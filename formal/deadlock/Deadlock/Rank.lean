      | reply =>
        simp only [execRun] at hyes
        unfold performReply at hyes
        cases hto : replyTo with
        | none =>
          simp [hto] at hyes
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · by_cases hmb : mb = id
