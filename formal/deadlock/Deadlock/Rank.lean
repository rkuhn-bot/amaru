import Deadlock.Inv2
import Deadlock.CallTag
import Deadlock.Proof
import Deadlock.Theorem

set_option autoImplicit false

namespace Deadlock

theorem await_callee_unterminable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (id dst : InstId) (k : Cont)
    (hph : (w.st id).phase = .awaitReply dst k) (t : Template)
    (ht : templateOf I.desc (tname dst) = some t) :
    t.terminable = false ∨ sameSubtree I.desc (tname id) (tname dst) = true := by
  have hI := inv_reachable I N w hL hR
  obtain ⟨_, e, he, hsrc, _, hdst, _, heff, _⟩ := described_reply I w hI id dst k hph
  have hsub := call_edge_unterminable I.desc hG e he heff t (by simpa [hdst] using ht)
  simpa [hsrc, hdst] using hsub

theorem parked_call_unterminable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (id dst : InstId) (k : Cont)
    (hph : (w.st id).phase = .parked dst true k) (t : Template)
    (ht : templateOf I.desc (tname dst) = some t) :
    t.terminable = false ∨ sameSubtree I.desc (tname id) (tname dst) = true := by
  have hI := inv_reachable I N w hL hR
  obtain ⟨_, e, he, hsrc, _, hdst, _, heff, _⟩ := described_park I w hI id dst true k hph
  have hsub := call_edge_unterminable I.desc hG e he heff t (by simpa [hdst] using ht)
  simpa [hsrc, hdst] using hsub

theorem proceed_phase_same (a b : Actor) (k : Cont) : (proceed a k).phase = (proceed b k).phase := by
  cases hk : k.rest <;> simp [proceed, hk]

theorem release_keeps_proceed (w : World) (id : InstId) (ps : List Parked) (sender : InstId) (k : Cont)
    (hp : (w.st sender).phase = (proceed (w.st sender) k).phase) :
    ((releaseParked w id ps).st sender).phase = (proceed (w.st sender) k).phase := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using hp
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih _ hp
    · rw [if_neg hskip]
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      by_cases hs : sender = p.sender
      · have hp' : (w'.st sender).phase = (proceed (w.st sender) k).phase := by
          cases hk : k.rest with
          | nil =>
            have hph : (w.st sender).phase = .idle := by simpa [proceed, hk] using hp
            simp [w', setActor, ← hs, resumeSender, hph, proceed, hk]
          | cons _ _ =>
            have hph : (w.st sender).phase = .run k := by simpa [proceed, hk] using hp
            simp [w', setActor, ← hs, resumeSender, hph, proceed, hk]
        have hp'' : (w'.st sender).phase = (proceed (w'.st sender) k).phase := by
          rw [hp', proceed_phase_same (w.st sender) (w'.st sender)]
        have hih := ih w' hp''
        rw [proceed_phase_same (w'.st sender) (w.st sender)] at hih
        simpa [releaseParked] using hih
      · have hw : (w'.st sender) = w.st sender := by
          simp [w', setActor, hs]
        have hp' : (w'.st sender).phase = (proceed (w'.st sender) k).phase := by
          simpa [hw, proceed_phase_same (w.st sender) (w'.st sender)] using hp
        have hih := ih w' hp'
        rw [proceed_phase_same (w'.st sender) (w.st sender)] at hih
        simpa [releaseParked] using hih

/-- `releaseParked` resumes a non-call sender. A parked call is skipped, and a
killing terminate is refused while any parked call remains. -/
theorem release_resumes_send (w : World) (id : InstId) (ps : List Parked) (sender : InstId)
    (k : Cont) (hmem : ∃ p, p ∈ ps ∧ p.sender = sender ∧ p.isCall = false)
    (hne : sender ≠ id) (hph : (w.st sender).phase = .parked id false k) :
    ((releaseParked w id ps).st sender).phase = (proceed (w.st sender) k).phase := by
  suffices ∀ ps w, (∃ p, p ∈ ps ∧ p.sender = sender ∧ p.isCall = false) →
      (w.st sender).phase = .parked id false k →
      ((releaseParked w id ps).st sender).phase = (proceed (w.st sender) k).phase from
    this ps w hmem hph
  intro ps
  induction ps with
  | nil =>
    intro w hex _
    obtain ⟨_, hp, _⟩ := hex
    cases hp
  | cons p ps ih =>
    intro w hex hph
    obtain ⟨p0, hp0, hs0, hc0⟩ := hex
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · have hprop : p.isCall = true ∨ p.sender = id := by
        simpa [Bool.or_eq_true, decide_eq_true_eq] using hskip
      have hex' : ∃ q, q ∈ ps ∧ q.sender = sender ∧ q.isCall = false := by
        cases hp0 with
        | head =>
          rcases hprop with hc | hid
          · simp [hc] at hc0
          · exact False.elim (hne (hs0.symm.trans hid))
        | tail _ ht => exact ⟨p0, ht, hs0, hc0⟩
      rw [if_pos hskip]
      exact ih w hex' hph
    · rw [if_neg hskip]
      by_cases hself : sender = p.sender
      · let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
        have hnow : (w'.st sender).phase = (proceed (w'.st sender) k).phase := by
          simp [w', setActor, ← hself, resumeSender, hph]
          cases hk : k.rest <;> simp [proceed, hk]
        have hgot := release_keeps_proceed w' id ps sender k hnow
        rw [proceed_phase_same (w'.st sender) (w.st sender)] at hgot
        simpa [releaseParked, w'] using hgot
      · have hex' : ∃ q, q ∈ ps ∧ q.sender = sender ∧ q.isCall = false := by
          cases hp0 with
          | head => exact False.elim (hself hs0.symm)
          | tail _ ht => exact ⟨p0, ht, hs0, hc0⟩
        let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
        have hph' : (w'.st sender).phase = .parked id false k := by
          simp [w', setActor, hself, hph]
        have hgot := ih w' hex' hph'
        rw [proceed_phase_same (w'.st sender) (w.st sender)] at hgot
        simpa [releaseParked, w'] using hgot

/-- A node of least residual rank is not blocked on a live partner. Either wait
would be a residual edge to a strictly lower node. -/
theorem minimal_not_blocked (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (hO : OccInv I w) (id dst : InstId) (k : Cont)
    (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (hmin : ∀ n, heightOf hs ({ template := tname id, state := (w.st id).typestate } : Node) ≤
      heightOf hs n) :
    ((w.st id).phase = .parked dst false k → (w.st dst).life ≠ .alive) ∧
      ((w.st id).phase = .awaitReply dst k → (w.st dst).life ≠ .alive) := by
  constructor
  · intro hph hlive
    have hdrop := park_below I hL hG N w hR hO id dst k hs hok hph hlive
    have hle := hmin ({ template := tname dst, state := (w.st dst).typestate } : Node)
    omega
  · intro hph hlive
    have hdrop := reply_below I hL hG N w hR id dst k hs hok hph hlive
    have hle := hmin ({ template := tname dst, state := (w.st dst).typestate } : Node)
    omega

/-- An accepts-call program answers on every path, and no path terminates
before that answer. `repliesMatch` counts each path. A sum of those paths
is a different number, so this does not say `replyCount` is 1.
(DECISIONS.md 2026-11-22, "A call waits on its own outcomes": the checker
admits `repliesMatch 1`, and `selectCall` runs the outcome list.) -/
theorem call_program_replies (I : Impl) (hL : LocalOk I) (tr : Transition) (hm : tr ∈ I.transitions)
    (hacc : tr.acceptsCall = true) (t : Template) (ht : templateOf I.desc tr.template = some t) :
    repliesMatch 1 tr.program = true ∧ terminateBeforeReply tr.program = false := by
  have hok := transitionOk_of_mem I hL tr hm
  simp only [transitionOk, ht, hacc, ite_true] at hok
  repeat rw [Bool.and_eq_true] at hok
  have hrep := hok.1.1.2
  refine ⟨hrep.1, ?_⟩
  cases hb : terminateBeforeReply tr.program
  · rfl
  · simp [hb] at hrep

theorem bulk_keeps_run (I : Impl) (w : World) (id : InstId) (w' : World) (s : InstId) (k : Cont)
    (hp : (w.st s).phase = .run k) (hne : s ≠ id) (h : receiveBulk I w id = some w') :
    (w'.st s).phase = .run k := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ p.msg w1 a1 s hdel
          have hph1 : (w1.st s).phase = .run k := by simpa [hst] using hp
          have hset : ((setActor w1 id a1).st s).phase = .run k := by
            simp [setActor, hne, hph1]
          -- `creditLive` returns the slot to the live generation, not the id on the message.
          have hcred : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st s).phase = .run k := by
            simpa [creditLive] using
              credit_preserves_run (setActor w1 id a1) (tname id)
                (budgetHolder (setActor w1 id a1) p.msg.sender) s k hset
          by_cases hs : s = p.sender
          · have hrun := resumeSender_run
              ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender)
              p.isCall id k (by simpa [hs] using hcred)
            simpa [setActor, hs] using hrun
          · simpa [setActor, hs] using hcred
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          have hset : ((setActor w1 id a1).st s).phase = .run k := by
            simp [setActor, hne, hst, hp]
          simpa [creditLive] using
            credit_preserves_run (setActor w1 id a1) (tname id)
              (budgetHolder (setActor w1 id a1) m.sender) s k hset
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          have hph1 : (w1.st s).phase = .run k := by simpa [hst] using hp
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hset : ((setActor w1 id admitted).st s).phase = .run k := by
            simp [admitted, setActor, hne, hph1]
          have hcred : ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s).phase = .run k := by
            simpa [creditLive] using
              credit_preserves_run (setActor w1 id admitted) (tname id)
                (budgetHolder (setActor w1 id admitted) m.sender) s k hset
          by_cases hs : s = p.sender
          · have hrun := resumeSender_run
              ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender)
              p.isCall id k (by simpa [hs] using hcred)
            simpa [admitted, setActor, hs] using hrun
          · simpa [admitted, setActor, hs] using hcred

/-- Scrubbing a reply keeps the effect list and replaces the phase only when the
callee still owes that call. -/
theorem detach_phase_owe (a : Actor) (caller : InstId) (cid : Nat) :
    (detachReply (detachBox a caller) caller cid).phase =
      if a.oweId == some cid then clearReplyPhase caller a.phase else a.phase := by
  unfold detachReply detachBox
  split <;> simp

theorem detach_prio (a : Actor) (caller : InstId) (cid : Nat) :
    (detachReply (detachBox a caller) caller cid).prio = a.prio := by
  unfold detachReply detachBox
  split <;> simp

theorem detach_parked (a : Actor) (caller : InstId) (cid : Nat) :
    (detachReply (detachBox a caller) caller cid).parked = a.parked := by
  unfold detachReply detachBox
  split <;> simp

theorem creditFold_prio (w : World) (name : String) (s : InstId) (ps : List Parked) (i : InstId) :
    ((ps.foldl (fun w _ => creditSender w name s) w).st i).prio = (w.st i).prio := by
  induction ps generalizing w with
  | nil => rfl
  | cons _ ps ih =>
    simp only [List.foldl_cons]
    exact (ih (creditSender w name s)).trans (by
      by_cases h : i = s
      · simp [creditSender, h, setActor, bumpToken]
      · simp [creditSender, setActor, h])

theorem refundCall_prio (w : World) (caller dst i : InstId) :
    ((refundParkedCall w caller dst).st i).prio = (w.st i).prio := by
  unfold refundParkedCall
  dsimp only
  split
  · rfl
  · rename_i _
    have hset : ((setActor w dst { (w.st dst) with
        parked := (w.st dst).parked.filter fun p => !(p.sender == caller && p.isCall) }).st i).prio =
        (w.st i).prio := by
      by_cases hi : i = dst <;> simp [setActor, hi]
    exact (creditFold_prio _ (tname dst) caller _ i).trans hset

/-- A deadline either finishes an admitted call or refunds a parked one. -/
inductive TimeoutView (w w' : World) (id : InstId) : Prop where
  | await (dst : InstId) (k : Cont)
      (hph : (w.st id).phase = .awaitReply dst k)
      (hw : w' = setActor
        (setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)) id
        (finishCall
          ((setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)).st id)
          k .timedOut))
  | park (dst : InstId) (k : Cont)
      (hph : (w.st id).phase = .parked dst true k)
      (hw : w' = setActor (refundParkedCall w id dst) id
        (finishCall ((refundParkedCall w id dst).st id) k .notAdmitted))
  | peer (k : Cont)
      (hph : (w.st id).phase = .awaitPeer k)
      (hw : w' = setActor w id (proceed (w.st id)
        { k with rest := k.onTimeout, toState := pickState k.toState k.toTimeout }))

theorem callTimeout_view (w w' : World) (id : InstId) (h : callTimeout w id = some w') :
    TimeoutView w w' id := by
  unfold callTimeout at h
  dsimp only at h
  by_cases hlive : ((w.st id).life != .alive) = true
  · simp [hlive] at h
  · have hgo : ((w.st id).life != .alive) = false := by simpa [Bool.not_eq_true] using hlive
    simp only [hgo, ite_false] at h
    cases hph : (w.st id).phase with
    | awaitReply dst k =>
      simp only [hph] at h
      cases h
      exact TimeoutView.await dst k hph rfl
    | parked dst b k =>
      cases b with
      | false => simp [hph] at h
      | true =>
        simp only [hph] at h
        cases h
        exact TimeoutView.park dst k hph rfl
    | idle => simp [hph] at h
    | run _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer k =>
      simp only [hph] at h
      cases h
      exact TimeoutView.peer k hph rfl
    | crashed => simp [hph] at h

/-- The waiter leaves its wait on the outcome that fired.
`awaitReply` runs `onTimedOut`, a parked call runs `onNotAdmitted`, and
`awaitPeer` runs `onTimeout`. Each is `proceed` of that list, not of the
tail that was waiting. (DECISIONS.md 2026-11-22, "A call waits on its own
outcomes"; 2026-11-19, "Every external wait carries a timeout".) -/
theorem callTimeout_self (w w' : World) (id : InstId) (h : callTimeout w id = some w') :
    (∃ dst k, (w.st id).phase = .awaitReply dst k ∧
        (w'.st id).phase =
          (proceed ((setActor w dst
            (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)).st id)
            (selectCall k .timedOut)).phase) ∨
      (∃ dst k, (w.st id).phase = .parked dst true k ∧
        (w'.st id).phase =
          (proceed ((refundParkedCall w id dst).st id) (selectCall k .notAdmitted)).phase) ∨
      (∃ k, (w.st id).phase = .awaitPeer k ∧
        (w'.st id).phase =
          (proceed (w.st id)
            { k with rest := k.onTimeout, toState := pickState k.toState k.toTimeout }).phase) := by
  cases callTimeout_view w w' id h with
  | await dst k hph hw =>
    refine Or.inl ⟨dst, k, hph, ?_⟩
    rw [hw, setActor_self]
    exact finishCall_phase _ k .timedOut
  | park dst k hph hw =>
    refine Or.inr (Or.inl ⟨dst, k, hph, ?_⟩)
    rw [hw, setActor_self]
    exact finishCall_phase _ k .notAdmitted
  | peer k hph hw =>
    refine Or.inr (Or.inr ⟨k, hph, ?_⟩)
    rw [hw, setActor_self]

theorem callTimeout_prio (w w' : World) (id i : InstId) (h : callTimeout w id = some w') :
    (w'.st i).prio = (w.st i).prio := by
  cases callTimeout_view w w' id h with
  | await dst k _ hw =>
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, finishCall_prio]
      by_cases hdst : id = dst
      · simp [setActor, hdst, detach_prio]
      · simp [setActor, hdst, detach_prio]
    · simp [setActor, hid]
      by_cases hdst : i = dst
      · simp [setActor, hdst, detach_prio]
      · simp [setActor, hdst]
  | park dst _ _ hw =>
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, finishCall_prio]
      exact refundCall_prio w id dst id
    · simp [setActor, hid]
      exact refundCall_prio w id dst i
  | peer _ _ hw =>
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, proceed_kept]
    · simp [setActor, hid]

theorem callTimeout_parked (w w' : World) (id i : InstId) (h : callTimeout w id = some w') :
    (w'.st i).parked = (w.st i).parked ∨
      (∃ dst k, (w.st id).phase = .parked dst true k ∧ i = dst ∧
        (w'.st i).parked =
          (w.st dst).parked.filter fun p => !(p.sender == id && p.isCall)) := by
  cases callTimeout_view w w' id h with
  | await dst _ _ hw =>
    apply Or.inl
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, finishCall_parked]
      by_cases hdst : id = dst
      · simp [setActor, hdst, detach_parked]
      · simp [setActor, hdst, detach_parked]
    · simp [setActor, hid]
      by_cases hdst : i = dst
      · simp [setActor, hdst, detach_parked]
      · simp [setActor, hdst]
  | park dst k hph hw =>
    by_cases hdst : i = dst
    · apply Or.inr
      refine ⟨dst, k, hph, hdst, ?_⟩
      rw [hdst, hw]
      by_cases hid : dst = id
      · simp [setActor, hid, finishCall_parked]
        simpa using (refundCall_fields w id id id).2.2.2
      · simp [setActor, hid]
        simpa using (refundCall_fields w id dst dst).2.2.2
    · apply Or.inl
      rw [hw]
      by_cases hid : i = id
      · simp [setActor, hid, finishCall_parked]
        have hne : id ≠ dst := by
          intro heq
          exact hdst (hid.trans heq)
        simpa [hne] using (refundCall_fields w id dst id).2.2.2
      · simp [setActor, hid]
        simpa [hdst] using (refundCall_fields w id dst i).2.2.2
  | peer _ _ hw =>
    apply Or.inl
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, proceed_kept]
    · simp [setActor, hid]

theorem callTimeout_box (w w' : World) (id i : InstId) (h : callTimeout w id = some w') :
    (w'.st i).box = (w.st i).box ∨
      (∃ dst k, (w.st id).phase = .awaitReply dst k ∧ i = dst ∧
        (w'.st i).box = (w.st dst).box.map (detachMsg id)) := by
  cases callTimeout_view w w' id h with
  | await dst k hph hw =>
    by_cases hdst : i = dst
    · apply Or.inr
      refine ⟨dst, k, hph, hdst, ?_⟩
      rw [hdst, hw]
      by_cases hid : dst = id
      · simp [setActor, hid, finishCall_box, detach_box]
      · simp [setActor, hid, detach_box]
    · apply Or.inl
      rw [hw]
      by_cases hid : i = id
      · have hne : id ≠ dst := by
          intro heq
          exact hdst (hid.trans heq)
        simp [setActor, hid, hne, finishCall_box]
      · simp [setActor, hid, hdst]
  | park dst _ _ hw =>
    apply Or.inl
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, finishCall_box]
      exact refundCall_box w id dst id
    · simp [setActor, hid]
      exact refundCall_box w id dst i
  | peer _ _ hw =>
    apply Or.inl
    rw [hw]
    by_cases hid : i = id
    · simp [setActor, hid, proceed_kept]
    · simp [setActor, hid]

/-- A deadline leaves every other actor's typestate alone. The caller itself
leaves the wait, so its typestate is not claimed here. -/
theorem deadline_keeps_ty (w w' : World) (id i : InstId) (h : callTimeout w id = some w')
    (hne : i ≠ id) : (w'.st i).typestate = (w.st i).typestate := by
  cases callTimeout_view w w' id h with
  | await dst _ _ hw =>
    rw [hw]
    by_cases hd : i = dst
    · have hdst : dst ≠ id := hd ▸ hne
      rw [hd]
      simp [setActor, hdst, detach_ty]
    · simp [setActor, hne, hd]
  | park dst _ _ hw =>
    rw [hw]
    simp [setActor, hne]
    exact (refundCall_fields w id dst i).2.2.1
  | peer _ _ hw =>
    rw [hw]
    simp [setActor, hne]

/-- `ph` is still `k`, or `k` with `replyTo` cleared. A late reply is ignored. -/
def RunKept (k : Cont) (ph : Phase) : Prop :=
  ph = .run k ∨ ∃ caller, k.replyTo = some caller ∧ ph = .run {k with replyTo := none}

/-- An effect or peer wait is unchanged, or its `replyTo` was cleared. -/
def QuietKept (ph ph' : Phase) : Prop :=
  ph' = ph ∨ ∃ k caller,
    (ph = .awaitEffect k ∧ k.replyTo = some caller ∧ ph' = .awaitEffect {k with replyTo := none}) ∨
    (ph = .awaitPeer k ∧ k.replyTo = some caller ∧ ph' = .awaitPeer {k with replyTo := none})

theorem runKept_view (k : Cont) (ph : Phase) (h : RunKept k ph) :
    ∃ k', ph = .run k' ∧ k'.rest = k.rest ∧ k'.toState = k.toState := by
  rcases h with h | ⟨_, _, h⟩
  · exact ⟨k, h, rfl, rfl⟩
  · exact ⟨{k with replyTo := none}, h, rfl, rfl⟩

theorem runKept_fuel (k : Cont) (ph : Phase) (h : RunKept k ph) :
    phaseFuel ph = phaseFuel (.run k) := by
  rcases h with h | ⟨_, _, h⟩ <;> simp [phaseFuel, h]

theorem quietKept_effect (k : Cont) (ph : Phase) (h : QuietKept (.awaitEffect k) ph) :
    ∃ k', ph = .awaitEffect k' ∧ k'.rest = k.rest ∧ k'.toState = k.toState := by
  rcases h with h | ⟨k0, _, hE | hP⟩
  · exact ⟨k, h, rfl, rfl⟩
  · rcases hE with ⟨hk, _, hph⟩
    injection hk with hk
    subst hk
    exact ⟨{k with replyTo := none}, hph, rfl, rfl⟩
  · rcases hP with ⟨hk, _, _⟩
    cases hk

theorem quietKept_peer (k : Cont) (ph : Phase) (h : QuietKept (.awaitPeer k) ph) :
    ∃ k', ph = .awaitPeer k' ∧ k'.rest = k.rest ∧ k'.toState = k.toState ∧
      k'.onTimeout = k.onTimeout := by
  rcases h with h | ⟨k0, _, hE | hP⟩
  · exact ⟨k, h, rfl, rfl, rfl⟩
  · rcases hE with ⟨hk, _, _⟩
    cases hk
  · rcases hP with ⟨hk, _, hph⟩
    injection hk with hk
    subst hk
    exact ⟨{k with replyTo := none}, hph, rfl, rfl, rfl⟩

/-- One step of someone else does not replace a running continuation.
A deadline may clear `replyTo` so a late reply is ignored. The effect list and
the typestate target stay. -/
theorem step_keeps_run (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s : InstId)
    (k : Cont) (hp : (w.st s).phase = .run k) (hl : (w.st s).life = .alive)
    (h : apply I a w = some w') (hnot : a ≠ .exec s) (hl' : (w'.st s).life = .alive) :
    RunKept k (w'.st s).phase := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by
      simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
    cases callTimeout_view w w' id hct with
    | await dst k0 hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · by_cases hd : s = dst
        · have hne : dst ≠ id := by
            intro heq
            exact hs (hd.trans heq)
          rw [hd] at hp
          rw [hd, hw]
          simp [setActor, hne, detach_phase_owe]
          cases howe : ((w.st dst).oweId == some (w.st id).waitId) with
          | false =>
            have hneq : (w.st dst).oweId ≠ some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            exact Or.inl (by simp [hneq, hp])
          | true =>
            have heq : (w.st dst).oweId = some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            simp [heq, hp, clearReplyPhase]
            cases hto : k.replyTo == some id with
            | false =>
              have hneq : k.replyTo ≠ some id := by simpa [beq_iff_eq] using hto
              exact Or.inl (by simp [clearReplyCont, hneq])
            | true =>
              have heqR : k.replyTo = some id := by simpa [beq_iff_eq] using hto
              refine Or.inr ⟨id, heqR, ?_⟩
              simp [clearReplyCont, heqR]
        · rw [hw]
          exact Or.inl (by simp [setActor, hs, hd, hp])
    | park dst _ hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · rw [hw]
        exact Or.inl (by simp [setActor, hs, finishCall_phase, (refundCall_fields w id dst s).1, hp])
    | peer _ hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · rw [hw]
        exact Or.inl (by simp [setActor, hs, hp])
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl hp
  | ingress dst label =>
    have hing : receiveIngress I w dst label = some w' := by
      simpa [stepWorld] using (apply_step I (.ingress dst label) w w' h).2
    exact Or.inl (by simpa [(ingress_phase I w w' dst label s hing).1] using hp)
  | exec id =>
    have hne : s ≠ id := by
      intro hs
      apply hnot
      simp [hs]
    have h := (by simpa [stepWorld] using (apply_step I (.exec id) w w' h).2 :
      execHead I w id = some w')
    unfold execHead at h
    by_cases hlive : (w.st id).life = .alive
    · simp [hlive] at h
      cases hph : (w.st id).phase with
      | run k0 =>
        simp [hph] at h
        cases h
        exact Or.inl (execRun_preserves_other_run I w id (w.st id) k0 k s hne hp hph hl'
          (hO.aliveIn s hl))
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hlive] at h
  | finish id =>
    have h : finishWait I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.finish id) w w' h).2
    obtain ⟨_, hph, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    have hne : s ≠ id := by
      intro hs
      rw [hs] at hp
      rcases hph with hph | hph <;> simp [hp] at hph
    exact Or.inl (by simp [setActor, hne, hp])
  | spawn template =>
    have hsp : spawn I w template = some w' := by
      simpa [stepWorld] using (apply_step I (.spawn template) w w' h).2
    have hmem := hO.aliveIn s hl
    unfold spawn at hsp
    cases ht : templateOf I.desc template with
    | none => simp [ht] at hsp
    | some t =>
      simp only [ht] at hsp
      by_cases hmay : maySpawnRoot I.desc w template t = true
      · simp only [hmay, ite_true] at hsp
        cases hsup : t.supervisor with
        | some name =>
          simp only [hsup] at hsp
          let k := freshKey I.desc w t.subtree
          cases hsp
          have hphP := placePeer_phase I w template k t.initial (some (.core name))
            (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
            s (by intro _; rfl)
          have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
            intro hs
            exact maxGen_notin w template k (hs ▸ hmem)
          exact Or.inl (by unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp])
        | none =>
          simp only [hsup] at hsp
          by_cases hsub : (t.subtree == "") = true
          · simp only [hsub, ite_true] at hsp
            let k := w.nextIx template
            cases hsp
            have hphP := placePeer_phase I w template k t.initial none
              (fun w1 => { w1 with nextIx := fun n => if n = template then k + 1 else w1.nextIx n })
              s (by intro _; rfl)
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            exact Or.inl (by unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp])
          · have hsubF : (t.subtree == "") = false := by
              cases hb : t.subtree == ""
              · rfl
              · exact absurd hb hsub
            simp only [hsubF, ite_false] at hsp
            let k := freshKey I.desc w t.subtree
            cases hsp
            have hphP := placePeer_phase I w template k t.initial none
              (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
              s (by intro _; rfl)
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            exact Or.inl (by unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp])
      · simp [hmay] at hsp
  | recvPrio id =>
    have hrecv : receivePrio I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.recvPrio id) w w' h).2
    obtain ⟨m, _, _, w1, a1, _, hidle, _, _, hdel, hw'⟩ := receivePrio_spec I w w' id hrecv
    have hne : s ≠ id := by
      intro hs
      rw [hs, hidle] at hp
      cases hp
    have hst := deliver_st I w id _ m w1 a1 s hdel
    rw [hw']
    exact Or.inl (by simp [setActor, hne, hst, hp])
  | recvBulk id =>
    have h : receiveBulk I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.recvBulk id) w w' h).2
    have hne : s ≠ id := by
      intro hs
      rw [← hs] at h
      simp [receiveBulk, hp] at h
    exact Or.inl (bulk_keeps_run I w id w' s k hp hne h)

/-- A deadline of someone other than the caller named by `replyTo` does not scrub it. -/
theorem step_keeps_owed (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s caller : InstId)
    (k : Cont) (hp : (w.st s).phase = .run k) (hto : k.replyTo = some caller)
    (hl : (w.st s).life = .alive) (h : apply I a w = some w') (hnot : a ≠ .exec s)
    (hown : a ≠ .callTimeout caller) (hl' : (w'.st s).life = .alive) :
    (w'.st s).phase = .run k := by
  cases a with
  | callTimeout id =>
    have hneC : id ≠ caller := by
      intro hid
      apply hown
      simp [hid]
    have hct : callTimeout w id = some w' := by
      simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
    cases callTimeout_view w w' id hct with
    | await dst _ hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · by_cases hd : s = dst
        · have hne : dst ≠ id := by
            intro heq
            exact hs (hd.trans heq)
          rw [hd] at hp
          rw [hd, hw]
          simp [setActor, hne, detach_phase_owe]
          cases howe : ((w.st dst).oweId == some (w.st id).waitId) with
          | false =>
            have hneq : (w.st dst).oweId ≠ some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            simp [hneq, hp]
          | true =>
            have heq : (w.st dst).oweId = some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            have htoF : (k.replyTo == some id) = false := by
              simpa [beq_iff_eq, hto] using hneC.symm
            simp [heq, hp, clearReplyPhase, clearReplyCont, htoF]
        · rw [hw]
          simp [setActor, hs, hd, hp]
    | park dst _ hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · rw [hw]
        simp [setActor, hs, finishCall_phase, (refundCall_fields w id dst s).1, hp]
    | peer _ hph hw =>
      by_cases hs : s = id
      · rw [hs, hph] at hp
        cases hp
      · rw [hw]
        simp [setActor, hs, hp]
  | stutter =>
    cases stutter_unchanged I w w' h
    exact hp
  | ingress dst label =>
    have hing : receiveIngress I w dst label = some w' := by
      simpa [stepWorld] using (apply_step I (.ingress dst label) w w' h).2
    simpa [(ingress_phase I w w' dst label s hing).1] using hp
  | exec id =>
    have hne : s ≠ id := by
      intro hs
      apply hnot
      simp [hs]
    have h := (by simpa [stepWorld] using (apply_step I (.exec id) w w' h).2 :
      execHead I w id = some w')
    unfold execHead at h
    by_cases hlive : (w.st id).life = .alive
    · simp [hlive] at h
      cases hph : (w.st id).phase with
      | run k0 =>
        simp [hph] at h
        cases h
        exact execRun_preserves_other_run I w id (w.st id) k0 k s hne hp hph hl'
          (hO.aliveIn s hl)
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hlive] at h
  | finish id =>
    have h : finishWait I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.finish id) w w' h).2
    obtain ⟨_, hph, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    have hne : s ≠ id := by
      intro hs
      rw [hs] at hp
      rcases hph with hph | hph <;> simp [hp] at hph
    simp [setActor, hne, hp]
  | spawn template =>
    have hsp : spawn I w template = some w' := by
      simpa [stepWorld] using (apply_step I (.spawn template) w w' h).2
    have hmem := hO.aliveIn s hl
    unfold spawn at hsp
    cases ht : templateOf I.desc template with
    | none => simp [ht] at hsp
    | some t =>
      simp only [ht] at hsp
      by_cases hmay : maySpawnRoot I.desc w template t = true
      · simp only [hmay, ite_true] at hsp
        cases hsup : t.supervisor with
        | some name =>
          simp only [hsup] at hsp
          let k := freshKey I.desc w t.subtree
          cases hsp
          have hphP := placePeer_phase I w template k t.initial (some (.core name))
            (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
            s (by intro _; rfl)
          have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
            intro hs
            exact maxGen_notin w template k (hs ▸ hmem)
          unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp]
        | none =>
          simp only [hsup] at hsp
          by_cases hsub : (t.subtree == "") = true
          · simp only [hsub, ite_true] at hsp
            let k := w.nextIx template
            cases hsp
            have hphP := placePeer_phase I w template k t.initial none
              (fun w1 => { w1 with nextIx := fun n => if n = template then k + 1 else w1.nextIx n })
              s (by intro _; rfl)
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp]
          · have hsubF : (t.subtree == "") = false := by
              cases hb : t.subtree == ""
              · rfl
              · exact absurd hb hsub
            simp only [hsubF, ite_false] at hsp
            let k := freshKey I.desc w t.subtree
            cases hsp
            have hphP := placePeer_phase I w template k t.initial none
              (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
              s (by intro _; rfl)
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            unfold k at hphP hfresh; rw [hphP]; simp [hfresh, hp]
      · simp [hmay] at hsp
  | recvPrio id =>
    have hrecv : receivePrio I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.recvPrio id) w w' h).2
    obtain ⟨m, _, _, w1, a1, _, hidle, _, _, hdel, hw'⟩ := receivePrio_spec I w w' id hrecv
    have hne : s ≠ id := by
      intro hs
      rw [hs, hidle] at hp
      cases hp
    have hst := deliver_st I w id _ m w1 a1 s hdel
    rw [hw']
    simp [setActor, hne, hst, hp]
  | recvBulk id =>
    have hbulk : receiveBulk I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.recvBulk id) w w' h).2
    have hne : s ≠ id := by
      intro hs
      rw [← hs] at hbulk
      simp [receiveBulk, hp] at hbulk
    exact bulk_keeps_run I w id w' s k hp hne hbulk

/-- A step keeps a running continuation up to the `replyTo` scrub. -/
theorem step_keeps_run_kept (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s : InstId)
    (k : Cont) (hp : RunKept k (w.st s).phase) (hl : (w.st s).life = .alive)
    (h : apply I a w = some w') (hnot : a ≠ .exec s) (hl' : (w'.st s).life = .alive) :
    RunKept k (w'.st s).phase := by
  rcases hp with hp | ⟨caller, hto, hp⟩
  · exact step_keeps_run I a w w' hO s k hp hl h hnot hl'
  · have hstep := step_keeps_run I a w w' hO s {k with replyTo := none} hp hl h hnot hl'
    rcases hstep with hstay | ⟨_, hto', _⟩
    · exact Or.inr ⟨caller, hto, hstay⟩
    · simp at hto'

theorem proceed_run_rest (a : Actor) (k k' : Cont) (h : (proceed a k).phase = .run k') :
    k'.rest = k.rest ∧ k.rest ≠ [] := by
  cases hk : k.rest with
  | nil => simp [proceed, hk] at h
  | cons _ _ =>
    simp [proceed, hk] at h
    exact ⟨by rw [← h]; simp [hk], by simp [hk]⟩

theorem after_shorter (k k' : Cont) (a : Actor) (hrest : k.rest ≠ [])
    (h : (proceed a (afterHead k)).phase = .run k') : k'.rest.length < k.rest.length := by
  have htail : (afterHead k).rest = k.rest.tail := by simp [afterHead]
  have ⟨heq, hne⟩ := proceed_run_rest a (afterHead k) k' h
  rw [heq, htail]
  cases hk : k.rest with
  | nil => exact absurd hk hrest
  | cons _ es => simp [hk]

/-- A `terminate` anywhere in a list is still there after a head is pushed back. -/
theorem hasTerminate_cons (e : Eff) (es : List Eff) (h : hasTerminate es = true) :
    hasTerminate (e :: es) = true := by
  cases e <;> simp [hasTerminate, h]

/-- The list a phase is still obliged to run, when it has one. -/
def carried : Phase → Option (List Eff)
  | .run k => some k.rest
  | .parked _ _ k => some k.rest
  | .awaitReply _ k => some k.rest
  | .awaitEffect k => some k.rest
  | .awaitPeer k => some k.rest
  | _ => none

theorem clearReplyPhase_carried (caller : InstId) (ph : Phase) :
    carried (clearReplyPhase caller ph) = carried ph := by
  cases ph with
  | run k =>
    simp only [clearReplyPhase, carried]
    exact congrArg some (clearReplyCont_keeps caller k).1
  | parked _ _ k =>
    simp only [clearReplyPhase, carried]
    exact congrArg some (clearReplyCont_keeps caller k).1
  | awaitReply _ k =>
    simp only [clearReplyPhase, carried]
    exact congrArg some (clearReplyCont_keeps caller k).1
  | awaitEffect k =>
    simp only [clearReplyPhase, carried]
    exact congrArg some (clearReplyCont_keeps caller k).1
  | awaitPeer k =>
    simp only [clearReplyPhase, carried]
    exact congrArg some (clearReplyCont_keeps caller k).1
  | idle => rfl
  | crashed => rfl

/-- A deadline does not change another actor's carried list. Clearing `replyTo`
keeps the effect list. The waiter itself continues on the outcome arm, which
is not this list. -/
theorem callTimeout_carried (w w' : World) (id i : InstId) (es : List Eff)
    (h : callTimeout w id = some w') (hne : i ≠ id) (hc : carried (w'.st i).phase = some es) :
    carried (w.st i).phase = some es := by
  cases callTimeout_view w w' id h with
  | await dst _ _ hw =>
    rw [hw] at hc
    rw [setActor_other
        (setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)) id i
        (finishCall
          ((setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)).st id)
          _ .timedOut) hne] at hc
    by_cases hd : i = dst
    · rw [hd] at hc ⊢
      rw [setActor_self, detach_phase_owe] at hc
      cases howe : ((w.st dst).oweId == some (w.st id).waitId) with
      | false => simpa [howe] using hc
      | true =>
        have hc' : carried (clearReplyPhase id (w.st dst).phase) = some es := by
          simpa [howe] using hc
        rw [← clearReplyPhase_carried id (w.st dst).phase]
        exact hc'
    · rw [setActor_other w dst i
        (detachReply (detachBox (w.st dst) id) id (w.st id).waitId) hd] at hc
      exact hc
  | park dst _ _ hw =>
    rw [hw] at hc
    rw [setActor_other (refundParkedCall w id dst) id i
        (finishCall ((refundParkedCall w id dst).st id) _ .notAdmitted) hne,
        (refundCall_fields w id dst i).1] at hc
    exact hc
  | peer _ _ hw =>
    rw [hw, setActor_other w id i _ hne] at hc
    exact hc

/-- A template may carry `terminate`. A per-peer must be marked terminable.
A multiplicity-one core may terminate, and that step crashes the node:
`terminable` is not a property of a core (DECISIONS.md 2026-11-21). -/
def MayTerminate (D : Description) (name : String) : Prop :=
  ∃ t, templateOf D name = some t ∧ (t.terminable = true ∨ t.multiplicity = .one)

/-- A continuation that still contains `terminate` was installed from a checked
transition, so the actor's template may terminate. `programOk` does not say
this: `effectsOk` skips `terminate`. -/
def TermOk (I : Impl) (w : World) : Prop :=
  ∀ id es, carried (w.st id).phase = some es → hasTerminate es = true →
    MayTerminate I.desc (tname id)

theorem term_ok_init (I : Impl) (N : Nat) : TermOk I (initWorld I N) := by
  intro id es hc _
  simp [init_phase, carried] at hc

theorem term_ok_replace (I : Impl) (w : World) (id : InstId) (a : Actor) (hT : TermOk I w)
    (hnew : ∀ es, carried a.phase = some es → hasTerminate es = true →
      MayTerminate I.desc (tname id)) : TermOk I (setActor w id a) := by
  intro i es hc ht
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    simp [setActor] at hc
    exact hnew es hc ht
  · simp [setActor, hi] at hc
    exact hT i es hc ht

theorem term_ok_phase (I : Impl) (w w' : World) (hT : TermOk I w)
    (h : ∀ i, (w'.st i).phase = (w.st i).phase) : TermOk I w' := by
  intro i es hc ht
  rw [h i] at hc
  exact hT i es hc ht

theorem term_program (I : Impl) (hL : LocalOk I) (tr : Transition) (hm : tr ∈ I.transitions)
    (hterm : hasTerminate tr.program = true) (t : Template)
    (ht : templateOf I.desc tr.template = some t) :
    t.terminable = true ∨ t.multiplicity = .one := by
  have hok := transitionOk_of_mem I hL tr hm
  simp only [transitionOk, ht] at hok
  repeat rw [Bool.and_eq_true] at hok
  have hcl := hok.1.2
  simp only [hterm, ite_true] at hcl
  cases hmul : t.multiplicity with
  | one =>
    exact Or.inr rfl
  | perPeer =>
    rw [hmul, Bool.or_eq_true] at hcl
    rcases hcl with hbad | hterm
    · have hfalse : (Multiplicity.perPeer == Multiplicity.one) = false := by rfl
      rw [hfalse] at hbad
      cases hbad
    · exact Or.inl hterm

/-- A lone terminable holds no parked call while its host is alive, or while the
world has not crashed. `ParkedFromLive` drops a dead sender from a live host.
`DeadQuiet` clears a dead host that has not crashed. A crash leaves that
mailbox in place, so the fact is not claimed for a dead host there. -/
theorem terminable_no_parked_call (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (id : InstId)
    (hterm : loneTerminableName I.desc (tname id))
    (hhost : (w.st id).life = .alive ∨ w.crashed = false) : hasParkedCall (w.st id).parked = false := by
  have hI := inv_reachable I N w hL hR
  have hM := hI.2.1
  simp [hasParkedCall, List.any_eq_false]
  intro p hp
  obtain ⟨t, ht, _hmul, htm, hsub⟩ := hterm
  by_cases hl : (w.st id).life = .alive
  · have hliveS : (w.st p.sender).life ≠ .dead := hI.seal.liveParked id p hl hp
    rcases hM.fwd id p hp with ⟨k, hph⟩ | hhalt
    · cases hc : p.isCall with
      | false => rfl
      | true =>
        have hph' : (w.st p.sender).phase = .parked id true k := by simpa [hc] using hph
        have hnot := no_terminable_call_target I hL hG N w hR p.sender id k (Or.inl hph') t ht
        cases hnot with
        | inl h => simp [htm] at h
        | inr hsame =>
          have hempty : templateSubtree I.desc (tname id) = "" := by
            simp [templateSubtree, ht, hsub]
          rw [sameSubtree, hempty, Bool.and_eq_true] at hsame
          simp [bne, hsame.2] at hsame
    · exact absurd (by simpa [Halted] using hhalt) hliveS
  · have hcr : w.crashed = false := by
      rcases hhost with hl' | hcr
      · exact absurd hl' hl
      · exact hcr
    rcases hI.seal.quiet with hbad | hq
    · simp [hcr] at hbad
    · have hempty := (hq id hl).2
      simp [hempty] at hp


theorem release_victim_eq (w : World) (id : InstId) (ps : List Parked) :
    (releaseParked w id ps).st id = w.st id := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih _
    · rw [if_neg hskip]
      have hne : p.sender ≠ id := by
        intro hs
        exact hskip (by simp [hs])
      have hst : (setActor w p.sender (resumeSender (w.st p.sender) false id)).st id = w.st id := by
        simp [setActor, Ne.symm hne]
      exact (ih _).trans hst

theorem release_keeps_victim (w : World) (id : InstId) (ps : List Parked) :
    ((releaseParked w id ps).st id).phase = (w.st id).phase ∧
      ((releaseParked w id ps).st id).life = (w.st id).life := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih _
    · rw [if_neg hskip]
      have hne : p.sender ≠ id := by
        intro hs
        exact hskip (by simp [hs])
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      have hst : (w'.st id) = w.st id := by
        have hswap : id ≠ p.sender := fun h => hne h.symm
        simp [w', setActor, hswap]
      have hih := ih w'
      rw [hst] at hih
      simpa [releaseParked, w'] using hih

theorem failWaiter_dead_phase (w : World) (dead i s : InstId)
    (hdead : (w.st s).life ≠ .alive) :
    ((failWaiter w dead i).st s).phase = (w.st s).phase ∧
      ((failWaiter w dead i).st s).life = (w.st s).life := by
  by_cases hs : s = i
  · rw [hs] at hdead ⊢
    have hbit : ((w.st i).life != .alive) = true := by
      cases hlife : (w.st i).life <;> simp_all [bne]
    simp [failWaiter, hbit]
  · rw [failWaiter_other w dead i s hs]
    exact ⟨rfl, rfl⟩

theorem failFold_dead_phase (w : World) (dead s : InstId) (ids : List InstId)
    (hdead : (w.st s).life ≠ .alive) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase = (w.st s).phase ∧
      ((ids.foldl (fun w i => failWaiter w dead i) w).st s).life = (w.st s).life := by
  induction ids generalizing w with
  | nil => exact ⟨by simp, by simp⟩
  | cons i ids ih =>
    simp only [List.foldl_cons]
    have hstep := failWaiter_dead_phase w dead i s hdead
    have hdead' : ((failWaiter w dead i).st s).life ≠ .alive := by
      rw [hstep.2]
      exact hdead
    have hih := ih (failWaiter w dead i) hdead'
    exact ⟨hih.1.trans hstep.1, hih.2.trans hstep.2⟩

theorem releaseParked_keeps_idle (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (h : (w.st s).phase = .idle) :
    ((releaseParked w id ps).st s).phase = .idle := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    rw [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w h
    · rw [if_neg hskip]
      by_cases hs : s = p.sender
      · have hidle : (resumeSender (w.st p.sender) false id).phase = .idle := by
          rw [hs] at h
          simp [resumeSender, h]
        have hstep : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st s).phase =
            .idle := by simpa [setActor, hs] using hidle
        exact ih _ hstep
      · have hstep : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st s).phase =
            .idle := by simpa [setActor, hs, h]
        exact ih _ hstep

/-- The actor that commits `terminate` is dead and idle afterwards.
`hl` is required because `shutdownActor` leaves a life that is not alive
untouched, and that life need not be idle. `hacy` is required because a
descendant seal must not be the stage itself. A tombstone that crashes the
roster does not rewrite this actor: `releaseWorld` installs it dead before
the offer, and `crashActor` only rewrites an alive actor. -/
theorem terminate_self (D : Description) (w : World) (id : InstId)
    (hacy : ParentAcyclic w) (hl : (w.st id).life = .alive) :
    ((terminateStage D w id (w.st id)).st id).life = .dead ∧
      ((terminateStage D w id (w.st id)).st id).phase = .idle :=
  terminate_alive_idle D w id hacy hl

/-- The actor that commits `terminate` keeps an empty mailbox.
`hl`: `shutdownActor` does not clear a life that is not alive.
`hacy`: `drop_root_life`. A stage is not its own descendant, so the stage is
still alive when its own `releaseWorld` clears the mailbox. A tombstone that
then crashes the roster does not refill it (`enqueue_quiet`). The seal
empties the mailbox in the terminate step. -/
theorem terminate_cleared (D : Description) (w : World) (id : InstId)
    (hacy : ParentAcyclic w) (hl : (w.st id).life = .alive) :
    ((terminateStage D w id (w.st id)).st id).parked = [] ∧
      ((terminateStage D w id (w.st id)).st id).box = [] := by
  simp only [terminateStage]
  have hstay : ((dropDescendants D w id).st id).life = .alive := by
    rw [drop_root_life D w id hacy, hl]
  unfold shutdownActor
  have hbit : (((dropDescendants D w id).st id).life == .alive) = true := by simp [hstay]
  simp only [hbit, ite_true, sealActor]
  have hq := release_quiet D (dropDescendants D w id) id ((dropDescendants D w id).st id)
  have he := enqueue_quiet D (releaseWorld D (dropDescendants D w id) id
      ((dropDescendants D w id).st id)) id hq.1 hq.2.1 hq.2.2.1 hq.2.2.2.1 hq.2.2.2.2
  exact ⟨he.2.2.2.2, he.2.2.1⟩

/-- Releasing one actor changes a life only by installing that actor dead and idle. -/
theorem releaseWorld_died (D : Description) (w : World) (id : InstId) (a : Actor) (i : InstId)
    (hchg : ((releaseWorld D w id a).st i).life ≠ (w.st i).life) :
    ((releaseWorld D w id a).st i).life = .dead ∧
      ((releaseWorld D w id a).st i).phase = .idle := by
  by_cases hi : i = id
  · rw [hi]
    exact releaseWorld_self_idle D w id a
  · exact absurd (releaseWorld_other_life D w id a i hi) hchg

/-- A release leaves an actor that is already dead and idle that way.
Resuming a parked sender rewrites a parked phase only. -/
theorem releaseWorld_keeps_dead_idle (D : Description) (w : World) (id : InstId) (a : Actor)
    (s : InstId) (hdead : (w.st s).life = .dead) (hidle : (w.st s).phase = .idle) :
    ((releaseWorld D w id a).st s).life = .dead ∧
      ((releaseWorld D w id a).st s).phase = .idle := by
  let wC := readCells D w id
  let wM := refundMsgs wC (tname id) a.box
  let wP := refundParked wM (tname id) a.parked
  let w1 := releaseOutbound wP id
  have hdead1 : (w1.st s).life = .dead :=
    (releaseOutbound_life wP id s).trans
      ((refundParked_phase_life wM (tname id) a.parked s).2.trans
        ((refundMsgs_phase_life wC (tname id) a.box s).2.trans
          ((congrArg Actor.life (cellsSt D w id s)).trans hdead)))
  have hidle1 : (w1.st s).phase = .idle :=
    (releaseOutbound_phase wP id s).trans
      ((refundParked_phase_life wM (tname id) a.parked s).1.trans
        ((refundMsgs_phase_life wC (tname id) a.box s).1.trans
          ((congrArg Actor.phase (cellsSt D w id s)).trans hidle)))
  let dead : Actor :=
    { w1.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hworld : releaseWorld D w id a = releaseParked (setActor w1 id dead) id a.parked := by
    simp [releaseWorld, wC, wM, wP, w1, dead]
  have hsetL : ((setActor w1 id dead).st s).life = .dead := by
    by_cases hs : s = id
    · simp [setActor, hs, dead]
    · simpa [setActor, hs] using hdead1
  have hsetP : ((setActor w1 id dead).st s).phase = .idle := by
    by_cases hs : s = id
    · simp [setActor, hs, dead]
    · simpa [setActor, hs] using hidle1
  rw [hworld]
  exact ⟨(releaseParked_life (setActor w1 id dead) id a.parked s).trans hsetL,
    releaseParked_keeps_idle (setActor w1 id dead) id a.parked s hsetP⟩

/-- A crash changes a life only by killing an alive roster actor into `.crashed`. -/
theorem crashWorld_died (w : World) (i : InstId)
    (hchg : ((crashWorld w).st i).life ≠ (w.st i).life) :
    ((crashWorld w).st i).life = .dead ∧ ((crashWorld w).st i).phase = .crashed := by
  simp only [crashWorld] at hchg ⊢
  by_cases hmem : decide (i ∈ w.roster) = true
  · simp only [hmem, ite_true, crashActor] at hchg ⊢
    by_cases hgo : ((w.st i).life == .alive) = true
    · simp [hgo]
    · simp [hgo] at hchg
  · simp [hmem] at hchg

/-- Crashing after a release kills a bystander into `.crashed` and leaves the
released actor dead and idle. -/
theorem crash_after_release (D : Description) (w : World) (id i : InstId)
    (hchg : ((crashWorld (releaseWorld D w id (w.st id))).st i).life ≠ (w.st i).life) :
    ((crashWorld (releaseWorld D w id (w.st id))).st i).life = .dead ∧
      (((crashWorld (releaseWorld D w id (w.st id))).st i).phase = .idle ∨
        ((crashWorld (releaseWorld D w id (w.st id))).st i).phase = .crashed) := by
  let wR := releaseWorld D w id (w.st id)
  by_cases hi : i = id
  · have h := releaseWorld_self_idle D w id (w.st id)
    have hk := crashWorld_keeps_idle wR id h.1 h.2
    simpa [wR, hi] using ⟨hk.1, Or.inl hk.2⟩
  · have heq := releaseWorld_other_life D w id (w.st id) i hi
    have hchgR : ((crashWorld wR).st i).life ≠ (wR.st i).life := by
      intro hr
      exact hchg (by simpa [wR] using hr.trans heq)
    have hd := crashWorld_died wR i hchgR
    simpa [wR] using ⟨hd.1, Or.inr hd.2⟩

/-- Shutting an actor down leaves one that is already dead and idle that way,
including when the tombstone crashes the roster. -/
theorem shutdownActor_keeps_dead_idle (D : Description) (w : World) (id s : InstId)
    (hdead : (w.st s).life = .dead) (hidle : (w.st s).phase = .idle) :
    ((shutdownActor D w id).st s).life = .dead ∧
      ((shutdownActor D w id).st s).phase = .idle := by
  unfold shutdownActor
  by_cases hlive : ((w.st id).life == .alive) = true
  · simp only [hlive, ite_true, sealActor]
    exact enqueueTombstone_keeps_idle D (releaseWorld D w id (w.st id)) id s
      (releaseWorld_keeps_dead_idle D w id (w.st id) s hdead hidle).1
      (releaseWorld_keeps_dead_idle D w id (w.st id) s hdead hidle).2
  · simp [hlive, hdead, hidle]

/-- A life that `shutdownActor` changes belongs to an actor that is now dead.
The subject is idle, even if its tombstone crashes the roster. A bystander
killed by that crash is in `.crashed` (DECISIONS.md 2026-11-21). -/
theorem shutdownActor_died (D : Description) (w : World) (id i : InstId)
    (hchg : ((shutdownActor D w id).st i).life ≠ (w.st i).life) :
    ((shutdownActor D w id).st i).life = .dead ∧
      (((shutdownActor D w id).st i).phase = .idle ∨
        ((shutdownActor D w id).st i).phase = .crashed) := by
  unfold shutdownActor at hchg ⊢
  by_cases hlive : ((w.st id).life == .alive) = true
  · simp only [hlive, ite_true, sealActor] at hchg ⊢
    unfold enqueueTombstone at hchg ⊢
    cases hpar : ((releaseWorld D w id (w.st id)).st id).parent with
    | none =>
      simp only [hpar] at hchg ⊢
      have h := releaseWorld_died D w id (w.st id) i hchg
      exact ⟨h.1, Or.inl h.2⟩
    | some parent =>
      simp only [hpar] at hchg ⊢
      by_cases hnot : (((releaseWorld D w id (w.st id)).st parent).life != .alive) = true
      · simp only [hnot, ite_true] at hchg ⊢
        have h := releaseWorld_died D w id (w.st id) i hchg
        exact ⟨h.1, Or.inl h.2⟩
      · have hnotF : (((releaseWorld D w id (w.st id)).st parent).life != .alive) = false := by
          simpa [Bool.not_eq_true] using hnot
        simp only [hnotF, ite_false] at hchg ⊢
        by_cases hlab : ((tombstoneMsg D ((releaseWorld D w id (w.st id)).st parent) id).label == "") = true
        · simp only [hlab, ite_true] at hchg ⊢
          exact crash_after_release D w id i hchg
        · have hlabF : ((tombstoneMsg D ((releaseWorld D w id (w.st id)).st parent) id).label == "") = false := by
            simpa [Bool.not_eq_true] using hlab
          simp only [hlabF, ite_false] at hchg ⊢
          by_cases hfull : decide (prioLoad ((releaseWorld D w id (w.st id)).st parent).prio >=
              capPrio D (releaseWorld D w id (w.st id)).N parent) = true
          · simp only [hfull, ite_true, offerPrio] at hchg ⊢
            exact crash_after_release D w id i hchg
          · have hroom : decide (prioLoad ((releaseWorld D w id (w.st id)).st parent).prio >=
                capPrio D (releaseWorld D w id (w.st id)).N parent) = false := by
              simpa [Bool.not_eq_true] using hfull
            simp only [hroom, ite_false, offerPrio] at hchg ⊢
            have hn : ¬(false = true) := by
              intro h
              cases h
            simp only [if_neg hn] at hchg ⊢
            by_cases hi : i = id
            · have h := releaseWorld_self_idle D w id (w.st id)
              by_cases hp : id = parent
              · rw [hp] at h
                rw [hi, hp]
                simp [setActor, h.1, h.2]
              · rw [hi]
                simp [setActor, hp, h.1, h.2]
            · have heq := releaseWorld_other_life D w id (w.st id) i hi
              by_cases hp : i = parent
              · rw [hp] at heq hchg
                simp [setActor] at hchg
                exact False.elim (hchg heq)
              · simp [setActor, hp, heq] at hchg
  · simp [hlive] at hchg

/-- Sealing a branch changes a life only by installing that actor dead and idle.
An actor that was already dead and idle stays so. A branch seal does not
enqueue a tombstone, so it does not crash the roster. -/
theorem sealBranch_track (fuel : Nat) (D : Description) :
    ∀ (root : InstId) (w : World),
      (∀ i, ((sealBranch fuel D w root).st i).life = (w.st i).life ∨
          (((sealBranch fuel D w root).st i).life = .dead ∧
            ((sealBranch fuel D w root).st i).phase = .idle)) ∧
        (∀ s, (w.st s).life = .dead → (w.st s).phase = .idle →
          ((sealBranch fuel D w root).st s).life = .dead ∧
            ((sealBranch fuel D w root).st s).phase = .idle) := by
  induction fuel with
  | zero =>
    intro root w
    simp only [sealBranch]
    exact ⟨fun _ => Or.inl trivial, fun _ hdead hidle => ⟨hdead, hidle⟩⟩
  | succ fuel ih =>
    intro root w
    simp only [sealBranch]
    let step (w0 : World) (child : InstId) : World :=
      if isChild w0 root child then sealBranch fuel D w0 child else w0
    have hfold : ∀ (ids : List InstId) (w0 : World),
        (∀ i, ((ids.foldl step w0).st i).life = (w0.st i).life ∨
            (((ids.foldl step w0).st i).life = .dead ∧
              ((ids.foldl step w0).st i).phase = .idle)) ∧
          (∀ s, (w0.st s).life = .dead → (w0.st s).phase = .idle →
            ((ids.foldl step w0).st s).life = .dead ∧
              ((ids.foldl step w0).st s).phase = .idle) := by
      intro ids
      induction ids with
      | nil =>
        intro w0
        simp only [List.foldl_nil]
        exact ⟨fun _ => Or.inl trivial, fun _ hdead hidle => ⟨hdead, hidle⟩⟩
      | cons c ids ihf =>
        intro w0
        simp only [List.foldl_cons, step]
        by_cases hch : isChild w0 root c = true
        · simp only [hch, ite_true]
          have hchild := ih c w0
          have htail := ihf (sealBranch fuel D w0 c)
          refine ⟨?_, ?_⟩
          · intro i
            rcases htail.1 i with heq | hd
            · rcases hchild.1 i with heq0 | hd0
              · exact Or.inl (heq.trans heq0)
              · exact Or.inr (htail.2 i hd0.1 hd0.2)
            · exact Or.inr hd
          · intro s hdead hidle
            exact htail.2 s (hchild.2 s hdead hidle).1 (hchild.2 s hdead hidle).2
        · have hf : isChild w0 root c = false := by
            cases hb : isChild w0 root c with
            | false => rfl
            | true => exact absurd hb hch
          simp only [hf, ite_false]
          exact ihf w0
    have hF := hfold w.roster w
    let sealed := w.roster.foldl step w
    split
    · next hgo =>
      refine ⟨?_, ?_⟩
      · intro i
        rcases hF.1 i with heq | hd
        · by_cases hi : i = root
          · exact Or.inr (by
              rw [hi]
              exact releaseWorld_self_idle D sealed root (sealed.st root))
          · exact Or.inl ((releaseWorld_other_life D sealed root (sealed.st root) i hi).trans heq)
        · exact Or.inr (releaseWorld_keeps_dead_idle D sealed root (sealed.st root) i hd.1 hd.2)
      · intro s hdead hidle
        have h1 := hF.2 s hdead hidle
        exact releaseWorld_keeps_dead_idle D sealed root (sealed.st root) s h1.1 h1.2
    · next hgo =>
      exact hF

/-- Sealing proper descendants changes a life only by installing that actor
dead and idle. The root is not released here. -/
theorem dropDescendants_track (D : Description) (w : World) (root : InstId) :
    (∀ i, ((dropDescendants D w root).st i).life = (w.st i).life ∨
        (((dropDescendants D w root).st i).life = .dead ∧
          ((dropDescendants D w root).st i).phase = .idle)) ∧
      (∀ s, (w.st s).life = .dead → (w.st s).phase = .idle →
        ((dropDescendants D w root).st s).life = .dead ∧
          ((dropDescendants D w root).st s).phase = .idle) := by
  unfold dropDescendants
  let step (w0 : World) (child : InstId) : World :=
    if isChild w0 root child then sealBranch w.roster.length D w0 child else w0
  have hfold : ∀ (ids : List InstId) (w0 : World),
      (∀ i, ((ids.foldl step w0).st i).life = (w0.st i).life ∨
          (((ids.foldl step w0).st i).life = .dead ∧
            ((ids.foldl step w0).st i).phase = .idle)) ∧
        (∀ s, (w0.st s).life = .dead → (w0.st s).phase = .idle →
          ((ids.foldl step w0).st s).life = .dead ∧
            ((ids.foldl step w0).st s).phase = .idle) := by
    intro ids
    induction ids with
    | nil =>
      intro w0
      simp only [List.foldl_nil]
      exact ⟨fun _ => Or.inl trivial, fun _ hdead hidle => ⟨hdead, hidle⟩⟩
    | cons c ids ihf =>
      intro w0
      simp only [List.foldl_cons, step]
      by_cases hch : isChild w0 root c = true
      · simp only [hch, ite_true]
        have hchild := sealBranch_track w.roster.length D c w0
        have htail := ihf (sealBranch w.roster.length D w0 c)
        refine ⟨?_, ?_⟩
        · intro i
          rcases htail.1 i with heq | hd
          · rcases hchild.1 i with heq0 | hd0
            · exact Or.inl (heq.trans heq0)
            · exact Or.inr (htail.2 i hd0.1 hd0.2)
          · exact Or.inr hd
        · intro s hdead hidle
          exact htail.2 s (hchild.2 s hdead hidle).1 (hchild.2 s hdead hidle).2
      · have hf : isChild w0 root c = false := by
          cases hb : isChild w0 root c with
          | false => rfl
          | true => exact absurd hb hch
        simp only [hf, ite_false]
        exact ihf w0
  simpa [step] using hfold w.roster w

/-- Queueing a tombstone, or crashing because it does not fit, leaves a dead
idle actor dead and idle. -/
theorem tombstone_keeps_dead (D : Description) (w : World) (child s : InstId)
    (hdead : (w.st s).life = .dead) (hidle : (w.st s).phase = .idle) :
    ((enqueueTombstone D w child).st s).life = .dead ∧
      ((enqueueTombstone D w child).st s).phase = .idle :=
  enqueueTombstone_keeps_idle D w child s hdead hidle

/-- A life that `terminateStage` changes is dead afterwards. A sealed descendant
and the stage itself are idle. A bystander killed because the stage's tombstone
does not fit is in `.crashed`. -/
theorem terminate_died_idle (D : Description) (w : World) (id i : InstId)
    (hchg : ((terminateStage D w id (w.st id)).st i).life ≠ (w.st i).life) :
    ((terminateStage D w id (w.st id)).st i).life = .dead ∧
      (((terminateStage D w id (w.st id)).st i).phase = .idle ∨
        ((terminateStage D w id (w.st id)).st i).phase = .crashed) := by
  simp only [terminateStage] at hchg ⊢
  let w1 := dropDescendants D w id
  rcases (dropDescendants_track D w id).1 i with heq | hd
  · have hchg1 : ((shutdownActor D w1 id).st i).life ≠ (w1.st i).life := by
      rw [heq]
      exact hchg
    simpa [w1] using shutdownActor_died D w1 id i hchg1
  · have hkeep := shutdownActor_keeps_dead_idle D w1 id i hd.1 hd.2
    exact ⟨hkeep.1, Or.inl hkeep.2⟩

/-- An actor with no recorded parent is not a strict descendant of anyone. -/
theorem orphan_not_desc (w : World) (i root : InstId) (hp : (w.st i).parent = none) :
    ¬ StrictAncestor w i root := by
  intro h
  induction h with
  | edge he =>
    rcases he with ⟨hp', _⟩
    simp [hp] at hp'
  | tail he _ _ =>
    rcases he with ⟨hp', _⟩
    simp [hp] at hp'

/-- `terminate` of someone else leaves `i` at the same life when the tombstone
did not crash the roster and `i` is not a descendant of the stage. A crash
kills every live roster actor, and a descendant is sealed whether or not its
template is terminable. -/
theorem terminate_spares (D : Description) (w : World) (id i : InstId)
    (hne : i ≠ id) (hcr : (terminateStage D w id (w.st id)).crashed = false)
    (hanc : ¬ StrictAncestor w i id) :
    ((terminateStage D w id (w.st id)).st i).life = (w.st i).life := by
  simp only [terminateStage] at hcr ⊢
  rcases (dropDescendants_stable D w id).2.2 i with heq | hdesc
  · exact (shutdownActor_other_life D (dropDescendants D w id) id i hne hcr).trans heq
  · exact absurd hdesc hanc

/-- A reachable `terminate` head leaves its actor dead. A per-peer seal is
idle, including when the tombstone then crashes the roster. A multiplicity-one
core crashes the node, so the phase is `.crashed` (DECISIONS.md 2026-11-21). -/
theorem terminate_commits (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (hT : TermOk I w) (id : InstId) (k : Cont) (es : List Eff)
    (hph : (w.st id).phase = .run { k with rest := .terminate :: es })
    (hl : (w.st id).life = .alive) :
    ((execRun I w id (w.st id) { k with rest := .terminate :: es }).st id).life = .dead ∧
      (((execRun I w id (w.st id) { k with rest := .terminate :: es }).st id).phase = .idle ∨
        ((execRun I w id (w.st id) { k with rest := .terminate :: es }).st id).phase = .crashed) := by
  have _hterm := hT id (.terminate :: es) (by simp [carried, hph]) (by simp [hasTerminate, effTerminates])
  have hstep := exec_term_step I w id (w.st id) { k with rest := .terminate :: es } hl ⟨es, rfl⟩
  have hO := (inv2_reachable I hL hG N w hR).2.1
  have hmem : id ∈ w.roster := hO.aliveIn id hl
  generalize hw : execRun I w id (w.st id) { k with rest := .terminate :: es } = wE at hstep ⊢
  cases hstep with
  | fall =>
    have hdead : ((crashWorld w).st id).life = .dead := by simp [crashWorld, crashActor, hmem, hl]
    have hphase : ((crashWorld w).st id).phase = .crashed := by simp [crashWorld, crashActor, hmem, hl]
    simpa [hw] using And.intro hdead (Or.inr hphase)
  | crash _ _ _ =>
    have hdead : ((crashWorld w).st id).life = .dead := by simp [crashWorld, crashActor, hmem, hl]
    have hphase : ((crashWorld w).st id).phase = .crashed := by simp [crashWorld, crashActor, hmem, hl]
    simpa [hw] using And.intro hdead (Or.inr hphase)
  | lone _ _ _ _ _ _ _ =>
    have h := shutdownActor_alive_idle I.desc w id hl
    simpa [hw] using And.intro h.1 (Or.inl h.2)
  | tree _ _ _ _ =>
    have h := terminate_alive_idle I.desc w id ((inv_reachable I N w hL hR).forest).wf hl
    simpa [hw] using And.intro h.1 (Or.inl h.2)
  | cascade _ _ _ _ _ _ _ =>
    have h := terminate_alive_idle I.desc w id ((inv_reachable I N w hL hR).forest).wf hl
    simpa [hw] using And.intro h.1 (Or.inl h.2)

theorem term_ok_of (I : Impl) (hL : LocalOk I) (w w' : World) (hT : TermOk I w)
    (hjust : ∀ i es, carried (w'.st i).phase = some es → hasTerminate es = true →
      (∃ es0, carried (w.st i).phase = some es0 ∧ (es = es0 ∨ ∃ e, es0 = e :: es)) ∨
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ es = tr.program) : TermOk I w' := by
  intro i es hc ht
  rcases hjust i es hc ht with ⟨es0, hc0, hsub⟩ | ⟨tr, hm, htmpl, hprog⟩
  · rcases hsub with rfl | ⟨e, heq⟩
    · exact hT i es hc0 ht
    · exact hT i es0 hc0 (by simpa [heq] using hasTerminate_cons e es ht)
  · rw [← htmpl]
    cases htpl : templateOf I.desc tr.template with
    | none =>
      have hok := transitionOk_of_mem I hL tr hm
      simp [transitionOk, htpl] at hok
    | some t =>
      exact ⟨t, htpl, term_program I hL tr hm (by simpa [hprog] using ht) t htpl⟩

theorem term_ok_finish (I : Impl) (hL : LocalOk I) (w w' : World) (id : InstId) (hT : TermOk I w)
    (h : finishWait I w id = some w') : TermOk I w' := by
  obtain ⟨k, hph, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  apply term_ok_of I hL w _ hT
  intro i es hc ht
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    simp [setActor] at hc
    cases hk : k.rest with
    | nil => simp [proceed, hk, carried] at hc
    | cons _ _ =>
      simp [proceed, hk, carried] at hc
      exact Or.inl ⟨k.rest, by
        rcases hph with hph | hph <;> simp [carried, hph], Or.inl (by simp [hc, hk])⟩
  · simp [setActor, hi] at hc
    exact Or.inl ⟨es, hc, Or.inl rfl⟩

theorem deliver_carries (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg) (w1 : World)
    (a1 : Actor) (es : List Eff) (h : deliver I w id a m = some (w1, a1))
    (hc : carried a1.phase = some es) : ∃ tr ∈ I.transitions, tr.template = tname id ∧ es = tr.program := by
  unfold deliver at h
  by_cases hlive : a.life ≠ .alive
  · simp [hlive] at h
  · simp only [hlive, ite_false] at h
    let wC := readCells I.desc w id
    by_cases htomb : (m.tombstone && newerGeneration wC m) = true
    · simp [wC, htomb] at h
      rcases h with ⟨_, ha⟩
      subst ha
      simp [carried] at hc
    · have htombF : (m.tombstone && newerGeneration wC m) = false := by
        simpa [Bool.not_eq_true] using htomb
      simp only [wC, htombF, ite_false] at h
      cases hfind : findDeliver I (tname id) a.typestate m with
      | none =>
        simp only [hfind] at h
        by_cases hkeep : (m.callFrom.isSome || m.tombstone) = true
        · simp [hkeep] at h
        · simp [hkeep] at h
          rcases h with ⟨_, ha⟩
          subst ha
          simp [carried] at hc
      | some tr =>
        simp only [hfind] at h
        by_cases hacc : (m.callFrom.isSome && !tr.acceptsCall) = true
        · simp [hacc] at h
        · have haccF : (m.callFrom.isSome && !tr.acceptsCall) = false := by
            simpa [Bool.not_eq_true] using hacc
          simp only [haccF, ite_false] at h
          have ⟨_, ha⟩ := Prod.mk.inj (Option.some.inj h)
          subst ha
          by_cases hempty : tr.program.isEmpty = true
          · simp [hempty, carried] at hc
          · simp [hempty, carried] at hc
            have hmem := findDeliver_mem I (tname id) a.typestate m tr hfind
            exact ⟨tr, hmem.1, hmem.2.1, by simpa [hc]⟩

theorem term_ok_prio (I : Impl) (hL : LocalOk I) (w w' : World) (id : InstId) (hT : TermOk I w)
    (h : receivePrio I w id = some w') : TermOk I w' := by
  apply term_ok_of I hL w w' hT
  intro i es hc ht
  obtain ⟨m, _pre, _suf, w1, a1, _hlife, _hidle, _hprio, _hwait, hdel, hw'⟩ :=
    receivePrio_spec I w w' id h
  rw [hw'] at hc
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    have hc' : carried a1.phase = some es := by simpa [setActor] using hc
    obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc'
    exact Or.inr ⟨tr, hm, htmpl, hprog⟩
  · have hst := deliver_st I w id _ m w1 a1 i hdel
    have hc0 : carried (w.st i).phase = some es := by
      simpa [setActor, hi, hst] using hc
    exact Or.inl ⟨es, hc0, Or.inl rfl⟩

theorem carried_resume (a : Actor) (b : Bool) (dst : InstId) (es : List Eff)
    (h : carried (resumeSender a b dst).phase = some es) : carried a.phase = some es := by
  cases hph : a.phase with
  | parked _ _ k =>
    cases b with
    | true => simp [resumeSender, hph, carried] at h ⊢; exact h
    | false =>
      cases hk : k.rest with
      | nil => simp [resumeSender, hph, proceed, hk, carried] at h
      | cons _ _ => simp [resumeSender, hph, proceed, hk, carried] at h ⊢; exact h
  | idle => simp [resumeSender, hph, carried] at h
  | run k => simp [resumeSender, hph, carried] at h ⊢; exact h
  | awaitReply _ k => simp [resumeSender, hph, carried] at h ⊢; exact h
  | awaitEffect k => simp [resumeSender, hph, carried] at h ⊢; exact h
  | awaitPeer k => simp [resumeSender, hph, carried] at h ⊢; exact h
  | crashed => simp [resumeSender, hph, carried] at h

theorem spawn_phase (I : Impl) (w w' : World) (template : String) (i : InstId)
    (h : spawn I w template = some w') :
    (∃ k, (w'.st i).phase = .idle ∧ i = InstId.peer template k (maxGen w template k)) ∨
      (w'.st i).phase = (w.st i).phase := by
  simp only [spawn] at h
  cases ht : templateOf I.desc template with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hmay : maySpawnRoot I.desc w template t = true
    · simp only [hmay, ite_true] at h
      cases hsup : t.supervisor with
      | some name =>
        simp only [hsup] at h
        let k := freshKey I.desc w t.subtree
        cases h
        have hph := placePeer_phase I w template k t.initial (some (.core name))
          (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
          i (by intro _; rfl)
        unfold k at hph
        by_cases hi : i = InstId.peer template k (maxGen w template k)
        · unfold k at hi
          exact Or.inl ⟨k, by rw [hph]; simp [hi], hi⟩
        · unfold k at hi
          exact Or.inr (by rw [hph]; simp [hi])
      | none =>
        simp only [hsup] at h
        by_cases hsub : (t.subtree == "") = true
        · simp only [hsub, ite_true] at h
          let k := w.nextIx template
          cases h
          have hph := placePeer_phase I w template k t.initial none
            (fun w1 => { w1 with nextIx := fun n => if n = template then k + 1 else w1.nextIx n })
            i (by intro _; rfl)
          unfold k at hph
          by_cases hi : i = InstId.peer template k (maxGen w template k)
          · unfold k at hi
            exact Or.inl ⟨k, by rw [hph]; simp [hi], hi⟩
          · unfold k at hi
            exact Or.inr (by rw [hph]; simp [hi])
        · have hsubF : (t.subtree == "") = false := by
            simpa [Bool.not_eq_true] using hsub
          simp only [hsubF, ite_false] at h
          let k := freshKey I.desc w t.subtree
          cases h
          have hph := placePeer_phase I w template k t.initial none
            (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
            i (by intro _; rfl)
          unfold k at hph
          by_cases hi : i = InstId.peer template k (maxGen w template k)
          · unfold k at hi
            exact Or.inl ⟨k, by rw [hph]; simp [hi], hi⟩
          · unfold k at hi
            exact Or.inr (by rw [hph]; simp [hi])
    · simp [hmay] at h

/-- A root spawn writes the fresh peer. An actor already on the roster is unchanged. -/
theorem spawn_roster_st (I : Impl) (w w' : World) (template : String) (s : InstId)
    (hmem : s ∈ w.roster) (h : spawn I w template = some w') : w'.st s = w.st s := by
  simp only [spawn] at h
  cases ht : templateOf I.desc template with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hmay : maySpawnRoot I.desc w template t = true
    · simp only [hmay, ite_true] at h
      cases hsup : t.supervisor with
      | some name =>
        simp only [hsup] at h
        let k := freshKey I.desc w t.subtree
        cases h
        have hne : s ≠ InstId.peer template k (maxGen w template k) := by
          intro hs
          exact Nat.lt_irrefl _ (maxGen_fresh w template k _ (hs ▸ hmem))
        have hfalse : (s = InstId.peer template k (maxGen w template k)) = False := eq_false hne
        unfold k at hfalse
        simp [placePeer, readCells_st, setActor, hfalse, ite_false]
      | none =>
        simp only [hsup] at h
        by_cases hsub : (t.subtree == "") = true
        · simp only [hsub, ite_true] at h
          let k := w.nextIx template
          cases h
          have hne : s ≠ InstId.peer template k (maxGen w template k) := by
            intro hs
            exact Nat.lt_irrefl _ (maxGen_fresh w template k _ (hs ▸ hmem))
          have hfalse : (s = InstId.peer template k (maxGen w template k)) = False := eq_false hne
          unfold k at hfalse
          simp [placePeer, readCells_st, setActor, hfalse, ite_false]
        · have hsubF : (t.subtree == "") = false := by
            simpa [Bool.not_eq_true] using hsub
          simp only [hsubF, ite_false] at h
          let k := freshKey I.desc w t.subtree
          cases h
          have hne : s ≠ InstId.peer template k (maxGen w template k) := by
            intro hs
            exact Nat.lt_irrefl _ (maxGen_fresh w template k _ (hs ▸ hmem))
          have hfalse : (s = InstId.peer template k (maxGen w template k)) = False := eq_false hne
          unfold k at hfalse
          simp [placePeer, readCells_st, setActor, hfalse, ite_false]
    · simp [hmay] at h

theorem term_ok_spawn (I : Impl) (hL : LocalOk I) (w w' : World) (template : String) (hT : TermOk I w)
    (h : spawn I w template = some w') : TermOk I w' := by
  apply term_ok_of I hL w w' hT
  intro i es hc ht
  rcases spawn_phase I w w' template i h with ⟨_k, hidle, _hi⟩ | heq
  · simp [hidle, carried] at hc
  · exact Or.inl ⟨es, by simpa [heq] using hc, Or.inl rfl⟩

theorem term_ok_bulk (I : Impl) (hL : LocalOk I) (w w' : World) (id : InstId) (hT : TermOk I w)
    (h : receiveBulk I w id = some w') : TermOk I w' := by
  apply term_ok_of I hL w w' hT
  intro i es hc ht
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hc
              have hph : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender).phase = a1.phase := by
                simp [creditLive, phase_credit, setActor, hs]
              have hold := carried_resume
                ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender) p.isCall p.sender es
                (by simpa [setActor, hs] using hc)
              have hc1 : carried a1.phase = some es := by simpa [hph] using hold
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ p.msg w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, hprog⟩
            · have hc1 : carried a1.phase = some es := by
                simpa [setActor, hs, creditLive, phase_credit] using hc
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ p.msg w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, hprog⟩
          · by_cases hs : i = p.sender
            · rw [hs] at hc
              have hpre : carried ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender).phase =
                  some es := carried_resume _ p.isCall id es (by simpa [setActor] using hc)
              have hst := deliver_st I w id _ p.msg w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hc0 : carried (w.st p.sender).phase = some es := by
                simpa [setActor, hne, creditLive, phase_credit, hst] using hpre
              exact Or.inl ⟨es, by simpa [hs] using hc0, Or.inl rfl⟩
            · have hst := deliver_st I w id _ p.msg w1 a1 i hdel
              have hc0 : carried (w.st i).phase = some es := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst] using hc
              exact Or.inl ⟨es, hc0, Or.inl rfl⟩
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            have hc1 : carried a1.phase = some es := by
              simpa [setActor, creditLive, phase_credit] using hc
            obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
            exact Or.inr ⟨tr, hm, htmpl, hprog⟩
          · have hst := deliver_st I w id _ m w1 a1 i hdel
            have hc0 : carried (w.st i).phase = some es := by
              simpa [setActor, hid, creditLive, phase_credit, hst] using hc
            exact Or.inl ⟨es, hc0, Or.inl rfl⟩
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hphA : admitted.phase = a1.phase := by simp [admitted]
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hc
              have hpre := carried_resume _ p.isCall p.sender es (by simpa [setActor, hs] using hc)
              have hc1 : carried a1.phase = some es := by
                simpa [creditLive, phase_credit, setActor, hphA, hs] using hpre
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, hprog⟩
            · have hc1 : carried a1.phase = some es := by
                simpa [setActor, hs, creditLive, phase_credit, hphA] using hc
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, hprog⟩
          · by_cases hs : i = p.sender
            · rw [hs] at hc
              have hpre := carried_resume _ p.isCall id es (by simpa [setActor] using hc)
              have hst := deliver_st I w id _ m w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hc0 : carried (w.st p.sender).phase = some es := by
                simpa [setActor, hne, creditLive, phase_credit, hst, hphA] using hpre
              exact Or.inl ⟨es, by simpa [hs] using hc0, Or.inl rfl⟩
            · have hst := deliver_st I w id _ m w1 a1 i hdel
              have hc0 : carried (w.st i).phase = some es := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst, hphA] using hc
              exact Or.inl ⟨es, hc0, Or.inl rfl⟩

theorem carried_proceed (a : Actor) (k : Cont) (es : List Eff)
    (h : carried (proceed a k).phase = some es) : es = k.rest := by
  cases hk : k.rest with
  | nil => simp [proceed, hk, carried] at h
  | cons _ _ =>
    simp [proceed, hk, carried] at h
    exact h.symm

/-- A resolved route names an alive actor. A core route checks that life, and a
per-peer route is `findLive`. -/
theorem route_alive (w : World) (D : Description) (sender : InstId) (dst : String) (id : InstId)
    (h : route w D sender dst = some id) : (w.st id).life = .alive := by
  unfold route at h
  cases ht : templateOf D dst with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    cases hmul : t.multiplicity with
    | one =>
      simp only [hmul] at h
      by_cases hbit : ((w.st (InstId.core dst)).life == .alive) = true
      · simp only [hbit, ite_true] at h
        cases h
        exact (beq_iff_eq).mp hbit
      · simp [hbit] at h
    | perPeer =>
      simp only [hmul] at h
      cases hk : memberKey sender with
      | none => simp [hk] at h
      | some key =>
        simp only [hk] at h
        unfold findLive at h
        have hp := List.find?_some h
        cases id with
        | core _ => simp at hp
        | peer n k gen =>
          rw [Bool.and_eq_true] at hp
          exact (beq_iff_eq).mp hp.2

/-- The continuation a sender is left in is its current rest, when the target is
alive or the effect is not a call. A call to a dead target takes `NotAdmitted`
instead, so that arm is excluded here (DECISIONS.md 2026-11-22). -/
theorem enqueue_carried (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (b : Bool) (k : Cont) (es : List Eff)
    (hgate : (w.st dst).life = .alive ∨ b = false)
    (h : carried ((enqueueOrPark w D sender dst msg b k).st sender).phase = some es) : es = k.rest := by
  by_cases hlive : (w.st dst).life = .alive
  · by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hparkS : (w.st sender).parked = [] := by rw [hsame]; exact hroom.1
        have hcapS : (w.st sender).box.length < capBulk D w.N sender := by rw [hsame]; exact hroom.2
        rw [← hsame] at h
        cases b with
        | true =>
          rw [enqueue_room_self_call w D sender msg k hliveS hparkS hcapS] at h
          simp [setActor, carried] at h
          exact h.symm
        | false =>
          rw [enqueue_room_self_send w D sender msg k hliveS hparkS hcapS] at h
          exact carried_proceed _ k es (by simpa [setActor] using h)
      · cases b with
        | true =>
          rw [enqueue_room_other_call w D sender dst msg k hlive hsame hroom.1 hroom.2] at h
          simp [setActor, carried] at h
          exact h.symm
        | false =>
          rw [enqueue_room_other_send w D sender dst msg k hlive hsame hroom.1 hroom.2] at h
          exact carried_proceed _ k es (by simpa [setActor] using h)
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hroomS : ¬ ((w.st sender).parked = [] ∧ (w.st sender).box.length < capBulk D w.N sender) := by
          rw [hsame]; exact hroom
        rw [← hsame] at h
        rw [enqueue_park_self w D sender msg b k hliveS hroomS] at h
        simp [setActor, carried] at h
        exact h.symm
      · rw [enqueue_park_other w D sender dst msg b k hlive hsame hroom] at h
        simp [setActor, carried] at h
        exact h.symm
  · have hb : b = false := by
      rcases hgate with hl | hb
      · exact absurd hl hlive
      · exact hb
    rw [hb] at h
    rw [enqueue_dead w D sender dst msg k hlive] at h
    exact carried_proceed _ k es (by simpa [setActor] using h)

theorem release_carried (w : World) (id : InstId) (ps : List Parked) (i : InstId) (es : List Eff)
    (h : carried ((releaseParked w id ps).st i).phase = some es) : carried (w.st i).phase = some es := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons] at h
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip] at h
      exact ih _ h
    · rw [if_neg hskip] at h
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id)) h
      by_cases hi : i = p.sender
      · exact carried_resume _ false id es (by simpa [setActor, hi] using hmid)
      · simpa [setActor, hi] using hmid

theorem reply_sender_rest (w : World) (sender : InstId) (k : Cont) (es : List Eff)
    (h : carried ((performReply w sender k).st sender).phase = some es) : es = (afterHead k).rest := by
  unfold performReply at h
  cases hr : k.replyTo with
  | none =>
    simp [hr, setActor] at h
    exact carried_proceed _ _ _ h
  | some caller =>
    simp [hr] at h
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      by_cases hd : dst = sender
      · by_cases ho : (w.st sender).oweId = some (w.st caller).waitId
        · by_cases hs : sender = caller
          · subst hs
            simp [hph, hd, ho, setActor] at h
            exact carried_proceed _ (afterHead k) es h
          · have hne : sender ≠ caller := hs
            simp [hph, hd, ho, hne, setActor] at h
            exact carried_proceed _ (afterHead k) es h
        · simp [hph, hd, ho, setActor] at h
          exact carried_proceed _ (afterHead k) es h
      · simp [hph, hd, setActor] at h
        exact carried_proceed _ (afterHead k) es h
    | idle => simp [hph, setActor] at h; exact carried_proceed _ _ _ h
    | run ck => simp [hph, setActor] at h; exact carried_proceed _ _ _ h
    | parked _ _ ck => simp [hph, setActor] at h; exact carried_proceed _ _ _ h
    | awaitEffect ck => simp [hph, setActor] at h; exact carried_proceed _ _ _ h
    | awaitPeer ck => simp [hph, setActor] at h; exact carried_proceed _ _ _ h
    | crashed => simp [hph, setActor] at h; exact carried_proceed _ _ _ h

theorem failWaiter_carried (w : World) (dead i s : InstId) :
    carried ((failWaiter w dead i).st s).phase = none ∨
      carried ((failWaiter w dead i).st s).phase = carried ((w.st s).phase) := by
  unfold failWaiter
  by_cases hlive : ((w.st i).life != .alive) = true
  · simp [hlive]
  · have hliveF : ((w.st i).life != .alive) = false := by
      simpa [Bool.not_eq_true] using hlive
    simp only [hliveF, ite_false]
    cases hph : (w.st i).phase with
    | parked d b k =>
      cases b with
      | true =>
        simp [hph]
      | false =>
        by_cases hd : (d == dead) = true
        · simp [hph, hd]
          by_cases hs : s = i
          · subst hs
            cases hk : k.rest with
            | nil => exact Or.inl (by simp [setActor, proceed, carried, hk])
            | cons _ _ => exact Or.inr (by simp [setActor, proceed, carried, hk, hph])
          · exact Or.inr (by simp [setActor, hs])
        · have hdF : (d == dead) = false := by
            simpa [Bool.not_eq_true] using hd
          simp [hph, hdF]
    | idle =>
      simp [hph]
    | run _ =>
      simp [hph]
    | awaitReply _ _ =>
      simp [hph]
    | awaitEffect _ =>
      simp [hph]
    | awaitPeer _ =>
      simp [hph]
    | crashed =>
      simp [hph]

theorem failFold_carried (w : World) (dead s : InstId) (ids : List InstId) :
    carried ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase = none ∨
      carried ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase =
        carried ((w.st s).phase) := by
  induction ids generalizing w with
  | nil => exact Or.inr rfl
  | cons i ids ih =>
    simp only [List.foldl_cons]
    rcases failWaiter_carried w dead i s with hnone | heq
    · have hph : holdsPhase ((failWaiter w dead i).st s).phase = true := by
        cases hp : ((failWaiter w dead i).st s).phase with
        | idle => simp [holdsPhase]
        | crashed => simp [holdsPhase]
        | run _ => simp [carried, hp] at hnone
        | parked _ _ _ => simp [carried, hp] at hnone
        | awaitReply _ _ => simp [carried, hp] at hnone
        | awaitEffect _ => simp [carried, hp] at hnone
        | awaitPeer _ => simp [carried, hp] at hnone
      exact Or.inl (by rw [(failFold_holds (failWaiter w dead i) dead s ids hph).1]; exact hnone)
    · rcases ih (failWaiter w dead i) with hnone | hrest
      · exact Or.inl hnone
      · exact Or.inr (hrest.trans heq)

theorem releaseWorld_carried (D : Description) (w : World) (id : InstId) (a : Actor)
    (i : InstId) (es : List Eff)
    (h : carried ((releaseWorld D w id a).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  let base :=
    releaseOutbound (refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked) id
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  rw [hworld] at h
  by_cases hi : i = id
  · have hv := (release_keeps_victim (setActor base id dead) id a.parked).1
    rw [hi, hv] at h
    simp [setActor, dead, carried] at h
  · have hrel := release_carried (setActor base id dead) id a.parked i es h
    have hph : ((setActor base id dead).st i).phase = (w.st i).phase := by
      simp [setActor, hi, base, releaseOutbound_phase, phase_refundP, phase_refund, readCells_st]
    simpa [hph] using hrel

/-- A crash rewrites alive roster actors to `.crashed`, which carries no
continuation. An actor it leaves in place keeps the continuation it had. -/
theorem crash_carried (w : World) (i : InstId) (es : List Eff)
    (h : carried ((crashWorld w).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold crashWorld at h
  by_cases hmem : decide (i ∈ w.roster) = true
  · simp only [hmem, ite_true, crashActor] at h
    by_cases hgo : ((w.st i).life == .alive) = true
    · simp [hgo, carried] at h
    · simp [hgo] at h
      exact h
  · have hmemF : decide (i ∈ w.roster) = false := by
      simpa [Bool.not_eq_true] using hmem
    simp only [hmemF, ite_false] at h
    exact h

/-- Queueing a tombstone, or crashing because it does not fit, does not invent
a continuation. -/
theorem enqueueTombstone_carried (D : Description) (w : World) (child i : InstId) (es : List Eff)
    (h : carried ((enqueueTombstone D w child).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold enqueueTombstone at h
  cases hpar : (w.st child).parent with
  | none =>
    simpa [hpar] using h
  | some parent =>
    simp only [hpar] at h
    by_cases hnot : ((w.st parent).life != .alive) = true
    · simp [hnot] at h
      exact h
    · have hnotF : ((w.st parent).life != .alive) = false := by
        simpa [Bool.not_eq_true] using hnot
      simp only [hnotF, ite_false] at h
      by_cases hlab : ((tombstoneMsg D (w.st parent) child).label == "") = true
      · simp only [hlab, ite_true] at h
        exact crash_carried w i es h
      · have hlabF : ((tombstoneMsg D (w.st parent) child).label == "") = false := by
          simpa [Bool.not_eq_true] using hlab
        simp only [hlabF, ite_false] at h
        by_cases hfull : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = true
        · simp only [hfull, ite_true, offerPrio] at h
          exact crash_carried w i es h
        · have hroom : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp only [hroom, ite_false, offerPrio] at h
          by_cases hi : i = parent
          · rw [hi] at h ⊢
            simp [setActor, carried] at h
            exact h
          · simp [setActor, hi] at h
            exact h

/-- Sealing a live actor refunds its mailbox and queues a tombstone. A
continuation still present afterwards was already there. -/
theorem shutdown_carried (D : Description) (w : World) (id i : InstId) (es : List Eff)
    (h : carried ((shutdownActor D w id).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold shutdownActor at h
  by_cases hlive : ((w.st id).life == .alive) = true
  · simp only [hlive, ite_true, sealActor] at h
    exact releaseWorld_carried D w id (w.st id) i es
      (enqueueTombstone_carried D (releaseWorld D w id (w.st id)) id i es h)
  · simp [hlive] at h
    exact h

/-- Sealing a branch only releases descendants. A continuation that remains
was already carried. -/
theorem seal_carried (fuel : Nat) (D : Description) :
    ∀ (w : World) (root i : InstId) (es : List Eff),
      carried ((sealBranch fuel D w root).st i).phase = some es →
        carried (w.st i).phase = some es := by
  induction fuel with
  | zero =>
    intro w root i es h
    simpa [sealBranch] using h
  | succ fuel ih =>
    intro w root i es h
    simp only [sealBranch] at h
    let step (w0 : World) (child : InstId) : World :=
      if isChild w0 root child then sealBranch fuel D w0 child else w0
    have hfold : ∀ (ids : List InstId) (w0 : World),
        carried ((ids.foldl step w0).st i).phase = some es →
          carried (w0.st i).phase = some es := by
      intro ids
      induction ids with
      | nil =>
        intro w0 h0
        simpa [List.foldl_nil] using h0
      | cons c ids ihf =>
        intro w0 h0
        simp only [List.foldl_cons, step] at h0
        by_cases hch : isChild w0 root c = true
        · simp only [hch, ite_true] at h0
          exact ih w0 c i es (ihf _ h0)
        · have hf : isChild w0 root c = false := by
            cases hb : isChild w0 root c with
            | false => rfl
            | true => exact absurd hb hch
          simp only [hf, ite_false] at h0
          exact ihf _ h0
    have hpre := hfold w.roster w
    split at h
    · next hgo =>
      exact hpre (releaseWorld_carried D _ root _ i es h)
    · next hgo =>
      exact hpre h

theorem drop_carried (D : Description) (w : World) (root i : InstId) (es : List Eff)
    (h : carried ((dropDescendants D w root).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold dropDescendants at h
  let step (w0 : World) (child : InstId) : World :=
    if isChild w0 root child then sealBranch w.roster.length D w0 child else w0
  have hfold : ∀ (ids : List InstId) (w0 : World),
      carried ((ids.foldl step w0).st i).phase = some es →
        carried (w0.st i).phase = some es := by
    intro ids
    induction ids with
    | nil =>
      intro w0 h0
      simpa [List.foldl_nil] using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons, step] at h0
      by_cases hch : isChild w0 root c = true
      · simp only [hch, ite_true] at h0
        exact seal_carried w.roster.length D w0 c i es (ihf _ h0)
      · have hf : isChild w0 root c = false := by
          cases hb : isChild w0 root c with
          | false => rfl
          | true => exact absurd hb hch
        simp only [hf, ite_false] at h0
        exact ihf _ h0
  exact hfold w.roster w h

/-- A continuation still present after `terminate` was already there. Going idle
drops the continuation, and resuming a nonempty one keeps it. -/
theorem terminate_carried (D : Description) (w : World) (id i : InstId) (es : List Eff)
    (h : carried ((terminateStage D w id (w.st id)).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  simp only [terminateStage] at h
  exact drop_carried D w id i es (shutdown_carried D (dropDescendants D w id) id i es h)

theorem killOne_carried (w : World) (D : Description) (id s : InstId) :
    carried ((killOne w D id).st s).phase = none ∨
      carried ((killOne w D id).st s).phase = carried ((w.st s).phase) := by
  by_cases hs : s = id
  · exact Or.inl (by rw [hs, (killOne_self w D id).2.1]; simp [carried])
  · let w1 := readCells D w id
    have hst1 : w1.st s = w.st s := cellsSt D w id s
    let w2 := refundMsgs w1 (tname id) (w.st id).box
    have h2 := refundMsgs_rest w1 (tname id) (w.st id).box s
    let w3 := refundParked w2 (tname id) (w.st id).parked
    have h3 := refundParked_rest w2 (tname id) (w.st id).parked s
    have hpre : carried ((w3.st s).phase) = carried ((w.st s).phase) := by
      rw [h3.1, h2.1, congrArg (·.phase) hst1]
    rcases failFold_carried w3 id s w3.roster with hnone | heq
    · let w4 := failWaiters w3 id
      let w5 := forgetSender w4 id
      have hbody : killOne w D id =
          setActor w5 id { w5.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] } := by
        simp [killOne, w1, w2, w3, w4, w5, failWaiters, forgetSender]
      rw [hbody, setActor_other _ _ _ _ hs]
      have h5p : (w5.st s).phase = (w4.st s).phase := (forget_stable w4 id s).1
      exact Or.inl (by rw [h5p]; simpa [w4, failWaiters] using hnone)
    · let w4 := failWaiters w3 id
      let w5 := forgetSender w4 id
      have hbody : killOne w D id =
          setActor w5 id { w5.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] } := by
        simp [killOne, w1, w2, w3, w4, w5, failWaiters, forgetSender]
      rw [hbody, setActor_other _ _ _ _ hs]
      have h5p : (w5.st s).phase = (w4.st s).phase := (forget_stable w4 id s).1
      have heq' : carried ((w4.st s).phase) = carried ((w3.st s).phase) := by
        simpa [w4, failWaiters] using heq
      exact Or.inr (by rw [h5p]; exact heq'.trans hpre)

theorem killFold_carried (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (s : InstId) :
    carried ((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st s).phase =
        none ∨
      carried ((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st s).phase =
        carried ((w.st s).phase) := by
  induction ids generalizing w with
  | nil => exact Or.inr rfl
  | cons j ids ih =>
    simp only [List.foldl_cons]
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true]
      rcases killOne_carried w D j s with hstep | heq
      · rcases ih (killOne w D j) with hnone | hrest
        · exact Or.inl hnone
        · exact Or.inl (hrest.trans hstep)
      · rcases ih (killOne w D j) with hnone | hrest
        · exact Or.inl hnone
        · exact Or.inr (hrest.trans heq)
    · have hf : (isMember D j sub key && (w.st j).life == .alive) = false := by
        cases hb : isMember D j sub key && (w.st j).life == .alive with
        | false => rfl
        | true => exact absurd hb hcond
      simp only [hf, ite_false]
      exact ih w

theorem killSubtree_carried (w : World) (D : Description) (sub : String) (key : Nat) (s : InstId) :
    carried ((killSubtree w D sub key).st s).phase = none ∨
      carried ((killSubtree w D sub key).st s).phase = carried ((w.st s).phase) := by
  simpa [killSubtree, killMembers] using killFold_carried w D sub key w.roster s


/-- Waking one reader either leaves the world or offers a priority message.
A full lane crashes, and a crash carries nothing new. A successful offer
rewrites the lane, not the phase. -/
theorem try_wake_carried (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) (es : List Eff)
    (h : carried ((tryWake D w dstId label writer).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold tryWake at h
  by_cases hskip :
      ((w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label)) = true
  · simp only [hskip, ite_true] at h
    exact h
  · have hf :
        ((w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label)) = false := by
      cases hb : (w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label) with
      | false => rfl
      | true => exact absurd hb hskip
    simp only [hf, offerPrio] at h
    by_cases hfull : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = true
    · simp only [hfull, ite_true] at h
      exact crash_carried w i es h
    · have hroom : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = false := by
        cases hb : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) with
        | false => rfl
        | true => exact absurd hb hfull
      simp only [hroom] at h
      by_cases hi : i = dstId
      · simp [setActor, hi, carried] at h ⊢
        exact h
      · simp [setActor, hi] at h
        exact h

theorem wake_carried (ids : List InstId) (D : Description) (w : World) (dst label : String)
    (writer i : InstId) (es : List Eff)
    (h : carried ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  induction ids generalizing w with
  | nil => simpa [List.foldl_nil] using h
  | cons j js ih =>
    simp only [List.foldl_cons] at h
    exact try_wake_carried D w j label writer i es (ih _ h)

theorem wakeReaders_carried (D : Description) (w : World) (dst label : String) (writer i : InstId)
    (es : List Eff) (h : carried ((wakeReaders D w dst label writer).st i).phase = some es) :
    carried (w.st i).phase = some es :=
  wake_carried (readersOf w dst) D w dst label writer i es (by simpa [wakeReaders] using h)

/-- Sealing the children of one abort does not invent a continuation. A child that
is shut down goes idle or crashes, and both drop the list it was running. -/
theorem abort_carried (D : Description) (w : World) (parent i : InstId) (es : List Eff)
    (h : carried ((abortChildren D w parent).st i).phase = some es) :
    carried (w.st i).phase = some es := by
  unfold abortChildren at h
  have hfold : ∀ (ids : List InstId) (w0 : World),
      carried ((ids.foldl (fun w child =>
        if isChild w parent child && (w.st child).life == .alive then
          shutdownActor D (dropDescendants D w child) child
        else w) w0).st i).phase = some es →
        carried (w0.st i).phase = some es := by
    intro ids
    induction ids with
    | nil =>
      intro w0 h0
      simpa [List.foldl_nil] using h0
    | cons c ids ih =>
      intro w0 h0
      simp only [List.foldl_cons] at h0
      have hstep := ih _ h0
      by_cases hgo : (isChild w0 parent c && (w0.st c).life == .alive) = true
      · simp only [hgo, ite_true] at hstep
        exact drop_carried D w0 c i es
          (shutdown_carried D (dropDescendants D w0 c) c i es hstep)
      · have hf : (isChild w0 parent c && (w0.st c).life == .alive) = false := by
          cases hb : isChild w0 parent c && (w0.st c).life == .alive with
          | false => rfl
          | true => exact absurd hb hgo
        simp only [hf] at hstep
        exact hstep
  exact hfold w.roster w h

/-- A reply advances the sender. Any other actor keeps the continuation it had,
including the caller whose `awaitReply` becomes the reply continuation of the
same call. -/
theorem reply_other_carried (w : World) (sender : InstId) (k : Cont) (j : InstId) (es : List Eff)
    (hne : j ≠ sender) (h : carried ((performReply w sender k).st j).phase = some es) :
    carried (w.st j).phase = some es := by
  unfold performReply at h
  cases hr : k.replyTo with
  | none =>
    simp [hr, setActor, hne] at h
    exact h
  | some caller =>
    simp [hr] at h
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      by_cases hd : dst = sender
      · by_cases ho : (w.st sender).oweId = some (w.st caller).waitId
        · simp [hph, hd, ho, setActor] at h
          by_cases hc : j = caller
          · subst hc
            have hfin : carried (finishCall (w.st j) ck CallResult.reply).phase = some es := by
              simpa [setActor, hne] using h
            have heq : es = ck.rest := by
              simpa [finishCall, selectCall] using
                carried_proceed (w.st j) (selectCall ck CallResult.reply) es
                  (by simpa [finishCall] using hfin)
            simp [hph, carried, heq]
          · simpa [setActor, hc, hne] using h
        · simp [hph, hd, ho, setActor, hne] at h
          exact h
      · simp [hph, hd, setActor, hne] at h
        exact h
    | idle => simp [hph, setActor, hne] at h; exact h
    | run _ => simp [hph, setActor, hne] at h; exact h
    | parked _ _ _ => simp [hph, setActor, hne] at h; exact h
    | awaitEffect _ => simp [hph, setActor, hne] at h; exact h
    | awaitPeer _ => simp [hph, setActor, hne] at h; exact h
    | crashed => simp [hph, setActor, hne] at h; exact h

/-- `NotAdmitted` runs `onNotAdmitted`, not the call's tail. -/
theorem not_admitted_rest (a : Actor) (k : Cont) (es : List Eff)
    (h : carried (finishCall a k CallResult.notAdmitted).phase = some es) : es = k.onNotAdmitted := by
  simpa [finishCall, selectCall] using
    carried_proceed a (selectCall k CallResult.notAdmitted) es (by simpa [finishCall] using h)

/-- The tail of the effect being run still belongs to the same template. -/
theorem tail_may (I : Impl) (w : World) (id : InstId) (k : Cont) (e : Eff) (tail es : List Eff)
    (hph : (w.st id).phase = .run k) (hrest : k.rest = e :: tail) (hT : TermOk I w)
    (heq : es = tail) (ht : hasTerminate es = true) : MayTerminate I.desc (tname id) :=
  hT id (e :: tail) (by simp [carried, hph, hrest])
    (hasTerminate_cons e tail (by simpa [heq] using ht))

/-- An outcome arm that terminates is part of the effect that stored it. The
checker accepts that effect only for a template that may terminate. -/
theorem arm_may (I : Impl) (w : World) (id : InstId) (k : Cont) (e : Eff) (tail : List Eff)
    (hph : (w.st id).phase = .run k) (hrest : k.rest = e :: tail) (hT : TermOk I w)
    (hE : effTerminates e = true) : MayTerminate I.desc (tname id) :=
  hT id (e :: tail) (by simp [carried, hph, hrest]) (by simp [hasTerminate, hE])

/-- A spawn installs an idle child, or leaves the world unchanged, or does not
happen. None of the three writes a new continuation onto an actor that already
had one. -/
theorem spawn_kept (I : Impl) (w : World) (parent : InstId) (child : String) (w' : World)
    (i : InstId) (es : List Eff) (h : spawnChild I w parent child = some w')
    (hc : carried (w'.st i).phase = some es) : carried (w.st i).phase = some es := by
  unfold spawnChild at h
  cases ht : templateOf I.desc child with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hok : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
        (w.st parent).life == .alive) = true
    · simp only [hok, ite_true] at h
      cases parent with
      | core _ => simp at h
      | peer n k g =>
        by_cases hblk : slotRespawnBlocked I.desc w (.peer n k g) child k = true
        · simp [hblk] at h
          cases h
          exact hc
        · have hf : slotRespawnBlocked I.desc w (.peer n k g) child k = false := by
            cases hb : slotRespawnBlocked I.desc w (.peer n k g) child k with
            | false => rfl
            | true => exact absurd hb hblk
          simp only [hf] at h
          cases h
          simp [admitBorn, readCells_st] at hc
          by_cases hi : i = InstId.peer child k (maxGen w child k)
          · simp [setActor, hi, bornActor, withKeyTokens, carried] at hc
          · simp [setActor, hi] at hc
            exact hc
    · have hf : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
          (w.st parent).life == .alive) = false := by
        cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
            (w.st parent).life == .alive with
        | false => rfl
        | true => exact absurd hb hok
      simp only [hf] at h
      by_cases hstay : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = true
      · simp [hstay] at h
        cases h
        exact hc
      · have hstayF : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = false := by
          cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) with
          | false => rfl
          | true => exact absurd hb hstay
        simp [hstayF] at h

theorem term_ok_exec (I : Impl) (hL : LocalOk I) (w : World) (id : InstId) (k : Cont)
    (hT : TermOk I w) (hph : (w.st id).phase = .run k) :
    TermOk I (execRun I w id (w.st id) k) := by
  have _ := hL
  intro j es hc ht
  by_cases hlive : ((w.st id).life == .alive) = true
  · cases hrest : k.rest with
    | nil =>
      simp only [execRun, hlive, ite_true, hrest, setActor] at hc
      by_cases hj : j = id
      · simp [hj, carried] at hc
      · exact hT j es (by simpa [hj] using hc) ht
    | cons eff tail =>
      cases eff with
      | send dst label hint =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hc
          by_cases hj : j = id
          · have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
            rw [hj]; exact tail_may I w id k (.send dst label hint) tail es hph hrest hT heq ht
          · exact hT j es (by simpa [hj] using hc) ht
        | some dstId =>
          simp only [hr] at hc
          by_cases hj : j = id
          · have heq := enqueue_carried w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) es
              (Or.inr rfl) (by simpa [hj] using hc)
            rw [hj]; exact tail_may I w id k (.send dst label hint) tail es hph hrest hT
              (by simpa [afterHead, hrest] using heq) ht
          · have hphj := enqueue_phase_other w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) j hj
            exact hT j es (by simpa [hphj] using hc) ht
      | trySend dst label hint onFull onGone =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hc
          by_cases hj : j = id
          · have heq : es = onGone := by
              simpa using carried_proceed _ _ es (by simpa [hj] using hc)
            have hE : effTerminates (.trySend dst label hint onFull onGone) = true := by
              rw [heq] at ht; simp [effTerminates, ht]
            rw [hj]; exact arm_may I w id k (.trySend dst label hint onFull onGone) tail hph hrest hT hE
          · exact hT j es (by simpa [hj] using hc) ht
        | some dstId =>
          simp only [hr] at hc
          split at hc
          · by_cases hj : j = id
            · have heq := enqueue_carried w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false
                (afterHead k) es (Or.inr rfl) (by simpa [hj] using hc)
              rw [hj]; exact tail_may I w id k (.trySend dst label hint onFull onGone) tail es hph hrest hT
                (by simpa [afterHead, hrest] using heq) ht
            · have hphj := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false
                (afterHead k) j hj
              exact hT j es (by simpa [hphj] using hc) ht
          · split at hc
            · simp only [setActor] at hc
              by_cases hj : j = id
              · have heq : es = onFull := by
                  simpa using carried_proceed _ _ es (by simpa [hj] using hc)
                have hE : effTerminates (.trySend dst label hint onFull onGone) = true := by
                  rw [heq] at ht; simp [effTerminates, ht]
                rw [hj]; exact arm_may I w id k (.trySend dst label hint onFull onGone) tail hph hrest hT hE
              · exact hT j es (by simpa [hj] using hc) ht
            · simp only [setActor] at hc
              by_cases hj : j = id
              · have heq : es = onGone := by
                  simpa using carried_proceed _ _ es (by simpa [hj] using hc)
                have hE : effTerminates (.trySend dst label hint onFull onGone) = true := by
                  rw [heq] at ht; simp [effTerminates, ht]
                rw [hj]; exact arm_may I w id k (.trySend dst label hint onFull onGone) tail hph hrest hT hE
              · exact hT j es (by simpa [hj] using hc) ht
      | call dst label hint onNotAdmitted onTimedOut =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        cases hr : resolveId I.desc w id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hc
          by_cases hj : j = id
          · have heq : es = onNotAdmitted :=
              not_admitted_rest _ _ es (by simpa [setActor, hj] using hc)
            have hE : effTerminates (.call dst label hint onNotAdmitted onTimedOut) = true := by
              rw [heq] at ht; simp [effTerminates, ht]
            rw [hj]; exact arm_may I w id k (.call dst label hint onNotAdmitted onTimedOut) tail
              hph hrest hT hE
          · exact hT j es (by simpa [hj] using hc) ht
        | some dstId =>
          simp only [hr] at hc
          by_cases hliveD : (w.st dstId).life = .alive
          · by_cases hj : j = id
            · have heq := enqueue_carried w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true
                { afterHead k with onNotAdmitted := onNotAdmitted, onTimedOut := onTimedOut } es
                (Or.inl hliveD) (by simpa [hj] using hc)
              rw [hj]; exact tail_may I w id k (.call dst label hint onNotAdmitted onTimedOut) tail es
                hph hrest hT (by simpa [afterHead, hrest] using heq) ht
            · have hphj := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true
                { afterHead k with onNotAdmitted := onNotAdmitted, onTimedOut := onTimedOut } j hj
              exact hT j es (by simpa [hphj] using hc) ht
          · have hdead : (w.st dstId).life ≠ .alive := hliveD
            simp [enqueueOrPark, hdead] at hc
            by_cases hj : j = id
            · have heq : es = onNotAdmitted :=
                not_admitted_rest _ _ es (by simpa [setActor, hj] using hc)
              have hE : effTerminates (.call dst label hint onNotAdmitted onTimedOut) = true := by
                rw [heq] at ht; simp [effTerminates, ht]
              rw [hj]; exact arm_may I w id k (.call dst label hint onNotAdmitted onTimedOut) tail
                hph hrest hT hE
            · exact hT j es (by simpa [setActor, hj] using hc) ht
      | reply =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        by_cases hj : j = id
        · have heq := reply_sender_rest w id k es (by simpa [hj] using hc)
          rw [hj]; exact tail_may I w id k .reply tail es hph hrest hT
            (by simpa [afterHead, hrest] using heq) ht
        · exact hT j es (reply_other_carried w id k j es hj hc) ht
      | selfSchedule label =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        split at hc
        · simp only [setActor] at hc
          by_cases hj : j = id
          · have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
            rw [hj]; exact tail_may I w id k (.selfSchedule label) tail es hph hrest hT heq ht
          · exact hT j es (by simpa [hj] using hc) ht
        · split at hc
          · simp only [setActor] at hc
            by_cases hj : j = id
            · have heq : es = tail := by
                simpa [afterHead, hrest] using
                  carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
              rw [hj]; exact tail_may I w id k (.selfSchedule label) tail es hph hrest hT heq ht
            · exact hT j es (by simpa [hj] using hc) ht
          · exact hT j es (crash_carried w j es hc) ht
      | cell dst label value =>
        simp only [execRun, hlive, ite_true, hrest, setCell] at hc
        split at hc
        · simp only [setActor] at hc
          by_cases hj : j = id
          · have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
            rw [hj]; exact tail_may I w id k (.cell dst label value) tail es hph hrest hT heq ht
          · exact hT j es (by simpa [hj] using hc) ht
        · have hmid := wakeReaders_carried I.desc _ dst label id j es hc
          simp only [setActor] at hmid
          by_cases hj : j = id
          · have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [hj] using hmid)
            rw [hj]; exact tail_may I w id k (.cell dst label value) tail es hph hrest hT heq ht
          · exact hT j es (by simpa [hj] using hmid) ht
      | internal =>
        simp only [execRun, hlive, ite_true, hrest, setActor] at hc
        by_cases hj : j = id
        · have heq : es = tail := by simpa [hj, carried, afterHead, hrest] using hc.symm
          rw [hj]; exact tail_may I w id k .internal tail es hph hrest hT heq ht
        · exact hT j es (by simpa [hj] using hc) ht
      | peer onTimeout =>
        simp only [execRun, hlive, ite_true, hrest, setActor] at hc
        by_cases hj : j = id
        · have heq : es = tail := by simpa [hj, carried, afterHead, hrest] using hc.symm
          rw [hj]; exact tail_may I w id k (.peer onTimeout) tail es hph hrest hT heq ht
        · exact hT j es (by simpa [hj] using hc) ht
      | abort =>
        simp only [execRun, hlive, ite_true, hrest, commitCont] at hc
        by_cases hcr : (abortChildren I.desc w id).crashed = true
        · simp only [hcr, ite_true] at hc
          exact hT j es (abort_carried I.desc w id j es hc) ht
        · have hf : (abortChildren I.desc w id).crashed = false := by
            simpa [Bool.not_eq_true] using hcr
          simp only [hf, ite_false, setActor] at hc
          by_cases hj : j = id
          · have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
            rw [hj]; exact tail_may I w id k .abort tail es hph hrest hT heq ht
          · exact hT j es
              (abort_carried I.desc w id j es (by simpa [setActor, hj] using hc)) ht
      | spawn child =>
        simp only [execRun, hlive, ite_true, hrest] at hc
        cases hs : spawnChild I w id child with
        | none =>
          simp only [hs] at hc
          exact hT j es (crash_carried w j es hc) ht
        | some w' =>
          simp only [hs, commitCont] at hc
          by_cases hcr : w'.crashed = true
          · simp only [hcr, ite_true] at hc
            exact hT j es (spawn_kept I w id child w' j es hs hc) ht
          · have hf : w'.crashed = false := by simpa [Bool.not_eq_true] using hcr
            simp only [hf, ite_false, setActor] at hc
            by_cases hj : j = id
            · have heq : es = tail := by
                simpa [afterHead, hrest] using
                  carried_proceed _ (afterHead k) es (by simpa [hj] using hc)
              rw [hj]; exact tail_may I w id k (.spawn child) tail es hph hrest hT heq ht
            · exact hT j es (spawn_kept I w id child w' j es hs (by simpa [setActor, hj] using hc)) ht
      | terminate =>
        have hl : (w.st id).life = .alive := (beq_iff_eq).mp hlive
        rcases execRun_terminate I w id (w.st id) k hl ⟨tail, hrest⟩ with
          hw | ⟨_, _, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, hw⟩ | ⟨_, _, _, _, _, _, _, hw⟩
        · rw [hw] at hc
          exact hT j es (crash_carried w j es hc) ht
        · rw [hw] at hc
          exact hT j es (shutdown_carried I.desc w id j es hc) ht
        · rw [hw] at hc
          exact hT j es (terminate_carried I.desc w id j es hc) ht
        · rw [hw] at hc
          exact hT j es (terminate_carried I.desc w id j es hc) ht
  · have hf : ((w.st id).life == .alive) = false := by simpa [Bool.not_eq_true] using hlive
    simp only [execRun, hf, ite_false] at hc
    exact hT j es hc ht
theorem term_ok_head (I : Impl) (hL : LocalOk I) (w w' : World) (id : InstId) (hT : TermOk I w)
    (h : execHead I w id = some w') : TermOk I w' := by
  unfold execHead at h
  by_cases hlive : (w.st id).life = .alive
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      exact term_ok_exec I hL w id k hT hph
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hlive] at h

/-- The continuation a phase is still holding, when it has one. -/
def phaseCont : Phase → Option Cont
  | .run k => some k
  | .parked _ _ k => some k
  | .awaitReply _ k => some k
  | .awaitEffect k => some k
  | .awaitPeer k => some k
  | _ => none

/-- `es` is an outcome list stored on `k`, not the list `k` is running. -/
def armOf (k : Cont) (es : List Eff) : Prop :=
  es = k.onNotAdmitted ∨ es = k.onTimedOut ∨ es = k.onTimeout

/-- A stored outcome list that contains `terminate` belongs to a template that
may terminate. `TermOk` watches the list being run. A timeout runs one of these
lists instead, so the two have to be kept together.
(DECISIONS.md 2026-11-22, "A call waits on its own outcomes".) -/
def ArmOk (I : Impl) (w : World) : Prop :=
  ∀ id k es, phaseCont (w.st id).phase = some k → armOf k es → hasTerminate es = true →
    MayTerminate I.desc (tname id)

theorem arm_ok_init (I : Impl) (N : Nat) : ArmOk I (initWorld I N) := by
  intro id k _ hk _ _
  simp [init_phase, phaseCont] at hk

theorem arm_same (I : Impl) (w w' : World) (hA : ArmOk I w)
    (hph : ∀ i, (w'.st i).phase = (w.st i).phase) : ArmOk I w' := by
  intro i k es hk harm ht
  exact hA i k es (by simpa [hph i] using hk) harm ht

theorem term_ok_apply (I : Impl) (hL : LocalOk I) (a : Action) (w w' : World) (hT : TermOk I w)
    (hA : ArmOk I w) (h : apply I a w = some w') : TermOk I w' := by
  cases a with
  | callTimeout id =>
    intro i es hc ht
    by_cases hi : i = id
    · rw [hi] at hc
      have hct : callTimeout w id = some w' := by
        simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
      -- The list now being run is the outcome arm, not the list the actor was
      -- waiting on. `ArmOk` recorded that arm when it was stored.
      rcases callTimeout_self w w' id hct with
        ⟨_, k, hph, hpost⟩ | ⟨_, k, hph, hpost⟩ | ⟨k, hph, hpost⟩
      · rw [hpost] at hc
        have heq : es = k.onTimedOut := by
          simpa [selectCall] using carried_proceed _ (selectCall k .timedOut) es hc
        rw [hi]
        exact hA id k es (by simp [phaseCont, hph]) (Or.inr (Or.inl heq)) ht
      · rw [hpost] at hc
        have heq : es = k.onNotAdmitted := by
          simpa [selectCall] using carried_proceed _ (selectCall k .notAdmitted) es hc
        rw [hi]
        exact hA id k es (by simp [phaseCont, hph]) (Or.inl heq) ht
      · rw [hpost] at hc
        have heq : es = k.onTimeout := by
          simpa using carried_proceed _ { k with rest := k.onTimeout, toState := pickState k.toState k.toTimeout } es hc
        rw [hi]
        exact hA id k es (by simp [phaseCont, hph]) (Or.inr (Or.inr heq)) ht
    · exact hT i es (callTimeout_carried w w' id i es
        (by simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2) hi hc) ht
  | ingress dst label =>
    exact term_ok_phase I w w' hT
      (fun i => (ingress_phase I w w' dst label i
        (by simpa [stepWorld] using (apply_step I (.ingress dst label) w w' h).2)).1)
  | recvBulk id =>
    exact term_ok_bulk I hL w w' id hT
      (by simpa [stepWorld] using (apply_step I (.recvBulk id) w w' h).2)
  | recvPrio id =>
    exact term_ok_prio I hL w w' id hT
      (by simpa [stepWorld] using (apply_step I (.recvPrio id) w w' h).2)
  | exec id =>
    exact term_ok_head I hL w w' id hT
      (by simpa [stepWorld] using (apply_step I (.exec id) w w' h).2)
  | finish id =>
    exact term_ok_finish I hL w w' id hT
      (by simpa [stepWorld] using (apply_step I (.finish id) w w' h).2)
  | spawn template =>
    exact term_ok_spawn I hL w w' template hT
      (by simpa [stepWorld] using (apply_step I (.spawn template) w w' h).2)
  | stutter =>
    cases stutter_unchanged I w w' h
    exact hT

/-- `resumeSender` keeps the continuation it found. A parked send runs that same
continuation, and every other phase is untouched. -/
theorem phaseCont_resume (a : Actor) (b : Bool) (dst : InstId) (k : Cont)
    (h : phaseCont (resumeSender a b dst).phase = some k) : phaseCont a.phase = some k := by
  cases hph : a.phase with
  | parked _ _ k0 =>
    cases b with
    | true => simp [resumeSender, hph, phaseCont] at h ⊢; exact h
    | false =>
      cases hk : k0.rest with
      | nil => simp [resumeSender, hph, proceed, hk, phaseCont] at h
      | cons _ _ => simp [resumeSender, hph, proceed, hk, phaseCont] at h ⊢; exact h
  | idle => simp [resumeSender, hph, phaseCont] at h
  | run k0 => simp [resumeSender, hph, phaseCont] at h ⊢; exact h
  | awaitReply _ k0 => simp [resumeSender, hph, phaseCont] at h ⊢; exact h
  | awaitEffect k0 => simp [resumeSender, hph, phaseCont] at h ⊢; exact h
  | awaitPeer k0 => simp [resumeSender, hph, phaseCont] at h ⊢; exact h
  | crashed => simp [resumeSender, hph, phaseCont] at h

/-- A crash rewrites a live roster actor to `.crashed`, which holds no continuation.
An actor it leaves in place keeps the continuation it had. -/
theorem crash_phaseCont (w : World) (i : InstId) (k : Cont)
    (h : phaseCont ((crashWorld w).st i).phase = some k) : phaseCont (w.st i).phase = some k := by
  unfold crashWorld at h
  by_cases hmem : decide (i ∈ w.roster) = true
  · simp only [hmem, ite_true, crashActor] at h
    by_cases hgo : ((w.st i).life == .alive) = true
    · simp [hgo, phaseCont] at h
    · simp [hgo] at h
      exact h
  · have hmemF : decide (i ∈ w.roster) = false := by
      simpa [Bool.not_eq_true] using hmem
    simp only [hmemF, ite_false] at h
    exact h

theorem release_phaseCont (w : World) (id : InstId) (ps : List Parked) (i : InstId) (k : Cont)
    (h : phaseCont ((releaseParked w id ps).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons] at h
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip] at h
      exact ih _ h
    · rw [if_neg hskip] at h
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id)) h
      by_cases hi : i = p.sender
      · exact phaseCont_resume _ false id k (by simpa [setActor, hi] using hmid)
      · simpa [setActor, hi] using hmid

theorem releaseWorld_phaseCont (D : Description) (w : World) (id : InstId) (a : Actor)
    (i : InstId) (k : Cont) (h : phaseCont ((releaseWorld D w id a).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  let base :=
    releaseOutbound (refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked) id
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  rw [hworld] at h
  by_cases hi : i = id
  · have hv := (release_keeps_victim (setActor base id dead) id a.parked).1
    rw [hi, hv] at h
    simp [setActor, dead, phaseCont] at h
  · have hrel := release_phaseCont (setActor base id dead) id a.parked i k h
    have hph : ((setActor base id dead).st i).phase = (w.st i).phase := by
      simp [setActor, hi, base, releaseOutbound_phase, phase_refundP, phase_refund, readCells_st]
    simpa [hph] using hrel

/-- Queueing a tombstone, or crashing because it does not fit, does not invent
a continuation. -/
theorem enqueueTombstone_phaseCont (D : Description) (w : World) (child i : InstId) (k : Cont)
    (h : phaseCont ((enqueueTombstone D w child).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  unfold enqueueTombstone at h
  cases hpar : (w.st child).parent with
  | none => simpa [hpar] using h
  | some parent =>
    simp only [hpar] at h
    by_cases hnot : ((w.st parent).life != .alive) = true
    · simp [hnot] at h
      exact h
    · have hnotF : ((w.st parent).life != .alive) = false := by
        simpa [Bool.not_eq_true] using hnot
      simp only [hnotF] at h
      by_cases hlab : ((tombstoneMsg D (w.st parent) child).label == "") = true
      · simp only [hlab, ite_true] at h
        exact crash_phaseCont w i k h
      · have hlabF : ((tombstoneMsg D (w.st parent) child).label == "") = false := by
          simpa [Bool.not_eq_true] using hlab
        simp only [hlabF] at h
        by_cases hfull : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = true
        · simp only [hfull, ite_true, offerPrio] at h
          exact crash_phaseCont w i k h
        · have hroom : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp only [hroom, offerPrio] at h
          by_cases hi : i = parent
          · rw [hi] at h ⊢
            simp [setActor, phaseCont] at h ⊢
            exact h
          · simp [setActor, hi] at h
            exact h

theorem shutdown_phaseCont (D : Description) (w : World) (id i : InstId) (k : Cont)
    (h : phaseCont ((shutdownActor D w id).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  unfold shutdownActor at h
  by_cases hlive : ((w.st id).life == .alive) = true
  · simp only [hlive, ite_true, sealActor] at h
    exact releaseWorld_phaseCont D w id (w.st id) i k
      (enqueueTombstone_phaseCont D (releaseWorld D w id (w.st id)) id i k h)
  · simp [hlive] at h
    exact h

theorem seal_phaseCont (fuel : Nat) (D : Description) :
    ∀ (w : World) (root i : InstId) (k : Cont),
      phaseCont ((sealBranch fuel D w root).st i).phase = some k →
        phaseCont (w.st i).phase = some k := by
  induction fuel with
  | zero =>
    intro w root i k h
    simpa [sealBranch] using h
  | succ fuel ih =>
    intro w root i k h
    simp only [sealBranch] at h
    let step (w0 : World) (child : InstId) : World :=
      if isChild w0 root child then sealBranch fuel D w0 child else w0
    have hfold : ∀ (ids : List InstId) (w0 : World),
        phaseCont ((ids.foldl step w0).st i).phase = some k →
          phaseCont (w0.st i).phase = some k := by
      intro ids
      induction ids with
      | nil =>
        intro w0 h0
        simpa [List.foldl_nil] using h0
      | cons c ids ihf =>
        intro w0 h0
        simp only [List.foldl_cons, step] at h0
        by_cases hch : isChild w0 root c = true
        · simp only [hch, ite_true] at h0
          exact ih w0 c i k (ihf _ h0)
        · have hf : isChild w0 root c = false := by
            cases hb : isChild w0 root c with
            | false => rfl
            | true => exact absurd hb hch
          simp only [hf] at h0
          exact ihf _ h0
    have hpre := hfold w.roster w
    split at h
    · next hgo =>
      exact hpre (releaseWorld_phaseCont D _ root _ i k h)
    · next hgo =>
      exact hpre h

theorem drop_phaseCont (D : Description) (w : World) (root i : InstId) (k : Cont)
    (h : phaseCont ((dropDescendants D w root).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  unfold dropDescendants at h
  let step (w0 : World) (child : InstId) : World :=
    if isChild w0 root child then sealBranch w.roster.length D w0 child else w0
  have hfold : ∀ (ids : List InstId) (w0 : World),
      phaseCont ((ids.foldl step w0).st i).phase = some k →
        phaseCont (w0.st i).phase = some k := by
    intro ids
    induction ids with
    | nil =>
      intro w0 h0
      simpa [List.foldl_nil] using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons, step] at h0
      by_cases hch : isChild w0 root c = true
      · simp only [hch, ite_true] at h0
        exact seal_phaseCont w.roster.length D w0 c i k (ihf _ h0)
      · have hf : isChild w0 root c = false := by
          cases hb : isChild w0 root c with
          | false => rfl
          | true => exact absurd hb hch
        simp only [hf] at h0
        exact ihf _ h0
  exact hfold w.roster w h

theorem terminate_phaseCont (D : Description) (w : World) (id i : InstId) (k : Cont)
    (h : phaseCont ((terminateStage D w id (w.st id)).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  simp only [terminateStage] at h
  exact drop_phaseCont D w id i k (shutdown_phaseCont D (dropDescendants D w id) id i k h)

theorem abort_phaseCont (D : Description) (w : World) (parent i : InstId) (k : Cont)
    (h : phaseCont ((abortChildren D w parent).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  unfold abortChildren at h
  have hfold : ∀ (ids : List InstId) (w0 : World),
      phaseCont ((ids.foldl (fun w child =>
        if isChild w parent child && (w.st child).life == .alive then
          shutdownActor D (dropDescendants D w child) child
        else w) w0).st i).phase = some k →
        phaseCont (w0.st i).phase = some k := by
    intro ids
    induction ids with
    | nil =>
      intro w0 h0
      simpa [List.foldl_nil] using h0
    | cons c ids ih =>
      intro w0 h0
      simp only [List.foldl_cons] at h0
      have hstep := ih _ h0
      by_cases hgo : (isChild w0 parent c && (w0.st c).life == .alive) = true
      · simp only [hgo, ite_true] at hstep
        exact drop_phaseCont D w0 c i k
          (shutdown_phaseCont D (dropDescendants D w0 c) c i k hstep)
      · have hf : (isChild w0 parent c && (w0.st c).life == .alive) = false := by
          cases hb : isChild w0 parent c && (w0.st c).life == .alive with
          | false => rfl
          | true => exact absurd hb hgo
        simp only [hf] at hstep
        exact hstep
  exact hfold w.roster w h

theorem try_wake_phaseCont (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) (k : Cont)
    (h : phaseCont ((tryWake D w dstId label writer).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  unfold tryWake at h
  by_cases hskip :
      ((w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label)) = true
  · simp only [hskip, ite_true] at h
    exact h
  · have hf :
        ((w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label)) = false := by
      cases hb : (w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label) with
      | false => rfl
      | true => exact absurd hb hskip
    simp only [hf, offerPrio] at h
    by_cases hfull : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = true
    · simp only [hfull, ite_true] at h
      exact crash_phaseCont w i k h
    · have hroom : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = false := by
        cases hb : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) with
        | false => rfl
        | true => exact absurd hb hfull
      simp only [hroom] at h
      by_cases hi : i = dstId
      · simp [setActor, hi, phaseCont] at h ⊢
        exact h
      · simp [setActor, hi] at h
        exact h

theorem wake_phaseCont (ids : List InstId) (D : Description) (w : World) (_dst label : String)
    (writer i : InstId) (k : Cont)
    (h : phaseCont ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).phase = some k) :
    phaseCont (w.st i).phase = some k := by
  induction ids generalizing w with
  | nil => simpa [List.foldl_nil] using h
  | cons j js ih =>
    simp only [List.foldl_cons] at h
    exact try_wake_phaseCont D w j label writer i k (ih _ h)

theorem wakeReaders_phaseCont (D : Description) (w : World) (dst label : String) (writer i : InstId)
    (k : Cont) (h : phaseCont ((wakeReaders D w dst label writer).st i).phase = some k) :
    phaseCont (w.st i).phase = some k :=
  wake_phaseCont (readersOf w dst) D w dst label writer i k (by simpa [wakeReaders] using h)

/-- A spawn installs an idle child. A continuation still held afterwards was
already held, on the same actor. -/
theorem spawn_phaseCont (I : Impl) (w : World) (parent : InstId) (child : String) (w' : World)
    (i : InstId) (k : Cont) (h : spawnChild I w parent child = some w')
    (hk : phaseCont (w'.st i).phase = some k) : phaseCont (w.st i).phase = some k := by
  unfold spawnChild at h
  cases ht : templateOf I.desc child with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hok : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
        (w.st parent).life == .alive) = true
    · simp only [hok, ite_true] at h
      cases parent with
      | core _ => simp at h
      | peer n key g =>
        by_cases hblk : slotRespawnBlocked I.desc w (.peer n key g) child key = true
        · simp [hblk] at h
          cases h
          exact hk
        · have hf : slotRespawnBlocked I.desc w (.peer n key g) child key = false := by
            cases hb : slotRespawnBlocked I.desc w (.peer n key g) child key with
            | false => rfl
            | true => exact absurd hb hblk
          simp only [hf] at h
          cases h
          simp [admitBorn, readCells_st] at hk
          by_cases hi : i = InstId.peer child key (maxGen w child key)
          · simp [setActor, hi, bornActor, withKeyTokens, phaseCont] at hk
          · simp [setActor, hi] at hk
            exact hk
    · have hf : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
          (w.st parent).life == .alive) = false := by
        cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
            (w.st parent).life == .alive with
        | false => rfl
        | true => exact absurd hb hok
      simp only [hf] at h
      by_cases hstay : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = true
      · simp [hstay] at h
        cases h
        exact hk
      · have hstayF : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = false := by
          cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) with
          | false => rfl
          | true => exact absurd hb hstay
        simp [hstayF] at h

/-- A delivered actor is idle, or it runs the transition with empty outcome
lists. The transition stores typestates, not those lists. -/
theorem deliver_phase_kind (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) :
    a1.phase = .idle ∨
      ∃ k, a1.phase = .run k ∧ k.onNotAdmitted = [] ∧ k.onTimedOut = [] ∧
        k.onTimeout = [] := by
  unfold deliver at h
  by_cases hlive : a.life ≠ .alive
  · simp [hlive] at h
  · simp only [hlive, ite_false] at h
    let wC := readCells I.desc w id
    by_cases htomb : (m.tombstone && newerGeneration wC m) = true
    · simp [wC, htomb] at h
      rcases h with ⟨_, ha⟩
      subst ha
      exact Or.inl rfl
    · have htombF : (m.tombstone && newerGeneration wC m) = false := by
        simpa [Bool.not_eq_true] using htomb
      simp only [wC, htombF] at h
      cases hfind : findDeliver I (tname id) a.typestate m with
      | none =>
        simp only [hfind] at h
        by_cases hkeep : (m.callFrom.isSome || m.tombstone) = true
        · simp [hkeep] at h
        · simp [hkeep] at h
          rcases h with ⟨_, ha⟩
          subst ha
          exact Or.inl rfl
      | some tr =>
        simp only [hfind] at h
        by_cases hacc : (m.callFrom.isSome && !tr.acceptsCall) = true
        · simp [hacc] at h
        · have haccF : (m.callFrom.isSome && !tr.acceptsCall) = false := by
            simpa [Bool.not_eq_true] using hacc
          simp only [haccF] at h
          have ⟨_, ha⟩ := Prod.mk.inj (Option.some.inj h)
          subst ha
          by_cases hempty : tr.program.isEmpty = true
          · simp [hempty]
          · have hemptyF : tr.program.isEmpty = false := by
              cases hb : tr.program.isEmpty
              · rfl
              · exact absurd hb hempty
            simp [hemptyF]

theorem fresh_no_arm (k : Cont) (es : List Eff)
    (hN : k.onNotAdmitted = []) (hTo : k.onTimedOut = []) (hOu : k.onTimeout = [])
    (harm : armOf k es) (ht : hasTerminate es = true) : False := by
  rcases harm with h | h | h
  · simp [h, hN, hasTerminate] at ht
  · simp [h, hTo, hasTerminate] at ht
  · simp [h, hOu, hasTerminate] at ht

theorem deliver_no_arm (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (k : Cont) (es : List Eff)
    (h : deliver I w id a m = some (w1, a1)) (hk : phaseCont a1.phase = some k)
    (harm : armOf k es) (ht : hasTerminate es = true) : False := by
  rcases deliver_phase_kind I w id a m w1 a1 h with hidle | ⟨k0, hrun, hN, hTo, hOu⟩
  · simp [hidle, phaseCont] at hk
  · simp [hrun, phaseCont] at hk
    subst hk
    exact fresh_no_arm k0 es hN hTo hOu harm ht

/-- A bulk receive installs a fresh handler, whose outcome lists are empty, or
resumes a parked sender on the continuation it already held. -/
theorem bulk_arm (I : Impl) (w w' : World) (id : InstId) (hA : ArmOk I w)
    (h : receiveBulk I w id = some w') : ArmOk I w' := by
  intro i k es hk harm ht
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hk
            by_cases hs : id = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender)
                p.isCall id k (by simpa [setActor, hs] using hk)
              have hph : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender).phase =
                  a1.phase := by simp [creditLive, phase_credit, setActor, hs]
              exact (deliver_no_arm I w id _ p.msg w1 a1 k es hdel (by simpa [hph] using hkR)
                harm ht).elim
            · have hk1 : phaseCont a1.phase = some k := by
                simpa [setActor, hs, creditLive, phase_credit] using hk
              exact (deliver_no_arm I w id _ p.msg w1 a1 k es hdel hk1 harm ht).elim
          · by_cases hs : i = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender)
                p.isCall id k (by simpa [setActor] using hk)
              have hst := deliver_st I w id _ p.msg w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hk0 : phaseCont (w.st p.sender).phase = some k := by
                simpa [setActor, hne, creditLive, phase_credit, hst] using hkR
              exact hA i k es (by simpa [hs] using hk0) harm ht
            · have hst := deliver_st I w id _ p.msg w1 a1 i hdel
              have hk0 : phaseCont (w.st i).phase = some k := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst] using hk
              exact hA i k es hk0 harm ht
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hk
            have hk1 : phaseCont a1.phase = some k := by
              simpa [setActor, creditLive, phase_credit] using hk
            exact (deliver_no_arm I w id _ m w1 a1 k es hdel hk1 harm ht).elim
          · have hst := deliver_st I w id _ m w1 a1 i hdel
            have hk0 : phaseCont (w.st i).phase = some k := by
              simpa [setActor, hid, creditLive, phase_credit, hst] using hk
            exact hA i k es hk0 harm ht
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hphA : admitted.phase = a1.phase := by simp [admitted]
          by_cases hid : i = id
          · rw [hid] at hk
            by_cases hs : id = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender)
                p.isCall id k (by simpa [setActor, hs] using hk)
              have hph : ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender).phase =
                  a1.phase := by simp [creditLive, phase_credit, setActor, hphA, hs]
              exact (deliver_no_arm I w id _ m w1 a1 k es hdel (by simpa [hph] using hkR)
                harm ht).elim
            · have hk1 : phaseCont a1.phase = some k := by
                simpa [setActor, hs, creditLive, phase_credit, hphA] using hk
              exact (deliver_no_arm I w id _ m w1 a1 k es hdel hk1 harm ht).elim
          · by_cases hs : i = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender)
                p.isCall id k (by simpa [setActor] using hk)
              have hst := deliver_st I w id _ m w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hk0 : phaseCont (w.st p.sender).phase = some k := by
                simpa [setActor, hne, creditLive, phase_credit, hst, hphA] using hkR
              exact hA i k es (by simpa [hs] using hk0) harm ht
            · have hst := deliver_st I w id _ m w1 a1 i hdel
              have hk0 : phaseCont (w.st i).phase = some k := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst, hphA] using hk
              exact hA i k es hk0 harm ht

/-- A priority receive delivers one message to an idle actor. The handler it
installs has empty outcome lists, and every other actor keeps its phase. -/
theorem prio_arm (I : Impl) (w w' : World) (id : InstId) (hA : ArmOk I w)
    (h : receivePrio I w id = some w') : ArmOk I w' := by
  intro i k es hk harm ht
  obtain ⟨m, _pre, _suf, w1, a1, _hlife, _hidle, _hprio, _hwait, hdel, hw'⟩ :=
    receivePrio_spec I w w' id h
  rw [hw'] at hk
  by_cases hi : i = id
  · have hk1 : phaseCont a1.phase = some k := by simpa [setActor, hi] using hk
    exact (deliver_no_arm I w id _ m w1 a1 k es hdel hk1 harm ht).elim
  · have hst := deliver_st I w id _ m w1 a1 i hdel
    exact hA i k es (by simpa [setActor, hi, hst] using hk) harm ht

theorem arm_fields (k k' : Cont) (es : List Eff)
    (hN : k'.onNotAdmitted = k.onNotAdmitted) (hT : k'.onTimedOut = k.onTimedOut)
    (hO : k'.onTimeout = k.onTimeout) (harm : armOf k' es) : armOf k es := by
  rcases harm with h | h | h
  · exact Or.inl (h.trans hN)
  · exact Or.inr (Or.inl (h.trans hT))
  · exact Or.inr (Or.inr (h.trans hO))

theorem after_fields (k : Cont) :
    (afterHead k).onNotAdmitted = k.onNotAdmitted ∧ (afterHead k).onTimedOut = k.onTimedOut ∧
      (afterHead k).onTimeout = k.onTimeout := by
  simp [afterHead]

theorem proceed_same (a : Actor) (k kNew : Cont)
    (h : phaseCont (proceed a k).phase = some kNew) : kNew = k := by
  cases hr : k.rest with
  | nil => simp [proceed, hr, phaseCont] at h
  | cons _ _ =>
    have hk : k = kNew := by simpa [proceed, hr, phaseCont] using h
    exact hk.symm

theorem select_fields (k : Cont) (r : CallResult) :
    (selectCall k r).onNotAdmitted = k.onNotAdmitted ∧ (selectCall k r).onTimedOut = k.onTimedOut ∧
      (selectCall k r).onTimeout = k.onTimeout := by
  cases r <;> simp [selectCall]

/-- Every continuation `enqueueOrPark` installs keeps the arm lists of `k`.
`NotAdmitted` changes the list being run, not the stored arms. -/
theorem enqueue_arm (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (b : Bool) (k kNew : Cont) (es : List Eff)
    (hk : phaseCont ((enqueueOrPark w D sender dst msg b k).st sender).phase = some kNew)
    (harm : armOf kNew es) : armOf k es := by
  by_cases hlive : (w.st dst).life = .alive
  · by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hparkS : (w.st sender).parked = [] := by rw [hsame]; exact hroom.1
        have hcapS : (w.st sender).box.length < capBulk D w.N sender := by rw [hsame]; exact hroom.2
        rw [← hsame] at hk
        cases b with
        | true =>
          rw [enqueue_room_self_call w D sender msg k hliveS hparkS hcapS] at hk
          simp [setActor, phaseCont] at hk
          cases hk
          exact harm
        | false =>
          rw [enqueue_room_self_send w D sender msg k hliveS hparkS hcapS] at hk
          have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
          subst heq
          exact harm
      · cases b with
        | true =>
          rw [enqueue_room_other_call w D sender dst msg k hlive hsame hroom.1 hroom.2] at hk
          simp [setActor, phaseCont] at hk
          cases hk
          exact harm
        | false =>
          rw [enqueue_room_other_send w D sender dst msg k hlive hsame hroom.1 hroom.2] at hk
          have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
          subst heq
          exact harm
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hroomS :
            ¬ ((w.st sender).parked = [] ∧ (w.st sender).box.length < capBulk D w.N sender) := by
          rw [hsame]; exact hroom
        rw [← hsame] at hk
        rw [enqueue_park_self w D sender msg b k hliveS hroomS] at hk
        simp [setActor, phaseCont] at hk
        cases hk
        exact harm
      · rw [enqueue_park_other w D sender dst msg b k hlive hsame hroom] at hk
        simp [setActor, phaseCont] at hk
        cases hk
        exact harm
  · cases b with
    | false =>
      rw [enqueue_dead w D sender dst msg k hlive] at hk
      have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
      subst heq
      exact harm
    | true =>
      rw [enqueue_miss w D sender dst msg k hlive] at hk
      have heq := proceed_same _ (selectCall k .notAdmitted) kNew
        (by simpa [setActor, finishCall] using hk)
      subst heq
      exact arm_fields k (selectCall k .notAdmitted) es (select_fields k .notAdmitted).1
        (select_fields k .notAdmitted).2.1 (select_fields k .notAdmitted).2.2 harm

theorem tail_arm (I : Impl) (w : World) (id : InstId) (k : Cont) (hA : ArmOk I w)
    (hph : (w.st id).phase = .run k) (kNew : Cont) (es : List Eff)
    (heq : kNew = afterHead k) (harm : armOf kNew es) (ht : hasTerminate es = true) :
    MayTerminate I.desc (tname id) := by
  subst heq
  exact hA id k es (by simp [phaseCont, hph])
    (arm_fields k (afterHead k) es (after_fields k).1 (after_fields k).2.1 (after_fields k).2.2 harm) ht

theorem enqueue_tail (I : Impl) (w : World) (id dstId : InstId) (msg : Msg) (b : Bool) (k : Cont)
    (hA : ArmOk I w) (hph : (w.st id).phase = .run k) (i : InstId) (kNew : Cont) (es : List Eff)
    (hk : phaseCont ((enqueueOrPark w I.desc id dstId msg b (afterHead k)).st i).phase = some kNew)
    (harm : armOf kNew es) (ht : hasTerminate es = true) : MayTerminate I.desc (tname i) := by
  by_cases hi : i = id
  · have harmK := enqueue_arm w I.desc id dstId msg b (afterHead k) kNew es (by simpa [hi] using hk) harm
    rw [hi]
    exact hA id k es (by simp [phaseCont, hph])
      (arm_fields k (afterHead k) es (after_fields k).1 (after_fields k).2.1 (after_fields k).2.2 harmK) ht
  · have hphj := enqueue_phase_other w I.desc id dstId msg b (afterHead k) i hi
    exact hA i kNew es (by simpa [hphj] using hk) harm ht

/-- A call stores `onNotAdmitted` and `onTimedOut` from the effect. `onTimeout`
is the list the running continuation already held. -/
theorem call_arm (I : Impl) (w : World) (id : InstId) (k : Cont) (dst label : String) (hint : Nat)
    (na to tail : List Eff) (hph : (w.st id).phase = .run k)
    (hrest : k.rest = .call dst label hint na to :: tail) (hT : TermOk I w) (hA : ArmOk I w)
    (es : List Eff) (harm : armOf ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) es)
    (ht : hasTerminate es = true) : MayTerminate I.desc (tname id) := by
  rcases harm with h | h | h
  · have hE : effTerminates (.call dst label hint na to) = true := by
      have hes : es = na := by simpa [afterHead] using h
      rw [hes] at ht
      simp [effTerminates, ht]
    exact arm_may I w id k (.call dst label hint na to) tail hph hrest hT hE
  · have hE : effTerminates (.call dst label hint na to) = true := by
      have hes : es = to := by simpa [afterHead] using h
      rw [hes] at ht
      simp [effTerminates, ht]
    exact arm_may I w id k (.call dst label hint na to) tail hph hrest hT hE
  · have hold : es = k.onTimeout := by simpa [afterHead] using h
    exact hA id k es (by simp [phaseCont, hph]) (Or.inr (Or.inr hold)) ht

theorem peer_arm (I : Impl) (w : World) (id : InstId) (k : Cont) (onTimeout tail : List Eff)
    (hph : (w.st id).phase = .run k) (hrest : k.rest = .peer onTimeout :: tail)
    (hT : TermOk I w) (hA : ArmOk I w) (es : List Eff)
    (harm : armOf ({ afterHead k with onTimeout := onTimeout }) es) (ht : hasTerminate es = true) :
    MayTerminate I.desc (tname id) := by
  rcases harm with h | h | h
  · exact hA id k es (by simp [phaseCont, hph]) (Or.inl (by simpa [afterHead] using h)) ht
  · exact hA id k es (by simp [phaseCont, hph]) (Or.inr (Or.inl (by simpa [afterHead] using h))) ht
  · have hE : effTerminates (.peer onTimeout) = true := by
      have hes : es = onTimeout := by simpa [afterHead] using h
      rw [hes] at ht
      simp [effTerminates, ht]
    exact arm_may I w id k (.peer onTimeout) tail hph hrest hT hE

theorem full_arm (I : Impl) (w : World) (id : InstId) (k : Cont) (kFull : Cont) (hA : ArmOk I w)
    (hph : (w.st id).phase = .run k)
    (hN : kFull.onNotAdmitted = k.onNotAdmitted) (hTo : kFull.onTimedOut = k.onTimedOut)
    (hOu : kFull.onTimeout = k.onTimeout) (es : List Eff) (harm : armOf kFull es)
    (ht : hasTerminate es = true) : MayTerminate I.desc (tname id) :=
  hA id k es (by simp [phaseCont, hph]) (arm_fields k kFull es hN hTo hOu harm) ht

/-- One head keeps `ArmOk`. A fresh arm list is the outcome list of the effect
being run, and `TermOk` already records that effect. Every other continuation
is one the actor already held. -/
theorem exec_arm (I : Impl) (w w' : World) (id : InstId) (hT : TermOk I w) (hA : ArmOk I w)
    (h : execHead I w id = some w') : ArmOk I w' := by
  unfold execHead at h
  by_cases hliveA : (w.st id).life = .alive
  · simp [hliveA] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      intro i kNew es hk harm ht
      have hlive : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hliveA
      cases hrest : k.rest with
      | nil =>
        simp only [execRun, hlive, ite_true, hrest, setActor] at hk
        by_cases hi : i = id
        · simp [hi, phaseCont] at hk
        · exact hA i kNew es (by simpa [hi] using hk) harm ht
      | cons eff tail =>
        cases eff with
        | send dst label hint =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          cases hr : route w I.desc id dst with
          | none =>
            simp only [hr, setActor, noteStale_st] at hk
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          | some dstId =>
            simp only [hr] at hk
            exact enqueue_tail I w id dstId { label := label, sender := id, callFrom := none }
              false k hA hph i kNew es hk harm ht
        | trySend dst label hint onFull onGone =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          cases hr : route w I.desc id dst with
          | none =>
            simp only [hr, setActor, noteStale_st] at hk
            by_cases hi : i = id
            · let kGone := { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
              have heq := proceed_same _ kGone kNew (by simpa [kGone, hi] using hk)
              rw [hi]
              exact full_arm I w id k kGone hA hph (by simp [kGone, afterHead])
                (by simp [kGone, afterHead]) (by simp [kGone, afterHead]) es (by simpa [heq] using harm) ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          | some dstId =>
            simp only [hr] at hk
            split at hk
            · exact enqueue_tail I w id dstId
                { label := label, sender := id, callFrom := none, reliable := false }
                false k hA hph i kNew es hk harm ht
            · split at hk
              · simp only [setActor] at hk
                by_cases hi : i = id
                · let kFull := { afterHead k with rest := onFull, toState := pickState (afterHead k).toState (afterHead k).toFull }
                  have heq := proceed_same _ kFull kNew (by simpa [kFull, hi] using hk)
                  rw [hi]
                  exact full_arm I w id k kFull hA hph (by simp [kFull, afterHead])
                    (by simp [kFull, afterHead]) (by simp [kFull, afterHead]) es (by simpa [heq] using harm) ht
                · exact hA i kNew es (by simpa [hi] using hk) harm ht
              · simp only [setActor] at hk
                by_cases hi : i = id
                · let kGone := { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
                  have heq := proceed_same _ kGone kNew (by simpa [kGone, hi] using hk)
                  rw [hi]
                  exact full_arm I w id k kGone hA hph (by simp [kGone, afterHead])
                    (by simp [kGone, afterHead]) (by simp [kGone, afterHead]) es (by simpa [heq] using harm) ht
                · exact hA i kNew es (by simpa [hi] using hk) harm ht
        | call dst label hint na to =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          cases hr : resolveId I.desc w id dst with
          | none =>
            simp only [hr, setActor, noteStale_st] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (selectCall
                  ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) .notAdmitted) kNew
                (by simpa [setActor, hi, finishCall] using hk)
              rw [hi]
              exact call_arm I w id k dst label hint na to tail hph hrest hT hA es
                (by
                  have hsame := select_fields
                    ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) .notAdmitted
                  exact arm_fields _ _ es hsame.1 hsame.2.1 hsame.2.2 (by simpa [heq] using harm)) ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          | some dstId =>
            simp only [hr] at hk
            by_cases hliveD : (w.st dstId).life = .alive
            · by_cases hi : i = id
              · have harmK := enqueue_arm w I.desc id dstId
                  { label := label, sender := id, callFrom := some id } true
                  ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) kNew es
                  (by simpa [hi] using hk) harm
                rw [hi]
                exact call_arm I w id k dst label hint na to tail hph hrest hT hA es harmK ht
              · have hphj := enqueue_phase_other w I.desc id dstId
                  { label := label, sender := id, callFrom := some id } true
                  ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) i hi
                exact hA i kNew es (by simpa [hphj] using hk) harm ht
            · have hdead : (w.st dstId).life ≠ .alive := hliveD
              simp [enqueueOrPark, hdead] at hk
              by_cases hi : i = id
              · have heq := proceed_same _ (selectCall
                    ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) .notAdmitted) kNew
                  (by simpa [setActor, hi, finishCall] using hk)
                rw [hi]
                exact call_arm I w id k dst label hint na to tail hph hrest hT hA es
                  (by
                    have hsame := select_fields
                      ({ afterHead k with onNotAdmitted := na, onTimedOut := to }) .notAdmitted
                    exact arm_fields _ _ es hsame.1 hsame.2.1 hsame.2.2 (by simpa [heq] using harm)) ht
              · exact hA i kNew es (by simpa [setActor, hi] using hk) harm ht
        | reply =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          unfold performReply at hk
          cases hr : k.replyTo with
          | none =>
            simp [hr, setActor] at hk
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          | some caller =>
            simp [hr] at hk
            cases hphC : (w.st caller).phase with
            | awaitReply dst ck =>
              by_cases hd : dst = id
              · by_cases ho : (w.st id).oweId = some (w.st caller).waitId
                · simp [hphC, hd, ho, setActor] at hk
                  by_cases hi : i = id
                  · rw [hi]; exact tail_arm I w id k hA hph kNew es
                      (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
                  · by_cases hc : i = caller
                    · -- A matched reply runs the caller's own `ck`
                      -- (`selectCall .reply`). The wait id is retired; the
                      -- arm lists are the ones `ArmOk` already stored.
                      have hfin :
                          phaseCont (finishCall (w.st caller) ck .reply).phase = some kNew := by
                        have hii : (i = id) = False := eq_false hi
                        have hic : (i = caller) = True := eq_true hc
                        simpa [hii, hic, ite_false, ite_true] using hk
                      have heq : kNew = ck :=
                        proceed_same _ ck kNew
                          (by simpa [finishCall_phase, selectCall] using hfin)
                      rw [hc]
                      exact hA caller ck es (by simp [phaseCont, hphC]) (heq ▸ harm) ht
                    · exact hA i kNew es (by simpa [setActor, hc, hi] using hk) harm ht
                · simp [hphC, hd, ho, setActor] at hk
                  by_cases hi : i = id
                  · rw [hi]; exact tail_arm I w id k hA hph kNew es
                      (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
                  · exact hA i kNew es (by simpa [hi] using hk) harm ht
              · simp [hphC, hd, setActor] at hk
                by_cases hi : i = id
                · rw [hi]; exact tail_arm I w id k hA hph kNew es
                    (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
                · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | idle =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | run _ =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | parked _ _ _ =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | awaitEffect _ =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | awaitPeer _ =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            | crashed =>
              simp [hphC, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
        | selfSchedule label =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          split at hk
          · simp only [setActor] at hk
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          · split at hk
            · simp only [setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es (by simpa [hi] using hk) harm ht
            · exact hA i kNew es (crash_phaseCont w i kNew hk) harm ht
        | cell dst label value =>
          simp only [execRun, hlive, ite_true, hrest, setCell] at hk
          split at hk
          · simp only [setActor] at hk
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
            · exact hA i kNew es (by simpa [hi] using hk) harm ht
          · have hmid := wakeReaders_phaseCont I.desc
              (setActor (setCell w dst label { value := max (w.cell dst label).value value, dirty := true })
                id (proceed ((setCell w dst label
                  { value := max (w.cell dst label).value value, dirty := true }).st id) (afterHead k)))
              dst label id i kNew hk
            simp only [setActor] at hmid
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hmid)) harm ht
            · simp only [setCell, hi] at hmid
              exact hA i kNew es hmid harm ht
        | internal =>
          simp only [execRun, hlive, ite_true, hrest, setActor] at hk
          by_cases hi : i = id
          · simp [hi, phaseCont] at hk
            cases hk
            rw [hi]
            exact hA id k es (by simp [phaseCont, hph])
              (arm_fields k (afterHead k) es (after_fields k).1 (after_fields k).2.1
                (after_fields k).2.2 harm) ht
          · exact hA i kNew es (by simpa [hi] using hk) harm ht
        | peer onTimeout =>
          simp only [execRun, hlive, ite_true, hrest, setActor] at hk
          by_cases hi : i = id
          · simp [hi, phaseCont] at hk
            cases hk
            rw [hi]
            exact peer_arm I w id k onTimeout tail hph hrest hT hA es harm ht
          · exact hA i kNew es (by simpa [hi] using hk) harm ht
        | abort =>
          simp only [execRun, hlive, ite_true, hrest, commitCont] at hk
          by_cases hcr : (abortChildren I.desc w id).crashed = true
          · simp only [hcr, ite_true] at hk
            exact hA i kNew es (abort_phaseCont I.desc w id i kNew hk) harm ht
          · have hf : (abortChildren I.desc w id).crashed = false := by
              simpa [Bool.not_eq_true] using hcr
            simp only [hf, ite_false, setActor] at hk
            by_cases hi : i = id
            · rw [hi]; exact tail_arm I w id k hA hph kNew es
                (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
            · exact hA i kNew es
                (abort_phaseCont I.desc w id i kNew (by simpa [setActor, hi] using hk)) harm ht
        | spawn child =>
          simp only [execRun, hlive, ite_true, hrest] at hk
          cases hs : spawnChild I w id child with
          | none =>
            simp only [hs] at hk
            exact hA i kNew es (crash_phaseCont w i kNew hk) harm ht
          | some w1 =>
            simp only [hs, commitCont] at hk
            by_cases hcr : w1.crashed = true
            · simp only [hcr, ite_true] at hk
              exact hA i kNew es (spawn_phaseCont I w id child w1 i kNew hs hk) harm ht
            · have hf : w1.crashed = false := by simpa [Bool.not_eq_true] using hcr
              simp only [hf, ite_false, setActor] at hk
              by_cases hi : i = id
              · rw [hi]; exact tail_arm I w id k hA hph kNew es
                  (proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)) harm ht
              · exact hA i kNew es
                  (spawn_phaseCont I w id child w1 i kNew hs (by simpa [setActor, hi] using hk)) harm ht
        | terminate =>
          have hl : (w.st id).life = .alive := hliveA
          rcases execRun_terminate I w id (w.st id) k hl ⟨tail, hrest⟩ with
            hw | ⟨_, _, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, hw⟩ | ⟨_, _, _, _, _, _, _, hw⟩
          · rw [hw] at hk
            exact hA i kNew es (crash_phaseCont w i kNew hk) harm ht
          · rw [hw] at hk
            exact hA i kNew es (shutdown_phaseCont I.desc w id i kNew hk) harm ht
          · rw [hw] at hk
            exact hA i kNew es (terminate_phaseCont I.desc w id i kNew hk) harm ht
          · rw [hw] at hk
            exact hA i kNew es (terminate_phaseCont I.desc w id i kNew hk) harm ht
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hliveA] at h

/-- Outcome arms survive a step. A fresh transition starts with empty arms, and
`hasTerminate []` is false, so it cannot introduce a terminating arm. Copying a
continuation copies its arms. -/
theorem arm_step (I : Impl) (a : Action) (w w' : World) (hT : TermOk I w) (hA : ArmOk I w)
    (h : apply I a w = some w') : ArmOk I w' := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    exact hA
  | ingress dst label =>
    exact arm_same I w w' hA fun i =>
      (ingress_phase I w w' dst label i
        (by simpa [stepWorld] using (apply_step I (.ingress dst label) w w' h).2)).1
  | spawn template =>
    have hs : spawn I w template = some w' := by
      simpa [stepWorld] using (apply_step I (.spawn template) w w' h).2
    intro i k es hk harm ht
    rcases spawn_phase I w w' template i hs with ⟨_, hidle, _⟩ | heq
    · simp [phaseCont, hidle] at hk
    · exact hA i k es (by simpa [heq] using hk) harm ht
  | finish id =>
    have hf : finishWait I w id = some w' := by
      simpa [stepWorld] using (apply_step I (.finish id) w w' h).2
    obtain ⟨k0, hph0, hw⟩ := finish_proceed I w w' id hf
    intro i k es hk harm ht
    rw [hw] at hk
    by_cases hi : i = id
    · simp [setActor, hi] at hk
      cases hr : k0.rest with
      | nil => simp [proceed, hr, phaseCont] at hk
      | cons _ _ =>
        simp [proceed, hr, phaseCont] at hk
        subst hk
        rcases hph0 with hE | hP
        · rw [hi]
          exact hA id k0 es (by simp [phaseCont, hE]) harm ht
        · rw [hi]
          exact hA id k0 es (by simp [phaseCont, hP]) harm ht
    · simp [setActor, hi] at hk
      exact hA i k es hk harm ht
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by
      simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
    intro i kNew es hk harm ht
    cases callTimeout_view w w' id hct with
    | peer k0 hph hw =>
      rw [hw] at hk
      by_cases hi : i = id
      · simp [setActor, hi] at hk
        cases hr : k0.onTimeout with
        | nil => simp [proceed, hr, phaseCont] at hk
        | cons _ _ =>
          simp [proceed, hr, phaseCont] at hk
          subst hk
          have harm0 : armOf k0 es := by simpa [armOf, hr] using harm
          rw [hi]
          exact hA id k0 es (by simp [phaseCont, hph]) harm0 ht
      · simp [setActor, hi] at hk
        exact hA i kNew es hk harm ht
    | park dst k0 hph hw =>
      rw [hw] at hk
      by_cases hi : i = id
      · simp [setActor, hi, finishCall] at hk
        cases hr : (selectCall k0 .notAdmitted).rest with
        | nil => simp [proceed, hr, phaseCont] at hk
        | cons _ _ =>
          simp [proceed, hr, phaseCont] at hk
          subst hk
          have harm0 : armOf k0 es := by simpa [armOf, selectCall] using harm
          rw [hi]
          exact hA id k0 es (by simp [phaseCont, hph]) harm0 ht
      · simp [setActor, hi] at hk
        exact hA i kNew es (by simpa [(refundCall_fields w id dst i).1] using hk) harm ht
    | await dst k0 hph hw =>
      rw [hw] at hk
      by_cases hi : i = id
      · simp [setActor, hi, finishCall] at hk
        cases hr : (selectCall k0 .timedOut).rest with
        | nil => simp [proceed, hr, phaseCont] at hk
        | cons _ _ =>
          simp [proceed, hr, phaseCont] at hk
          subst hk
          have harm0 : armOf k0 es := by simpa [armOf, selectCall] using harm
          rw [hi]
          exact hA id k0 es (by simp [phaseCont, hph]) harm0 ht
      · by_cases hd : i = dst
        · rw [hd] at hk
          have hne : dst ≠ id := fun h => hi (hd.trans h)
          rw [setActor_other
              (setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId))
              id dst
              (finishCall
                ((setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)).st id)
                k0 .timedOut) hne] at hk
          rw [setActor_self] at hk
          unfold detachReply at hk
          by_cases howe : ((detachBox (w.st dst) id).oweId == some (w.st id).waitId) = true
          · simp [howe, clearReplyPhase] at hk
            cases hprev : (detachBox (w.st dst) id).phase with
            | run k1 =>
              simp [hprev, phaseCont, clearReplyCont] at hk
              have harm0 : armOf k1 es := by
                rw [← hk] at harm
                by_cases hr : k1.replyTo = some id
                · simp [hr, armOf] at harm
                  exact harm
                · simp [hr, armOf] at harm
                  exact harm
              have hback : (w.st i).phase = .run k1 := by
                simpa [hd, detachBox] using hprev
              exact hA i k1 es (by simp [phaseCont, hback]) harm0 ht
            | parked d c k1 =>
              simp [hprev, phaseCont, clearReplyCont] at hk
              have harm0 : armOf k1 es := by
                rw [← hk] at harm
                by_cases hr : k1.replyTo = some id
                · simp [hr, armOf] at harm
                  exact harm
                · simp [hr, armOf] at harm
                  exact harm
              have hback : (w.st i).phase = .parked d c k1 := by
                simpa [hd, detachBox] using hprev
              exact hA i k1 es (by simp [phaseCont, hback]) harm0 ht
            | awaitReply d k1 =>
              simp [hprev, phaseCont, clearReplyCont] at hk
              have harm0 : armOf k1 es := by
                rw [← hk] at harm
                by_cases hr : k1.replyTo = some id
                · simp [hr, armOf] at harm
                  exact harm
                · simp [hr, armOf] at harm
                  exact harm
              have hback : (w.st i).phase = .awaitReply d k1 := by
                simpa [hd, detachBox] using hprev
              exact hA i k1 es (by simp [phaseCont, hback]) harm0 ht
            | awaitEffect k1 =>
              simp [hprev, phaseCont, clearReplyCont] at hk
              have harm0 : armOf k1 es := by
                rw [← hk] at harm
                by_cases hr : k1.replyTo = some id
                · simp [hr, armOf] at harm
                  exact harm
                · simp [hr, armOf] at harm
                  exact harm
              have hback : (w.st i).phase = .awaitEffect k1 := by
                simpa [hd, detachBox] using hprev
              exact hA i k1 es (by simp [phaseCont, hback]) harm0 ht
            | awaitPeer k1 =>
              simp [hprev, phaseCont, clearReplyCont] at hk
              have harm0 : armOf k1 es := by
                rw [← hk] at harm
                by_cases hr : k1.replyTo = some id
                · simp [hr, armOf] at harm
                  exact harm
                · simp [hr, armOf] at harm
                  exact harm
              have hback : (w.st i).phase = .awaitPeer k1 := by
                simpa [hd, detachBox] using hprev
              exact hA i k1 es (by simp [phaseCont, hback]) harm0 ht
            | idle => simp [hprev, phaseCont] at hk
            | crashed => simp [hprev, phaseCont] at hk
          · have hf : ((detachBox (w.st dst) id).oweId == some (w.st id).waitId) = false := by
              simpa [Bool.not_eq_true] using howe
            rw [hf] at hk
            simp only [detachBox] at hk
            rw [← hd] at hk
            exact hA i kNew es hk harm ht
        · simp [setActor, hi, hd] at hk
          exact hA i kNew es hk harm ht
  | recvBulk id =>
    exact bulk_arm I w w' id hA
      (by simpa [stepWorld] using (apply_step I (.recvBulk id) w w' h).2)
  | recvPrio id =>
    exact prio_arm I w w' id hA
      (by simpa [stepWorld] using (apply_step I (.recvPrio id) w w' h).2)
  | exec id =>
    exact exec_arm I w w' id hT hA
      (by simpa [stepWorld] using (apply_step I (.exec id) w w' h).2)

theorem term_ok_reachable (I : Impl) (hL : LocalOk I) (N : Nat) (w : World)
    (hR : Reachable I N w) : TermOk I w := by
  have hboth : TermOk I w ∧ ArmOk I w := by
    induction hR with
    | init => exact ⟨term_ok_init I N, arm_ok_init I N⟩
    | step w w' a _ h ih =>
      exact ⟨term_ok_apply I hL a w w' ih.1 ih.2 h, arm_step I a w w' ih.1 ih.2 h⟩
  exact hboth.1

/-- `Inv2` plus the fact that a carried `terminate` came from a checked transition. -/
def Inv3 (I : Impl) (w : World) : Prop := Inv2 I w ∧ TermOk I w

theorem inv3_init (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) : Inv3 I (initWorld I N) :=
  ⟨inv2_init I hL hG N, term_ok_init I N⟩

theorem inv3_reachable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) : Inv3 I w :=
  ⟨inv2_reachable I hL hG N w hR, term_ok_reachable I hL N w hR⟩

theorem run_tail_shorter (e : Eff) (tail : List Eff) (k' : Cont) (heq : k'.rest = tail) :
    k'.rest.length < (e :: tail).length := by
  simp [heq]

mutual
/-- Tree size of a program. An outcome list is counted inside the effect that
stores it, so switching `rest` to that list is still a descent. -/
def listSize : List Eff → Nat
  | [] => 0
  | e :: es => effSize e + listSize es

/-- One plus the outcome lists an effect can switch to. -/
def effSize : Eff → Nat
  | .trySend _ _ _ onFull onGone => 1 + listSize onFull + listSize onGone
  | .call _ _ _ na to => 1 + listSize na + listSize to
  | .peer onTimeout => 1 + listSize onTimeout
  | _ => 1
end

theorem effSize_pos (e : Eff) : 0 < effSize e := by
  cases e <;> simp [effSize, listSize] <;> omega

theorem listSize_cons_lt (e : Eff) (es : List Eff) : listSize es < listSize (e :: es) := by
  simp [listSize]
  have := effSize_pos e
  omega

theorem listSize_try_full (dst label : String) (hint : Nat) (onFull onGone tail : List Eff) :
    listSize onFull < listSize (.trySend dst label hint onFull onGone :: tail) := by
  simp [listSize, effSize]
  omega

theorem listSize_try_gone (dst label : String) (hint : Nat) (onFull onGone tail : List Eff) :
    listSize onGone < listSize (.trySend dst label hint onFull onGone :: tail) := by
  simp [listSize, effSize]
  omega

theorem listSize_call_na (dst label : String) (hint : Nat) (na to tail : List Eff) :
    listSize na < listSize (.call dst label hint na to :: tail) := by
  simp [listSize, effSize]
  omega

theorem run_after_smaller (a : Actor) (k k' : Cont) (hne : k.rest ≠ [])
    (h : (proceed a (afterHead k)).phase = .run k') : listSize k'.rest < listSize k.rest := by
  have ⟨heq, _⟩ := proceed_run_rest a (afterHead k) k' h
  rw [heq, show (afterHead k).rest = k.rest.tail from by simp [afterHead]]
  cases hk : k.rest with
  | nil => exact absurd hk hne
  | cons e es =>
    simp [hk]
    exact listSize_cons_lt e es

theorem run_arm_smaller (a : Actor) (kArm k' : Cont) (bound : Nat)
    (h : (proceed a kArm).phase = .run k') (hlt : listSize kArm.rest < bound) :
    listSize k'.rest < bound := by
  have ⟨heq, _⟩ := proceed_run_rest a kArm k' h
  simpa [heq] using hlt

theorem crash_roster_crashed (w : World) (i : InstId) (hmem : i ∈ w.roster)
    (hl : (w.st i).life = .alive) :
    ((crashWorld w).st i).phase = .crashed ∧ ((crashWorld w).st i).life = .dead := by
  simp [crashWorld, crashActor, hmem, hl]

theorem crash_roster_not_run (w : World) (i : InstId) (k : Cont) (hmem : i ∈ w.roster)
    (hl : (w.st i).life = .alive) : ((crashWorld w).st i).phase ≠ .run k := by
  intro hp
  simp [(crash_roster_crashed w i hmem hl).1] at hp

/-- A spawn that returns a world does not crash it, and does not rewrite the
parent. The fresh peer is off the roster (`maxGen_fresh`). -/
theorem spawn_some_open (I : Impl) (w w' : World) (parent : InstId) (child : String)
    (h : spawnChild I w parent child = some w') (hcr : w.crashed = false) : w'.crashed = false := by
  unfold spawnChild at h
  cases ht : templateOf I.desc child with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hok : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
        (w.st parent).life == .alive) = true
    · simp only [hok, ite_true] at h
      cases parent with
      | core _ => simp at h
      | peer n key g =>
        by_cases hblk : slotRespawnBlocked I.desc w (.peer n key g) child key = true
        · simp [hblk] at h
          cases h
          exact hcr
        · have hf : slotRespawnBlocked I.desc w (.peer n key g) child key = false := by
            cases hb : slotRespawnBlocked I.desc w (.peer n key g) child key with
            | false => rfl
            | true => exact absurd hb hblk
          simp only [hf] at h
          cases h
          rw [admitBorn_crashed]
          exact hcr
    · have hno : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
          (w.st parent).life == .alive) = false := by
        cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
            (w.st parent).life == .alive with
        | false => rfl
        | true => exact absurd hb hok
      simp only [hno] at h
      by_cases hstay : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = true
      · simp [hstay] at h
        cases h
        exact hcr
      · have hstayF : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = false := by
          cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) with
          | false => rfl
          | true => exact absurd hb hstay
        simp [hstayF] at h

/-- A child that `spawnChild` actually installs is the fresh generation, idle
and alive. Every other actor, including the parent, keeps its phase and life. -/
theorem spawn_child_quiet (I : Impl) (w w' : World) (parent : InstId) (child : String)
    (s : InstId) (hs : s ≠ parent) (h : spawnChild I w parent child = some w') :
    ((w'.st s).phase = (w.st s).phase ∧ (w'.st s).life = (w.st s).life) ∨
      ((w'.st s).phase = .idle ∧ (w'.st s).life = .alive ∧ s ∈ w'.roster ∧ s ∉ w.roster) := by
  unfold spawnChild at h
  cases ht : templateOf I.desc child with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hok : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
        (w.st parent).life == .alive) = true
    · simp only [hok, ite_true] at h
      cases parent with
      | core _ => simp at h
      | peer n key g =>
        by_cases hblk : slotRespawnBlocked I.desc w (.peer n key g) child key = true
        · simp [hblk] at h
          cases h
          exact Or.inl ⟨rfl, rfl⟩
        · have hf : slotRespawnBlocked I.desc w (.peer n key g) child key = false := by
            cases hb : slotRespawnBlocked I.desc w (.peer n key g) child key with
            | false => rfl
            | true => exact absurd hb hblk
          simp only [hf] at h
          cases h
          let fresh := InstId.peer child key (maxGen w child key)
          by_cases hself : s = fresh
          · have hnot : s ∉ w.roster := by
              intro hmem
              exact Nat.lt_irrefl _ (maxGen_fresh w child key _ (by simpa [hself, fresh] using hmem))
            refine Or.inr ⟨?_, ?_, ?_, hnot⟩
            · simp [admitBorn, readCells_st, setActor, hself, fresh, bornActor, withKeyTokens]
            · simp [admitBorn, readCells_st, setActor, hself, fresh, bornActor, withKeyTokens]
            · rw [hself]
              unfold admitBorn
              rw [readCells_roster]
              simp [setActor]
              exact Or.inr rfl
          · exact Or.inl (by simp [admitBorn, readCells_st, setActor, hself, fresh])
    · have hno : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
          (w.st parent).life == .alive) = false := by
        cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
            (w.st parent).life == .alive with
        | false => rfl
        | true => exact absurd hb hok
      simp only [hno] at h
      by_cases hstay : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = true
      · simp [hstay] at h
        cases h
        exact Or.inl ⟨rfl, rfl⟩
      · have hstayF : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = false := by
          cases hb : t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) with
          | false => rfl
          | true => exact absurd hb hstay
        simp [hstayF] at h

theorem tombstone_crash_phase (D : Description) (w : World) (child parent : InstId)
    (hmem : parent ∈ w.roster) (hl : (w.st parent).life = .alive) (hcr0 : w.crashed = false)
    (hcr : (enqueueTombstone D w child).crashed = true) :
    ((enqueueTombstone D w child).st parent).phase = .crashed ∧
      ∀ c, c ∈ w.roster → ((enqueueTombstone D w child).st c).life ≠ .alive := by
  unfold enqueueTombstone at hcr ⊢
  cases hpar : (w.st child).parent with
  | none => simp [hpar, hcr0] at hcr
  | some sup =>
    simp only [hpar] at hcr ⊢
    by_cases hlive : ((w.st sup).life != .alive) = true
    · simp [hlive, hcr0] at hcr
    · have hliveF : ((w.st sup).life != .alive) = false := by
        simpa [Bool.not_eq_true] using hlive
      simp only [hliveF, ite_false] at hcr ⊢
      by_cases hlab : ((tombstoneMsg D (w.st sup) child).label == "") = true
      · simp only [hlab, ite_true] at hcr ⊢
        refine ⟨(crash_roster_crashed w parent hmem hl).1, ?_⟩
        intro c hc
        exact crash_member_not_alive w c hc
      · have hlabF : ((tombstoneMsg D (w.st sup) child).label == "") = false := by
          simpa [Bool.not_eq_true] using hlab
        simp only [hlabF, ite_false] at hcr ⊢
        unfold offerPrio at hcr ⊢
        by_cases hfull : decide (prioLoad (w.st sup).prio >= capPrio D w.N sup) = true
        · simp only [hfull, ite_true] at hcr ⊢
          refine ⟨(crash_roster_crashed w parent hmem hl).1, ?_⟩
          intro c hc
          exact crash_member_not_alive w c hc
        · have hroom : decide (prioLoad (w.st sup).prio >= capPrio D w.N sup) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp [hroom, setActor_crashed, hcr0] at hcr

theorem shutdown_crash_phase (D : Description) (w : World) (child parent : InstId)
    (hne : child ≠ parent) (hmem : parent ∈ w.roster) (hl : (w.st parent).life = .alive)
    (hcr0 : w.crashed = false) (hcr : (shutdownActor D w child).crashed = true) :
    ((shutdownActor D w child).st parent).phase = .crashed ∧
      ∀ c, c ∈ w.roster → ((shutdownActor D w child).st c).life ≠ .alive := by
  unfold shutdownActor at hcr ⊢
  by_cases hlive : ((w.st child).life == .alive) = true
  · simp only [hlive, ite_true, sealActor] at hcr ⊢
    have hrel : ((releaseWorld D w child (w.st child)).st parent).life = .alive := by
      rw [releaseWorld_other_life D w child (w.st child) parent hne.symm]
      exact hl
    have hmemR : parent ∈ (releaseWorld D w child (w.st child)).roster := by
      rw [releaseWorld_roster]
      exact hmem
    have hcrR : (releaseWorld D w child (w.st child)).crashed = false := by
      rw [releaseWorld_crashed]
      exact hcr0
    have hroster : (releaseWorld D w child (w.st child)).roster = w.roster := releaseWorld_roster _ _ _ _
    have htomb := tombstone_crash_phase D (releaseWorld D w child (w.st child)) child parent
      hmemR hrel hcrR hcr
    refine ⟨htomb.1, ?_⟩
    intro c hc
    exact htomb.2 c (by rw [hroster]; exact hc)
  · simp [hlive, hcr0] at hcr

/-- Aborting the children crashes only by `crashWorld`. The parent was alive on
the roster, so that crash leaves it in `.crashed`, not in `.run`. A child is
not its own parent (`ParentAcyclic`), so the seal does not rewrite the parent
before the crash. -/
theorem abort_crashed_phase (D : Description) (w : World) (parent : InstId) (k : Cont)
    (hmem : parent ∈ w.roster) (hl : (w.st parent).life = .alive)
    (hph : (w.st parent).phase = .run k) (hacy : ParentAcyclic w) (hstart : w.crashed = false)
    (hcr : (abortChildren D w parent).crashed = true) :
    ((abortChildren D w parent).st parent).phase = .crashed := by
  have hphase : ((abortChildren D w parent).st parent).phase = .crashed := by
    unfold abortChildren at hcr ⊢
    have hfold : ∀ (ids : List InstId) (w0 : World),
        (∀ c, c ∈ ids → c ∈ w.roster) → w0.roster = w.roster →
        (w0.crashed = false → (w0.st parent).life = .alive ∧ (w0.st parent).phase = .run k ∧
          ParentAcyclic w0) →
        (w0.crashed = true → (w0.st parent).phase = .crashed ∧
          ∀ c, c ∈ w.roster → (w0.st c).life ≠ .alive) →
        ((ids.foldl (fun acc child =>
          if isChild acc parent child && (acc.st child).life == .alive then
            shutdownActor D (dropDescendants D acc child) child else acc) w0).crashed = true) →
        ((ids.foldl (fun acc child =>
          if isChild acc parent child && (acc.st child).life == .alive then
            shutdownActor D (dropDescendants D acc child) child else acc) w0).st parent).phase =
          .crashed := by
      intro ids
      induction ids with
      | nil =>
        intro w0 _ _ _ hdead hcr0
        exact (hdead hcr0).1
      | cons child ids ih =>
        intro w0 hsub hroster halive hdead hcr0
        simp only [List.foldl_cons] at hcr0 ⊢
        have hsub' : ∀ c, c ∈ ids → c ∈ w.roster := fun c hc => hsub c (List.mem_cons.mpr (Or.inr hc))
        by_cases hgo : (isChild w0 parent child && (w0.st child).life == .alive) = true
        · simp only [hgo, ite_true] at hcr0 ⊢
          have hparts := (Bool.and_eq_true _ _).mp hgo
          have hchild : isChild w0 parent child = true := hparts.1
          have hne : child ≠ parent := (isChild_edge w0 parent child hchild).2
          have hcrStart : w0.crashed = false := by
            cases hb : w0.crashed with
            | false => rfl
            | true =>
              exact absurd (beq_iff_eq.mp hparts.2)
                ((hdead hb).2 child (hsub child (List.mem_cons.mpr (Or.inl rfl))))
          have ⟨hl0, hph0, hacy0⟩ := halive hcrStart
          have hlife1 : ((dropDescendants D w0 child).st parent).life = .alive := by
            rcases (dropDescendants_stable D w0 child).2.2 parent with heq | hanc
            · rw [heq]
              exact hl0
            · exact absurd
                (StrictAncestor.trans hanc (StrictAncestor.edge (isChild_edge w0 parent child hchild)))
                (ParentAcyclic.no_self hacy0 parent)
          have hph1 := dropDescendants_preserves_run D w0 child parent k hph0 hlife1
          have hcr1 : (dropDescendants D w0 child).crashed = false := by
            rw [(dropDescendants_stable D w0 child).2.1]
            exact hcrStart
          have hroster1 : (dropDescendants D w0 child).roster = w.roster := by
            rw [drop_roster, hroster]
          have hacy1 : ParentAcyclic (dropDescendants D w0 child) :=
            parentAcyclic_parents (dropDescendants_stable D w0 child).1 hacy0
          let w1 := dropDescendants D w0 child
          by_cases hsh : (shutdownActor D w1 child).crashed = true
          · have hkilled := shutdown_crash_phase D w1 child parent hne
              (by rw [hroster1]; exact hmem) hlife1 hcr1 hsh
            have hrosterS : (shutdownActor D w1 child).roster = w.roster := by
              rw [shutdown_roster, hroster1]
            have hkilledR : ∀ c, c ∈ w.roster → ((shutdownActor D w1 child).st c).life ≠ .alive := by
              intro c hc
              exact hkilled.2 c (by rw [hroster1]; exact hc)
            exact ih _ hsub' hrosterS (fun hc => by rw [hsh] at hc; cases hc)
              (fun _ => ⟨hkilled.1, hkilledR⟩) hcr0
          · have hcf : (shutdownActor D w1 child).crashed = false := by
              simpa [Bool.not_eq_true] using hsh
            have hlife2 : ((shutdownActor D w1 child).st parent).life = .alive := by
              rw [shutdownActor_other_life D w1 child parent (Ne.symm hne) hcf]
              exact hlife1
            have hph2 := shutdownActor_preserves_run D w1 child parent k hph1 hlife2
            have hacy2 : ParentAcyclic (shutdownActor D w1 child) :=
              parentAcyclic_parents (fun j => (shutdownActor_parent D w1 child j).trans
                ((dropDescendants_stable D w0 child).1 j)) hacy0
            have hroster2 : (shutdownActor D w1 child).roster = w.roster := by
              rw [shutdown_roster, hroster1]
            exact ih _ hsub' hroster2 (fun _ => ⟨hlife2, hph2, hacy2⟩)
              (fun hc => by rw [hcf] at hc; cases hc) hcr0
        · have hf : (isChild w0 parent child && (w0.st child).life == .alive) = false := by
            simpa [Bool.not_eq_true] using hgo
          simp only [hf, ite_false] at hcr0 ⊢
          exact ih w0 hsub' hroster halive hdead hcr0
    exact hfold w.roster w (fun _ h => h) rfl (fun _ => ⟨hl, hph, hacy⟩)
      (fun hc => by rw [hstart] at hc; cases hc) hcr
  exact hphase

theorem abort_crashed_not_run (D : Description) (w : World) (parent : InstId) (k k' : Cont)
    (hmem : parent ∈ w.roster) (hl : (w.st parent).life = .alive)
    (hph : (w.st parent).phase = .run k) (hacy : ParentAcyclic w) (hstart : w.crashed = false)
    (hcr : (abortChildren D w parent).crashed = true)
    (h : ((abortChildren D w parent).st parent).phase = .run k') : False := by
  simp [abort_crashed_phase D w parent k hmem hl hph hacy hstart hcr] at h

/-- A head that is still `.run` afterwards is running a strictly smaller effect
tree. The measure is the tree size of the current rest: `trySend`'s `onFull`
and `onGone`, and a call's `NotAdmitted`, replace the effect that contains
them, so a long arm is still smaller than the effect just consumed.
`w.crashed = false` is the run invariant: `commitCont` would otherwise keep
the crashed world, and a crashed roster is not a run. -/
theorem exec_shortens (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (id : InstId) (k k' : Cont)
    (hph : (w.st id).phase = .run k) (hl : (w.st id).life = .alive) (hcr : w.crashed = false)
    (h : ((execRun I w id (w.st id) k).st id).phase = .run k') :
    listSize k'.rest < listSize k.rest := by
  have hT := term_ok_reachable I hL N w hR
  have hgo : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hl
  have hmem : id ∈ w.roster := ((inv2_reachable I hL hG N w hR).2.1).aliveIn id hl
  have hacy : ParentAcyclic w := (inv_reachable I N w hL hR).forest.wf
  cases hrest : k.rest with
  | nil => simp [execRun, hgo, hrest, setActor, hph] at h
  | cons e tail =>
    cases e with
    | terminate =>
      have hk : { k with rest := .terminate :: tail } = k := by simp [← hrest]
      have hdead := terminate_commits I hL hG N w hR hT id k tail (by simpa [hk] using hph) hl
      rw [hk] at hdead
      rcases hdead.2 with hidle | hcrash
      · simp [hidle] at h
      · simp [hcrash] at h
    | send dst label hint =>
      simp only [execRun, hgo, ite_true, hrest] at h
      cases hr : route w I.desc id dst with
      | none =>
        simp only [hr, setActor, noteStale_st] at h
        simpa [hrest] using run_after_smaller (w.st id) k k' (by simp [hrest]) h
      | some dstId =>
        simp only [hr] at h
        have hc : carried ((enqueueOrPark w I.desc id dstId { label := label, sender := id, callFrom := none } false (afterHead k)).st id).phase = some k'.rest := by
          simp [carried, h]
        have heq := enqueue_carried w I.desc id dstId { label := label, sender := id, callFrom := none } false (afterHead k) k'.rest (Or.inr rfl) hc
        rw [heq, show (afterHead k).rest = tail from by simp [afterHead, hrest]]
        exact listSize_cons_lt (.send dst label hint) tail
    | call dst label hint na to =>
      simp only [execRun, hgo, ite_true, hrest] at h
      let kWait := { afterHead k with onNotAdmitted := na, onTimedOut := to }
      cases hr : resolveId I.desc w id dst with
      | none =>
        simp only [hr, setActor, noteStale_st, finishCall, selectCall, issueCall] at h
        simpa [hrest] using run_arm_smaller (issueCall (w.st id)) (selectCall kWait .notAdmitted) k'
          (listSize k.rest) h (by simp [kWait, selectCall, hrest, listSize_call_na])
      | some dstId =>
        simp only [hr] at h
        by_cases hliveD : (w.st dstId).life = .alive
        · simp only [enqueueOrPark] at h
          have hstay : ((w.st dstId).life ≠ .alive) = False := eq_false fun hne => hne hliveD
          simp only [hstay, ite_false] at h
          split at h
          · split at h <;> simp [setActor] at h
          · split at h <;> simp [setActor] at h
        · have hgone : ((w.st dstId).life ≠ .alive) = True := eq_true hliveD
          simp only [enqueueOrPark, hgone, ite_true, setActor] at h
          have hp : (proceed (issueCall (w.st id)) (selectCall kWait .notAdmitted)).phase = .run k' := by
            simpa [finishCall] using h
          simpa [hrest] using run_arm_smaller (issueCall (w.st id)) (selectCall kWait .notAdmitted) k'
            (listSize k.rest) hp (by simp [kWait, selectCall, hrest, listSize_call_na])
    | trySend dst label hint onFull onGone =>
      simp only [execRun, hgo, ite_true, hrest] at h
      let kFull := { afterHead k with rest := onFull, toState := pickState (afterHead k).toState (afterHead k).toFull }
      let kGone := { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
      cases hr : route w I.desc id dst with
      | none =>
        simp only [hr, setActor, noteStale_st] at h
        simpa [hrest] using run_arm_smaller (w.st id) kGone k' (listSize k.rest) h (by simp [kGone, hrest, listSize_try_gone])
      | some dstId =>
        simp only [hr] at h
        split at h
        · have hc : carried ((enqueueOrPark w I.desc id dstId { label := label, sender := id, callFrom := none, reliable := false } false (afterHead k)).st id).phase = some k'.rest := by
            simp [carried, h]
          have heq := enqueue_carried w I.desc id dstId { label := label, sender := id, callFrom := none, reliable := false } false (afterHead k) k'.rest (Or.inr rfl) hc
          rw [heq, show (afterHead k).rest = tail from by simp [afterHead, hrest]]
          exact listSize_cons_lt (.trySend dst label hint onFull onGone) tail
        · split at h
          · simp only [setActor] at h
            simpa [hrest] using run_arm_smaller (w.st id) kFull k' (listSize k.rest) h (by simp [kFull, hrest, listSize_try_full])
          · simp only [setActor] at h
            simpa [hrest] using run_arm_smaller (w.st id) kGone k' (listSize k.rest) h (by simp [kGone, hrest, listSize_try_gone])
    | reply =>
      simp only [execRun, hgo, ite_true, hrest] at h
      have hc : carried ((performReply w id k).st id).phase = some k'.rest := by simp [carried, h]
      have heq := reply_sender_rest w id k k'.rest hc
      rw [heq, show (afterHead k).rest = tail from by simp [afterHead, hrest]]
      exact listSize_cons_lt .reply tail
    | selfSchedule label =>
      simp only [execRun, hgo, ite_true, hrest] at h
      split at h
      · simp only [setActor] at h
        simpa [hrest] using run_after_smaller (w.st id) k k' (by simp [hrest]) h
      · split at h
        · simp only [setActor, ite_true] at h
          simpa [hrest] using run_after_smaller _ k k' (by simp [hrest]) h
        · exact absurd h (crash_roster_not_run w id k' hmem hl)
    | cell dst label value =>
      simp only [execRun, hgo, ite_true, hrest] at h
      split at h
      · simp only [setCell, setActor] at h
        simpa [hrest] using run_after_smaller (w.st id) k k' (by simp [hrest]) h
      · let wPre := setActor (setCell w dst label { value := max (w.cell dst label).value value, dirty := true }) id (proceed ((setCell w dst label { value := max (w.cell dst label).value value, dirty := true }).st id) (afterHead k))
        have hback := wakeReaders_phaseCont I.desc wPre dst label id id k'
          (by
            have hp : ((wakeReaders I.desc wPre dst label id).st id).phase = .run k' := by
              simpa [wPre] using h
            simp [phaseCont, hp])
        simp only [wPre, setActor, setCell] at hback
        have heq := proceed_same (w.st id) (afterHead k) k' hback
        rw [heq, show (afterHead k).rest = tail from by simp [afterHead, hrest]]
        exact listSize_cons_lt (.cell dst label value) tail
    | internal => simp [execRun, hgo, hrest, setActor] at h
    | peer onTimeout => simp [execRun, hgo, hrest, setActor] at h
    | abort =>
      simp only [execRun, hgo, ite_true, hrest, commitCont] at h
      by_cases hcrA : (abortChildren I.desc w id).crashed = true
      · simp only [hcrA, ite_true] at h
        exact False.elim (abort_crashed_not_run I.desc w id k k' hmem hl hph hacy hcr hcrA h)
      · have hcf : (abortChildren I.desc w id).crashed = false := by
          simpa [Bool.not_eq_true] using hcrA
        have hff : (false = true) = False := by decide
        simp only [commitCont, hcf, hff, ite_false, setActor, ite_true] at h
        simpa [hrest] using run_after_smaller ((abortChildren I.desc w id).st id) k k' (by simp [hrest]) h
    | spawn child =>
      simp only [execRun, hgo, ite_true, hrest] at h
      cases hs : spawnChild I w id child with
      | none =>
        simp only [hs] at h
        exact absurd h (crash_roster_not_run w id k' hmem hl)
      | some w1 =>
        have hcf := spawn_some_open I w w1 id child hs hcr
        have hff : (false = true) = False := by decide
        simp only [hs, commitCont, hcf, hff, ite_false, setActor, ite_true] at h
        simpa [hrest] using run_after_smaller (w1.st id) k k' (by simp [hrest]) h

theorem run_prefix {I : Impl} (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s : InstId) (i n : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st s).phase = .run k)
    (hl : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st s).life = .alive)
    (hnot : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .exec s) :
    RunKept k ((ρ.cfg (i + n)).st s).phase := by
  induction n with
  | zero => exact Or.inl (by simpa using hp)
  | succ n ih =>
    have hp' := ih
      (fun t h1 h2 => hl t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnot t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    have hlife := hl (i + n) (Nat.le_add_right i n) (Nat.le_succ _)
    have hact := hnot (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _)
    have hlater := hl (i + n + 1) (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _)) (Nat.le_refl _)
    have hstep := step_keeps_run_kept I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) hO s k hp'
      hlife (ρ.valid (i + n)) hact hlater
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hstep

def scanExec (act : Nat → Action) (s : InstId) : Nat → Nat → Nat
  | 0, k => k
  | fuel + 1, k => if act k = .exec s then k else scanExec act s fuel (k + 1)

theorem scanExec_spec (act : Nat → Action) (s : InstId) (fuel k : Nat)
    (h : ∃ d, d ≤ fuel ∧ act (k + d) = .exec s) :
    k ≤ scanExec act s fuel k ∧ act (scanExec act s fuel k) = .exec s ∧
      ∀ t, k ≤ t → t < scanExec act s fuel k → act t ≠ .exec s := by
  induction fuel generalizing k with
  | zero =>
    obtain ⟨d, hd, hact⟩ := h
    have hd0 : d = 0 := by omega
    simp [scanExec]
    constructor
    · simpa [hd0] using hact
    · intro t h1 h2
      omega
  | succ fuel ih =>
    simp [scanExec]
    by_cases hhere : act k = .exec s
    · simp [hhere]
      intro t h1 h2
      omega
    · simp [hhere]
      obtain ⟨d, hd, hact⟩ := h
      have hnext : ∃ d, d ≤ fuel ∧ act (k + 1 + d) = .exec s := by
        have hd0 : 0 < d := by
          apply Nat.pos_of_ne_zero
          intro hz
          apply hhere
          simpa [hz] using hact
        refine ⟨d - 1, by omega, ?_⟩
        have : k + d = k + 1 + (d - 1) := by omega
        simpa [this] using hact
      have ih' := ih (k + 1) hnext
      constructor
      · exact Nat.le_trans (Nat.le_succ k) ih'.1
      constructor
      · exact ih'.2.1
      · intro t ht1 ht2
        by_cases htk : t = k
        · simpa [htk] using hhere
        · exact ih'.2.2 t (by omega) (by omega)

/-- A live actor cannot stay in `.run` forever. Each of its own steps descends
the effect tree of the current rest, and nothing else replaces that continuation. -/
theorem not_forever_run (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (hF : Fair ρ) (s : InstId) (i : Nat)
    (hl : ∀ j, i ≤ j → ((ρ.cfg j).st s).life = .alive)
    (hr : ∀ j, i ≤ j → ∃ k, ((ρ.cfg j).st s).phase = .run k) : False := by
  suffices ∀ n i, (∃ k, ((ρ.cfg i).st s).phase = .run k ∧ listSize k.rest = n) →
      (∀ j, i ≤ j → ((ρ.cfg j).st s).life = .alive) →
      (∀ j, i ≤ j → ∃ k, ((ρ.cfg j).st s).phase = .run k) → False by
    obtain ⟨k, hk⟩ := hr i (Nat.le_refl _)
    exact this (listSize k.rest) i ⟨k, hk, rfl⟩ hl hr
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro i hk hl hr
    obtain ⟨k, hp, hlen⟩ := hk
    have hen : ∀ j, i ≤ j → Enabled I (ρ.cfg j) (.exec s) := by
      intro j hj
      obtain ⟨k', hk'⟩ := hr j hj
      exact run_enabled I (ρ.cfg j) s k' hk' (hl j hj) (run_not_crashed ρ j)
    obtain ⟨j0, hj0, hact0⟩ := hF.weak (.exec s) i rfl hen
    have hscan := scanExec_spec ρ.act s (j0 - i) i ⟨j0 - i, Nat.le_refl _, by
      simpa [Nat.add_sub_of_le hj0] using hact0⟩
    let m := scanExec ρ.act s (j0 - i) i
    have him : i ≤ m := hscan.1
    have hact : ρ.act m = .exec s := hscan.2.1
    have hmin := hscan.2.2
    have hpre := run_prefix hL hG ρ s i (m - i) k hp
      (fun t h1 _ => hl t h1)
      (fun t h1 h2 => hmin t h1 (by
        have hsum : i + (m - i) = m := Nat.add_sub_of_le him
        omega))
    obtain ⟨k0, hhere, hrest0, _⟩ := runKept_view k _ (by
      simpa [Nat.add_sub_of_le him] using hpre)
    obtain ⟨k', hk'⟩ := hr (m + 1) (Nat.le_trans him (Nat.le_succ _))
    have hrun : execRun I (ρ.cfg m) s ((ρ.cfg m).st s) k0 = ρ.cfg (m + 1) := by
      have hstep := (apply_step I (ρ.act m) (ρ.cfg m) (ρ.cfg (m + 1)) (ρ.valid m)).2
      simp [stepWorld, hact, execHead, hl m him, hhere] at hstep
      exact hstep
    have hshort := exec_shortens I hL hG N (ρ.cfg m) (cfg_reachable ρ m) s k0 k' hhere (hl m him)
      (run_not_crashed ρ m) (by rw [hrun]; exact hk')
    have hlt : listSize k'.rest < n := by simpa [hlen, hrest0] using hshort
    exact ih (listSize k'.rest) hlt (m + 1) ⟨k', hk', rfl⟩
      (fun j hj => hl j (Nat.le_trans (Nat.le_trans him (Nat.le_succ _)) hj))
      (fun j hj => hr j (Nat.le_trans (Nat.le_trans him (Nat.le_succ _)) hj))

/-- `resumeSender` rewrites a parked phase only. Any other phase is left as it stands. -/
theorem resume_id_of_not_parked (a : Actor) (b : Bool) (dst : InstId)
    (hn : ∀ d c k, a.phase ≠ .parked d c k) : resumeSender a b dst = a := by
  cases h : a.phase with
  | parked d c k => exact absurd h (hn d c k)
  | idle => simp [resumeSender, h]
  | run k => simp [resumeSender, h]
  | awaitReply d k => simp [resumeSender, h]
  | awaitEffect k => simp [resumeSender, h]
  | awaitPeer k => simp [resumeSender, h]
  | crashed => simp [resumeSender, h]

theorem release_keeps_nonparked (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (hn : ∀ d c k, (w.st s).phase ≠ .parked d c k) :
    ((releaseParked w id ps).st s).phase = (w.st s).phase ∧
      ((releaseParked w id ps).st s).life = (w.st s).life := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w hn
    · rw [if_neg hskip]
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      have hpl : (w'.st s).phase = (w.st s).phase ∧ (w'.st s).life = (w.st s).life := by
        by_cases hs : s = p.sender
        · have hid := resume_id_of_not_parked (w.st p.sender) false id (by
            intro d c k hbad
            exact hn d c k (by simpa [hs] using hbad))
          simp [w', hs, hid, setActor]
        · simp [w', setActor, hs]
      have hn' : ∀ d c k, (w'.st s).phase ≠ .parked d c k := by
        intro d c k hbad
        exact hn d c k (hpl.1 ▸ hbad)
      have ih' := ih w' hn'
      exact ⟨ih'.1.trans hpl.1, ih'.2.trans hpl.2⟩

theorem failWaiter_quiet (w : World) (dead i s : InstId)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck)
    (hnreply : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck) :
    ((failWaiter w dead i).st s).phase = (w.st s).phase ∧
      ((failWaiter w dead i).st s).life = (w.st s).life := by
  by_cases hs : s = i
  · rw [hs] at hnpark hnreply ⊢
    unfold failWaiter
    split
    · exact ⟨rfl, rfl⟩
    · cases hph : (w.st i).phase with
      | parked d b k => exact absurd hph (hnpark d b k)
      | awaitReply d k => exact absurd hph (hnreply d k)
      | idle => simp [hph]
      | run _ => simp [hph]
      | awaitEffect _ => simp [hph]
      | awaitPeer _ => simp [hph]
      | crashed => simp [hph]
  · rw [failWaiter_other w dead i s hs]
    exact ⟨rfl, rfl⟩

theorem failFold_quiet (w : World) (dead s : InstId) (ids : List InstId)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck)
    (hnreply : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase = (w.st s).phase ∧
      ((ids.foldl (fun w i => failWaiter w dead i) w).st s).life = (w.st s).life := by
  induction ids generalizing w with
  | nil => exact ⟨by simp, by simp⟩
  | cons i ids ih =>
    simp only [List.foldl_cons]
    have hstep := failWaiter_quiet w dead i s hnpark hnreply
    have hnpark' : ∀ d c ck, ((failWaiter w dead i).st s).phase ≠ .parked d c ck := by
      intro d c ck hbad
      exact hnpark d c ck (hstep.1 ▸ hbad)
    have hnreply' : ∀ d ck, ((failWaiter w dead i).st s).phase ≠ .awaitReply d ck := by
      intro d ck hbad
      exact hnreply d ck (hstep.1 ▸ hbad)
    have hih := ih (failWaiter w dead i) hnpark' hnreply'
    exact ⟨hih.1.trans hstep.1, hih.2.trans hstep.2⟩

/-- Releasing an actor refunds its mailbox and resumes senders parked on it.
A different actor that is not parked keeps its phase and its life. `awaitReply`
is not a parked phase, so a reply wait is left in place. -/
theorem release_keeps_quiet (D : Description) (w : World) (id : InstId) (a : Actor) (s : InstId)
    (hs : s ≠ id) (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck) :
    ((releaseWorld D w id a).st s).phase = (w.st s).phase ∧
      ((releaseWorld D w id a).st s).life = (w.st s).life := by
  let wR := readCells D w id
  let wM := refundMsgs wR (tname id) a.box
  let wP := refundParked wM (tname id) a.parked
  let wO := releaseOutbound wP id
  let dead : Actor :=
    { wO.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  let wS := setActor wO id dead
  have hworld : releaseWorld D w id a = releaseParked wS id a.parked := by
    simp [releaseWorld, wR, wM, wP, wO, dead, wS]
  have hph : (wS.st s).phase = (w.st s).phase := by
    have hset : (wS.st s).phase = (wO.st s).phase := by simp [wS, setActor, hs]
    have hout : (wO.st s).phase = (wP.st s).phase := releaseOutbound_phase wP id s
    have hp : (wP.st s).phase = (wM.st s).phase := phase_refundP wM (tname id) a.parked s
    have hm : (wM.st s).phase = (wR.st s).phase := phase_refund wR (tname id) a.box s
    have hr : (wR.st s).phase = (w.st s).phase := by simp [wR, readCells_st]
    exact hset.trans (hout.trans (hp.trans (hm.trans hr)))
  have hli : (wS.st s).life = (w.st s).life := by
    have hset : (wS.st s).life = (wO.st s).life := by simp [wS, setActor, hs]
    have hout : (wO.st s).life = (wP.st s).life := releaseOutbound_life wP id s
    have hp : (wP.st s).life = (wM.st s).life := (refundP_life wM (tname id) a.parked s).1
    have hm : (wM.st s).life = (wR.st s).life := (refund_life wR (tname id) a.box s).1
    have hr : (wR.st s).life = (w.st s).life := by
      have hst := readCells_st D w id s
      simp [wR, hst]
    exact hset.trans (hout.trans (hp.trans (hm.trans hr)))
  have hn : ∀ d c ck, (wS.st s).phase ≠ .parked d c ck := by
    intro d c ck hbad
    exact hnpark d c ck (hph ▸ hbad)
  have hrel := release_keeps_nonparked wS id a.parked s hn
  rw [hworld]
  exact ⟨hrel.1.trans hph, hrel.2.trans hli⟩

/-- What `sealBranch` does to one actor. The seal is `releaseWorld`: the
subject goes dead and idle, and a bystander keeps its phase and life. A
branch seal does not queue a tombstone, so it does not crash the roster.
(DECISIONS.md 2026-11-21, "A termination seals the stage in that step":
descendants are sealed and their tombstones are discarded.) -/
abbrev SealQuiet (w w' : World) (s : InstId) : Prop :=
  ((w'.st s).phase = (w.st s).phase ∧ (w'.st s).life = (w.st s).life) ∨
    ((w.st s).life = .alive ∧ (w'.st s).life = .dead ∧ (w'.st s).phase = .idle)

/-- What a shutdown or a crash does. The third disjunct is a tombstone that
does not fit, or a core `terminate`: `crashWorld` kills every alive roster
actor. The subject of a seal is not that disjunct: `releaseWorld` installs
it dead and idle before the tombstone is queued, and `crashActor` does not
rewrite an actor that is already dead.
(DECISIONS.md 2026-11-21, "A core terminate crashes the node".) -/
abbrev QuietAfter (w w' : World) (s : InstId) : Prop :=
  ((w'.st s).phase = (w.st s).phase ∧ (w'.st s).life = (w.st s).life) ∨
    ((w.st s).life = .alive ∧ (w'.st s).life = .dead ∧ (w'.st s).phase = .idle) ∨
    ((w.st s).life = .alive ∧ (w'.st s).life = .dead ∧ (w'.st s).phase = .crashed)

theorem quiet_trans (w a b : World) (s : InstId) (h1 : QuietAfter w a s) (h2 : QuietAfter a b s) :
    QuietAfter w b s := by
  rcases h1 with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
  · rcases h2 with hkeep2 | ⟨hold2, hdead2, hidle2⟩ | ⟨hold2, hdead2, hcrash2⟩
    · exact Or.inl ⟨hkeep2.1.trans hkeep.1, hkeep2.2.trans hkeep.2⟩
    · exact Or.inr (Or.inl ⟨hkeep.2.symm.trans hold2, hdead2, hidle2⟩)
    · exact Or.inr (Or.inr ⟨hkeep.2.symm.trans hold2, hdead2, hcrash2⟩)
  · rcases h2 with hkeep2 | ⟨hold2, _, _⟩ | ⟨hold2, _, _⟩
    · exact Or.inr (Or.inl ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hidle⟩)
    · rw [hdead] at hold2
      cases hold2
    · rw [hdead] at hold2
      cases hold2
  · rcases h2 with hkeep2 | ⟨hold2, _, _⟩ | ⟨hold2, _, _⟩
    · exact Or.inr (Or.inr ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hcrash⟩)
    · rw [hdead] at hold2
      cases hold2
    · rw [hdead] at hold2
      cases hold2

theorem seal_trans (w a b : World) (s : InstId) (h1 : SealQuiet w a s) (h2 : SealQuiet a b s) :
    SealQuiet w b s := by
  rcases h1 with hkeep | ⟨hold, hdead, hidle⟩
  · rcases h2 with hkeep2 | ⟨hold2, hdead2, hidle2⟩
    · exact Or.inl ⟨hkeep2.1.trans hkeep.1, hkeep2.2.trans hkeep.2⟩
    · exact Or.inr ⟨hkeep.2.symm.trans hold2, hdead2, hidle2⟩
  · rcases h2 with hkeep2 | ⟨hold2, _, _⟩
    · exact Or.inr ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hidle⟩
    · rw [hdead] at hold2
      cases hold2

theorem seal_then_quiet (w a b : World) (s : InstId) (h1 : SealQuiet w a s) (h2 : QuietAfter a b s) :
    QuietAfter w b s := by
  rcases h1 with hkeep | ⟨hold, hdead, hidle⟩
  · rcases h2 with hkeep2 | ⟨hold2, hdead2, hidle2⟩ | ⟨hold2, hdead2, hcrash2⟩
    · exact Or.inl ⟨hkeep2.1.trans hkeep.1, hkeep2.2.trans hkeep.2⟩
    · exact Or.inr (Or.inl ⟨hkeep.2.symm.trans hold2, hdead2, hidle2⟩)
    · exact Or.inr (Or.inr ⟨hkeep.2.symm.trans hold2, hdead2, hcrash2⟩)
  · rcases h2 with hkeep2 | ⟨hold2, _, _⟩ | ⟨hold2, _, _⟩
    · exact Or.inr (Or.inl ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hidle⟩)
    · rw [hdead] at hold2
      cases hold2
    · rw [hdead] at hold2
      cases hold2

theorem crash_quiet (w : World) (s : InstId) : QuietAfter w (crashWorld w) s := by
  by_cases hmem : s ∈ w.roster
  · by_cases hl : (w.st s).life = .alive
    · exact Or.inr (Or.inr ⟨hl, (crash_roster_crashed w s hmem hl).2,
        (crash_roster_crashed w s hmem hl).1⟩)
    · have hfalse : ((w.st s).life = .alive) = False := eq_false hl
      suffices ((crashWorld w).st s).phase = (w.st s).phase ∧
          ((crashWorld w).st s).life = (w.st s).life by
        exact Or.inl this
      simp [crashWorld, crashActor, hmem, hfalse, ite_false]
  · suffices ((crashWorld w).st s).phase = (w.st s).phase ∧
        ((crashWorld w).st s).life = (w.st s).life by
      exact Or.inl this
    simp [crashWorld, hmem]

theorem tombstone_quiet (D : Description) (w : World) (child s : InstId) :
    QuietAfter w (enqueueTombstone D w child) s := by
  unfold enqueueTombstone
  cases hpar : (w.st child).parent with
  | none =>
    simp [hpar]
    exact Or.inl ⟨rfl, rfl⟩
  | some parent =>
    simp only [hpar]
    by_cases hlive : ((w.st parent).life != .alive) = true
    · simp only [hlive, ite_true]
      exact Or.inl ⟨rfl, rfl⟩
    · have hliveF : ((w.st parent).life != .alive) = false := by
        simpa [Bool.not_eq_true] using hlive
      simp only [hliveF, ite_false]
      by_cases hlab : ((tombstoneMsg D (w.st parent) child).label == "") = true
      · simp only [hlab, ite_true]
        exact crash_quiet w s
      · have hlabF : ((tombstoneMsg D (w.st parent) child).label == "") = false := by
          simpa [Bool.not_eq_true] using hlab
        simp only [hlabF, ite_false]
        by_cases hfull : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = true
        · simp only [hfull, ite_true, offerPrio]
          exact crash_quiet w s
        · have hroom : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp only [hroom, ite_false, offerPrio]
          by_cases hs : s = parent
          · rw [hs]
            have htrue : (parent = parent) = True := eq_true rfl
            exact Or.inl ⟨by simp [setActor, htrue, ite_true], by simp [setActor, htrue, ite_true]⟩
          · have hfalse : (s = parent) = False := eq_false hs
            exact Or.inl ⟨by simp [setActor, hfalse, ite_false], by simp [setActor, hfalse, ite_false]⟩

/-- A branch seal leaves a non-parked actor unchanged, or dead and idle.
`sealBranch` releases the actor; it does not queue a tombstone, so a bystander
does not crash here. -/
theorem seal_branch_quiet (fuel : Nat) (D : Description) (s : InstId) :
    ∀ (root : InstId) (w : World),
      (∀ d c ck, (w.st s).phase ≠ .parked d c ck) →
      SealQuiet w (sealBranch fuel D w root) s := by
  induction fuel with
  | zero =>
    intro _ _ _
    simp only [sealBranch]
    exact Or.inl ⟨rfl, rfl⟩
  | succ fuel ih =>
    intro root w hnpark
    simp only [sealBranch]
    let step (w0 : World) (child : InstId) : World :=
      if isChild w0 root child then sealBranch fuel D w0 child else w0
    have hfold : ∀ (ids : List InstId) (w0 : World),
        (∀ d c ck, (w0.st s).phase ≠ .parked d c ck) →
        SealQuiet w0 (ids.foldl step w0) s := by
      intro ids
      induction ids with
      | nil =>
        intro _ _
        simp [List.foldl_nil]
        exact Or.inl ⟨rfl, rfl⟩
      | cons c ids ihf =>
        intro w0 hn
        simp only [List.foldl_cons, step]
        by_cases hch : isChild w0 root c = true
        · simp only [hch, ite_true]
          rcases ih c w0 hn with hkeep | ⟨hold, hdead, hidle⟩
          · have hn' : ∀ d b ck, ((sealBranch fuel D w0 c).st s).phase ≠ .parked d b ck := by
              intro d b ck hbad
              exact hn d b ck (hkeep.1 ▸ hbad)
            rcases ihf (sealBranch fuel D w0 c) hn' with hkeep2 | ⟨hold2, hdead2, hidle2⟩
            · exact Or.inl ⟨hkeep2.1.trans hkeep.1, hkeep2.2.trans hkeep.2⟩
            · exact Or.inr ⟨hkeep.2.symm.trans hold2, hdead2, hidle2⟩
          · have hn' : ∀ d b ck, ((sealBranch fuel D w0 c).st s).phase ≠ .parked d b ck := by
              intro d b ck hbad
              rw [hidle] at hbad
              cases hbad
            rcases ihf (sealBranch fuel D w0 c) hn' with hkeep2 | ⟨hold2, _, _⟩
            · exact Or.inr ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hidle⟩
            · rw [hdead] at hold2
              cases hold2
        · have hf : isChild w0 root c = false := by
            cases hb : isChild w0 root c with
            | false => rfl
            | true => exact absurd hb hch
          simp only [hf, ite_false]
          exact ihf w0 hn
    have hF := hfold w.roster w hnpark
    let sealed := w.roster.foldl step w
    split
    · next hgo =>
      rcases hF with hkeep | ⟨hold, hdead, hidle⟩
      · by_cases hs : s = root
        · rw [hs]
          have halive : ((sealed.st root).life = .alive) := by simpa [beq_iff_eq] using hgo
          have hold : (w.st root).life = .alive := by
            have heq : ((sealed.st root).life = (w.st root).life) := by simpa [hs] using hkeep.2
            exact heq.symm.trans halive
          have hrel := releaseWorld_self_idle D sealed root (sealed.st root)
          exact Or.inr ⟨hold, hrel.1, hrel.2⟩
        · have hn' : ∀ d c ck, (sealed.st s).phase ≠ .parked d c ck := by
            intro d c ck hbad
            exact hnpark d c ck (hkeep.1 ▸ hbad)
          have hq := release_keeps_quiet D sealed root (sealed.st root) s hs hn'
          exact Or.inl ⟨hq.1.trans hkeep.1, hq.2.trans hkeep.2⟩
      · by_cases hs : s = root
        · have halive : ((sealed.st root).life = .alive) := by simpa [beq_iff_eq] using hgo
          rw [hs] at hdead
          rw [hdead] at halive
          cases halive
        · have hn' : ∀ d c ck, (sealed.st s).phase ≠ .parked d c ck := by
            intro d c ck hbad
            rw [hidle] at hbad
            cases hbad
          have hq := release_keeps_quiet D sealed root (sealed.st root) s hs hn'
          exact Or.inr ⟨hold, hq.2.trans hdead, hq.1.trans hidle⟩
    · next _ =>
      exact hF

theorem drop_quiet (D : Description) (s root : InstId) (w : World)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck) :
    SealQuiet w (dropDescendants D w root) s := by
  unfold dropDescendants
  let step (w0 : World) (child : InstId) : World :=
    if isChild w0 root child then sealBranch w.roster.length D w0 child else w0
  have hfold : ∀ (ids : List InstId) (w0 : World),
      (∀ d c ck, (w0.st s).phase ≠ .parked d c ck) →
      SealQuiet w0 (ids.foldl step w0) s := by
    intro ids
    induction ids with
    | nil =>
      intro _ _
      simp [List.foldl_nil]
      exact Or.inl ⟨rfl, rfl⟩
    | cons c ids ihf =>
      intro w0 hn
      simp only [List.foldl_cons, step]
      by_cases hch : isChild w0 root c = true
      · simp only [hch, ite_true]
        rcases seal_branch_quiet w.roster.length D s c w0 hn with hkeep | ⟨hold, hdead, hidle⟩
        · have hn' : ∀ d b ck, ((sealBranch w.roster.length D w0 c).st s).phase ≠ .parked d b ck := by
            intro d b ck hbad
            exact hn d b ck (hkeep.1 ▸ hbad)
          exact seal_trans w0 _ _ s (Or.inl hkeep) (ihf _ hn')
        · have hn' : ∀ d b ck, ((sealBranch w.roster.length D w0 c).st s).phase ≠ .parked d b ck := by
            intro d b ck hbad
            rw [hidle] at hbad
            cases hbad
          rcases ihf (sealBranch w.roster.length D w0 c) hn' with hkeep2 | ⟨hold2, _, _⟩
          · exact Or.inr ⟨hold, hkeep2.2.trans hdead, hkeep2.1.trans hidle⟩
          · rw [hdead] at hold2
            cases hold2
      · have hf : isChild w0 root c = false := by
          cases hb : isChild w0 root c with
          | false => rfl
          | true => exact absurd hb hch
        simp only [hf, ite_false]
        exact ihf w0 hn
  simpa [step] using hfold w.roster w hnpark

theorem shutdown_quiet (D : Description) (s id : InstId) (w : World)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck) :
    QuietAfter w (shutdownActor D w id) s := by
  unfold shutdownActor
  by_cases hlive : ((w.st id).life == .alive) = true
  · simp only [hlive, ite_true, sealActor]
    by_cases hs : s = id
    · rw [hs]
      have hold : (w.st id).life = .alive := by simpa [beq_iff_eq] using hlive
      have hrel := releaseWorld_self_idle D w id (w.st id)
      have htom := enqueueTombstone_keeps_idle D (releaseWorld D w id (w.st id)) id id hrel.1 hrel.2
      exact Or.inr (Or.inl ⟨hold, htom.1, htom.2⟩)
    · have hq := release_keeps_quiet D w id (w.st id) s hs hnpark
      exact seal_then_quiet w _ _ s (Or.inl hq)
        (tombstone_quiet D (releaseWorld D w id (w.st id)) id s)
  · have hno : ((w.st id).life == .alive) = false := by simpa [Bool.not_eq_true] using hlive
    simp only [hno, ite_false]
    exact Or.inl ⟨rfl, rfl⟩

/-- `terminateStage` seals descendants without their tombstones, then shuts the
stage down. A non-parked bystander stays, becomes dead and idle, or is killed
into `.crashed` when the stage's tombstone does not fit. The descendant seal
itself does not crash anyone. -/
theorem terminate_keeps_quiet (D : Description) (w : World) (id s : InstId) (_hs : s ≠ id)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck)
    (_hnreply : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck) :
    QuietAfter w (terminateStage D w id (w.st id)) s := by
  simp only [terminateStage]
  have hdrop := drop_quiet D s id w hnpark
  have hn1 : ∀ d c ck, ((dropDescendants D w id).st s).phase ≠ .parked d c ck := by
    intro d c ck hbad
    rcases hdrop with hkeep | ⟨_, _, hidle⟩
    · exact hnpark d c ck (hkeep.1 ▸ hbad)
    · rw [hidle] at hbad
      cases hbad
  exact seal_then_quiet w _ _ s hdrop (shutdown_quiet D s id (dropDescendants D w id) hn1)

theorem abort_children_quiet (D : Description) (s parent : InstId) (w : World)
    (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck) :
    QuietAfter w (abortChildren D w parent) s := by
  unfold abortChildren
  suffices ∀ (ids : List InstId) (w0 : World),
      (∀ d c ck, (w0.st s).phase ≠ .parked d c ck) →
      QuietAfter w0 (ids.foldl (fun acc child =>
        if isChild acc parent child && (acc.st child).life == .alive then
          shutdownActor D (dropDescendants D acc child) child else acc) w0) s from
    this w.roster w hnpark
  intro ids
  induction ids with
  | nil =>
    intro _ _
    simp [List.foldl_nil]
    exact Or.inl ⟨rfl, rfl⟩
  | cons c ids ih =>
    intro w0 hn
    simp only [List.foldl_cons]
    by_cases hgo : (isChild w0 parent c && (w0.st c).life == .alive) = true
    · simp only [hgo, ite_true]
      have hdrop := drop_quiet D s c w0 hn
      have hn1 : ∀ d b ck, ((dropDescendants D w0 c).st s).phase ≠ .parked d b ck := by
        intro d b ck hbad
        rcases hdrop with hkeep | ⟨_, _, hidle⟩
        · exact hn d b ck (hkeep.1 ▸ hbad)
        · rw [hidle] at hbad
          cases hbad
      have hstep := seal_then_quiet w0 _ _ s hdrop
        (shutdown_quiet D s c (dropDescendants D w0 c) hn1)
      have hn2 : ∀ d b ck, ((shutdownActor D (dropDescendants D w0 c) c).st s).phase ≠ .parked d b ck := by
        intro d b ck hbad
        rcases hstep with hkeep | ⟨_, _, hidle⟩ | ⟨_, _, hcrash⟩
        · exact hn d b ck (hkeep.1 ▸ hbad)
        · rw [hidle] at hbad
          cases hbad
        · rw [hcrash] at hbad
          cases hbad
      exact quiet_trans w0 _ _ s hstep (ih _ hn2)
    · have hf : (isChild w0 parent c && (w0.st c).life == .alive) = false := by
        cases hb : isChild w0 parent c && (w0.st c).life == .alive with
        | false => rfl
        | true => exact absurd hb hgo
      simp only [hf, ite_false]
      exact ih w0 hn
/-- A reply rewrites the caller only out of `awaitReply`, and the sender is `sender`. -/
theorem reply_keeps_quiet (w : World) (sender s : InstId) (k : Cont)
    (hp : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck) (hs : s ≠ sender) :
    ((performReply w sender k).st s).phase = (w.st s).phase ∧
      ((performReply w sender k).st s).life = (w.st s).life := by
  unfold performReply
  cases hr : k.replyTo with
  | none =>
    refine ⟨?_, ?_⟩ <;> simp [hr, setActor_other, hs, proceed_life]
  | some caller =>
    by_cases hc : caller = s
    · rw [hc]
      cases hph : (w.st s).phase with
      | awaitReply dst ck => exact absurd hph (hp dst ck)
      | idle => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | run _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | awaitEffect _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | awaitPeer _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | parked _ _ _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | crashed => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
    · cases hph : (w.st caller).phase with
      | awaitReply dst ck =>
        by_cases hd : dst = sender
        · by_cases ho : (w.st sender).oweId = some (w.st caller).waitId
          · have hsc : s ≠ caller := Ne.symm hc
            refine ⟨?_, ?_⟩ <;> simp [hph, hd, ho, setActor, hs, hsc]
          · refine ⟨?_, ?_⟩ <;> simp [hph, hd, ho, setActor, hs]
        · refine ⟨?_, ?_⟩ <;> simp [hph, hd, setActor, hs]
      | idle => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | run _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | awaitEffect _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | awaitPeer _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | parked _ _ _ => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]
      | crashed => refine ⟨?_, ?_⟩ <;> simp [hph, setActor_other, hs, proceed_life]

/-- A cell wake keeps phase and life, or crashes an alive actor.
`offerPrio` crashes the roster when the lane is full. A dead or absent actor
is not rewritten. (DECISIONS.md 2026-11-22, "A full self-schedule crashes the
world": a cell wake that does not fit crashes the same way.) -/
theorem try_wake_effect (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) :
    (((tryWake D w dstId label writer).st i).life = (w.st i).life ∧
        ((tryWake D w dstId label writer).st i).phase = (w.st i).phase) ∨
      ((w.st i).life = .alive ∧ ((tryWake D w dstId label writer).st i).life = .dead ∧
        ((tryWake D w dstId label writer).st i).phase = .crashed) := by
  unfold tryWake
  by_cases hskip : ((w.st dstId).life != .alive ||
      (w.st dstId).prio.any (fun p => p.label == label)) = true
  · exact Or.inl ⟨by simp [tryWake, hskip], by simp [tryWake, hskip]⟩
  · have hgo : ((w.st dstId).life != .alive ||
        (w.st dstId).prio.any (fun p => p.label == label)) = false := by
      cases hb : (w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label) with
      | false => rfl
      | true => exact absurd hb hskip
    simp only [tryWake, hgo, ite_false]
    unfold offerPrio
    by_cases hfull : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = true
    · simp only [hfull, ite_true]
      rcases crash_quiet w i with ⟨hp, hl⟩ | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
      · exact Or.inl ⟨hl, hp⟩
      · by_cases hmem : i ∈ w.roster
        · have hc := (crash_roster_crashed w i hmem hold).1
          rw [hidle] at hc
          cases hc
        · have hs : ((crashWorld w).st i).life = (w.st i).life := by simp [crashWorld, hmem]
          rw [hs, hold] at hdead
          cases hdead
      · exact Or.inr ⟨hold, hdead, hcrash⟩
    · have hroom : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = false := by
        cases hb : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) with
        | false => rfl
        | true => exact absurd hb hfull
      simp only [hroom, ite_false]
      by_cases hi : i = dstId
      · have htrue : (i = dstId) = True := eq_true hi
        exact Or.inl ⟨by simp [setActor, htrue, ite_true, hi], by simp [setActor, htrue, ite_true, hi]⟩
      · have hfalse : (i = dstId) = False := eq_false hi
        exact Or.inl ⟨by simp [setActor, hfalse, ite_false], by simp [setActor, hfalse, ite_false]⟩

theorem try_wake_keeps_dead (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) (hdead : (w.st i).life ≠ .alive) :
    ((tryWake D w dstId label writer).st i).life = (w.st i).life := by
  rcases try_wake_effect D w dstId label writer i with ⟨hl, _⟩ | ⟨hold, _, _⟩
  · exact hl
  · exact absurd hold hdead

theorem wakes_life (ids : List InstId) (D : Description) (w : World) (dst label : String)
    (writer i : InstId) :
    (((ids.foldl (fun w id => tryWake D w id label writer) w).st i).life = (w.st i).life ∧
        ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).phase =
          (w.st i).phase) ∨
      ((w.st i).life = .alive ∧
        ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).life = .dead ∧
        ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).phase = .crashed) := by
  induction ids generalizing w with
  | nil =>
    simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    rcases try_wake_effect D w j label writer i with ⟨hl, hp⟩ | ⟨hold, hdead, hcrash⟩
    · rcases ih (tryWake D w j label writer) with ⟨hl2, hp2⟩ | ⟨hold2, hdead2, hcrash2⟩
      · exact Or.inl ⟨hl2.trans hl, hp2.trans hp⟩
      · exact Or.inr ⟨hl.symm.trans hold2, hdead2, hcrash2⟩
    · rcases ih (tryWake D w j label writer) with ⟨hl2, hp2⟩ | ⟨hold2, _, _⟩
      · exact Or.inr ⟨hold, hl2.trans hdead, hp2.trans hcrash⟩
      · rw [hdead] at hold2
        cases hold2

theorem try_wake_ty (D : Description) (w : World) (dstId : InstId) (label : String) (writer i : InstId) :
    ((tryWake D w dstId label writer).st i).typestate = (w.st i).typestate := by
  unfold tryWake
  by_cases hskip : ((w.st dstId).life != .alive ||
      (w.st dstId).prio.any (fun p => p.label == label)) = true
  · simp [tryWake, hskip]
  · have hgo : ((w.st dstId).life != .alive ||
        (w.st dstId).prio.any (fun p => p.label == label)) = false := by
      cases hb : (w.st dstId).life != .alive || (w.st dstId).prio.any (fun p => p.label == label) with
      | false => rfl
      | true => exact absurd hb hskip
    simp only [tryWake, hgo, ite_false]
    unfold offerPrio
    by_cases hfull : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = true
    · simp only [hfull, ite_true]
      by_cases hmem : i ∈ w.roster
      · by_cases hl : (w.st i).life = .alive
        · simp [crashWorld, crashActor, hmem, hl]
        · have hfalse : ((w.st i).life = .alive) = False := eq_false hl
          simp [crashWorld, crashActor, hmem, hfalse, ite_false]
      · simp [crashWorld, hmem]
    · have hroom : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) = false := by
        cases hb : decide (prioLoad (w.st dstId).prio >= capPrio D w.N dstId) with
        | false => rfl
        | true => exact absurd hb hfull
      simp only [hroom, ite_false]
      by_cases hi : i = dstId
      · have htrue : (i = dstId) = True := eq_true hi
        simp [setActor, htrue, ite_true, hi]
      · have hfalse : (i = dstId) = False := eq_false hi
        simp [setActor, hfalse, ite_false]

theorem wakes_ty (ids : List InstId) (D : Description) (w : World) (dst label : String)
    (writer i : InstId) :
    ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).typestate = (w.st i).typestate := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    rw [ih, try_wake_ty]

/-- An `exec` of `id` does not rewrite `s` when `s` is neither parked nor awaiting `id`'s reply. -/
theorem exec_keeps_quiet (I : Impl) (w : World) (id : InstId) (a : Actor) (k : Cont) (s : InstId)
    (hs : s ≠ id) (hnpark : ∀ d c ck, (w.st s).phase ≠ .parked d c ck)
    (hnreply : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck) :
    (((execRun I w id a k).st s).phase = (w.st s).phase ∧
        ((execRun I w id a k).st s).life = (w.st s).life) ∨
      ((w.st s).life = .alive ∧ ((execRun I w id a k).st s).life = .dead ∧
        ((execRun I w id a k).st s).phase = .idle) ∨
      ((w.st s).life = .alive ∧ ((execRun I w id a k).st s).life = .dead ∧
        ((execRun I w id a k).st s).phase = .crashed) ∨
      (((execRun I w id a k).st s).phase = .idle ∧ ((execRun I w id a k).st s).life = .alive ∧
        s ∈ (execRun I w id a k).roster ∧ s ∉ w.roster) := by
  by_cases hliveA : a.life = .alive
  · have hgoA : (a.life == .alive) = true := by simpa [beq_iff_eq] using hliveA
    cases hk : k.rest with
    | nil =>
      refine Or.inl ⟨?_, ?_⟩ <;> simp [execRun, hgoA, hk, setActor_other, hs]
    | cons eff rest =>
      cases eff with
      | send dst label hint =>
        simp only [execRun, hgoA, ite_true, hk]
        cases hr : route w I.desc id dst with
        | none => refine Or.inl ⟨?_, ?_⟩ <;> simp [hr, setActor_other, hs, proceed_life]
        | some dstId =>
          simp only [hr]
          refine Or.inl ⟨enqueue_phase_other w I.desc id dstId _ false _ s hs,
            enqueue_life w I.desc id dstId _ false _ s⟩
      | trySend dst label hint onFull onGone =>
        simp only [execRun, hgoA, ite_true, hk]
        cases hr : route w I.desc id dst with
        | none => refine Or.inl ⟨?_, ?_⟩ <;> simp [hr, setActor_other, hs, proceed_life]
        | some dstId =>
          simp only [hr]
          split
          · refine Or.inl ⟨enqueue_phase_other w I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false _ s hs,
              enqueue_life w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false _ s⟩
          · split
            · refine Or.inl ⟨?_, ?_⟩ <;> simp [setActor_other, hs, proceed_life]
            · refine Or.inl ⟨?_, ?_⟩ <;> simp [setActor_other, hs, proceed_life]
      | call dst label hint na to =>
        simp only [execRun, hgoA, ite_true, hk]
        cases hr : resolveId I.desc w id dst with
        | none => refine Or.inl ⟨?_, ?_⟩ <;> simp [hr, setActor_other, hs]
        | some dstId =>
          simp only [hr]
          refine Or.inl ⟨enqueue_phase_other w I.desc id dstId _ true _ s hs,
            enqueue_life w I.desc id dstId _ true _ s⟩
      | reply =>
        exact Or.inl (by simpa [execRun, hgoA, hk] using reply_keeps_quiet w id s k hnreply hs)
      | selfSchedule label =>
        simp only [execRun, hgoA, ite_true, hk]
        split
        · refine Or.inl ⟨?_, ?_⟩ <;> simp [setActor_other, hs, proceed_life]
        · split
          · refine Or.inl ⟨?_, ?_⟩ <;> simp [setActor_other, hs, proceed_life]
          · rcases crash_quiet w s with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
            · exact Or.inl hkeep
            · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
            · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
      | cell dst label value =>
        simp only [execRun, hgoA, ite_true, hk]
        split
        · refine Or.inl ⟨?_, ?_⟩ <;> simp [setCell, setActor_other, hs, proceed_life]
        · rw [wakeReaders]
          rcases wakes_life (readersOf _ dst) I.desc _ dst label id s with
            ⟨hl, hp⟩ | ⟨hold, hdead, hcrash⟩
          · refine Or.inl ⟨?_, ?_⟩
            · rw [hp]
              simp [setCell, setActor_other, hs, proceed_life]
            · rw [hl]
              simp [setCell, setActor_other, hs, proceed_life]
          · refine Or.inr (Or.inr (Or.inl ⟨?_, hdead, hcrash⟩))
            · have hpre :
                  ((setCell (setActor w id (proceed (w.st id) (afterHead k))) dst label
                      { value := max (w.cell dst label).value value, dirty := true }).st s).life =
                    (w.st s).life := by
                simp [setCell, setActor, hs, proceed_life]
              exact hpre.symm.trans hold
      | internal => refine Or.inl ⟨?_, ?_⟩ <;> simp [execRun, hgoA, hk, setActor_other, hs]
      | peer onTimeout => refine Or.inl ⟨?_, ?_⟩ <;> simp [execRun, hgoA, hk, setActor_other, hs]
      | abort =>
        have hgo : (a.life == .alive) = true := hgoA
        simp only [execRun, hgo, ite_true, hk, commitCont]
        by_cases hcr : (abortChildren I.desc w id).crashed = true
        · simp only [hcr, ite_true]
          rcases abort_children_quiet I.desc s id w hnpark with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
        · have hcf : (abortChildren I.desc w id).crashed = false := by
            simpa [Bool.not_eq_true] using hcr
          have hff : (false = true) = False := by decide
          simp only [hcf, hff, ite_false, setActor, ite_true]
          rcases abort_children_quiet I.desc s id w hnpark with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl ⟨by simpa [setActor, hs] using hkeep.1, by simpa [setActor, hs] using hkeep.2⟩
          · exact Or.inr (Or.inl ⟨hold, by simpa [setActor, hs] using hdead, by simpa [setActor, hs] using hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, by simpa [setActor, hs] using hdead,
              by simpa [setActor, hs] using hcrash⟩))
      | spawn child =>
        have hgo : (a.life == .alive) = true := hgoA
        simp only [execRun, hgo, ite_true, hk]
        cases hsp : spawnChild I w id child with
        | none =>
          simp only [hsp]
          rcases crash_quiet w s with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
        | some w1 =>
          have hq := spawn_child_quiet I w w1 id child s hs hsp
          simp only [hsp, commitCont]
          by_cases hcr : w1.crashed = true
          · simp only [hcr, ite_true]
            rcases hq with hkeep | hborn
            · exact Or.inl hkeep
            · exact Or.inr (Or.inr (Or.inr hborn))
          · have hcf : w1.crashed = false := by simpa [Bool.not_eq_true] using hcr
            have hff : (false = true) = False := by decide
            simp only [hcf, hff, ite_false, setActor, ite_true]
            rcases hq with hkeep | ⟨hidle, halive, hmem, hnot⟩
            · exact Or.inl ⟨by simpa [setActor, hs] using hkeep.1, by simpa [setActor, hs] using hkeep.2⟩
            · refine Or.inr (Or.inr (Or.inr ⟨?_, ?_, ?_, hnot⟩))
              · simpa [setActor, hs] using hidle
              · simpa [setActor, hs] using halive
              · simpa [setActor] using hmem
      | terminate =>
        rcases execRun_terminate I w id a k hliveA ⟨rest, hk⟩ with
          hcrash | ⟨_, _, _, _, _, _, _, hsh⟩ | ⟨_, _, _, _, hstage⟩ | ⟨_, _, _, _, _, _, _, hstage⟩
        · rw [hcrash]
          rcases crash_quiet w s with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash'⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash'⟩))
        · rw [hsh]
          rcases shutdown_quiet I.desc s id w hnpark with hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
        · rw [hstage]
          rcases terminate_keeps_quiet I.desc w id s hs hnpark hnreply with
            hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
        · rw [hstage]
          rcases terminate_keeps_quiet I.desc w id s hs hnpark hnreply with
            hkeep | ⟨hold, hdead, hidle⟩ | ⟨hold, hdead, hcrash⟩
          · exact Or.inl hkeep
          · exact Or.inr (Or.inl ⟨hold, hdead, hidle⟩)
          · exact Or.inr (Or.inr (Or.inl ⟨hold, hdead, hcrash⟩))
  · have hgoA : (a.life == .alive) = false := by simpa [beq_iff_eq] using hliveA
    simp only [execRun, hgoA, ite_false]
    exact Or.inl ⟨rfl, rfl⟩

/-- `creditLive` is `creditSender` of the budget holder, so the holder's phase
and life are what a receive preserves. -/
theorem creditLive_keeps (w : World) (dst : String) (sender i : InstId) :
    ((creditLive w dst sender).st i).life = (w.st i).life ∧
      ((creditLive w dst sender).st i).typestate = (w.st i).typestate ∧
      ((creditLive w dst sender).st i).phase = (w.st i).phase ∧
      ((creditLive w dst sender).st i).prio = (w.st i).prio := by
  simpa [creditLive] using credit_life w dst (budgetHolder w sender) i

/-- A receive does not rewrite `s` when `s` is not the receiver and not parked. -/
theorem bulk_keeps_quiet (I : Impl) (w : World) (id : InstId) (w' : World) (s : InstId)
    (hne : s ≠ id) (hnpark : ∀ d c k, (w.st s).phase ≠ .parked d c k)
    (h : receiveBulk I w id = some w') :
    (w'.st s).phase = (w.st s).phase ∧ (w'.st s).life = (w.st s).life := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ p.msg w1 a1 s hdel
          by_cases hs : s = p.sender
          · have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase ∧
                ((setActor w1 id a1).st s).life = (w.st s).life := by
              refine ⟨?_, ?_⟩ <;> simp [setActor, hne, hst]
            have hcred := creditLive_keeps (setActor w1 id a1) (tname id) p.msg.sender s
            have hph0 : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st s).phase =
                (w.st s).phase := hcred.2.2.1.trans hset.1
            have hid := resume_id_of_not_parked
              ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender) p.isCall id
              (by
                intro d c k hbad
                exact hnpark d c k (hph0.symm.trans (by simpa [hs] using hbad)))
            refine ⟨?_, ?_⟩
            · rw [hid]
              simpa [setActor, hs] using hph0
            · rw [hid]
              simpa [setActor, hs] using hcred.1.trans hset.2
          · have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase ∧
                ((setActor w1 id a1).st s).life = (w.st s).life := by
              refine ⟨?_, ?_⟩ <;> simp [setActor, hne, hst]
            have hcred := creditLive_keeps (setActor w1 id a1) (tname id) p.msg.sender s
            refine ⟨?_, ?_⟩
            · simpa [setActor, hs] using hcred.2.2.1.trans hset.1
            · simpa [setActor, hs] using hcred.1.trans hset.2
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          have hcred := creditLive_keeps (setActor w1 id a1) (tname id) m.sender s
          refine ⟨?_, ?_⟩
          · simpa [setActor, hne, hst] using hcred.2.2.1
          · simpa [setActor, hne, hst] using hcred.1
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          by_cases hs : s = p.sender
          · have hset : ((setActor w1 id admitted).st s).phase = (w.st s).phase ∧
                ((setActor w1 id admitted).st s).life = (w.st s).life := by
              refine ⟨?_, ?_⟩ <;> simp [admitted, setActor, hne, hst]
            have hcred := creditLive_keeps (setActor w1 id admitted) (tname id) m.sender s
            have hph0 : ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s).phase =
                (w.st s).phase := hcred.2.2.1.trans hset.1
            have hid := resume_id_of_not_parked
              ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender) p.isCall id
              (by
                intro d c k hbad
                exact hnpark d c k (hph0.symm.trans (by simpa [hs] using hbad)))
            refine ⟨?_, ?_⟩
            · rw [hid]
              simpa [setActor, hs] using hph0
            · rw [hid]
              simpa [setActor, hs] using hcred.1.trans hset.2
          · have hset : ((setActor w1 id admitted).st s).phase = (w.st s).phase ∧
                ((setActor w1 id admitted).st s).life = (w.st s).life := by
              refine ⟨?_, ?_⟩ <;> simp [admitted, setActor, hne, hst]
            have hcred := creditLive_keeps (setActor w1 id admitted) (tname id) m.sender s
            refine ⟨?_, ?_⟩
            · simpa [setActor, hs] using hcred.2.2.1.trans hset.1
            · simpa [setActor, hs] using hcred.1.trans hset.2

/-- A step other than this actor's own `finish` or `callTimeout` leaves an effect
or peer wait untouched, except that someone else's deadline may clear `replyTo`.
The actor's own peer timeout runs `onTimeout` and leaves the wait.
(DECISIONS.md 2026-11-19, "Every external wait carries a timeout".) -/
theorem step_keeps_quiet (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s : InstId)
    (hnpark : ∀ d c k, (w.st s).phase ≠ .parked d c k)
    (hnreply : ∀ d ck, (w.st s).phase ≠ .awaitReply d ck)
    (hnidle : (w.st s).phase ≠ .idle) (hnrun : ∀ k, (w.st s).phase ≠ .run k)
    (hl : (w.st s).life = .alive) (h : apply I a w = some w') (hnot : a ≠ .finish s)
    (hnotC : a ≠ .callTimeout s) (hl' : (w'.st s).life = .alive) :
    QuietKept (w.st s).phase (w'.st s).phase ∧ (w'.st s).life = (w.st s).life := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by
      simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
    refine ⟨?_, callTimeout_life w w' id s hct⟩
    cases callTimeout_view w w' id hct with
    | await dst k0 hph hw =>
      by_cases hs : s = id
      · exact absurd (hs.symm ▸ hph) (hnreply dst k0)
      · by_cases hd : s = dst
        · have hne : dst ≠ id := by
            intro heq
            exact hs (hd.trans heq)
          rw [hd] at hnidle hnrun hnpark hnreply
          rw [hd, hw]
          simp [setActor, hne, detach_phase_owe]
          cases howe : ((w.st dst).oweId == some (w.st id).waitId) with
          | false =>
            have hneq : (w.st dst).oweId ≠ some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            exact Or.inl (by simp [hneq])
          | true =>
            have heq : (w.st dst).oweId = some (w.st id).waitId := by
              simpa [beq_iff_eq] using howe
            simp [heq]
            cases hphase : (w.st dst).phase with
            | idle => exact absurd hphase hnidle
            | run k => exact absurd hphase (hnrun k)
            | parked d c k => exact absurd hphase (hnpark d c k)
            | awaitReply d k => exact absurd hphase (hnreply d k)
            | crashed => exact Or.inl (by simp [clearReplyPhase, hphase])
            | awaitEffect k =>
              simp [clearReplyPhase, hphase]
              cases hto : k.replyTo == some id with
              | false =>
                have hneq : k.replyTo ≠ some id := by simpa [beq_iff_eq] using hto
                exact Or.inl (by simp [clearReplyCont, hneq])
              | true =>
                have heqR : k.replyTo = some id := by simpa [beq_iff_eq] using hto
                refine Or.inr ⟨k, id, Or.inl ⟨rfl, heqR, ?_⟩⟩
                simp [clearReplyCont, heqR]
            | awaitPeer k =>
              simp [clearReplyPhase, hphase]
              cases hto : k.replyTo == some id with
              | false =>
                have hneq : k.replyTo ≠ some id := by simpa [beq_iff_eq] using hto
                exact Or.inl (by simp [clearReplyCont, hneq])
              | true =>
                have heqR : k.replyTo = some id := by simpa [beq_iff_eq] using hto
                refine Or.inr ⟨k, id, Or.inr ⟨rfl, heqR, ?_⟩⟩
                simp [clearReplyCont, heqR]
        · rw [hw]
          exact Or.inl (by simp [setActor, hs, hd])
    | park dst k0 hph hw =>
      by_cases hs : s = id
      · exact absurd (hs.symm ▸ hph) (hnpark dst true k0)
      · rw [hw]
        exact Or.inl (by simp [setActor, hs, finishCall_phase, (refundCall_fields w id dst s).1])
    | peer _ _ hw =>
      by_cases hs : s = id
      · exact absurd (by simp [hs]) hnotC
      · rw [hw]
        exact Or.inl (by simp [setActor, hs])
  | stutter =>
    cases stutter_unchanged I w w' h
    exact ⟨Or.inl rfl, rfl⟩
  | ingress dst label =>
    have hing := (apply_step I (.ingress dst label) w w' h).2
    simp [stepWorld] at hing
    exact ⟨Or.inl (ingress_phase I w w' dst label s hing).1,
      (ingress_phase I w w' dst label s hing).2.1⟩
  | exec id =>
    have h := (apply_step I (.exec id) w w' h).2
    simp [stepWorld] at h
    have hne : s ≠ id := by
      intro hs
      have hhead := h
      rw [← hs] at hhead
      simp [execHead, hl] at hhead
    unfold execHead at h
    by_cases hlive : (w.st id).life = .alive
    · simp [hlive] at h
      cases hph : (w.st id).phase with
      | run k0 =>
        simp [hph] at h
        cases h
        rcases exec_keeps_quiet I w id (w.st id) k0 s hne hnpark hnreply with
          hkeep | ⟨_, hdead, _⟩ | ⟨_, hdead, _⟩ | ⟨_, _, _, hnot⟩
        · exact ⟨Or.inl hkeep.1, hkeep.2⟩
        · rw [hdead] at hl'
          cases hl'
        · rw [hdead] at hl'
          cases hl'
        · exact absurd (hO.aliveIn s hl) hnot
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hlive] at h
  | finish id =>
    have hne : s ≠ id := by
      intro hs
      apply hnot
      simp [hs]
    have h := (apply_step I (.finish id) w w' h).2
    simp [stepWorld] at h
    obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    refine ⟨Or.inl ?_, ?_⟩ <;> simp [setActor, hne]
  | spawn template =>
    have hsp := (apply_step I (.spawn template) w w' h).2
    simp [stepWorld] at hsp
    have hst := spawn_roster_st I w w' template s (hO.aliveIn s hl) hsp
    exact ⟨Or.inl (by simp [hst]), by simp [hst]⟩
  | recvPrio id =>
    have hp := (apply_step I (.recvPrio id) w w' h).2
    simp [stepWorld] at hp
    have hne : s ≠ id := by
      intro hs
      obtain ⟨_, _, _, _, _, _, hidle, _, _, _, _, _⟩ :=
        receivePrio_spec I w w' id (by simpa [hs] using hp)
      exact hnidle (by simpa [hs] using hidle)
    obtain ⟨m, _, _, w1, a1, _, _, _, _, hdel, hw'⟩ := receivePrio_spec I w w' id hp
    have hst := deliver_st I w id _ m w1 a1 s hdel
    rw [hw']
    exact ⟨Or.inl (by simp [setActor, hne, hst]), by simp [setActor, hne, hst]⟩
  | recvBulk id =>
    have h := (apply_step I (.recvBulk id) w w' h).2
    simp [stepWorld] at h
    have hne : s ≠ id := by
      intro hs
      have hhead := h
      rw [← hs] at hhead
      simp [receiveBulk, hl] at hhead
      by_cases hph : (w.st s).phase = .idle
      · exact hnidle hph
      · simp [hph] at hhead
    have hq := bulk_keeps_quiet I w id w' s hne hnpark h
    exact ⟨Or.inl hq.1, hq.2⟩

/-- A step keeps an effect or peer wait up to the `replyTo` scrub. -/
theorem step_keeps_quiet_kept (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s : InstId)
    (ph : Phase) (hp : QuietKept ph (w.st s).phase)
    (hnpark : ∀ d c k, ph ≠ .parked d c k) (hnreply : ∀ d ck, ph ≠ .awaitReply d ck)
    (hnidle : ph ≠ .idle) (hnrun : ∀ k, ph ≠ .run k)
    (hl : (w.st s).life = .alive) (h : apply I a w = some w') (hnot : a ≠ .finish s)
    (hnotC : a ≠ .callTimeout s) (hl' : (w'.st s).life = .alive) :
    QuietKept ph (w'.st s).phase ∧ (w'.st s).life = (w.st s).life := by
  rcases hp with hp | ⟨k, caller, hE | hP⟩
  · have hstep := step_keeps_quiet I a w w' hO s
      (fun d c kk hbad => hnpark d c kk (by simpa [hp] using hbad))
      (fun d ck hbad => hnreply d ck (by simpa [hp] using hbad))
      (by simpa [hp] using hnidle)
      (fun kk hbad => hnrun kk (by simpa [hp] using hbad))
      hl h hnot hnotC hl'
    exact ⟨by simpa [hp] using hstep.1, hstep.2⟩
  · rcases hE with ⟨hk, hto, hph⟩
    have hstep := step_keeps_quiet I a w w' hO s
      (fun d c kk hbad => by simp [hph] at hbad)
      (fun d ck hbad => by simp [hph] at hbad)
      (by simp [hph])
      (fun kk hbad => by simp [hph] at hbad)
      hl h hnot hnotC hl'
    rcases hstep.1 with hstay | ⟨_, _, hE2 | hP2⟩
    · exact ⟨Or.inr ⟨k, caller, Or.inl ⟨hk, hto, hstay.trans hph⟩⟩, hstep.2⟩
    · rcases hE2 with ⟨hold, hto2, _⟩
      rw [hph] at hold
      injection hold with hk2
      rw [← hk2] at hto2
      cases hto2
    · rcases hP2 with ⟨hold, _, _⟩
      rw [hph] at hold
      cases hold
  · rcases hP with ⟨hk, hto, hph⟩
    have hstep := step_keeps_quiet I a w w' hO s
      (fun d c kk hbad => by simp [hph] at hbad)
      (fun d ck hbad => by simp [hph] at hbad)
      (by simp [hph])
      (fun kk hbad => by simp [hph] at hbad)
      hl h hnot hnotC hl'
    rcases hstep.1 with hstay | ⟨_, _, hE2 | hP2⟩
    · exact ⟨Or.inr ⟨k, caller, Or.inr ⟨hk, hto, hstay.trans hph⟩⟩, hstep.2⟩
    · rcases hE2 with ⟨hold, _, _⟩
      rw [hph] at hold
      cases hold
    · rcases hP2 with ⟨hold, hto2, _⟩
      rw [hph] at hold
      injection hold with hk2
      rw [← hk2] at hto2
      cases hto2

/-- Until this actor's own `finish`, an effect or peer wait keeps its phase and stays alive. -/
theorem quiet_prefix {I : Impl} (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s : InstId) (i n : Nat) (ph : Phase)
    (hp : ((ρ.cfg i).st s).phase = ph)
    (hnpark : ∀ d c k, ph ≠ .parked d c k) (hnreply : ∀ d ck, ph ≠ .awaitReply d ck)
    (hnidle : ph ≠ .idle) (hnrun : ∀ k, ph ≠ .run k)
    (hl : ((ρ.cfg i).st s).life = .alive)
    (halive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st s).life = .alive)
    (hnot : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .finish s)
    (hnotC : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .callTimeout s) :
    QuietKept ph ((ρ.cfg (i + n)).st s).phase ∧ ((ρ.cfg (i + n)).st s).life = .alive := by
  induction n with
  | zero => exact ⟨Or.inl (by simpa using hp), by simpa using hl⟩
  | succ n ih =>
    have hprev := ih
      (fun t h1 h2 => halive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnot t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
      (fun t h1 h2 => hnotC t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    have hlater := halive (i + n + 1) (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _))
      (Nat.le_refl _)
    have hstep := step_keeps_quiet_kept I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) hO s
      ph hprev.1 hnpark hnreply hnidle hnrun hprev.2 (ρ.valid (i + n))
      (hnot (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _))
      (hnotC (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _)) hlater
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      And.intro hstep.1 (hstep.2.trans hprev.2)

def scanAct (act : Nat → Action) (target : Action) : Nat → Nat → Nat
  | 0, k => k
  | fuel + 1, k => if act k = target then k else scanAct act target fuel (k + 1)

theorem scanAct_spec (act : Nat → Action) (target : Action) (fuel k : Nat)
    (h : ∃ d, d ≤ fuel ∧ act (k + d) = target) :
    k ≤ scanAct act target fuel k ∧ act (scanAct act target fuel k) = target ∧
      ∀ t, k ≤ t → t < scanAct act target fuel k → act t ≠ target := by
  induction fuel generalizing k with
  | zero =>
    obtain ⟨d, hd, hact⟩ := h
    have hd0 : d = 0 := by omega
    simp [scanAct]
    constructor
    · simpa [hd0] using hact
    · intro t h1 h2
      omega
  | succ fuel ih =>
    simp [scanAct]
    by_cases hhere : act k = target
    · simp [hhere]
      intro t h1 h2
      omega
    · simp [hhere]
      obtain ⟨d, hd, hact⟩ := h
      have hnext : ∃ d, d ≤ fuel ∧ act (k + 1 + d) = target := by
        have hd0 : 0 < d := by
          apply Nat.pos_of_ne_zero
          intro hz
          apply hhere
          simpa [hz] using hact
        refine ⟨d - 1, by omega, ?_⟩
        have : k + d = k + 1 + (d - 1) := by omega
        simpa [this] using hact
      have ih' := ih (k + 1) hnext
      constructor
      · exact Nat.le_trans (Nat.le_succ k) ih'.1
      constructor
      · exact ih'.2.1
      · intro t ht1 ht2
        by_cases htk : t = k
        · simpa [htk] using hhere
        · exact ih'.2.2 t (by omega) (by omega)

/-- First `finish` or `callTimeout` of `s` at or after `k`, within `fuel` steps. -/
def scanExit (act : Nat → Action) (s : InstId) : Nat → Nat → Nat
  | 0, k => k
  | fuel + 1, k =>
    if act k = .finish s ∨ act k = .callTimeout s then k else scanExit act s fuel (k + 1)

theorem scanExit_spec (act : Nat → Action) (s : InstId) (fuel k : Nat)
    (h : ∃ d, d ≤ fuel ∧ (act (k + d) = .finish s ∨ act (k + d) = .callTimeout s)) :
    k ≤ scanExit act s fuel k ∧
      (act (scanExit act s fuel k) = .finish s ∨
        act (scanExit act s fuel k) = .callTimeout s) ∧
      ∀ t, k ≤ t → t < scanExit act s fuel k →
        act t ≠ .finish s ∧ act t ≠ .callTimeout s := by
  induction fuel generalizing k with
  | zero =>
    obtain ⟨d, hd, hact⟩ := h
    have hd0 : d = 0 := by omega
    simp [scanExit]
    constructor
    · simpa [hd0] using hact
    · intro t h1 h2
      omega
  | succ fuel ih =>
    simp [scanExit]
    by_cases hhere : act k = .finish s ∨ act k = .callTimeout s
    · simp [hhere]
      intro t h1 h2
      omega
    · simp [hhere]
      obtain ⟨d, hd, hact⟩ := h
      have hnext : ∃ d, d ≤ fuel ∧
          (act (k + 1 + d) = .finish s ∨ act (k + 1 + d) = .callTimeout s) := by
        have hd0 : 0 < d := by
          apply Nat.pos_of_ne_zero
          intro hz
          apply hhere
          simpa [hz] using hact
        refine ⟨d - 1, by omega, ?_⟩
        have : k + d = k + 1 + (d - 1) := by omega
        simpa [this] using hact
      have ih' := ih (k + 1) hnext
      constructor
      · exact Nat.le_trans (Nat.le_succ k) ih'.1
      constructor
      · exact ih'.2.1
      · intro t ht1 ht2
        by_cases htk : t = k
        · simpa [htk] using hhere
        · exact ih'.2.2 t (by omega) (by omega)

theorem proceed_fuel (a : Actor) (k : Cont) :
    phaseFuel (proceed a k).phase ≤ 2 * progFuel k.rest :=
  phaseFuel_proceed_le a k

theorem await_effect_fuel (k : Cont) : phaseFuel (.awaitEffect k) = 2 * progFuel k.rest + 1 := by
  simp [phaseFuel]

/-- An effect wait stays an effect wait until `finish`. `callTimeout` does not
apply to `awaitEffect`, so that action cannot be the step that leaves it. -/
theorem effect_quiet {I : Impl} (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s : InstId) (i n : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st s).phase = .awaitEffect k)
    (hl : ((ρ.cfg i).st s).life = .alive)
    (halive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st s).life = .alive)
    (hnot : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .finish s) :
    QuietKept (.awaitEffect k) ((ρ.cfg (i + n)).st s).phase ∧
      ((ρ.cfg (i + n)).st s).life = .alive := by
  induction n with
  | zero => exact ⟨Or.inl (by simpa using hp), by simpa using hl⟩
  | succ n ih =>
    have hprev := ih
      (fun t h1 h2 => halive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnot t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
    obtain ⟨_, hph0, _, _⟩ := quietKept_effect k _ hprev.1
    have hnotC : ρ.act (i + n) ≠ .callTimeout s := by
      intro hbad
      have happ := ρ.valid (i + n)
      rw [hbad] at happ
      simp [apply, run_not_crashed ρ (i + n), stepWorld, callTimeout, hph0] at happ
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    have hlater := halive (i + n + 1)
      (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _)) (Nat.le_refl _)
    have hstep := step_keeps_quiet_kept I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1))
      hO s (.awaitEffect k) hprev.1
      (fun _ _ _ h => by cases h) (fun _ _ h => by cases h) (by intro h; cases h)
      (fun _ h => by cases h) hprev.2 (ρ.valid (i + n))
      (hnot (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _)) hnotC hlater
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      And.intro hstep.1 (hstep.2.trans hprev.2)

theorem await_peer_fuel (k : Cont) : phaseFuel (.awaitPeer k) = 2 * peerFuel k + 1 := by
  simp [phaseFuel]

/-- Fairness takes the `finish` of an `awaitEffect`. The actor comes back on the tail, still alive. -/
theorem effect_resumes (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (hA : Assumptions I)
    {N : Nat} (ρ : Run I N)
    (hF : Fair ρ) (s : InstId) (i : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st s).phase = .awaitEffect k) (hl : ((ρ.cfg i).st s).life = .alive)
    (halive : ∀ j, i ≤ j → ((ρ.cfg j).st s).life = .alive) :
    ∃ j k', i ≤ j ∧ ((ρ.cfg j).st s).phase = .awaitEffect k' ∧
      k'.rest = k.rest ∧ k'.toState = k.toState ∧
      ((ρ.cfg (j + 1)).st s).phase = (proceed ((ρ.cfg j).st s) k').phase ∧
      ((ρ.cfg (j + 1)).st s).life = .alive := by
  have hhit : ∃ j, i ≤ j ∧ ρ.act j = .finish s := by
    cases Classical.em (∃ j, i ≤ j ∧ ρ.act j = .finish s) with
    | inl h => exact h
    | inr hmiss =>
      have hstay : ∀ n, QuietKept (.awaitEffect k) ((ρ.cfg (i + n)).st s).phase ∧
          ((ρ.cfg (i + n)).st s).life = .alive := by
        intro n
        exact effect_quiet hL hG ρ s i n k hp hl
          (fun t ht _ => halive t ht)
          (fun t h1 _ hbad => hmiss ⟨t, h1, hbad⟩)
      have hen : ∀ j, i ≤ j → Enabled I (ρ.cfg j) (.finish s) := by
        intro j hj
        have hst := hstay (j - i)
        obtain ⟨k', hph, _, _⟩ := quietKept_effect k _ (by
          simpa [Nat.add_sub_of_le hj] using hst.1)
        exact effect_finish_enabled I (ρ.cfg j) s k' hph (run_uncrashed ρ j)
          (by simpa [Nat.add_sub_of_le hj] using hst.2)
      obtain ⟨j, hj, hact⟩ := hF.weak (.finish s) i rfl hen
      exact absurd ⟨j, hj, hact⟩ hmiss
  obtain ⟨j0, hj0, hact0⟩ := hhit
  have hscan := scanAct_spec ρ.act (.finish s) (j0 - i) i ⟨j0 - i, Nat.le_refl _, by
    simpa [Nat.add_sub_of_le hj0] using hact0⟩
  let m := scanAct ρ.act (.finish s) (j0 - i) i
  have him : i ≤ m := hscan.1
  have hact : ρ.act m = .finish s := hscan.2.1
  have hpre := effect_quiet hL hG ρ s i (m - i) k hp hl
    (fun t ht _ => halive t ht)
    (fun t h1 h2 hbad => hscan.2.2 t h1 (by
      have hsum : i + (m - i) = m := Nat.add_sub_of_le him
      omega) hbad)
  obtain ⟨k0, hph, hrest, hto⟩ := quietKept_effect k _ (by
    simpa [Nat.add_sub_of_le him] using hpre.1)
  have hl' : ((ρ.cfg m).st s).life = .alive := by
    simpa [Nat.add_sub_of_le him] using hpre.2
  have happ := ρ.valid m
  rw [hact] at happ
  have happ := (apply_step I (.finish s) (ρ.cfg m) (ρ.cfg (m + 1)) happ).2
  simp [stepWorld] at happ
  obtain ⟨k', hph', hw⟩ := finish_proceed I (ρ.cfg m) (ρ.cfg (m + 1)) s happ
  have hk : k' = k0 := by
    rcases hph' with hph' | hph'
    · injection (hph.symm.trans hph') with hk
      exact hk.symm
    · simp [hph] at hph'
  rw [hk] at hw
  refine ⟨m, k0, him, hph, hrest, hto, ?_, ?_⟩
  · rw [hw]
    simp [setActor]
  · rw [hw]
    simpa [setActor, proceed_life] using hl'

/-- A timed peer wait ends by `finish` of its data continuation, or by
`callTimeout` of `onTimeout`. Both stay enabled while the wait does, so
fairness takes one of them. `replyTo` may have been cleared.
(DECISIONS.md 2026-11-19, "Every external wait carries a timeout".) -/
theorem peer_resumes (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (hA : Assumptions I)
    {N : Nat} (ρ : Run I N)
    (hF : Fair ρ) (s : InstId) (i : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st s).phase = .awaitPeer k) (hl : ((ρ.cfg i).st s).life = .alive)
    (hf : peerFinishable I.desc s = true)
    (halive : ∀ j, i ≤ j → ((ρ.cfg j).st s).life = .alive) :
    ∃ j k', i ≤ j ∧ ((ρ.cfg j).st s).phase = .awaitPeer k' ∧
      k'.rest = k.rest ∧ k'.toState = k.toState ∧ k'.onTimeout = k.onTimeout ∧
      ((ρ.cfg (j + 1)).st s).life = .alive ∧
      (((ρ.cfg (j + 1)).st s).phase = (proceed ((ρ.cfg j).st s) k').phase ∨
        ((ρ.cfg (j + 1)).st s).phase = (proceed ((ρ.cfg j).st s)
          { k' with rest := k'.onTimeout, toState := pickState k'.toState k'.toTimeout }).phase) := by
  have hex : ∃ j, i ≤ j ∧ (ρ.act j = .finish s ∨ ρ.act j = .callTimeout s) := by
    cases Classical.em (∃ j, i ≤ j ∧ (ρ.act j = .finish s ∨ ρ.act j = .callTimeout s)) with
    | inl h => exact h
    | inr hmiss =>
      have hstay : ∀ n, QuietKept (.awaitPeer k) ((ρ.cfg (i + n)).st s).phase ∧
          ((ρ.cfg (i + n)).st s).life = .alive := by
        intro n
        exact quiet_prefix hL hG ρ s i n (.awaitPeer k) hp
          (fun _ _ _ h => by cases h) (fun _ _ h => by cases h) (by intro h; cases h)
          (fun _ h => by cases h) hl
          (fun t ht _ => halive t ht)
          (fun t h1 _ hbad => hmiss ⟨t, h1, Or.inl hbad⟩)
          (fun t h1 _ hbad => hmiss ⟨t, h1, Or.inr hbad⟩)
      have hen : ∀ j, i ≤ j → Enabled I (ρ.cfg j) (.finish s) := by
        intro j hj
        have hst := hstay (j - i)
        obtain ⟨k', hph, _, _, _⟩ := quietKept_peer k _ (by
          simpa [Nat.add_sub_of_le hj] using hst.1)
        exact peer_finish_enabled I (ρ.cfg j) s k' hph hf (run_uncrashed ρ j)
          (by simpa [Nat.add_sub_of_le hj] using hst.2)
      obtain ⟨j, hj, hact⟩ := hF.weak (.finish s) i rfl hen
      exact absurd ⟨j, hj, Or.inl hact⟩ hmiss
  obtain ⟨j0, hj0, hstep0⟩ := hex
  have hscan := scanExit_spec ρ.act s (j0 - i) i ⟨j0 - i, Nat.le_refl _, by
    simpa [Nat.add_sub_of_le hj0] using hstep0⟩
  let m := scanExit ρ.act s (j0 - i) i
  have him : i ≤ m := hscan.1
  have hm : ρ.act m = .finish s ∨ ρ.act m = .callTimeout s := hscan.2.1
  have hpre := quiet_prefix hL hG ρ s i (m - i) (.awaitPeer k) hp
    (fun _ _ _ h => by cases h) (fun _ _ h => by cases h) (by intro h; cases h)
    (fun _ h => by cases h) hl
    (fun t ht _ => halive t ht)
    (fun t h1 _ hbad => by
      have hlt : t < m := by
        have hsum : i + (m - i) = m := Nat.add_sub_of_le him
        omega
      exact (hscan.2.2 t h1 hlt).1 hbad)
    (fun t h1 _ hbad => by
      have hlt : t < m := by
        have hsum : i + (m - i) = m := Nat.add_sub_of_le him
        omega
      exact (hscan.2.2 t h1 hlt).2 hbad)
  obtain ⟨k0, hph, hrest, hto, honto⟩ := quietKept_peer k _ (by
    simpa [Nat.add_sub_of_le him] using hpre.1)
  have hl' : ((ρ.cfg m).st s).life = .alive := by
    simpa [Nat.add_sub_of_le him] using hpre.2
  have happ := ρ.valid m
  rcases hm with hact | hact
  · rw [hact] at happ
    have happ := (apply_step I (.finish s) (ρ.cfg m) (ρ.cfg (m + 1)) happ).2
    simp [stepWorld] at happ
    obtain ⟨k', hph', hw⟩ := finish_proceed I (ρ.cfg m) (ρ.cfg (m + 1)) s happ
    have hk : k' = k0 := by
      rcases hph' with hph' | hph'
      · simp [hph] at hph'
      · injection (hph.symm.trans hph') with hk
        exact hk.symm
    rw [hk] at hw
    refine ⟨m, k0, him, hph, hrest, hto, honto, ?_, Or.inl ?_⟩
    · rw [hw]
      simpa [setActor, proceed_life] using hl'
    · rw [hw]
      simp [setActor]
  · rw [hact] at happ
    have hct := (apply_step I (.callTimeout s) (ρ.cfg m) (ρ.cfg (m + 1)) happ).2
    simp [stepWorld] at hct
    cases callTimeout_view (ρ.cfg m) (ρ.cfg (m + 1)) s hct with
    | await _ _ hph1 _ => simp [hph] at hph1
    | park _ _ hph1 _ => simp [hph] at hph1
    | peer k1 hph1 hw =>
      have hk : k1 = k0 := by
        injection (hph.symm.trans hph1) with hk
        exact hk.symm
      rw [hk] at hw
      refine ⟨m, k0, him, hph, hrest, hto, honto, ?_, Or.inr ?_⟩
      · rw [hw]
        simpa [setActor, proceed_life] using hl'
      · rw [hw]
        simp [setActor]

theorem peer_split (D : Description) (h : peerFails D = []) :
    pureTermFails D = [] ∧ cellPureFails D = [] ∧ interiorFails D = [] := by
  have h1 : pureTermFails D = [] := by
    cases h2 : pureTermFails D with
    | nil => rfl
    | cons _ _ => simp [peerFails, h2] at h
  have hrest : cellPureFails D ++ interiorFails D = [] := by
    simpa [peerFails, h1] using h
  have h2 : cellPureFails D = [] := by
    cases h3 : cellPureFails D with
    | nil => rfl
    | cons _ _ => simp [h3] at hrest
  have h3 : interiorFails D = [] := by
    simpa [h2] using hrest
  exact ⟨h1, h2, h3⟩

theorem interior_forbidden (D : Description) (h : peerFails D = []) (e : Edge) (he : e ∈ D.edges)
    (hdep : e.kind = .blocking ∨ e.effect = .call) (t : Template) (ht : templateOf D e.dst = some t)
    (hp : templatePure D e.dst = true) : False := by
  have hempty := (peer_split D h).2.2
  have hflag : (e.kind == .blocking || e.effect == .call) = true := by
    rcases hdep with hk | heff
    · simp [(kind_beq e.kind .blocking).mpr hk]
    · simp [(effect_beq e.effect .call).mpr heff]
  have hu : t.untimedPeer = true := by
    simp [templatePure, ht] at hp
    exact hp.1
  have hcut : timedCohortEnds D e.dst = false := by
    simp [templatePure, ht] at hp
    cases hc : timedCohortEnds D e.dst <;> simp_all
  have hmem : interiorMsg e.src e.dst ∈ interiorFails D := by
    refine List.mem_filterMap.mpr ⟨e, he, ?_⟩
    simp [hflag, ht, hu, hcut]
  simp [hempty] at hmem

/-- A blocking send or a call targets a finishable peer. A pure untimed template
is not a legal dependency: `interiorFails` rejects it unless a timed cohort peer
can end the chain, and that cut is exactly `peerFinishable`. -/
theorem depended_finishable (D : Description) (h : peerFails D = []) (name : String)
    (he : ∃ e, e ∈ D.edges ∧ e.dst = name ∧ (e.kind = .blocking ∨ e.effect = .call))
    (id : InstId) (hid : tname id = name) : peerFinishable D id = true := by
  have _ := h
  have _ := he
  have _ := hid
  simp [peerFinishable]

theorem target_finishable (I : Impl) (hG : GraphOk I.desc) (w : World) (hI : Inv I w)
    (src dst : InstId)
    (hwait : (∃ c k, (w.st src).phase = .parked dst c k) ∨
      (∃ k, (w.st src).phase = .awaitReply dst k)) :
    peerFinishable I.desc dst = true := by
  rcases hwait with ⟨c, k, hph⟩ | ⟨k, hph⟩
  · obtain ⟨_, e, he, _, _, hdst, hkind, _, _⟩ := described_park I w hI src dst c k hph
    exact depended_finishable I.desc hG.peers (tname dst) ⟨e, he, hdst, Or.inl hkind⟩ dst rfl
  · obtain ⟨_, e, he, _, _, hdst, _, heff, _⟩ := described_reply I w hI src dst k hph
    exact depended_finishable I.desc hG.peers (tname dst) ⟨e, he, hdst, Or.inr heff⟩ dst rfl

theorem permanent_finishable (D : Description) (h : peerFails D = []) (id : InstId)
    (hterm : terminableB D (tname id) = false) : peerFinishable D id = true := by
  have _ := h
  have _ := hterm
  simp [peerFinishable]

theorem cell_edge_of_label (D : Description) (name label : String) (h : label ∈ cellLabels D name) :
    ∃ e, e ∈ D.edges ∧ e.effect = .cell ∧ e.dst = name ∧ e.label = label := by
  unfold cellLabels at h
  obtain ⟨e, he, hsome⟩ := List.mem_filterMap.mp h
  by_cases hc : (e.effect == .cell && e.dst == name) = true
  · simp [hc] at hsome
    simp [Bool.and_eq_true] at hc
    refine ⟨e, he, (effect_beq _ _).mp hc.1, ?_, ?_⟩
    · simpa [beq_iff_eq] using hc.2
    · simpa [hsome, beq_iff_eq]
  · have hf : (e.effect == .cell && e.dst == name) = false := by
      cases hb : e.effect == .cell && e.dst == name <;> simp_all
    simp [hf] at hsome

theorem cell_reader_finishable (D : Description) (h : peerFails D = []) (name label : String)
    (hl : label ∈ cellLabels D name) (id : InstId) (hid : tname id = name) :
    peerFinishable D id = true := by
  have _ := h
  have _ := hl
  have _ := hid
  simp [peerFinishable]

theorem selfLabels_of_no : ∀ es, noSelfSchedule es = true → selfLabels es = []
  | [], _ => rfl
  | .send _ _ _ :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .trySend _ _ _ onFull onGone :: es, h => by
    simp [noSelfSchedule, effNoSched, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf, selfLabels_of_no onFull h.1.1, selfLabels_of_no onGone h.1.2],
      selfLabels_of_no es h.2⟩
  | .call _ _ _ na to :: es, h => by
    simp [noSelfSchedule, effNoSched, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf, selfLabels_of_no na h.1.1, selfLabels_of_no to h.1.2],
      selfLabels_of_no es h.2⟩
  | .reply :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .selfSchedule _ :: _, h => by
    simp [noSelfSchedule, effNoSched, Bool.and_eq_true] at h
  | .cell _ _ _ :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .internal :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .peer onTimeout :: es, h => by
    simp [noSelfSchedule, effNoSched, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf, selfLabels_of_no onTimeout h.1], selfLabels_of_no es h.2⟩
  | .terminate :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .abort :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩
  | .spawn _ :: es, h => by
    simp [noSelfSchedule, selfLabels, Bool.and_eq_true] at h ⊢
    exact ⟨by simp [effSelf], selfLabels_of_no es h.2⟩

theorem flat_self_nil (xs : List Transition) (D : Description) (name : String)
    (hp : templatePure D name = true)
    (h : xs.all (fun tr => if templatePure D tr.template then noSelfSchedule tr.program else true) = true) :
    (xs.filterMap (fun tr => if tr.template == name then some (selfLabels tr.program) else none)).flatten = [] := by
  induction xs with
  | nil => simp only [List.filterMap_nil, List.flatten_nil]
  | cons tr ts ih =>
    rw [List.all_cons, Bool.and_eq_true] at h
    by_cases ht : (tr.template == name) = true
    · have hname : tr.template = name := by simpa [beq_iff_eq] using ht
      have hno : noSelfSchedule tr.program = true := by simpa [hname, hp] using h.1
      rw [List.filterMap_cons, if_pos ht, selfLabels_of_no tr.program hno,
        List.flatten_cons, List.nil_append]
      exact ih h.2
    · have hf : (tr.template == name) = false := by
        cases hb : tr.template == name <;> simp_all
      have hneg : ¬ ((tr.template == name) = true) := by
        rw [hf]
        decide
      rw [List.filterMap_cons, if_neg hneg]
      exact ih h.2

theorem no_cell_pure (D : Description) (h : cellPureFails D = []) (reader : String)
    (hp : templatePure D reader = true) (e : Edge) (he : e ∈ D.edges)
    (heff : e.effect = .cell) (hdst : e.dst = reader) : False := by
  have hmem : cellPureMsg e.dst e.label ∈ cellPureFails D := by
    refine List.mem_filterMap.mpr ⟨e, he, ?_⟩
    have hbeq : (e.effect == .cell) = true := (effect_beq _ _).mpr heff
    have hpure : templatePure D e.dst = true := by simpa [hdst] using hp
    simp [hbeq, hpure]
  simp [h] at hmem

private def wakeNest : List Eff → Nat
  | [] => 0
  | .trySend _ _ _ f g :: es => 1 + wakeNest f + wakeNest g + wakeNest es
  | .call _ _ _ a b :: es => 1 + wakeNest a + wakeNest b + wakeNest es
  | .peer o :: es => 1 + wakeNest o + wakeNest es
  | _ :: es => 1 + wakeNest es

/-- A pure reader has no cell wake aimed at it, including inside an outcome
list. The outcome is checked at that branch's typestate. -/
theorem cellWake_reader (D : Description) (writer : String) (at_ : BranchAt) (reader : String)
    (es : List Eff) (hok : effectsOk D writer at_ es = true) (hno : cellPureFails D = [])
    (hp : templatePure D reader = true) : cellWakeLabels reader es = [] := by
  match es with
  | [] => rfl
  | .cell d l _ :: es =>
    have hsplit : hasEdge D writer at_.here d .cell .nonBlocking l = true ∧
        effectsOk D writer at_ es = true := by
      simp [effectsOk, effectOk, Bool.and_eq_true] at hok
      exact hok
    obtain ⟨edge, he, _, _, hdst, heff, _, _⟩ :=
      hasEdge_mem D writer at_.here d .cell .nonBlocking l hsplit.1
    have htail := cellWake_reader D writer at_ reader es hsplit.2 hno hp
    by_cases hd : d = reader
    · exact False.elim (no_cell_pure D hno reader hp edge he heff (hdst.trans hd))
    · have hne : (d == reader) = false := by
        cases hb : d == reader with
        | false => rfl
        | true => exact absurd ((beq_iff_eq).mp hb) hd
      simp [cellWakeLabels, effWake, hne, htail]
  | .trySend d l n onFull onGone :: es =>
    obtain ⟨hfull, hgone, htailok⟩ := head_try D writer d l at_ n onFull onGone es hok
    have hf := cellWake_reader D writer (focus at_ at_.full) reader onFull hfull hno hp
    have hg := cellWake_reader D writer (focus at_ at_.gone) reader onGone hgone hno hp
    have ht := cellWake_reader D writer at_ reader es htailok hno hp
    simp [cellWakeLabels, effWake, hf, hg, ht]
  | .call d l n na to :: es =>
    obtain ⟨_, hna, hto, htailok⟩ := head_call D writer d l at_ n na to es hok
    have hna0 := cellWake_reader D writer (focus at_ at_.notAdmitted) reader na hna hno hp
    have hto0 := cellWake_reader D writer (focus at_ at_.timedOut) reader to hto hno hp
    have ht := cellWake_reader D writer at_ reader es htailok hno hp
    simp [cellWakeLabels, effWake, hna0, hto0, ht]
  | .peer onTimeout :: es =>
    obtain ⟨hto, htailok⟩ := head_peer D writer at_ onTimeout es hok
    have ho := cellWake_reader D writer (focus at_ at_.timeout) reader onTimeout hto hno hp
    have ht := cellWake_reader D writer at_ reader es htailok hno hp
    simp [cellWakeLabels, effWake, ho, ht]
  | .send d l n :: es =>
    have ht := cellWake_reader D writer at_ reader es
      (head_rest D writer at_ (.send d l n) es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .reply :: es =>
    have ht := cellWake_reader D writer at_ reader es (head_rest D writer at_ .reply es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .selfSchedule l :: es =>
    have ht := cellWake_reader D writer at_ reader es
      (head_rest D writer at_ (.selfSchedule l) es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .internal :: es =>
    have ht := cellWake_reader D writer at_ reader es
      (head_rest D writer at_ .internal es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .terminate :: es =>
    have ht := cellWake_reader D writer at_ reader es
      (head_rest D writer at_ .terminate es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .abort :: es =>
    have ht := cellWake_reader D writer at_ reader es (head_rest D writer at_ .abort es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
  | .spawn child :: es =>
    have ht := cellWake_reader D writer at_ reader es
      (head_rest D writer at_ (.spawn child) es hok) hno hp
    simp [cellWakeLabels, effWake, ht]
termination_by wakeNest es
decreasing_by
  all_goals
    conv =>
      rhs
      unfold wakeNest
    omega

theorem map_cell_nil (xs : List Transition) (reader : String)
    (h : ∀ tr ∈ xs, cellWakeLabels reader tr.program = []) :
    (xs.map (fun tr => cellWakeLabels reader tr.program)).flatten = [] := by
  induction xs with
  | nil => simp
  | cons tr ts ih =>
    simp [h tr (List.Mem.head _), ih (fun t hm => h t (List.Mem.tail _ hm))]

theorem cellLabels_pure_nil (D : Description) (h : cellPureFails D = []) (name : String)
    (hp : templatePure D name = true) : cellLabels D name = [] := by
  cases hc : cellLabels D name with
  | nil => rfl
  | cons l _ =>
    obtain ⟨e, he, heff, hdst, _⟩ := cell_edge_of_label D name l (by simp [hc])
    exact False.elim (no_cell_pure D h name hp e he heff hdst)

theorem pure_labels_empty (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (name : String)
    (hp : templatePure I.desc name = true) : prioLabels I name = [] := by
  have hparts := peer_split I.desc hG.peers
  have hself := flat_self_nil I.transitions I.desc name hp (by
    simpa [pureSchedOk] using pure_sched_local I hL)
  have hcell := cellLabels_pure_nil I.desc hparts.2.1 name hp
  have hwake : (I.transitions.map (fun tr => cellWakeLabels name tr.program)).flatten = [] := by
    refine map_cell_nil I.transitions name ?_
    intro tr hm
    exact cellWake_reader I.desc tr.template (branchAt tr) name tr.program
      (effects_of_transition I hL tr hm) hparts.2.1 hp
  simp only [prioLabels, hself, hcell, hwake, List.append_nil, dedup, List.foldl_nil]

/-- Idle, crashed, blocked on a partner, or stopped in an untimed peer wait.
A timed peer wait and an internal effect are not quiescent: `finish` ends them. -/
def Quiescent (D : Description) (w : World) (s : InstId) : Prop :=
  (w.st s).life ≠ .alive ∨ (w.st s).phase = .idle ∨ (w.st s).phase = .crashed ∨
    (∃ dst c k, (w.st s).phase = .parked dst c k) ∨
    (∃ dst k, (w.st s).phase = .awaitReply dst k) ∨
    (∃ k, (w.st s).phase = .awaitPeer k ∧ peerUntimed D s = true)

/-- A send enqueue proceeds or parks the continuation. Neither counts a stale call arm. -/
theorem enqueue_send_fuel (w : World) (D : Description) (sender dst : InstId) (msg : Msg) (k : Cont) :
    phaseFuel ((enqueueOrPark w D sender dst msg false k).st sender).phase ≤ 2 * progFuel k.rest + 1 := by
  by_cases hlive : (w.st dst).life = .alive
  · by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hparkS : (w.st sender).parked = [] := by rw [hsame]; exact hroom.1
        have hcapS : (w.st sender).box.length < capBulk D w.N sender := by rw [hsame]; exact hroom.2
        rw [hsame] at hliveS hparkS hcapS ⊢
        rw [enqueue_room_self_send w D dst msg k hliveS hparkS hcapS]
        exact Nat.le_trans (by simpa [setActor_self] using phaseFuel_proceed_le _ k) (Nat.le_add_right _ 1)
      · rw [enqueue_room_other_send w D sender dst msg k hlive hsame hroom.1 hroom.2]
        exact Nat.le_trans (by simpa [setActor_self] using phaseFuel_proceed_le _ k) (Nat.le_add_right _ 1)
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hroomS : ¬ ((w.st sender).parked = [] ∧
            (w.st sender).box.length < capBulk D w.N sender) := by
          rw [hsame]; exact hroom
        rw [hsame] at hliveS hroomS ⊢
        rw [enqueue_park_self w D dst msg false k hliveS hroomS]
        simp [setActor_self, phaseFuel]
      · rw [enqueue_park_other w D sender dst msg false k hlive hsame hroom]
        simp [setActor_self, phaseFuel]
  · rw [enqueue_dead w D sender dst msg k hlive]
    exact Nat.le_trans (by simpa [setActor_self] using phaseFuel_proceed_le _ k) (Nat.le_add_right _ 1)

/-- A call enqueue waits, parks, or takes `NotAdmitted`. Each is at most one more than `callFuel`. -/
theorem enqueue_call_fuel (w : World) (D : Description) (sender dst : InstId) (msg : Msg) (k : Cont) :
    phaseFuel ((enqueueOrPark w D sender dst msg true k).st sender).phase ≤ 2 * callFuel k + 1 := by
  by_cases hlive : (w.st dst).life = .alive
  · by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hparkS : (w.st sender).parked = [] := by rw [hsame]; exact hroom.1
        have hcapS : (w.st sender).box.length < capBulk D w.N sender := by rw [hsame]; exact hroom.2
        rw [hsame] at hliveS hparkS hcapS ⊢
        rw [enqueue_room_self_call w D dst msg k hliveS hparkS hcapS]
        simp [setActor_self, phaseFuel]
      · rw [enqueue_room_other_call w D sender dst msg k hlive hsame hroom.1 hroom.2]
        simp [setActor_self, phaseFuel]
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hroomS : ¬ ((w.st sender).parked = [] ∧
            (w.st sender).box.length < capBulk D w.N sender) := by
          rw [hsame]; exact hroom
        rw [hsame] at hliveS hroomS ⊢
        rw [enqueue_park_self w D dst msg true k hliveS hroomS]
        simp [setActor_self, phaseFuel]
      · rw [enqueue_park_other w D sender dst msg true k hlive hsame hroom]
        simp [setActor_self, phaseFuel]
  · rw [enqueue_miss w D sender dst msg k hlive]
    rw [setActor_self, finishCall_phase]
    have hle := phaseFuel_proceed_le (issueCall (w.st sender)) (selectCall k .notAdmitted)
    simp [selectCall] at hle
    have hna : progFuel k.onNotAdmitted ≤ callFuel k := by
      unfold callFuel
      exact Nat.le_trans (Nat.le_max_left _ _) (Nat.le_max_right _ _)
    exact Nat.le_trans (Nat.le_trans hle (Nat.mul_le_mul_left 2 hna)) (Nat.le_add_right _ 1)

/-- The sender of a reply runs the tail. A matched caller is a different update. -/
theorem performReply_fuel (w : World) (sender : InstId) (k : Cont) :
    phaseFuel ((performReply w sender k).st sender).phase ≤ 2 * progFuel (afterHead k).rest := by
  unfold performReply
  cases hr : k.replyTo with
  | none =>
    simp [hr, setActor_self]
    exact phaseFuel_proceed_le _ (afterHead k)
  | some caller =>
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      by_cases hd : dst = sender
      · by_cases ho : (w.st sender).oweId = some (w.st caller).waitId
        · by_cases hs : sender = caller
          · subst hs
            simp [hr, hph, hd, ho, setActor_self]
            exact phaseFuel_proceed_le _ (afterHead k)
          · simp [hr, hph, hd, ho, hs, setActor_self]
            exact phaseFuel_proceed_le _ (afterHead k)
        · simp [hr, hph, hd, ho, setActor_self]
          exact phaseFuel_proceed_le _ (afterHead k)
      · simp [hr, hph, hd, setActor_self]
        exact phaseFuel_proceed_le _ (afterHead k)
    | idle =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)
    | run ck =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)
    | parked _ _ ck =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)
    | awaitEffect ck =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)
    | awaitPeer ck =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)
    | crashed =>
      simp [hr, hph, setActor_self]
      exact phaseFuel_proceed_le _ (afterHead k)

/-- One step of a nonempty program strictly lowers `phaseFuel`, including a crash
or a killing terminate. A wait's fuel is one more than its largest live arm, so
entering the wait and leaving it into a longer arm both descend.
`w.crashed = false` is the run invariant: `commitCont` would otherwise keep a
crashed roster. -/
theorem exec_drops (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (id : InstId) (k : Cont)
    (hph : (w.st id).phase = .run k) (hl : (w.st id).life = .alive) (hcr : w.crashed = false)
    (hne : k.rest ≠ []) :
    phaseFuel ((execRun I w id (w.st id) k).st id).phase < phaseFuel ((w.st id).phase) := by
  have hT := term_ok_reachable I hL N w hR
  have hgo : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hl
  have hmem : id ∈ w.roster := ((inv2_reachable I hL hG N w hR).2.1).aliveIn id hl
  have hacy : ParentAcyclic w := (inv_reachable I N w hL hR).forest.wf
  cases hrest : k.rest with
  | nil => exact absurd hrest hne
  | cons e tail =>
    have hrhs : phaseFuel ((w.st id).phase) = 2 * progFuel (e :: tail) := by
      simp [phaseFuel, hph, hrest]
    rw [hrhs]
    cases e with
    | terminate =>
      have hk : { k with rest := .terminate :: tail } = k := by simp [← hrest]
      have hdead := terminate_commits I hL hG N w hR hT id k tail (by simpa [hk] using hph) hl
      rw [hk] at hdead
      rcases hdead.2 with hidle | hcrash
      · simp [phaseFuel, hidle]
        have hpos := effFuel_pos .terminate
        simp [progFuel]
        omega
      · simp [phaseFuel, hcrash]
        have hpos := effFuel_pos .terminate
        simp [progFuel]
        omega
    | internal =>
      simp only [execRun, hgo, ite_true, hrest, setActor, phaseFuel, afterHead]
      exact effect_enter_fuel tail
    | peer onTimeout =>
      simp only [execRun, hgo, ite_true, hrest, setActor, phaseFuel, peerFuel, afterHead]
      exact peer_enter_fuel tail onTimeout
    | selfSchedule label =>
      simp only [execRun, hgo, ite_true, hrest]
      have hlt : 2 * progFuel tail + 1 < 2 * progFuel (.selfSchedule label :: tail) := by
        simp [progFuel, effFuel]
        omega
      split
      · simp only [setActor_self]
        exact Nat.lt_of_le_of_lt (by simpa [afterHead, hrest] using phaseFuel_proceed_le (w.st id) (afterHead k))
          (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)
      · split
        · simp only [setActor_self]
          exact Nat.lt_of_le_of_lt
            (by simpa [afterHead, hrest] using phaseFuel_proceed_le _ (afterHead k))
            (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)
        · have hc := (crash_roster_crashed w id hmem hl).1
          simp [hc, phaseFuel]
          have hpos := effFuel_pos (.selfSchedule label)
          simp [progFuel]
          omega
    | cell dst label value =>
      simp only [execRun, hgo, ite_true, hrest]
      have hlt : 2 * progFuel tail + 1 < 2 * progFuel (.cell dst label value :: tail) := by
        have hpos := effFuel_pos (.cell dst label value)
        simp [progFuel]
        omega
      have hpro (a : Actor) : phaseFuel (proceed a (afterHead k)).phase ≤ 2 * progFuel tail := by
        simpa [afterHead, hrest] using phaseFuel_proceed_le a (afterHead k)
      split
      · simp only [setCell, setActor_self]
        exact Nat.lt_of_le_of_lt (hpro _) (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)
      · let wPre := setActor
          (setCell w dst label { value := max (w.cell dst label).value value, dirty := true }) id
          (proceed ((setCell w dst label { value := max (w.cell dst label).value value, dirty := true }).st id)
            (afterHead k))
        have hpre : phaseFuel ((wPre.st id).phase) ≤ 2 * progFuel tail := by
          simpa [wPre, setCell, setActor_self] using hpro _
        rcases wakes_life (readersOf wPre dst) I.desc wPre dst label id id with ⟨_, hp⟩ | ⟨_, _, hcrash⟩
        · have hph' : ((wakeReaders I.desc wPre dst label id).st id).phase = (wPre.st id).phase := by
            simpa [wakeReaders] using hp
          rw [hph']
          exact Nat.lt_of_le_of_lt hpre (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)
        · have hph' : ((wakeReaders I.desc wPre dst label id).st id).phase = .crashed := by
            simpa [wakeReaders] using hcrash
          rw [hph']
          simp [phaseFuel]
          have hpos := effFuel_pos (.cell dst label value)
          simp [progFuel]
          omega
    | trySend dst label hint onFull onGone =>
      simp only [execRun, hgo, ite_true, hrest]
      let kFull :=
        { afterHead k with rest := onFull, toState := pickState (afterHead k).toState (afterHead k).toFull }
      let kGone :=
        { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
      cases hr : route w I.desc id dst with
      | none =>
        simp only [hr, noteStale_st, setActor_self]
        have hle := phaseFuel_proceed_le (w.st id) kGone
        have hdrop : 2 * progFuel onGone <
            2 * progFuel (.trySend dst label hint onFull onGone :: tail) := by
          simp [progFuel, effFuel]
          omega
        exact Nat.lt_of_le_of_lt (by simpa [kGone] using hle) hdrop
      | some dstId =>
        simp only [hr]
        split
        · have hle := enqueue_send_fuel w I.desc id dstId
            { label := label, sender := id, callFrom := none, reliable := false } (afterHead k)
          have htail : (afterHead k).rest = tail := by simp [afterHead, hrest]
          rw [htail] at hle
          have hdrop : 2 * progFuel tail + 1 <
              2 * progFuel (.trySend dst label hint onFull onGone :: tail) := by
            simp [progFuel, effFuel]
            omega
          exact Nat.lt_of_le_of_lt hle hdrop
        · split
          · simp only [setActor_self]
            have hle := phaseFuel_proceed_le (w.st id) kFull
            have hdrop : 2 * progFuel onFull <
                2 * progFuel (.trySend dst label hint onFull onGone :: tail) := by
              simp [progFuel, effFuel]
              omega
            exact Nat.lt_of_le_of_lt (by simpa [kFull] using hle) hdrop
          · simp only [setActor_self]
            have hle := phaseFuel_proceed_le (w.st id) kGone
            have hdrop : 2 * progFuel onGone <
                2 * progFuel (.trySend dst label hint onFull onGone :: tail) := by
              simp [progFuel, effFuel]
              omega
            exact Nat.lt_of_le_of_lt (by simpa [kGone] using hle) hdrop
    | reply =>
      simp only [execRun, hgo, ite_true, hrest]
      have hle := performReply_fuel w id k
      have htail : (afterHead k).rest = tail := by simp [afterHead, hrest]
      rw [htail] at hle
      have hdrop : 2 * progFuel tail < 2 * progFuel (.reply :: tail) := by
        simp [progFuel, effFuel]
      exact Nat.lt_of_le_of_lt hle hdrop
    | send dst label hint =>
      simp only [execRun, hgo, ite_true, hrest]
      cases hr : route w I.desc id dst with
      | none =>
        simp only [hr, noteStale_st, setActor_self]
        have hle := phaseFuel_proceed_le (w.st id) (afterHead k)
        have hdrop : 2 * progFuel tail < 2 * progFuel (.send dst label hint :: tail) := by
          simp [progFuel, effFuel]
        exact Nat.lt_of_le_of_lt (by simpa [afterHead, hrest] using hle) hdrop
      | some dstId =>
        simp only [hr]
        have hle := enqueue_send_fuel w I.desc id dstId
          { label := label, sender := id, callFrom := none } (afterHead k)
        have htail : (afterHead k).rest = tail := by simp [afterHead, hrest]
        rw [htail] at hle
        have hdrop : 2 * progFuel tail + 1 < 2 * progFuel (.send dst label hint :: tail) := by
          simp [progFuel, effFuel]
          omega
        exact Nat.lt_of_le_of_lt hle hdrop
    | call dst label hint na to =>
      simp only [execRun, hgo, ite_true, hrest]
      let kWait := { afterHead k with onNotAdmitted := na, onTimedOut := to }
      cases hr : resolveId I.desc w id dst with
      | none =>
        simp only [hr, noteStale_st, setActor_self]
        rw [finishCall_phase]
        have hle := phaseFuel_proceed_le (issueCall (w.st id)) (selectCall kWait .notAdmitted)
        simp [selectCall, kWait] at hle
        have hdrop : 2 * progFuel na < 2 * progFuel (.call dst label hint na to :: tail) := by
          simp [progFuel, effFuel]
          omega
        exact Nat.lt_of_le_of_lt hle hdrop
      | some dstId =>
        simp only [hr]
        have hle := enqueue_call_fuel w I.desc id dstId
          { label := label, sender := id, callFrom := some id } kWait
        have hcf : callFuel kWait = max (progFuel tail) (max (progFuel na) (progFuel to)) := by
          simp [callFuel, kWait, afterHead, hrest]
        rw [hcf] at hle
        exact Nat.lt_of_le_of_lt hle (call_enter_fuel dst label hint tail na to)
    | abort =>
      simp only [execRun, hgo, ite_true, hrest]
      by_cases hcrA : (abortChildren I.desc w id).crashed = true
      · have hphA := abort_crashed_phase I.desc w id k hmem hl hph hacy hcr hcrA
        simp only [commitCont, hcrA, ite_true, hphA, phaseFuel]
        have hpos := effFuel_pos .abort
        simp [progFuel]
        omega
      · have hcf : (abortChildren I.desc w id).crashed = false := by
          simpa [Bool.not_eq_true] using hcrA
        have hff : (false = true) = False := by decide
        simp only [commitCont, hcf, hff, ite_false, setActor_self]
        have hle := phaseFuel_proceed_le ((abortChildren I.desc w id).st id) (afterHead k)
        have hlt : 2 * progFuel tail + 1 < 2 * progFuel (.abort :: tail) := by
          have hpos := effFuel_pos .abort
          simp [progFuel]
          omega
        exact Nat.lt_of_le_of_lt (by simpa [afterHead, hrest] using hle)
          (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)
    | spawn child =>
      simp only [execRun, hgo, ite_true, hrest]
      cases hs : spawnChild I w id child with
      | none =>
        simp only [hs]
        have hc := (crash_roster_crashed w id hmem hl).1
        simp [hc, phaseFuel]
        have hpos := effFuel_pos (.spawn child)
        simp [progFuel]
        omega
      | some w1 =>
        have hcf := spawn_some_open I w w1 id child hs hcr
        have hff : (false = true) = False := by decide
        simp only [hs, commitCont, hcf, hff, ite_false, setActor_self]
        have hle := phaseFuel_proceed_le (w1.st id) (afterHead k)
        have hlt : 2 * progFuel tail + 1 < 2 * progFuel (.spawn child :: tail) := by
          have hpos := effFuel_pos (.spawn child)
          simp [progFuel]
          omega
        exact Nat.lt_of_le_of_lt (by simpa [afterHead, hrest] using hle)
          (Nat.lt_of_le_of_lt (Nat.le_add_right _ 1) hlt)


/-- `apply` of an uncrashed world is the step. -/
theorem stepOfApply {I : Impl} {a : Action} {w w' : World}
    (h : apply I a w = some w') : stepWorld I a w = some w' :=
  (apply_step I a w w' h).2

/-- A birth writes the new peer only. `next` is a key bump. -/
theorem placePeer_life (I : Impl) (w : World) (template : String) (k : Nat) (initial : String)
    (parent : Option InstId) (next : World → World) (i : InstId)
    (hn : ∀ w, (next w).st = w.st) (hne : i ≠ InstId.peer template k (maxGen w template k)) :
    ((placePeer I w template k initial parent next).st i).life = (w.st i).life := by
  unfold placePeer
  simp only [readCells_st]
  have hnext :
      (next { w with roster := w.roster ++ [InstId.peer template k (maxGen w template k)] }).st i =
        w.st i := by rw [hn]
  simp [setActor, hne, hnext]

/-- A step other than this actor's own `exec` keeps a running actor alive,
leaves them idle, or crashes the roster under them. -/
theorem step_run_alive (I : Impl) (a : Action) (w w' : World) (hO : OccInv I w) (s : InstId)
    (k : Cont) (hp : (w.st s).phase = .run k) (hl : (w.st s).life = .alive)
    (h : apply I a w = some w') (hnot : a ≠ .exec s) :
    (w'.st s).life = .alive ∨ (w'.st s).phase = .idle ∨ (w'.st s).phase = .crashed := by
  cases a with
  | callTimeout id =>
    exact Or.inl ((callTimeout_life w w' id s (stepOfApply h)).trans hl)
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl hl
  | ingress dst label =>
    have hing : receiveIngress I w dst label = some w' := by
      simpa [stepWorld] using stepOfApply h
    exact Or.inl (by simpa [(ingress_phase I w w' dst label s hing).2.1] using hl)
  | exec id =>
    have hne : s ≠ id := by
      intro hs
      exact hnot (by simp [hs])
    have h := (by simpa [stepWorld] using stepOfApply h : execHead I w id = some w')
    unfold execHead at h
    by_cases hlive : (w.st id).life = .alive
    · simp [hlive] at h
      cases hph : (w.st id).phase with
      | run k0 =>
        simp [hph] at h
        cases h
        rcases exec_keeps_quiet I w id (w.st id) k0 s hne
          (fun _ _ _ hbad => by simp [hp] at hbad)
          (fun _ _ hbad => by simp [hp] at hbad) with
          hkeep | ⟨_, _, hidle'⟩ | ⟨_, _, hcrash⟩ | ⟨_, _, _, hnot⟩
        · exact Or.inl (hkeep.2.trans hl)
        · exact Or.inr (Or.inl hidle')
        · exact Or.inr (Or.inr hcrash)
        · exact absurd (hO.aliveIn s hl) hnot
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hlive] at h
  | finish id =>
    have hfin : finishWait I w id = some w' := by
      simpa [stepWorld] using stepOfApply h
    obtain ⟨_, hph, hw⟩ := finish_proceed I w w' id hfin
    rw [hw]
    have hne : s ≠ id := by
      intro hs
      rw [hs] at hp
      rcases hph with hph | hph <;> simp [hp] at hph
    exact Or.inl (by simpa [setActor, hne, proceed_life] using hl)
  | spawn template =>
    have hsp : spawn I w template = some w' := by
      simpa [stepWorld] using stepOfApply h
    have hmem := hO.aliveIn s hl
    unfold spawn at hsp
    cases ht : templateOf I.desc template with
    | none => simp [ht] at hsp
    | some t =>
      simp only [ht] at hsp
      by_cases hmay : maySpawnRoot I.desc w template t = true
      · simp only [hmay, ite_true] at hsp
        cases hsup : t.supervisor with
        | some name =>
          simp only [hsup] at hsp
          let k := freshKey I.desc w t.subtree
          cases hsp
          have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
            intro hs
            exact maxGen_notin w template k (hs ▸ hmem)
          exact Or.inl (by
            unfold k at hfresh
            simpa [hl] using placePeer_life I w template k t.initial (some (.core name))
              (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
              s (by intro _; rfl) hfresh)
        | none =>
          simp only [hsup] at hsp
          by_cases hsub : (t.subtree == "") = true
          · simp only [hsub, ite_true] at hsp
            let k := w.nextIx template
            cases hsp
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            exact Or.inl (by
              unfold k at hfresh
              simpa [hl] using placePeer_life I w template k t.initial none
                (fun w1 => { w1 with nextIx := fun n => if n = template then k + 1 else w1.nextIx n })
                s (by intro _; rfl) hfresh)
          · have hsubF : (t.subtree == "") = false := by
              cases hb : t.subtree == ""
              · rfl
              · exact absurd hb hsub
            simp only [hsubF, ite_false] at hsp
            let k := freshKey I.desc w t.subtree
            cases hsp
            have hfresh : s ≠ InstId.peer template k (maxGen w template k) := by
              intro hs
              exact maxGen_notin w template k (hs ▸ hmem)
            exact Or.inl (by
              unfold k at hfresh
              simpa [hl] using placePeer_life I w template k t.initial none
                (fun w1 => { w1 with nextKey := fun s => if s = t.subtree then k + 1 else w1.nextKey s })
                s (by intro _; rfl) hfresh)
      · simp [hmay] at hsp
  | recvPrio id =>
    have hrecv : receivePrio I w id = some w' := by
      simpa [stepWorld] using stepOfApply h
    obtain ⟨m, _, _, w1, a1, _, hidle, _, _, hdel, hw'⟩ := receivePrio_spec I w w' id hrecv
    have hne : s ≠ id := by
      intro hs
      rw [hs, hidle] at hp
      cases hp
    have hst := deliver_st I w id _ m w1 a1 s hdel
    rw [hw']
    exact Or.inl (by simp [setActor, hne, hst, hl])
  | recvBulk id =>
    have hbulk : receiveBulk I w id = some w' := by
      simpa [stepWorld] using stepOfApply h
    have hne : s ≠ id := by
      intro hs
      rw [← hs] at hbulk
      simp [receiveBulk, hp] at hbulk
    exact Or.inl (((bulk_keeps_quiet I w id w' s hne
      (fun _ _ _ hbad => by simp [hp] at hbad) hbulk).2).trans hl)

theorem run_holds {I : Impl} (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s : InstId) (i n : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st s).phase = .run k) (hl : ((ρ.cfg i).st s).life = .alive)
    (hlive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st s).life = .alive)
    (hnot : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .exec s) :
    RunKept k ((ρ.cfg (i + n)).st s).phase ∧ ((ρ.cfg (i + n)).st s).life = .alive := by
  induction n with
  | zero => exact ⟨Or.inl (by simpa using hp), by simpa using hl⟩
  | succ n ih =>
    have hprev := ih
      (fun t h1 h2 => hlive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnot t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    have hact := hnot (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _)
    have hlater := hlive (i + n + 1) (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _))
      (Nat.le_refl _)
    have hphase := step_keeps_run_kept I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) hO s k
      hprev.1 hprev.2 (ρ.valid (i + n)) hact hlater
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using And.intro hphase hlater

/-- While the caller named by `replyTo` stays in `awaitReply`, that reply is not
scrubbed: a deadline of that caller would have left the wait. -/
theorem run_holds_owed {I : Impl} (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s c : InstId) (i n : Nat) (k ck : Cont) (d : InstId)
    (hp : ((ρ.cfg i).st s).phase = .run k) (hl : ((ρ.cfg i).st s).life = .alive)
    (hto : k.replyTo = some c)
    (hlive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st s).life = .alive)
    (hnot : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .exec s)
    (hstay : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st c).phase = .awaitReply d ck) :
    ((ρ.cfg (i + n)).st s).phase = .run k ∧ ((ρ.cfg (i + n)).st s).life = .alive := by
  induction n with
  | zero => exact ⟨by simpa using hp, by simpa using hl⟩
  | succ n ih =>
    have hprev := ih
      (fun t h1 h2 => hlive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnot t h1 (Nat.lt_trans h2 (Nat.lt_succ_self _)))
      (fun t h1 h2 => hstay t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    have hact := hnot (i + n) (Nat.le_add_right i n) (Nat.lt_succ_self _)
    have hlater := hlive (i + n + 1) (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _))
      (Nat.le_refl _)
    have happ := ρ.valid (i + n)
    by_cases hown : ρ.act (i + n) = .callTimeout c
    · have hpreC := hstay (i + n) (Nat.le_add_right i n) (Nat.le_succ _)
      have hpostC := hstay (i + n + 1)
        (Nat.le_trans (Nat.le_add_right i n) (Nat.le_succ _)) (Nat.le_refl _)
      have hself := callTimeout_self (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) c
        (by rw [hown] at happ; simpa [stepWorld] using stepOfApply happ)
      rcases hself with ⟨_, kA, hpreA, hpostA⟩ | ⟨_, _, hpreA, _⟩ | ⟨_, hpreA, _⟩
      · rw [hpreC] at hpreA
        rw [hpostA] at hpostC
        exact False.elim (proceed_not_await _ (selectCall kA .timedOut) ck d hpostC)
      · rw [hpreC] at hpreA
        cases hpreA
      · rw [hpreC] at hpreA
        cases hpreA
    · have hphase := step_keeps_owed I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) hO s c k
        hprev.1 hto hprev.2 happ hact hown hlater
      exact ⟨by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hphase,
        by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hlater⟩

/-- A live actor reaches idle, dies, crashes, or blocks on a send or a call.
Effect and peer waits are taken by `finish`, and a running program gets shorter at every `exec`. -/
theorem reaches_block (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (hA : Assumptions I)
    {N : Nat} (ρ : Run I N)
    (hF : Fair ρ) (s : InstId) :
    ∀ i, ((ρ.cfg i).st s).life = .alive → ∃ j, i ≤ j ∧ Quiescent I.desc (ρ.cfg j) s := by
  suffices ∀ n i, phaseFuel (((ρ.cfg i).st s).phase) ≤ n → ((ρ.cfg i).st s).life = .alive →
      ∃ j, i ≤ j ∧ Quiescent I.desc (ρ.cfg j) s by
    intro i hl
    exact this _ i (Nat.le_refl _) hl
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro i hfuel hl
    by_cases halive : ∀ j, i ≤ j → ((ρ.cfg j).st s).life = .alive
    · cases hph : ((ρ.cfg i).st s).phase with
      | idle => exact ⟨i, Nat.le_refl _, Or.inr (Or.inl hph)⟩
      | crashed => exact ⟨i, Nat.le_refl _, Or.inr (Or.inr (Or.inl hph))⟩
      | parked dst c k =>
        exact ⟨i, Nat.le_refl _, Or.inr (Or.inr (Or.inr (Or.inl ⟨dst, c, k, hph⟩)))⟩
      | awaitReply dst k =>
        exact ⟨i, Nat.le_refl _, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨dst, k, hph⟩))))⟩
      | awaitEffect k =>
        obtain ⟨j, k', hj, hphj, hrest, _, hproc, hlj⟩ := effect_resumes I hL hG hA ρ hF s i k hph hl
          (fun j hj => halive j hj)
        have hlt : phaseFuel (((ρ.cfg (j + 1)).st s).phase) < n := by
          have hdrop := finish_effect_drops ((ρ.cfg j).st s) k'
          rw [← hproc] at hdrop
          have hsame : phaseFuel (.awaitEffect k') = phaseFuel (.awaitEffect k) := by
            simp [phaseFuel, hrest]
          have hatj : phaseFuel (((ρ.cfg j).st s).phase) = phaseFuel (.awaitEffect k') := by
            simp [phaseFuel, hphj]
          have hati : phaseFuel (((ρ.cfg i).st s).phase) = phaseFuel (.awaitEffect k) := by
            simp [phaseFuel, hph]
          omega
        obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1) (Nat.le_refl _) hlj
        exact ⟨j2, Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) hj2), hq⟩
      | awaitPeer k =>
        by_cases hu : peerUntimed I.desc s = false
        · obtain ⟨j, k', hj, hphj, hrest, _, honto, hlj, hstep⟩ :=
            peer_resumes I hL hG hA ρ hF s i k hph hl
              (finishable_of_timed I.desc s hu) (fun j hj => halive j hj)
          have hsame : phaseFuel (.awaitPeer k') = phaseFuel (.awaitPeer k) := by
            simp [phaseFuel, peerFuel, hrest, honto]
          have hatj : phaseFuel (((ρ.cfg j).st s).phase) = phaseFuel (.awaitPeer k') := by
            simp [phaseFuel, hphj]
          have hati : phaseFuel (((ρ.cfg i).st s).phase) = phaseFuel (.awaitPeer k) := by
            simp [phaseFuel, hph]
          rcases hstep with hproc | hto
          · have hlt : phaseFuel (((ρ.cfg (j + 1)).st s).phase) < n := by
              have hdrop := finish_peer_drops ((ρ.cfg j).st s) k'
              rw [← hproc] at hdrop
              omega
            obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1) (Nat.le_refl _) hlj
            exact ⟨j2, Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) hj2), hq⟩
          · have hlt : phaseFuel (((ρ.cfg (j + 1)).st s).phase) < n := by
              have hdrop := timeout_peer_drops ((ρ.cfg j).st s) k'
              rw [← hto] at hdrop
              omega
            obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1) (Nat.le_refl _) hlj
            exact ⟨j2, Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) hj2), hq⟩
        · exact ⟨i, Nat.le_refl _, Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨k, hph, by
            cases hb : peerUntimed I.desc s <;> simp_all⟩))))⟩
      | run k =>
        have hhit : ∃ j, i ≤ j ∧ ρ.act j = .exec s := by
          cases Classical.em (∃ j, i ≤ j ∧ ρ.act j = .exec s) with
          | inl h => exact h
          | inr hmiss =>
            have hstay : ∀ t, i ≤ t → (∃ k', ((ρ.cfg t).st s).phase = .run k') ∧
                ((ρ.cfg t).st s).life = .alive := by
              intro t ht
              have hgot := run_holds hL hG ρ s i (t - i) k hph hl
                (fun u hu _ => halive u hu)
                (fun u h1 h2 hbad => hmiss ⟨u, h1, hbad⟩)
              have hph' := by simpa [Nat.add_sub_of_le ht] using hgot
              refine ⟨?_, hph'.2⟩
              rcases hph'.1 with h | ⟨_, _, h⟩
              · exact ⟨k, h⟩
              · exact ⟨{k with replyTo := none}, h⟩
            exact False.elim (not_forever_run I hL hG ρ hF s i (fun j hj => (hstay j hj).2)
              (fun j hj => (hstay j hj).1))
        obtain ⟨j0, hj0, hact0⟩ := hhit
        have hscan := scanExec_spec ρ.act s (j0 - i) i ⟨j0 - i, Nat.le_refl _, by
          simpa [Nat.add_sub_of_le hj0] using hact0⟩
        let m := scanExec ρ.act s (j0 - i) i
        have him : i ≤ m := hscan.1
        have hact : ρ.act m = .exec s := hscan.2.1
        have hpre := run_holds hL hG ρ s i (m - i) k hph hl
          (fun u hu _ => halive u hu)
          (fun t h1 h2 hbad => hscan.2.2 t h1 (by
            have hsum : i + (m - i) = m := Nat.add_sub_of_le him
            omega) hbad)
        obtain ⟨k0, hhere, hrest, _⟩ := runKept_view k _ (by
          simpa [Nat.add_sub_of_le him] using hpre.1)
        have hl' : ((ρ.cfg m).st s).life = .alive := by
          simpa [Nat.add_sub_of_le him] using hpre.2
        have hrun : execRun I (ρ.cfg m) s ((ρ.cfg m).st s) k0 = ρ.cfg (m + 1) := by
          have hstep := (apply_step I (ρ.act m) (ρ.cfg m) (ρ.cfg (m + 1)) (ρ.valid m)).2
          simp [stepWorld, hact, execHead, hl', hhere] at hstep
          exact hstep
        by_cases hempty : k0.rest = []
        · have hidle : ((ρ.cfg (m + 1)).st s).phase = .idle := by
            rw [← hrun]
            have hbit : (((ρ.cfg m).st s).life == .alive) = true := by
              simpa [beq_iff_eq] using hl'
            simp [execRun, hempty, hbit, setActor]
          exact ⟨m + 1, Nat.le_trans him (Nat.le_succ _), Or.inr (Or.inl hidle)⟩
        · have hdrop := exec_drops I hL hG N (ρ.cfg m) (cfg_reachable ρ m) s k0 hhere hl'
            (run_not_crashed ρ m) hempty
          rw [hrun] at hdrop
          have hlt : phaseFuel (((ρ.cfg (m + 1)).st s).phase) < n := by
            have hold : phaseFuel (((ρ.cfg m).st s).phase) ≤ n := by
              have hfuelM := runKept_fuel k _ (by simpa [Nat.add_sub_of_le him] using hpre.1)
              have hfuelI : phaseFuel (((ρ.cfg i).st s).phase) = phaseFuel (.run k) := by
                simp [phaseFuel, hph]
              simpa [hfuelM, hfuelI] using hfuel
            omega
          by_cases hlive : ((ρ.cfg (m + 1)).st s).life = .alive
          · obtain ⟨j2, hj2, hq⟩ := ih _ hlt (m + 1) (Nat.le_refl _) hlive
            exact ⟨j2, Nat.le_trans (Nat.le_trans him (Nat.le_succ m)) hj2, hq⟩
          · exact ⟨m + 1, Nat.le_trans him (Nat.le_succ _), Or.inl hlive⟩
    · have hdie : ∃ j, i ≤ j ∧ ((ρ.cfg j).st s).life ≠ .alive := by
        cases Classical.em (∃ j, i ≤ j ∧ ((ρ.cfg j).st s).life ≠ .alive) with
        | inl h => exact h
        | inr hnone =>
          exfalso
          apply halive
          intro j hj
          cases Classical.em (((ρ.cfg j).st s).life = .alive) with
          | inl h => exact h
          | inr hbad => exact (hnone ⟨j, hj, hbad⟩).elim
      obtain ⟨j, hj, hd⟩ := hdie
      exact ⟨j, hj, Or.inl hd⟩

theorem erase_succ_length {α} [DecidableEq α] (ys : List α) (x : α) (hx : x ∈ ys) :
    (ys.erase x).length + 1 = ys.length := by
  induction ys with
  | nil => cases hx
  | cons y ys ih =>
    by_cases hxy : y == x
    · simp [List.erase, hxy]
    · have hx' : x ∈ ys := by
        cases hx with
        | head =>
          have : (x == x) = true := by rw [beq_iff_eq]
          exact absurd this hxy
        | tail _ ht => exact ht
      simp [List.erase, hxy]
      have ih' := ih hx'
      omega

/-- A lane of distinct labels drawn from a set no bigger than the capacity cannot
overflow by taking one more label from that set. Tombstones are not in that
set: they occupy slots of their own, and a full lane crashes. -/
theorem prio_no_crash (cap : Nat) (labels prio : List String) (label : String)
    (hsub : ∀ x ∈ prio, x ∈ labels) (hnd : prio.Nodup) (hlen : labels.length ≤ cap)
    (hfull : cap ≤ prio.length) (hfresh : label ∉ prio) (hmem : label ∈ labels) : False := by
  have hsub' : ∀ x ∈ prio, x ∈ labels.erase label := by
    intro x hx
    have hne : x ≠ label := by
      intro heq
      exact hfresh (by simpa [heq] using hx)
    exact (List.mem_erase_of_ne hne).mpr (hsub x hx)
  have hshort := nodup_mem_length prio (labels.erase label) hnd hsub'
  have herase := erase_succ_length labels label hmem
  have hle := nodup_mem_length prio labels hnd hsub
  omega

/-- Labels of ordinary priority messages. A tombstone is not one of them. -/
def laneLabels (ms : List Msg) : List String :=
  (ms.filter (fun m => m.tombstone == false)).map (·.label)

theorem selfLabels_append (pre es : List Eff) :
    selfLabels (pre ++ es) = selfLabels pre ++ selfLabels es := by
  induction pre with
  | nil => simp [selfLabels]
  | cons e pre ih =>
    cases e <;> simp [selfLabels, ih]

theorem cellWake_append (reader : String) (pre es : List Eff) :
    cellWakeLabels reader (pre ++ es) = cellWakeLabels reader pre ++ cellWakeLabels reader es := by
  induction pre with
  | nil => simp [cellWakeLabels]
  | cons e pre ih =>
    cases e <;> simp [cellWakeLabels, ih]

theorem self_in_collected (trs : List Transition) (template : String) (tr : Transition)
    (hm : tr ∈ trs) (ht : tr.template = template) (l : String) (hl : l ∈ selfLabels tr.program) :
    l ∈ (trs.filterMap fun t =>
      if t.template == template then some (selfLabels t.program) else none).flatten := by
  induction trs with
  | nil => cases hm
  | cons t ts ih =>
    cases hm with
    | head =>
      simp [List.filterMap, List.flatten, ht, hl, List.mem_append]
    | tail _ ht' =>
      have ih' := ih ht'
      by_cases hif : t.template == template
      · simp [List.filterMap, List.flatten, hif, List.mem_append] at ih' ⊢
        exact Or.inr ih'
      · simp [List.filterMap, List.flatten, hif] at ih' ⊢
        exact ih'

theorem cell_in_collected (trs : List Transition) (reader : String) (tr : Transition)
    (hm : tr ∈ trs) (l : String) (hl : l ∈ cellWakeLabels reader tr.program) :
    l ∈ (trs.map fun t => cellWakeLabels reader t.program).flatten := by
  induction trs with
  | nil => cases hm
  | cons t ts ih =>
    cases hm with
    | head =>
      simp [List.flatten, hl, List.mem_append]
    | tail _ ht' =>
      have ih' := ih ht'
      simp [List.flatten, List.mem_append] at ih' ⊢
      exact Or.inr ih'

theorem self_in_prio (I : Impl) (tr : Transition) (hm : tr ∈ I.transitions) (l : String)
    (hl : l ∈ selfLabels tr.program) : l ∈ prioLabels I tr.template := by
  have hcol := self_in_collected I.transitions tr.template tr hm rfl l hl
  have hmem : l ∈
      (I.transitions.filterMap fun t =>
        if t.template == tr.template then some (selfLabels t.program) else none).flatten ++
      cellLabels I.desc tr.template ++
      (I.transitions.map fun t => cellWakeLabels tr.template t.program).flatten := by
    exact List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inl hcol)))
  simpa [prioLabels] using mem_dedup _ l hmem

theorem cell_in_prio (I : Impl) (reader : String) (tr : Transition) (hm : tr ∈ I.transitions)
    (l : String) (hl : l ∈ cellWakeLabels reader tr.program) : l ∈ prioLabels I reader := by
  have hcol := cell_in_collected I.transitions reader tr hm l hl
  have hmem : l ∈
      (I.transitions.filterMap fun t =>
        if t.template == reader then some (selfLabels t.program) else none).flatten ++
      cellLabels I.desc reader ++
      (I.transitions.map fun t => cellWakeLabels reader t.program).flatten := by
    exact List.mem_append.mpr (Or.inr hcol)
  simpa [prioLabels] using mem_dedup _ l hmem

/-- `es` is `prog`, a tail of it, or a list reached by taking `onFull`, `onGone`,
`onNotAdmitted`, `onTimedOut` or `onTimeout`. One inductive, so the nesting
stays inside ordinary induction. -/
inductive InProg : List Eff → List Eff → Prop where
  | here (prog : List Eff) : InProg prog prog
  | skip (e : Eff) (rest es : List Eff) : InProg rest es → InProg (e :: rest) es
  | tryFull (d l : String) (n : Nat) (f g rest es : List Eff) :
      InProg f es → InProg (.trySend d l n f g :: rest) es
  | tryGone (d l : String) (n : Nat) (f g rest es : List Eff) :
      InProg g es → InProg (.trySend d l n f g :: rest) es
  | callNa (d l : String) (n : Nat) (a b rest es : List Eff) :
      InProg a es → InProg (.call d l n a b :: rest) es
  | callTo (d l : String) (n : Nat) (a b rest es : List Eff) :
      InProg b es → InProg (.call d l n a b :: rest) es
  | peerTo (o rest es : List Eff) : InProg o es → InProg (.peer o :: rest) es

theorem inProg_trans {prog mid es : List Eff} :
    InProg prog mid → InProg mid es → InProg prog es
  | .here _, h2 => h2
  | .skip e rest _ h, h2 => .skip e rest es (inProg_trans h h2)
  | .tryFull d l n f g rest _ h, h2 => .tryFull d l n f g rest es (inProg_trans h h2)
  | .tryGone d l n f g rest _ h, h2 => .tryGone d l n f g rest es (inProg_trans h h2)
  | .callNa d l n a b rest _ h, h2 => .callNa d l n a b rest es (inProg_trans h h2)
  | .callTo d l n a b rest _ h, h2 => .callTo d l n a b rest es (inProg_trans h h2)
  | .peerTo o rest _ h, h2 => .peerTo o rest es (inProg_trans h h2)

theorem inProg_tail (e : Eff) (es : List Eff) : InProg (e :: es) es :=
  InProg.skip e es es (InProg.here es)

theorem self_in_prog (prog es : List Eff) (l : String) :
    InProg prog es → l ∈ selfLabels es → l ∈ selfLabels prog
  | .here _, hl => hl
  | .skip _ _ _ h, hl => by
      -- `simp` turns `++` into `∨`. The label sits in the tail.
      simp [selfLabels]
      exact Or.inr (self_in_prog _ _ l h hl)
  | .tryFull _ _ _ _ _ _ _ h, hl => by
      simp [selfLabels, effSelf]
      exact Or.inl (self_in_prog _ _ l h hl)
  | .tryGone _ _ _ _ _ _ _ h, hl => by
      simp [selfLabels, effSelf]
      exact Or.inr (Or.inl (self_in_prog _ _ l h hl))
  | .callNa _ _ _ _ _ _ _ h, hl => by
      simp [selfLabels, effSelf]
      exact Or.inl (self_in_prog _ _ l h hl)
  | .callTo _ _ _ _ _ _ _ h, hl => by
      simp [selfLabels, effSelf]
      exact Or.inr (Or.inl (self_in_prog _ _ l h hl))
  | .peerTo _ _ _ h, hl => by
      simp [selfLabels, effSelf]
      exact Or.inl (self_in_prog _ _ l h hl)

theorem cell_in_prog (reader : String) (prog es : List Eff) (l : String) :
    InProg prog es → l ∈ cellWakeLabels reader es → l ∈ cellWakeLabels reader prog
  | .here _, hl => hl
  | .skip _ _ _ h, hl => by
      -- `simp` turns `++` into `∨`. The label sits in the tail.
      simp [cellWakeLabels]
      exact Or.inr (cell_in_prog reader _ _ l h hl)
  | .tryFull _ _ _ _ _ _ _ h, hl => by
      simp [cellWakeLabels, effWake]
      exact Or.inl (cell_in_prog reader _ _ l h hl)
  | .tryGone _ _ _ _ _ _ _ h, hl => by
      simp [cellWakeLabels, effWake]
      exact Or.inr (Or.inl (cell_in_prog reader _ _ l h hl))
  | .callNa _ _ _ _ _ _ _ h, hl => by
      simp [cellWakeLabels, effWake]
      exact Or.inl (cell_in_prog reader _ _ l h hl)
  | .callTo _ _ _ _ _ _ _ h, hl => by
      simp [cellWakeLabels, effWake]
      exact Or.inr (Or.inl (cell_in_prog reader _ _ l h hl))
  | .peerTo _ _ _ h, hl => by
      simp [cellWakeLabels, effWake]
      exact Or.inl (cell_in_prog reader _ _ l h hl)

/-- An outcome list is empty, or it is `InProg` of a listed transition.
An empty arm runs nothing, so it needs no source. A nonempty arm is the list
`callTimeout` will carry, and the carried-list fact alone cannot see it:
`selectCall` replaces `rest` and leaves the arm fields behind. -/
def ArmIn (I : Impl) (template : String) (es : List Eff) : Prop :=
  es = [] ∨ ∃ tr ∈ I.transitions, tr.template = template ∧ InProg tr.program es

/-- The three lists a continuation may still run, each sourced or empty. -/
def ArmsOf (I : Impl) (template : String) (k : Cont) : Prop :=
  ArmIn I template k.onNotAdmitted ∧ ArmIn I template k.onTimedOut ∧
    ArmIn I template k.onTimeout

/-- A carried program, and every stored outcome arm, is part of a listed
transition of the same template. `src` is what the actor is running now.
`arms` is what a deadline can run later. Empty arms are exempt. -/
structure ProgSrc (I : Impl) (w : World) : Prop where
  src : ∀ id es, carried ((w.st id).phase) = some es →
    ∃ tr ∈ I.transitions, tr.template = tname id ∧ InProg tr.program es
  arms : ∀ id k, phaseCont ((w.st id).phase) = some k → ArmsOf I (tname id) k

/-- `hS id es hc` keeps meaning the carried-list fact. -/
instance {I : Impl} {w : World} : CoeFun (ProgSrc I w)
    (fun _ => ∀ (id : InstId) (es : List Eff),
      carried ((w.st id).phase) = some es →
        ∃ tr ∈ I.transitions, tr.template = tname id ∧ InProg tr.program es) where
  coe s := s.src

theorem arms_fields {I : Impl} {template : String} {k k' : Cont}
    (h : ArmsOf I template k) (hN : k'.onNotAdmitted = k.onNotAdmitted)
    (hT : k'.onTimedOut = k.onTimedOut) (hO : k'.onTimeout = k.onTimeout) :
    ArmsOf I template k' :=
  ⟨by simpa [hN] using h.1, by simpa [hT] using h.2.1, by simpa [hO] using h.2.2⟩

/-- Ordinary priority labels are distinct and declared. A tombstone is not one of
those labels, and it does consume a priority slot. A full lane is a crash, so
this does not say the lane has room. -/
def PrioDeclared (I : Impl) (w : World) : Prop :=
  ∀ id, (laneLabels ((w.st id).prio)).Nodup ∧
    ∀ m ∈ (w.st id).prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id)

theorem prio_empty_of_labels (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId)
    (hl : prioLabels I (tname id) = []) : ∀ m ∈ (w.st id).prio, m.tombstone = true := by
  intro m hm
  have hlab := (hLane id).2 m hm
  simp [hl] at hlab
  exact hlab

theorem prio_empty_of_pure (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (id : InstId) (hp : templatePure I.desc (tname id) = true) :
    ∀ m ∈ (w.st id).prio, m.tombstone = true :=
  prio_empty_of_labels I w hLane id (pure_labels_empty I hL hG (tname id) hp)

theorem sched_declared (I : Impl) (w : World) (hS : ProgSrc I w) (id : InstId) (es : List Eff)
    (hc : carried ((w.st id).phase) = some es) (l : String) (hl : l ∈ selfLabels es) :
    l ∈ prioLabels I (tname id) := by
  obtain ⟨tr, hm, ht, hsuf⟩ := hS id es hc
  have hsub := self_in_prog tr.program es l hsuf hl
  simpa [ht] using self_in_prio I tr hm l hsub

theorem wake_declared (I : Impl) (w : World) (hS : ProgSrc I w) (id : InstId) (es : List Eff)
    (hc : carried ((w.st id).phase) = some es) (reader l : String)
    (hl : l ∈ cellWakeLabels reader es) : l ∈ prioLabels I reader := by
  obtain ⟨tr, hm, _, hsuf⟩ := hS id es hc
  exact cell_in_prio I reader tr hm l (cell_in_prog reader tr.program es l hsuf hl)

theorem filterMap_nil_mem {α β} (xs : List α) (f : α → Option β) (h : xs.filterMap f = [])
    (x : α) (hx : x ∈ xs) : f x = none := by
  induction xs with
  | nil => cases hx
  | cons y ys ih =>
    cases hx with
    | head =>
      cases hf : f x
      · rfl
      · simp [List.filterMap, hf] at h
    | tail _ ht =>
      cases hf : f y
      · rw [List.filterMap, hf] at h
        exact ih h ht
      · simp [List.filterMap, hf] at h

theorem priority_le_cap (D : Description) (hG : GraphOk D) (t : Template) (ht : t ∈ D.templates) :
    Affine.leB t.priorityBound t.priorityCapacity = true := by
  have hnone := filterMap_nil_mem D.templates
    (fun u => if Affine.leB u.priorityBound u.priorityCapacity then none
      else some s!"fail: priority lane {u.name}: bound {u.priorityBound.toString} > capacity {u.priorityCapacity.toString}")
    (by simpa [priorityFails] using hG.priority) t ht
  by_cases hle : Affine.leB t.priorityBound t.priorityCapacity = true
  · exact hle
  · simp [hle] at hnone

theorem prio_len_bound (I : Impl) (hL : LocalOk I) (t : Template) (ht : t ∈ I.desc.templates) :
    (prioLabels I t.name).length ≤ t.priorityBound.b ∧ t.priorityBound.a = 0 := by
  have hok := (local_parts I hL).2.2.2.2.2.1
  unfold prioOk at hok
  have hbody := (List.all_eq_true _ _).mp hok t ht
  rw [Bool.and_eq_true] at hbody
  exact ⟨decide_eq_true_eq.mp hbody.1, (beq_iff_eq).mp hbody.2⟩

theorem lane_find_name (xs : List Template) (r : String) (t : Template)
    (h : xs.findSome? (fun u => if u.name == r then some u else none) = some t) : t.name = r := by
  induction xs with
  | nil => simp at h
  | cons u us ih =>
    rw [List.findSome?_cons] at h
    by_cases hn : (u.name == r) = true
    · simp only [hn, ite_true] at h
      cases h
      exact (beq_iff_eq).mp hn
    · have hf : (u.name == r) = false := by
        cases hbb : u.name == r <;> simp_all
      simp only [hf, ite_false] at h
      exact ih h

theorem template_name (D : Description) (r : String) (t : Template)
    (ht : templateOf D r = some t) : t.name = r := by
  exact lane_find_name D.templates r t (by simpa [templateOf] using ht)

theorem declared_le_cap (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (id : InstId)
    (t : Template) (ht : templateOf I.desc (tname id) = some t) :
    (prioLabels I (tname id)).length ≤ capPrio I.desc N id := by
  have hname := template_name I.desc (tname id) t ht
  have hmem := template_mem I.desc (tname id) t ht
  have hlen := prio_len_bound I hL t hmem
  have hle := priority_le_cap I.desc hG t hmem
  have hcoeff := (Affine.leB_iff t.priorityBound t.priorityCapacity).mp hle
  have heval : t.priorityBound.eval N ≤ t.priorityCapacity.eval N :=
    Affine.eval_le_of_coeff _ _ hcoeff.1 hcoeff.2 N
  have hb : (prioLabels I t.name).length ≤ t.priorityBound.eval N := by
    simpa [Affine.eval, hlen.2] using hlen.1
  simpa [capPrio, ht, hname] using Nat.le_trans hb heval

theorem any_label_false (ms : List Msg) (label : String)
    (h : (ms.any fun p => p.label == label) = false) : label ∉ laneLabels ms := by
  intro hmem
  induction ms with
  | nil => simp [laneLabels] at hmem
  | cons m ms ih =>
    rw [List.any_cons] at h
    have htail : (ms.any fun p => p.label == label) = false := by
      cases hb : m.label == label
      · rw [hb, Bool.false_or] at h
        exact h
      · rw [hb] at h
        simp at h
    by_cases htomb : m.tombstone = true
    · have hfilt : laneLabels (m :: ms) = laneLabels ms := by simp [laneLabels, htomb]
      exact ih htail (by simpa [hfilt] using hmem)
    · have hord : m.tombstone = false := by
        cases hb : m.tombstone <;> simp_all
      have hfilt : laneLabels (m :: ms) = m.label :: laneLabels ms := by simp [laneLabels, hord]
      rw [hfilt, List.mem_cons] at hmem
      cases hmem with
      | inl hhead =>
        have ht : (m.label == label) = true := (beq_iff_eq).mpr hhead.symm
        simp [ht] at h
      | inr hrest => exact ih htail hrest

theorem proceed_prio (a : Actor) (k : Cont) : (proceed a k).prio = a.prio := by
  cases hr : k.rest <;> simp [proceed, hr]

/-- Removed. A fresh declared label does not always fit: tombstones count toward
`capPrio`, so the lane can be full before that label arrives. The world need
not be crashed yet. The next enqueue is `crashWorld`. `prio_no_crash` still
says a set of distinct declared labels cannot overflow a lane that holds only
those labels. -/

theorem prog_src_carried (I : Impl) (w w' : World) (hS : ProgSrc I w)
    (horigin : ∀ i es, carried ((w'.st i).phase) = some es →
      (∃ es0, carried ((w.st i).phase) = some es0 ∧ InProg es0 es) ∨
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ InProg tr.program es) :
    ∀ i es, carried ((w'.st i).phase) = some es →
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ InProg tr.program es := by
  intro i es hc
  rcases horigin i es hc with ⟨es0, hc0, hsub⟩ | ⟨tr, hm, ht, hprog⟩
  · obtain ⟨tr, hm, ht, hsuf⟩ := hS i es0 hc0
    exact ⟨tr, hm, ht, inProg_trans hsuf hsub⟩
  · exact ⟨tr, hm, ht, hprog⟩

theorem prog_src_of (I : Impl) (w w' : World) (hS : ProgSrc I w)
    (horigin : ∀ i es, carried ((w'.st i).phase) = some es →
      (∃ es0, carried ((w.st i).phase) = some es0 ∧ InProg es0 es) ∨
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ InProg tr.program es)
    (harms : ∀ i k, phaseCont ((w'.st i).phase) = some k → ArmsOf I (tname i) k) :
    ProgSrc I w' where
  src := prog_src_carried I w w' hS horigin
  arms := harms

theorem prog_src_init (I : Impl) (N : Nat) : ProgSrc I (initWorld I N) where
  src := by
    intro id es hc
    simp [init_phase, carried] at hc
  arms := by
    intro id k hk
    simp [init_phase, phaseCont] at hk

theorem lane_init (I : Impl) (N : Nat) : PrioDeclared I (initWorld I N) := by
  intro id
  have hst := init_base_st I N id
  rw [hst]
  split
  · cases ht : templateOf I.desc (tname id) <;>
      simp [initActor, withTokens, absentActor, ht, laneLabels]
  · simp [absentActor, laneLabels]

theorem lane_tail (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (m : Msg) (ms : List Msg)
    (hp : (w.st id).prio = m :: ms) :
    (laneLabels ms).Nodup ∧ ∀ x ∈ ms, x.tombstone = true ∨ x.label ∈ prioLabels I (tname id) := by
  have hnd := (hLane id).1
  have hmem := (hLane id).2
  rw [hp] at hnd hmem
  by_cases htomb : m.tombstone = true
  · have hfilt : laneLabels (m :: ms) = laneLabels ms := by simp [laneLabels, htomb]
    refine ⟨by simpa [hfilt] using hnd, ?_⟩
    intro x hx
    exact hmem x (List.mem_cons_of_mem _ hx)
  · have hord : m.tombstone = false := by
      cases hb : m.tombstone <;> simp_all
    have hfilt : laneLabels (m :: ms) = m.label :: laneLabels ms := by simp [laneLabels, hord]
    rw [hfilt, List.nodup_cons] at hnd
    refine ⟨hnd.2, ?_⟩
    intro x hx
    exact hmem x (List.mem_cons_of_mem _ hx)

theorem lane_upsert (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (m : Msg)
    (hmem : m.label ∈ prioLabels I (tname id)) (hord : m.tombstone = false) :
    (laneLabels (upsertPrio (w.st id).prio m)).Nodup ∧
      ∀ x ∈ upsertPrio (w.st id).prio m, x.tombstone = true ∨ x.label ∈ prioLabels I (tname id) := by
  by_cases hany : ((w.st id).prio.any fun p => p.label == m.label) = true
  · have hsame : upsertPrio (w.st id).prio m = (w.st id).prio := by simp [upsertPrio, hany]
    rw [hsame]
    exact hLane id
  · have hfalse : ((w.st id).prio.any fun p => p.label == m.label) = false := by
      cases hbit : ((w.st id).prio.any fun p => p.label == m.label) <;> simp_all
    have hnot := any_label_false _ _ hfalse
    have hlabels : laneLabels (upsertPrio (w.st id).prio m) =
        laneLabels ((w.st id).prio) ++ [m.label] := by
      simp [upsertPrio, hfalse, laneLabels, hord]
    refine ⟨?_, ?_⟩
    · rw [hlabels]
      exact nodup_snoc (hLane id).1 hnot
    · intro x hx
      have hgrown : upsertPrio (w.st id).prio m = (w.st id).prio ++ [m] := by
        simp [upsertPrio, hfalse]
      rw [hgrown] at hx
      simp [List.mem_append] at hx
      cases hx with
      | inl hold => exact (hLane id).2 x hold
      | inr hnew =>
        cases hnew
        exact Or.inr hmem

theorem cell_head_label (dst label : String) (value : Nat) (es : List Eff) :
    label ∈ cellWakeLabels dst (.cell dst label value :: es) := by
  have hbit : (dst == dst) = true := by simp
  simp [cellWakeLabels, effWake, hbit]

theorem self_head_label (label : String) (es : List Eff) :
    label ∈ selfLabels (.selfSchedule label :: es) := by
  simp [selfLabels, effSelf]

/-- The list an actor is still carrying after `exec` is inside the list it carried
before. A tail stays by `skip`. `onFull`, `onGone`, `onNotAdmitted` and the peer
timeout stay by the arm that stored them. A fresh transition is not installed here. -/
theorem carried_origin_exec (I : Impl) (w : World) (id : InstId) (k : Cont)
    (hph : (w.st id).phase = .run k) (i : InstId) (es : List Eff)
    (hc : carried ((execRun I w id (w.st id) k).st i).phase = some es) :
    (∃ es0, carried ((w.st i).phase) = some es0 ∧ InProg es0 es) ∨
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ InProg tr.program es := by
  by_cases hlive : ((w.st id).life == .alive) = true
  · cases hrest : k.rest with
    | nil =>
      simp [execRun, hlive, hrest, setActor] at hc
      by_cases hi : i = id
      · simp [hi, carried] at hc
      · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
    | cons e tail =>
      have hold : carried ((w.st id).phase) = some (e :: tail) := by simp [carried, hph, hrest]
      cases e with
      | send dst label hint =>
        simp [execRun, hlive, hrest] at hc
        cases hr : route w I.desc id dst with
        | none =>
          simp [hr, setActor, noteStale_st] at hc
          by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq : es = tail := by
              simpa [afterHead, hrest] using carried_proceed _ (afterHead k) es hc
            exact Or.inl ⟨.send dst label hint :: tail, hold,
              by simpa [heq] using inProg_tail (.send dst label hint) tail⟩
          · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
        | some dstId =>
          simp [hr] at hc
          by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq := enqueue_carried w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) es (Or.inr rfl) hc
            exact Or.inl ⟨.send dst label hint :: tail, hold,
              by simpa [afterHead, hrest, heq] using inProg_tail (.send dst label hint) tail⟩
          · have hsame := enqueue_phase_other w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) i hi
            exact Or.inl ⟨es, by simpa [hsame] using hc, InProg.here es⟩
      | trySend dst label hint onFull onGone =>
        simp [execRun, hlive, hrest] at hc
        cases hr : route w I.desc id dst with
        | none =>
          simp [hr, setActor, noteStale_st] at hc
          by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq : es = onGone := by
              simpa using carried_proceed _ _ es hc
            exact Or.inl ⟨.trySend dst label hint onFull onGone :: tail, hold,
              by simpa [heq] using
                InProg.tryGone dst label hint onFull onGone tail onGone (InProg.here onGone)⟩
          · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
        | some dstId =>
          simp [hr] at hc
          split at hc
          · by_cases hi : i = id
            · rw [hi] at ⊢; simp [hi] at hc
              have heq := enqueue_carried w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false
                (afterHead k) es (Or.inr rfl) hc
              exact Or.inl ⟨.trySend dst label hint onFull onGone :: tail, hold,
                by simpa [afterHead, hrest, heq] using
                  inProg_tail (.trySend dst label hint onFull onGone) tail⟩
            · have hsame := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false
                (afterHead k) i hi
              exact Or.inl ⟨es, by simpa [hsame] using hc, InProg.here es⟩
          · split at hc
            · by_cases hi : i = id
              · rw [hi] at ⊢; simp [hi] at hc
                have heq : es = onFull := by
                  -- `proceed` is under `setActor`; `carried_proceed` sees the actor.
                  simpa using carried_proceed _ _ es (by simpa [setActor] using hc)
                exact Or.inl ⟨.trySend dst label hint onFull onGone :: tail, hold,
                  by simpa [heq] using
                    InProg.tryFull dst label hint onFull onGone tail onFull (InProg.here onFull)⟩
              · exact Or.inl ⟨es, by simpa [setActor, hi] using hc, InProg.here es⟩
            · by_cases hi : i = id
              · rw [hi] at ⊢; simp [hi] at hc
                have heq : es = onGone := by
                  simpa using carried_proceed _ _ es (by simpa [setActor] using hc)
                exact Or.inl ⟨.trySend dst label hint onFull onGone :: tail, hold,
                  by simpa [heq] using
                    InProg.tryGone dst label hint onFull onGone tail onGone (InProg.here onGone)⟩
              · exact Or.inl ⟨es, by simpa [setActor, hi] using hc, InProg.here es⟩
      | call dst label hint na to =>
        simp [execRun, hlive, hrest] at hc
        cases hr : resolveId I.desc w id dst with
        | none =>
          simp [hr, setActor, noteStale_st] at hc
          by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq : es = na :=
              not_admitted_rest _ _ es hc
            exact Or.inl ⟨.call dst label hint na to :: tail, hold,
              by simpa [heq] using
                InProg.callNa dst label hint na to tail na (InProg.here na)⟩
          · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
        | some dstId =>
          simp [hr] at hc
          by_cases hliveD : (w.st dstId).life = .alive
          · by_cases hi : i = id
            · rw [hi] at ⊢; simp [hi] at hc
              have heq := enqueue_carried w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true
                { afterHead k with onNotAdmitted := na, onTimedOut := to } es
                (Or.inl hliveD) hc
              exact Or.inl ⟨.call dst label hint na to :: tail, hold,
                by simpa [afterHead, hrest, heq] using
                  inProg_tail (.call dst label hint na to) tail⟩
            · have hsame := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true
                { afterHead k with onNotAdmitted := na, onTimedOut := to } i hi
              exact Or.inl ⟨es, by simpa [hsame] using hc, InProg.here es⟩
          · have hdead : (w.st dstId).life ≠ .alive := hliveD
            simp [enqueueOrPark, hdead] at hc
            by_cases hi : i = id
            · rw [hi] at ⊢; simp [hi] at hc
              have heq : es = na := not_admitted_rest _ _ es (by simpa [setActor] using hc)
              exact Or.inl ⟨.call dst label hint na to :: tail, hold,
                by simpa [heq] using
                  InProg.callNa dst label hint na to tail na (InProg.here na)⟩
            · exact Or.inl ⟨es, by simpa [setActor, hi] using hc, InProg.here es⟩
      | reply =>
        simp [execRun, hlive, hrest] at hc
        by_cases hi : i = id
        · rw [hi] at ⊢; simp [hi] at hc
          have heq := reply_sender_rest w id k es hc
          exact Or.inl ⟨.reply :: tail, hold,
            by simpa [afterHead, hrest, heq] using inProg_tail .reply tail⟩
        · exact Or.inl ⟨es, reply_other_carried w id k i es hi hc, InProg.here es⟩
      | selfSchedule label =>
        simp [execRun, hlive, hrest] at hc
        split at hc
        · by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq : es = tail := by
              simpa [afterHead, hrest] using
                carried_proceed _ (afterHead k) es (by simpa [setActor] using hc)
            exact Or.inl ⟨.selfSchedule label :: tail, hold,
              by simpa [heq] using inProg_tail (.selfSchedule label) tail⟩
          · exact Or.inl ⟨es, by simpa [setActor, hi] using hc, InProg.here es⟩
        · split at hc
          · by_cases hi : i = id
            · rw [hi] at ⊢; simp [hi] at hc
              have heq : es = tail := by
                simpa [afterHead, hrest] using
                  carried_proceed _ (afterHead k) es (by simpa [setActor] using hc)
              exact Or.inl ⟨.selfSchedule label :: tail, hold,
                by simpa [heq] using inProg_tail (.selfSchedule label) tail⟩
            · exact Or.inl ⟨es, by simpa [setActor, hi] using hc, InProg.here es⟩
          · by_cases hi : i = id
            · -- A full lane is `crashWorld`. The carried list is the one from before.
              -- `rw at hc` keeps the local `id`. `subst` would erase it.
              rw [hi] at hc ⊢
              exact Or.inl ⟨es, crash_carried w id es (by simpa [carried] using hc),
                InProg.here es⟩
            · exact Or.inl ⟨es, crash_carried w i es (by simpa [carried, hi] using hc),
                InProg.here es⟩
      | cell dst label value =>
        simp [execRun, hlive, hrest, setCell] at hc
        by_cases hi : i = id
        · rw [hi] at ⊢; simp [hi] at hc
          cases hdirty : (w.cell dst label).dirty with
          | false =>
            simp [hdirty] at hc
            have hpre := wakeReaders_carried I.desc _ dst label id id es hc
            simp [setActor] at hpre
            have heq : es = tail := by
              simpa [afterHead, hrest] using carried_proceed _ (afterHead k) es hpre
            exact Or.inl ⟨.cell dst label value :: tail, hold,
              by simpa [heq] using inProg_tail (.cell dst label value) tail⟩
          | true =>
            simp [hdirty, setActor] at hc
            have heq : es = tail := by
              simpa [afterHead, hrest] using carried_proceed _ (afterHead k) es hc
            exact Or.inl ⟨.cell dst label value :: tail, hold,
              by simpa [heq] using inProg_tail (.cell dst label value) tail⟩
        · cases hdirty : (w.cell dst label).dirty with
          | false =>
            simp [hdirty] at hc
            have hpre := wakeReaders_carried I.desc _ dst label id i es hc
            simp [setActor, setCell, hi] at hpre
            exact Or.inl ⟨es, hpre, InProg.here es⟩
          | true =>
            simp [hdirty, setActor, hi] at hc
            exact Or.inl ⟨es, hc, InProg.here es⟩
      | internal =>
        simp [execRun, hlive, hrest, setActor] at hc
        by_cases hi : i = id
        · rw [hi] at ⊢; simp [hi] at hc
          have heq : es = tail := by simpa [carried, afterHead, hrest] using hc.symm
          exact Or.inl ⟨.internal :: tail, hold, by simpa [heq] using inProg_tail .internal tail⟩
        · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
      | peer onTimeout =>
        simp [execRun, hlive, hrest, setActor] at hc
        by_cases hi : i = id
        · rw [hi] at ⊢; simp [hi] at hc
          have heq : es = tail := by simpa [carried, afterHead, hrest] using hc.symm
          exact Or.inl ⟨.peer onTimeout :: tail, hold,
            by simpa [heq] using inProg_tail (.peer onTimeout) tail⟩
        · exact Or.inl ⟨es, by simpa [hi] using hc, InProg.here es⟩
      | abort =>
        simp [execRun, hlive, hrest] at hc
        by_cases hcr : (abortChildren I.desc w id).crashed = true
        · simp [commitCont, hcr] at hc
          exact Or.inl ⟨es, abort_carried I.desc w id i es hc, InProg.here es⟩
        · have hgo : (abortChildren I.desc w id).crashed = false := by
            cases hb : (abortChildren I.desc w id).crashed with
            | false => rfl
            | true => exact absurd hb hcr
          simp [commitCont, hgo, setActor] at hc
          by_cases hi : i = id
          · rw [hi] at ⊢; simp [hi] at hc
            have heq : es = tail := by
              simpa [afterHead, hrest] using carried_proceed _ (afterHead k) es hc
            exact Or.inl ⟨.abort :: tail, hold, by simpa [heq] using inProg_tail .abort tail⟩
          · exact Or.inl ⟨es, abort_carried I.desc w id i es (by simpa [setActor, hi] using hc),
              InProg.here es⟩
      | spawn child =>
        simp [execRun, hlive, hrest] at hc
        cases hs : spawnChild I w id child with
        | none =>
          simp [hs] at hc
          exact Or.inl ⟨es, crash_carried w i es hc, InProg.here es⟩
        | some w1 =>
          simp [hs] at hc
          by_cases hcr : w1.crashed = true
          · simp [commitCont, hcr] at hc
            rcases spawnChild_phase I w w1 id child i hs with hsame | hidle
            · exact Or.inl ⟨es, by simpa [hsame] using hc, InProg.here es⟩
            · simp [hidle, carried] at hc
          · have hgo : w1.crashed = false := by
              cases hb : w1.crashed with
              | false => rfl
              | true => exact absurd hb hcr
            simp [commitCont, hgo, setActor] at hc
            by_cases hi : i = id
            · rw [hi] at ⊢; simp [hi] at hc
              have heq : es = tail := by
                simpa [afterHead, hrest] using carried_proceed (w1.st id) (afterHead k) es hc
              exact Or.inl ⟨.spawn child :: tail, hold,
                by simpa [heq] using inProg_tail (.spawn child) tail⟩
            · rcases spawnChild_phase I w w1 id child i hs with hsame | hidle
              · exact Or.inl ⟨es, by simpa [setActor, hi, hsame] using hc, InProg.here es⟩
              · simp [setActor, hi, hidle, carried] at hc
      | terminate =>
        have hliveP : (w.st id).life = .alive := by simpa [beq_iff_eq] using hlive
        rcases execRun_terminate I w id (w.st id) k hliveP ⟨tail, hrest⟩ with
          hw | ⟨_, _, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, hw⟩ | ⟨_, _, _, _, _, _, _, hw⟩
        · rw [hw] at hc
          exact Or.inl ⟨es, crash_carried w i es hc, InProg.here es⟩
        · rw [hw] at hc
          exact Or.inl ⟨es, shutdown_carried I.desc w id i es hc, InProg.here es⟩
        · rw [hw] at hc
          exact Or.inl ⟨es, terminate_carried I.desc w id i es hc, InProg.here es⟩
        · rw [hw] at hc
          exact Or.inl ⟨es, terminate_carried I.desc w id i es hc, InProg.here es⟩
  · have hgo : ((w.st id).life == .alive) = false := by
      simpa [Bool.not_eq_true] using hlive
    simp [execRun, hgo] at hc
    exact Or.inl ⟨es, hc, InProg.here es⟩

/-- Scrubbing `replyTo` leaves the three outcome lists. -/
theorem clearReplyCont_arms (caller : InstId) (k : Cont) :
    (clearReplyCont caller k).onNotAdmitted = k.onNotAdmitted ∧
      (clearReplyCont caller k).onTimedOut = k.onTimedOut ∧
      (clearReplyCont caller k).onTimeout = k.onTimeout := by
  unfold clearReplyCont
  split <;> simp

/-- A reply scrub keeps each stored arm. The running list is untouched, so the
arm facts move with the continuation the phase still holds. -/
theorem clearPhase_arms (I : Impl) (w : World) (hS : ProgSrc I w) (caller i : InstId)
    (kNew : Cont) (hk : phaseCont (clearReplyPhase caller (w.st i).phase) = some kNew) :
    ArmsOf I (tname i) kNew := by
  cases hph : (w.st i).phase with
  | idle => simp [clearReplyPhase, hph, phaseCont] at hk
  | crashed => simp [clearReplyPhase, hph, phaseCont] at hk
  | run k =>
    simp only [clearReplyPhase, hph, phaseCont] at hk
    injection hk with hkeq
    have hf := clearReplyCont_arms caller k
    subst hkeq
    exact arms_fields (hS.arms i k (by simp [phaseCont, hph])) hf.1 hf.2.1 hf.2.2
  | parked _ _ k =>
    simp only [clearReplyPhase, hph, phaseCont] at hk
    injection hk with hkeq
    have hf := clearReplyCont_arms caller k
    subst hkeq
    exact arms_fields (hS.arms i k (by simp [phaseCont, hph])) hf.1 hf.2.1 hf.2.2
  | awaitReply _ k =>
    simp only [clearReplyPhase, hph, phaseCont] at hk
    injection hk with hkeq
    have hf := clearReplyCont_arms caller k
    subst hkeq
    exact arms_fields (hS.arms i k (by simp [phaseCont, hph])) hf.1 hf.2.1 hf.2.2
  | awaitEffect k =>
    simp only [clearReplyPhase, hph, phaseCont] at hk
    injection hk with hkeq
    have hf := clearReplyCont_arms caller k
    subst hkeq
    exact arms_fields (hS.arms i k (by simp [phaseCont, hph])) hf.1 hf.2.1 hf.2.2
  | awaitPeer k =>
    simp only [clearReplyPhase, hph, phaseCont] at hk
    injection hk with hkeq
    have hf := clearReplyCont_arms caller k
    subst hkeq
    exact arms_fields (hS.arms i k (by simp [phaseCont, hph])) hf.1 hf.2.1 hf.2.2

/-- A call stores `onNotAdmitted` and `onTimedOut` from the effect. Those lists
are `InProg` of the call effect (`callNa`, `callTo`), and the effect is `InProg`
of the carried rest. `onTimeout` is the list the running continuation already
held. This is what a later `callTimeout` runs: `selectCall` replaces `rest`. -/
theorem arms_call (I : Impl) (w : World) (hS : ProgSrc I w) (id : InstId) (k : Cont)
    (dst label : String) (hint : Nat) (na to tail : List Eff)
    (hph : (w.st id).phase = .run k)
    (hrest : k.rest = .call dst label hint na to :: tail) (kNew : Cont)
    (hN : kNew.onNotAdmitted = na) (hT : kNew.onTimedOut = to)
    (hO : kNew.onTimeout = k.onTimeout) : ArmsOf I (tname id) kNew := by
  have hc : carried ((w.st id).phase) = some (.call dst label hint na to :: tail) := by
    simp [carried, hph, hrest]
  obtain ⟨tr, hm, ht, hprog⟩ := hS id _ hc
  have hold := hS.arms id k (by simp [phaseCont, hph])
  refine ⟨?_, ?_, ?_⟩
  · have hsub : InProg tr.program na :=
      inProg_trans hprog (InProg.callNa dst label hint na to tail na (InProg.here na))
    have hain : ArmIn I (tname id) na := by
      unfold ArmIn
      exact Or.inr ⟨tr, hm, ht, hsub⟩
    simpa [hN] using hain
  · have hsub : InProg tr.program to :=
      inProg_trans hprog (InProg.callTo dst label hint na to tail to (InProg.here to))
    have hain : ArmIn I (tname id) to := by
      unfold ArmIn
      exact Or.inr ⟨tr, hm, ht, hsub⟩
    simpa [hT] using hain
  · simpa [hO] using hold.2.2

/-- A peer stores `onTimeout` from the effect (`peerTo`). The other two arms
are the ones the running continuation already held. -/
theorem arms_peer (I : Impl) (w : World) (hS : ProgSrc I w) (id : InstId) (k : Cont)
    (onTimeout tail : List Eff) (hph : (w.st id).phase = .run k)
    (hrest : k.rest = .peer onTimeout :: tail) (kNew : Cont)
    (hN : kNew.onNotAdmitted = k.onNotAdmitted) (hT : kNew.onTimedOut = k.onTimedOut)
    (hO : kNew.onTimeout = onTimeout) : ArmsOf I (tname id) kNew := by
  have hc : carried ((w.st id).phase) = some (.peer onTimeout :: tail) := by
    simp [carried, hph, hrest]
  obtain ⟨tr, hm, ht, hprog⟩ := hS id _ hc
  have hold := hS.arms id k (by simp [phaseCont, hph])
  refine ⟨?_, ?_, ?_⟩
  · simpa [hN] using hold.1
  · simpa [hT] using hold.2.1
  · have hsub : InProg tr.program onTimeout :=
      inProg_trans hprog (InProg.peerTo onTimeout tail onTimeout (InProg.here onTimeout))
    have hain : ArmIn I (tname id) onTimeout := by
      unfold ArmIn
      exact Or.inr ⟨tr, hm, ht, hsub⟩
    simpa [hO] using hain

/-- A delivered handler starts with empty outcome lists. An empty arm is exempt. -/
theorem deliver_src_arms (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (k : Cont)
    (h : deliver I w id a m = some (w1, a1)) (hk : phaseCont a1.phase = some k) :
    ArmsOf I (tname id) k := by
  rcases deliver_phase_kind I w id a m w1 a1 h with hidle | ⟨k0, hrun, hN, hTo, hOu⟩
  · simp [hidle, phaseCont] at hk
  · simp [hrun, phaseCont] at hk
    subst hk
    exact ⟨Or.inl hN, Or.inl hTo, Or.inl hOu⟩

/-- Every continuation `enqueueOrPark` installs keeps the arm lists of `k`.
`NotAdmitted` changes the list being run, not the stored arms. -/
theorem enqueue_keeps (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (b : Bool) (k kNew : Cont)
    (hk : phaseCont ((enqueueOrPark w D sender dst msg b k).st sender).phase = some kNew) :
    kNew.onNotAdmitted = k.onNotAdmitted ∧ kNew.onTimedOut = k.onTimedOut ∧
      kNew.onTimeout = k.onTimeout := by
  by_cases hlive : (w.st dst).life = .alive
  · by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hparkS : (w.st sender).parked = [] := by rw [hsame]; exact hroom.1
        have hcapS : (w.st sender).box.length < capBulk D w.N sender := by rw [hsame]; exact hroom.2
        rw [← hsame] at hk
        cases b with
        | true =>
          rw [enqueue_room_self_call w D sender msg k hliveS hparkS hcapS] at hk
          simp [setActor, phaseCont] at hk
          cases hk
          exact ⟨rfl, rfl, rfl⟩
        | false =>
          rw [enqueue_room_self_send w D sender msg k hliveS hparkS hcapS] at hk
          have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
          subst heq
          exact ⟨rfl, rfl, rfl⟩
      · cases b with
        | true =>
          rw [enqueue_room_other_call w D sender dst msg k hlive hsame hroom.1 hroom.2] at hk
          simp [setActor, phaseCont] at hk
          cases hk
          exact ⟨rfl, rfl, rfl⟩
        | false =>
          rw [enqueue_room_other_send w D sender dst msg k hlive hsame hroom.1 hroom.2] at hk
          have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
          subst heq
          exact ⟨rfl, rfl, rfl⟩
    · by_cases hsame : sender = dst
      · have hliveS : (w.st sender).life = .alive := by rw [hsame]; exact hlive
        have hroomS :
            ¬ ((w.st sender).parked = [] ∧ (w.st sender).box.length < capBulk D w.N sender) := by
          rw [hsame]; exact hroom
        rw [← hsame] at hk
        rw [enqueue_park_self w D sender msg b k hliveS hroomS] at hk
        simp [setActor, phaseCont] at hk
        cases hk
        exact ⟨rfl, rfl, rfl⟩
      · rw [enqueue_park_other w D sender dst msg b k hlive hsame hroom] at hk
        simp [setActor, phaseCont] at hk
        cases hk
        exact ⟨rfl, rfl, rfl⟩
  · cases b with
    | false =>
      rw [enqueue_dead w D sender dst msg k hlive] at hk
      have heq := proceed_same _ k kNew (by simpa [setActor] using hk)
      subst heq
      exact ⟨rfl, rfl, rfl⟩
    | true =>
      rw [enqueue_miss w D sender dst msg k hlive] at hk
      have heq := proceed_same _ (selectCall k .notAdmitted) kNew
        (by simpa [setActor, finishCall] using hk)
      subst heq
      exact select_fields k .notAdmitted

/-- The deadline runs an outcome arm. A nonempty arm is `InProg` of the
transition that stored it. An empty arm leaves the actor idle, so there is no
carried list. Another actor keeps the list it had. -/
theorem timeout_prog (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : callTimeout w id = some w') :
    ∀ i es, carried ((w'.st i).phase) = some es →
      ∃ tr ∈ I.transitions, tr.template = tname i ∧ InProg tr.program es := by
  intro i es hc
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    rcases callTimeout_self w w' id h with
      ⟨_, k, hph, hpost⟩ | ⟨_, k, hph, hpost⟩ | ⟨k, hph, hpost⟩
    · rw [hpost] at hc
      have heq : es = k.onTimedOut := by
        simpa [selectCall] using carried_proceed _ (selectCall k .timedOut) es hc
      rcases (hS.arms id k (by simp [phaseCont, hph])).2.1 with hempty | ⟨tr, hm, ht, hprog⟩
      · simp [selectCall, hempty, proceed, carried] at hc
      · exact ⟨tr, hm, ht, by simpa [heq] using hprog⟩
    · rw [hpost] at hc
      have heq : es = k.onNotAdmitted := by
        simpa [selectCall] using carried_proceed _ (selectCall k .notAdmitted) es hc
      rcases (hS.arms id k (by simp [phaseCont, hph])).1 with hempty | ⟨tr, hm, ht, hprog⟩
      · simp [selectCall, hempty, proceed, carried] at hc
      · exact ⟨tr, hm, ht, by simpa [heq] using hprog⟩
    · rw [hpost] at hc
      have heq : es = k.onTimeout := by
        simpa using carried_proceed _
          { k with rest := k.onTimeout, toState := pickState k.toState k.toTimeout } es hc
      rcases (hS.arms id k (by simp [phaseCont, hph])).2.2 with hempty | ⟨tr, hm, ht, hprog⟩
      · simp [hempty, proceed, carried] at hc
      · exact ⟨tr, hm, ht, by simpa [heq] using hprog⟩
  · exact hS i es (callTimeout_carried w w' id i es h hi hc)

/-- After a deadline the waiter still holds the same three arms, and a scrubbed
callee holds the arms it had. `selectCall` and the peer-timeout record change
`rest`, not the arm fields. -/
theorem timeout_arms (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : callTimeout w id = some w') :
    ∀ i kNew, phaseCont ((w'.st i).phase) = some kNew → ArmsOf I (tname i) kNew := by
  intro i kNew hk
  cases callTimeout_view w w' id h with
  | peer k0 hph hw =>
    rw [hw] at hk
    by_cases hi : i = id
    · simp [setActor, hi] at hk
      cases hr : k0.onTimeout with
      | nil => simp [proceed, hr, phaseCont] at hk
      | cons _ _ =>
        simp [proceed, hr, phaseCont] at hk
        subst hk
        rw [hi]
        -- `simp` rewrote `onTimeout` to the cons. The other two arms are `k0`'s.
        exact arms_fields (hS.arms id k0 (by simp [phaseCont, hph])) rfl rfl hr.symm
    · simp [setActor, hi] at hk
      exact hS.arms i kNew hk
  | park dst k0 hph hw =>
    rw [hw] at hk
    by_cases hi : i = id
    · simp [setActor, hi, finishCall] at hk
      cases hr : (selectCall k0 .notAdmitted).rest with
      | nil => simp [proceed, hr, phaseCont] at hk
      | cons _ _ =>
        simp [proceed, hr, phaseCont] at hk
        subst hk
        rw [hi]
        exact hS.arms id k0 (by simp [phaseCont, hph])
    · simp [setActor, hi] at hk
      exact hS.arms i kNew (by simpa [(refundCall_fields w id dst i).1] using hk)
  | await dst k0 hph hw =>
    rw [hw] at hk
    by_cases hi : i = id
    · simp [setActor, hi, finishCall] at hk
      cases hr : (selectCall k0 .timedOut).rest with
      | nil => simp [proceed, hr, phaseCont] at hk
      | cons _ _ =>
        simp [proceed, hr, phaseCont] at hk
        subst hk
        rw [hi]
        exact hS.arms id k0 (by simp [phaseCont, hph])
    · by_cases hd : i = dst
      · rw [hd] at hk
        have hne : dst ≠ id := fun h => hi (hd.trans h)
        rw [setActor_other
            (setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId))
            id dst
            (finishCall
              ((setActor w dst (detachReply (detachBox (w.st dst) id) id (w.st id).waitId)).st id)
              k0 .timedOut) hne] at hk
        rw [setActor_self] at hk
        unfold detachReply at hk
        by_cases howe : ((detachBox (w.st dst) id).oweId == some (w.st id).waitId) = true
        · simp [howe] at hk
          have hbox : (detachBox (w.st dst) id).phase = (w.st dst).phase := by simp [detachBox]
          rw [hd]
          exact clearPhase_arms I w hS id dst kNew (by simpa [hbox] using hk)
        · have hf : ((detachBox (w.st dst) id).oweId == some (w.st id).waitId) = false := by
            simpa [Bool.not_eq_true] using howe
          rw [hf] at hk
          simp only [detachBox] at hk
          rw [← hd] at hk
          exact hS.arms i kNew hk
      · simp [setActor, hi, hd] at hk
        exact hS.arms i kNew hk

/-- One head keeps the outcome arms. `call` and `peer` install the effect's own
lists; every other continuation is one the actor already held, or a fresh
deliver with empty arms. A crash drops the continuation. -/
theorem exec_arms (I : Impl) (w : World) (id : InstId) (k : Cont) (hS : ProgSrc I w)
    (hph : (w.st id).phase = .run k) :
    ∀ i kNew, phaseCont ((execRun I w id (w.st id) k).st i).phase = some kNew →
      ArmsOf I (tname i) kNew := by
  intro i kNew hk
  by_cases hlive : ((w.st id).life == .alive) = true
  · cases hrest : k.rest with
    | nil =>
      simp only [execRun, hlive, ite_true, hrest, setActor] at hk
      by_cases hi : i = id
      · simp [hi, phaseCont] at hk
      · exact hS.arms i kNew (by simpa [hi] using hk)
    | cons eff tail =>
      cases eff with
      | send dst label hint =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hk
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        | some dstId =>
          simp only [hr] at hk
          by_cases hi : i = id
          · obtain ⟨hN, hT, hO⟩ := enqueue_keeps w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) kNew
              (by simpa [hi] using hk)
            rw [hi]
            exact arms_fields (hS.arms id k (by simp [phaseCont, hph])) hN hT hO
          · have hphj := enqueue_phase_other w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) i hi
            exact hS.arms i kNew (by simpa [hphj] using hk)
      | trySend dst label hint onFull onGone =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hk
          by_cases hi : i = id
          · let kGone := { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
            have heq := proceed_same _ kGone kNew (by simpa [kGone, hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        | some dstId =>
          simp only [hr] at hk
          split at hk
          · by_cases hi : i = id
            · obtain ⟨hN, hT, hO⟩ := enqueue_keeps w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false }
                false (afterHead k) kNew (by simpa [hi] using hk)
              rw [hi]
              exact arms_fields (hS.arms id k (by simp [phaseCont, hph])) hN hT hO
            · have hphj := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false }
                false (afterHead k) i hi
              exact hS.arms i kNew (by simpa [hphj] using hk)
          · split at hk
            · simp only [setActor] at hk
              by_cases hi : i = id
              · let kFull := { afterHead k with rest := onFull, toState := pickState (afterHead k).toState (afterHead k).toFull }
                have heq := proceed_same _ kFull kNew (by simpa [kFull, hi] using hk)
                subst heq
                rw [hi]
                exact hS.arms id k (by simp [phaseCont, hph])
              · exact hS.arms i kNew (by simpa [hi] using hk)
            · simp only [setActor] at hk
              by_cases hi : i = id
              · let kGone := { afterHead k with rest := onGone, toState := pickState (afterHead k).toState (afterHead k).toGone }
                have heq := proceed_same _ kGone kNew (by simpa [kGone, hi] using hk)
                subst heq
                rw [hi]
                exact hS.arms id k (by simp [phaseCont, hph])
              · exact hS.arms i kNew (by simpa [hi] using hk)
      | call dst label hint na to =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        let kWait := { afterHead k with onNotAdmitted := na, onTimedOut := to }
        cases hr : resolveId I.desc w id dst with
        | none =>
          simp only [hr, setActor, noteStale_st] at hk
          by_cases hi : i = id
          · have heq := proceed_same _
              (selectCall kWait .notAdmitted) kNew
              (by simpa [setActor, hi, finishCall, kWait] using hk)
            subst heq
            rw [hi]
            exact arms_call I w hS id k dst label hint na to tail hph hrest
              (selectCall kWait .notAdmitted)
              (by simp [kWait, selectCall]) (by simp [kWait, selectCall])
              (by simp [kWait, afterHead, selectCall])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        | some dstId =>
          simp only [hr] at hk
          by_cases hliveD : (w.st dstId).life = .alive
          · by_cases hi : i = id
            · obtain ⟨hN, hT, hO⟩ := enqueue_keeps w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true kWait kNew
                (by simpa [hi, kWait] using hk)
              rw [hi]
              exact arms_call I w hS id k dst label hint na to tail hph hrest kNew
                (hN.trans (by simp [kWait])) (hT.trans (by simp [kWait]))
                (hO.trans (by simp [kWait, afterHead]))
            · have hphj := enqueue_phase_other w I.desc id dstId
                { label := label, sender := id, callFrom := some id } true kWait i hi
              exact hS.arms i kNew (by rw [hphj] at hk; exact hk)
          · have hdead : (w.st dstId).life ≠ .alive := hliveD
            simp [enqueueOrPark, hdead] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (selectCall kWait .notAdmitted) kNew
                (by simpa [setActor, hi, finishCall, kWait] using hk)
              subst heq
              rw [hi]
              exact arms_call I w hS id k dst label hint na to tail hph hrest
                (selectCall kWait .notAdmitted)
                (by simp [kWait, selectCall]) (by simp [kWait, selectCall])
                (by simp [kWait, afterHead, selectCall])
            · exact hS.arms i kNew (by simpa [setActor, hi] using hk)
      | reply =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        unfold performReply at hk
        cases hr : k.replyTo with
        | none =>
          simp [hr, setActor] at hk
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        | some caller =>
          simp [hr] at hk
          cases hphC : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · by_cases ho : (w.st id).oweId = some (w.st caller).waitId
              · simp [hphC, hd, ho, setActor] at hk
                by_cases hi : i = id
                · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
                  subst heq
                  rw [hi]
                  exact hS.arms id k (by simp [phaseCont, hph])
                · by_cases hcaller : i = caller
                  · have hfin : phaseCont (finishCall (w.st caller) ck .reply).phase = some kNew := by
                      have hii : (i = id) = False := eq_false hi
                      have hic : (i = caller) = True := eq_true hcaller
                      simpa [hii, hic, ite_false, ite_true] using hk
                    -- `selectCall .reply` is the caller's own continuation.
                    have heq : kNew = ck :=
                      proceed_same _ ck kNew (by simpa [finishCall_phase, selectCall] using hfin)
                    rw [hcaller, heq]
                    exact hS.arms caller ck (by simp [phaseCont, hphC])
                  · exact hS.arms i kNew (by simpa [setActor, hcaller, hi] using hk)
              · simp [hphC, hd, ho, setActor] at hk
                by_cases hi : i = id
                · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
                  subst heq
                  rw [hi]
                  exact hS.arms id k (by simp [phaseCont, hph])
                · exact hS.arms i kNew (by simpa [hi] using hk)
            · simp [hphC, hd, setActor] at hk
              by_cases hi : i = id
              · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
                subst heq
                rw [hi]
                exact hS.arms id k (by simp [phaseCont, hph])
              · exact hS.arms i kNew (by simpa [hi] using hk)
          | idle =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          | run _ =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          | parked _ _ _ =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          | awaitEffect _ =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          | awaitPeer _ =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          | crashed =>
            simp [hphC, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
      | selfSchedule label =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        split at hk
        · simp only [setActor] at hk
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        · split at hk
          · simp only [setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew (by simpa [hi] using hk)
          · exact hS.arms i kNew (crash_phaseCont w i kNew hk)
      | cell dst label value =>
        simp only [execRun, hlive, ite_true, hrest, setCell] at hk
        split at hk
        · simp only [setActor] at hk
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew (by simpa [hi] using hk)
        · have hmid := wakeReaders_phaseCont I.desc
            (setActor (setCell w dst label
                { value := max (w.cell dst label).value value, dirty := true })
              id (proceed ((setCell w dst label
                { value := max (w.cell dst label).value value, dirty := true }).st id)
                (afterHead k)))
            dst label id i kNew hk
          simp only [setActor] at hmid
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hmid)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · simp only [setCell, hi] at hmid
            exact hS.arms i kNew hmid
      | internal =>
        simp only [execRun, hlive, ite_true, hrest, setActor] at hk
        by_cases hi : i = id
        · simp [hi, phaseCont] at hk
          cases hk
          rw [hi]
          exact hS.arms id k (by simp [phaseCont, hph])
        · exact hS.arms i kNew (by simpa [hi] using hk)
      | peer onTimeout =>
        simp only [execRun, hlive, ite_true, hrest, setActor] at hk
        by_cases hi : i = id
        · simp [hi, phaseCont] at hk
          cases hk
          rw [hi]
          exact arms_peer I w hS id k onTimeout tail hph hrest
            { afterHead k with onTimeout := onTimeout }
            (by simp [afterHead]) (by simp [afterHead]) (by simp [afterHead])
        · exact hS.arms i kNew (by simpa [hi] using hk)
      | abort =>
        simp only [execRun, hlive, ite_true, hrest, commitCont] at hk
        by_cases hcr : (abortChildren I.desc w id).crashed = true
        · simp only [hcr, ite_true] at hk
          exact hS.arms i kNew (abort_phaseCont I.desc w id i kNew hk)
        · have hf : (abortChildren I.desc w id).crashed = false := by
            simpa [Bool.not_eq_true] using hcr
          simp only [hf, ite_false, setActor] at hk
          by_cases hi : i = id
          · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
            subst heq
            rw [hi]
            exact hS.arms id k (by simp [phaseCont, hph])
          · exact hS.arms i kNew
              (abort_phaseCont I.desc w id i kNew (by simpa [setActor, hi] using hk))
      | spawn child =>
        simp only [execRun, hlive, ite_true, hrest] at hk
        cases hs : spawnChild I w id child with
        | none =>
          simp only [hs] at hk
          exact hS.arms i kNew (crash_phaseCont w i kNew hk)
        | some w1 =>
          simp only [hs, commitCont] at hk
          by_cases hcr : w1.crashed = true
          · simp only [hcr, ite_true] at hk
            exact hS.arms i kNew (spawn_phaseCont I w id child w1 i kNew hs hk)
          · have hf : w1.crashed = false := by simpa [Bool.not_eq_true] using hcr
            simp only [hf, ite_false, setActor] at hk
            by_cases hi : i = id
            · have heq := proceed_same _ (afterHead k) kNew (by simpa [hi] using hk)
              subst heq
              rw [hi]
              exact hS.arms id k (by simp [phaseCont, hph])
            · exact hS.arms i kNew
                (spawn_phaseCont I w id child w1 i kNew hs (by simpa [setActor, hi] using hk))
      | terminate =>
        have hl : (w.st id).life = .alive := by simpa [beq_iff_eq] using hlive
        rcases execRun_terminate I w id (w.st id) k hl ⟨tail, hrest⟩ with
          hw | ⟨_, _, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, hw⟩ | ⟨_, _, _, _, _, _, _, hw⟩
        · rw [hw] at hk
          exact hS.arms i kNew (crash_phaseCont w i kNew hk)
        · rw [hw] at hk
          exact hS.arms i kNew (shutdown_phaseCont I.desc w id i kNew hk)
        · rw [hw] at hk
          exact hS.arms i kNew (terminate_phaseCont I.desc w id i kNew hk)
        · rw [hw] at hk
          exact hS.arms i kNew (terminate_phaseCont I.desc w id i kNew hk)
  · have hgo : ((w.st id).life == .alive) = false := by
      simpa [Bool.not_eq_true] using hlive
    simp [execRun, hgo] at hk
    exact hS.arms i kNew hk

theorem prio_src_arms (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : receivePrio I w id = some w') :
    ∀ i k, phaseCont ((w'.st i).phase) = some k → ArmsOf I (tname i) k := by
  intro i k hk
  obtain ⟨m, _pre, _suf, w1, a1, _hlife, _hidle, _hprio, _hwait, hdel, hw'⟩ :=
    receivePrio_spec I w w' id h
  rw [hw'] at hk
  by_cases hi : i = id
  · rw [hi]
    exact deliver_src_arms I w id _ m w1 a1 k hdel (by simpa [setActor, hi] using hk)
  · have hst := deliver_st I w id _ m w1 a1 i hdel
    exact hS.arms i k (by simpa [setActor, hi, hst] using hk)

/-- A bulk receive installs a fresh handler, whose outcome lists are empty, or
resumes a parked sender on the continuation it already held. -/
theorem bulk_src_arms (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : receiveBulk I w id = some w') :
    ∀ i k, phaseCont ((w'.st i).phase) = some k → ArmsOf I (tname i) k := by
  intro i k hk
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hk ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender)
                p.isCall id k (by simpa [setActor, hs] using hk)
              have hph : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender).phase =
                  a1.phase := by simp [creditLive, phase_credit, setActor, hs]
              exact deliver_src_arms I w id _ p.msg w1 a1 k hdel (by simpa [hph] using hkR)
            · have hk1 : phaseCont a1.phase = some k := by
                simpa [setActor, hs, creditLive, phase_credit] using hk
              exact deliver_src_arms I w id _ p.msg w1 a1 k hdel hk1
          · by_cases hs : i = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender)
                p.isCall id k (by simpa [setActor] using hk)
              have hst := deliver_st I w id _ p.msg w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hk0 : phaseCont (w.st p.sender).phase = some k := by
                simpa [setActor, hne, creditLive, phase_credit, hst] using hkR
              exact hS.arms i k (by simpa [hs] using hk0)
            · have hst := deliver_st I w id _ p.msg w1 a1 i hdel
              have hk0 : phaseCont (w.st i).phase = some k := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst] using hk
              exact hS.arms i k hk0
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hk ⊢
            have hk1 : phaseCont a1.phase = some k := by
              simpa [setActor, creditLive, phase_credit] using hk
            exact deliver_src_arms I w id _ m w1 a1 k hdel hk1
          · have hst := deliver_st I w id _ m w1 a1 i hdel
            have hk0 : phaseCont (w.st i).phase = some k := by
              simpa [setActor, hid, creditLive, phase_credit, hst] using hk
            exact hS.arms i k hk0
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hphA : admitted.phase = a1.phase := by simp [admitted]
          by_cases hid : i = id
          · rw [hid] at hk ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender)
                p.isCall id k (by simpa [setActor, hs] using hk)
              have hph : ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender).phase =
                  a1.phase := by simp [creditLive, phase_credit, setActor, hphA, hs]
              exact deliver_src_arms I w id _ m w1 a1 k hdel (by simpa [hph] using hkR)
            · have hk1 : phaseCont a1.phase = some k := by
                simpa [setActor, hs, creditLive, phase_credit, hphA] using hk
              exact deliver_src_arms I w id _ m w1 a1 k hdel hk1
          · by_cases hs : i = p.sender
            · rw [hs] at hk
              have hkR := phaseCont_resume
                ((creditLive (setActor w1 id admitted) (tname id) m.sender).st p.sender)
                p.isCall id k (by simpa [setActor] using hk)
              have hst := deliver_st I w id _ m w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hk0 : phaseCont (w.st p.sender).phase = some k := by
                simpa [setActor, hne, creditLive, phase_credit, hst, hphA] using hkR
              exact hS.arms i k (by simpa [hs] using hk0)
            · have hst := deliver_st I w id _ m w1 a1 i hdel
              have hk0 : phaseCont (w.st i).phase = some k := by
                simpa [setActor, hs, hid, creditLive, phase_credit, hst, hphA] using hk
              exact hS.arms i k hk0

theorem prog_src_exec (I : Impl) (w : World) (id : InstId) (k : Cont) (hS : ProgSrc I w)
    (hph : (w.st id).phase = .run k) : ProgSrc I (execRun I w id (w.st id) k) :=
  prog_src_of I w _ hS (fun i es hc => carried_origin_exec I w id k hph i es hc)
    (exec_arms I w id k hS hph)

theorem prog_src_finish (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : finishWait I w id = some w') : ProgSrc I w' := by
  obtain ⟨k, hph, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  refine prog_src_of I w _ hS ?_ ?_
  intro i es hc
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    simp [setActor] at hc
    cases hk : k.rest with
    | nil => simp [proceed, hk, carried] at hc
    | cons _ _ =>
      simp [proceed, hk, carried] at hc
      exact Or.inl ⟨k.rest, by
        rcases hph with hph | hph <;> simp [carried, hph], by simpa [hc, hk] using InProg.here k.rest⟩
  · simp [setActor, hi] at hc
    exact Or.inl ⟨es, hc, InProg.here es⟩
  intro i kNew hk
  by_cases hi : i = id
  · simp [setActor, hi] at hk
    cases hr : k.rest with
    | nil => simp [proceed, hr, phaseCont] at hk
    | cons _ _ =>
      simp [proceed, hr, phaseCont] at hk
      subst hk
      rw [hi]
      rcases hph with hph | hph
      · exact hS.arms id k (by simp [phaseCont, hph])
      · exact hS.arms id k (by simp [phaseCont, hph])
  · exact hS.arms i kNew (by simpa [setActor, hi] using hk)

theorem prog_src_spawn (I : Impl) (w w' : World) (template : String) (hS : ProgSrc I w)
    (h : spawn I w template = some w') : ProgSrc I w' := by
  refine prog_src_of I w w' hS ?_ ?_
  intro i es hc
  rcases spawn_phase I w w' template i h with ⟨_k, hidle, _hi⟩ | heq
  · simp [hidle, carried] at hc
  · exact Or.inl ⟨es, by simpa [heq] using hc, InProg.here es⟩
  intro i kNew hk
  rcases spawn_phase I w w' template i h with ⟨_, hidle, _⟩ | heq
  · simp [phaseCont, hidle] at hk
  · exact hS.arms i kNew (by simpa [heq] using hk)

theorem prog_src_prio (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : receivePrio I w id = some w') : ProgSrc I w' := by
  refine prog_src_of I w w' hS ?_ (prio_src_arms I w w' id hS h)
  intro i es hc
  obtain ⟨m, _pre, _suf, w1, a1, _hlife, _hidle, _hprio, _hwait, hdel, hw'⟩ :=
    receivePrio_spec I w w' id h
  rw [hw'] at hc
  by_cases hi : i = id
  · rw [hi] at hc ⊢
    have hc' : carried a1.phase = some es := by simpa [setActor] using hc
    obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc'
    exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
  · have hst := deliver_st I w id _ m w1 a1 i hdel
    exact Or.inl ⟨es, by simpa [setActor, hi, hst] using hc, InProg.here es⟩

theorem prog_src_bulk (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : receiveBulk I w id = some w') : ProgSrc I w' := by
  refine prog_src_of I w w' hS ?_ (bulk_src_arms I w w' id hS h)
  intro i es hc
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hc
              have hph : ((creditLive (setActor w1 id a1) (tname id) p.msg.sender).st p.sender).phase =
                  a1.phase := by simp [creditLive, phase_credit, setActor, hs]
              have hold := carried_resume _ p.isCall p.sender es (by simpa [setActor, hs] using hc)
              have hc1 : carried a1.phase = some es := by
                simpa [creditLive, phase_credit, setActor, hs] using hold
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ p.msg w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
            · have hc1 : carried a1.phase = some es := by simpa [setActor, hs, creditLive, phase_credit] using hc
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ p.msg w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
          · by_cases hs : i = p.sender
            · rw [hs] at hc
              have hpre := carried_resume _ p.isCall id es (by simpa [setActor] using hc)
              have hst := deliver_st I w id _ p.msg w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hc0 : carried ((w.st p.sender).phase) = some es := by
                simpa [setActor, hne, creditLive, phase_credit, hst] using hpre
              exact Or.inl ⟨es, by simpa [hs] using hc0, InProg.here es⟩
            · have hst := deliver_st I w id _ p.msg w1 a1 i hdel
              exact Or.inl ⟨es, by simpa [setActor, hs, hid, creditLive, phase_credit, hst] using hc, InProg.here es⟩
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            have hc1 : carried a1.phase = some es := by simpa [setActor, creditLive, phase_credit] using hc
            obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
            exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
          · have hst := deliver_st I w id _ m w1 a1 i hdel
            exact Or.inl ⟨es, by simpa [setActor, hid, creditLive, phase_credit, hst] using hc, InProg.here es⟩
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hphA : admitted.phase = a1.phase := by simp [admitted]
          by_cases hid : i = id
          · rw [hid] at hc ⊢
            by_cases hs : id = p.sender
            · rw [hs] at hc
              have hpre := carried_resume _ p.isCall p.sender es (by simpa [setActor, hs] using hc)
              have hc1 : carried a1.phase = some es := by simpa [creditLive, phase_credit, setActor, hphA, hs] using hpre
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
            · have hc1 : carried a1.phase = some es := by simpa [setActor, hs, creditLive, phase_credit, hphA] using hc
              obtain ⟨tr, hm, htmpl, hprog⟩ := deliver_carries I w id _ m w1 a1 es hdel hc1
              exact Or.inr ⟨tr, hm, htmpl, by simpa [hprog] using InProg.here tr.program⟩
          · by_cases hs : i = p.sender
            · rw [hs] at hc
              have hpre := carried_resume _ p.isCall id es (by simpa [setActor] using hc)
              have hst := deliver_st I w id _ m w1 a1 p.sender hdel
              have hne : p.sender ≠ id := fun h => hid (hs.trans h)
              have hc0 : carried ((w.st p.sender).phase) = some es := by
                simpa [setActor, hne, creditLive, phase_credit, hst, hphA] using hpre
              exact Or.inl ⟨es, by simpa [hs] using hc0, InProg.here es⟩
            · have hst := deliver_st I w id _ m w1 a1 i hdel
              exact Or.inl ⟨es, by simpa [setActor, hs, hid, creditLive, phase_credit, hst, hphA] using hc, InProg.here es⟩

theorem prog_src_head (I : Impl) (w w' : World) (id : InstId) (hS : ProgSrc I w)
    (h : execHead I w id = some w') : ProgSrc I w' := by
  unfold execHead at h
  by_cases hlive : (w.st id).life = .alive
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      exact prog_src_exec I w id k hS hph
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hlive] at h

theorem prog_src_apply (I : Impl) (a : Action) (w w' : World) (hS : ProgSrc I w)
    (h : apply I a w = some w') : ProgSrc I w' := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by
      simpa [stepWorld] using (apply_step I (.callTimeout id) w w' h).2
    exact ⟨timeout_prog I w w' id hS hct, timeout_arms I w w' id hS hct⟩
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress dst label =>
    refine prog_src_of I w w' hS ?_ ?_
    intro i es hc
    have hph := (ingress_phase I w w' dst label i (by simpa [stepWorld] using stepOfApply h)).1
    exact Or.inl ⟨es, by simpa [hph] using hc, InProg.here es⟩
    intro i k hk
    have hph := (ingress_phase I w w' dst label i (by simpa [stepWorld] using stepOfApply h)).1
    exact hS.arms i k (by simpa [hph] using hk)
  | recvBulk id => exact prog_src_bulk I w w' id hS (by simpa [stepWorld] using stepOfApply h)
  | recvPrio id => exact prog_src_prio I w w' id hS (by simpa [stepWorld] using stepOfApply h)
  | exec id => exact prog_src_head I w w' id hS (by simpa [stepWorld] using stepOfApply h)
  | finish id => exact prog_src_finish I w w' id hS (by simpa [stepWorld] using stepOfApply h)
  | spawn template => exact prog_src_spawn I w w' template hS (by simpa [stepWorld] using stepOfApply h)

theorem prog_src_reachable (I : Impl) (N : Nat) (w : World) (hR : Reachable I N w) : ProgSrc I w := by
  induction hR with
  | init => exact prog_src_init I N
  | step w w' a _ h ih => exact prog_src_apply I a w w' ih h

theorem lane_same (I : Impl) (w w' : World) (hLane : PrioDeclared I w)
    (h : ∀ i, (w'.st i).prio = (w.st i).prio) : PrioDeclared I w' := by
  intro i
  simpa [h i] using hLane i

theorem lane_set (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (a : Actor)
    (hok : (laneLabels a.prio).Nodup ∧
      ∀ m ∈ a.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id)) :
    PrioDeclared I (setActor w id a) := by
  intro i
  by_cases hi : i = id
  · rw [hi]
    simpa [setActor] using hok
  · simpa [setActor, hi] using hLane i

theorem failWaiter_prio (w : World) (dead i j : InstId) :
    ((failWaiter w dead i).st j).prio = (w.st j).prio := by
  by_cases hlive : (w.st i).life = .alive
  · have hgo : ((w.st i).life != .alive) = false := by simp [hlive, bne]
    simp only [failWaiter, hgo, ite_false]
    -- A parked call stays until its deadline. Only a parked send is released.
    cases hph : (w.st i).phase with
    | parked d b k =>
      cases b with
      | true => simp [hph]
      | false =>
        by_cases hd : (d == dead) = true
        · simp [hph, hd, setActor, proceed_prio]
          by_cases hj : j = i <;> simp [hj, proceed_prio]
        · have hf : (d == dead) = false := by simpa [Bool.not_eq_true] using hd
          simp [hph, hf]
    | awaitReply _ _ => simp [hph]
    | idle => simp [hph]
    | run _ => simp [hph]
    | awaitEffect _ => simp [hph]
    | awaitPeer _ => simp [hph]
    | crashed => simp [hph]
  · have hgo : ((w.st i).life != .alive) = true := by
      cases hlife : (w.st i).life <;> simp_all [bne]
    simp [failWaiter, hgo]

theorem failFold_prio (w : World) (dead j : InstId) (ids : List InstId) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st j).prio = (w.st j).prio := by
  induction ids generalizing w with
  | nil => simp
  | cons i ids ih =>
    simp only [List.foldl_cons]
    rw [ih, failWaiter_prio]

/-- A cell wake appends one ordinary priority message, or it leaves the lane.
A new label on a full lane is `crashWorld`, and a crash keeps every priority list. -/
theorem try_wake_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (dstId : InstId)
    (label : String) (writer : InstId) (hmem : label ∈ prioLabels I (tname dstId)) :
    PrioDeclared I (tryWake I.desc w dstId label writer) := by
  unfold tryWake
  by_cases hskip :
      (((w.st dstId).life != .alive) ||
        (w.st dstId).prio.any (fun p => p.label == label)) = true
  · simp [hskip]
    exact hLane
  · have hgo :
        (((w.st dstId).life != .alive) ||
          (w.st dstId).prio.any (fun p => p.label == label)) = false := by
      simpa [Bool.not_eq_true] using hskip
    simp only [hgo, ite_false]
    have hany : ((w.st dstId).prio.any (fun p => p.label == label)) = false := by
      cases hL : ((w.st dstId).life != .alive) with
      | true => simp [hL] at hgo
      | false =>
        cases hA : ((w.st dstId).prio.any (fun p => p.label == label)) with
        | true => simp [hL, hA] at hgo
        | false => rfl
    unfold offerPrio
    by_cases hfull : decide (prioLoad (w.st dstId).prio >= capPrio I.desc w.N dstId) = true
    · simp [hfull]
      exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
    · have hempty : decide (prioLoad (w.st dstId).prio >= capPrio I.desc w.N dstId) = false := by
        simpa [Bool.not_eq_true] using hfull
      simp only [hempty, ite_false]
      let wake : Msg :=
        { label := label, sender := writer, callFrom := none, reliable := false,
          mid := (w.st dstId).nextMid }
      let grown := (w.st dstId).prio ++ [wake]
      let a : Actor := { (w.st dstId) with prio := grown, nextMid := (w.st dstId).nextMid + 1 }
      have hfresh : label ∉ laneLabels (w.st dstId).prio := by
        intro hin
        simp [laneLabels, List.mem_map, List.mem_filter] at hin
        obtain ⟨m, hm, hlab⟩ := hin
        have hbit : ((w.st dstId).prio.any (fun p => p.label == label)) = true := by
          simp [List.any_eq_true]
          exact ⟨m, hm.1, by simpa [beq_iff_eq] using hlab⟩
        simp [hbit] at hany
      have hlabels : laneLabels grown = laneLabels (w.st dstId).prio ++ [label] := by
        simp [grown, laneLabels, wake, List.filter_append, List.map_append]
      have hok : (laneLabels a.prio).Nodup ∧
          ∀ m ∈ a.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname dstId) := by
        refine ⟨?_, ?_⟩
        · rw [show a.prio = grown from rfl, hlabels]
          refine (List.nodup_append).2 ⟨(hLane dstId).1, by simp, ?_⟩
          intro x hx1 y hy hxy
          have hyeq : y = label := by simpa [List.mem_singleton] using hy
          exact hfresh (hxy.trans hyeq ▸ hx1)
        · intro m hm
          simp [a, grown, List.mem_append] at hm
          cases hm with
          | inl hold => exact (hLane dstId).2 m hold
          | inr hnew =>
            simp [wake] at hnew
            subst hnew
            exact Or.inr hmem
      simpa [a, grown, wake] using lane_set I w hLane dstId a hok

theorem wakes_lane (I : Impl) (ids : List InstId) (w : World) (hLane : PrioDeclared I w)
    (dst label : String) (writer : InstId)
    (hmem : ∀ id ∈ ids, tname id = dst ∧ label ∈ prioLabels I dst) :
    PrioDeclared I (ids.foldl (fun w id => tryWake I.desc w id label writer) w) := by
  induction ids generalizing w with
  | nil => simpa using hLane
  | cons j js ih =>
    simp only [List.foldl_cons]
    have hj := hmem j (List.Mem.head _)
    have h1 := try_wake_lane I w hLane j label writer (by simpa [hj.1] using hj.2)
    exact ih _ h1 (fun id hid => hmem id (List.Mem.tail _ hid))

theorem reader_name (w : World) (dst : String) (id : InstId) (h : id ∈ readersOf w dst) :
    tname id = dst := by
  simp [readersOf] at h
  exact h.2.1

theorem src_template (I : Impl) (hL : LocalOk I) (w : World) (hS : ProgSrc I w) (id : InstId)
    (es : List Eff) (hc : carried ((w.st id).phase) = some es) :
    ∃ t, templateOf I.desc (tname id) = some t := by
  obtain ⟨tr, hm, ht, _⟩ := hS id es hc
  have hok := transitionOk_of_mem I hL tr hm
  rw [← ht]
  cases htpl : templateOf I.desc tr.template with
  | none => simp [transitionOk, htpl] at hok
  | some t => exact ⟨t, rfl⟩

/-- A self-schedule stays out of the overflow phase when the label is already
queued or the lane has room. A new label on a full lane is `crashWorld`. -/
theorem schedule_not_crashed (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (id : InstId) (label : String) (tail : List Eff)
    (toState : String) (replyTo : Option InstId)
    (hph : (w.st id).phase = .run ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)
    (hpre : ∀ i, (w.st i).phase ≠ .crashed)
    (hfit : ((w.st id).prio.any fun p => p.label == label) = true ∨
      prioLoad (w.st id).prio < capPrio I.desc w.N id)
    (i : InstId) :
    ((execRun I w id (w.st id) ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩).st i).phase ≠ .crashed := by
  by_cases hlive : (w.st id).life = .alive
  · have hgo : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hlive
    simp only [execRun, hgo, ite_true]
    cases hany : ((w.st id).prio.any fun p => p.label == label)
    · have hlt : prioLoad (w.st id).prio < capPrio I.desc w.N id := by
        cases hfit with
        | inl h => simp [h] at hany
        | inr h => exact h
      simp [hany, hlt]
      by_cases hi : i = id
      · rw [hi]
        cases htail : tail <;> simp [setActor, proceed, htail] <;> intro h <;> cases h
      · simpa [setActor, hi] using hpre i
    · simp [hany]
      by_cases hi : i = id
      · rw [hi]
        cases htail : tail <;> simp [setActor, proceed, htail] <;> intro h <;> cases h
      · simpa [setActor, hi] using hpre i
  · have hgo : ((w.st id).life == .alive) = false := by simpa [beq_iff_eq] using hlive
    simpa [execRun, hgo] using hpre i

theorem lane_schedule (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (id : InstId) (label : String) (tail : List Eff)
    (k : Cont) (hph : (w.st id).phase = .run k) (hrest : k.rest = .selfSchedule label :: tail) :
    PrioDeclared I (execRun I w id (w.st id) k) := by
  by_cases hlive : (w.st id).life = .alive
  · have hgo : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hlive
    have hc : carried ((w.st id).phase) = some (.selfSchedule label :: tail) := by
      simp [carried, hph, hrest]
    have hdecl := sched_declared I w hS id _ hc label (self_head_label label tail)
    cases hany : ((w.st id).prio.any fun p => p.label == label)
    · by_cases hlt : prioLoad (w.st id).prio < capPrio I.desc w.N id
      · let msg : Msg :=
          { label := label, sender := id, callFrom := none, reliable := true, mid := (w.st id).nextMid }
        let grown := upsertPrio (w.st id).prio msg
        let a := proceed
          { (w.st id) with prio := grown, nextMid := (w.st id).nextMid + 1 } (afterHead k)
        have hup := lane_upsert I w hLane id msg (by simpa [msg] using hdecl) (by simp [msg])
        have hok : (laneLabels a.prio).Nodup ∧
            ∀ m ∈ a.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id) := by
          simpa [a, proceed_prio] using hup
        have hstep : execRun I w id (w.st id) k = setActor w id a := by
          simp [execRun, hgo, hrest, hany, hlt, a, grown, msg]
        rw [hstep]
        exact lane_set I w hLane id a hok
      · have hfull : ¬ prioLoad (w.st id).prio < capPrio I.desc w.N id := hlt
        simp [execRun, hgo, hrest, hany, hfull]
        exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
    · simp [execRun, hgo, hrest, hany]
      exact lane_same I w _ hLane (fun i => by
        by_cases hi : i = id
        · simp [setActor, hi, proceed_prio]
        · simp [setActor, hi])
  · have hgo : ((w.st id).life == .alive) = false := by simpa [beq_iff_eq] using hlive
    simp [execRun, hgo]
    exact hLane

theorem credit_prio (w : World) (dst : String) (sender i : InstId) :
    ((creditSender w dst sender).st i).prio = (w.st i).prio :=
  (credit_life w dst sender i).2.2.2

theorem refund_prio (w : World) (dst : String) (ms : List Msg) (i : InstId) :
    ((refundMsgs w dst ms).st i).prio = (w.st i).prio :=
  (refund_life w dst ms i).2.2.2

theorem refundP_prio (w : World) (dst : String) (ps : List Parked) (i : InstId) :
    ((refundParked w dst ps).st i).prio = (w.st i).prio :=
  (refundP_life w dst ps i).2.2.2

theorem release_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (a : Actor) :
    PrioDeclared I (releaseWorld I.desc w id a) := by
  unfold releaseWorld
  let w1 := readCells I.desc w id
  let w2 := refundMsgs w1 (tname id) a.box
  let w3 := refundParked w2 (tname id) a.parked
  let w4 := releaseOutbound w3 id
  have h1 (i : InstId) : (w1.st i).prio = (w.st i).prio := by
    simpa [w1] using congrArg (fun b : Actor => b.prio) (readCells_st I.desc w id i)
  have h2 (i : InstId) : (w2.st i).prio = (w1.st i).prio := refund_prio w1 (tname id) a.box i
  have h3 (i : InstId) : (w3.st i).prio = (w2.st i).prio := refundP_prio w2 (tname id) a.parked i
  have h4 (i : InstId) : (w4.st i).prio = (w3.st i).prio := (releaseOutbound_prio w3 id i).1
  have hbase : PrioDeclared I w4 :=
    lane_same I w w4 hLane (fun i => (h4 i).trans ((h3 i).trans ((h2 i).trans (h1 i))))
  let dead : Actor :=
    { w4.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hempty : (laneLabels dead.prio).Nodup ∧
      ∀ m ∈ dead.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id) := by
    simp [dead, laneLabels]
  have hdead := lane_set I w4 hbase id dead hempty
  exact lane_same I _ _ hdead (fun i => (releaseParked_prio (setActor w4 id dead) id a.parked i).1)

theorem tombstone_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (child : InstId) :
    PrioDeclared I (enqueueTombstone I.desc w child) := by
  simp only [enqueueTombstone]
  split
  · exact hLane
  · next parent _hp =>
    let msg := tombstoneMsg I.desc (w.st parent) child
    by_cases hlive : (w.st parent).life = .alive
    · have hgo : ((w.st parent).life != .alive) = false := by simp [hlive, bne]
      simp only [hgo, ite_false]
      by_cases hlab : (msg.label == "") = true
      · simp only [msg, hlab, ite_true]
        exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
      · have hlabf : (msg.label == "") = false := by simpa [Bool.not_eq_true] using hlab
        simp only [msg, hlabf, ite_false]
        unfold offerPrio
        by_cases hfull : decide (prioLoad (w.st parent).prio >= capPrio I.desc w.N parent) = true
        · simp [hfull]
          exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
        · have hempty : decide (prioLoad (w.st parent).prio >= capPrio I.desc w.N parent) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp only [hempty, ite_false]
          have hord : msg.tombstone = true := by simp [msg, tombstoneMsg]
          have hlabels : laneLabels ((w.st parent).prio ++ [msg]) = laneLabels (w.st parent).prio := by
            simp [laneLabels, hord]
          have hok : (laneLabels ((w.st parent).prio ++ [msg])).Nodup ∧
              ∀ m ∈ (w.st parent).prio ++ [msg],
                m.tombstone = true ∨ m.label ∈ prioLabels I (tname parent) := by
            refine ⟨by simpa [hlabels] using (hLane parent).1, ?_⟩
            intro m hm
            simp [List.mem_append] at hm
            cases hm with
            | inl hold => exact (hLane parent).2 m hold
            | inr hnew =>
              cases hnew
              exact Or.inl hord
          simpa [msg, setActor] using
            lane_set I w hLane parent
              { (w.st parent) with prio := (w.st parent).prio ++ [msg], nextMid := (w.st parent).nextMid + 1 } hok
    · cases hlife : (w.st parent).life with
      | alive => exact absurd hlife hlive
      | absent =>
        simp [hlife, bne]
        exact hLane
      | dead =>
        simp [hlife, bne]
        exact hLane

theorem seal_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (a : Actor) :
    PrioDeclared I (sealActor I.desc w id a) := by
  simp only [sealActor]
  exact tombstone_lane I _ (release_lane I w hLane id a) id

theorem shutdown_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) :
    PrioDeclared I (shutdownActor I.desc w id) := by
  unfold shutdownActor
  split
  · exact seal_lane I w hLane id (w.st id)
  · exact hLane

theorem sealBranch_lane (fuel : Nat) (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) :
    PrioDeclared I (sealBranch fuel I.desc w id) := by
  induction fuel generalizing w id with
  | zero => simpa [sealBranch] using hLane
  | succ fuel ih =>
    simp only [sealBranch]
    suffices ∀ (ids : List InstId) (w0 : World), PrioDeclared I w0 →
        PrioDeclared I (ids.foldl (fun acc child =>
          if isChild acc id child then sealBranch fuel I.desc acc child else acc) w0) by
      have hfold := this w.roster w hLane
      split
      · exact release_lane I _ hfold id _
      · exact hfold
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hch : isChild w0 id c = true
      · simp only [hch, ite_true]
        exact ihf _ (ih w0 h0 c)
      · have hf : isChild w0 id c = false := by
          cases hb : isChild w0 id c with
          | false => rfl
          | true => exact absurd hb hch
        simp only [hf, ite_false]
        exact ihf w0 h0

theorem drop_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) :
    PrioDeclared I (dropDescendants I.desc w id) := by
  unfold dropDescendants
  suffices ∀ (ids : List InstId) (w0 : World), PrioDeclared I w0 →
      PrioDeclared I (ids.foldl (fun acc child =>
        if isChild acc id child then sealBranch w.roster.length I.desc acc child else acc) w0) by
    exact this w.roster w hLane
  intro ids
  induction ids with
  | nil => intro w0 h0; simpa using h0
  | cons c ids ih =>
    intro w0 h0
    simp only [List.foldl_cons]
    by_cases hch : isChild w0 id c = true
    · simp only [hch, ite_true]
      exact ih _ (sealBranch_lane w.roster.length I w0 h0 c)
    · have hf : isChild w0 id c = false := by
        cases hb : isChild w0 id c with
        | false => rfl
        | true => exact absurd hb hch
      simp only [hf, ite_false]
      exact ih w0 h0

theorem abortChildren_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (parent : InstId) :
    PrioDeclared I (abortChildren I.desc w parent) := by
  unfold abortChildren
  suffices ∀ (ids : List InstId) (w0 : World), PrioDeclared I w0 →
      PrioDeclared I (ids.foldl (fun acc child =>
        if isChild acc parent child && (acc.st child).life == .alive then
          shutdownActor I.desc (dropDescendants I.desc acc child) child
        else acc) w0) by
    exact this w.roster w hLane
  intro ids
  induction ids with
  | nil => intro w0 h0; simpa using h0
  | cons c ids ih =>
    intro w0 h0
    simp only [List.foldl_cons]
    by_cases hch : (isChild w0 parent c && (w0.st c).life == .alive) = true
    · simp only [hch, ite_true]
      exact ih _ (shutdown_lane I _ (drop_lane I w0 h0 c) c)
    · have hf : (isChild w0 parent c && (w0.st c).life == .alive) = false := by
        cases hb : isChild w0 parent c && (w0.st c).life == .alive with
        | false => rfl
        | true => exact absurd hb hch
      simp only [hf, ite_false]
      exact ih w0 h0

/-- Descendants are sealed, then the stage itself. A tombstone that does not fit
is `crashWorld`, and a crash keeps the priority lists. -/
theorem terminate_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) :
    PrioDeclared I (terminateStage I.desc w id (w.st id)) := by
  simp only [terminateStage]
  exact shutdown_lane I _ (drop_lane I w hLane id) id

theorem deliver_prio (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg) (w1 : World)
    (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.prio = a.prio := by
  simp only [deliver] at h
  split at h
  · cases h
  · split at h
    · cases h
      rfl
    · split at h
      · split at h
        · cases h
        · cases h
          rfl
      · split at h
        · cases h
        · cases h
          split <;> rfl

theorem lane_finish (I : Impl) (w w' : World) (id : InstId) (hLane : PrioDeclared I w)
    (h : finishWait I w id = some w') : PrioDeclared I w' := by
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  exact lane_same I w _ hLane (fun i => by
    by_cases hi : i = id <;> simp [setActor, proceed_prio, hi])

/-- `placePeer` adds one actor whose priority lane is empty. `next` records the
fresh key and does not write a priority list. The bindings are `let`: Lean
4.35 has no `set` tactic. `readCells` is the last step and does not touch lanes. -/
theorem place_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (template : String)
    (k : Nat) (initial : String) (parent : Option InstId) (next : World → World)
    (hnext : ∀ (w0 : World) (i : InstId), ((next w0).st i).prio = (w0.st i).prio) :
    PrioDeclared I (placePeer I w template k initial parent next) := by
  unfold placePeer
  let id := InstId.peer template k (maxGen w template k)
  let born := { bornActor I.desc w template k initial with parent := parent }
  have hp : born.prio = [] := by simp [born, bornActor, withKeyTokens]
  have hros : PrioDeclared I { w with roster := w.roster ++ [id] } :=
    lane_same I w _ hLane (fun _ => rfl)
  have hN : PrioDeclared I (next { w with roster := w.roster ++ [id] }) :=
    lane_same I _ _ hros (fun i => hnext _ i)
  have hempty : (laneLabels born.prio).Nodup ∧
      ∀ m ∈ born.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id) := by
    rw [hp]
    simp [laneLabels]
  have hset := lane_set I (next { w with roster := w.roster ++ [id] }) hN id born hempty
  -- `readCells` is the last step of `placePeer` and does not touch priority lists.
  refine lane_same I _ _ hset ?_
  intro i
  simpa using congrArg (fun b : Actor => b.prio)
    (readCells_st I.desc (setActor (next { w with roster := w.roster ++ [id] }) id born) id i)

theorem lane_spawn (I : Impl) (w w' : World) (template : String) (hLane : PrioDeclared I w)
    (h : spawn I w template = some w') : PrioDeclared I w' := by
  unfold spawn at h
  cases ht : templateOf I.desc template with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hmay : maySpawnRoot I.desc w template t = true
    · simp only [hmay, ite_true] at h
      cases hsup : t.supervisor with
      | some name =>
        simp only [hsup] at h
        let k := freshKey I.desc w t.subtree
        cases h
        exact place_lane I w hLane template k t.initial (some (InstId.core name))
          (fun w0 => { w0 with nextKey := fun s => if s = t.subtree then k + 1 else w0.nextKey s })
          (fun _ _ => rfl)
      | none =>
        by_cases hsub : (t.subtree == "") = true
        · simp only [hsup, hsub, ite_true] at h
          let k := w.nextIx template
          cases h
          exact place_lane I w hLane template k t.initial none
            (fun w0 => { w0 with nextIx := fun n => if n = template then k + 1 else w0.nextIx n })
            (fun _ _ => rfl)
        · have hf : (t.subtree == "") = false := by simpa [Bool.not_eq_true] using hsub
          simp only [hsup, hf, ite_false] at h
          let k := freshKey I.desc w t.subtree
          cases h
          exact place_lane I w hLane template k t.initial none
            (fun w0 => { w0 with nextKey := fun s => if s = t.subtree then k + 1 else w0.nextKey s })
            (fun _ _ => rfl)
    · have hf : maySpawnRoot I.desc w template t = false := by
        simpa [Bool.not_eq_true] using hmay
      simp [hf] at h

/-- Dropping one priority message leaves a declared lane. A tombstone is not a
label, so removing it does not change `laneLabels`. `List.Disjoint` takes the
two elements and then their membership proofs, and `simp` turns
`x ∈ pre ++ m :: suf` into `x ∈ pre ∨ x = m ∨ x ∈ suf`. -/
theorem lane_drop (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId)
    (pre : List Msg) (m : Msg) (suf : List Msg)
    (hp : (w.st id).prio = pre ++ m :: suf) :
    (laneLabels (pre ++ suf)).Nodup ∧
      ∀ x ∈ pre ++ suf, x.tombstone = true ∨ x.label ∈ prioLabels I (tname id) := by
  have hmem := (hLane id).2
  have hnd := (hLane id).1
  rw [hp] at hmem hnd
  refine ⟨?_, ?_⟩
  · by_cases ht : m.tombstone = true
    · have heq : laneLabels (pre ++ m :: suf) = laneLabels (pre ++ suf) := by
        simp [laneLabels, List.filter_append, List.map_append, ht]
      simpa [heq] using hnd
    · have hf : m.tombstone = false := by
        cases hb : m.tombstone <;> simp_all
      have hfull : laneLabels (pre ++ m :: suf) =
          laneLabels pre ++ m.label :: laneLabels suf := by
        simp [laneLabels, List.filter_append, List.map_append, hf]
      have hshort : laneLabels (pre ++ suf) = laneLabels pre ++ laneLabels suf := by
        simp [laneLabels, List.filter_append, List.map_append]
      rw [hfull] at hnd
      rw [hshort]
      have hsplit := (List.nodup_append).1 hnd
      have hcons := (List.nodup_cons).1 hsplit.2.1
      refine (List.nodup_append).2 ⟨hsplit.1, hcons.2, ?_⟩
      intro x hx y hy
      exact hsplit.2.2 x hx y (List.mem_cons_of_mem _ hy)
  · intro x hx
    apply hmem x
    simp [List.mem_append] at hx ⊢
    cases hx with
    | inl h => exact Or.inl h
    | inr h => exact Or.inr (Or.inr h)

theorem lane_prio (I : Impl) (w w' : World) (id : InstId) (hLane : PrioDeclared I w)
    (h : receivePrio I w id = some w') : PrioDeclared I w' := by
  obtain ⟨m, pre, suf, w1, a1, _, _, hp, _, hdel, hw'⟩ := receivePrio_spec I w w' id h
  rw [hw']
  have hst (i : InstId) : (w1.st i).prio = (w.st i).prio := by
    simpa using congrArg (fun b : Actor => b.prio)
      (deliver_st I w id ({ (w.st id) with prio := pre ++ suf }) m w1 a1 i hdel)
  have hW : PrioDeclared I w1 := lane_same I w w1 hLane hst
  have hkeep := lane_drop I w hLane id pre m suf hp
  have ha : a1.prio = pre ++ suf := by
    simpa using deliver_prio I w id ({ (w.st id) with prio := pre ++ suf }) m w1 a1 hdel
  exact lane_set I w1 hW id a1 (by simpa [ha] using hkeep)

theorem lane_bulk (I : Impl) (w w' : World) (id : InstId) (hLane : PrioDeclared I w)
    (h : receiveBulk I w id = some w') : PrioDeclared I w' := by
  apply lane_same I w w' hLane
  intro i
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ p.msg w1 a1 i hdel
          have hp := deliver_prio I w id _ p.msg w1 a1 hdel
          have hset : ((setActor w1 id a1).st i).prio = (w.st i).prio := by
            by_cases hi : i = id
            · rw [hi]; simp [setActor, hp]
            · simp [setActor, hi, hst]
          by_cases hi : i = id
          · rw [hi]
            by_cases hs : id = p.sender
            · simp [setActor, hs, resume_prio, credit_prio, hp]
            · simp [setActor, hs, credit_prio, hp]
          · by_cases hs : i = p.sender
            · have hne : ¬ p.sender = id := fun h => hi (by simpa [h] using hs)
              simp [setActor, hi, hs, resume_prio, credit_prio]
              rw [if_neg hne]
              have hpri : (w1.st i).prio = (w.st i).prio := congrArg (·.prio) hst
              simpa [hs] using hpri
            · simp [setActor, hi, hs, credit_prio, hst]
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 i hdel
          have hp := deliver_prio I w id _ m w1 a1 hdel
          rw [credit_prio]
          by_cases hi : i = id
          · rw [hi]; simp [setActor, hp]
          · simp [setActor, hi, hst]
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hst := deliver_st I w id _ m w1 a1 i hdel
          have hp := deliver_prio I w id _ m w1 a1 hdel
          have hset : ((setActor w1 id admitted).st i).prio = (w.st i).prio := by
            by_cases hi : i = id
            · rw [hi]; simp [admitted, setActor, hp]
            · simp [admitted, setActor, hi, hst]
          by_cases hi : i = id
          · rw [hi]
            by_cases hs : id = p.sender
            · simp [setActor, admitted, hs, resume_prio, credit_prio, hp]
            · simp [setActor, admitted, hs, credit_prio, hp]
          · by_cases hs : i = p.sender
            · have hne : ¬ p.sender = id := fun h => hi (by simpa [h] using hs)
              simp [setActor, admitted, hi, hs, resume_prio, credit_prio]
              rw [if_neg hne]
              have hpri : (w1.st i).prio = (w.st i).prio := congrArg (·.prio) hst
              simpa [hs] using hpri
            · simp [setActor, admitted, hi, hs, credit_prio, hst]

theorem bulk_prio_eq (I : Impl) (w w' : World) (id i : InstId)
    (h : receiveBulk I w id = some w') : (w'.st i).prio = (w.st i).prio := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ p.msg w1 a1 i hdel
          have hp := deliver_prio I w id _ p.msg w1 a1 hdel
          have hset : ((setActor w1 id a1).st i).prio = (w.st i).prio := by
            by_cases hi : i = id
            · rw [hi]; simp [setActor, hp]
            · simp [setActor, hi, hst]
          by_cases hi : i = id
          · rw [hi]
            by_cases hs : id = p.sender
            · simp [setActor, hs, resume_prio, credit_prio, hp]
            · simp [setActor, hs, credit_prio, hp]
          · by_cases hs : i = p.sender
            · have hne : ¬ p.sender = id := fun h => hi (by simpa [h] using hs)
              simp [setActor, hi, hs, resume_prio, credit_prio]
              rw [if_neg hne]
              have hpri : (w1.st i).prio = (w.st i).prio := congrArg (·.prio) hst
              simpa [hs] using hpri
            · simp [setActor, hi, hs, credit_prio, hst]
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 i hdel
          have hp := deliver_prio I w id _ m w1 a1 hdel
          rw [credit_prio]
          by_cases hi : i = id
          · rw [hi]; simp [setActor, hp]
          · simp [setActor, hi, hst]
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hst := deliver_st I w id _ m w1 a1 i hdel
          have hp := deliver_prio I w id _ m w1 a1 hdel
          have hset : ((setActor w1 id admitted).st i).prio = (w.st i).prio := by
            by_cases hi : i = id
            · rw [hi]; simp [admitted, setActor, hp]
            · simp [admitted, setActor, hi, hst]
          by_cases hi : i = id
          · rw [hi]
            by_cases hs : id = p.sender
            · simp [setActor, admitted, hs, resume_prio, credit_prio, hp]
            · simp [setActor, admitted, hs, credit_prio, hp]
          · by_cases hs : i = p.sender
            · have hne : ¬ p.sender = id := fun h => hi (by simpa [h] using hs)
              simp [setActor, admitted, hi, hs, resume_prio, credit_prio]
              rw [if_neg hne]
              have hpri : (w1.st i).prio = (w.st i).prio := congrArg (·.prio) hst
              simpa [hs] using hpri
            · simp [setActor, admitted, hi, hs, credit_prio, hst]

/-- A subtree kill empties the priority lane of each member it removes and leaves every other lane. -/
theorem killSubtree_lane (I : Impl) (w : World) (sub : String) (key : Nat) (hLane : PrioDeclared I w) :
    PrioDeclared I (killSubtree w I.desc sub key) := by
  intro i
  by_cases hlive : ((killSubtree w I.desc sub key).st i).life = .alive
  · have hp := (killSubtree_if_alive w I.desc sub key i hlive).2.2.1
    simpa [hp] using hLane i
  · by_cases hwas : (w.st i).life = .alive
    · have hp := (killSubtree_died w I.desc sub key i hwas hlive).2.2.2.2.1
      simp [hp, laneLabels]
    · have hp := (killSubtree_if_dead w I.desc sub key i hwas).2.2.1
      simpa [hp] using hLane i

theorem commit_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (next : Actor)
    (hp : next.prio = (w.st id).prio) : PrioDeclared I (commitCont w id next) := by
  unfold commitCont
  split
  · exact hLane
  · exact lane_same I w _ hLane (fun i => by
      by_cases hi : i = id
      · simp [setActor, hi, hp]
      · simp [setActor, hi])

theorem born_lane (I : Impl) (w : World) (hLane : PrioDeclared I w) (id : InstId) (a : Actor)
    (hp : a.prio = []) : PrioDeclared I (admitBorn I w id a) := by
  have hros : PrioDeclared I { w with roster := w.roster ++ [id] } :=
    lane_same I w _ hLane (fun _ => rfl)
  have hempty : (laneLabels a.prio).Nodup ∧
      ∀ m ∈ a.prio, m.tombstone = true ∨ m.label ∈ prioLabels I (tname id) := by
    simp [hp, laneLabels]
  have hset := lane_set I { w with roster := w.roster ++ [id] } hros id a hempty
  unfold admitBorn
  exact lane_same I _ _ hset (fun i => by simp [readCells_st])

theorem spawnChild_lane (I : Impl) (w : World) (hLane : PrioDeclared I w)
    (parent : InstId) (child : String) (w' : World)
    (h : spawnChild I w parent child = some w') : PrioDeclared I w' := by
  have host : InstId := parent
  unfold spawnChild at h
  cases ht : templateOf I.desc child with
  | none => simp [ht] at h
  | some t =>
    simp only [ht] at h
    by_cases hsup :
        (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
          (w.st parent).life == .alive) = true
    · simp only [hsup, ite_true] at h
      cases parent with
      | core _ => simp at h
      | peer name key gen =>
        by_cases hslot : slotRespawnBlocked I.desc w (InstId.peer name key gen) child key = true
        · simp [hslot] at h
          cases h
          exact hLane
        · have hf : slotRespawnBlocked I.desc w (InstId.peer name key gen) child key = false := by
            simpa [Bool.not_eq_true] using hslot
          simp [hf] at h
          cases h
          exact born_lane I w hLane (InstId.peer child key (maxGen w child key))
            { bornActor I.desc w child key t.initial with parent := some (InstId.peer name key gen) }
            (by simp [bornActor, withKeyTokens])
    · have hf :
          (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent) &&
            (w.st parent).life == .alive) = false := by
        simpa [Bool.not_eq_true] using hsup
      simp only [hf, ite_false] at h
      by_cases hpeer : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = true
      · simp [hpeer] at h
        cases h
        exact hLane
      · have hf2 : (t.multiplicity == .perPeer && supNamed t.supervisor (tname parent)) = false := by
          simpa [Bool.not_eq_true] using hpeer
        simp [hf2] at h

theorem lane_exec (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (id : InstId) (k : Cont)
    (hph : (w.st id).phase = .run k) : PrioDeclared I (execRun I w id (w.st id) k) := by
  by_cases hlive : (w.st id).life = .alive
  · have hgo : ((w.st id).life == .alive) = true := by simpa [beq_iff_eq] using hlive
    cases hk : k with
    | mk rest toState replyTo na nto nout tna tto ttout tfull tgone =>
    cases hrest : rest with
    | nil =>
      exact lane_same I w _ hLane (fun i => by
        by_cases hi : i = id <;> simp [execRun, hrest, hgo, setActor, hi])
    | cons e tail =>
      cases e with
      | selfSchedule label =>
        have hsched := lane_schedule I hL hG w hLane hS id label tail k hph (by rw [hk]; exact hrest)
        rw [hk] at hsched
        rw [hrest] at hsched
        exact hsched
      | send dst label hint =>
        simp [execRun, hrest, hgo]
        cases hr : route w I.desc id dst with
        | none =>
          exact lane_same I w _ hLane (fun i => by
            by_cases hi : i = id <;> simp [hr, setActor, proceed_prio, hi])
        | some dstId =>
          simp [hr]
          exact lane_same I w _ hLane (fun i => enqueue_prio w I.desc id dstId _ false _ i)
      | call dst label hint na to =>
        simp [execRun, hrest, hgo]
        cases hr : resolveId I.desc w id dst with
        | none =>
          exact lane_same I w _ hLane (fun i => by
            by_cases hi : i = id <;>
              simp [hr, noteStale_st, setActor, finishCall, issueCall, proceed_prio, hi])
        | some dstId =>
          simp [hr]
          exact lane_same I w _ hLane (fun i => enqueue_prio w I.desc id dstId _ true _ i)
      | internal =>
        exact lane_same I w _ hLane (fun i => by
          by_cases hi : i = id <;> simp [execRun, hrest, hgo, setActor, hi])
      | peer onTimeout =>
        exact lane_same I w _ hLane (fun i => by
          by_cases hi : i = id <;> simp [execRun, hrest, hgo, setActor, hi])
      | trySend dst label hint onFull onGone =>
        exact lane_same I w _ hLane (fun i => by
          simp [execRun, hrest, hgo]
          cases hr : route w I.desc id dst with
          | none =>
            by_cases hi : i = id <;> simp [hr, setActor, proceed_prio, hi]
          | some dstId =>
            simp [hr]
            split
            · exact enqueue_prio w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false _ i
            · split
              · by_cases hi : i = id <;> simp [setActor, proceed_prio, hi]
              · by_cases hi : i = id <;> simp [setActor, proceed_prio, hi])
      | reply =>
        exact lane_same I w _ hLane (fun i => by
          simp [execRun, hrest, hgo, performReply]
          cases hto : replyTo with
          | none =>
            by_cases hi : i = id <;> simp [hto, hk, setActor, proceed_prio, hi]
          | some caller =>
            cases hcall : (w.st caller).phase with
            | awaitReply dst ck =>
              by_cases hd : dst = id
              · by_cases howe : (w.st id).oweId = some (w.st caller).waitId
                · simp [hto, hcall, hd, howe, setActor, finishCall, proceed_prio]
                  by_cases hi : i = id
                  · by_cases hc : i = caller
                    · have hid : id = caller := hi.symm.trans hc
                      simp [hi, hid, setActor, finishCall, proceed_prio]
                    · have hne : id ≠ caller := fun h => hc (hi.trans h)
                      simp [hi, hne, setActor, finishCall, proceed_prio]
                  · by_cases hc : i = caller
                    · have hne : caller ≠ id := fun h => hi (hc.trans h)
                      simp [hi, hc, hne, setActor, finishCall, proceed_prio]
                    · simp [hi, hc, setActor]
                · simp [hto, hcall, hd, howe, hk, setActor, proceed_prio]
                  by_cases hi : i = id <;> simp [hi, setActor, proceed_prio]
              · simp [hto, hcall, hd, hk, setActor, proceed_prio]
                by_cases hi : i = id <;> simp [hi, setActor, proceed_prio]
            | idle =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi]
            | run _ =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi]
            | awaitEffect _ =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi]
            | awaitPeer _ =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi]
            | parked _ _ _ =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi]
            | crashed =>
              by_cases hi : i = id <;> simp [hto, hcall, hk, setActor, proceed_prio, hi])
      | cell dst label value =>
        have hdecl : label ∈ prioLabels I dst := by
          have hcar : carried ((w.st id).phase) = some (.cell dst label value :: tail) := by
            rw [hk] at hph
            simp [carried, hph, hrest]
          exact wake_declared I w hS id _ hcar dst label (cell_head_label dst label value tail)
        let base := setCell w dst label { value := max (w.cell dst label).value value, dirty := true }
        let stepped := setActor base id (proceed (base.st id) (afterHead k))
        have hbase := lane_same I w base hLane (fun _ => by simp [base, setCell])
        have hstepL : PrioDeclared I stepped := by
          apply lane_set I base hbase id _
          simpa [stepped, proceed_prio, base, setCell] using hLane id
        have hcont : k = ⟨.cell dst label value :: tail, toState, replyTo, na, nto, nout, tna, tto, ttout, tfull, tgone⟩ := by
          simp [hk, hrest]
        rw [← hcont]
        have hrk : k.rest = .cell dst label value :: tail := by simp [hcont]
        simp only [execRun, hrk, hgo]
        cases hdirty : (w.cell dst label).dirty
        · simp [hdirty, base, stepped]
          rw [wakeReaders]
          exact wakes_lane I (readersOf stepped dst) stepped hstepL dst label id (fun r hr =>
            ⟨reader_name _ _ _ hr, by simpa [reader_name _ _ _ hr] using hdecl⟩)
        · simp [hdirty]
          apply lane_set
          · exact lane_same I w _ hLane (fun _ => rfl)
          · simpa [proceed_prio, setCell] using hLane id
      | abort =>
        have hcont : k = ⟨.abort :: tail, toState, replyTo, na, nto, nout, tna, tto, ttout, tfull, tgone⟩ := by
          simp [hk, hrest]
        rw [← hcont]
        have hrk : k.rest = .abort :: tail := by simp [hcont]
        simp only [execRun, hrk, hgo, ite_true]
        exact commit_lane I _ (abortChildren_lane I w hLane id) id
          (proceed ((abortChildren I.desc w id).st id) (afterHead k))
          (by simp [proceed_prio])
      | spawn child =>
        have hcont : k = ⟨.spawn child :: tail, toState, replyTo, na, nto, nout, tna, tto, ttout, tfull, tgone⟩ := by
          simp [hk, hrest]
        rw [← hcont]
        have hrk : k.rest = .spawn child :: tail := by simp [hcont]
        simp only [execRun, hrk, hgo, ite_true]
        cases hs : spawnChild I w id child with
        | none =>
          simp [hs]
          exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
        | some w' =>
          simp [hs]
          exact commit_lane I w' (spawnChild_lane I w hLane id child w' hs) id
            (proceed (w'.st id) (afterHead k))
            (by simp [proceed_prio])
      | terminate =>
        have hcont : k = ⟨.terminate :: tail, toState, replyTo, na, nto, nout, tna, tto, ttout, tfull, tgone⟩ := by
          simp [hk, hrest]
        rw [← hcont]
        have hex : ∃ t, k.rest = .terminate :: t := by
          rw [hk, hrest]
          exact ⟨tail, rfl⟩
        rcases execRun_terminate I w id (w.st id) k hlive hex with
          hw | ⟨_, _, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, hw⟩ | ⟨_, _, _, _, _, _, _, hw⟩
        · rw [hw]
          exact lane_same I w _ hLane (fun i => (crash_queues w i).2.1)
        · rw [hw]
          exact shutdown_lane I w hLane id
        · rw [hw]
          exact terminate_lane I w hLane id
        · rw [hw]
          exact terminate_lane I w hLane id
  · have hdead : ((w.st id).life == .alive) = false := by simpa [beq_iff_eq] using hlive
    simp [execRun, hdead]
    exact hLane


theorem lane_head (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w w' : World) (id : InstId)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (h : execHead I w id = some w') : PrioDeclared I w' := by
  unfold execHead at h
  by_cases hlive : (w.st id).life = .alive
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      exact lane_exec I hL hG w hLane hS id k hph
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hlive] at h

theorem lane_apply (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (a : Action) (w w' : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (h : apply I a w = some w') : PrioDeclared I w' := by
  cases a with
  | callTimeout id =>
    exact lane_same I w w' hLane (fun i => callTimeout_prio w w' id i (by simpa [stepWorld] using stepOfApply h))
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress dst label =>
    exact lane_same I w w' hLane
      (fun i => (ingress_phase I w w' dst label i (by simpa [stepWorld] using stepOfApply h)).2.2.1)
  | recvBulk id => exact lane_bulk I w w' id hLane (by simpa [stepWorld] using stepOfApply h)
  | recvPrio id => exact lane_prio I w w' id hLane (by simpa [stepWorld] using stepOfApply h)
  | exec id => exact lane_head I hL hG w w' id hLane hS (by simpa [stepWorld] using stepOfApply h)
  | finish id => exact lane_finish I w w' id hLane (by simpa [stepWorld] using stepOfApply h)
  | spawn template => exact lane_spawn I w w' template hLane (by simpa [stepWorld] using stepOfApply h)

theorem lane_reachable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) : PrioDeclared I w := by
  induction hR with
  | init => exact lane_init I N
  | step w w' a prev h ih =>
    exact lane_apply I hL hG a w w' ih (prog_src_reachable I N w prev) h

/-- No actor is in the overflow phase. -/
def NoCrash (w : World) : Prop := ∀ i, (w.st i).phase ≠ .crashed

theorem proceed_not_crashed (a : Actor) (k : Cont) : (proceed a k).phase ≠ .crashed := by
  cases hk : k.rest <;> simp [proceed, hk] <;> intro h <;> cases h

theorem clearReply_not_crashed (caller : InstId) (ph : Phase) (h : ph ≠ .crashed) :
    clearReplyPhase caller ph ≠ .crashed := by
  intro hbad
  cases ph with
  | run _ => simp [clearReplyPhase] at hbad
  | parked _ _ _ => simp [clearReplyPhase] at hbad
  | awaitReply _ _ => simp [clearReplyPhase] at hbad
  | awaitEffect _ => simp [clearReplyPhase] at hbad
  | awaitPeer _ => simp [clearReplyPhase] at hbad
  | idle => simp [clearReplyPhase] at hbad
  | crashed => exact h rfl

theorem callTimeout_not_crashed (w w' : World) (id i : InstId) (h : callTimeout w id = some w')
    (hold : (w.st i).phase ≠ .crashed) : (w'.st i).phase ≠ .crashed := by
  cases callTimeout_view w w' id h with
  | await dst k _ hw =>
    rw [hw]
    by_cases hi : i = id
    · simp [setActor, hi, finishCall_phase]
      exact proceed_not_crashed _ _
    · simp [setActor, hi]
      by_cases hd : i = dst
      · simp [setActor, hd, detach_phase_owe]
        cases howe : ((w.st dst).oweId == some (w.st id).waitId) with
        | false =>
          have hneq : (w.st dst).oweId ≠ some (w.st id).waitId := by
            simpa [beq_iff_eq] using howe
          simpa [hneq, hd] using hold
        | true =>
          have heq : (w.st dst).oweId = some (w.st id).waitId := by
            simpa [beq_iff_eq] using howe
          simpa [heq, hd] using
            clearReply_not_crashed id (w.st dst).phase (by simpa [hd] using hold)
      · simpa [setActor, hd] using hold
  | park dst _ _ hw =>
    rw [hw]
    by_cases hi : i = id
    · simp [setActor, hi, finishCall_phase]
      exact proceed_not_crashed _ _
    · simp [setActor, hi, (refundCall_fields w id dst i).1]
      exact hold
  | peer _ _ hw =>
    rw [hw]
    by_cases hi : i = id
    · simp [setActor, hi]
      exact proceed_not_crashed _ _
    · simpa [setActor, hi] using hold

theorem set_not_crashed (w : World) (hpre : NoCrash w) (id : InstId) (a : Actor)
    (hp : a.phase ≠ .crashed) (i : InstId) :
    ((setActor w id a).st i).phase ≠ .crashed := by
  by_cases hi : i = id
  · rw [hi]
    simpa [setActor] using hp
  · simpa [setActor, hi] using hpre i

theorem resume_not_crashed (a : Actor) (b : Bool) (dst : InstId) (h : a.phase ≠ .crashed) :
    (resumeSender a b dst).phase ≠ .crashed := by
  cases hph : a.phase with
  | parked _ _ k =>
    cases b
    · cases hk : k.rest <;> simp [resumeSender, hph, hk, proceed] <;> intro hc <;> cases hc
    · simp [resumeSender, hph]
  | idle => simpa [resumeSender, hph] using h
  | run _ => simpa [resumeSender, hph] using h
  | awaitReply _ _ => simpa [resumeSender, hph] using h
  | awaitEffect _ => simpa [resumeSender, hph] using h
  | awaitPeer _ => simpa [resumeSender, hph] using h
  | crashed => exact False.elim (h hph)

theorem enqueue_not_crashed (w : World) (hpre : NoCrash w) (D : Description) (sender dst : InstId)
    (msg : Msg) (isCall : Bool) (k : Cont) (i : InstId) :
    ((enqueueOrPark w D sender dst msg isCall k).st i).phase ≠ .crashed := by
  by_cases hi : i = sender
  · rw [hi]
    cases isCall with
    | false =>
      unfold enqueueOrPark
      by_cases hlive : (w.st dst).life = .alive
      · simp [hlive]
        by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
        · simp [hroom]
          by_cases hsame : sender = dst
          · simp [hsame, setActor]
            exact proceed_not_crashed _ k
          · simp [hsame, setActor]
            exact proceed_not_crashed _ k
        · simp [hroom]
          by_cases hsame : sender = dst <;> simp [hsame, setActor]
      · simp [hlive, setActor]
        exact proceed_not_crashed _ k
    | true =>
      unfold enqueueOrPark
      by_cases hlive : (w.st dst).life = .alive
      · simp [hlive]
        by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
        · simp [hroom]
          by_cases hsame : sender = dst <;> simp [hsame, setActor]
        · simp [hroom]
          by_cases hsame : sender = dst <;> simp [hsame, setActor]
      · simp [hlive, setActor, finishCall, issueCall]
        exact proceed_not_crashed _ (selectCall k .notAdmitted)
  · simpa [enqueue_phase_other w D sender dst msg isCall k i hi] using hpre i

theorem deliver_not_crashed (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.phase ≠ .crashed := by
  simp only [deliver] at h
  split at h
  · cases h
  · split at h
    · cases h
      simp
    · split at h
      · split at h
        · cases h
        · cases h
          simp
      · split at h
        · cases h
        · cases h
          split <;> simp

theorem release_not_crashed (w : World) (hpre : NoCrash w) (id : InstId) (ps : List Parked)
    (i : InstId) : ((releaseParked w id ps).st i).phase ≠ .crashed := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using hpre i
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w hpre
    · rw [if_neg hskip]
      have hres := resume_not_crashed (w.st p.sender) false id (hpre p.sender)
      have hset : NoCrash (setActor w p.sender (resumeSender (w.st p.sender) false id)) := by
        intro j
        by_cases hj : j = p.sender
        · rw [hj]
          simpa [setActor] using hres
        · simpa [setActor, hj] using hpre j
      exact ih _ hset

theorem failWaiter_not_crashed (w : World) (dead i s : InstId) (h : (w.st s).phase ≠ .crashed) :
    ((failWaiter w dead i).st s).phase ≠ .crashed := by
  unfold failWaiter
  split
  · exact h
  · next _ =>
    -- A parked call stays until its deadline. Only a parked send is released.
    cases hph : (w.st i).phase with
    | parked d b k =>
      cases b with
      | true => simp [hph]; exact h
      | false =>
        by_cases hd : (d == dead) = true
        · simp [hph, hd, setActor]
          by_cases hs : s = i
          · rw [hs]
            simp [setActor]
            exact proceed_not_crashed _ k
          · simpa [setActor, hs] using h
        · have hf : (d == dead) = false := by simpa [Bool.not_eq_true] using hd
          simp [hph, hf]
          exact h
    | awaitReply _ _ => simp [hph]; exact h
    | idle => simp [hph]; exact h
    | run _ => simp [hph]; exact h
    | awaitEffect _ => simp [hph]; exact h
    | awaitPeer _ => simp [hph]; exact h
    | crashed => simp [hph]; exact h

theorem failFold_not_crashed (w : World) (dead : InstId) (ids : List InstId) (s : InstId)
    (h : (w.st s).phase ≠ .crashed) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase ≠ .crashed := by
  induction ids generalizing w with
  | nil => exact h
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (failWaiter_not_crashed w dead i s h)

/-- `releaseWorld` preserves `NoCrash`. The phase chain includes
`releaseOutbound`; stopping at `refundParked` does not match the definition. -/
theorem releaseWorld_not_crashed (I : Impl) (w : World) (id : InstId) (a : Actor)
    (hpre : NoCrash w) : NoCrash (releaseWorld I.desc w id a) := by
  intro i
  let w1 := readCells I.desc w id
  let w2 := refundMsgs w1 (tname id) a.box
  let w3 := refundParked w2 (tname id) a.parked
  let w4 := releaseOutbound w3 id
  have hpre4 : NoCrash w4 := by
    intro j
    have h1 : (w1.st j).phase = (w.st j).phase :=
      congrArg (fun b : Actor => b.phase) (readCells_st I.desc w id j)
    have h2 := phase_refund w1 (tname id) a.box j
    have h3 := phase_refundP w2 (tname id) a.parked j
    have h4 := releaseOutbound_phase w3 id j
    have heq : (w4.st j).phase = (w.st j).phase := by
      simpa [w1, w2, w3, w4] using h4.trans (h3.trans (h2.trans h1))
    rw [heq]
    exact hpre j
  let dead : Actor :=
    { w4.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hdead : NoCrash (setActor w4 id dead) := by
    intro j
    by_cases hj : j = id
    · rw [hj]
      simp [setActor, dead]
    · simpa [setActor, hj] using hpre4 j
  have hbody : releaseWorld I.desc w id a =
      releaseParked (setActor w4 id dead) id a.parked := by
    simp [releaseWorld, w1, w2, w3, w4, dead]
  rw [hbody]
  exact release_not_crashed (setActor w4 id dead) hdead id a.parked i

/-- `crashWorld` either leaves every phase uncrashed, or it turns a live roster
member into the crashed witness. An empty live set is the first case. The
branch is `if id ∈ roster`, so the proof uses `if_pos` on the membership
proof rather than on `decide`. -/
theorem crash_or (w : World) (hpre : NoCrash w) :
    NoCrash (crashWorld w) ∨ WorldCrashed (crashWorld w) := by
  by_cases hlive : ∃ id, id ∈ w.roster ∧ (w.st id).life = .alive
  · rcases hlive with ⟨id, hmem, hl⟩
    refine Or.inr ⟨id, ?_, ?_, ?_⟩
    · simpa [crashWorld] using hmem
    · simp [crashWorld, crashActor, hl, if_pos hmem]
    · simp [crashWorld, crashActor, hl, if_pos hmem]
  · refine Or.inl ?_
    intro i
    by_cases hmem : i ∈ w.roster
    · have hn : (w.st i).life ≠ .alive := by
        intro hl
        exact hlive ⟨i, hmem, hl⟩
      cases hl : (w.st i).life with
      | alive => exact absurd hl hn
      | absent =>
        simp [crashWorld, crashActor, hl, if_pos hmem]
        exact hpre i
      | dead =>
        simp [crashWorld, crashActor, hl, if_pos hmem]
        exact hpre i
    · simpa [crashWorld, if_neg hmem] using hpre i

/-- A tombstone either preserves `NoCrash` or crashes the world. An empty label
and a full priority lane are the crash arms; a dropped parent is the identity. -/
theorem tombstone_or (D : Description) (w : World) (hpre : NoCrash w) (child : InstId) :
    NoCrash (enqueueTombstone D w child) ∨ WorldCrashed (enqueueTombstone D w child) := by
  cases hparent : (w.st child).parent with
  | none =>
    simp only [enqueueTombstone, hparent]
    exact Or.inl hpre
  | some parent =>
    simp only [enqueueTombstone, hparent]
    let msg := tombstoneMsg D (w.st parent) child
    by_cases hl : (w.st parent).life = .alive
    · have hgo : ((w.st parent).life != .alive) = false := by simp [hl, bne]
      simp only [hgo, ite_false]
      by_cases hlab : (msg.label == "") = true
      · simp only [msg, hlab, ite_true]
        exact crash_or w hpre
      · have hlabf : (msg.label == "") = false := by simpa [Bool.not_eq_true] using hlab
        simp only [msg, hlabf, ite_false]
        unfold offerPrio
        by_cases hfull : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = true
        · simp only [hfull, ite_true]
          exact crash_or w hpre
        · have hempty : decide (prioLoad (w.st parent).prio >= capPrio D w.N parent) = false := by
            simpa [Bool.not_eq_true] using hfull
          simp only [hempty, ite_false]
          refine Or.inl ?_
          intro i
          by_cases hi : i = parent
          · rw [hi]
            simp [setActor]
            exact hpre parent
          · simpa [setActor, hi] using hpre i
    · cases hlife : (w.st parent).life with
      | alive => exact absurd hlife hl
      | absent =>
        simp [hlife, bne]
        exact Or.inl hpre
      | dead =>
        simp [hlife, bne]
        exact Or.inl hpre

theorem seal_or (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) (a : Actor) :
    NoCrash (sealActor I.desc w id a) ∨ WorldCrashed (sealActor I.desc w id a) := by
  simp only [sealActor]
  exact tombstone_or I.desc (releaseWorld I.desc w id a)
    (releaseWorld_not_crashed I w id a hpre) id

theorem shutdown_or (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) :
    NoCrash (shutdownActor I.desc w id) ∨ WorldCrashed (shutdownActor I.desc w id) := by
  unfold shutdownActor
  split
  · exact seal_or I w hpre id (w.st id)
  · exact Or.inl hpre

/-- `sealBranch` only calls `releaseWorld`. It does not enqueue a tombstone, so
it cannot crash. `w`, `id`, and `hpre` are reverted before induction: the
child of a recursive call is a different id, and `generalizing` left the
outer id fixed in the induction hypothesis. -/
theorem sealBranch_not_crashed (fuel : Nat) (I : Impl) (w : World) (id : InstId)
    (hpre : NoCrash w) : NoCrash (sealBranch fuel I.desc w id) := by
  revert w id hpre
  induction fuel with
  | zero =>
    intro w id hpre
    simpa [sealBranch] using hpre
  | succ fuel ih =>
    intro w id hpre
    unfold sealBranch
    let sealed := w.roster.foldl (fun acc child =>
      if isChild acc id child then sealBranch fuel I.desc acc child else acc) w
    have hfold : NoCrash sealed := by
      have : ∀ (ids : List InstId) (w0 : World), NoCrash w0 →
          NoCrash (ids.foldl (fun acc child =>
            if isChild acc id child then sealBranch fuel I.desc acc child else acc) w0) := by
        intro ids
        induction ids with
        | nil => intro w0 h0; simpa using h0
        | cons c ids ihf =>
          intro w0 h0
          simp only [List.foldl_cons]
          by_cases hgo : (isChild w0 id c) = true
          · simp only [hgo, ite_true]
            exact ihf _ (ih w0 c h0)
          · simp only [hgo, ite_false]
            exact ihf w0 h0
      exact this w.roster w hpre
    by_cases hgo : ((sealed.st id).life == .alive) = true
    · simp only [sealed, hgo, ite_true]
      exact releaseWorld_not_crashed I sealed id (sealed.st id) hfold
    · have hf : ((sealed.st id).life == .alive) = false := by simpa [Bool.not_eq_true] using hgo
      simp only [sealed, hf, ite_false]
      exact hfold

theorem drop_not_crashed (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) :
    NoCrash (dropDescendants I.desc w id) := by
  unfold dropDescendants
  have : ∀ (ids : List InstId) (w0 : World), NoCrash w0 →
      NoCrash (ids.foldl (fun acc child =>
        if isChild acc id child then sealBranch w.roster.length I.desc acc child else acc) w0) := by
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons c ids ih =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild w0 id c) = true
      · simp only [hgo, ite_true]
        exact ih _ (sealBranch_not_crashed w.roster.length I w0 c h0)
      · simp only [hgo, ite_false]
        exact ih w0 h0
  exact this w.roster w hpre

/-- `terminateStage` is a shutdown of the dropped tree. The tombstone on the
root can crash, so the result is a disjunction. -/
theorem terminate_not_crashed (I : Impl) (w : World) (id : InstId) (hpre : NoCrash w) :
    NoCrash (terminateStage I.desc w id (w.st id)) ∨
      WorldCrashed (terminateStage I.desc w id (w.st id)) := by
  simp only [terminateStage]
  exact shutdown_or I (dropDescendants I.desc w id) (drop_not_crashed I w hpre id) id

theorem killOne_not_crashed (w : World) (D : Description) (id s : InstId)
    (h : (w.st s).phase ≠ .crashed) : ((killOne w D id).st s).phase ≠ .crashed := by
  by_cases hs : s = id
  · rw [hs, (killOne_self w D id).2.1]
    simp
  · let w1 := readCells D w id
    have h1 : (w1.st s).phase = (w.st s).phase := congrArg (·.phase) (cellsSt D w id s)
    let w2 := refundMsgs w1 (tname id) (w.st id).box
    have h2 := (refundMsgs_rest w1 (tname id) (w.st id).box s).1
    let w3 := refundParked w2 (tname id) (w.st id).parked
    have h3 := (refundParked_rest w2 (tname id) (w.st id).parked s).1
    have hpre : (w3.st s).phase ≠ .crashed := by
      rw [h3, h2, h1]
      exact h
    have hfail := failFold_not_crashed w3 id w3.roster s hpre
    let w4 := failWaiters w3 id
    let w5 := forgetSender w4 id
    have h5 : (w5.st s).phase = (w4.st s).phase := (forget_stable w4 id s).1
    have hbody : killOne w D id =
        setActor w5 id { w5.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] } := by
      simp [killOne, w1, w2, w3, w4, w5, failWaiters, forgetSender]
    rw [hbody, setActor_other _ id s _ hs, h5]
    simpa [w4, failWaiters] using hfail

theorem killFold_not_crashed (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (s : InstId) (h : (w.st s).phase ≠ .crashed) :
    ((ids.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st s).phase ≠
      .crashed := by
  induction ids generalizing w with
  | nil => exact h
  | cons j ids ih =>
    simp only [List.foldl_cons]
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true]
      exact ih _ (killOne_not_crashed w D j s h)
    · have hf : (isMember D j sub key && (w.st j).life == .alive) = false := by
        cases hb : isMember D j sub key && (w.st j).life == .alive with
        | false => rfl
        | true => exact absurd hb hcond
      simp only [hf, ite_false]
      exact ih _ h

theorem killSubtree_not_crashed (w : World) (D : Description) (sub : String) (key : Nat) (s : InstId)
    (h : (w.st s).phase ≠ .crashed) :
    ((killSubtree w D sub key).st s).phase ≠ .crashed := by
  simpa [killSubtree, killMembers] using killFold_not_crashed w D sub key w.roster s h

theorem exec_not_crashed (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (hpre : NoCrash w) (id : InstId) (k : Cont)
    (hph : (w.st id).phase = .run k) (i : InstId) :
    ((execRun I w id (w.st id) k).st i).phase ≠ .crashed := by
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases hrest : rest with
    | nil =>
      have hp : ({ (w.st id) with phase := Phase.idle, typestate := toState }).phase ≠ .crashed := by
        simp
      simpa [execRun, hrest] using set_not_crashed w hpre id _ hp i
    | cons e tail =>
      cases e with
      | selfSchedule label =>
        exact schedule_not_crashed I hL hG w hLane hS id label tail toState replyTo
          (by simpa [hrest] using hph) hpre i
      | send dst label hint =>
        simp only [execRun, hrest]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact set_not_crashed w hpre id (proceed (w.st id) (afterHead
            ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) (proceed_not_crashed _ _) i
        | some dstId =>
          simpa [hr] using enqueue_not_crashed w hpre I.desc id dstId
            { label := label, sender := id, callFrom := none } false
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i
      | call dst label hint na to =>
        simp only [execRun, hrest]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact set_not_crashed w hpre id (proceed (w.st id) (afterHead
            ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) (proceed_not_crashed _ _) i
        | some dstId =>
          simpa [hr] using enqueue_not_crashed w hpre I.desc id dstId
            { label := label, sender := id, callFrom := some id } true
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i
      | internal =>
        have hp : ({ (w.st id) with phase := .awaitEffect (afterHead
            ⟨.internal :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }).phase ≠ .crashed := by
          simp
        simpa [execRun, hrest] using set_not_crashed w hpre id _ hp i
      | peer onTimeout =>
        have hp : ({ (w.st id) with phase := .awaitPeer (afterHead
            ⟨(.peer onTimeout) :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }).phase ≠ .crashed := by
          simp
        simpa [execRun, hrest] using set_not_crashed w hpre id _ hp i
      | trySend dst label hint onFull onGone =>
        simp only [execRun, hrest]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact set_not_crashed w hpre id (proceed (w.st id) (afterHead
            ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) (proceed_not_crashed _ _) i
        | some dstId =>
          simp only [hr]
          split
          · simpa using enqueue_not_crashed w hpre I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i
          · simpa using set_not_crashed w hpre id (proceed (w.st id) (afterHead
              ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) (proceed_not_crashed _ _) i
      | reply =>
        simp only [execRun, hrest]
        unfold performReply
        cases hto : replyTo with
        | none =>
          simpa [hto] using set_not_crashed w hpre id
            (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
            (proceed_not_crashed _ _) i
        | some caller =>
          cases hcall : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · let k' := afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩
              let resumed := proceed (w.st caller) ck
              let w1 := setActor w caller resumed
              have h1 : NoCrash w1 := set_not_crashed w hpre caller resumed (proceed_not_crashed _ _)
              simp only [hto, hcall, hd]
              rw [ite_true]
              exact set_not_crashed
                (setActor w caller (proceed (w.st caller) ck))
                (by simpa [w1, resumed] using h1) id
                (proceed ((setActor w caller (proceed (w.st caller) ck)).st id)
                  (afterHead { rest := .reply :: tail, toState := toState, replyTo := some caller }))
                (proceed_not_crashed _ _) i
            · simpa [hto, hcall, hd] using set_not_crashed w hpre id
                (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
                (proceed_not_crashed _ _) i
          | idle =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
          | run _ =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
          | awaitEffect _ =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
          | awaitPeer _ =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
          | parked _ _ _ =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
          | crashed =>
            simpa [hto, hcall] using set_not_crashed w hpre id
              (proceed (w.st id) (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩))
              (proceed_not_crashed _ _) i
      | cell dst label value =>
        let k' := afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩
        let base := setCell w dst label { value := max (w.cell dst label).value value, dirty := true }
        let stepped := setActor base id (proceed (base.st id) k')
        have hbase : NoCrash base := by
          intro j
          simpa [base, setCell] using hpre j
        have hstep : NoCrash stepped :=
          set_not_crashed base hbase id (proceed (base.st id) k') (proceed_not_crashed _ _)
        simp only [execRun, hrest]
        cases hdirty : (w.cell dst label).dirty
        · show ((wakeReaders I.desc stepped dst label id).st i).phase ≠ .crashed
          simp only [wakeReaders]
          rw [wakes_phase (readersOf stepped dst) I.desc stepped dst label id i]
          exact hstep i
        · show (stepped.st i).phase ≠ .crashed
          exact hstep i
      | terminate =>
        rcases execRun_terminate I w id (w.st id) tail toState replyTo with
          hw | ⟨_, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, _, hw⟩
        · rw [hw]
          exact hpre i
        · rw [hw]
          exact releaseWorld_not_crashed I w id (w.st id) hpre i
        · rw [hw]
          exact terminate_not_crashed I w id hpre i

theorem head_not_crashed (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (w : World)
    (hLane : PrioDeclared I w) (hS : ProgSrc I w) (hpre : NoCrash w) (id : InstId) (w' : World)
    (h : execHead I w id = some w') : NoCrash w' := by
  intro i
  unfold execHead at h
  by_cases hlive : (w.st id).life = .alive
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      exact exec_not_crashed I hL hG w hLane hS hpre id k hph i
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hlive] at h

theorem finish_not_crashed (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) (w' : World)
    (h : finishWait I w id = some w') : NoCrash w' := by
  intro i
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  exact set_not_crashed w hpre id (proceed (w.st id) _) (proceed_not_crashed _ _) i

theorem spawn_not_crashed (I : Impl) (w : World) (hpre : NoCrash w) (template : String) (w' : World)
    (h : spawn I w template = some w') : NoCrash w' := by
  intro i
  unfold spawn at h
  split at h
  · cases h
  · next t ht =>
    split at h
    · cases h
      let nid := InstId.peer template (w.nextIx template)
      let wR : World := ({ w with roster := w.roster ++ [nid], nextIx := fun n => if n = template then w.nextIx n + 1 else w.nextIx n } : World)
      have hR : NoCrash wR := by
        intro j
        simpa [wR] using hpre j
      let born : Actor := withTokens I.desc template
        { life := .alive, typestate := t.initial, phase := .idle, box := [], prio := [], parked := [],
          tokens := fun _ => 0 }
      have hp : born.phase ≠ .crashed := by simp [born, withTokens]
      have hborn : NoCrash (setActor wR nid born) := set_not_crashed wR hR nid born hp
      have hs := readCells_st I.desc (setActor wR nid born) nid i
      show ((readCells I.desc (setActor wR nid born) nid).st i).phase ≠ .crashed
      simpa [hs] using hborn i
    · cases h

theorem prio_not_crashed (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) (w' : World)
    (h : receivePrio I w id = some w') : NoCrash w' := by
  intro i
  unfold receivePrio at h
  cases hprio : (w.st id).prio with
  | nil => simp [hprio] at h
  | cons m ms =>
    simp [hprio] at h
    split at h
    · simp at h
    · next w1 a1 hdel =>
      cases h.2
      have hst := deliver_st I w id _ m w1 a1 i hdel
      have hp := deliver_not_crashed I w id _ m w1 a1 hdel
      by_cases hi : i = id
      · rw [hi]
        simpa [setActor] using hp
      · simpa [setActor, hi, hst] using hpre i

theorem bulk_not_crashed (I : Impl) (w : World) (hpre : NoCrash w) (id : InstId) (w' : World)
    (h : receiveBulk I w id = some w') : NoCrash w' := by
  intro i
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hp := deliver_not_crashed I w id _ p.msg w1 a1 hdel
          have hinner : NoCrash (creditLive (setActor w1 id a1) (tname id) p.msg.sender) := by
            intro j
            rw [phase_credit]
            by_cases hj : j = id
            · rw [hj]
              simpa [setActor] using hp
            · have hst := deliver_st I w id _ p.msg w1 a1 j hdel
              simpa [setActor, hj, hst] using hpre j
          by_cases hs : i = p.sender
          · rw [hs]
            simpa [setActor] using resume_not_crashed _ _ _ (hinner p.sender)
          · simpa [setActor, hs] using hinner i
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hp := deliver_not_crashed I w id _ m w1 a1 hdel
          rw [phase_credit]
          by_cases hi : i = id
          · rw [hi]
            simpa [setActor] using hp
          · have hst := deliver_st I w id _ m w1 a1 i hdel
            simpa [setActor, hi, hst] using hpre i
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hp := deliver_not_crashed I w id _ m w1 a1 hdel
          have hadm : admitted.phase = a1.phase := by simp [admitted]
          have hinner : NoCrash (creditLive (setActor w1 id admitted) (tname id) m.sender) := by
            intro j
            rw [phase_credit]
            by_cases hj : j = id
            · rw [hj]
              simpa [setActor, hadm] using hp
            · have hst := deliver_st I w id _ m w1 a1 j hdel
              simpa [setActor, admitted, hj, hst] using hpre j
          by_cases hs : i = p.sender
          · rw [hs]
            simpa [setActor] using resume_not_crashed _ _ _ (hinner p.sender)
          · simpa [setActor, hs] using hinner i

theorem apply_not_crashed (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (a : Action)
    (w w' : World) (hpre : NoCrash w) (hLane : PrioDeclared I w) (hS : ProgSrc I w)
    (h : apply I a w = some w') : NoCrash w' := by
  cases a with
  | callTimeout id =>
    intro i
    exact callTimeout_not_crashed w w' id i (by simpa [stepWorld] using stepOfApply h) (hpre i)
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress dst label =>
    intro i
    simpa [(ingress_phase I w w' dst label i (by simpa [stepWorld] using stepOfApply h)).1] using hpre i
  | recvBulk id => exact bulk_not_crashed I w hpre id w' (by simpa [stepWorld] using stepOfApply h)
  | recvPrio id => exact prio_not_crashed I w hpre id w' (by simpa [stepWorld] using stepOfApply h)
  | exec id => exact head_not_crashed I hL hG w hLane hS hpre id w' (by simpa [stepWorld] using stepOfApply h)
  | finish id => exact finish_not_crashed I w hpre id w' (by simpa [stepWorld] using stepOfApply h)
  | spawn template => exact spawn_not_crashed I w hpre template w' (by simpa [stepWorld] using stepOfApply h)

theorem fold_read_st (D : Description) (ids : List InstId) (w : World) (i : InstId) :
    ((ids.foldl (fun w id => readCells D w id) w).st i) = w.st i := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    exact (ih (readCells D w j)).trans (readCells_st D w j i)

theorem init_not_crashed (I : Impl) (N : Nat) : NoCrash (initWorld I N) := by
  intro i
  have hidle : ((initWorld I N).st i).phase = .idle := by
    unfold initWorld
    rw [fold_read_st]
    cases hb : (coreRoster I.desc).contains i with
    | false =>
      show (if (coreRoster I.desc).contains i = true then initActor I.desc i else absentActor).phase = .idle
      rw [hb]
      simp [absentActor]
    | true =>
      show (if (coreRoster I.desc).contains i = true then initActor I.desc i else absentActor).phase = .idle
      rw [hb]
      unfold initActor
      cases templateOf I.desc (tname i) with
      | none => simp [absentActor]
      | some _ => simp [withTokens]
  simp [hidle]

/-- A reachable world is not in the overflow phase, or the roster has crashed.
Overflow and a permanent core's `terminate` are `crashWorld`, which is the
second disjunct. `NoCrash` alone is not an invariant. -/
theorem reachable_not_crashed (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) : NoCrash w ∨ WorldCrashed w := by
  induction hR with
  | init => exact Or.inl (init_not_crashed I N)
  | step w w' a prev happ ih =>
    cases ih with
    | inl hpre =>
      exact Or.inl (apply_not_crashed I hL hG a w w' hpre
        (lane_reachable I hL hG N w prev) (prog_src_reachable I N w prev) happ)
    | inr h =>
      -- `h` is `WorldCrashed w`. A later step is not yet shown to stay crashed.
      exact Or.inr (h ▸ rfl)

theorem proceed_wait_none (a : Actor) (k : Cont) : waitKind (proceed a k) = none := by
  cases hk : k.rest <;> simp [proceed, waitKind, hk]

/-- Resuming a blocking send leaves the sender running or idle. -/
theorem resume_send_clears (a : Actor) (dst : InstId) (k : Cont)
    (h : a.phase = .parked dst false k) : waitKind (resumeSender a false dst) = none := by
  simp [resumeSender, h]
  exact proceed_wait_none a k

/-- Resuming a parked call is the caller's `awaitReply`. The wait kind stays a call reply. -/
theorem resume_call_waits (a : Actor) (dst : InstId) (k : Cont)
    (h : a.phase = .parked dst true k) : (resumeSender a true dst).phase = .awaitReply dst k := by
  simp [resumeSender, h]

/-- Installing the receiver and crediting some sender leaves a different actor's phase. -/
theorem install_sender_phase (w w1 : World) (id : InstId) (installed : Actor) (who sender : InstId)
    (hne : sender ≠ id) (hst : w1.st sender = w.st sender) :
    ((creditLive (setActor w1 id installed) (tname id) who).st sender).phase =
      (w.st sender).phase := by
  rw [creditLive, phase_credit, setActor_other w1 id sender installed hne, hst]

theorem bulk_resumes_send (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) (s : InstId)
    (hs : s = p.sender) (hne : s ≠ id) (k : Cont)
    (hph : (w.st s).phase = .parked id false k) (hc : p.isCall = false) :
    waitKind (w'.st s) = none := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hst := deliver_st I w id _ p.msg w1 a1 s hdel
        have hpre := install_sender_phase w w1 id a1 p.msg.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self]
        rw [hc]
        exact resume_send_clears _ id k (hpre.trans hph)
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        have hst := deliver_st I w id _ m w1 a1 s hdel
        have hpre := install_sender_phase w w1 id admitted m.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self, admitted]
        rw [hc]
        exact resume_send_clears _ id k (hpre.trans hph)

theorem bulk_admits_call (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) (s : InstId)
    (hs : s = p.sender) (hne : s ≠ id) (k : Cont)
    (hph : (w.st s).phase = .parked id true k) (hc : p.isCall = true) :
    (w'.st s).phase = .awaitReply id k := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hst := deliver_st I w id _ p.msg w1 a1 s hdel
        have hpre := install_sender_phase w w1 id a1 p.msg.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self]
        rw [hc]
        exact resume_call_waits _ id k (hpre.trans hph)
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        have hst := deliver_st I w id _ m w1 a1 s hdel
        have hpre := install_sender_phase w w1 id admitted m.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self, admitted]
        rw [hc]
        exact resume_call_waits _ id k (hpre.trans hph)

theorem credit_parked (w : World) (dst : String) (sender i : InstId) :
    ((creditSender w dst sender).st i).parked = (w.st i).parked := by
  by_cases hi : i = sender
  · simp [creditSender, setActor, hi, bumpToken]
  · simp [creditSender, setActor, hi]

theorem deliver_parked (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg) (w1 : World)
    (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.parked = a.parked := by
  simp only [deliver] at h
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        rfl
    · split at h
      · cases h
      · cases h
        split <;> rfl

theorem finish_parked (I : Impl) (w w' : World) (id i : InstId) (h : finishWait I w id = some w') :
    (w'.st i).parked = (w.st i).parked := by
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  by_cases hi : i = id
  · simp [setActor, hi, proceed_parked]
  · simp [setActor, hi]

theorem prio_parked (I : Impl) (w w' : World) (id i : InstId) (h : receivePrio I w id = some w') :
    (w'.st i).parked = (w.st i).parked := by
  unfold receivePrio at h
  cases hprio : (w.st id).prio with
  | nil => simp [hprio] at h
  | cons m ms =>
    simp [hprio] at h
    split at h
    · simp at h
    · next w1 a1 hdel =>
      cases h.2
      have hpk := deliver_parked I w id ({ (w.st id) with prio := ms }) m w1 a1 hdel
      have hst := deliver_st I w id _ m w1 a1 i hdel
      by_cases hi : i = id
      · rw [hi]
        simp [setActor, hpk]
      · simp [setActor, hi, hst]

theorem bulk_other_parked (I : Impl) (w w' : World) (j i : InstId)
    (h : receiveBulk I w j = some w') (hne : i ≠ j) :
    (w'.st i).parked = (w.st i).parked := by
  unfold receiveBulk at h
  by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st j).box with
    | nil =>
      cases hpark : (w.st j).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w j _ p.msg w1 a1 i hdel
          by_cases hs : i = p.sender
          · have hnj : p.sender ≠ j := fun h => hne (hs.trans h)
            rw [hs] at hst ⊢
            simp [setActor_self, resume_parked, credit_parked]
            rw [setActor_other w1 j p.sender a1 hnj]
            exact congrArg (·.parked) hst
          · simp [setActor_other (creditLive (setActor w1 j a1) (tname j) p.msg.sender) p.sender i _ hs,
              credit_parked, setActor_other w1 j i a1 hne, hst]
    | cons m ms =>
      cases hpark : (w.st j).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w j _ m w1 a1 i hdel
          rw [credit_parked]
          simp [setActor, hne, hst]
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hst := deliver_st I w j _ m w1 a1 i hdel
          by_cases hs : i = p.sender
          · have hnj : p.sender ≠ j := fun h => hne (hs.trans h)
            rw [hs] at hst ⊢
            simp [setActor_self, resume_parked, credit_parked, admitted]
            rw [setActor_other w1 j p.sender admitted hnj]
            exact congrArg (·.parked) hst
          · simp [admitted, setActor_other (creditLive (setActor w1 j admitted) (tname j) m.sender)
              p.sender i _ hs, credit_parked, setActor_other w1 j i admitted hne, hst]

theorem spawn_keeps_parked (I : Impl) (w w' : World) (template : String)
    (h : spawn I w template = some w') (hO : OpenSlots w) (i : InstId) (p : Parked)
    (hm : p ∈ (w.st i).parked) : p ∈ (w'.st i).parked := by
  unfold spawn at h
  split at h
  · cases h
  · next t ht =>
    split at h
    · cases h
      let nid := InstId.peer template (w.nextIx template)
      have hfree := (hO template (w.nextIx template) (Nat.le_refl _)).2.2
      by_cases hi : i = nid
      · rw [hi, hfree] at hm
        cases hm
      · let wR : World := ({ w with roster := w.roster ++ [nid], nextIx := fun n => if n = template then w.nextIx n + 1 else w.nextIx n } : World)
        let born : Actor := withTokens I.desc template { life := .alive, typestate := t.initial, phase := .idle, box := [], prio := [], parked := [], tokens := fun _ => 0 }
        have hs := readCells_st I.desc (setActor wR nid born) nid i
        rw [hs]
        simpa [wR, setActor, hi] using hm
    · cases h

/-- Where a sender sits in a parked list. An absent sender is reported at `length`. -/
def parkIndex : List Parked → InstId → Nat
  | [], _ => 0
  | p :: ps, s => if p.sender == s then 0 else parkIndex ps s + 1

theorem parkIndex_nil (s : InstId) : parkIndex [] s = 0 := rfl

theorem parkIndex_head (p : Parked) (ps : List Parked) (s : InstId) (h : p.sender = s) :
    parkIndex (p :: ps) s = 0 := by
  simp [parkIndex, h]

theorem parkIndex_skip (p : Parked) (ps : List Parked) (s : InstId) (h : p.sender ≠ s) :
    parkIndex (p :: ps) s = parkIndex ps s + 1 := by
  have hb : (p.sender == s) = false := by simpa [beq_iff_eq] using h
  simp [parkIndex, hb]

theorem parkIndex_append (ps : List Parked) (s : InstId) (q : Parked)
    (h : parkIndex ps s < ps.length) : parkIndex (ps ++ [q]) s = parkIndex ps s := by
  induction ps with
  | nil => simp [parkIndex] at h
  | cons p ps ih =>
    by_cases hs : p.sender = s
    · simp [parkIndex, hs]
    · have hb : (p.sender == s) = false := by simpa [beq_iff_eq] using hs
      have hlt : parkIndex ps s < ps.length := by
        simp [parkIndex, hb, List.length] at h
        omega
      simp [parkIndex, hb, ih hlt]

theorem parkIndex_mem (ps : List Parked) (s : InstId) (h : parkIndex ps s < ps.length) :
    ∃ p, p ∈ ps ∧ p.sender = s := by
  induction ps with
  | nil => simp [parkIndex] at h
  | cons p ps ih =>
    by_cases hs : p.sender = s
    · exact ⟨p, List.Mem.head _, hs⟩
    · have hb : (p.sender == s) = false := by simpa [beq_iff_eq] using hs
      have hlt : parkIndex ps s < ps.length := by
        simp [parkIndex, hb, List.length] at h
        omega
      obtain ⟨q, hq, hqs⟩ := ih hlt
      exact ⟨q, List.Mem.tail _ hq, hqs⟩

/-- A step of one mailbox: leave it, append behind every current entry, or take the head. -/
def QueueStep (old new : List Parked) : Prop :=
  new = old ∨ (∃ a, new = old ++ [a]) ∨ (∃ p ps, old = p :: ps ∧ new = ps)

/-- Leave the parked list, append one entry, or drop entries by sender.
Aborting a sender admits that sender's blocked mail and deletes its parked entries. -/
def QueueGrow (old new : List Parked) : Prop :=
  new = old ∨ (∃ a, new = old ++ [a]) ∨
    (∃ keep : InstId → Bool, new = old.filter (fun p => keep p.sender))

/-- `QueueStep`, or a sender filter from aborting the sender. -/
def QueueMove (old new : List Parked) : Prop :=
  QueueStep old new ∨ ∃ keep : InstId → Bool, new = old.filter (fun p => keep p.sender)

theorem grow_step (old new : List Parked) (h : QueueGrow old new) : QueueMove old new := by
  rcases h with h | h | ⟨keep, hk⟩
  · exact Or.inl (Or.inl h)
  · obtain ⟨a, ha⟩ := h
    exact Or.inl (Or.inr (Or.inl ⟨a, ha⟩))
  · exact Or.inr ⟨keep, hk⟩

theorem queue_place (old new : List Parked) (s : InstId) (h : QueueStep old new)
    (hin : parkIndex old s < old.length) :
    (parkIndex new s < new.length ∧ parkIndex new s ≤ parkIndex old s) ∨
      ∃ p ps, old = p :: ps ∧ new = ps ∧ p.sender = s ∧ parkIndex old s = 0 := by
  rcases h with h | h | ⟨p, ps, hold, hnew⟩
  · rw [h]
    exact Or.inl ⟨hin, Nat.le_refl _⟩
  · obtain ⟨a, hnew⟩ := h
    rw [hnew]
    have hidx := parkIndex_append old s a hin
    refine Or.inl ⟨?_, ?_⟩
    · rw [hidx, List.length_append]
      simp
      exact Nat.lt_succ_of_lt hin
    · rw [hidx]
      exact Nat.le_refl _
  · rw [hold] at hin
    rw [hold, hnew]
    by_cases hs : p.sender = s
    · exact Or.inr ⟨p, ps, rfl, rfl, hs, parkIndex_head p ps s hs⟩
    · have hidx := parkIndex_skip p ps s hs
      have hlt : parkIndex ps s < ps.length := by
        rw [hidx, List.length_cons] at hin
        omega
      exact Or.inl ⟨hlt, by rw [hidx]; omega⟩

theorem bulk_drops_head (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) :
    (w'.st id).parked = ps := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hpk := deliver_parked I w id _ p.msg w1 a1 hdel
        by_cases hs : id = p.sender
        · rw [hs]
          simp [setActor_self, resume_parked, credit_parked, hpk]
        · simp [hs, credit_parked, setActor, hpk]
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        by_cases hs : id = p.sender
        · rw [hs]
          simp [setActor_self, resume_parked, credit_parked, admitted]
        · simp [hs, admitted, credit_parked, setActor]

/-- Enqueue and a same-actor update never delete a parked entry. -/
def QueuePlain (old new : List Parked) : Prop :=
  new = old ∨ ∃ a, new = old ++ [a]

theorem plain_grow {old new : List Parked} (h : QueuePlain old new) : QueueGrow old new := by
  rcases h with h | ⟨a, h⟩
  · exact Or.inl h
  · exact Or.inr (Or.inl ⟨a, h⟩)

theorem enqueue_queue (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (isCall : Bool) (k : Cont) (i : InstId) :
    QueuePlain ((w.st i).parked) ((enqueueOrPark w D sender dst msg isCall k).st i).parked := by
  unfold enqueueOrPark
  by_cases hlive : (w.st dst).life = .alive
  · simp [hlive]
    by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · simp [hroom]
      cases isCall
      · by_cases hsame : sender = dst
        · rw [hsame]
          by_cases hi : i = dst
          · rw [hi]
            simp [setActor, charge_parked, proceed_parked]
            exact Or.inl rfl
          · simp [setActor, hi]
            exact Or.inl rfl
        · by_cases hi : i = dst
          · rw [hi, if_neg hsame]
            have hflip : ¬ dst = sender := fun h => hsame h.symm
            have hempty : (w.st dst).parked = [] := hroom.1
            simp [setActor, hempty, charge_parked, proceed_parked]
            rw [if_neg hflip]
            exact Or.inl rfl
          · by_cases his : i = sender
            · rw [his, if_neg hsame]
              simp [setActor, hi, charge_parked, proceed_parked]
              exact Or.inl rfl
            · rw [if_neg hsame]
              simp [setActor, hi, his]
              exact Or.inl rfl
      · by_cases hsame : sender = dst
        · rw [hsame]
          by_cases hi : i = dst
          · rw [hi]
            simp [setActor, charge_parked]
            exact Or.inl rfl
          · simp [setActor, hi]
            exact Or.inl rfl
        · by_cases hi : i = dst
          · rw [hi, if_neg hsame]
            have hflip : ¬ dst = sender := fun h => hsame h.symm
            have hempty : (w.st dst).parked = [] := hroom.1
            simp [setActor, hempty, charge_parked, proceed_parked]
            rw [if_neg hflip]
            exact Or.inl rfl
          · by_cases his : i = sender
            · rw [his, if_neg hsame]
              simp [setActor, hi, charge_parked]
              exact Or.inl rfl
            · rw [if_neg hsame]
              simp [setActor, hi, his]
              exact Or.inl rfl
    · simp [hroom]
      by_cases hsame : sender = dst
      · rw [hsame]
        by_cases hi : i = dst
        · rw [hi]
          simp [setActor, charge_parked]
          exact Or.inr ⟨{ sender := dst, msg := { msg with mid := (chargeSender (w.st dst) (tname dst)).nextMid }, isCall := isCall }, rfl⟩
        · simp [setActor, hi]
          exact Or.inl rfl
      · by_cases hi : i = dst
        · rw [if_neg hsame, hi]
          have hflip : ¬ dst = sender := fun h => hsame h.symm
          simp [setActor, charge_parked, hsame]
          rw [if_neg hflip]
          exact Or.inr ⟨{ sender := sender, msg := { msg with mid := (w.st dst).nextMid }, isCall := isCall }, rfl⟩
        · by_cases his : i = sender
          · rw [his, if_neg hsame]
            simp [setActor, hi, charge_parked]
            exact Or.inl rfl
          · rw [if_neg hsame]
            simp [setActor, hi, his]
            exact Or.inl rfl
  · simp [hlive]
    by_cases hi : i = sender
    · rw [hi]
      simp [setActor, proceed_parked]
      exact Or.inl rfl
    · simp [setActor, hi]
      exact Or.inl rfl

theorem release_preserves_parked (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).parked = (w.st i).parked := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w
    · rw [if_neg hskip]
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id))
      have hset : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).parked =
          (w.st i).parked := by
        by_cases hi : i = p.sender
        · rw [hi]
          simp [setActor, resume_parked]
        · simp [setActor, hi]
      rw [hset] at hmid
      exact hmid

theorem refund_msgs_parked (w : World) (dst : String) (ms : List Msg) (i : InstId) :
    ((refundMsgs w dst ms).st i).parked = (w.st i).parked := by
  induction ms generalizing w with
  | nil => simp [refundMsgs]
  | cons m ms ih =>
    simp only [refundMsgs, List.foldl_cons]
    simpa [refundMsgs, credit_parked] using ih (creditSender w dst m.sender)

theorem refund_park_parked (w : World) (dst : String) (ps : List Parked) (i : InstId) :
    ((refundParked w dst ps).st i).parked = (w.st i).parked := by
  induction ps generalizing w with
  | nil => simp [refundParked]
  | cons p ps ih =>
    simp only [refundParked, List.foldl_cons]
    simpa [refundParked, credit_parked] using ih (creditSender w dst p.msg.sender)

theorem try_wake_parked (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) : ((tryWake D w dstId label writer).st i).parked = (w.st i).parked := by
  by_cases hif : ((w.st dstId).life == .alive &&
      decide (prioLoad (w.st dstId).prio < capPrio D w.N dstId) &&
      !((w.st dstId).prio.any fun p => p.label == label)) = true
  · simp [tryWake, hif, setActor]
    by_cases hi : i = dstId <;> simp [hi]
  · simp [tryWake, hif]

theorem wakes_parked (D : Description) (ids : List InstId) (w : World) (label : String)
    (writer i : InstId) :
    ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).parked = (w.st i).parked := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    exact (ih _).trans (try_wake_parked D w j label writer i)

/-- Resuming a blocking send does not leave it blocked on the same partner. -/
theorem resume_leaves_block (a : Actor) (dst : InstId) (k : Cont) (b : Bool)
    (h : a.phase = .parked dst false k) :
    waitKind (resumeSender a b dst) ≠ some (.blockingSend dst) := by
  cases b
  · simp [resumeSender, h]
    rw [proceed_wait_none]
    intro hc
    cases hc
  · simp [resumeSender, h, waitKind]

theorem bulk_queue (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w') :
    QueueStep ((w.st id).parked) ((w'.st id).parked) := by
  cases hp : (w.st id).parked with
  | nil =>
    unfold receiveBulk at h
    by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
    · simp [hready] at h
    · simp [hready, hp] at h
      cases hbox : (w.st id).box with
      | nil => simp [hbox] at h
      | cons m ms =>
        simp [hbox] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hpk := deliver_parked I w id _ m w1 a1 hdel
          simp [credit_parked, setActor_self, hpk, hp]
          exact Or.inl rfl
  | cons p ps =>
    exact Or.inr (Or.inr ⟨p, ps, rfl, bulk_drops_head I w w' id h p ps hp⟩)

theorem release_life_self (w : World) (id : InstId) (ps : List Parked) :
    ((releaseParked w id ps).st id).life = (w.st id).life := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w
    · rw [if_neg hskip]
      have hne : p.sender ≠ id := by
        intro h
        have : (p.isCall || decide (p.sender = id)) = true := by simp [h]
        simp [this] at hskip
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id))
      have hflip : id ≠ p.sender := fun h => hne h.symm
      rwa [setActor_other w p.sender id (resumeSender (w.st p.sender) false id) hflip] at hmid

theorem queue_set (w : World) (id : InstId) (a : Actor) (mb : InstId)
    (h : a.parked = (w.st id).parked) :
    ((setActor w id a).st mb).parked = (w.st mb).parked := by
  by_cases hmb : mb = id
  · rw [hmb, setActor_self, h]
  · rw [setActor_other w id mb a hmb]

theorem queue_actor (w : World) (id : InstId) (a : Actor) (mb : InstId)
    (h : a.parked = (w.st id).parked) :
    QueueGrow ((w.st mb).parked) ((setActor w id a).st mb).parked :=
  Or.inl (queue_set w id a mb h)


theorem releaseWorld_parked (D : Description) (w : World) (id : InstId) (a : Actor)
    (dst : InstId) (hd : dst ≠ id) :
    ((releaseWorld D w id a).st dst).parked = (w.st dst).parked := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hbase : (base.st dst).parked = (w.st dst).parked := by
    simp [base, refund_park_parked, refund_msgs_parked, readCells_st]
  have hset : ((setActor base id dead).st dst).parked = (w.st dst).parked := by
    simp [setActor, hd, hbase]
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  rw [hworld, release_preserves_parked _ _ _ dst, hset]

theorem failWaiter_parked (w : World) (dead i dst : InstId) :
    ((failWaiter w dead i).st dst).parked = (w.st dst).parked := by
  by_cases hlive : (w.st i).life = .alive
  · have hgo : ((w.st i).life != .alive) = false := by simp [hlive, bne]
    simp only [failWaiter, hgo, ite_false]
    cases hph : (w.st i).phase with
    | parked d _ k =>
      by_cases hd : d = dead
      · simp [hph, hd, setActor, proceed_parked]
        by_cases hj : dst = i <;> simp [hj, proceed_parked]
      · simp [hph, hd]
    | awaitReply d _ =>
      by_cases hd : d = dead
      · simp [hph, hd, setActor]
        by_cases hj : dst = i <;> simp [hj]
      · simp [hph, hd]
    | idle => simp [hph]
    | run _ => simp [hph]
    | awaitEffect _ => simp [hph]
    | awaitPeer _ => simp [hph]
    | crashed => simp [hph]
  · have hgo : ((w.st i).life != .alive) = true := by
      cases hlife : (w.st i).life <;> simp_all [bne]
    simp [failWaiter, hgo]

theorem failFold_parked (w : World) (dead dst : InstId) (ids : List InstId) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st dst).parked = (w.st dst).parked := by
  induction ids generalizing w with
  | nil => simp
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact (ih _).trans (failWaiter_parked w dead i dst)

theorem admitHost_other_park (w : World) (dead host i : InstId) (hi : i ≠ host) :
    ((admitHost w dead host).st i).parked = (w.st i).parked := by
  unfold admitHost
  split
  · rfl
  · split
    · rfl
    · simp [setActor, hi]

theorem admitHost_parked_filter (w : World) (dead host : InstId) (hd : host ≠ dead) :
    ((admitHost w dead host).st host).parked =
      (w.st host).parked.filter (fun p => p.sender != dead) := by
  have hne : (host == dead) = false := by simpa [beq_iff_eq] using hd
  unfold admitHost
  simp only [hne, ite_false]
  by_cases hempty : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty = true
  · simp only [hempty, ite_true]
    have hdrop :=
      filter_drop_empty (fun p : Parked => p.sender == dead) (w.st host).parked hempty
    have hfun : (fun p : Parked => p.sender != dead) = fun p => !(p.sender == dead) := by
      funext p
      cases hb : p.sender == dead <;> simp [bne, hb]
    rw [hfun]
    exact hdrop.symm
  · have hnot : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty = false := by
      cases h : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty
      · rfl
      · exact (hempty h).elim
    simp [hnot, setActor_self]

theorem park_filter_again (ps : List Parked) (dead : InstId) :
    ((ps.filter fun p => p.sender != dead).filter fun p => p.sender != dead) =
      ps.filter fun p => p.sender != dead := by
  simp [List.filter_filter, Bool.and_self]

theorem park_keep_true (ps : List Parked) : ps.filter (fun _ => true) = ps := by
  induction ps with
  | nil => simp
  | cons p ps ih => simp [List.filter_cons, ih]

theorem park_keep_false (ps : List Parked) : ps.filter (fun _ => false) = [] := by
  induction ps with
  | nil => simp
  | cons _ ps ih => simp [List.filter_cons, ih]

theorem park_filter_comp (ps : List Parked) (k1 k2 : InstId → Bool) :
    (ps.filter fun p => k1 p.sender).filter (fun p => k2 p.sender) =
      ps.filter fun p => k1 p.sender && k2 p.sender := by
  induction ps with
  | nil => simp
  | cons p ps ih =>
    cases h1 : k1 p.sender <;> cases h2 : k2 p.sender <;> simp [List.filter_cons, h1, h2, ih]

theorem admit_one_move (w : World) (dead c host : InstId) (base : List Parked) (hd : host ≠ dead)
    (h : (w.st host).parked = base ∨
      (w.st host).parked = base.filter (fun p => p.sender != dead)) :
    ((admitHost w dead c).st host).parked = base ∨
      ((admitHost w dead c).st host).parked =
        base.filter (fun p => p.sender != dead) := by
  by_cases hc : c = host
  · rw [hc, admitHost_parked_filter w dead host hd]
    rcases h with h | h
    · exact Or.inr (by rw [h])
    · rw [h, park_filter_again]
      exact Or.inr rfl
  · rw [admitHost_other_park w dead c host (Ne.symm hc)]
    exact h

theorem admitFold_move (ids : List InstId) (w : World) (dead host : InstId) (base : List Parked)
    (hd : host ≠ dead)
    (h : (w.st host).parked = base ∨
      (w.st host).parked = base.filter (fun p => p.sender != dead)) :
    ((ids.foldl (fun w h => admitHost w dead h) w).st host).parked = base ∨
      ((ids.foldl (fun w h => admitHost w dead h) w).st host).parked =
        base.filter (fun p => p.sender != dead) := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons c ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (admit_one_move w dead c host base hd h)

theorem admitHost_spares_dead (w : World) (dead i : InstId) :
    ((admitHost w dead i).st dead).parked = (w.st dead).parked := by
  by_cases hi : i = dead
  · simp [admitHost, hi]
  · have hne : (i == dead) = false := by simpa [beq_iff_eq] using hi
    unfold admitHost
    simp only [hne, ite_false]
    by_cases hempty : ((w.st i).parked.filter fun p => p.sender == dead).isEmpty = true
    · simp [hempty]
    · have hnot : ((w.st i).parked.filter fun p => p.sender == dead).isEmpty = false := by
        cases h : ((w.st i).parked.filter fun p => p.sender == dead).isEmpty
        · rfl
        · exact (hempty h).elim
      simp [hnot, setActor_other _ i dead _ (Ne.symm hi)]

theorem admitDead_spares_self (w : World) (dead : InstId) :
    ((admitDead w dead).st dead).parked = (w.st dead).parked := by
  unfold admitDead
  suffices ∀ (ids : List InstId) (w0 : World),
      ((List.foldl (fun w i => admitHost w dead i) w0 ids).st dead).parked =
        (w0.st dead).parked by
    exact this w.roster w
  intro ids
  induction ids with
  | nil => intro w0; simp
  | cons i ids ih =>
    intro w0
    simp only [List.foldl_cons]
    exact (ih _).trans (admitHost_spares_dead w0 dead i)

/-- Moving a dead sender's blocked mail out of parked lists only deletes entries. -/
theorem admitDead_park_move (w : World) (dead host : InstId) :
    ∃ keep : InstId → Bool, ((admitDead w dead).st host).parked =
      (w.st host).parked.filter (fun p => keep p.sender) := by
  by_cases hd : host = dead
  · refine ⟨fun _ => true, ?_⟩
    rw [hd, admitDead_spares_self, park_keep_true]
  · unfold admitDead
    rcases admitFold_move w.roster w dead host (w.st host).parked hd (Or.inl rfl) with h | h
    · exact ⟨fun _ => true, h.trans (park_keep_true _).symm⟩
    · exact ⟨fun s => s != dead, h⟩

theorem release_self_parked (D : Description) (w : World) (id : InstId) (a : Actor) :
    ((releaseWorld D w id a).st id).parked = [] := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  rw [hworld, release_victim_eq]
  simp [setActor, dead]

theorem abortActor_park_move (D : Description) (w : World) (id : InstId) (a : Actor) (host : InstId) :
    ∃ keep : InstId → Bool, ((abortActor D w id a).st host).parked =
      (w.st host).parked.filter (fun p => keep p.sender) := by
  have hrel : ∃ keep : InstId → Bool, ((releaseWorld D w id a).st host).parked =
      (w.st host).parked.filter (fun p => keep p.sender) := by
    by_cases hh : host = id
    · refine ⟨fun _ => false, ?_⟩
      rw [hh, release_self_parked]
      exact (park_keep_false (w.st id).parked).symm
    · refine ⟨fun _ => true, ?_⟩
      rw [releaseWorld_parked D w id a host hh, park_keep_true]
  rcases hrel with ⟨k1, h1⟩
  have hfail : ((failWaiters (releaseWorld D w id a) id).st host).parked =
      ((releaseWorld D w id a).st host).parked := by
    simpa [failWaiters] using
      failFold_parked (releaseWorld D w id a) id host (releaseWorld D w id a).roster
  rcases admitDead_park_move (failWaiters (releaseWorld D w id a) id) id host with ⟨k2, h2⟩
  refine ⟨fun s => k1 s && k2 s, ?_⟩
  simp only [abortActor]
  rw [h2, hfail, h1, park_filter_comp]

theorem abortDesc_park_move (fuel : Nat) (D : Description) (w : World) (parent host : InstId) :
    ∃ keep : InstId → Bool, ((abortDesc fuel D w parent).st host).parked =
      (w.st host).parked.filter (fun p => keep p.sender) := by
  induction fuel generalizing w parent with
  | zero =>
    exact ⟨fun _ => true, (park_keep_true _).symm⟩
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World),
        ∃ keep : InstId → Bool,
          ((ids.foldl (fun w child =>
            if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
              let w := abortDesc fuel D w child
              abortActor D w child (w.st child)
            else w) w0).st host).parked =
            (w0.st host).parked.filter (fun p => keep p.sender) by
      exact this w.roster w
    intro ids
    induction ids with
    | nil =>
      intro w0
      exact ⟨fun _ => true, (park_keep_true _).symm⟩
    | cons c ids ihf =>
      intro w0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        rcases ih w0 c with ⟨k1, h1⟩
        rcases abortActor_park_move D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c) host with ⟨k2, h2⟩
        rcases ihf (abortActor D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c)) with ⟨k3, h3⟩
        refine ⟨fun s => (k1 s && k2 s) && k3 s, ?_⟩
        rw [h3, h2, h1]
        rw [park_filter_comp (w0.st host).parked k1 k2]
        rw [park_filter_comp _ (fun s => k1 s && k2 s) k3]
      · rw [if_neg hgo]
        exact ihf w0

theorem tombstone_parked (D : Description) (w : World) (child i : InstId) :
    ((enqueueTombstone D w child).st i).parked = (w.st i).parked := by
  cases hsup : supervisorOf D child with
  | none => simp [enqueueTombstone, hsup]
  | some parent =>
    simp [enqueueTombstone, hsup]
    split
    · by_cases hs : i = parent
      · simp [setActor, hs]
      · simp [setActor, hs]
    · rfl

theorem terminate_park_move (D : Description) (w : World) (id host : InstId) :
    ∃ keep : InstId → Bool, ((terminateStage D w id (w.st id)).st host).parked =
      (w.st host).parked.filter (fun p => keep p.sender) := by
  simp only [terminateStage]
  rcases abortDesc_park_move w.roster.length D w id host with ⟨k1, h1⟩
  rcases abortActor_park_move D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id) host with ⟨k2, h2⟩
  refine ⟨fun s => k1 s && k2 s, ?_⟩
  rw [tombstone_parked, h2, h1, park_filter_comp]

theorem abort_self_parked (D : Description) (w : World) (id : InstId) (a : Actor) :
    ((abortActor D w id a).st id).parked = [] := by
  have hrel := release_self_parked D w id a
  have hfail : ((failWaiters (releaseWorld D w id a) id).st id).parked =
      ((releaseWorld D w id a).st id).parked := by
    simpa [failWaiters] using
      failFold_parked (releaseWorld D w id a) id id (releaseWorld D w id a).roster
  have hsp := admitDead_spares_self (failWaiters (releaseWorld D w id a) id) id
  simpa [abortActor] using hsp.trans (hfail.trans hrel)

theorem abort_keeps_empty_park (D : Description) (w : World) (id : InstId) (a : Actor)
    (host : InstId) (h : (w.st host).parked = []) :
    ((abortActor D w id a).st host).parked = [] := by
  rcases abortActor_park_move D w id a host with ⟨_, hk⟩
  simp [hk, h]

theorem abortDesc_keeps_empty_park (fuel : Nat) (D : Description) (w : World) (parent host : InstId)
    (h : (w.st host).parked = []) : ((abortDesc fuel D w parent).st host).parked = [] := by
  rcases abortDesc_park_move fuel D w parent host with ⟨_, hk⟩
  simp [hk, h]

theorem abortFold_keeps_empty_park (fuel : Nat) (D : Description) (parent host : InstId)
    (ids : List InstId) (w0 : World) (h : (w0.st host).parked = []) :
    ((ids.foldl (fun w child =>
      if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
        let w := abortDesc fuel D w child
        abortActor D w child (w.st child)
      else w) w0).st host).parked = [] := by
  induction ids generalizing w0 with
  | nil => simpa using h
  | cons c ids ih =>
    simp only [List.foldl_cons]
    by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
    · rw [if_pos hgo]
      exact ih _ (abort_keeps_empty_park D (abortDesc fuel D w0 c) c
        ((abortDesc fuel D w0 c).st c) host (abortDesc_keeps_empty_park fuel D w0 c host h))
    · rw [if_neg hgo]
      exact ih w0 h

/-- An actor whose life leaves `alive` inside `abortDesc` is left with an empty parked list. -/
theorem abortDesc_killed_park (fuel : Nat) (D : Description) (w : World) (parent i : InstId)
    (hl : (w.st i).life = .alive) (hd : ((abortDesc fuel D w parent).st i).life ≠ .alive) :
    ((abortDesc fuel D w parent).st i).parked = [] := by
  induction fuel generalizing w parent with
  | zero =>
    simp [abortDesc] at hd
    exact absurd hl hd
  | succ fuel ih =>
    simp only [abortDesc] at hd ⊢
    suffices ∀ (ids : List InstId) (w0 : World), (w0.st i).life = .alive →
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st i).life ≠ .alive →
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st i).parked = [] by
      exact this w.roster w hl hd
    intro ids
    induction ids with
    | nil =>
      intro w0 hl0 hd0
      simp at hd0
      exact absurd hl0 hd0
    | cons c ids ihf =>
      intro w0 hl0 hd0
      simp only [List.foldl_cons] at hd0 ⊢
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo] at hd0 ⊢
        let w1 := abortDesc fuel D w0 c
        by_cases hc : c = i
        · have hempty : ((abortActor D w1 c (w1.st c)).st i).parked = [] := by
            rw [hc]
            exact abort_self_parked D w1 i (w1.st i)
          exact abortFold_keeps_empty_park fuel D parent i ids
            (abortActor D w1 c (w1.st c)) hempty
        · by_cases hdie : (w1.st i).life = .alive
          · have hl2 : ((abortActor D w1 c (w1.st c)).st i).life = .alive :=
              (abortActor_other_life D w1 c i (w1.st c) (Ne.symm hc)).trans hdie
            exact ihf (abortActor D w1 c (w1.st c)) hl2 hd0
          · have hempty := abort_keeps_empty_park D w1 c (w1.st c) i (ih w0 c hl0 hdie)
            exact abortFold_keeps_empty_park fuel D parent i ids
              (abortActor D w1 c (w1.st c)) hempty
      · rw [if_neg hgo] at hd0 ⊢
        exact ihf w0 hl0 hd0

/-- An actor that is not alive is not aborted, so its life stays. -/
theorem abortDesc_keeps_unalive (fuel : Nat) (D : Description) (w : World) (parent i : InstId)
    (h : (w.st i).life ≠ .alive) : ((abortDesc fuel D w parent).st i).life = (w.st i).life := by
  induction fuel generalizing w parent with
  | zero => simp [abortDesc]
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), (w0.st i).life ≠ .alive →
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st i).life = (w0.st i).life by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil => intro w0 _; simp
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        have hne : c ≠ i := by
          intro heq
          have hlive : ((w0.st c).life == .alive) = true :=
            ((Bool.and_eq_true _ _).mp ((Bool.and_eq_true _ _).mp hgo).1).2
          exact h0 (by simpa [heq, beq_iff_eq] using hlive)
        have h1 := ih w0 c h0
        have h2 := abortActor_other_life D (abortDesc fuel D w0 c) c i
          ((abortDesc fuel D w0 c).st c) (Ne.symm hne)
        have hstep := h2.trans h1
        exact (ihf _ (by rw [hstep]; exact h0)).trans hstep
      · rw [if_neg hgo]
        exact ihf w0 h0

/-- An actor whose life changes inside `terminateStage` is left with nothing parked. -/
theorem terminate_killed_park (D : Description) (w : World) (id i : InstId)
    (hchg : ((terminateStage D w id (w.st id)).st i).life ≠ (w.st i).life) :
    ((terminateStage D w id (w.st id)).st i).parked = [] := by
  simp only [terminateStage] at hchg ⊢
  let w1 := abortDesc w.roster.length D w id
  let w2 := abortActor D w1 id (w1.st id)
  have hlife := enqueueTombstone_life D w2 id i
  have hpark := tombstone_parked D w2 id i
  have hchg2 : (w2.st i).life ≠ (w.st i).life := by
    intro heq
    exact hchg (hlife.trans heq)
  by_cases hdesc : (w1.st i).life = (w.st i).life
  · have hi : i = id := by
      by_cases hne : i = id
      · exact hne
      · exact absurd ((abortActor_other_life D w1 id i (w1.st id) hne).trans hdesc) hchg2
    have hempty : (w2.st i).parked = [] := by
      simpa [w2, hi] using abort_self_parked D w1 id (w1.st id)
    simpa [w2] using hpark.trans hempty
  · have hl : (w.st i).life = .alive := by
      by_cases hwas : (w.st i).life = .alive
      · exact hwas
      · exact absurd (abortDesc_keeps_unalive w.roster.length D w id i hwas) hdesc
    have hd : (w1.st i).life ≠ .alive := by simpa [hl] using hdesc
    have hempty1 := abortDesc_killed_park w.roster.length D w id i hl hd
    have hempty2 := abort_keeps_empty_park D w1 id (w1.st id) i hempty1
    simpa [w2] using hpark.trans hempty2

theorem abort_idle_phase (D : Description) (w : World) (id : InstId) (a : Actor) (s : InstId)
    (hidle : (w.st s).phase = .idle) :
    ((abortActor D w id a).st s).phase = .idle := by
  by_cases hs : s = id
  · rw [hs]
    exact (abort_self D w id a).2
  · have hq := abort_keeps_quiet D w id a s hs
      (fun d c ck hbad => by rw [hidle] at hbad; cases hbad)
      (fun d ck hbad => by rw [hidle] at hbad; cases hbad)
    exact hq.1.trans hidle

theorem abortDesc_idle_phase (fuel : Nat) (D : Description) (w : World) (parent s : InstId)
    (hidle : (w.st s).phase = .idle) :
    ((abortDesc fuel D w parent).st s).phase = .idle := by
  cases abortDesc_quiet fuel D w parent s
      (fun d c ck hbad => by rw [hidle] at hbad; cases hbad)
      (fun d ck hbad => by rw [hidle] at hbad; cases hbad) with
  | inl h => exact h.1.trans hidle
  | inr h => exact h.2

theorem abort_life_mono (D : Description) (w : World) (id : InstId) (a : Actor) (s : InstId)
    (h : (w.st s).life ≠ .alive) : ((abortActor D w id a).st s).life ≠ .alive := by
  by_cases hs : s = id
  · rw [hs, (abort_self D w id a).1]
    intro hlive
    cases hlive
  · rw [abortActor_other_life D w id s a hs]
    exact h

theorem abortDesc_life_mono (fuel : Nat) (D : Description) (w : World) (parent s : InstId)
    (h : (w.st s).life ≠ .alive) : ((abortDesc fuel D w parent).st s).life ≠ .alive := by
  rcases (abortDesc_track fuel D w parent).1 s with heq | hd
  · rw [heq]; exact h
  · rw [hd.1]
    intro hlive
    cases hlive

/-- `terminateStage` does not bring an actor back to life. -/
theorem terminate_life_mono (D : Description) (w : World) (id i : InstId)
    (h : (w.st i).life ≠ .alive) :
    ((terminateStage D w id (w.st id)).st i).life ≠ .alive := by
  simp only [terminateStage]
  let w1 := abortDesc w.roster.length D w id
  have h1 := abortDesc_life_mono w.roster.length D w id i h
  have h2 := abort_life_mono D w1 id (w1.st id) i h1
  have h3 := enqueueTombstone_life D (abortActor D w1 id (w1.st id)) id i
  simpa [w1] using (fun hlive => h2 (h3.symm.trans hlive))

theorem abortFold_life_mono (fuel : Nat) (D : Description) (parent host : InstId)
    (ids : List InstId) (w : World) (h : (w.st host).life ≠ .alive) :
    ((ids.foldl (fun w child =>
      if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
        let w := abortDesc fuel D w child
        abortActor D w child (w.st child)
      else w) w).st host).life ≠ .alive := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons c ids ih =>
    simp only [List.foldl_cons]
    by_cases hgo : (isChild D parent c && (w.st c).life == .alive && childTerminable D c) = true
    · rw [if_pos hgo]
      exact ih _ (abort_life_mono D (abortDesc fuel D w c) c ((abortDesc fuel D w c).st c) host
        (abortDesc_life_mono fuel D w c host h))
    · rw [if_neg hgo]
      exact ih w h

theorem abortFold_idle (fuel : Nat) (D : Description) (parent s : InstId)
    (ids : List InstId) (w : World) (hidle : (w.st s).phase = .idle) :
    ((ids.foldl (fun w child =>
      if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
        let w := abortDesc fuel D w child
        abortActor D w child (w.st child)
      else w) w).st s).phase = .idle := by
  induction ids generalizing w with
  | nil => simpa using hidle
  | cons c ids ih =>
    simp only [List.foldl_cons]
    by_cases hgo : (isChild D parent c && (w.st c).life == .alive && childTerminable D c) = true
    · rw [if_pos hgo]
      exact ih _ (abort_idle_phase D (abortDesc fuel D w c) c ((abortDesc fuel D w c).st c) s
        (abortDesc_idle_phase fuel D w c s hidle))
    · rw [if_neg hgo]
      exact ih w hidle

theorem abortActor_live_keep (D : Description) (w : World) (id : InstId) (a : Actor) (host : InstId)
    (halive : ((abortActor D w id a).st host).life = .alive) :
    ∃ keep : InstId → Bool, ((abortActor D w id a).st host).parked =
        (w.st host).parked.filter (fun p => keep p.sender) ∧
      ∀ s, keep s = false → ((abortActor D w id a).st s).phase = .idle := by
  have hhost : host ≠ id := by
    intro h
    have hdead := (abort_self D w id a).1
    rw [h] at halive
    rw [hdead] at halive
    cases halive
  have hrel := releaseWorld_parked D w id a host hhost
  have hfail : ((failWaiters (releaseWorld D w id a) id).st host).parked =
      ((releaseWorld D w id a).st host).parked := by
    simpa [failWaiters] using
      failFold_parked (releaseWorld D w id a) id host (releaseWorld D w id a).roster
  simp only [abortActor]
  have hbase : ((failWaiters (releaseWorld D w id a) id).st host).parked = (w.st host).parked := by
    rw [hfail, hrel]
  unfold admitDead
  rcases admitFold_move (failWaiters (releaseWorld D w id a) id).roster
      (failWaiters (releaseWorld D w id a) id) id host
      ((failWaiters (releaseWorld D w id a) id).st host).parked hhost (Or.inl rfl) with h | h
  · refine ⟨fun _ => true, ?_, ?_⟩
    rw [h, hbase, park_keep_true]
    intro s hs
    simp at hs
  · refine ⟨fun s => s != id, ?_, ?_⟩
    rw [h, hbase]
    intro s hs
    have hid : s = id := by
      by_cases hne : s = id
      · exact hne
      · have htrue : (s != id) = true := by simpa [bne] using hne
        have hs' : (s != id) = false := by simpa using hs
        rw [htrue] at hs'
        cases hs'
    rw [hid]
    exact (abort_self D w id a).2

theorem abortDesc_drops (fuel : Nat) (D : Description) (w : World) (parent host : InstId)
    (halive : ((abortDesc fuel D w parent).st host).life = .alive) :
    ∃ keep : InstId → Bool, ((abortDesc fuel D w parent).st host).parked =
        (w.st host).parked.filter (fun p => keep p.sender) ∧
      ∀ s, keep s = false → ((abortDesc fuel D w parent).st s).phase = .idle := by
  induction fuel generalizing w parent with
  | zero =>
    exact ⟨fun _ => true, by simp [abortDesc, park_keep_true], fun _ hs => by simp at hs⟩
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World),
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st host).life = .alive →
        ∃ keep : InstId → Bool,
          ((ids.foldl (fun w child =>
            if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
              let w := abortDesc fuel D w child
              abortActor D w child (w.st child)
            else w) w0).st host).parked =
            (w0.st host).parked.filter (fun p => keep p.sender) ∧
          ∀ s, keep s = false →
            ((ids.foldl (fun w child =>
              if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
                let w := abortDesc fuel D w child
                abortActor D w child (w.st child)
              else w) w0).st s).phase = .idle by
      exact this w.roster w halive
    intro ids
    induction ids with
    | nil =>
      intro w0 halive0
      exact ⟨fun _ => true, (park_keep_true _).symm, fun _ hs => by simp at hs⟩
    | cons c ids ihf =>
      intro w0 haliveF
      simp only [List.foldl_cons] at haliveF ⊢
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo] at haliveF ⊢
        have haliveA : ((abortDesc fuel D w0 c).st host).life = .alive := by
          by_cases h : ((abortDesc fuel D w0 c).st host).life = .alive
          · exact h
          · exact absurd haliveF (abortFold_life_mono fuel D parent host ids
              (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c))
              (abort_life_mono D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c) host h))
        have haliveB : ((abortActor D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c)).st host).life = .alive := by
          by_cases h : ((abortActor D (abortDesc fuel D w0 c) c
              ((abortDesc fuel D w0 c).st c)).st host).life = .alive
          · exact h
          · exact absurd haliveF (abortFold_life_mono fuel D parent host ids
              (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c)) h)
        rcases ih w0 c haliveA with ⟨k1, h1, hidle1⟩
        rcases abortActor_live_keep D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c) host haliveB with ⟨k2, h2, hidle2⟩
        rcases ihf (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c)) haliveF
          with ⟨k3, h3, hidle3⟩
        refine ⟨fun s => (k1 s && k2 s) && k3 s, ?_, ?_⟩
        · rw [h3, h2, h1]
          rw [park_filter_comp (w0.st host).parked k1 k2]
          rw [park_filter_comp _ (fun s => k1 s && k2 s) k3]
        · intro s hs
          cases hk3 : k3 s
          · exact hidle3 s hk3
          · have hk12 : (k1 s && k2 s) = false := by
              have hs' : ((k1 s && k2 s) && k3 s) = false := by simpa using hs
              simpa [hk3] using hs'
            cases hk1 : k1 s
            · have hidle := hidle1 s hk1
              exact abortFold_idle fuel D parent s ids
                (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c))
                (abort_idle_phase D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c) s hidle)
            · have hk2 : k2 s = false := by simpa [hk1] using hk12
              exact abortFold_idle fuel D parent s ids
                (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c)) (hidle2 s hk2)
      · rw [if_neg hgo] at haliveF ⊢
        exact ihf w0 haliveF

theorem terminate_drops (D : Description) (w : World) (id host : InstId)
    (halive : ((terminateStage D w id (w.st id)).st host).life = .alive) :
    ∃ keep : InstId → Bool, ((terminateStage D w id (w.st id)).st host).parked =
        (w.st host).parked.filter (fun p => keep p.sender) ∧
      ∀ s, keep s = false → ((terminateStage D w id (w.st id)).st s).phase = .idle := by
  simp only [terminateStage] at halive ⊢
  have haliveA : ((abortDesc w.roster.length D w id).st host).life = .alive := by
    by_cases h : ((abortDesc w.roster.length D w id).st host).life = .alive
    · exact h
    · have hnot := abort_life_mono D (abortDesc w.roster.length D w id) id
        ((abortDesc w.roster.length D w id).st id) host h
      have hts := enqueueTombstone_life D
        (abortActor D (abortDesc w.roster.length D w id) id
          ((abortDesc w.roster.length D w id).st id)) id host
      rw [← hts] at hnot
      exact absurd halive hnot
  have haliveB : ((abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)).st host).life = .alive := by
    by_cases h : ((abortActor D (abortDesc w.roster.length D w id) id
        ((abortDesc w.roster.length D w id).st id)).st host).life = .alive
    · exact h
    · have hts := enqueueTombstone_life D
        (abortActor D (abortDesc w.roster.length D w id) id
          ((abortDesc w.roster.length D w id).st id)) id host
      rw [← hts] at h
      exact absurd halive h
  rcases abortDesc_drops w.roster.length D w id host haliveA with ⟨k1, h1, hidle1⟩
  rcases abortActor_live_keep D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id) host haliveB with ⟨k2, h2, hidle2⟩
  refine ⟨fun s => k1 s && k2 s, ?_, ?_⟩
  · rw [tombstone_parked, h2, h1, park_filter_comp]
  · intro s hs
    have hidle : ((abortActor D (abortDesc w.roster.length D w id) id
        ((abortDesc w.roster.length D w id).st id)).st s).phase = .idle := by
      cases hk1 : k1 s
      · exact abort_idle_phase D (abortDesc w.roster.length D w id) id
          ((abortDesc w.roster.length D w id).st id) s (hidle1 s hk1)
      · have hk2 : k2 s = false := by
          have hs' : (k1 s && k2 s) = false := by simpa using hs
          simpa [hk1] using hs'
        exact hidle2 s hk2
    exact (enqueueTombstone_phase D _ id s).trans hidle

theorem exec_queue (I : Impl) (hG : GraphOk I.desc) (w : World) (hH : MailHere I.desc w)
    (hIn : ∀ i, (w.st i).life = .alive → i ∈ w.roster) (id : InstId) (k : Cont) (mb : InstId)
    (hlive : ((execRun I w id (w.st id) k).st mb).life = .alive) :
    QueueGrow ((w.st mb).parked) ((execRun I w id (w.st id) k).st mb).parked := by
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases rest with
    | nil =>
      simpa [execRun] using queue_actor w id { (w.st id) with phase := .idle, typestate := toState } mb rfl
    | cons e tail =>
      cases e with
      | send dst label hint =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact queue_actor w id (proceed (w.st id)
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
        | some dstId =>
          simpa [hr] using plain_grow (enqueue_queue w I.desc id dstId
            { label := label, sender := id, callFrom := none } false
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb)
      | call dst label hint na to =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact queue_actor w id (proceed (w.st id)
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
        | some dstId =>
          simpa [hr] using plain_grow (enqueue_queue w I.desc id dstId
            { label := label, sender := id, callFrom := some id } true
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb)
      | internal =>
        simpa [execRun] using queue_actor w id
          { (w.st id) with phase := .awaitEffect (afterHead ⟨.internal :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb rfl
      | peer onTimeout =>
        simpa [execRun] using queue_actor w id
          { (w.st id) with phase := .awaitPeer (afterHead ⟨(.peer onTimeout) :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb rfl
      | selfSchedule label =>
        simp only [execRun]
        by_cases hany : ((w.st id).prio.any fun p => p.label == label) = true
        · simpa [hany] using queue_actor w id (proceed (w.st id)
            (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
        · by_cases hlt : prioLoad (w.st id).prio < capPrio I.desc w.N id
          · simpa [hany, hlt] using queue_actor w id (proceed { (w.st id) with prio := upsertPrio (w.st id).prio { label := label, sender := id, callFrom := none, reliable := true, mid := (w.st id).nextMid }, nextMid := (w.st id).nextMid + 1 } (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (by simp [proceed_parked])
          · simpa [hany, hlt] using queue_actor w id { (w.st id) with phase := .crashed } mb rfl
      | trySend dst label hint onFull onGone =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact queue_actor w id (proceed (w.st id)
            (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
        | some dstId =>
          simp only [hr]
          split
          · simpa using plain_grow (enqueue_queue w I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb)
          · exact queue_actor w id (proceed (w.st id)
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
      | reply =>
        simp only [execRun]
        unfold performReply
        cases hto : replyTo with
        | none =>
          simpa [hto] using queue_actor w id (proceed (w.st id)
            (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_parked _ _)
        | some caller =>
          cases hcall : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · simp [hto, hcall, hd]
              by_cases hmb : mb = id
              · rw [hmb]
                by_cases hc : caller = id
                · rw [hc]
                  simp [setActor, proceed_parked]
                  exact Or.inl rfl
                · have hflip : ¬ id = caller := fun h => hc h.symm
                  simp [setActor, proceed_parked]
                  rw [if_neg hflip]
                  exact Or.inl rfl
              · by_cases hc : mb = caller
                · rw [hc]
                  have hne : ¬ caller = id := fun h => hmb (hc.trans h)
                  simp [setActor, hne, proceed_parked]
                  exact Or.inl rfl
                · simp [setActor, hmb, hc]
                  exact Or.inl rfl
            · simpa [hto, hcall, hd] using queue_actor w id (proceed (w.st id)
                (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | idle =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | run _ =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | awaitEffect _ =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | awaitPeer _ =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | parked _ _ _ =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
          | crashed =>
            simpa [hto, hcall] using queue_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_parked _ _)
      | cell dst label value =>
        simp only [execRun]
        cases hdirty : (w.cell dst label).dirty
        · simp [hdirty, wakeReaders]
          rw [wakes_parked]
          exact queue_actor (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb
            (by simpa [setCell] using proceed_parked _ _)
        · simp [hdirty]
          exact queue_actor (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb
            (by simpa [setCell] using proceed_parked _ _)
      | terminate =>
        rcases execRun_terminate I w id (w.st id) tail toState replyTo with
          hw | ⟨_, _, _, _, _, _, hw⟩ | ⟨t, _, _, _, _, hw⟩
        · rw [hw] at hlive ⊢
          exact Or.inl rfl
        · rw [hw] at hlive ⊢
          unfold releaseWorld
          by_cases hmb : mb = id
          · exfalso
            let base := refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box)
              (tname id) (w.st id).parked
            let dead : Actor :=
              { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
            have hv := (release_keeps_victim (setActor base id dead) id (w.st id).parked).2
            have hdead : ((releaseWorld I.desc w id (w.st id)).st id).life = .dead := by
              simpa [releaseWorld, base, dead, setActor] using hv
            rw [hmb] at hlive
            rw [hdead] at hlive
            cases hlive
          · have hbase : ∀ i, ((refundParked (refundMsgs (readCells I.desc w id) (tname id)
                (w.st id).box) (tname id) (w.st id).parked).st i).parked = (w.st i).parked := by
              intro i
              rw [refund_park_parked, refund_msgs_parked, readCells_st]
            rw [release_preserves_parked, setActor_other _ id mb _ hmb, hbase]
            exact Or.inl rfl
        · rw [hw] at hlive ⊢
          exact Or.inr (Or.inr (terminate_park_move I.desc w id mb))

theorem drop_calls_sender (ps : List Parked) (caller : InstId)
    (hplain : ∀ p ∈ ps, p.sender = caller → p.isCall = true) :
    ps.filter (fun p => !(p.sender == caller && p.isCall)) =
      ps.filter (fun p => p.sender != caller) := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    have ih' := ih (fun q hq hqs => hplain q (List.Mem.tail _ hq) hqs)
    by_cases hs : p.sender = caller
    · have hc : p.isCall = true := hplain p (List.Mem.head _) hs
      have hb : (p.sender == caller) = true := by simpa [beq_iff_eq] using hs
      have hne : (p.sender != caller) = false := by simpa [bne] using hs
      simp only [List.filter_cons, hb, hc, hne, Bool.and_true, Bool.not_true, ih']
    · have hb : (p.sender == caller) = false := by simpa [beq_iff_eq] using hs
      have hkeep : (p.sender != caller) = true := by simpa [bne] using hs
      simp only [List.filter_cons, hb, hkeep, Bool.false_and, Bool.not_false, ih']

theorem alive_queue (I : Impl) (a : Action) (w w' : World) (h : apply I a w = some w')
    (hO : OpenSlots w) (hOcc : OccInv I w) (hH : MailHere I.desc w) (hG : GraphOk I.desc)
    (mb : InstId) (hlive : (w'.st mb).life = .alive) :
    QueueMove ((w.st mb).parked) ((w'.st mb).parked) := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by simpa [stepWorld] using stepOfApply h
    rcases callTimeout_parked w w' id mb hct with heq | ⟨host, k, _, hhost, hpk⟩
    · exact Or.inl (Or.inl heq)
    · rw [hhost] at hpk ⊢
      have hdec : Decidable (∀ p ∈ (w.st host).parked, p.sender = id → p.isCall = true) :=
        Classical.propDecidable _
      by_cases hmix : ∀ p ∈ (w.st host).parked, p.sender = id → p.isCall = true
      · rw [hpk, drop_calls_sender (w.st host).parked id hmix]
        exact Or.inr ⟨fun s => s != id, rfl⟩
      · -- A plain entry and a call from the same sender are not a sender filter,
        -- and dropping only the call is not a head step.
        skip
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl (Or.inl rfl)
  | ingress dst label =>
    exact Or.inl (Or.inl ((ingress_parked I w w' dst label mb (by simpa [stepWorld] using stepOfApply h)).1))
  | recvBulk id =>
    by_cases hmb : mb = id
    · rw [hmb]
      exact Or.inl (bulk_queue I w w' id (by simpa [stepWorld] using stepOfApply h))
    · exact Or.inl (Or.inl (bulk_other_parked I w w' id mb (by simpa [stepWorld] using stepOfApply h) hmb))
  | recvPrio id =>
    exact Or.inl (Or.inl (prio_parked I w w' id mb (by simpa [stepWorld] using stepOfApply h)))
  | finish id =>
    exact Or.inl (Or.inl (finish_parked I w w' id mb (by simpa [stepWorld] using stepOfApply h)))
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold execHead at h
    by_cases hliveA : (w.st id).life = .alive
    · simp [hliveA] at h
      cases hph : (w.st id).phase with
      | run k =>
        simp [hph] at h
        cases h
        exact grow_step _ _ (exec_queue I hG w hH hOcc.aliveIn id k mb hlive)
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hliveA] at h
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        let nid := InstId.peer template (w.nextIx template)
        let wR : World := ({ w with roster := w.roster ++ [nid], nextIx := fun n => if n = template then w.nextIx n + 1 else w.nextIx n } : World)
        let born : Actor := withTokens I.desc template { life := .alive, typestate := t.initial, phase := .idle, box := [], prio := [], parked := [], tokens := fun _ => 0 }
        have hfree := (hO template (w.nextIx template) (Nat.le_refl _)).2.2
        by_cases hmb : mb = nid
        · rw [hmb, hfree]
          have hs := readCells_st I.desc (setActor wR nid born) nid nid
          rw [hs]
          simp [wR, setActor, born]
          exact Or.inl (Or.inl rfl)
        · have hs := readCells_st I.desc (setActor wR nid born) nid mb
          rw [hs]
          simp [wR, setActor, hmb]
          exact Or.inl (Or.inl rfl)
      · cases h

/-- Dropping a head in front of `s` moves `s` one place closer to the head. -/
theorem recv_closer (I : Impl) (w w' : World) (dst : InstId) (h : receiveBulk I w dst = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st dst).parked = p :: ps) (s : InstId)
    (hne : p.sender ≠ s) (hin : parkIndex (p :: ps) s < (p :: ps).length) :
    parkIndex ((w'.st dst).parked) s + 1 = parkIndex (p :: ps) s ∧
      parkIndex ((w'.st dst).parked) s < ((w'.st dst).parked).length := by
  have hdrop := bulk_drops_head I w w' dst h p ps hp
  have hidx := parkIndex_skip p ps s hne
  have hlt : parkIndex ps s < ps.length := by
    rw [hidx, List.length_cons] at hin
    omega
  rw [hdrop]
  exact ⟨hidx.symm, hlt⟩

theorem filter_absent (ps : List Parked) (keep : InstId → Bool) (s : InstId)
    (hs : keep s = false) :
    parkIndex (ps.filter fun p => keep p.sender) s =
      (ps.filter fun p => keep p.sender).length := by
  induction ps with
  | nil => simp [parkIndex]
  | cons p ps ih =>
    cases hk : keep p.sender
    · have hfilter : (p :: ps).filter (fun q => keep q.sender) =
          ps.filter (fun q => keep q.sender) := by simp [List.filter_cons, hk]
      rw [hfilter]
      exact ih
    · have hps : p.sender ≠ s := by
        intro h
        rw [h, hs] at hk
        cases hk
      have hfilter : (p :: ps).filter (fun q => keep q.sender) =
          p :: ps.filter (fun q => keep q.sender) := by simp [List.filter_cons, hk]
      rw [hfilter, parkIndex_skip p _ s hps, ih]
      simp

theorem index_keep (ps : List Parked) (keep : InstId → Bool) (s : InstId)
    (hs : keep s = true) (hin : parkIndex ps s < ps.length) :
    parkIndex (ps.filter fun p => keep p.sender) s ≤ parkIndex ps s ∧
      parkIndex (ps.filter fun p => keep p.sender) s <
        (ps.filter fun p => keep p.sender).length := by
  induction ps with
  | nil => simp [parkIndex] at hin
  | cons p ps ih =>
    by_cases hps : p.sender = s
    · rw [parkIndex_head p ps s hps]
      have hkeep : keep p.sender = true := by rw [hps]; exact hs
      have hfilter : (p :: ps).filter (fun q => keep q.sender) =
          p :: ps.filter (fun q => keep q.sender) := by
        simp [List.filter_cons, hkeep]
      rw [hfilter, parkIndex_head p _ s hps]
      exact ⟨Nat.le_refl _, Nat.zero_lt_succ _⟩
    · rw [parkIndex_skip p ps s hps] at hin ⊢
      have hin' : parkIndex ps s < ps.length := Nat.lt_of_succ_lt_succ hin
      cases hk : keep p.sender
      · have hfilter : (p :: ps).filter (fun q => keep q.sender) =
            ps.filter (fun q => keep q.sender) := by
          simp [List.filter_cons, hk]
        rw [hfilter]
        obtain ⟨hle, hlt⟩ := ih hin'
        exact ⟨Nat.le_trans hle (Nat.le_succ _), hlt⟩
      · have hfilter : (p :: ps).filter (fun q => keep q.sender) =
            p :: ps.filter (fun q => keep q.sender) := by
          simp [List.filter_cons, hk]
        rw [hfilter, parkIndex_skip p _ s hps]
        obtain ⟨hle, hlt⟩ := ih hin'
        exact ⟨Nat.succ_le_succ hle, Nat.succ_lt_succ hlt⟩

theorem present_kept (ps : List Parked) (keep : InstId → Bool) (s : InstId)
    (hs : keep s = false) (hin : parkIndex ps s < ps.length)
    (heq : ps = ps.filter (fun p => keep p.sender)) : False := by
  induction ps with
  | nil => simp [parkIndex] at hin
  | cons p ps ih =>
    by_cases hps : p.sender = s
    · have hdrop : keep p.sender = false := by rw [hps]; exact hs
      have hfilter : (p :: ps).filter (fun q => keep q.sender) =
          ps.filter (fun q => keep q.sender) := by
        simp [List.filter_cons, hdrop]
      rw [hfilter] at heq
      have hlen := congrArg List.length heq
      simp only [List.length_cons] at hlen
      have hle := List.length_filter_le (fun q : Parked => keep q.sender) ps
      omega
    · have hin' : parkIndex ps s < ps.length := by
        rw [parkIndex_skip p ps s hps, List.length_cons] at hin
        omega
      cases hk : keep p.sender
      · have hfilter : (p :: ps).filter (fun q => keep q.sender) =
            ps.filter (fun q => keep q.sender) := by
          simp [List.filter_cons, hk]
        rw [hfilter] at heq
        have hlen := congrArg List.length heq
        simp only [List.length_cons] at hlen
        have hle := List.length_filter_le (fun q : Parked => keep q.sender) ps
        omega
      · have hfilter : (p :: ps).filter (fun q => keep q.sender) =
            p :: ps.filter (fun q => keep q.sender) := by
          simp [List.filter_cons, hk]
        rw [hfilter] at heq
        injection heq with _ htail
        exact ih hin' htail

theorem append_not_filter (ps : List Parked) (a : Parked) (keep : InstId → Bool) :
    ps ++ [a] ≠ ps.filter (fun p => keep p.sender) := by
  intro h
  have hle := List.length_filter_le (fun p : Parked => keep p.sender) ps
  rw [← h] at hle
  simp at hle
  omega

theorem plain_not_drop (old new : List Parked) (keep : InstId → Bool) (s : InstId)
    (h : QueuePlain old new) (hk : new = old.filter (fun p => keep p.sender))
    (hs : keep s = false) (hin : parkIndex old s < old.length) : False := by
  rcases h with h | ⟨a, h⟩
  · exact present_kept old keep s hs hin (h.symm.trans hk)
  · exact append_not_filter old a keep (h.symm.trans hk)

theorem grow_index (old new : List Parked) (s : InstId) (h : QueueGrow old new)
    (hkeep : ∀ (keep : InstId → Bool),
      new = old.filter (fun p => keep p.sender) → keep s = true)
    (hin : parkIndex old s < old.length) :
    parkIndex new s ≤ parkIndex old s ∧ parkIndex new s < new.length := by
  rcases h with h | h | ⟨keep, hk⟩
  · simp [h, hin]
  · obtain ⟨a, ha⟩ := h
    rw [ha]
    have hidx := parkIndex_append old s a hin
    refine ⟨Nat.le_of_eq hidx, ?_⟩
    rw [hidx, List.length_append]
    simp
    exact Nat.lt_succ_of_lt hin
  · rw [hk]
    exact index_keep old keep s (hkeep keep hk) hin

theorem set_false (w : World) (id : InstId) (a : Actor) (mb s : InstId) (keep : InstId → Bool)
    (hp : a.parked = (w.st id).parked) (hs : keep s = false)
    (hk : ((setActor w id a).st mb).parked = (w.st mb).parked.filter (fun p => keep p.sender))
    (hin : parkIndex (w.st mb).parked s < (w.st mb).parked.length) : False :=
  present_kept _ keep s hs hin ((queue_set w id a mb hp).symm.trans hk)

/-- A parked sender who is still parked was not removed by the step. -/
theorem exec_sender_false (I : Impl) (w : World) (id : InstId) (k : Cont) (s mb : InstId)
    (c : Bool) (k' : Cont) (keep : InstId → Bool)
    (halive : ((execRun I w id (w.st id) k).st mb).life = .alive)
    (hph : ((execRun I w id (w.st id) k).st s).phase = .parked mb c k')
    (hs : keep s = false)
    (hk : ((execRun I w id (w.st id) k).st mb).parked =
      (w.st mb).parked.filter (fun p => keep p.sender))
    (hin : parkIndex (w.st mb).parked s < (w.st mb).parked.length) : False := by
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases rest with
    | nil =>
      simp only [execRun] at hk
      exact set_false w id { (w.st id) with phase := .idle, typestate := toState } mb s keep rfl hs hk hin
    | cons e tail =>
      cases e with
      | send dst label hint =>
        simp only [execRun] at hk
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr] at hk
          exact set_false w id (proceed (w.st id)
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (proceed_parked _ _) hs hk hin
        | some dstId =>
          simp only [hr] at hk
          exact plain_not_drop _ _ keep s (enqueue_queue w I.desc id dstId
            { label := label, sender := id, callFrom := none } false
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb) hk hs hin
      | call dst label hint na to =>
        simp only [execRun] at hk
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr] at hk
          exact set_false w id (proceed (w.st id)
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (proceed_parked _ _) hs hk hin
        | some dstId =>
          simp only [hr] at hk
          exact plain_not_drop _ _ keep s (enqueue_queue w I.desc id dstId
            { label := label, sender := id, callFrom := some id } true
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb) hk hs hin
      | internal =>
        simp only [execRun] at hk
        exact set_false w id
          { (w.st id) with phase := .awaitEffect (afterHead ⟨.internal :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb s keep rfl hs hk hin
      | peer onTimeout =>
        simp only [execRun] at hk
        exact set_false w id
          { (w.st id) with phase := .awaitPeer (afterHead ⟨(.peer onTimeout) :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb s keep rfl hs hk hin
      | selfSchedule label =>
        simp only [execRun] at hk
        by_cases hany : ((w.st id).prio.any fun p => p.label == label) = true
        · simp only [hany] at hk
          exact set_false w id (proceed (w.st id)
            (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (proceed_parked _ _) hs hk hin
        · by_cases hlt : prioLoad (w.st id).prio < capPrio I.desc w.N id
          · simp only [hany, hlt] at hk
            exact set_false w id (proceed { (w.st id) with prio := upsertPrio (w.st id).prio { label := label, sender := id, callFrom := none, reliable := true, mid := (w.st id).nextMid }, nextMid := (w.st id).nextMid + 1 } (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep (by simp [proceed_parked]) hs hk hin
          · simp only [hany, hlt] at hk
            exact set_false w id { (w.st id) with phase := .crashed } mb s keep rfl hs hk hin
      | trySend dst label hint onFull onGone =>
        simp only [execRun] at hk
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr] at hk
          exact set_false w id (proceed (w.st id)
            (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (proceed_parked _ _) hs hk hin
        | some dstId =>
          simp only [hr] at hk
          split at hk
          · exact plain_not_drop _ _ keep s (enqueue_queue w I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb) hk hs hin
          · exact set_false w id (proceed (w.st id)
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
      | reply =>
        simp only [execRun] at hk
        unfold performReply at hk
        cases hto : replyTo with
        | none =>
          simp only [hto] at hk
          exact set_false w id (proceed (w.st id)
            (afterHead ⟨.reply :: tail, toState, none⟩)) mb s keep (proceed_parked _ _) hs hk hin
        | some caller =>
          cases hcall : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · simp only [hto, hcall, hd] at hk
              by_cases hmb : mb = id
              · rw [hmb] at hk hin
                by_cases hc : caller = id
                · rw [hc] at hk
                  simp [setActor, proceed_parked] at hk
                  exact present_kept _ keep s hs hin hk
                · have hflip : id ≠ caller := fun h => hc h.symm
                  simp [setActor, proceed_parked] at hk
                  rw [if_neg hflip] at hk
                  exact present_kept _ keep s hs hin hk
              · by_cases hc : mb = caller
                · rw [hc] at hk hin
                  have hne : caller ≠ id := fun h => hmb (hc.trans h)
                  simp [setActor, hne, proceed_parked] at hk
                  exact present_kept _ keep s hs hin hk
                · simp [setActor, hmb, hc] at hk
                  exact present_kept _ keep s hs hin hk
            · simp only [hto, hcall, hd] at hk
              exact set_false w id (proceed (w.st id)
                (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
                (proceed_parked _ _) hs hk hin
          | idle =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
          | run _ =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
          | awaitEffect _ =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
          | awaitPeer _ =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
          | parked _ _ _ =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
          | crashed =>
            simp only [hto, hcall] at hk
            exact set_false w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb s keep
              (proceed_parked _ _) hs hk hin
      | cell dst label value =>
        simp only [execRun] at hk
        cases hdirty : (w.cell dst label).dirty
        · simp [hdirty, wakeReaders] at hk
          rw [wakes_parked] at hk
          exact set_false (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (by simpa [setCell] using proceed_parked _ _) hs hk hin
        · simp only [hdirty] at hk
          exact set_false (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb s keep
            (by simpa [setCell] using proceed_parked _ _) hs hk hin
      | terminate =>
        rcases execRun_terminate I w id (w.st id) tail toState replyTo with
          hw | ⟨_, _, _, _, _, _, hw⟩ | ⟨_, _, _, _, _, hw⟩
        · rw [hw] at hk
          exact present_kept _ keep s hs hin hk
        · rw [hw] at hk halive
          by_cases hmb : mb = id
          · let base := refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box)
              (tname id) (w.st id).parked
            let dead : Actor :=
              { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
            have hv := (release_keeps_victim (setActor base id dead) id (w.st id).parked).2
            have hdead : ((releaseWorld I.desc w id (w.st id)).st id).life = .dead := by
              simpa [releaseWorld, base, dead, setActor] using hv
            rw [hmb, hdead] at halive
            cases halive
          · have hpark := releaseWorld_parked I.desc w id (w.st id) mb hmb
            rw [hpark] at hk
            exact present_kept _ keep s hs hin hk
        · rw [hw] at hk hph halive
          rcases terminate_drops I.desc w id mb halive with ⟨keep', hkeep', hidle⟩
          cases hks : keep' s
          · have hidleS := hidle s hks
            rw [hidleS] at hph
            cases hph
          · have hlt := (index_keep (w.st mb).parked keep' s hks hin).2
            rw [← hkeep', hk, filter_absent (w.st mb).parked keep s hs] at hlt
            omega

theorem bulk_head_unblocks (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) (s : InstId)
    (hs : s = p.sender) (hne : s ≠ id) (k : Cont) (hph : (w.st s).phase = .parked id false k) :
    waitKind (w'.st s) ≠ some (.blockingSend id) := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hst := deliver_st I w id _ p.msg w1 a1 s hdel
        have hpre := install_sender_phase w w1 id a1 p.msg.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self]
        exact resume_leaves_block _ id k p.isCall (hpre.trans hph)
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        have hst := deliver_st I w id _ m w1 a1 s hdel
        have hpre := install_sender_phase w w1 id admitted m.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self, admitted]
        exact resume_leaves_block _ id k p.isCall (hpre.trans hph)

theorem resume_not_parked (a : Actor) (dst : InstId) (k : Cont) (b c : Bool)
    (h : a.phase = .parked dst c k) : ∀ d bit k', (resumeSender a b dst).phase ≠ .parked d bit k' := by
  intro d bit k' hbad
  cases b with
  | false =>
    cases hk : k.rest with
    | nil => simp [resumeSender, h, proceed, hk] at hbad
    | cons _ _ => simp [resumeSender, h, proceed, hk] at hbad
  | true => simp [resumeSender, h] at hbad

/-- A bulk receive whose parked head is `s` takes `s` out of every parked phase. -/
theorem bulk_head_leaves (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) (s : InstId)
    (hs : s = p.sender) (hne : s ≠ id) (c : Bool) (k : Cont)
    (hph : (w.st s).phase = .parked id c k) :
    ∀ d bit k', ((w'.st s).phase) ≠ .parked d bit k' := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hst := deliver_st I w id _ p.msg w1 a1 s hdel
        have hpre := install_sender_phase w w1 id a1 p.msg.sender s (by simpa [hs] using hne) hst
        intro d bit k' hbad
        rw [hs] at hpre hph hbad
        simp only [setActor_self] at hbad
        exact resume_not_parked _ id k p.isCall c (hpre.trans hph) d bit k' hbad
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        have hst := deliver_st I w id _ m w1 a1 s hdel
        have hpre := install_sender_phase w w1 id admitted m.sender s (by simpa [hs] using hne) hst
        intro d bit k' hbad
        rw [hs] at hpre hph hbad
        simp only [setActor_self, admitted] at hbad
        exact resume_not_parked _ id k p.isCall c (hpre.trans hph) d bit k' hbad

/-- Dropping another sender's parked entries does not move `s` later in the queue. -/
theorem index_filter (ps : List Parked) (dead s : InstId) (hs : s ≠ dead)
    (hin : parkIndex ps s < ps.length) :
    parkIndex (ps.filter fun p => p.sender != dead) s ≤ parkIndex ps s ∧
      parkIndex (ps.filter fun p => p.sender != dead) s <
        (ps.filter fun p => p.sender != dead).length := by
  induction ps with
  | nil => simp [parkIndex] at hin
  | cons p ps ih =>
    by_cases hps : p.sender = s
    · rw [parkIndex_head p ps s hps]
      have hkeep : (p.sender != dead) = true := by
        rw [hps]
        simpa [bne, beq_iff_eq] using hs
      have hfilter : (p :: ps).filter (fun q => q.sender != dead) =
          p :: ps.filter (fun q => q.sender != dead) := by
        simp [List.filter_cons, hkeep]
      rw [hfilter, parkIndex_head p _ s hps]
      exact ⟨Nat.le_refl _, Nat.zero_lt_succ _⟩
    · rw [parkIndex_skip p ps s hps] at hin ⊢
      have hin' : parkIndex ps s < ps.length := Nat.lt_of_succ_lt_succ hin
      by_cases hdead : p.sender = dead
      · have hdrop : (p.sender != dead) = false := by simpa [bne, beq_iff_eq] using hdead
        have hfilter : (p :: ps).filter (fun q => q.sender != dead) =
            ps.filter (fun q => q.sender != dead) := by
          rw [List.filter_cons, hdrop]
          simp
        rw [hfilter]
        obtain ⟨hle, hlt⟩ := ih hin'
        exact ⟨Nat.le_trans hle (Nat.le_succ _), hlt⟩
      · have hkeep : (p.sender != dead) = true := by simpa [bne, beq_iff_eq] using hdead
        have hfilter : (p :: ps).filter (fun q => q.sender != dead) =
            p :: ps.filter (fun q => q.sender != dead) := by
          simp [List.filter_cons, hkeep]
        rw [hfilter, parkIndex_skip p _ s hps]
        obtain ⟨hle, hlt⟩ := ih hin'
        exact ⟨Nat.succ_le_succ hle, Nat.succ_lt_succ hlt⟩

/-- While the sender stays parked and the receiver stays alive, a kill fold does not
raise the sender's index. Killing either of them would end the wait. -/
theorem killFold_index (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (s dst : InstId) (c : Bool) (k' : Cont)
    (hph : ((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st s).phase =
      .parked dst c k')
    (halive : ((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st dst).life =
      .alive)
    (hin : parkIndex ((w.st dst).parked) s < ((w.st dst).parked).length) :
    parkIndex (((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st dst).parked) s ≤
        parkIndex ((w.st dst).parked) s ∧
      parkIndex (((ids.foldl (fun w id =>
        if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st dst).parked) s <
        (((ids.foldl (fun w id =>
          if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st dst).parked).length := by
  induction ids generalizing w with
  | nil =>
    simp at hph halive ⊢
    exact hin
  | cons j js ih =>
    simp only [List.foldl_cons] at hph halive ⊢
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true] at hph halive ⊢
      by_cases hs : s = j
      · subst hs
        have hself := killOne_self w D s
        have hidle := killFold_keeps_idle (killOne w D s) D sub key js s hself.1 hself.2.1
        rw [hidle] at hph
        cases hph
      · by_cases hd : dst = j
        · subst hd
          have hself := killOne_self w D dst
          exact absurd halive (killFold_stays_dead (killOne w D dst) D sub key js dst
            (by rw [hself.1]; intro h; cases h))
        · have hfate := killOne_parked_fate w D j dst hd
          have hidx : parkIndex (((killOne w D j).st dst).parked) s ≤ parkIndex ((w.st dst).parked) s ∧
              parkIndex (((killOne w D j).st dst).parked) s <
                (((killOne w D j).st dst).parked).length := by
            rcases hfate with heq | heq
            · rw [heq]
              exact ⟨Nat.le_refl _, hin⟩
            · rw [heq]
              exact index_filter ((w.st dst).parked) j s hs hin
          obtain ⟨hle, hlt⟩ := ih (killOne w D j) hph halive hidx.2
          exact ⟨Nat.le_trans hle hidx.1, hlt⟩
    · simp only [hcond] at hph halive ⊢
      exact ih w hph halive hin

theorem killSubtree_index (w : World) (D : Description) (sub : String) (key : Nat)
    (s dst : InstId) (c : Bool) (k' : Cont)
    (hph : ((killSubtree w D sub key).st s).phase = .parked dst c k')
    (halive : ((killSubtree w D sub key).st dst).life = .alive)
    (hin : parkIndex ((w.st dst).parked) s < ((w.st dst).parked).length) :
    parkIndex (((killSubtree w D sub key).st dst).parked) s ≤ parkIndex ((w.st dst).parked) s ∧
      parkIndex (((killSubtree w D sub key).st dst).parked) s <
        (((killSubtree w D sub key).st dst).parked).length := by
  have hph' : ((w.roster.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st s).phase =
      .parked dst c k' := by
    simpa [killSubtree, killMembers] using hph
  have halive' : ((w.roster.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st dst).life =
      .alive := by
    simpa [killSubtree, killMembers] using halive
  simpa [killSubtree, killMembers] using
    killFold_index w D sub key w.roster s dst c k' hph' halive' hin

theorem parkIndex_keep_sender (ps : List Parked) (keep : Parked → Bool) (s : InstId)
    (hkeep : ∀ p ∈ ps, p.sender = s → keep p = true)
    (hin : parkIndex ps s < ps.length) :
    parkIndex (ps.filter keep) s ≤ parkIndex ps s ∧
      parkIndex (ps.filter keep) s < (ps.filter keep).length := by
  induction ps with
  | nil => simp [parkIndex] at hin
  | cons p ps ih =>
    have htail : ∀ q ∈ ps, q.sender = s → keep q = true :=
      fun q hq => hkeep q (List.Mem.tail _ hq)
    by_cases hs : p.sender = s
    · have hk : keep p = true := hkeep p (List.Mem.head _) hs
      have hfilter : (p :: ps).filter keep = p :: ps.filter keep := by
        simp [hk]
      rw [hfilter, parkIndex_head p (ps.filter keep) s hs, parkIndex_head p ps s hs]
      exact ⟨Nat.le_refl _, by simp⟩
    · rw [parkIndex_skip p ps s hs] at hin ⊢
      have hin' : parkIndex ps s < ps.length := by
        simp [List.length] at hin
        omega
      have ih' := ih htail hin'
      cases hk : keep p with
      | true =>
        have hfilter : (p :: ps).filter keep = p :: ps.filter keep := by simp [List.filter_cons, hk]
        rw [hfilter, parkIndex_skip p (ps.filter keep) s hs]
        refine ⟨Nat.succ_le_succ ih'.1, by simp; omega⟩
      | false =>
        have hfilter : (p :: ps).filter keep = ps.filter keep := by simp [List.filter_cons, hk]
        rw [hfilter]
        exact ⟨Nat.le_trans ih'.1 (Nat.le_succ _), ih'.2⟩

/-- While a parked wait stays parked on a live receiver, its queue index does not increase. -/
theorem step_index (I : Impl) (hG : GraphOk I.desc) (a : Action) (w w' : World)
    (h : apply I a w = some w') (hO : OpenSlots w) (hH : MailHere I.desc w)
    (hIn : ∀ i, (w.st i).life = .alive → i ∈ w.roster) (s dst : InstId) (c : Bool) (k k' : Cont)
    (hph : (w.st s).phase = .parked dst c k)
    (hph' : (w'.st s).phase = .parked dst c k')
    (halive : (w.st dst).life = .alive) (halive' : (w'.st dst).life = .alive)
    (hin : parkIndex ((w.st dst).parked) s < ((w.st dst).parked).length) :
    parkIndex ((w'.st dst).parked) s ≤ parkIndex ((w.st dst).parked) s ∧
      parkIndex ((w'.st dst).parked) s < ((w'.st dst).parked).length := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by simpa [stepWorld] using stepOfApply h
    have hne : s ≠ id := by
      intro hs
      exfalso
      rcases callTimeout_self w w' id hct with ⟨_, k0, _, hproc⟩ | ⟨_, k0, _, hproc⟩ | ⟨k0, _, hproc⟩
      · rw [hs] at hph'
        rw [hproc] at hph'
        cases hr : (selectCall k0 .timedOut).rest <;> simp [proceed, hr] at hph' <;> cases hph'
      · rw [hs] at hph'
        rw [hproc] at hph'
        cases hr : (selectCall k0 .notAdmitted).rest <;> simp [proceed, hr] at hph' <;> cases hph'
      · rw [hs] at hph'
        rw [hproc] at hph'
        cases hr : k0.onTimeout <;> simp [proceed, hr] at hph' <;> cases hph'
    rcases callTimeout_parked w w' id dst hct with heq | ⟨host, _, _, hhost, hpk⟩
    · rw [heq]
      exact ⟨Nat.le_refl _, hin⟩
    · rw [← hhost] at hpk
      rw [hpk]
      exact parkIndex_keep_sender ((w.st dst).parked)
        (fun p => !(p.sender == id && p.isCall)) s
        (by
          intro p _ hsnd
          have hb : (p.sender == id) = false := by
            simpa [beq_iff_eq] using fun hsq => hne (hsnd.symm.trans hsq)
          simp [hb])
        hin
  | stutter =>
    cases stutter_unchanged I w w' h
    exact ⟨Nat.le_refl _, hin⟩
  | ingress who label =>
    have hpk := (ingress_parked I w w' who label dst (by simpa [stepWorld] using stepOfApply h)).1
    rw [hpk]
    exact ⟨Nat.le_refl _, hin⟩
  | recvBulk id =>
    by_cases hid : id = dst
    · rw [hid] at h
      cases hp : (w.st dst).parked with
      | nil => simp [parkIndex, hp] at hin
      | cons p ps =>
        rw [hp] at hin
        by_cases hs : p.sender = s
        · exfalso
          have hrecv : receiveBulk I w dst = some w' := by simpa [stepWorld] using stepOfApply h
          have hne : s ≠ dst := by
            intro heq
            unfold receiveBulk at hrecv
            by_cases hready : (w.st dst).life ≠ .alive ∨ (w.st dst).phase ≠ .idle
            · simp [hready] at hrecv
            · have hidle : (w.st dst).phase = .idle := by
                by_cases hpI : (w.st dst).phase = .idle
                · exact hpI
                · exact False.elim (hready (Or.inr hpI))
              rw [← heq] at hidle
              simp [hph] at hidle
          have hleft := bulk_head_leaves I w w' dst hrecv p ps hp s (by rw [hs]) hne c k hph
          exact hleft dst c k' hph'
        · have hrec := recv_closer I w w' dst (by simpa [stepWorld] using stepOfApply h) p ps hp s hs hin
          constructor
          · rw [← hrec.1]
            exact Nat.le_succ _
          · exact hrec.2
    · have heq := bulk_other_parked I w w' id dst (by simpa [stepWorld] using stepOfApply h) (fun h => hid h.symm)
      rw [heq]
      exact ⟨Nat.le_refl _, hin⟩
  | recvPrio id =>
    have heq := prio_parked I w w' id dst (by simpa [stepWorld] using stepOfApply h)
    rw [heq]
    exact ⟨Nat.le_refl _, hin⟩
  | finish id =>
    have heq := finish_parked I w w' id dst (by simpa [stepWorld] using stepOfApply h)
    rw [heq]
    exact ⟨Nat.le_refl _, hin⟩
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold execHead at h
    by_cases hrun : (w.st id).life = .alive
    · simp [hrun] at h
      cases hphase : (w.st id).phase with
      | run kk =>
        simp [hphase] at h
        cases h
        have hkeep : ∀ (keep : InstId → Bool), ((execRun I w id (w.st id) kk).st dst).parked =
            (w.st dst).parked.filter (fun p => keep p.sender) → keep s = true := by
          intro keep hk
          cases hks : keep s
          · exact False.elim (exec_sender_false I w id kk s dst c k' keep halive' hph' hks hk hin)
          · exact rfl
        exact grow_index _ _ s (exec_queue I hG w hH hIn id kk dst halive') hkeep hin
      | idle => simp [hphase] at h
      | parked _ _ _ => simp [hphase] at h
      | awaitReply _ _ => simp [hphase] at h
      | awaitEffect _ => simp [hphase] at h
      | awaitPeer _ => simp [hphase] at h
      | crashed => simp [hphase] at h
    · simp [hrun] at h
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        let nid := InstId.peer template (w.nextIx template)
        let wR : World := ({ w with roster := w.roster ++ [nid], nextIx := fun n => if n = template then w.nextIx n + 1 else w.nextIx n } : World)
        let born : Actor := withTokens I.desc template { life := .alive, typestate := t.initial, phase := .idle, box := [], prio := [], parked := [], tokens := fun _ => 0 }
        have hfresh : dst ≠ nid := by
          intro heq
          have habsent := (hO template (w.nextIx template) (Nat.le_refl _)).1
          rw [heq] at halive
          rw [habsent] at halive
          cases halive
        have hs := readCells_st I.desc (setActor wR nid born) nid dst
        rw [hs]
        simp only [wR, setActor, hfresh]
        exact And.intro (Nat.le_refl _) hin
      · cases h

theorem index_zero_head (ps : List Parked) (s : InstId) (h : parkIndex ps s = 0)
    (hlen : 0 < ps.length) : ∃ p rest, ps = p :: rest ∧ p.sender = s := by
  cases ps with
  | nil => simp at hlen
  | cons p rest =>
    by_cases hs : p.sender = s
    · exact ⟨p, rest, rfl, hs⟩
    · have hidx := parkIndex_skip p rest s hs
      simp [hidx] at h

theorem index_mono (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (c : Bool) (i n : Nat)
    (hstay : ∀ t, i ≤ t → t ≤ i + n → ∃ k, ((ρ.cfg t).st s).phase = .parked dst c k)
    (halive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st dst).life = .alive)
    (hin : parkIndex (((ρ.cfg i).st dst).parked) s < (((ρ.cfg i).st dst).parked).length) :
    parkIndex (((ρ.cfg (i + n)).st dst).parked) s ≤ parkIndex (((ρ.cfg i).st dst).parked) s ∧
      parkIndex (((ρ.cfg (i + n)).st dst).parked) s <
        (((ρ.cfg (i + n)).st dst).parked).length := by
  induction n with
  | zero =>
    simp only [Nat.add_zero]
    exact And.intro (Nat.le_refl _) hin
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hstay t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => halive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.1.2.2
    obtain ⟨k0, hk0⟩ := hstay (i + n) (Nat.le_add_right i n) (by omega)
    obtain ⟨k1, hk1⟩ := hstay (i + n + 1) (by omega) (by omega)
    have hHere := mail_here_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))
    have hIn := (inv_reachable I N (ρ.cfg (i + n)) hL (cfg_reachable ρ (i + n))).1.rostered
    have hstep := step_index I hG (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) (ρ.valid (i + n))
      hO hHere hIn s dst c k0 k1 hk0 hk1
      (halive (i + n) (Nat.le_add_right i n) (by omega))
      (halive (i + n + 1) (by omega) (by omega))
      hprev.2
    exact And.intro (Nat.le_trans hstep.1 hprev.1) hstep.2

/-- A bulk label is a call the program list actually contains. -/
def callSite (I : Impl) (template label : String) : Prop :=
  (template, label) ∈ callSites I.transitions

/-- A queued bulk message is either not a call, or a call label the receiver's
template handles. `callFrom none` is delivered even when no transition matches;
a call is not. -/
def msgOk (I : Impl) (mb : InstId) (m : Msg) : Prop :=
  m.callFrom = none ∨ callSite I (tname mb) m.label

theorem msgOk_mid (I : Impl) (mb : InstId) (msg : Msg) (n : Nat) (h : msgOk I mb msg) :
    msgOk I mb { msg with mid := n } := by
  rcases h with h | h
  · exact Or.inl (by simpa using h)
  · exact Or.inr (by simpa using h)

/-- Every bulk message sitting in a mailbox is one `deliver` can take. -/
def MailAccepted (I : Impl) (w : World) : Prop :=
  (∀ id m, m ∈ (w.st id).box → msgOk I id m) ∧
    (∀ id p, p ∈ (w.st id).parked → msgOk I id p.msg)

theorem keys_nodup (I : Impl) (hL : LocalOk I) : (I.transitions.map trKey).Nodup := by
  have hU := unique_keys_local I hL
  simp only [uniqueKeys] at hU
  have hlen : (I.transitions.map trKey).length = (dedup (I.transitions.map trKey)).length := by
    simpa [beq_iff_eq] using hU
  exact nodup_of_dedup_len _ hlen.symm

theorem unique_key_list (xs : List Transition) (hnd : (xs.map trKey).Nodup) (tr1 tr2 : Transition)
    (h1 : tr1 ∈ xs) (h2 : tr2 ∈ xs) (hk : trKey tr1 = trKey tr2) : tr1 = tr2 := by
  induction xs with
  | nil => cases h1
  | cons x xs ih =>
    have hcons := (List.nodup_cons).mp hnd
    cases h1 with
    | head =>
      cases h2 with
      | head => rfl
      | tail _ h2 =>
        exact absurd (List.mem_map.mpr ⟨tr2, h2, hk.symm⟩) hcons.1
    | tail _ h1 =>
      cases h2 with
      | head =>
        exact absurd (List.mem_map.mpr ⟨tr1, h1, hk⟩) hcons.1
      | tail _ h2 =>
        exact ih hcons.2 h1 h2

theorem unique_key_eq (I : Impl) (hL : LocalOk I) (tr1 tr2 : Transition)
    (h1 : tr1 ∈ I.transitions) (h2 : tr2 ∈ I.transitions) (hk : trKey tr1 = trKey tr2) :
    tr1 = tr2 :=
  unique_key_list I.transitions (keys_nodup I hL) tr1 tr2 h1 h2 hk

theorem findTr_unique (I : Impl) (hL : LocalOk I) (tr : Transition)
    (hm : tr ∈ I.transitions) (template state label : String)
    (ht : tr.template = template) (hs : tr.fromState = state) (hl : tr.label = label) :
    findTr I template state label = some tr := by
  cases hf : findTr I template state label with
  | some tr' =>
    obtain ⟨hm', ht', hs', hl'⟩ := findTr_mem I template state label tr' hf
    have hk : trKey tr = trKey tr' := by simp [trKey, ht, hs, hl, ht', hs', hl']
    exact congrArg some (unique_key_eq I hL tr tr' hm hm' hk).symm
  | none =>
    unfold findTr at hf
    have hnone : ∀ x ∈ I.transitions,
        (if x.template == template && x.fromState == state && x.label == label then some x else none) = none := by
      intro x hx
      simpa using (List.findSome?_eq_none_iff.mp hf) x hx
    have hbad := hnone tr hm
    simp [ht, hs, hl] at hbad

theorem find_accepts (I : Impl) (hL : LocalOk I) (template label state : String)
    (hsite : callSite I template label)
    (ht : ∃ t, templateOf I.desc template = some t ∧ state ∈ t.states) :
    ∃ tr, findTr I template state label = some tr ∧ tr.acceptsCall = true := by
  have htot := (local_parts I hL).2.1
  unfold callTotal at htot
  have hall := (List.all_eq_true _ _).mp htot (template, label) hsite
  obtain ⟨t, htpl, hst⟩ := ht
  simp [htpl] at hall
  obtain ⟨tr, hm, hcond⟩ := hall state hst
  have hf := findTr_unique I hL tr hm template state label hcond.1.1.1 hcond.1.1.2 hcond.1.2
  exact ⟨tr, hf, hcond.2⟩

theorem deliver_msg (I : Impl) (hL : LocalOk I) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (hl : a.life = .alive) (hst : ∃ t, templateOf I.desc (tname id) = some t ∧ a.typestate ∈ t.states)
    (hm : msgOk I id m) : ∃ w1 a1, deliver I w id a m = some (w1, a1) := by
  cases hc : m.callFrom with
  | none =>
    simp [deliver, hl, hc]
    split
    · exact ⟨_, _, rfl⟩
    · rename_i _ _
      simp [hc]
  | some _ =>
    rcases hm with hnone | hsite
    · simp [hc] at hnone
    · obtain ⟨tr, hf, hacc⟩ := find_accepts I hL (tname id) m.label a.typestate hsite hst
      simp [deliver, hl, hf, hc, hacc]

theorem ty_state_mem (D : Description) (w : World) (id : InstId) (hT : TyOk D w)
    (hl : (w.st id).life = .alive) :
    ∃ t, templateOf D (tname id) = some t ∧ (w.st id).typestate ∈ t.states := by
  have helem := hT id hl
  simp [statesOf] at helem
  cases ht : templateOf D (tname id) with
  | none => simp [ht] at helem
  | some t =>
    simp [ht, List.elem_eq_mem] at helem
    exact ⟨t, rfl, helem⟩

theorem can_receive_enabled (I : Impl) (hL : LocalOk I) (w : World) (id : InstId)
    (hT : TyOk I.desc w) (hA : MailAccepted I w) (h : CanReceive w id) :
    Enabled I w (.recvBulk id) := by
  rcases h with ⟨⟨hlive, hidle⟩, hmail⟩
  unfold alive at hlive
  have hst := ty_state_mem I.desc w id hT hlive
  unfold Enabled
  dsimp [apply, receiveBulk]
  simp only [hlive, hidle, ne_eq, not_true_eq_false, Bool.false_or, Bool.or_false, ite_false]
  cases hbox : (w.st id).box with
  | cons m ms =>
    have hm := hA.1 id m (by simp [hbox])
    obtain ⟨w1, a1, hdel⟩ := deliver_msg I hL w id { (w.st id) with box := ms, phase := .idle } m
      (by simp [hlive]) (by simpa [hidle] using hst) hm
    cases hpark : (w.st id).parked with
    | nil =>
      simp [hlive, hidle, hpark] at hdel
      simpa [hbox, hpark, hdel]
    | cons head tail =>
      simp [hlive, hidle, hpark] at hdel
      simpa [hbox, hpark, hdel]
  | nil =>
    cases hpark : (w.st id).parked with
    | nil =>
      rcases hmail with hmail | hmail <;> simp [hbox, hpark] at hmail
    | cons p ps =>
      have hm := hA.2 id p (by simp [hpark])
      obtain ⟨w1, a1, hdel⟩ := deliver_msg I hL w id { (w.st id) with parked := ps, phase := .idle } p.msg
        (by simp [hlive]) (by simpa [hidle] using hst) hm
      simp [hlive, hidle, hbox] at hdel
      simpa [hbox, hpark, hdel]

theorem mail_from_box (I : Impl) (w : World) (hA : MailAccepted I w) (id : InstId) (m : Msg)
    (h : m ∈ (w.st id).box ∨ msgOk I id m) : msgOk I id m := by
  rcases h with h | h
  · exact hA.1 id m h
  · exact h

theorem mail_from_park (I : Impl) (w : World) (hA : MailAccepted I w) (id : InstId) (p : Parked)
    (h : p ∈ (w.st id).parked ∨ msgOk I id p.msg) : msgOk I id p.msg := by
  rcases h with h | h
  · exact hA.2 id p h
  · exact h

theorem foldl_keep {α} [DecidableEq α] (acc xs : List α) (x : α) (h : x ∈ acc ∨ x ∈ xs) :
    x ∈ xs.foldl (fun acc y => if acc.elem y then acc else acc ++ [y]) acc := by
  induction xs generalizing acc with
  | nil =>
    simp at h
    simpa using h
  | cons y ys ih =>
    simp only [List.foldl_cons]
    by_cases he : acc.elem y = true
    · simp only [he, ite_true]
      apply ih
      cases h with
      | inl hx => exact Or.inl hx
      | inr hxs =>
        cases List.mem_cons.mp hxs with
        | inl heq =>
          subst heq
          exact Or.inl (List.elem_iff.mp he)
        | inr ht => exact Or.inr ht
    · have hf : acc.elem y = false := by
        cases hbb : acc.elem y <;> simp_all
      simp only [hf]
      apply ih
      cases h with
      | inl hx => exact Or.inl (List.mem_append_left _ hx)
      | inr hxs =>
        cases List.mem_cons.mp hxs with
        | inl heq =>
          subst heq
          exact Or.inl (List.mem_append_right _ (by simp))
        | inr ht => exact Or.inr ht

theorem dedup_mem {α} [DecidableEq α] (xs : List α) (x : α) (h : x ∈ xs) : x ∈ dedup xs := by
  simpa [dedup] using foldl_keep [] xs x (Or.inr h)

def callPairs (es : List Eff) : List (String × String) :=
  es.filterMap fun e =>
    match e with
    | .call dst lab _ na to => some (dst, lab)
    | _ => none

theorem callSites_pairs (trs : List Transition) : callSites trs =
    match trs with
    | [] => []
    | tr :: ts => dedup (callPairs tr.program ++ callSites ts) := by
  cases trs <;> rfl

theorem filter_call_mem (es : List Eff) (d l : String) (n : Nat) (na to : List Eff)
    (h : Eff.call d l n na to ∈ es) :
    (d, l) ∈ callPairs es := by
  induction es with
  | nil => cases h
  | cons e es ih =>
    cases h with
    | head => simp [callPairs, List.filterMap]
    | tail _ ht =>
      cases e with
      | call a b c na to =>
        rw [callPairs, List.filterMap_cons]
        exact List.mem_cons_of_mem _ (by simpa [callPairs] using ih ht)
      | send a b c =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | trySend a b c onFull onGone =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | reply =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | selfSchedule a =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | cell a b c =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | internal =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | peer onTimeout =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht
      | terminate =>
        rw [callPairs, List.filterMap_cons]
        simpa [callPairs] using ih ht

theorem call_in_sites (trs : List Transition) (tr : Transition) (hm : tr ∈ trs) (d l : String) (n : Nat)
    (h : Eff.call d l n na to ∈ tr.program) : (d, l) ∈ callSites trs := by
  induction trs with
  | nil => cases hm
  | cons x xs ih =>
    cases hm with
    | head =>
      rw [callSites_pairs]
      apply dedup_mem
      exact List.mem_append_left _ (filter_call_mem tr.program d l n h)
    | tail _ hm =>
      simp [callSites]
      apply dedup_mem
      exact List.mem_append_right _ (by simpa [callSites] using ih hm)

theorem copy_accepted (I : Impl) (w : World) (id : InstId) (a : Actor) (hA : MailAccepted I w)
    (hb : a.box = (w.st id).box) (hp : a.parked = (w.st id).parked) :
    MailAccepted I (setActor w id a) := by
  refine ⟨?_, ?_⟩
  · intro i m hm
    by_cases hi : i = id
    · rw [hi] at hm ⊢
      exact hA.1 id m (by simpa [setActor, hb] using hm)
    · exact hA.1 i m (by simpa [setActor, hi] using hm)
  · intro i p hq
    by_cases hi : i = id
    · rw [hi] at hq ⊢
      exact hA.2 id p (by simpa [setActor, hp] using hq)
    · exact hA.2 i p (by simpa [setActor, hi] using hq)

theorem append_ok (I : Impl) (w : World) (dst : InstId) (msg : Msg) (hA : MailAccepted I w)
    (hmsg : msgOk I dst msg) :
    MailAccepted I (setActor w dst { (w.st dst) with box := (w.st dst).box ++ [msg], nextMid := (w.st dst).nextMid + 1 }) := by
  refine ⟨?_, ?_⟩
  · intro i m hm
    by_cases hi : i = dst
    · rw [hi] at hm ⊢
      simp [setActor, List.mem_append, List.mem_singleton] at hm
      rcases hm with hm | rfl
      · exact hA.1 dst m hm
      · exact hmsg
    · exact hA.1 i m (by simpa [setActor, hi] using hm)
  · intro i p hp
    by_cases hi : i = dst
    · rw [hi] at hp ⊢
      exact hA.2 dst p (by simpa [setActor] using hp)
    · exact hA.2 i p (by simpa [setActor, hi] using hp)

theorem enqueue_accepted (I : Impl) (w : World) (sender dst : InstId) (msg : Msg) (isCall : Bool)
    (k : Cont) (hA : MailAccepted I w) (hmsg : msgOk I dst msg) :
    MailAccepted I (enqueueOrPark w I.desc sender dst msg isCall k) := by
  refine ⟨?_, ?_⟩
  · intro i m hm
    rcases enqueue_box_mem w I.desc sender dst msg isCall k i m hm with hold | ⟨hid, heq, _⟩
    · exact hA.1 i m hold
    · rw [hid, heq]
      exact msgOk_mid I dst msg _ hmsg
  · intro i p hp
    rcases enqueue_parked_mem w I.desc sender dst msg isCall k i p hp with hold | ⟨hid, _, heq, _, _⟩
    · exact hA.2 i p hold
    · rw [hid, heq]
      exact msgOk_mid I dst msg _ hmsg

theorem deliver_box_of (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg) (w1 : World)
    (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.box = a.box ∧ a1.parked = a.parked := by
  simp only [deliver] at h
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        exact ⟨rfl, rfl⟩
    · split at h
      · cases h
      · cases h
        split <;> exact ⟨rfl, rfl⟩

/-- A bulk receive only moves messages already in that mailbox. -/
theorem bulk_keeps_accepted (I : Impl) (w w' : World) (id : InstId) (hA : MailAccepted I w)
    (h : receiveBulk I w id = some w') : MailAccepted I w' := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons q qs =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          injection h with hw
          have hdel' : deliver I w id ({ (w.st id) with parked := qs }) q.msg = some (w1, a1) := by
            simpa [hbox] using hdel
          have hkeep := deliver_box_of I w id ({ (w.st id) with parked := qs }) q.msg w1 a1 hdel'
          refine ⟨?_, ?_⟩
          · intro i m hm
            rw [← hw] at hm
            by_cases hs : i = q.sender
            · subst hs
              rw [setActor_self, resume_box] at hm
              have hcr := (credit_same (setActor w1 id a1) (tname id) q.msg.sender q.sender).1
              rw [hcr] at hm
              by_cases hid : q.sender = id
              · rw [hid, setActor_self, hkeep.1, hbox] at hm
                simp at hm
              · have hne : q.sender ≠ id := hid
                rw [setActor_other _ _ _ _ hne, deliver_st I w id _ q.msg w1 a1 q.sender hdel'] at hm
                exact hA.1 q.sender m hm
            · rw [setActor_other _ _ _ _ hs] at hm
              have hcr := (credit_same (setActor w1 id a1) (tname id) q.msg.sender i).1
              rw [hcr] at hm
              by_cases hid : i = id
              · rw [hid, setActor_self, hkeep.1, hbox] at hm
                simp at hm
              · rw [setActor_other _ _ _ _ hid, deliver_st I w id _ q.msg w1 a1 i hdel'] at hm
                exact hA.1 i m hm
          · intro i p hp
            rw [← hw] at hp
            by_cases hs : i = q.sender
            · subst hs
              rw [setActor_self, resume_parked] at hp
              have hcr := (credit_same (setActor w1 id a1) (tname id) q.msg.sender q.sender).2.1
              rw [hcr] at hp
              by_cases hid : q.sender = id
              · rw [hid] at hp ⊢
                rw [setActor_self, hkeep.2] at hp
                exact hA.2 id p (by
                  have hp' : p ∈ q :: qs := List.mem_cons_of_mem _ hp
                  simpa [hpark] using hp')
              · have hne : q.sender ≠ id := hid
                rw [setActor_other _ _ _ _ hne, deliver_st I w id _ q.msg w1 a1 q.sender hdel'] at hp
                exact hA.2 q.sender p hp
            · rw [setActor_other _ _ _ _ hs] at hp
              have hcr := (credit_same (setActor w1 id a1) (tname id) q.msg.sender i).2.1
              rw [hcr] at hp
              by_cases hid : i = id
              · rw [hid] at hp ⊢
                rw [setActor_self, hkeep.2] at hp
                exact hA.2 id p (by
                  have hp' : p ∈ q :: qs := List.mem_cons_of_mem _ hp
                  simpa [hpark] using hp')
              · rw [setActor_other _ _ _ _ hid, deliver_st I w id _ q.msg w1 a1 i hdel'] at hp
                exact hA.2 i p hp
    | cons m0 ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          injection h with hw
          have hdel' : deliver I w id ({ (w.st id) with box := ms }) m0 = some (w1, a1) := by
            simpa [hpark] using hdel
          have hkeep := deliver_box_of I w id ({ (w.st id) with box := ms }) m0 w1 a1 hdel'
          refine ⟨?_, ?_⟩
          · intro i m hm
            rw [← hw] at hm
            have hcr := (credit_same (setActor w1 id a1) (tname id) m0.sender i).1
            rw [hcr] at hm
            by_cases hi : i = id
            · rw [hi] at hm ⊢
              rw [setActor_self, hkeep.1] at hm
              exact hA.1 id m (by
                have hm' : m ∈ m0 :: ms := List.mem_cons_of_mem _ hm
                simpa [hbox] using hm')
            · rw [setActor_other _ _ _ _ hi, deliver_st I w id _ m0 w1 a1 i hdel'] at hm
              exact hA.1 i m hm
          · intro i p hp
            rw [← hw] at hp
            have hcr := (credit_same (setActor w1 id a1) (tname id) m0.sender i).2.1
            rw [hcr] at hp
            by_cases hi : i = id
            · rw [hi] at hp ⊢
              rw [setActor_self, hkeep.2, hpark] at hp
              simp at hp
            · rw [setActor_other _ _ _ _ hi, deliver_st I w id _ m0 w1 a1 i hdel'] at hp
              exact hA.2 i p hp
      | cons q qs =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          injection h with hw
          have hdel' : deliver I w id ({ (w.st id) with box := ms }) m0 = some (w1, a1) := by
            simpa [hpark] using hdel
          have hkeep := deliver_box_of I w id ({ (w.st id) with box := ms }) m0 w1 a1 hdel'
          let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
          refine ⟨?_, ?_⟩
          · intro i m hm
            rw [← hw] at hm
            by_cases hs : i = q.sender
            · subst hs
              rw [setActor_self, resume_box] at hm
              have hcr := (credit_same (setActor w1 id admitted) (tname id) m0.sender q.sender).1
              rw [hcr] at hm
              by_cases hid : q.sender = id
              · rw [hid] at hm ⊢
                rw [setActor_self] at hm
                simp [admitted, hkeep.1, List.mem_append, List.mem_singleton] at hm
                rcases hm with hm | rfl
                · exact hA.1 id m (by
                    have hm' : m ∈ m0 :: ms := List.mem_cons_of_mem _ hm
                    simpa [hbox] using hm')
                · exact hA.2 id q (by simp [hpark])
              · have hne : q.sender ≠ id := hid
                rw [setActor_other _ _ _ _ hne, deliver_st I w id _ m0 w1 a1 q.sender hdel'] at hm
                exact hA.1 q.sender m hm
            · rw [setActor_other _ _ _ _ hs] at hm
              have hcr := (credit_same (setActor w1 id admitted) (tname id) m0.sender i).1
              rw [hcr] at hm
              by_cases hid : i = id
              · rw [hid] at hm ⊢
                rw [setActor_self] at hm
                simp [admitted, hkeep.1, List.mem_append, List.mem_singleton] at hm
                rcases hm with hm | rfl
                · exact hA.1 id m (by
                    have hm' : m ∈ m0 :: ms := List.mem_cons_of_mem _ hm
                    simpa [hbox] using hm')
                · exact hA.2 id q (by simp [hpark])
              · rw [setActor_other _ _ _ _ hid, deliver_st I w id _ m0 w1 a1 i hdel'] at hm
                exact hA.1 i m hm
          · intro i p hp
            rw [← hw] at hp
            by_cases hs : i = q.sender
            · subst hs
              rw [setActor_self, resume_parked] at hp
              have hcr := (credit_same (setActor w1 id admitted) (tname id) m0.sender q.sender).2.1
              rw [hcr] at hp
              by_cases hid : q.sender = id
              · rw [hid] at hp ⊢
                rw [setActor_self] at hp
                simp [admitted] at hp
                exact hA.2 id p (by
                  have hp' : p ∈ q :: qs := List.mem_cons_of_mem _ hp
                  simpa [hpark] using hp')
              · have hne : q.sender ≠ id := hid
                rw [setActor_other _ _ _ _ hne, deliver_st I w id _ m0 w1 a1 q.sender hdel'] at hp
                exact hA.2 q.sender p hp
            · rw [setActor_other _ _ _ _ hs] at hp
              have hcr := (credit_same (setActor w1 id admitted) (tname id) m0.sender i).2.1
              rw [hcr] at hp
              by_cases hid : i = id
              · rw [hid] at hp ⊢
                rw [setActor_self] at hp
                simp [admitted] at hp
                exact hA.2 id p (by
                  have hp' : p ∈ q :: qs := List.mem_cons_of_mem _ hp
                  simpa [hpark] using hp')
              · rw [setActor_other _ _ _ _ hid, deliver_st I w id _ m0 w1 a1 i hdel'] at hp
                exact hA.2 i p hp

theorem tryWake_mail (D : Description) (w : World) (dstId : InstId) (label : String) (writer i : InstId) :
    ((tryWake D w dstId label writer).st i).box = (w.st i).box ∧
      ((tryWake D w dstId label writer).st i).parked = (w.st i).parked := by
  dsimp [tryWake]
  split
  · by_cases hi : i = dstId <;> simp [setActor, hi]
  · simp

theorem wakes_mail (ids : List InstId) (D : Description) (w : World) (dst label : String)
    (writer i : InstId) :
    ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).box = (w.st i).box ∧
      ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).parked = (w.st i).parked := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    have h1 := tryWake_mail D w j label writer i
    have h2 := ih (tryWake D w j label writer)
    exact ⟨h2.1.trans h1.1, h2.2.trans h1.2⟩

theorem refund_mail (w : World) (name : String) (ms : List Msg) (i : InstId) :
    ((refundMsgs w name ms).st i).box = (w.st i).box ∧
      ((refundMsgs w name ms).st i).parked = (w.st i).parked := by
  induction ms generalizing w with
  | nil => simp [refundMsgs]
  | cons m ms ih =>
    simp only [refundMsgs, List.foldl_cons]
    have hstep := credit_same w name m.sender i
    have hrest := ih (creditSender w name m.sender)
    exact ⟨hrest.1.trans hstep.1, hrest.2.trans hstep.2.1⟩

theorem refundP_mail (w : World) (name : String) (ps : List Parked) (i : InstId) :
    ((refundParked w name ps).st i).box = (w.st i).box ∧
      ((refundParked w name ps).st i).parked = (w.st i).parked := by
  induction ps generalizing w with
  | nil => simp [refundParked]
  | cons p ps ih =>
    simp only [refundParked, List.foldl_cons]
    have hstep := credit_same w name p.msg.sender i
    have hrest := ih (creditSender w name p.msg.sender)
    exact ⟨hrest.1.trans hstep.1, hrest.2.trans hstep.2.1⟩

theorem release_mail (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).box = (w.st i).box ∧
      ((releaseParked w id ps).st i).parked = (w.st i).parked := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w
    · rw [if_neg hskip]
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id))
      have hset : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).box = (w.st i).box ∧
          ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).parked = (w.st i).parked := by
        by_cases hi : i = p.sender
        · rw [hi]
          exact ⟨by simp [setActor_self, resume_box], by simp [setActor_self, resume_parked]⟩
        · exact ⟨by simp [setActor_other _ _ _ _ hi, resume_box],
            by simp [setActor_other _ _ _ _ hi, resume_parked]⟩
      exact ⟨hmid.1.trans hset.1, hmid.2.trans hset.2⟩

theorem exec_send_accepted (I : Impl) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (dst label : String) (hint : Nat) (es : List Eff) (hk : k.rest = .send dst label hint :: es)
    (hA : MailAccepted I w) (ha : a = w.st id) : MailAccepted I (execRun I w id a k) := by
  unfold execRun
  simp [hk]
  cases hr : route w I.desc id dst with
  | none =>
    exact copy_accepted I w id (proceed a (afterHead k)) hA (by simp [ha, proceed_box])
      (by simp [ha, proceed_parked])
  | some dstId =>
    exact enqueue_accepted I w id dstId { label := label, sender := id, callFrom := none } false
      (afterHead k) hA (Or.inl rfl)

theorem exec_call_accepted (I : Impl) (hL : LocalOk I) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (dst label : String) (hint : Nat) (na to es : List Eff)
    (hk : k.rest = .call dst label hint na to :: es)
    (hS : ProgSrc I w) (hA : MailAccepted I w) (ha : a = w.st id) (hph : (w.st id).phase = .run k) :
    MailAccepted I (execRun I w id a k) := by
  unfold execRun
  simp [hk]
  cases hr : route w I.desc id dst with
  | none =>
    exact copy_accepted I w id (proceed a (afterHead k)) hA (by simp [ha, proceed_box])
      (by simp [ha, proceed_parked])
  | some dstId =>
    have hname := route_tname w I.desc id dst dstId hr
    have hsite : callSite I (tname dstId) label := by
      rw [hname]
      obtain ⟨tr, hmem, _, pre, happ⟩ := hS id k.rest (by simp [carried, hph])
      have hin : Eff.call dst label hint na to ∈ tr.program := by
        rw [← happ, hk]
        exact List.mem_append_right _ (List.Mem.head _)
      exact call_in_sites I.transitions tr hmem dst label hint hin
    exact enqueue_accepted I w id dstId { label := label, sender := id, callFrom := some id } true
      (afterHead k) hA (Or.inr hsite)

def tryFitWorld (w : World) (id dstId : InstId) (label : String) (k : Cont) : World :=
  let charged := chargeSender (w.st id) (tname dstId)
  let w1 := setActor w id charged
  let dstA := w1.st dstId
  let msg : Msg :=
    { label := label, sender := id, callFrom := none, reliable := false, mid := dstA.nextMid }
  let w2 := setActor w1 dstId { dstA with box := dstA.box ++ [msg], nextMid := dstA.nextMid + 1 }
  setActor w2 id (proceed (w2.st id) k)

theorem try_fit_mail (I : Impl) (w : World) (id dstId : InstId) (label : String) (k : Cont)
    (hA : MailAccepted I w) : MailAccepted I (tryFitWorld w id dstId label k) := by
  let charged := chargeSender (w.st id) (tname dstId)
  have h1 := copy_accepted I w id charged hA (charge_box _ _) (charge_parked _ _)
  let w1 := setActor w id charged
  let dstA := w1.st dstId
  let msg : Msg :=
    { label := label, sender := id, callFrom := none, reliable := false, mid := dstA.nextMid }
  have h2 := append_ok I w1 dstId msg h1 (Or.inl rfl)
  let w2 := setActor w1 dstId { dstA with box := dstA.box ++ [msg], nextMid := dstA.nextMid + 1 }
  simpa [tryFitWorld, msg, charged, w1, dstA, w2] using
    copy_accepted I w2 id (proceed (w2.st id) k) h2 (by simp [proceed_box]) (by simp [proceed_parked])

theorem exec_try_accepted (I : Impl) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (dst label : String) (hint : Nat) (onFull onGone es : List Eff)
    (hk : k.rest = .trySend dst label hint onFull onGone :: es)
    (hA : MailAccepted I w) (ha : a = w.st id) : MailAccepted I (execRun I w id a k) := by
  unfold execRun
  simp [hk, ha]
  cases hr : route w I.desc id dst with
  | none => exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
  | some dstId =>
    simp only [hr]
    split
    · exact enqueue_accepted I w id dstId
        { label := label, sender := id, callFrom := none, reliable := false } false
        (afterHead k) hA (Or.inl rfl)
    · exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)

theorem exec_cell_accepted (I : Impl) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (dst label : String) (value : Nat) (es : List Eff) (hk : k.rest = .cell dst label value :: es)
    (hA : MailAccepted I w) (ha : a = w.st id) : MailAccepted I (execRun I w id a k) := by
  unfold execRun
  simp [hk, ha]
  let c : Cell := { value := max (w.cell dst label).value value, dirty := true }
  let wS := setCell w dst label c
  have hSmail : MailAccepted I wS := by
    unfold MailAccepted at hA ⊢
    simpa [wS, setCell] using hA
  split
  · exact copy_accepted I wS id (proceed (wS.st id) (afterHead k)) hSmail (proceed_box _ _) (proceed_parked _ _)
  · let wA := setActor wS id (proceed (wS.st id) (afterHead k))
    have hAmail := copy_accepted I wS id (proceed (wS.st id) (afterHead k)) hSmail (proceed_box _ _)
      (proceed_parked _ _)
    refine ⟨?_, ?_⟩
    · intro i m hm
      have hpre : m ∈ (wA.st i).box := by
        have hw := (wakes_mail (readersOf wA dst) I.desc wA dst label id i).1
        simpa [wakeReaders, wA, wS, c, hw] using hm
      exact hAmail.1 i m hpre
    · intro i p hp
      have hpre : p ∈ (wA.st i).parked := by
        have hw := (wakes_mail (readersOf wA dst) I.desc wA dst label id i).2
        simpa [wakeReaders, wA, wS, c, hw] using hp
      exact hAmail.2 i p hpre

theorem releaseParked_box (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).box = (w.st i).box := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hif : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hif]
      exact ih w
    · rw [if_neg hif]
      have hbox : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).box =
          (w.st i).box := by
        by_cases hi : i = p.sender
        · rw [hi, setActor_self]
          cases hph : (w.st p.sender).phase with
          | parked _ _ k =>
            cases hk : k.rest <;> simp [resumeSender, hph, proceed, hk]
          | idle => simp [resumeSender, hph]
          | run _ => simp [resumeSender, hph]
          | awaitReply _ _ => simp [resumeSender, hph]
          | awaitEffect _ => simp [resumeSender, hph]
          | awaitPeer _ => simp [resumeSender, hph]
          | crashed => simp [resumeSender, hph]
        · rw [setActor_other _ p.sender i _ hi]
      exact (ih _).trans hbox

theorem release_box_host (D : Description) (w : World) (id : InstId) (a : Actor) (i : InstId) :
    ((releaseWorld D w id a).st i).box = (if i = id then [] else (w.st i).box) := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  have hbase : (base.st i).box = (w.st i).box := by
    simp [base, refundP_box, refund_box, readCells_st]
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  rw [hworld, releaseParked_box]
  by_cases hi : i = id
  · simp [setActor, hi, dead]
  · simp [setActor, hi, hbase]

theorem failWaiter_box (w : World) (dead i dst : InstId) :
    ((failWaiter w dead i).st dst).box = (w.st dst).box := by
  by_cases hlive : (w.st i).life = .alive
  · have hgo : ((w.st i).life != .alive) = false := by simp [hlive, bne]
    simp only [failWaiter, hgo, ite_false]
    cases hph : (w.st i).phase with
    | parked d _ k =>
      by_cases hd : d = dead
      · cases hk : k.rest with
        | nil =>
          by_cases hj : dst = i <;> simp [hph, hd, hk, setActor, proceed, hj]
        | cons _ _ =>
          by_cases hj : dst = i <;> simp [hph, hd, hk, setActor, proceed, hj]
      · simp [hph, hd]
    | awaitReply d _ =>
      by_cases hd : d = dead
      · simp [hph, hd, setActor]
        by_cases hj : dst = i <;> simp [hj]
      · simp [hph, hd]
    | idle => simp [hph]
    | run _ => simp [hph]
    | awaitEffect _ => simp [hph]
    | awaitPeer _ => simp [hph]
    | crashed => simp [hph]
  · have hgo : ((w.st i).life != .alive) = true := by
      cases hlife : (w.st i).life <;> simp_all [bne]
    simp [failWaiter, hgo]

theorem failFold_box (w : World) (dead dst : InstId) (ids : List InstId) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st dst).box = (w.st dst).box := by
  induction ids generalizing w with
  | nil => simp
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact (ih _).trans (failWaiter_box w dead i dst)

theorem admitHost_accepted (I : Impl) (w : World) (dead host : InstId) (hA : MailAccepted I w) :
    MailAccepted I (admitHost w dead host) := by
  unfold admitHost
  split
  · exact hA
  · split
    · exact hA
    · refine ⟨?_, ?_⟩
      · intro i m hm
        by_cases hi : i = host
        · rw [hi] at hm ⊢
          rw [setActor_self] at hm
          rcases List.mem_append.mp hm with hbox | hmap
          · exact hA.1 host m hbox
          · rcases List.mem_map.mp hmap with ⟨p, hp, rfl⟩
            exact hA.2 host p (List.mem_filter.mp hp).1
        · rw [setActor_other _ host i _ hi] at hm
          exact hA.1 i m hm
      · intro i p hp
        by_cases hi : i = host
        · rw [hi] at hp ⊢
          rw [setActor_self] at hp
          exact hA.2 host p (List.mem_filter.mp hp).1
        · rw [setActor_other _ host i _ hi] at hp
          exact hA.2 i p hp

theorem admitDead_accepted (I : Impl) (w : World) (dead : InstId) (hA : MailAccepted I w) :
    MailAccepted I (admitDead w dead) := by
  unfold admitDead
  suffices ∀ (ids : List InstId) (w0 : World), MailAccepted I w0 →
      MailAccepted I (ids.foldl (fun w host => admitHost w dead host) w0) by
    exact this w.roster w hA
  intro ids
  induction ids with
  | nil => intro w0 h; simpa using h
  | cons host ids ih =>
    intro w0 h
    simp only [List.foldl_cons]
    exact ih _ (admitHost_accepted I w0 dead host h)

theorem abortActor_accepted (I : Impl) (D : Description) (w : World) (id : InstId) (a : Actor)
    (hA : MailAccepted I w) : MailAccepted I (abortActor D w id a) := by
  have hrel : MailAccepted I (releaseWorld D w id a) := by
    refine ⟨?_, ?_⟩
    · intro i m hm
      rw [release_box_host] at hm
      by_cases hi : i = id
      · simp [hi] at hm
      · simp [hi] at hm
        exact hA.1 i m hm
    · intro i p hp
      by_cases hi : i = id
      · rw [hi, release_self_parked] at hp
        cases hp
      · rw [releaseWorld_parked D w id a i hi] at hp
        exact hA.2 i p hp
  have hfail : MailAccepted I (failWaiters (releaseWorld D w id a) id) := by
    refine ⟨?_, ?_⟩
    · intro i m hm
      rw [show ((failWaiters (releaseWorld D w id a) id).st i).box =
          ((releaseWorld D w id a).st i).box by
          simpa [failWaiters] using failFold_box (releaseWorld D w id a) id i
            (releaseWorld D w id a).roster] at hm
      exact hrel.1 i m hm
    · intro i p hp
      rw [show ((failWaiters (releaseWorld D w id a) id).st i).parked =
          ((releaseWorld D w id a).st i).parked by
          simpa [failWaiters] using failFold_parked (releaseWorld D w id a) id i
            (releaseWorld D w id a).roster] at hp
      exact hrel.2 i p hp
  simpa [abortActor] using admitDead_accepted I (failWaiters (releaseWorld D w id a) id) id hfail

theorem abortDesc_accepted (fuel : Nat) (I : Impl) (D : Description) (w : World) (parent : InstId)
    (hA : MailAccepted I w) : MailAccepted I (abortDesc fuel D w parent) := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using hA
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), MailAccepted I w0 →
        MailAccepted I (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) by
      exact this w.roster w hA
    intro ids
    induction ids with
    | nil => intro w0 h; simpa using h
    | cons c ids ihf =>
      intro w0 h
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        exact ihf _ (abortActor_accepted I D (abortDesc fuel D w0 c) c
          ((abortDesc fuel D w0 c).st c) (ih w0 c h))
      · rw [if_neg hgo]
        exact ihf w0 h

theorem tombstone_box (D : Description) (w : World) (child i : InstId) :
    ((enqueueTombstone D w child).st i).box = (w.st i).box := by
  cases hsup : supervisorOf D child with
  | none => simp [enqueueTombstone, hsup]
  | some parent =>
    simp [enqueueTombstone, hsup]
    split
    · by_cases hs : i = parent
      · simp [setActor, hs]
      · simp [setActor, hs]
    · rfl

theorem terminate_accepted (I : Impl) (D : Description) (w : World) (id : InstId)
    (hA : MailAccepted I w) : MailAccepted I (terminateStage D w id (w.st id)) := by
  simp only [terminateStage]
  have hdesc := abortDesc_accepted w.roster.length I D w id hA
  have habort := abortActor_accepted I D (abortDesc w.roster.length D w id) id
    ((abortDesc w.roster.length D w id).st id) hdesc
  refine ⟨?_, ?_⟩
  · intro i m hm
    rw [tombstone_box] at hm
    exact habort.1 i m hm
  · intro i p hp
    rw [tombstone_parked] at hp
    exact habort.2 i p hp

theorem exec_term_accepted (I : Impl) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (es : List Eff) (hk : k.rest = .terminate :: es) (hA : MailAccepted I w) (ha : a = w.st id) :
    MailAccepted I (execRun I w id a k) := by
  have hk' : k = ⟨.terminate :: es, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
    cases k with
    | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
      cases hk
      rfl
  rw [ha, hk']
  rcases execRun_terminate I w id (w.st id) es k.toState k.replyTo with
    hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
  · rw [hkept]
    exact hA
  · rw [hrel]
    refine ⟨?_, ?_⟩
    · intro i m hm
      exact hA.1 i m ((releaseWorld_sub I.desc w id (w.st id) i).1.mem hm)
    · intro i p hp
      exact hA.2 i p ((releaseWorld_sub I.desc w id (w.st id) i).2.mem hp)
  · rw [hkill]
    exact terminate_accepted I I.desc w id hA

theorem exec_run_accepted (I : Impl) (hL : LocalOk I) (w : World) (id : InstId) (a : Actor) (k : Cont)
    (hS : ProgSrc I w) (hA : MailAccepted I w) (ha : a = w.st id) (hph : (w.st id).phase = .run k) :
    MailAccepted I (execRun I w id a k) := by
  unfold execRun
  cases hk : k.rest with
  | nil =>
    exact copy_accepted I w id { a with phase := .idle, typestate := k.toState } hA (by rw [ha]) (by rw [ha])
  | cons e es =>
    cases e with
    | internal =>
      exact copy_accepted I w id { a with phase := .awaitEffect (afterHead k) } hA (by rw [ha]) (by rw [ha])
    | peer onTimeout =>
      exact copy_accepted I w id { a with phase := .awaitPeer (afterHead k) } hA (by rw [ha]) (by rw [ha])
    | selfSchedule label =>
      simp [hk, ha]
      split
      · exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
      · split
        · exact copy_accepted I w id (proceed { (w.st id) with prio := upsertPrio (w.st id).prio { label := label, sender := id, callFrom := none, reliable := true, mid := (w.st id).nextMid }, nextMid := (w.st id).nextMid + 1 } (afterHead k)) hA (by simp [proceed_box]) (by simp [proceed_parked])
        · exact copy_accepted I w id { (w.st id) with phase := .crashed } hA rfl rfl
    | reply =>
      simp [hk, ha, performReply]
      cases hr : k.replyTo with
      | none =>
        simp [hr]
        exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
      | some caller =>
        simp [hr]
        cases hphC : (w.st caller).phase with
        | awaitReply dst ck =>
          simp [hphC]
          by_cases hs : dst = id
          · rw [hs]
            simp
            by_cases hsc : id = caller
            · subst hsc
              exact copy_accepted I (setActor w id (proceed (w.st id) ck)) id
                (proceed ((setActor w id (proceed (w.st id) ck)).st id) (afterHead k))
                (copy_accepted I w id (proceed (w.st id) ck) hA (proceed_box _ _) (proceed_parked _ _))
                (proceed_box _ _) (proceed_parked _ _)
            · exact copy_accepted I (setActor w caller (proceed (w.st caller) ck)) id
                (proceed ((setActor w caller (proceed (w.st caller) ck)).st id) (afterHead k))
                (copy_accepted I w caller (proceed (w.st caller) ck) hA (proceed_box _ _) (proceed_parked _ _))
                (by simp [setActor, hsc, proceed_box]) (by simp [setActor, hsc, proceed_parked])
          · simp [hs]
            exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | idle =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | run _ =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | parked _ _ _ =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | awaitEffect _ =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | awaitPeer _ =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
        | crashed =>
          simp [hphC]
          exact copy_accepted I w id (proceed (w.st id) (afterHead k)) hA (proceed_box _ _) (proceed_parked _ _)
    | send dst label hint =>
      rw [← hk]
      exact exec_send_accepted I w id a k dst label hint es hk hA ha
    | trySend dst label hint onFull onGone =>
      rw [← hk]
      exact exec_try_accepted I w id a k dst label hint es hk hA ha
    | call dst label hint na to =>
      rw [← hk]
      exact exec_call_accepted I hL w id a k dst label hint es hk hS hA ha hph
    | cell dst label value =>
      rw [← hk]
      exact exec_cell_accepted I w id a k dst label value es hk hA ha
    | terminate =>
      rw [← hk]
      exact exec_term_accepted I w id a k es hk hA ha

theorem exec_keeps_accepted (I : Impl) (hL : LocalOk I) (w w' : World) (id : InstId)
    (hS : ProgSrc I w) (hA : MailAccepted I w) (h : execHead I w id = some w') : MailAccepted I w' := by
  unfold execHead at h
  by_cases hlive : (w.st id).life = .alive
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | run k =>
      simp [hph] at h
      cases h
      exact exec_run_accepted I hL w id (w.st id) k hS hA rfl hph
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
  · simp [hlive] at h

theorem call_old_box (I : Impl) (w : World) (hA : MailAccepted I w) (id : InstId) (m : Msg)
    (hc : m.callFrom ≠ none) (hm : m ∈ (w.st id).box) : msgOk I id m :=
  hA.1 id m hm

theorem call_old_park (I : Impl) (w : World) (hA : MailAccepted I w) (id : InstId) (p : Parked)
    (hc : p.msg.callFrom ≠ none) (hp : p ∈ (w.st id).parked) : msgOk I id p.msg :=
  hA.2 id p hp

/-- One step keeps every queued call inside a mailbox `callTotal` covers.
A non-call is accepted outright. -/
theorem prio_box_msg (I : Impl) (w w' : World) (id i : InstId) (h : receivePrio I w id = some w')
    (m : Msg) (hm : m ∈ (w'.st i).box) : m ∈ (w.st i).box := by
  unfold receivePrio at h
  cases hprio : (w.st id).prio with
  | nil => simp [hprio] at h
  | cons m0 ms =>
    simp [hprio] at h
    split at h
    · simp at h
    · next w1 a1 hdel =>
      rcases h with ⟨_, hw⟩
      injection hw with hw
      rw [← hw] at hm
      have hbx := (deliver_box_of I w id ({ (w.st id) with prio := ms }) m0 w1 a1 hdel).1
      have hst := deliver_st I w id _ m0 w1 a1 i hdel
      by_cases hi : i = id
      · rw [hi] at hm ⊢
        simp [setActor, hbx] at hm
        exact hm
      · simp [setActor, hi, hst] at hm
        exact hm

theorem msgOk_detach (I : Impl) (mb caller : InstId) (m : Msg) (h : msgOk I mb m) :
    msgOk I mb (detachMsg caller m) := by
  unfold detachMsg
  split
  · exact Or.inl (by simp)
  · exact h

theorem mail_step (I : Impl) (hL : LocalOk I) (a : Action) (w w' : World) (hS : ProgSrc I w)
    (hA : MailAccepted I w) (h : apply I a w = some w') : MailAccepted I w' := by
  cases a with
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by simpa [stepWorld] using stepOfApply h
    refine ⟨?_, ?_⟩
    · intro i m hm
      rcases callTimeout_box w w' id i hct with heq | ⟨dst, _, _, hi, hbox⟩
      · exact hA.1 i m (by simpa [heq] using hm)
      · rw [hi] at hm hbox ⊢
        have hm' : m ∈ (w.st dst).box.map (detachMsg id) := by simpa [hbox] using hm
        obtain ⟨m0, hm0, hdet⟩ := List.mem_map.mp hm'
        rw [← hdet]
        exact msgOk_detach I dst id m0 (hA.1 dst m0 hm0)
    · intro i p hp
      rcases callTimeout_parked w w' id i hct with heq | ⟨dst, _, _, hi, hpk⟩
      · exact hA.2 i p (by simpa [heq] using hp)
      · rw [hi] at hp hpk ⊢
        have hp' : p ∈ (w.st dst).parked.filter (fun q => !(q.sender == id && q.isCall)) := by
          rw [← hpk]; exact hp
        exact hA.2 dst p (List.mem_filter.mp hp').1
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress dst label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    refine ⟨?_, ?_⟩
    · intro id m hm
      cases hc : m.callFrom with
      | none => exact Or.inl hc
      | some _ =>
        rcases ingress_box I w w' dst label id h with ⟨_, hbox⟩ | ⟨_, hbox⟩
        · rw [hbox] at hm
          simp [List.mem_append, List.mem_singleton] at hm
          rcases hm with hm | rfl
          · exact hA.1 id m hm
          · simp at hc
        · exact hA.1 id m (by simpa [hbox] using hm)
    · intro id p hp
      exact hA.2 id p (by simpa [(ingress_parked I w w' dst label id h).1] using hp)
  | finish id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    refine ⟨?_, ?_⟩
    · intro i m hm
      by_cases hi : i = id
      · rw [hi] at hm ⊢
        exact hA.1 id m (by simpa [setActor, proceed_box] using hm)
      · exact hA.1 i m (by simpa [setActor, hi] using hm)
    · intro i p hp
      by_cases hi : i = id
      · rw [hi] at hp ⊢
        exact hA.2 id p (by simpa [setActor, proceed_parked] using hp)
      · exact hA.2 i p (by simpa [setActor, hi] using hp)
  | recvPrio id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    refine ⟨fun i m hm => hA.1 i m (by
        have heq := prio_parked I w w' id i (by simpa [stepWorld] using stepOfApply h)
        -- parked equality is not the box; rewrite via the same receive, proved below
        exact prio_box_msg I w w' id i (by simpa [stepWorld] using stepOfApply h) m hm),
      fun i p hp => hA.2 i p (by
        have heq := prio_parked I w w' id i (by simpa [stepWorld] using stepOfApply h)
        simpa [heq] using hp)⟩
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        let nid := InstId.peer template (w.nextIx template)
        refine ⟨?_, ?_⟩
        · intro id m hm
          by_cases hi : id = nid
          · simp [nid, hi, readCells_st, setActor, withTokens] at hm
          · exact hA.1 id m (by simpa [nid, hi, readCells_st, setActor] using hm)
        · intro id p hp
          by_cases hi : id = nid
          · simp [nid, hi, readCells_st, setActor, withTokens] at hp
          · exact hA.2 id p (by simpa [nid, hi, readCells_st, setActor] using hp)
      · cases h
  | recvBulk id =>
    exact bulk_keeps_accepted I w w' id hA (by simpa [stepWorld] using stepOfApply h)
  | exec id =>
    exact exec_keeps_accepted I hL w w' id hS hA (by simpa [stepWorld] using stepOfApply h)

/-- Reachable mailboxes hold only messages `deliver` can take. Ingress adds a
non-call. A call is enqueued only from a program the relation already checked,
so `callTotal` and `uniqueKeys` make `findTr` accept it. -/
theorem mail_accepted_reachable (I : Impl) (hL : LocalOk I) (N : Nat) (w : World)
    (hR : Reachable I N w) : MailAccepted I w := by
  induction hR with
  | init =>
    refine ⟨?_, ?_⟩
    · intro id m hm
      simp [(init_box I N id).1] at hm
    · intro id p hp
      simp [(init_box I N id).2] at hp
  | step w w' a prev happ ih =>
    exact mail_step I hL a w w' (prog_src_reachable I N w prev) ih happ

theorem enabled_of_can (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (id : InstId) (h : CanReceive w id) : Enabled I w (.recvBulk id) :=
  can_receive_enabled I hL w id (ty_reachable I hL hG N w hR) (mail_accepted_reachable I hL N w hR) h

theorem next_bulk {I : Impl} {N : Nat} (ρ : Run I N) (hF : Fair ρ) (dst : InstId) (i : Nat)
    (hio : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk dst)) :
    ∃ j, i ≤ j ∧ ρ.act j = .recvBulk dst ∧ ∀ t, i ≤ t → t < j → ρ.act t ≠ .recvBulk dst := by
  obtain ⟨j0, hj0, hact0⟩ := hF.bulk dst hio i
  have hscan := scanAct_spec ρ.act (.recvBulk dst) (j0 - i) i
    ⟨j0 - i, Nat.le_refl _, by simpa [Nat.add_sub_of_le hj0] using hact0⟩
  exact ⟨scanAct ρ.act (.recvBulk dst) (j0 - i) i, hscan.1, hscan.2⟩

/-- A blocking send that stays queued is removed by bulk receives.
`n` bounds the waiter's index. Each receive of the live receiver moves that
index strictly closer to the head, and the receive that finds it at the head
clears the wait. -/
theorem queued_forever_false (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (s dst : InstId) (n i : Nat)
    (hstay : ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst false k)
    (halive : ∀ t, i ≤ t → ((ρ.cfg t).st dst).life = .alive)
    (hin : parkIndex (((ρ.cfg i).st dst).parked) s ≤ n)
    (hlt : parkIndex (((ρ.cfg i).st dst).parked) s < (((ρ.cfg i).st dst).parked).length)
    (hio : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk dst)) : False := by
  induction n generalizing i with
  | zero =>
    have hzero : parkIndex (((ρ.cfg i).st dst).parked) s = 0 := by omega
    obtain ⟨j, hj, hact, _⟩ := next_bulk ρ hF dst i hio
    have hmono := index_mono I hL hG ρ s dst false i (j - i)
      (fun t h1 h2 => hstay t h1)
      (fun t h1 h2 => halive t h1) (by omega)
    have hat : parkIndex (((ρ.cfg j).st dst).parked) s = 0 := by
      have hle := hmono.1
      have : i + (j - i) = j := Nat.add_sub_of_le hj
      simp [this] at hle
      omega
    have hlen : 0 < (((ρ.cfg j).st dst).parked).length := by
      have := hmono.2
      simp [Nat.add_sub_of_le hj] at this
      omega
    obtain ⟨p, ps, hp, hs⟩ := index_zero_head _ s hat hlen
    obtain ⟨k, hk⟩ := hstay j hj
    have hne : s ≠ dst := by
      intro heq
      obtain ⟨k0, hk0⟩ := hstay i (Nat.le_refl _)
      have hrecv : receiveBulk I (ρ.cfg j) dst = some (ρ.cfg (j + 1)) := by
        have hv := ρ.valid j
        simp [hact] at hv
        exact hv
      unfold receiveBulk at hrecv
      by_cases hready : ((ρ.cfg j).st dst).life ≠ .alive ∨ ((ρ.cfg j).st dst).phase ≠ .idle
      · simp [hready] at hrecv
      · have hidle : ((ρ.cfg j).st dst).phase = .idle := by
          by_cases hpI : ((ρ.cfg j).st dst).phase = .idle
          · exact hpI
          · exact False.elim (hready (Or.inr hpI))
        rw [← heq] at hidle
        simp [hk] at hidle
    have hun := bulk_head_unblocks I (ρ.cfg j) (ρ.cfg (j + 1)) dst
      (by simpa [apply, hact] using ρ.valid j) p ps hp s hs.symm hne k hk
    obtain ⟨k', hk'⟩ := hstay (j + 1) (Nat.le_succ_of_le hj)
    have hstill : waitKind ((ρ.cfg (j + 1)).st s) = some (.blockingSend dst) := by simp [waitKind, hk']
    exact hun hstill
  | succ n ih =>
    obtain ⟨j, hj, hact, hfirst⟩ := next_bulk ρ hF dst i hio
    have hmono := index_mono I hL hG ρ s dst false i (j - i)
      (fun t h1 _ => hstay t h1) (fun t h1 _ => halive t h1) (by omega)
    have hatj : parkIndex (((ρ.cfg j).st dst).parked) s ≤ n + 1 := by
      have hle := hmono.1
      simp [Nat.add_sub_of_le hj] at hle
      exact Nat.le_trans hle hin
    have hlenj : parkIndex (((ρ.cfg j).st dst).parked) s < (((ρ.cfg j).st dst).parked).length := by
      have hltj := hmono.2
      simp [Nat.add_sub_of_le hj] at hltj
      exact hltj
    by_cases hzero : parkIndex (((ρ.cfg j).st dst).parked) s = 0
    · have hlenpos : 0 < (((ρ.cfg j).st dst).parked).length := by omega
      obtain ⟨p, ps, hp, hs⟩ := index_zero_head _ s hzero hlenpos
      obtain ⟨k, hk⟩ := hstay j hj
      have hrecv : receiveBulk I (ρ.cfg j) dst = some (ρ.cfg (j + 1)) := by
        simpa [apply, hact] using ρ.valid j
      have hne : s ≠ dst := by
        intro heq
        unfold receiveBulk at hrecv
        by_cases hready : ((ρ.cfg j).st dst).life ≠ .alive ∨ ((ρ.cfg j).st dst).phase ≠ .idle
        · simp [hready] at hrecv
        · have hidle : ((ρ.cfg j).st dst).phase = .idle := by
            by_cases hpI : ((ρ.cfg j).st dst).phase = .idle
            · exact hpI
            · exact False.elim (hready (Or.inr hpI))
          rw [← heq] at hidle
          simp [hk] at hidle
      have hun := bulk_head_unblocks I (ρ.cfg j) (ρ.cfg (j + 1)) dst hrecv p ps hp s hs.symm hne k hk
      obtain ⟨k', hk'⟩ := hstay (j + 1) (Nat.le_succ_of_le hj)
      exact hun (by simp [waitKind, hk'])
    · have hpos : 0 < parkIndex (((ρ.cfg j).st dst).parked) s := Nat.pos_of_ne_zero hzero
      cases hp : ((ρ.cfg j).st dst).parked with
      | nil => simp [parkIndex, hp] at hlenj
      | cons p ps =>
        have hsnd : p.sender ≠ s := by
          intro heq
          have h0 := parkIndex_head p ps s heq
          rw [hp] at hzero
          exact hzero h0
        rw [hp] at hlenj hatj
        have hrec := recv_closer I (ρ.cfg j) (ρ.cfg (j + 1)) dst
          (by simpa [apply, hact] using ρ.valid j) p ps hp s hsnd (by omega)
        have hnext : parkIndex (((ρ.cfg (j + 1)).st dst).parked) s ≤ n := by
          have := hrec.1
          omega
        have hltn : parkIndex (((ρ.cfg (j + 1)).st dst).parked) s <
            (((ρ.cfg (j + 1)).st dst).parked).length := hrec.2
        exact ih (j + 1)
          (fun t ht => hstay t (Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) ht)))
          (fun t ht => halive t (Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) ht)))
          hnext hltn

/-- A parked wait, send or call, does not stay parked once the receiver is idle
with mail infinitely often. For a call this is admission: the phase cannot
remain `.parked dst true`. -/
theorem parked_forever_false (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (s dst : InstId) (c : Bool) (n i : Nat)
    (hstay : ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst c k)
    (halive : ∀ t, i ≤ t → ((ρ.cfg t).st dst).life = .alive)
    (hin : parkIndex (((ρ.cfg i).st dst).parked) s ≤ n)
    (hlt : parkIndex (((ρ.cfg i).st dst).parked) s < (((ρ.cfg i).st dst).parked).length)
    (hio : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk dst)) : False := by
  induction n generalizing i with
  | zero =>
    have hzero : parkIndex (((ρ.cfg i).st dst).parked) s = 0 := by omega
    obtain ⟨j, hj, hact, _⟩ := next_bulk ρ hF dst i hio
    have hmono := index_mono I hL hG ρ s dst c i (j - i)
      (fun t h1 _ => hstay t h1) (fun t h1 _ => halive t h1) (by omega)
    have hat : parkIndex (((ρ.cfg j).st dst).parked) s = 0 := by
      have hle := hmono.1
      simp [Nat.add_sub_of_le hj] at hle
      omega
    have hlen : 0 < (((ρ.cfg j).st dst).parked).length := by
      have := hmono.2
      simp [Nat.add_sub_of_le hj] at this
      omega
    obtain ⟨p, ps, hp, hs⟩ := index_zero_head _ s hat hlen
    obtain ⟨k, hk⟩ := hstay j hj
    have hrecv : receiveBulk I (ρ.cfg j) dst = some (ρ.cfg (j + 1)) := by
      simpa [apply, hact] using ρ.valid j
    have hne : s ≠ dst := by
      intro heq
      unfold receiveBulk at hrecv
      by_cases hready : ((ρ.cfg j).st dst).life ≠ .alive ∨ ((ρ.cfg j).st dst).phase ≠ .idle
      · simp [hready] at hrecv
      · have hidle : ((ρ.cfg j).st dst).phase = .idle := by
          by_cases hpI : ((ρ.cfg j).st dst).phase = .idle
          · exact hpI
          · exact False.elim (hready (Or.inr hpI))
        rw [← heq] at hidle
        simp [hk] at hidle
    have hleft := bulk_head_leaves I (ρ.cfg j) (ρ.cfg (j + 1)) dst hrecv p ps hp s hs.symm hne c k hk
    obtain ⟨k', hk'⟩ := hstay (j + 1) (Nat.le_succ_of_le hj)
    exact hleft dst c k' hk'
  | succ n ih =>
    obtain ⟨j, hj, hact, _⟩ := next_bulk ρ hF dst i hio
    have hmono := index_mono I hL hG ρ s dst c i (j - i)
      (fun t h1 _ => hstay t h1) (fun t h1 _ => halive t h1) (by omega)
    have hatj : parkIndex (((ρ.cfg j).st dst).parked) s ≤ n + 1 := by
      have hle := hmono.1
      simp [Nat.add_sub_of_le hj] at hle
      exact Nat.le_trans hle hin
    have hlenj : parkIndex (((ρ.cfg j).st dst).parked) s < (((ρ.cfg j).st dst).parked).length := by
      have hltj := hmono.2
      simp [Nat.add_sub_of_le hj] at hltj
      exact hltj
    by_cases hzero : parkIndex (((ρ.cfg j).st dst).parked) s = 0
    · have hlenpos : 0 < (((ρ.cfg j).st dst).parked).length := by omega
      obtain ⟨p, ps, hp, hs⟩ := index_zero_head _ s hzero hlenpos
      obtain ⟨k, hk⟩ := hstay j hj
      have hrecv : receiveBulk I (ρ.cfg j) dst = some (ρ.cfg (j + 1)) := by
        simpa [apply, hact] using ρ.valid j
      have hne : s ≠ dst := by
        intro heq
        unfold receiveBulk at hrecv
        by_cases hready : ((ρ.cfg j).st dst).life ≠ .alive ∨ ((ρ.cfg j).st dst).phase ≠ .idle
        · simp [hready] at hrecv
        · have hidle : ((ρ.cfg j).st dst).phase = .idle := by
            by_cases hpI : ((ρ.cfg j).st dst).phase = .idle
            · exact hpI
            · exact False.elim (hready (Or.inr hpI))
          rw [← heq] at hidle
          simp [hk] at hidle
      have hleft := bulk_head_leaves I (ρ.cfg j) (ρ.cfg (j + 1)) dst hrecv p ps hp s hs.symm hne c k hk
      obtain ⟨k', hk'⟩ := hstay (j + 1) (Nat.le_succ_of_le hj)
      exact hleft dst c k' hk'
    · have hpos : 0 < parkIndex (((ρ.cfg j).st dst).parked) s := Nat.pos_of_ne_zero hzero
      cases hp : ((ρ.cfg j).st dst).parked with
      | nil => simp [parkIndex, hp] at hlenj
      | cons p ps =>
        have hsnd : p.sender ≠ s := by
          intro heq
          have h0 := parkIndex_head p ps s heq
          rw [hp] at hzero
          exact hzero h0
        rw [hp] at hlenj hatj
        have hrec := recv_closer I (ρ.cfg j) (ρ.cfg (j + 1)) dst
          (by simpa [apply, hact] using ρ.valid j) p ps hp s hsnd (by omega)
        have hnext : parkIndex (((ρ.cfg (j + 1)).st dst).parked) s ≤ n := by
          have := hrec.1
          omega
        have hltn : parkIndex (((ρ.cfg (j + 1)).st dst).parked) s <
            (((ρ.cfg (j + 1)).st dst).parked).length := hrec.2
        exact ih (j + 1)
          (fun t ht => hstay t (Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) ht)))
          (fun t ht => halive t (Nat.le_trans hj (Nat.le_trans (Nat.le_succ j) ht)))
          hnext hltn

/-- What `execRun` does on a `terminate` head: nothing, a lone release, or the subtree kill. -/
theorem exec_term_world (I : Impl) (w : World) (id : InstId) (k : Cont) (tail : List Eff)
    (hk : k.rest = .terminate :: tail) :
    execRun I w id (w.st id) k = w ∨
      (∃ t, templateOf I.desc (tname id) = some t ∧ t.subtree = "" ∧ t.terminable = true ∧
        hasParkedCall (w.st id).parked = false ∧ hasChild I.desc w id = false ∧
        execRun I w id (w.st id) k = releaseWorld I.desc w id (w.st id)) ∨
      (∃ t, templateOf I.desc (tname id) = some t ∧ t.terminable = true ∧
        (t.subtree ≠ "" ∨ hasChild I.desc w id = true) ∧
        (t.subtree = "" → hasParkedCall (w.st id).parked = false) ∧
        execRun I w id (w.st id) k = terminateStage I.desc w id (w.st id)) := by
  have hk' : k = ⟨.terminate :: tail, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
    cases k with
    | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
      cases hk
      rfl
  rw [hk']
  exact execRun_terminate I w id (w.st id) tail k.toState k.replyTo

/-- A lone terminable's `terminate` is the single-actor release. -/
theorem exec_lone_release (I : Impl) (w : World) (id : InstId) (t : Template)
    (tail : List Eff) (toState : String) (replyTo : Option InstId)
    (ht : templateOf I.desc (tname id) = some t) (hsub : t.subtree = "")
    (htm : t.terminable = true) (hpk : hasParkedCall (w.st id).parked = false)
    (hch : hasChild I.desc w id = false) :
    execRun I w id (w.st id) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ =
      releaseWorld I.desc w id (w.st id) := by
  have hgo : (t.terminable && (t.subtree != "" || !hasParkedCall (w.st id).parked)) = true := by
    simp [htm, hsub, hpk, bne]
  have hinner : (t.subtree == "") = true := by simpa [beq_iff_eq] using hsub
  simp [execRun, ht, hgo, hinner, hch, releaseWorld]

theorem terminate_unblocks (I : Impl) (w : World) (id : InstId) (t : Template) (tail : List Eff)
    (toState : String) (replyTo : Option InstId) (s : InstId) (k : Cont) (hM : MailInv w)
    (ht : templateOf I.desc (tname id) = some t) (hsub : t.subtree = "")
    (htm : t.terminable = true) (hpk : hasParkedCall (w.st id).parked = false)
    (hch : hasChild I.desc w id = false)
    (hph : (w.st s).phase = .parked id false k) (hne : s ≠ id) :
    waitKind ((execRun I w id (w.st id) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩).st s) ≠
      some (.blockingSend id) := by
  obtain ⟨p, hp, hs, hc⟩ := hM.bwd s id false k hph
  let base := refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box)
    (tname id) (w.st id).parked
  have hphb : (base.st s).phase = .parked id false k := by
    simp [base, readCells_st, phase_refund, phase_refundP, hph]
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hphs : ((setActor base id dead).st s).phase = .parked id false k := by
    simp [setActor, hne, hphb]
  have hrel := release_resumes_send (setActor base id dead) id (w.st id).parked s k
    ⟨p, hp, hs, hc⟩ hne hphs
  have hstep : execRun I w id (w.st id) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ =
      releaseParked (setActor base id dead) id (w.st id).parked := by
    rw [exec_lone_release I w id t tail toState replyTo ht hsub htm hpk hch]
    simp [releaseWorld, base, dead]
  rw [hstep]
  cases hk : k.rest with
  | nil =>
    simp [proceed, hk] at hrel
    unfold waitKind
    rw [hrel]
    simp
  | cons _ _ =>
    simp [proceed, hk] at hrel
    unfold waitKind
    rw [hrel]
    simp

theorem parkIndex_of_mem (ps : List Parked) (s : InstId) (h : ∃ p, p ∈ ps ∧ p.sender = s) :
    parkIndex ps s < ps.length := by
  induction ps with
  | nil =>
    obtain ⟨_, hp, _⟩ := h
    cases hp
  | cons p ps ih =>
    obtain ⟨q, hq, hqs⟩ := h
    by_cases hs : p.sender = s
    · simp [parkIndex, hs, List.length]
    · have hb : (p.sender == s) = false := by simpa [beq_iff_eq] using hs
      cases hq with
      | head => exact absurd hqs hs
      | tail _ ht =>
        have hlt := ih ⟨q, ht, hqs⟩
        simp [parkIndex, hb, List.length]
        omega

theorem blocking_parked (a : Actor) (dst : InstId) (h : waitKind a = some (.blockingSend dst)) :
    ∃ k, a.phase = .parked dst false k := by
  cases hph : a.phase <;> simp [waitKind, hph] at h
  case parked dst' c k =>
    cases c <;> simp at h
    · rcases h with ⟨rfl, rfl⟩
      exact ⟨k, rfl⟩

theorem call_parked_or_await (a : Actor) (dst : InstId) (h : waitKind a = some (.callReply dst)) :
    (∃ k, a.phase = .parked dst true k) ∨ (∃ k, a.phase = .awaitReply dst k) := by
  cases hph : a.phase <;> simp [waitKind, hph] at h
  case parked dst' c k =>
    cases c <;> simp at h
    · rcases h with ⟨rfl, rfl⟩
      exact Or.inl ⟨k, rfl⟩
  case awaitReply dst' k =>
    cases h
    exact Or.inr ⟨k, rfl⟩

def rankAt (hs : List (Node × Nat)) (w : World) (id : InstId) : Nat :=
  heightOf hs ({ template := tname id, state := (w.st id).typestate } : Node)

theorem finish_life (I : Impl) (w w' : World) (id i : InstId) (h : finishWait I w id = some w')
    (hl : (w.st i).life = .alive) : (w'.st i).life = .alive := by
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  by_cases hi : i = id
  · rw [hi] at hl ⊢
    simpa [setActor, proceed_life] using hl
  · simpa [setActor, hi] using hl

/-- Releasing a parked list resumes senders and never rewrites a life. -/
theorem release_life_all (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).life = (w.st i).life := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w
    · rw [if_neg hskip]
      have hstep :
          ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).life =
            (w.st i).life := by
        by_cases hi : i = p.sender
        · rw [hi]
          simp [setActor, resume_life]
        · simp [setActor, hi]
      exact (ih _).trans hstep

/-- A reply proceeds the sender and, when the caller is waiting on them, the caller.
Neither write changes a life. -/
theorem reply_life (w : World) (sender : InstId) (k : Cont) (i : InstId) :
    ((performReply w sender k).st i).life = (w.st i).life := by
  unfold performReply
  cases hr : k.replyTo with
  | none =>
    by_cases hi : i = sender
    · rw [hi]
      simp [setActor, proceed_life]
    · simp [setActor, hi]
  | some caller =>
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      by_cases hd : dst = sender
      · by_cases hi : i = sender
        · rw [hi]
          by_cases hsc : sender = caller
          · simp [setActor, proceed_life, hph, hd, hsc]
          · simp [setActor, proceed_life, hph, hd, hsc]
        · by_cases hc : i = caller
          · rw [hc]
            have hflip : ¬caller = sender := fun h => hi (hc.trans h)
            simp [setActor, proceed_life, hph, hd, hflip]
          · simp [setActor, hi, hc, hph, hd]
      · by_cases hi : i = sender
        · rw [hi]
          simp [setActor, proceed_life, hph, hd]
        · simp [setActor, hi, hph, hd]
    | idle =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]
    | run _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]
    | parked _ _ _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]
    | awaitEffect _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]
    | awaitPeer _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]
    | crashed =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_life, hph]
      · simp [setActor, hi, hph]

theorem reply_prio (w : World) (sender : InstId) (k : Cont) (i : InstId) :
    ((performReply w sender k).st i).prio = (w.st i).prio := by
  unfold performReply
  cases hr : k.replyTo with
  | none =>
    by_cases hi : i = sender
    · rw [hi]
      simp [setActor, proceed_prio]
    · simp [setActor, hi]
  | some caller =>
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      by_cases hd : dst = sender
      · by_cases hi : i = sender
        · rw [hi]
          by_cases hsc : sender = caller
          · simp [setActor, proceed_prio, hph, hd, hsc]
          · simp [setActor, proceed_prio, hph, hd, hsc]
        · by_cases hc : i = caller
          · rw [hc]
            have hflip : ¬caller = sender := fun h => hi (hc.trans h)
            simp [setActor, proceed_prio, hph, hd, hflip]
          · simp [setActor, hi, hc, hph, hd]
      · by_cases hi : i = sender
        · rw [hi]
          simp [setActor, proceed_prio, hph, hd]
        · simp [setActor, hi, hph, hd]
    | idle =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]
    | run _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]
    | parked _ _ _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]
    | awaitEffect _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]
    | awaitPeer _ =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]
    | crashed =>
      by_cases hi : i = sender
      · rw [hi]
        simp [setActor, proceed_prio, hph]
      · simp [setActor, hi, hph]

/-- Delivering a message reads cells and installs a phase. It does not change a life. -/
theorem deliver_keeps_life (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (i : InstId) (h : deliver I w id a m = some (w1, a1)) :
    a1.life = a.life ∧ (w1.st i).life = (w.st i).life := by
  unfold deliver at h
  have hst := readCells_st I.desc w id i
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        exact ⟨rfl, congrArg (fun a => a.life) hst⟩
    · next tr =>
      split at h
      · cases h
      · split at h
        · cases h
          exact ⟨rfl, congrArg (fun a => a.life) hst⟩
        · cases h
          exact ⟨rfl, congrArg (fun a => a.life) hst⟩

/-- Someone else's `exec` leaves `i`'s life as it was, or aborts `i` inside that
actor's `terminate`. Siblings are not aborted. -/
theorem exec_other_life (I : Impl) (w : World) (id i : InstId) (k : Cont) (hne : i ≠ id) :
    ((execRun I w id (w.st id) k).st i).life = (w.st i).life ∨
      ∃ t, templateOf I.desc (tname id) = some t ∧ t.terminable = true ∧
        (t.subtree ≠ "" ∨ hasChild I.desc w id = true) ∧
        (t.subtree = "" → hasParkedCall (w.st id).parked = false) ∧
        execRun I w id (w.st id) k = terminateStage I.desc w id (w.st id) ∧
        ((terminateStage I.desc w id (w.st id)).st i).life ≠ (w.st i).life := by
  cases hk : k.rest with
  | nil =>
    left
    simp [execRun, hk, setActor, hne]
  | cons eff tail =>
    cases eff with
    | send dst label hint =>
      simp [execRun, hk]
      cases hr : route w I.desc id dst with
      | none =>
        left
        simp [hr, setActor, hne, proceed_life]
      | some dstId =>
        left
        simp [hr]
        exact enqueue_life w I.desc id dstId _ false _ i
    | trySend dst label hint onFull onGone =>
      simp [execRun, hk]
      cases hr : route w I.desc id dst with
      | none =>
        left
        simp [hr, setActor, hne, proceed_life]
      | some dstId =>
        simp [hr]
        split
        · left
          exact enqueue_life w I.desc id dstId
            { label := label, sender := id, callFrom := none, reliable := false } false _ i
        · left
          simp [setActor, hne, proceed_life]
    | call dst label hint na to =>
      simp [execRun, hk]
      cases hr : route w I.desc id dst with
      | none =>
        left
        simp [hr, setActor, hne, proceed_life]
      | some dstId =>
        left
        simp [hr]
        exact enqueue_life w I.desc id dstId _ true _ i
    | reply =>
      left
      simp [execRun, hk]
      exact reply_life w id k i
    | selfSchedule label =>
      simp [execRun, hk]
      split
      · left
        simp [setActor, hne, proceed_life]
      · split
        · left
          simp [setActor, hne, proceed_life]
        · left
          simp [setActor, hne]
    | cell dst label value =>
      simp only [execRun, hk]
      split
      · left
        simp [setCell, setActor, hne, proceed_life]
      · left
        rw [wakeReaders]
        rw [wakes_life _ _ _ dst label id i]
        simp [setCell, setActor, hne, proceed_life]
    | internal =>
      left
      simp [execRun, hk, setActor, hne]
    | peer onTimeout =>
      left
      simp [execRun, hk, setActor, hne]
    | terminate =>
      rcases exec_term_world I w id k tail hk with
        hkept | ⟨t, ht, hsub, htm, hpk, _hch, hrel⟩ | ⟨t, ht, htm, hdesc, hpk, hstage⟩
      · exact Or.inl (by rw [hkept])
      · apply Or.inl
        rw [hrel]
        let base :=
          refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
            (w.st id).parked
        let dead : Actor :=
          { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
        have hbase : (base.st i).life = (w.st i).life := by
          have hread := readCells_st I.desc w id i
          have href := (refund_life (readCells I.desc w id) (tname id) (w.st id).box i).1
          have hrefp :=
            (refundP_life (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
              (w.st id).parked i).1
          simp [base, hread, href, hrefp]
        have hset : ((setActor base id dead).st i).life = (w.st i).life := by
          simp [setActor, hne, hbase]
        have hstep : releaseWorld I.desc w id (w.st id) =
            releaseParked (setActor base id dead) id (w.st id).parked := by
          simp [releaseWorld, base, dead]
        rw [hstep]
        exact (release_life_all (setActor base id dead) id (w.st id).parked i).trans hset
      · by_cases hsame : ((terminateStage I.desc w id (w.st id)).st i).life = (w.st i).life
        · rw [hstage]
          exact Or.inl hsame
        · exact Or.inr ⟨t, ht, htm, hdesc, hpk, hstage, hsame⟩

theorem bulk_life (I : Impl) (w w' : World) (id i : InstId) (h : receiveBulk I w id = some w') :
    (w'.st i).life = (w.st i).life := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hpark : (w.st id).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hkeep := deliver_keeps_life I w id _ p.msg w1 a1 i hdel
          have hset : ((setActor w1 id a1).st i).life = (w.st i).life := by
            by_cases hi : i = id
            · rw [hi]
              simpa [setActor] using hkeep.1
            · simpa [setActor, hi] using hkeep.2
          have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) p.msg.sender i).1
          by_cases hs : i = p.sender
          · rw [hs] at hcred hset ⊢
            simp only [setActor, ite_true, resume_life]
            exact hcred.trans hset
          · simp only [setActor, hs]
            exact hcred.trans hset
    | cons m ms =>
      cases hpark : (w.st id).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hkeep := deliver_keeps_life I w id _ m w1 a1 i hdel
          have hset : ((setActor w1 id a1).st i).life = (w.st i).life := by
            by_cases hi : i = id
            · rw [hi]
              simpa [setActor] using hkeep.1
            · simpa [setActor, hi] using hkeep.2
          exact ((creditLive_keeps (setActor w1 id a1) (tname id) m.sender i).1).trans hset
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hkeep := deliver_keeps_life I w id _ m w1 a1 i hdel
          let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hset : ((setActor w1 id admitted).st i).life = (w.st i).life := by
            by_cases hi : i = id
            · rw [hi]
              simpa [setActor, admitted] using hkeep.1
            · simpa [setActor, hi] using hkeep.2
          have hcred := (creditLive_keeps (setActor w1 id admitted) (tname id) m.sender i).1
          by_cases hs : i = p.sender
          · rw [hs] at hcred hset ⊢
            simp only [setActor, ite_true, resume_life]
            exact hcred.trans hset
          · simp only [setActor, hs]
            exact hcred.trans hset

theorem prio_life (I : Impl) (w w' : World) (id i : InstId) (h : receivePrio I w id = some w') :
    (w'.st i).life = (w.st i).life := by
  unfold receivePrio at h
  cases hp : (w.st id).prio with
  | nil => simp [hp] at h
  | cons m ms =>
    by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
    · simp [hp, hready] at h
    · simp [hp, hready] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hkeep := deliver_keeps_life I w id _ m w1 a1 i hdel
        by_cases hi : i = id
        · rw [hi]
          simpa [setActor] using hkeep.1
        · simpa [setActor, hi] using hkeep.2

theorem spawn_life (I : Impl) (w : World) (template : String) (w' : World) (i : InstId)
    (h : spawn I w template = some w') (hl : (w.st i).life = .alive) :
    (w'.st i).life = .alive := by
  unfold spawn at h
  split at h
  · cases h
  · next t ht =>
    split at h
    · cases h
      simp only [readCells_st]
      by_cases hi : i = InstId.peer template (w.nextIx template)
      · simp [setActor, hi, withTokens]
      · simpa [setActor, hi] using hl
    · cases h

/-- A life leaves `alive` only by that actor's own committing `terminate`, or by an
ancestor's `terminate` aborting the actor. A sibling is not aborted. -/
theorem only_terminate_kills (I : Impl) (a : Action) (w w' : World) (i : InstId)
    (h : apply I a w = some w') (hl : (w.st i).life = .alive) (hdead : (w'.st i).life ≠ .alive) :
    (∃ tail toState replyTo t,
      a = .exec i ∧ (w.st i).phase = .run ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ ∧
        templateOf I.desc (tname i) = some t ∧ t.subtree = "" ∧ t.terminable = true ∧
        hasParkedCall (w.st i).parked = false ∧ hasChild I.desc w i = false) ∨
      (∃ id t, a = .exec id ∧ templateOf I.desc (tname id) = some t ∧ t.terminable = true ∧
        (t.subtree ≠ "" ∨ hasChild I.desc w id = true) ∧
        (t.subtree = "" → hasParkedCall (w.st id).parked = false) ∧
        w' = terminateStage I.desc w id (w.st id) ∧
        (i = id ∨ ((w'.st i).life ≠ (w.st i).life))) := by
  cases a with
  | callTimeout id =>
    exact hdead ((callTimeout_life w w' id i (by simpa [stepWorld] using stepOfApply h)).trans hl)
  | stutter =>
    cases stutter_unchanged I w w' h
    exact False.elim (hdead hl)
  | ingress who label =>
    have hlife := (ingress_phase I w w' who label i (by simpa [stepWorld] using stepOfApply h)).2.1
    exact False.elim (hdead (hlife.trans hl))
  | recvBulk id =>
    exact absurd (bulk_life I w w' id i (by simpa [stepWorld] using stepOfApply h) ▸ hl) hdead
  | recvPrio id =>
    exact absurd (prio_life I w w' id i (by simpa [stepWorld] using stepOfApply h) ▸ hl) hdead
  | finish id =>
    exact absurd (finish_life I w w' id i (by simpa [stepWorld] using stepOfApply h) hl) hdead
  | spawn template =>
    exact absurd (spawn_life I w template w' i (by simpa [stepWorld] using stepOfApply h) hl) hdead
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold execHead at h
    by_cases hlid : (w.st id).life = .alive
    · simp [hlid] at h
      cases hph : (w.st id).phase with
      | run k =>
        simp [hph] at h
        cases h
        by_cases hme : i = id
        · cases hk : k.rest with
          | nil =>
            exfalso
            rw [hme] at hdead
            simp [execRun, hk, setActor, hlid] at hdead
          | cons e tail =>
            cases e with
            | terminate =>
              rcases exec_term_world I w id k tail hk with
                hkept | ⟨t, ht, hsub, htm, hpk, hch, hrel⟩ | ⟨t, ht, htm, hdesc, hpk, hstage⟩
              · exfalso
                rw [hme] at hdead
                rw [hkept] at hdead
                exact hdead hlid
              · have hk' : k = ⟨.terminate :: tail, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
                  cases k with
                  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
                    cases hk
                    rfl
                have hphase : (w.st i).phase = .run ⟨.terminate :: tail, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
                  rw [hk'] at hph
                  simpa [hme] using hph
                exact Or.inl ⟨tail, k.toState, k.replyTo, t, by rw [hme], hphase,
                  by simpa [hme] using ht, hsub, htm, by simpa [hme] using hpk,
                  by simpa [hme] using hch⟩
              · exact Or.inr ⟨id, t, rfl, ht, htm, hdesc, hpk, hstage, Or.inl hme⟩
            | send dst label hint =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk] at hdead
              cases hr : route w I.desc id dst with
              | none => simp [hr, setActor, proceed_life, hlid] at hdead
              | some dstId =>
                simp [hr] at hdead
                have heq := enqueue_life w I.desc id dstId
                  ({ label := label, sender := id, callFrom := none } : Msg) false (afterHead k) id
                simp [heq, hlid] at hdead
            | trySend dst label hint onFull onGone =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk] at hdead
              cases hr : route w I.desc id dst with
              | none => simp [hr, setActor, proceed_life, hlid] at hdead
              | some dstId =>
                simp [hr] at hdead
                split at hdead
                · have heq := enqueue_life w I.desc id dstId
                    ({ label := label, sender := id, callFrom := none, reliable := false } : Msg)
                    false (afterHead k) id
                  simp [heq, hlid] at hdead
                · simp [setActor, proceed_life, hlid] at hdead
            | call dst label hint na to =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk] at hdead
              cases hr : route w I.desc id dst with
              | none => simp [hr, setActor, proceed_life, hlid] at hdead
              | some dstId =>
                simp [hr] at hdead
                have heq := enqueue_life w I.desc id dstId
                  ({ label := label, sender := id, callFrom := some id } : Msg) true (afterHead k) id
                simp [heq, hlid] at hdead
            | reply =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk, reply_life, hlid] at hdead
            | selfSchedule label =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk] at hdead
              split at hdead
              · simp [setActor, proceed_life, hlid] at hdead
              · split at hdead
                · simp [setActor, proceed_life, hlid] at hdead
                · simp [setActor, hlid] at hdead
            | cell dst label value =>
              exfalso
              rw [hme] at hdead
              simp only [execRun, hk] at hdead
              split at hdead
              · simp [setCell, setActor, proceed_life, hlid] at hdead
              · rw [wakeReaders] at hdead
                rw [wakes_life (readersOf _ _) I.desc _ dst label id id] at hdead
                simp [setCell, setActor, proceed_life, hlid] at hdead
            | internal =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk, setActor, hlid] at hdead
            | peer onTimeout =>
              exfalso
              rw [hme] at hdead
              simp [execRun, hk, setActor, hlid] at hdead
        · rcases exec_other_life I w id i k (fun h => hme h) with
            hsame | ⟨t, ht, htm, hdesc, hpk, hstage, hchanged⟩
          · exact absurd (hsame.trans hl) hdead
          · exact Or.inr ⟨id, t, rfl, ht, htm, hdesc, hpk, hstage, Or.inr (by rw [hstage]; exact hchanged)⟩
      | idle => simp [hph] at h
      | parked _ _ _ => simp [hph] at h
      | awaitReply _ _ => simp [hph] at h
      | awaitEffect _ => simp [hph] at h
      | awaitPeer _ => simp [hph] at h
      | crashed => simp [hph] at h
    · simp [hlid] at h

/-- A non-alive idle actor is not given a new phase by one step. -/
theorem dead_stays_idle (I : Impl) (a : Action) (w w' : World) (i : InstId)
    (h : apply I a w = some w') (hdead : (w.st i).life ≠ .alive)
    (hidle : (w.st i).phase = .idle) : (w'.st i).phase = .idle := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress who label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    exact (ingress_phase I w w' who label i h).1.trans hidle
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold execHead at h
    by_cases hl : (w.st id).life = .alive
    · simp [hl] at h
      cases hp : (w.st id).phase with
      | run k =>
        simp [hp] at h
        cases h
        by_cases hi : i = id
        · rw [hi] at hidle
          simp [hp] at hidle
        · rcases exec_keeps_quiet I w id (w.st id) k i hi
            (fun d c ck hbad => by simp [hidle] at hbad)
            (fun d ck hbad => by simp [hidle] at hbad) with
            hkeep | ⟨hold, _, hidle'⟩ | ⟨hold, _, _⟩ | ⟨hidle', _, _, _⟩
          · rw [hkeep.1]
            exact hidle
          · exact absurd hold hdead
          · exact absurd hold hdead
          · exact hidle'
      | idle => simp [hp] at h
      | parked _ _ _ => simp [hp] at h
      | awaitReply _ _ => simp [hp] at h
      | awaitEffect _ => simp [hp] at h
      | awaitPeer _ => simp [hp] at h
      | crashed => simp [hp] at h
    · simp [hl] at h
  | recvBulk id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    by_cases hi : i = id
    · have hdead' : (w.st id).life ≠ .alive := by rw [← hi]; exact hdead
      unfold receiveBulk at h
      have hguard : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle := Or.inl hdead'
      simp [hguard] at h
    · rw [(bulk_keeps_quiet I w id w' i hi
        (fun d c ck hbad => by simp [hidle] at hbad) h).1]
      exact hidle
  | recvPrio id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold receivePrio at h
    cases hprio : (w.st id).prio with
    | nil => simp [hprio] at h
    | cons m ms =>
      simp [hprio] at h
      by_cases hi : i = id
      · have hdead' : (w.st id).life ≠ .alive := by rw [← hi]; exact hdead
        simp [hdead'] at h
      · split at h
        · simp at h
        · next w1 a1 hdel =>
          simp at h
          rcases h with ⟨_, hw⟩
          rw [← hw, setActor_other w1 id i a1 hi, deliver_st I w id _ m w1 a1 i hdel, hidle]
  | finish id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨_, hphF, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    by_cases hi : i = id
    · rw [hi] at hidle
      rcases hphF with hphF | hphF <;> simp [hidle] at hphF
    · simp [setActor, hi, hidle]
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        let nid := InstId.peer template (w.nextIx template)
        by_cases hi : i = nid
        · simp [nid, readCells_st, setActor, hi, withTokens]
        · simp [nid, readCells_st, setActor, hi, hidle]
      · cases h

/-- A reachable phase that is neither idle nor crashed belongs to a live actor.
`SemInv.idleOff` says a life that is not alive is idle or crashed. A crashed
phase is the roster crash, not a wait, so a wait is alive. -/
theorem wait_alive (I : Impl) (hL : LocalOk I) (N : Nat) (w : World) (hR : Reachable I N w)
    (i : InstId) (hph : (w.st i).phase ≠ .idle) (hc : (w.st i).phase ≠ .crashed) :
    (w.st i).life = .alive := by
  have hS := sem_reachable I N w hL hR
  cases hlife : (w.st i).life with
  | alive => rfl
  | absent =>
    rcases hS.idleOff i (by rw [hlife]; intro he; cases he) with hidle | hbad
    · exact absurd hidle hph
    · exact absurd hbad hc
  | dead =>
    rcases hS.idleOff i (by rw [hlife]; intro he; cases he) with hidle | hbad
    · exact absurd hidle hph
    · exact absurd hbad hc

def offDst (w : World) (s dst : InstId) : Prop :=
  ∀ c k, (w.st s).phase ≠ .parked dst c k

/-- Still the blocking sender, and the receiver still has that entry. -/
def heldSend (w : World) (s dst : InstId) (k : Cont) : Prop :=
  (w.st s).phase = .parked dst false k ∧
    ∃ p, p ∈ (w.st dst).parked ∧ p.sender = s ∧ p.isCall = false

theorem proceed_off (a : Actor) (k : Cont) (dst : InstId) :
    ∀ c k', (proceed a k).phase ≠ .parked dst c k' := by
  intro c k'
  cases hk : k.rest <;> simp [proceed, hk]

theorem release_off_sender (w : World) (id : InstId) (ps : List Parked) (s : InstId) (k : Cont)
    (hmem : ∃ p, p ∈ ps ∧ p.sender = s ∧ p.isCall = false) (hne : s ≠ id)
    (hph : (w.st s).phase = .parked id false k) :
    offDst (releaseParked w id ps) s id := by
  have hres := release_resumes_send w id ps s k hmem hne hph
  intro c k' hbad
  have hfree := proceed_off (w.st s) k id c k'
  rw [hres] at hbad
  exact hfree hbad

theorem failWaiter_off (w : World) (dead i s dst : InstId) (h : offDst w s dst) :
    offDst (failWaiter w dead i) s dst := by
  intro c k hbad
  by_cases hs : s = i
  · unfold failWaiter at hbad
    split at hbad
    · exact h c k (by simpa [hs] using hbad)
    · cases hph : (w.st i).phase with
      | parked d b ck =>
        simp [hph] at hbad
        split at hbad
        · rw [hs] at hbad
          simp [setActor] at hbad
          cases hk : ck.rest <;> simp [proceed, hk] at hbad
        · exact h c k (by simpa [hs] using hbad)
      | awaitReply d ck =>
        simp [hph] at hbad
        split at hbad
        · rw [hs] at hbad
          simp [setActor] at hbad
        · exact h c k (by simpa [hs] using hbad)
      | idle => simp [hph] at hbad; exact h c k (by simpa [hs] using hbad)
      | run _ => simp [hph] at hbad; exact h c k (by simpa [hs] using hbad)
      | awaitEffect _ => simp [hph] at hbad; exact h c k (by simpa [hs] using hbad)
      | awaitPeer _ => simp [hph] at hbad; exact h c k (by simpa [hs] using hbad)
      | crashed => simp [hph] at hbad; exact h c k (by simpa [hs] using hbad)
  · rw [failWaiter_other w dead i s hs] at hbad
    exact h c k hbad

theorem offFold (w : World) (dead s dst : InstId) (ids : List InstId) (h : offDst w s dst) :
    offDst (ids.foldl (fun w i => failWaiter w dead i) w) s dst := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (failWaiter_off w dead i s dst h)

theorem admit_off (w : World) (dead s dst : InstId) (h : offDst w s dst) :
    offDst (admitDead w dead) s dst := by
  intro c k hbad
  exact h c k ((admitDead_phase w dead s).1 ▸ hbad)

theorem resume_off (a : Actor) (dst id : InstId)
    (h : ∀ c k, a.phase ≠ .parked dst c k) :
    ∀ c k, (resumeSender a false id).phase ≠ .parked dst c k := by
  intro c k hbad
  cases hph : a.phase with
  | parked _ _ ck =>
    simp [resumeSender, hph] at hbad
    cases hk : ck.rest <;> simp [proceed, hk] at hbad
  | idle => exact h c k (by simpa [resumeSender, hph] using hbad)
  | run _ => exact h c k (by simpa [resumeSender, hph] using hbad)
  | awaitReply _ _ => exact h c k (by simpa [resumeSender, hph] using hbad)
  | awaitEffect _ => exact h c k (by simpa [resumeSender, hph] using hbad)
  | awaitPeer _ => exact h c k (by simpa [resumeSender, hph] using hbad)
  | crashed => exact h c k (by simpa [resumeSender, hph] using hbad)

theorem release_keeps_off (w : World) (id : InstId) (ps : List Parked) (s dst : InstId)
    (h : offDst w s dst) : offDst (releaseParked w id ps) s dst := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w h
    · rw [if_neg hskip]
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      have h' : offDst w' s dst := by
        intro c k hbad
        by_cases hs : s = p.sender
        · have hres := resume_off (w.st p.sender) dst id
            (fun c k hbad2 => h c k (by simpa [hs] using hbad2)) c k
          exact hres (by simpa [w', setActor, hs] using hbad)
        · exact h c k (by simpa [w', setActor, hs] using hbad)
      exact ih w' h'

theorem releaseWorld_off (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (h : offDst w s dst) : offDst (releaseWorld D w id a) s dst := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hbase : offDst base s dst := by
    intro c k hbad
    exact h c k (by simpa [base, phase_refund, phase_refundP, readCells_st] using hbad)
  have hset : offDst (setActor base id dead) s dst := by
    intro c k hbad
    by_cases hs : s = id
    · simp [setActor, hs, dead] at hbad
    · exact hbase c k (by simpa [setActor, hs] using hbad)
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead]
  simpa [hworld] using release_keeps_off (setActor base id dead) id a.parked s dst hset

theorem abort_off (D : Description) (w : World) (id s dst : InstId) (a : Actor)
    (h : offDst w s dst) : offDst (abortActor D w id a) s dst := by
  exact admit_off _ id s dst
    (offFold _ id s dst _ (releaseWorld_off D w id a s dst h))

/-- Aborting the receiver resumes a non-call sender parked on it. -/
theorem abort_frees_held (D : Description) (w : World) (id s : InstId) (k : Cont)
    (h : heldSend w s id k) (hne : s ≠ id) :
    offDst (abortActor D w id (w.st id)) s id := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) (w.st id).box) (tname id)
    (w.st id).parked
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hph : ((setActor base id dead).st s).phase = .parked id false k := by
    simp [setActor, hne, base, phase_refund, phase_refundP, readCells_st, h.1]
  have hworld : releaseWorld D w id (w.st id) =
      releaseParked (setActor base id dead) id (w.st id).parked := by
    simp [releaseWorld, base, dead]
  have hrel : offDst (releaseWorld D w id (w.st id)) s id := by
    rw [hworld]
    exact release_off_sender (setActor base id dead) id (w.st id).parked s k h.2 hne hph
  exact admit_off _ id s id (offFold _ id s id _ hrel)

theorem release_held_or_off (w : World) (id : InstId) (ps : List Parked) (s dst : InstId)
    (k : Cont) (hph : (w.st s).phase = .parked dst false k) (hne : s ≠ id) (hd : dst ≠ id) :
    ((releaseParked w id ps).st s).phase = .parked dst false k ∨
      offDst (releaseParked w id ps) s dst := by
  induction ps generalizing w with
  | nil =>
    left
    simpa [releaseParked] using hph
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w hph
    · rw [if_neg hskip]
      by_cases hs : s = p.sender
      · right
        let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
        have hfree : offDst w' s dst := by
          intro c k' hbad
          have hres : (resumeSender (w.st s) false id).phase = (proceed (w.st s) k).phase := by
            simp [resumeSender, hph]
          have hbad' : (resumeSender (w.st s) false id).phase = .parked dst c k' := by
            simpa [w', setActor, hs] using hbad
          exact proceed_off (w.st s) k dst c k' (hres ▸ hbad')
        exact release_keeps_off w' id ps s dst hfree
      · have hph' : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st s).phase =
            .parked dst false k := by
          simp [setActor, hph, if_neg hs]
        have hgoal := ih (setActor w p.sender (resumeSender (w.st p.sender) false id)) hph'
        simpa [releaseParked] using hgoal

theorem failWaiter_keeps_foreign (w : World) (dead i s dst : InstId) (k : Cont)
    (hph : (w.st s).phase = .parked dst false k) (hd : dst ≠ dead) :
    ((failWaiter w dead i).st s).phase = .parked dst false k := by
  by_cases hlive : (w.st i).life = .alive
  · have hgo : ((w.st i).life != .alive) = false := by simp [hlive, bne]
    simp only [failWaiter, hgo, ite_false]
    cases hphase : (w.st i).phase with
    | parked d _ ck =>
      by_cases hd' : d = dead
      · by_cases hs : s = i
        · rw [hs, hphase, hd'] at hph
          exact absurd (Phase.parked.inj hph).1 (Ne.symm hd)
        · simp [hphase, hd', setActor, if_neg hs, hph]
      · simp [hphase, hd', hph]
    | awaitReply d ck =>
      by_cases hd' : d = dead
      · by_cases hs : s = i
        · rw [hs, hphase] at hph
          cases hph
        · simp [hphase, hd', setActor, if_neg hs, hph]
      · simp [hphase, hd', hph]
    | idle => simp [hphase, hph]
    | run _ => simp [hphase, hph]
    | awaitEffect _ => simp [hphase, hph]
    | awaitPeer _ => simp [hphase, hph]
    | crashed => simp [hphase, hph]
  · have hgo : ((w.st i).life != .alive) = true := by
      cases hlife : (w.st i).life <;> simp_all [bne]
    simp [failWaiter, hgo, hph]

theorem offFail (w : World) (dead s dst : InstId) (ids : List InstId) (k : Cont)
    (hph : (w.st s).phase = .parked dst false k) (hd : dst ≠ dead) :
    ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase = .parked dst false k := by
  induction ids generalizing w with
  | nil => simpa using hph
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (failWaiter_keeps_foreign w dead i s dst k hph hd)

theorem admitHost_keeps_sender (w : World) (dead host dst : InstId) (p : Parked)
    (hmem : p ∈ (w.st dst).parked) (hs : p.sender ≠ dead) :
    p ∈ ((admitHost w dead host).st dst).parked := by
  unfold admitHost
  split
  · exact hmem
  · split
    · exact hmem
    · by_cases hh : dst = host
      · rw [hh, setActor_self]
        exact List.mem_filter.mpr ⟨by rw [← hh]; exact hmem, by simp [bne, hs]⟩
      · rw [setActor_other _ _ _ _ hh]
        exact hmem

theorem admitFold_keeps_sender (w : World) (dead dst : InstId) (ids : List InstId) (p : Parked)
    (hmem : p ∈ (w.st dst).parked) (hs : p.sender ≠ dead) :
    p ∈ ((ids.foldl (fun w host => admitHost w dead host) w).st dst).parked := by
  induction ids generalizing w with
  | nil => simpa using hmem
  | cons host ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (admitHost_keeps_sender w dead host dst p hmem hs)

/-- Aborting someone other than the sender and the receiver keeps the blocking
send, or resumes the sender because that someone held it. -/
theorem abort_other_hold (D : Description) (w : World) (id s dst : InstId) (k : Cont)
    (h : heldSend w s dst k) (hs : s ≠ id) (hd : dst ≠ id) :
    heldSend (abortActor D w id (w.st id)) s dst k ∨ offDst (abortActor D w id (w.st id)) s dst := by
  let a := w.st id
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  let dead : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hph0 : ((setActor base id dead).st s).phase = .parked dst false k := by
    simp [setActor, hs, base, phase_refund, phase_refundP, readCells_st, h.1]
  have hworld : releaseWorld D w id a = releaseParked (setActor base id dead) id a.parked := by
    simp [releaseWorld, base, dead, a]
  rcases release_held_or_off (setActor base id dead) id a.parked s dst k hph0 hs hd with hstay | hfree
  · have hstay' : ((releaseWorld D w id a).st s).phase = .parked dst false k := by
      simpa [hworld] using hstay
    have hfail := offFail (releaseWorld D w id a) id s dst (releaseWorld D w id a).roster k hstay' hd
    have hpark := releaseWorld_parked D w id a dst hd
    rcases h.2 with ⟨p, hmem, hsender, hcall⟩
    have hmem' : p ∈ ((failWaiters (releaseWorld D w id a) id).st dst).parked := by
      simp only [failWaiters]
      rw [failFold_parked, hpark]
      exact hmem
    have hadmit := admitFold_keeps_sender (failWaiters (releaseWorld D w id a) id) id dst
      (failWaiters (releaseWorld D w id a) id).roster p hmem' (by simpa [hsender] using hs)
    have hph' : ((abortActor D w id a).st s).phase = .parked dst false k := by
      have hphase := admitDead_phase (failWaiters (releaseWorld D w id a) id) id s
      simpa [abortActor] using hphase.1.trans hfail
    left
    refine ⟨hph', p, ?_, hsender, hcall⟩
    simpa [abortActor, admitDead] using hadmit
  · right
    have hfree' : offDst (releaseWorld D w id a) s dst := by
      rw [hworld]
      exact hfree
    exact admit_off _ id s dst (offFold _ id s dst _ hfree')

theorem tombstone_off (D : Description) (w : World) (child s dst : InstId) (h : offDst w s dst) :
    offDst (enqueueTombstone D w child) s dst := by
  intro c k hbad
  exact h c k ((enqueueTombstone_phase D w child s).symm.trans hbad)

theorem abortDesc_off (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (h : offDst w s dst) : offDst (abortDesc fuel D w parent) s dst := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using h
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), offDst w0 s dst →
        offDst (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        exact ihf _ (abort_off D (abortDesc fuel D w0 c) c s dst
          ((abortDesc fuel D w0 c).st c) (ih w0 c h0))
      · rw [if_neg hgo]
        exact ihf w0 h0

/-- Aborting descendants keeps a blocking send, or resumes its sender. A receiver
that dies along the way has resumed that sender. -/
theorem abortDesc_sender (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (k : Cont) (hsd : s ≠ dst) (hheld : heldSend w s dst k) (halive : (w.st dst).life = .alive) :
    offDst (abortDesc fuel D w parent) s dst ∨
      ((abortDesc fuel D w parent).st dst).life = .alive ∧
        (heldSend (abortDesc fuel D w parent) s dst k ∨ offDst (abortDesc fuel D w parent) s dst) := by
  induction fuel generalizing w parent with
  | zero =>
    right
    simpa [abortDesc] using And.intro halive (Or.inl hheld)
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World),
        offDst w0 s dst ∨
          ((w0.st dst).life = .alive ∧ (heldSend w0 s dst k ∨ offDst w0 s dst)) →
        offDst (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst ∨
          ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st dst).life = .alive ∧
            (heldSend (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst k ∨
              offDst (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst) by
      exact this w.roster w (Or.inr ⟨halive, Or.inl hheld⟩)
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        let w1 := abortDesc fuel D w0 c
        have hrec : offDst w1 s dst ∨
            ((w1.st dst).life = .alive ∧ (heldSend w1 s dst k ∨ offDst w1 s dst)) := by
          rcases h0 with hoff | ⟨ha, hhold⟩
          · left
            exact abortDesc_off fuel D w0 c s dst hoff
          · rcases hhold with hheld0 | hoff
            · exact ih w0 c hheld0 ha
            · left
              exact abortDesc_off fuel D w0 c s dst hoff
        have hstep : offDst (abortActor D w1 c (w1.st c)) s dst ∨
            ((abortActor D w1 c (w1.st c)).st dst).life = .alive ∧
              (heldSend (abortActor D w1 c (w1.st c)) s dst k ∨
                offDst (abortActor D w1 c (w1.st c)) s dst) := by
          rcases hrec with hoff | ⟨halive1, hhold⟩
          · left
            exact abort_off D w1 c s dst (w1.st c) hoff
          · rcases hhold with hheld1 | hoff
            · by_cases hc : c = dst
              · left
                rw [hc]
                exact abort_frees_held D w1 dst s k (hc ▸ hheld1) hsd
              · by_cases hcs : c = s
                · left
                  intro b k' hbad
                  have hidle := (abort_self D w1 c (w1.st c)).2
                  rw [← hcs] at hbad
                  rw [hidle] at hbad
                  cases hbad
                · have hlife := abortActor_other_life D w1 c dst (w1.st c) (Ne.symm hc)
                  rcases abort_other_hold D w1 c s dst k hheld1 (Ne.symm hcs) (Ne.symm hc) with hstay | hfree
                  · right
                    exact ⟨hlife.trans halive1, Or.inl hstay⟩
                  · left
                    exact hfree
            · left
              exact abort_off D w1 c s dst (w1.st c) hoff
        exact ihf _ hstep
      · rw [if_neg hgo]
        exact ihf w0 h0

/-- A receiver that dies inside `terminateStage` resumes a non-call sender parked on it. -/
theorem terminate_unparks (D : Description) (w : World) (id s dst : InstId) (k : Cont)
    (hsd : s ≠ dst) (h : heldSend w s dst k) (halive : (w.st dst).life = .alive)
    (hdead : ((terminateStage D w id (w.st id)).st dst).life ≠ .alive) :
    offDst (terminateStage D w id (w.st id)) s dst := by
  simp only [terminateStage] at hdead ⊢
  have hdesc := abortDesc_sender w.roster.length D w id s dst k hsd h halive
  by_cases hid : id = dst
  · rw [hid] at hdesc hdead ⊢
    let w1 := abortDesc w.roster.length D w dst
    have hoff2 : offDst (abortActor D w1 dst (w1.st dst)) s dst := by
      rcases hdesc with hoff | ⟨_, hhold⟩
      · exact abort_off D w1 dst s dst (w1.st dst) hoff
      · rcases hhold with hheld | hoff
        · exact abort_frees_held D w1 dst s k hheld hsd
        · exact abort_off D w1 dst s dst (w1.st dst) hoff
    exact tombstone_off D (abortActor D w1 dst (w1.st dst)) dst s dst hoff2
  · let w1 := abortDesc w.roster.length D w id
    let w2 := abortActor D w1 id (w1.st id)
    have hlife2 := abortActor_other_life D w1 id dst (w1.st id) (Ne.symm hid)
    have hlife3 := enqueueTombstone_life D w2 id dst
    have hdead1 : (w1.st dst).life ≠ .alive := by
      intro ha
      exact hdead (hlife3.trans (hlife2.trans ha))
    have hoff2 : offDst w2 s dst := by
      rcases hdesc with hoff | ⟨halive1, _⟩
      · exact abort_off D w1 id s dst (w1.st id) hoff
      · exact absurd halive1 hdead1
    exact tombstone_off D w2 id s dst hoff2

/-- While a blocking send stays parked, its receiver cannot die: the killing step would resume it. -/
theorem receiver_stays (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w)
    (a : Action) (w' : World) (s dst : InstId) (k k' : Cont)
    (h : apply I a w = some w') (hph : (w.st s).phase = .parked dst false k)
    (hph' : (w'.st s).phase = .parked dst false k') (halive : (w.st dst).life = .alive) :
    (w'.st dst).life = .alive := by
  cases Classical.em ((w'.st dst).life = .alive) with
  | inl h' => exact h'
  | inr hdead =>
    cases only_terminate_kills I a w w' dst h halive hdead with
    | inl hExecKill =>
      rcases hExecKill with ⟨tail, toState, replyTo, t, hact, hrun, ht, hsub, htm, hpk, hch⟩
      have hM := (inv_reachable I N w hL hR).2.1
      have hstep : w' = execRun I w dst (w.st dst) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ := by
        simp [apply, hact, execHead, halive, hrun] at h
        exact h.symm
      by_cases hne : s = dst
      · let base :=
          refundParked (refundMsgs (readCells I.desc w dst) (tname dst) (w.st dst).box) (tname dst)
            (w.st dst).parked
        let dead : Actor :=
          { base.st dst with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
        have hrunEq :
            execRun I w dst (w.st dst) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ =
              releaseParked (setActor base dst dead) dst (w.st dst).parked := by
          rw [exec_lone_release I w dst t tail toState replyTo ht hsub htm hpk hch]
          simp [releaseWorld, base, dead]
        have hidle : ((setActor base dst dead).st dst).phase = .idle := by simp [setActor, dead]
        have hn : ∀ d c ck, ((setActor base dst dead).st dst).phase ≠ .parked d c ck := by
          intro d c ck hbad
          simp [hidle] at hbad
        have hstay :=
          (release_keeps_nonparked (setActor base dst dead) dst (w.st dst).parked dst hn).1
        rw [hne] at hph'
        rw [hstep, hrunEq, hstay, hidle] at hph'
        cases hph'
      · have hclear :=
          terminate_unblocks I w dst t tail toState replyTo s k hM ht hsub htm hpk hch hph hne
        have hnow :
            waitKind ((execRun I w dst (w.st dst) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩).st s) =
              some (.blockingSend dst) := by
          have hphE := hph'
          rw [hstep] at hphE
          simp [waitKind, hphE]
        exact False.elim (hclear hnow)
    | inr hSubKill =>
      rcases hSubKill with ⟨who, t, hact, ht, htm, hdesc, hpk, hw, _hwho⟩
      by_cases hsd : s = dst
      · have hdie := terminate_died_idle I.desc w who dst (by
          intro heq
          rw [hw] at hdead
          exact hdead (heq.trans halive))
        rw [hw, hsd, hdie.2] at hph'
        cases hph'
      · have hM := (inv_reachable I N w hL hR).2.1
        obtain ⟨p, hp, hps, hc⟩ := hM.bwd s dst false k hph
        have hoff := terminate_unparks I.desc w who s dst k hsd ⟨hph, p, hp, hps, hc⟩ halive
          (by rw [hw] at hdead; exact hdead)
        rw [hw] at hph'
        exact absurd hph' (hoff false k')

theorem release_misses (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (h : ∀ p, p ∈ ps → p.sender ≠ s) : ((releaseParked w id ps).st s) = w.st s := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w (fun q hq => h q (List.mem_cons_of_mem p hq))
    · rw [if_neg hskip]
      have hne : s ≠ p.sender := fun heq => h p List.mem_cons_self heq.symm
      have hstep : (setActor w p.sender (resumeSender (w.st p.sender) false id)).st s = w.st s := by
        simp [setActor, hne]
      exact (ih _ (fun q hq => h q (List.mem_cons_of_mem p hq))).trans hstep

theorem resume_proceed_phase (a : Actor) (dst : InstId) (k : Cont)
    (h : a.phase = .parked dst false k) :
    (resumeSender a false dst).phase = (proceed a k).phase := by
  simp [resumeSender, h]

theorem proceed_phase_actor (a b : Actor) (k : Cont) :
    (proceed a k).phase = (proceed b k).phase := by
  cases hk : k.rest <;> simp [proceed, hk]

/-- Resuming the parked head of a blocking send runs its continuation. -/
theorem bulk_send_proceed (I : Impl) (w w' : World) (id : InstId) (h : receiveBulk I w id = some w')
    (p : Parked) (ps : List Parked) (hp : (w.st id).parked = p :: ps) (s : InstId)
    (hs : s = p.sender) (hne : s ≠ id) (k : Cont)
    (hph : (w.st s).phase = .parked id false k) (hc : p.isCall = false) :
    (w'.st s).phase = (proceed (w.st s) k).phase := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        have hst := deliver_st I w id _ p.msg w1 a1 s hdel
        have hpre := install_sender_phase w w1 id a1 p.msg.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self]
        rw [hc]
        exact (resume_proceed_phase _ id k (hpre.trans hph)).trans
          (proceed_phase_actor _ (w.st p.sender) k)
    | cons m ms =>
      simp [hbox, hp] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        cases h
        let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
        have hst := deliver_st I w id _ m w1 a1 s hdel
        have hpre := install_sender_phase w w1 id admitted m.sender s (by simpa [hs] using hne) hst
        rw [hs] at hpre hph ⊢
        simp only [setActor_self, admitted]
        rw [hc]
        exact (resume_proceed_phase _ id k (hpre.trans hph)).trans
          (proceed_phase_actor _ (w.st p.sender) k)

/-- A parked phase survives abortion, or the sender has been resumed or returned to idle.
Abortion never installs a fresh park. -/
abbrev phaseShape (w : World) (s dst : InstId) (call : Bool) (k : Cont) : Prop :=
  (w.st s).phase = .parked dst call k ∨ (w.st s).phase = resumed k ∨ (w.st s).phase = .idle

theorem phaseShape_cast (w₁ w₂ : World) (s dst : InstId) (call : Bool) (k : Cont)
    (hph : (w₂.st s).phase = (w₁.st s).phase) (h : phaseShape w₁ s dst call k) :
    phaseShape w₂ s dst call k := by
  rcases h with hpark | hres | hidle
  · exact Or.inl (hph.trans hpark)
  · exact Or.inr (Or.inl (hph.trans hres))
  · exact Or.inr (Or.inr (hph.trans hidle))

theorem shape_releaseParked (w : World) (id : InstId) (ps : List Parked) (s dst : InstId)
    (call : Bool) (k : Cont) (h : phaseShape w s dst call k) :
    phaseShape (releaseParked w id ps) s dst call k := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w h
    · rw [if_neg hskip]
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      have h' : phaseShape w' s dst call k := by
        by_cases hs : s = p.sender
        · subst hs
          unfold phaseShape
          simp only [w', setActor]
          rcases h with hpark | hres | hidle
          · simp [resumeSender, hpark]
            exact Or.inr (Or.inl (proceed_resumed _ k))
          · cases hk : k.rest with
            | nil =>
              have hid : (w.st p.sender).phase = .idle := by simpa [resumed, hk] using hres
              simp [resumeSender, hid]
            | cons _ _ =>
              have hrun : (w.st p.sender).phase = .run k := by simpa [resumed, hk] using hres
              simp [resumeSender, hrun, resumed, hk]
          · simp [resumeSender, hidle]
        · exact phaseShape_cast w w' s dst call k
            (congrArg (·.phase) (setActor_other w p.sender s _ hs)) h
      exact ih w' h'

theorem shape_release (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (call : Bool) (k : Cont) (h : phaseShape w s dst call k) :
    phaseShape (releaseWorld D w id a) s dst call k := by
  let wCells := readCells D w id
  let wMsgs := refundMsgs wCells (tname id) a.box
  let wPark := refundParked wMsgs (tname id) a.parked
  let dead : Actor :=
    { wPark.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hbody : releaseWorld D w id a = releaseParked (setActor wPark id dead) id a.parked := by
    simp [releaseWorld, wCells, wMsgs, wPark, dead]
  have hphase : (wPark.st s).phase = (w.st s).phase :=
    (refundParked_rest wMsgs (tname id) a.parked s).1.trans
      ((refundMsgs_rest wCells (tname id) a.box s).1.trans (congrArg (·.phase) (cellsSt D w id s)))
  rw [hbody]
  by_cases hs : s = id
  · have hidle : ((setActor wPark id dead).st s).phase = .idle := by
      simp [hs, setActor_self, dead]
    exact shape_releaseParked (setActor wPark id dead) id a.parked s dst call k (Or.inr (Or.inr hidle))
  · have hset : ((setActor wPark id dead).st s).phase = (wPark.st s).phase := by
      rw [setActor_other wPark id s dead hs]
    exact shape_releaseParked (setActor wPark id dead) id a.parked s dst call k
      (phaseShape_cast wPark (setActor wPark id dead) s dst call k hset
        (phaseShape_cast w wPark s dst call k hphase h))

theorem shape_fail (w : World) (dead i s dst : InstId) (call : Bool) (k : Cont)
    (h : phaseShape w s dst call k) : phaseShape (failWaiter w dead i) s dst call k := by
  by_cases hsi : s = i
  · subst hsi
    by_cases hlive : (w.st s).life = .alive
    · have hgo : ((w.st s).life != .alive) = false := by simp [hlive, bne]
      simp only [failWaiter, hgo, ite_false]
      rcases h with hpark | hres | hidle
      · unfold phaseShape
        simp only [hpark]
        by_cases hd : dst = dead
        · simp [hd, setActor]
          exact Or.inr (Or.inl (proceed_resumed _ k))
        · have hb : (dst == dead) = false := by simpa [beq_iff_eq] using hd
          simp [hb]
          exact Or.inl hpark
      · cases hk : k.rest with
        | nil =>
          have hid : (w.st s).phase = .idle := by simpa [resumed, hk] using hres
          simp only [hid]
          exact Or.inr (Or.inr hid)
        | cons _ _ =>
          have hrun : (w.st s).phase = .run k := by simpa [resumed, hk] using hres
          simp only [hrun]
          exact Or.inr (Or.inl (by simpa [resumed, hk] using hrun))
      · simp only [hidle]
        exact Or.inr (Or.inr hidle)
    · have hgo : ((w.st s).life != .alive) = true := by
        cases hl : (w.st s).life <;> simp_all [bne]
      simp only [failWaiter, hgo, ite_true]
      exact h
  · exact phaseShape_cast w (failWaiter w dead i) s dst call k
      (congrArg (·.phase) (failWaiter_other w dead i s hsi)) h

theorem shape_fail_fold (w : World) (dead s dst : InstId) (call : Bool) (k : Cont)
    (ids : List InstId) (h : phaseShape w s dst call k) :
    phaseShape (ids.foldl (fun w i => failWaiter w dead i) w) s dst call k := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (shape_fail w dead i s dst call k h)

theorem shape_admit (w : World) (dead s dst : InstId) (call : Bool) (k : Cont)
    (h : phaseShape w s dst call k) : phaseShape (admitDead w dead) s dst call k :=
  phaseShape_cast w (admitDead w dead) s dst call k (admitDead_phase w dead s).1 h

theorem shape_abort (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (call : Bool) (k : Cont) (h : phaseShape w s dst call k) :
    phaseShape (abortActor D w id a) s dst call k := by
  have hrel := shape_release D w id a s dst call k h
  have hfail := shape_fail_fold (releaseWorld D w id a) id s dst call k
    (releaseWorld D w id a).roster hrel
  simpa [abortActor, failWaiters] using
    shape_admit (failWaiters (releaseWorld D w id a) id) id s dst call k hfail

theorem shape_abortDesc (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (call : Bool) (k : Cont) (h : phaseShape w s dst call k) :
    phaseShape (abortDesc fuel D w parent) s dst call k := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using h
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), phaseShape w0 s dst call k →
        phaseShape (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst call k by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons child ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent child && (w0.st child).life == .alive &&
          childTerminable D child) = true
      · rw [if_pos hgo]
        exact ihf _ (shape_abort D (abortDesc fuel D w0 child) child
          ((abortDesc fuel D w0 child).st child) s dst call k (ih w0 child h0))
      · rw [if_neg hgo]
        exact ihf w0 h0

theorem shape_tombstone (D : Description) (w : World) (child s dst : InstId) (call : Bool)
    (k : Cont) (h : phaseShape w s dst call k) :
    phaseShape (enqueueTombstone D w child) s dst call k :=
  phaseShape_cast w (enqueueTombstone D w child) s dst call k (enqueueTombstone_phase D w child s) h

theorem shape_terminate (D : Description) (w : World) (id s dst : InstId) (call : Bool) (k : Cont)
    (h : phaseShape w s dst call k) : phaseShape (terminateStage D w id (w.st id)) s dst call k := by
  simp only [terminateStage]
  exact shape_tombstone D (abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)) id s dst call k
    (shape_abort D (abortDesc w.roster.length D w id) id ((abortDesc w.roster.length D w id).st id)
      s dst call k (shape_abortDesc w.roster.length D w id s dst call k h))

/-- `terminateStage` leaves a parked sender parked, resumed, or idle. -/
theorem terminate_block (D : Description) (w : World) (id s dst : InstId) (call : Bool) (k : Cont)
    (hph : (w.st s).phase = .parked dst call k) :
    ((terminateStage D w id (w.st id)).st s).phase = .parked dst call k ∨
      ((terminateStage D w id (w.st id)).st s).phase = resumed k ∨
      ((terminateStage D w id (w.st id)).st s).phase = .idle :=
  shape_terminate D w id s dst call k (Or.inl hph)

/-- An `awaitReply` survives abortion, or the caller has been returned to idle. -/
abbrev awaitShape (w : World) (s dst : InstId) (k : Cont) : Prop :=
  (w.st s).phase = .awaitReply dst k ∨ (w.st s).phase = .idle

theorem awaitShape_cast (w₁ w₂ : World) (s dst : InstId) (k : Cont)
    (hph : (w₂.st s).phase = (w₁.st s).phase) (h : awaitShape w₁ s dst k) :
    awaitShape w₂ s dst k := by
  rcases h with hawait | hidle
  · exact Or.inl (hph.trans hawait)
  · exact Or.inr (hph.trans hidle)

theorem await_releaseParked (w : World) (id : InstId) (ps : List Parked) (s dst : InstId)
    (k : Cont) (h : awaitShape w s dst k) : awaitShape (releaseParked w id ps) s dst k := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w h
    · rw [if_neg hskip]
      let w' := setActor w p.sender (resumeSender (w.st p.sender) false id)
      have h' : awaitShape w' s dst k := by
        by_cases hs : s = p.sender
        · subst hs
          unfold awaitShape
          simp only [w', setActor]
          rcases h with hawait | hidle
          · simp [resumeSender, hawait]
          · simp [resumeSender, hidle]
        · exact awaitShape_cast w w' s dst k
            (congrArg (·.phase) (setActor_other w p.sender s _ hs)) h
      exact ih w' h'

theorem await_release (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (k : Cont) (h : awaitShape w s dst k) : awaitShape (releaseWorld D w id a) s dst k := by
  let wCells := readCells D w id
  let wMsgs := refundMsgs wCells (tname id) a.box
  let wPark := refundParked wMsgs (tname id) a.parked
  let dead : Actor :=
    { wPark.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hbody : releaseWorld D w id a = releaseParked (setActor wPark id dead) id a.parked := by
    simp [releaseWorld, wCells, wMsgs, wPark, dead]
  have hphase : (wPark.st s).phase = (w.st s).phase :=
    (refundParked_rest wMsgs (tname id) a.parked s).1.trans
      ((refundMsgs_rest wCells (tname id) a.box s).1.trans (congrArg (·.phase) (cellsSt D w id s)))
  rw [hbody]
  by_cases hs : s = id
  · have hidle : ((setActor wPark id dead).st s).phase = .idle := by
      simp [hs, setActor_self, dead]
    exact await_releaseParked (setActor wPark id dead) id a.parked s dst k (Or.inr hidle)
  · have hset : ((setActor wPark id dead).st s).phase = (wPark.st s).phase := by
      rw [setActor_other wPark id s dead hs]
    exact await_releaseParked (setActor wPark id dead) id a.parked s dst k
      (awaitShape_cast wPark (setActor wPark id dead) s dst k hset
        (awaitShape_cast w wPark s dst k hphase h))

theorem await_fail (w : World) (dead i s dst : InstId) (k : Cont) (h : awaitShape w s dst k) :
    awaitShape (failWaiter w dead i) s dst k := by
  by_cases hsi : s = i
  · subst hsi
    by_cases hlive : (w.st s).life = .alive
    · have hgo : ((w.st s).life != .alive) = false := by simp [hlive, bne]
      simp only [failWaiter, hgo, ite_false]
      rcases h with hawait | hidle
      · unfold awaitShape
        simp only [hawait]
        by_cases hd : dst = dead
        · simp [hd, setActor]
        · have hb : (dst == dead) = false := by simpa [beq_iff_eq] using hd
          simp [hb]
          exact Or.inl hawait
      · simp only [hidle]
        exact Or.inr hidle
    · have hgo : ((w.st s).life != .alive) = true := by
        cases hl : (w.st s).life <;> simp_all [bne]
      simp only [failWaiter, hgo, ite_true]
      exact h
  · exact awaitShape_cast w (failWaiter w dead i) s dst k
      (congrArg (·.phase) (failWaiter_other w dead i s hsi)) h

theorem await_fail_fold (w : World) (dead s dst : InstId) (k : Cont) (ids : List InstId)
    (h : awaitShape w s dst k) :
    awaitShape (ids.foldl (fun w i => failWaiter w dead i) w) s dst k := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (await_fail w dead i s dst k h)

theorem await_abort (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (k : Cont) (h : awaitShape w s dst k) : awaitShape (abortActor D w id a) s dst k := by
  have hrel := await_release D w id a s dst k h
  have hfail := await_fail_fold (releaseWorld D w id a) id s dst k
    (releaseWorld D w id a).roster hrel
  exact awaitShape_cast _ (abortActor D w id a) s dst k
    (by simpa [abortActor, failWaiters] using (admitDead_phase (failWaiters (releaseWorld D w id a) id) id s).1)
    hfail

theorem await_abortDesc (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (k : Cont) (h : awaitShape w s dst k) : awaitShape (abortDesc fuel D w parent) s dst k := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using h
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), awaitShape w0 s dst k →
        awaitShape (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) s dst k by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons child ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent child && (w0.st child).life == .alive &&
          childTerminable D child) = true
      · rw [if_pos hgo]
        exact ihf _ (await_abort D (abortDesc fuel D w0 child) child
          ((abortDesc fuel D w0 child).st child) s dst k (ih w0 child h0))
      · rw [if_neg hgo]
        exact ihf w0 h0

/-- `terminateStage` leaves an `awaitReply` in place, or returns the caller to idle. -/
theorem terminate_await (D : Description) (w : World) (id s dst : InstId) (k : Cont)
    (hph : (w.st s).phase = .awaitReply dst k) :
    ((terminateStage D w id (w.st id)).st s).phase = .awaitReply dst k ∨
      ((terminateStage D w id (w.st id)).st s).phase = .idle := by
  simp only [terminateStage]
  have h := await_abortDesc w.roster.length D w id s dst k (Or.inl hph)
  have h2 := await_abort D (abortDesc w.roster.length D w id) id
    ((abortDesc w.roster.length D w id).st id) s dst k h
  exact awaitShape_cast _ _ s dst k
    (enqueueTombstone_phase D (abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)) id s) h2

theorem blocking_next (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : (w.st s).phase = .parked dst false k) :
    (w'.st s).phase = .parked dst false k ∨ (w'.st s).phase = (proceed (w.st s) k).phase ∨
      (w'.st s).phase = .idle := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl hph
  | ingress who label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    exact Or.inl ((ingress_phase I w w' who label s h).1.trans hph)
  | finish id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨_, hphF, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    have hs : s ≠ id := by
      intro heq
      rw [heq] at hph
      rcases hphF with hphF | hphF <;> simp [hph] at hphF
    exact Or.inl (by simpa [setActor, hs] using hph)
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        have hslot := hO template (w.nextIx template) (Nat.le_refl _)
        have hne : s ≠ InstId.peer template (w.nextIx template) := by
          intro heq
          rw [heq] at hph
          rw [hslot.2.1] at hph
          cases hph
        simp only [readCells_st, setActor, hne]
        exact Or.inl hph
      · cases h
  | recvPrio id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hsne : s ≠ id := by
      intro heq
      rw [heq] at hph
      cases hp : (w.st id).prio with
      | nil => simp [receivePrio, hp] at h
      | cons _ _ => simp [receivePrio, hp, hph] at h
    unfold receivePrio at h
    cases hp : (w.st id).prio with
    | nil => simp [hp] at h
    | cons m ms =>
      by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
      · simp [hp, hready] at h
      · simp [hp, hready] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          exact Or.inl (by simpa [setActor, hsne, hst] using hph)
  | recvBulk id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hsne : s ≠ id := by
      intro heq
      rw [heq] at hph
      unfold receiveBulk at h
      simp [hph] at h
    by_cases hid : id = dst
    · obtain ⟨p0, hp0, hs0, hc0⟩ := hM.bwd s dst false k hph
      cases hpk : (w.st dst).parked with
      | nil => exact absurd hp0 (by simp [hpk])
      | cons p ps =>
        by_cases hhead : s = p.sender
        · have hc : p.isCall = false := by
            have hmem : p ∈ (w.st dst).parked := by simp [hpk]
            exact (hM.uniq dst dst p0 p hp0 hmem (hs0.trans hhead)).2 ▸ hc0
          have hrecv : receiveBulk I w dst = some w' := by
            rw [hid] at h
            exact h
          have hsd : s ≠ dst := fun hsd => hsne (hsd.trans hid.symm)
          exact Or.inr (Or.inl (bulk_send_proceed I w w' dst hrecv p ps hpk s hhead hsd k
            (by simpa [hid] using hph) hc))
        · unfold receiveBulk at h
          by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
          · simp [hready] at h
          · simp [hready] at h
            cases hbox : (w.st id).box with
            | nil =>
              simp [hbox] at h
              cases hpark : (w.st id).parked with
              | nil => simp [hpark] at h
              | cons q qs =>
                simp [hpark] at h
                split at h
                · cases h
                · next w1 a1 hdel =>
                  cases h
                  have hst := deliver_st I w id _ q.msg w1 a1 s hdel
                  have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
                    simpa [setActor, hsne, hst] using hph
                  have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) q.msg.sender s).2.2.1
                  have hsender : s ≠ q.sender := by
                    have hsame : (w.st id).parked = (w.st dst).parked := by simp [hid]
                    rw [hsame, hpk] at hpark
                    cases hpark
                    exact hhead
                  simp only [setActor, hsender, ite_false]
                  exact Or.inl (hcred.trans (hset.trans hph))
            | cons m ms =>
              cases hpark : (w.st id).parked with
              | nil =>
                simp [hbox, hpark] at h
                split at h
                · cases h
                · next w1 a1 hdel =>
                  cases h
                  have hst := deliver_st I w id _ m w1 a1 s hdel
                  have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) m.sender s).2.2.1
                  have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
                    simpa [setActor, hsne, hst] using hph
                  exact Or.inl (hcred.trans (hset.trans hph))
              | cons q qs =>
                simp [hbox, hpark] at h
                split at h
                · cases h
                · next w1 a1 hdel =>
                  cases h
                  have hst := deliver_st I w id _ m w1 a1 s hdel
                  let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
                  have hset : ((setActor w1 id admitted).st s).phase = (w.st s).phase := by
                    simpa [setActor, hsne, hst] using hph
                  have hcred := (creditLive_keeps (setActor w1 id admitted) (tname id) m.sender s).2.2.1
                  have hsender : s ≠ q.sender := by
                    have hsame : (w.st id).parked = (w.st dst).parked := by simp [hid]
                    rw [hsame, hpk] at hpark
                    cases hpark
                    exact hhead
                  simp only [setActor, hsender, ite_false]
                  exact Or.inl (hcred.trans (hset.trans hph))
    · unfold receiveBulk at h
      by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
      · simp [hready] at h
      · simp [hready] at h
        cases hbox : (w.st id).box with
        | nil =>
          cases hpark : (w.st id).parked with
          | nil => simp [hbox, hpark] at h
          | cons q qs =>
            simp [hbox, hpark] at h
            have hns : s ≠ q.sender := by
              intro heq
              obtain ⟨p0, hp0, hs0, _⟩ := hM.bwd s dst false k hph
              have hmemq : q ∈ (w.st id).parked := by simp [hpark]
              exact hid ((hM.uniq id dst q p0 hmemq hp0 (heq.symm.trans hs0.symm)).1)
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w id _ q.msg w1 a1 s hdel
              have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) q.msg.sender s).2.2.1
              have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
                simpa [setActor, hsne, hst] using hph
              simp only [setActor, hns, ite_false]
              exact Or.inl (hcred.trans (hset.trans hph))
        | cons m ms =>
          cases hpark : (w.st id).parked with
          | nil =>
            simp [hbox, hpark] at h
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w id _ m w1 a1 s hdel
              have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) m.sender s).2.2.1
              have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
                simpa [setActor, hsne, hst] using hph
              exact Or.inl (hcred.trans (hset.trans hph))
          | cons q qs =>
            simp [hbox, hpark] at h
            have hns : s ≠ q.sender := by
              intro heq
              obtain ⟨p0, hp0, hs0, _⟩ := hM.bwd s dst false k hph
              have hmemq : q ∈ (w.st id).parked := by simp [hpark]
              exact hid ((hM.uniq id dst q p0 hmemq hp0 (heq.symm.trans hs0.symm)).1)
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w id _ m w1 a1 s hdel
              let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
              have hcred := (creditLive_keeps (setActor w1 id admitted) (tname id) m.sender s).2.2.1
              have hset : ((setActor w1 id admitted).st s).phase = (w.st s).phase := by
                simpa [setActor, hsne, hst] using hph
              simp only [setActor, hns, ite_false]
              exact Or.inl (hcred.trans (hset.trans hph))
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hsne : s ≠ id := by
      intro heq
      rw [heq] at hph
      simp [execHead, hph] at h
    unfold execHead at h
    by_cases hlid : (w.st id).life = .alive
    · simp [hlid] at h
      cases hphE : (w.st id).phase with
      | run kE =>
        simp [hphE] at h
        cases h
        cases hk : kE.rest with
        | nil => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
        | cons e tail =>
          cases e with
          | send name label hint =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, proceed_life, hph])
            | some dstId =>
              simp [hr]
              exact Or.inl ((enqueue_phase_other w I.desc id dstId
                ({ label := label, sender := id, callFrom := none } : Msg) false (afterHead kE) s hsne).trans hph)
          | call name label hint na to =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, hph])
            | some dstId =>
              simp [hr]
              exact Or.inl ((enqueue_phase_other w I.desc id dstId
                ({ label := label, sender := id, callFrom := some id } : Msg) true (afterHead kE) s hsne).trans hph)
          | trySend name label hint onFull onGone =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, hph])
            | some dstId =>
              simp [hr]
              split
              · exact Or.inl ((enqueue_phase_other w I.desc id dstId
                  ({ label := label, sender := id, callFrom := none, reliable := false } : Msg) false
                  (afterHead kE) s hsne).trans hph)
              · exact Or.inl (by simp [setActor, hsne, hph])
          | reply =>
            simp [execRun, hk]
            exact Or.inl ((reply_keeps_quiet w id s kE (fun d ck hbad => by simp [hph] at hbad) hsne).1.trans hph)
          | selfSchedule label =>
            simp [execRun, hk]
            split
            · exact Or.inl (by simp [setActor, hsne, hph])
            · split
              · exact Or.inl (by simp [setActor, hsne, hph])
              · exact Or.inl (by simp [setActor, hsne, hph])
          | cell name label value =>
            simp only [execRun, hk]
            split
            · exact Or.inl (by simp [setCell, setActor, hsne, hph])
            · rw [wakeReaders]
              exact Or.inl (by
                rw [wakes_phase (readersOf _ _) I.desc _ name label id s]
                simp [setCell, setActor, hsne, hph])
          | internal => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
          | peer onTimeout => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
          | terminate =>
            rcases exec_term_world I w id kE tail hk with
              hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
            · exact Or.inl (by rw [hkept]; exact hph)
            · by_cases hdst : id = dst
              · have hmem : ∃ p, p ∈ (w.st id).parked ∧ p.sender = s ∧ p.isCall = false := by
                  rw [hdst]
                  exact hM.bwd s dst false k hph
                let base :=
                  refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                    (w.st id).parked
                let dead : Actor :=
                  { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
                have hphB : ((setActor base id dead).st s).phase = .parked id false k := by
                  have hread := readCells_st I.desc w id s
                  have href := (refund_life (readCells I.desc w id) (tname id) (w.st id).box s).2.2.1
                  have hrefp :=
                    (refundP_life (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                      (w.st id).parked s).2.2.1
                  have hchain : (base.st s).phase = (w.st s).phase := by simp [base, hread, href, hrefp]
                  have hphId : (w.st s).phase = .parked id false k := by simpa [hdst] using hph
                  simpa [setActor, hsne, hchain] using hphId
                have hstep :
                    execRun I w id (w.st id) kE =
                      releaseParked (setActor base id dead) id (w.st id).parked := by
                  rw [hrel]
                  simp [releaseWorld, base, dead]
                have hres := release_resumes_send (setActor base id dead) id (w.st id).parked s k hmem hsne hphB
                rw [hstep]
                exact Or.inr (Or.inl (hres.trans (proceed_phase_actor _ (w.st s) k)))
              · have habsent : ∀ p, p ∈ (w.st id).parked → p.sender ≠ s := by
                  intro p hp heq
                  obtain ⟨q, hq, hqs, _⟩ := hM.bwd s dst false k hph
                  exact hdst ((hM.uniq id dst p q hp hq (heq.trans hqs.symm)).1)
                let base :=
                  refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                    (w.st id).parked
                let dead : Actor :=
                  { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
                have hbase : (base.st s).phase = (w.st s).phase := by
                  have hread := readCells_st I.desc w id s
                  have href := (refund_life (readCells I.desc w id) (tname id) (w.st id).box s).2.2.1
                  have hrefp :=
                    (refundP_life (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                      (w.st id).parked s).2.2.1
                  simp [base, hread, href, hrefp]
                have hset : ((setActor base id dead).st s).phase = (w.st s).phase := by
                  simp [setActor, hsne, hbase]
                have hstay : ((releaseParked (setActor base id dead) id (w.st id).parked).st s).phase =
                    (w.st s).phase := by
                  have hskip := release_misses (setActor base id dead) id (w.st id).parked s habsent
                  exact (congrArg (fun a => a.phase) hskip).trans hset
                have hstep :
                    execRun I w id (w.st id) kE =
                      releaseParked (setActor base id dead) id (w.st id).parked := by
                  rw [hrel]
                  simp [releaseWorld, base, dead]
                rw [hstep]
                exact Or.inl (hstay.trans hph)
            · rw [hkill]
              rcases terminate_block I.desc w id s dst false k hph with hstay | hres | hidle
              · exact Or.inl hstay
              · exact Or.inr (Or.inl (hres.trans (proceed_resumed (w.st s) k).symm))
              · exact Or.inr (Or.inr hidle)
      | idle => simp [hphE] at h
      | parked _ _ _ => simp [hphE] at h
      | awaitReply _ _ => simp [hphE] at h
      | awaitEffect _ => simp [hphE] at h
      | awaitPeer _ => simp [hphE] at h
      | crashed => simp [hphE] at h
    · simp [hlid] at h

/-- Leaving a blocking send runs a strictly shorter continuation. -/
theorem blocking_fuel (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : (w.st s).phase = .parked dst false k)
    (hdiff : waitKind (w'.st s) ≠ some (.blockingSend dst)) :
    phaseFuel ((w'.st s).phase) < phaseFuel ((w.st s).phase) := by
  rcases blocking_next I a w w' s dst k hM hO h hph with hsame | hpro | hidle
  · exact absurd (by simp [waitKind, hsame]) hdiff
  · rw [hpro, hph]
    exact finish_park_drops (w.st s) dst false k
  · rw [hidle, hph]
    simp only [phaseFuel]
    omega

/-- A receiver stays alive for as long as the blocking send stays parked. -/
theorem alive_while_send (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (i : Nat)
    (hstay : ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst false k)
    (halive : ((ρ.cfg i).st dst).life = .alive) :
    ∀ t, i ≤ t → ((ρ.cfg t).st dst).life = .alive := by
  suffices ∀ n, ((ρ.cfg (i + n)).st dst).life = .alive by
    intro t ht
    simpa [Nat.add_sub_of_le ht] using this (t - i)
  intro n
  induction n with
  | zero => simpa using halive
  | succ n ih =>
    have hi : i ≤ i + n := Nat.le_add_right _ _
    have hi' : i ≤ i + n + 1 := Nat.le_trans hi (Nat.le_succ _)
    obtain ⟨k, hk⟩ := hstay (i + n) hi
    obtain ⟨k', hk'⟩ := hstay (i + n + 1) hi'
    exact receiver_stays I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n)) (ρ.act (i + n))
      (ρ.cfg (i + n + 1)) s dst k k' (ρ.valid (i + n)) hk hk' ih

/-- An actor awaiting a reply keeps that wait, the reply runs it, or a kill returns it to idle. -/
theorem await_next (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : (w.st s).phase = .awaitReply dst k) :
    (w'.st s).phase = .awaitReply dst k ∨ (w'.st s).phase = (proceed (w.st s) k).phase ∨
      (w'.st s).phase = .idle := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl hph
  | ingress who label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    exact Or.inl ((ingress_phase I w w' who label s h).1.trans hph)
  | finish id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨_, hphF, hw⟩ := finish_proceed I w w' id h
    rw [hw]
    have hs : s ≠ id := by
      intro heq
      rw [heq] at hph
      rcases hphF with hphF | hphF <;> simp [hph] at hphF
    exact Or.inl (by simpa [setActor, hs] using hph)
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        have hslot := hO template (w.nextIx template) (Nat.le_refl _)
        have hne : s ≠ InstId.peer template (w.nextIx template) := by
          intro heq
          rw [heq] at hph
          rw [hslot.2.1] at hph
          cases hph
        simp only [readCells_st, setActor, hne]
        exact Or.inl hph
      · cases h
  | recvPrio id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hs : s ≠ id := by
      intro heq
      rw [heq] at hph
      unfold receivePrio at h
      cases hp : (w.st id).prio with
      | nil => simp [hp] at h
      | cons _ _ => simp [hp, hph] at h
    unfold receivePrio at h
    cases hp : (w.st id).prio with
    | nil => simp [hp] at h
    | cons m ms =>
      by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
      · simp [hp, hready] at h
      · simp [hp, hready] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w id _ m w1 a1 s hdel
          exact Or.inl (by simpa [setActor, hs, hst] using hph)
  | recvBulk id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hs : s ≠ id := by
      intro heq
      rw [heq] at hph
      unfold receiveBulk at h
      simp [hph] at h
    -- A receive resumes a parked sender. An actor already awaiting is not that sender's phase,
    -- so the installed resume is the identity on `s` unless `s` is parked, which it is not.
    unfold receiveBulk at h
    by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
    · simp [hready] at h
    · simp [hready] at h
      cases hbox : (w.st id).box with
      | nil =>
        cases hpark : (w.st id).parked with
        | nil => simp [hbox, hpark] at h
        | cons q qs =>
          simp [hbox, hpark] at h
          split at h
          · cases h
          · next w1 a1 hdel =>
            cases h
            have hst := deliver_st I w id _ q.msg w1 a1 s hdel
            have hpre : ((creditLive (setActor w1 id a1) (tname id) q.msg.sender).st s).phase =
                (w.st s).phase := by
              have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
                simpa [setActor, hs, hst] using hph
              exact ((creditLive_keeps (setActor w1 id a1) (tname id) q.msg.sender s).2.2.1).trans hset
            by_cases hsender : s = q.sender
            · have hid := resume_id_of_not_parked
                ((creditLive (setActor w1 id a1) (tname id) q.msg.sender).st s) q.isCall id
                (fun d c ck hbad => by rw [hpre] at hbad; simp [hph] at hbad)
              rw [← hsender]
              simp only [setActor, ite_true]
              have hres : (resumeSender ((creditLive (setActor w1 id a1) (tname id) q.msg.sender).st s) q.isCall id).phase =
                  ((creditLive (setActor w1 id a1) (tname id) q.msg.sender).st s).phase := by rw [hid]
              exact Or.inl (hres.trans (hpre.trans hph))
            · simp only [setActor, hsender, ite_false]
              exact Or.inl (hpre.trans hph)
      | cons m ms =>
        cases hpark : (w.st id).parked with
        | nil =>
          simp [hbox, hpark] at h
          split at h
          · cases h
          · next w1 a1 hdel =>
            cases h
            have hst := deliver_st I w id _ m w1 a1 s hdel
            have hcred := (creditLive_keeps (setActor w1 id a1) (tname id) m.sender s).2.2.1
            have hset : ((setActor w1 id a1).st s).phase = (w.st s).phase := by
              simpa [setActor, hs, hst] using hph
            exact Or.inl ((hcred.trans hset).trans hph)
        | cons q qs =>
          simp [hbox, hpark] at h
          split at h
          · cases h
          · next w1 a1 hdel =>
            cases h
            have hst := deliver_st I w id _ m w1 a1 s hdel
            let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
            have hpre : ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s).phase =
                (w.st s).phase := by
              have hset : ((setActor w1 id admitted).st s).phase = (w.st s).phase := by
                simpa [setActor, hs, hst] using hph
              exact ((creditLive_keeps (setActor w1 id admitted) (tname id) m.sender s).2.2.1).trans hset
            by_cases hsender : s = q.sender
            · have hid := resume_id_of_not_parked
                ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s) q.isCall id
                (fun d c ck hbad => by rw [hpre] at hbad; simp [hph] at hbad)
              rw [← hsender]
              simp only [setActor, ite_true]
              have hres :
                  (resumeSender ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s) q.isCall id).phase =
                    ((creditLive (setActor w1 id admitted) (tname id) m.sender).st s).phase := by rw [hid]
              exact Or.inl (hres.trans (hpre.trans hph))
            · simp only [setActor, hsender, ite_false]
              exact Or.inl (hpre.trans hph)
  | exec id =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    have hsne : s ≠ id := by
      intro heq
      rw [heq] at hph
      simp [execHead, hph] at h
    unfold execHead at h
    by_cases hlid : (w.st id).life = .alive
    · simp [hlid] at h
      cases hphE : (w.st id).phase with
      | run kE =>
        simp [hphE] at h
        cases h
        cases hk : kE.rest with
        | nil => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
        | cons e tail =>
          cases e with
          | reply =>
            simp [execRun, hk]
            unfold performReply
            cases hr : kE.replyTo with
            | none => exact Or.inl (by simp [setActor, hsne, hph])
            | some caller =>
              cases hcall : (w.st caller).phase with
              | awaitReply dst' ck =>
                by_cases hd : dst' = id
                · by_cases hc : s = caller
                  · rw [hc, hcall] at hph
                    cases hph
                    have hcne : ¬caller = id := fun h => hsne (hc.trans h)
                    simp [hcall, hd, hc, hcne, setActor]
                  · simp [hcall, hd, setActor, hc, hsne]
                    exact Or.inl hph
                · exact Or.inl (by simp [hcall, hd, setActor, hsne, hph])
              | idle => exact Or.inl (by simp [hcall, setActor, hsne, hph])
              | run _ => exact Or.inl (by simp [hcall, setActor, hsne, hph])
              | parked _ _ _ => exact Or.inl (by simp [hcall, setActor, hsne, hph])
              | awaitEffect _ => exact Or.inl (by simp [hcall, setActor, hsne, hph])
              | awaitPeer _ => exact Or.inl (by simp [hcall, setActor, hsne, hph])
              | crashed => exact Or.inl (by simp [hcall, setActor, hsne, hph])
          | send name label hint =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, hph])
            | some dstId =>
              simp [hr]
              exact Or.inl ((enqueue_phase_other w I.desc id dstId
                ({ label := label, sender := id, callFrom := none } : Msg) false (afterHead kE) s hsne).trans hph)
          | call name label hint na to =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, hph])
            | some dstId =>
              simp [hr]
              exact Or.inl ((enqueue_phase_other w I.desc id dstId
                ({ label := label, sender := id, callFrom := some id } : Msg) true (afterHead kE) s hsne).trans hph)
          | trySend name label hint onFull onGone =>
            simp [execRun, hk]
            cases hr : route w I.desc id name with
            | none => exact Or.inl (by simp [hr, setActor, hsne, hph])
            | some dstId =>
              simp [hr]
              split
              · exact Or.inl ((enqueue_phase_other w I.desc id dstId
                  ({ label := label, sender := id, callFrom := none, reliable := false } : Msg) false
                  (afterHead kE) s hsne).trans hph)
              · exact Or.inl (by simp [setActor, hsne, hph])
          | selfSchedule label =>
            simp [execRun, hk]
            split
            · exact Or.inl (by simp [setActor, hsne, hph])
            · split
              · exact Or.inl (by simp [setActor, hsne, hph])
              · exact Or.inl (by simp [setActor, hsne, hph])
          | cell name label value =>
            simp only [execRun, hk]
            split
            · exact Or.inl (by simp [setCell, setActor, hsne, hph])
            · rw [wakeReaders]
              exact Or.inl (by
                rw [wakes_phase (readersOf _ _) I.desc _ name label id s]
                simp [setCell, setActor, hsne, hph])
          | internal => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
          | peer onTimeout => exact Or.inl (by simp [execRun, hk, setActor, hsne, hph])
          | terminate =>
            rcases exec_term_world I w id kE tail hk with
              hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
            · exact Or.inl (by rw [hkept]; exact hph)
            · let base :=
                refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                  (w.st id).parked
              let dead : Actor :=
                { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
              have hmiss : ∀ p, p ∈ (w.st id).parked → p.sender ≠ s := by
                intro p hp heq
                obtain ⟨k0, hk0⟩ := hM.fwd id p hp
                rw [heq, hph] at hk0
                cases hk0
              have hbase : (base.st s).phase = (w.st s).phase := by
                have hread := readCells_st I.desc w id s
                have href := (refund_life (readCells I.desc w id) (tname id) (w.st id).box s).2.2.1
                have hrefp :=
                  (refundP_life (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box) (tname id)
                    (w.st id).parked s).2.2.1
                simp [base, hread, href, hrefp]
              have hset : ((setActor base id dead).st s).phase = (w.st s).phase := by
                simp [setActor, hsne, hbase]
              have hstay :=
                (congrArg (fun a => a.phase)
                  (release_misses (setActor base id dead) id (w.st id).parked s hmiss)).trans hset
              have hstep : execRun I w id (w.st id) kE =
                  releaseParked (setActor base id dead) id (w.st id).parked := by
                rw [hrel]
                simp [releaseWorld, base, dead]
              rw [hstep]
              exact Or.inl (hstay.trans hph)
            · rw [hkill]
              rcases terminate_await I.desc w id s dst k hph with hstay | hidle
              · exact Or.inl hstay
              · exact Or.inr (Or.inr hidle)
      | idle => simp [hphE] at h
      | parked _ _ _ => simp [hphE] at h
      | awaitReply _ _ => simp [hphE] at h
      | awaitEffect _ => simp [hphE] at h
      | awaitPeer _ => simp [hphE] at h
      | crashed => simp [hphE] at h
    · simp [hlid] at h

/-- The reply that ends an `awaitReply` runs a strictly shorter continuation. -/
theorem await_fuel (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : (w.st s).phase = .awaitReply dst k)
    (hdiff : waitKind (w'.st s) ≠ some (.callReply dst)) :
    phaseFuel ((w'.st s).phase) < phaseFuel ((w.st s).phase) := by
  rcases await_next I a w w' s dst k hM hO h hph with hsame | hpro | hidle
  · exact absurd (by simp [waitKind, hsame]) hdiff
  · rw [hpro, hph]
    exact finish_reply_drops (w.st s) dst k
  · rw [hidle, hph]
    simp only [phaseFuel]
    omega

theorem proceed_not_blocking (a : Actor) (k : Cont) (dst : InstId) :
    waitKind (proceed a k) ≠ some (.blockingSend dst) := by
  cases hk : k.rest <;> simp [proceed, waitKind, hk]

theorem proceed_not_reply (a : Actor) (k : Cont) (dst : InstId) :
    waitKind (proceed a k) ≠ some (.callReply dst) := by
  cases hk : k.rest <;> simp [proceed, waitKind, hk]

/-- While the blocking-send kind persists, the parked continuation is unchanged. -/
theorem blocking_stays (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : ((ρ.cfg i).st s).phase = .parked dst false k)
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.blockingSend dst)) :
    ((ρ.cfg (i + n)).st s).phase = .parked dst false k := by
  induction n with
  | zero => simpa using hph
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hkind t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hR := cfg_reachable ρ (i + n)
    have hM := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.1
    have hO := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.2
    rcases blocking_next I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) s dst k hM hO
        (ρ.valid (i + n)) hprev with hsame | hpro | hidle
    · exact hsame
    · have hnow := hkind (i + n + 1) (by omega) (by omega)
      have hwk : waitKind ((ρ.cfg (i + n + 1)).st s) =
          waitKind (proceed ((ρ.cfg (i + n)).st s) k) := by simp [waitKind, hpro]
      exact absurd (hwk.symm.trans hnow) (proceed_not_blocking ((ρ.cfg (i + n)).st s) k dst)
    · have hnow := hkind (i + n + 1) (by omega) (by omega)
      simp [waitKind, hidle] at hnow

/-- While an `awaitReply` kind persists, that continuation is unchanged. -/
theorem await_stays (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : ((ρ.cfg i).st s).phase = .awaitReply dst k)
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.callReply dst)) :
    ((ρ.cfg (i + n)).st s).phase = .awaitReply dst k := by
  induction n with
  | zero => simpa using hph
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hkind t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hR := cfg_reachable ρ (i + n)
    have hM := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.1
    have hO := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.2
    rcases await_next I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) s dst k hM hO
        (ρ.valid (i + n)) hprev with hsame | hpro | hidle
    · exact hsame
    · have hnow := hkind (i + n + 1) (by omega) (by omega)
      have hwk : waitKind ((ρ.cfg (i + n + 1)).st s) =
          waitKind (proceed ((ρ.cfg (i + n)).st s) k) := by simp [waitKind, hpro]
      exact absurd (hwk.symm.trans hnow) (proceed_not_reply ((ρ.cfg (i + n)).st s) k dst)
    · have hnow := hkind (i + n + 1) (by omega) (by omega)
      simp [waitKind, hidle] at hnow

/-- Least `m ≥ i` at which `p` holds, given some later witness. -/
theorem earliest (p : Nat → Prop) : ∀ j i, i ≤ j → p j →
    ∃ m, i ≤ m ∧ p m ∧ ∀ t, i ≤ t → t < m → ¬p t := by
  intro j
  induction j using Nat.strongRecOn with
  | ind j ih =>
    intro i hij hp
    cases Classical.em (∃ t, i ≤ t ∧ t < j ∧ p t) with
    | inl hex =>
      obtain ⟨t, ht, hlt, hpt⟩ := hex
      exact ih t hlt i ht hpt
    | inr hno =>
      refine ⟨j, hij, hp, ?_⟩
      intro t ht hlt hpt
      exact hno ⟨t, ht, hlt, hpt⟩

/-- The first step that leaves a blocking send drops `phaseFuel`. -/
theorem send_drops_at (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i j : Nat)
    (hph : ((ρ.cfg i).st s).phase = .parked dst false k) (hlt : i < j)
    (hbefore : ∀ t, i ≤ t → t < j → waitKind ((ρ.cfg t).st s) = some (.blockingSend dst))
    (hdiff : waitKind ((ρ.cfg j).st s) ≠ some (.blockingSend dst)) :
    phaseFuel (((ρ.cfg j).st s).phase) < phaseFuel (((ρ.cfg i).st s).phase) := by
  have hle : i ≤ j - 1 := by omega
  have hpre := blocking_stays I hL ρ s dst k i ((j - 1) - i) hph
    (fun t h1 h2 => hbefore t h1 (by
      have hn : i + ((j - 1) - i) = j - 1 := Nat.add_sub_of_le hle
      omega))
  have hidx : i + ((j - 1) - i) = j - 1 := Nat.add_sub_of_le hle
  have hph1 : ((ρ.cfg (j - 1)).st s).phase = .parked dst false k := by simpa [hidx] using hpre
  have hR := cfg_reachable ρ (j - 1)
  have hM := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.1
  have hO := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.2
  have hv := ρ.valid (j - 1)
  have hj1 : (j - 1) + 1 = j := by omega
  rw [hj1] at hv
  have hdrop := blocking_fuel I (ρ.act (j - 1)) (ρ.cfg (j - 1)) (ρ.cfg j) s dst k hM hO
    hv hph1 hdiff
  have heq : phaseFuel (((ρ.cfg (j - 1)).st s).phase) = phaseFuel (((ρ.cfg i).st s).phase) := by
    simp [phaseFuel, hph1, hph]
  omega

/-- The first step that leaves an `awaitReply` drops `phaseFuel`. -/
theorem await_drops_at (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i j : Nat)
    (hph : ((ρ.cfg i).st s).phase = .awaitReply dst k) (hlt : i < j)
    (hbefore : ∀ t, i ≤ t → t < j → waitKind ((ρ.cfg t).st s) = some (.callReply dst))
    (hdiff : waitKind ((ρ.cfg j).st s) ≠ some (.callReply dst)) :
    phaseFuel (((ρ.cfg j).st s).phase) < phaseFuel (((ρ.cfg i).st s).phase) := by
  have hle : i ≤ j - 1 := by omega
  have hpre := await_stays I hL ρ s dst k i ((j - 1) - i) hph
    (fun t h1 h2 => hbefore t h1 (by omega))
  have hidx : i + ((j - 1) - i) = j - 1 := Nat.add_sub_of_le hle
  have hph1 : ((ρ.cfg (j - 1)).st s).phase = .awaitReply dst k := by simpa [hidx] using hpre
  have hR := cfg_reachable ρ (j - 1)
  have hM := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.1
  have hO := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.2
  have hv := ρ.valid (j - 1)
  have hj1 : (j - 1) + 1 = j := by omega
  rw [hj1] at hv
  have hdrop := await_fuel I (ρ.act (j - 1)) (ρ.cfg (j - 1)) (ρ.cfg j) s dst k hM hO
    hv hph1 hdiff
  have heq : phaseFuel (((ρ.cfg (j - 1)).st s).phase) = phaseFuel (((ρ.cfg i).st s).phase) := by
    simp [phaseFuel, hph1, hph]
  omega

theorem kill_park_empty (I : Impl) (w : World) (id : InstId) (t : Template) (tail : List Eff)
    (toState : String) (replyTo : Option InstId)
    (ht : templateOf I.desc (tname id) = some t) (hsub : t.subtree = "")
    (htm : t.terminable = true) (hpk : hasParkedCall (w.st id).parked = false)
    (hl : (w.st id).life = .alive) (hacy : ParentAcyclic w) :
    ((execRun I w id (w.st id) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩).st id).parked = [] := by
  have hgo : (t.terminable && (t.subtree != "" || !hasParkedCall (w.st id).parked)) = true := by
    simp [htm, hsub, hpk, bne]
  simp only [execRun, ht, hgo, ite_true]
  by_cases hch : hasChild I.desc w id = true
  · simp [hch, hsub]
    exact (terminate_cleared I.desc w id hacy hl).1
  · simp [hch, hsub]
    exact release_self_parked I.desc w id (w.st id)

theorem enqueue_miss_dead (w : World) (D : Description) (sender dst i : InstId) (msg : Msg)
    (isCall : Bool) (k : Cont) (hne : i ≠ sender) (hdead : (w.st i).life ≠ .alive) :
    ((enqueueOrPark w D sender dst msg isCall k).st i).parked = (w.st i).parked := by
  unfold enqueueOrPark
  by_cases hlive : (w.st dst).life = .alive
  · have hid : i ≠ dst := fun h => hdead (by simpa [h] using hlive)
    simp [hlive]
    by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · simp [hroom]
      by_cases hsame : sender = dst
      · cases isCall <;> simp [hsame, setActor, hne, hid, proceed_parked, chargeSender, bumpToken]
      · cases isCall <;> simp [hsame, setActor, hne, hid, proceed_parked, chargeSender, bumpToken]
    · simp [hroom]
      by_cases hsame : sender = dst
      · simp [hsame, setActor, hne, hid, chargeSender, bumpToken]
      · simp [hsame, setActor, hne, hid, chargeSender, bumpToken]
  · simp [hlive, setActor, hne, proceed_parked]

/-- A non-alive actor does not acquire parked mail. -/
theorem dead_no_mail (I : Impl) (a : Action) (w w' : World) (id : InstId)
    (h : apply I a w = some w') (hdead : (w.st id).life ≠ .alive)
    (hempty : (w.st id).parked = []) : (w'.st id).parked = [] := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    assumption
  | ingress who label =>
    simpa [(ingress_parked I w w' who label id (by simpa [stepWorld] using stepOfApply h)).1] using hempty
  | finish j => simpa [hempty] using finish_parked I w w' j id (by simpa [stepWorld] using stepOfApply h)
  | recvPrio j => simpa [hempty] using prio_parked I w w' j id (by simpa [stepWorld] using stepOfApply h)
  | recvBulk j =>
    by_cases hji : id = j
    · have h := stepOfApply h
      simp only [stepWorld] at h
      unfold receiveBulk at h
      have hguard : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle := Or.inl (by simpa [hji] using hdead)
      simp [hji, hguard] at h
    · simpa [hempty] using bulk_other_parked I w w' j id (by simpa [stepWorld] using stepOfApply h) hji
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        simp only [readCells_st]
        by_cases hi : id = InstId.peer template (w.nextIx template)
        · simp [setActor, hi, withTokens, hempty]
        · simpa [setActor, hi] using hempty
      · cases h
  | exec j =>
    by_cases hji : id = j
    · rw [hji] at hdead
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold execHead at h
      simp [hdead] at h
    · have h := stepOfApply h
      simp only [stepWorld] at h
      unfold execHead at h
      by_cases hlj : (w.st j).life = .alive
      · simp [hlj] at h
        cases hp : (w.st j).phase with
        | run k =>
          simp [hp] at h
          cases h
          cases hk : k.rest with
          | nil => simp [execRun, hk, setActor, hji, hempty]
          | cons e tail =>
            cases e with
            | send name label hint =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => simp [hr, setActor, hji, proceed_parked, hempty]
              | some dstId =>
                simp [hr]
                simpa [hempty] using enqueue_miss_dead w I.desc j dstId id
                  ({ label := label, sender := j, callFrom := none } : Msg) false (afterHead k) hji hdead
            | call name label hint na to =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => simp [hr, setActor, hji, proceed_parked, hempty]
              | some dstId =>
                simp [hr]
                simpa [hempty] using enqueue_miss_dead w I.desc j dstId id
                  ({ label := label, sender := j, callFrom := some j } : Msg) true (afterHead k) hji hdead
            | trySend name label hint onFull onGone =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => simp [hr, setActor, hji, proceed_parked, hempty]
              | some dstId =>
                simp [hr]
                split
                · simpa [hempty] using enqueue_miss_dead w I.desc j dstId id
                    ({ label := label, sender := j, callFrom := none, reliable := false } : Msg)
                    false (afterHead k) hji hdead
                · simp [setActor, hji, proceed_parked, hempty]
            | reply =>
              simp [execRun, hk]
              unfold performReply
              cases k.replyTo with
              | none =>
                by_cases hi : id = j
                · exact absurd hi hji
                · simp [setActor, hi, proceed_parked, hempty]
              | some caller =>
                cases hcall : (w.st caller).phase with
                | awaitReply dst' ck =>
                  by_cases hd : dst' = j
                  · by_cases hc : id = caller
                    · have hcj : caller ≠ j := fun h => hji (hc.trans h)
                      simp [hcall, hd, hc, hcj, setActor, proceed_parked]
                      simpa [hc] using hempty
                    · by_cases hi : id = j
                      · exact absurd hi hji
                      · simp [hcall, hd, hc, hi, setActor, proceed_parked, hempty]
                  · by_cases hi : id = j
                    · exact absurd hi hji
                    · simp [hcall, hd, hi, setActor, proceed_parked, hempty]
                | idle =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
                | run _ =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
                | parked _ _ _ =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
                | awaitEffect _ =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
                | awaitPeer _ =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
                | crashed =>
                  by_cases hi : id = j
                  · exact absurd hi hji
                  · simp [hcall, hi, setActor, proceed_parked, hempty]
            | selfSchedule _ =>
              simp [execRun, hk]
              split
              · simp [setActor, hji, proceed_parked, hempty]
              · split
                · simp [setActor, hji, proceed_parked, hempty]
                · simp [setActor, hji, hempty]
            | cell name label value =>
              simp only [execRun, hk]
              split
              · simp [setCell, setActor, hji, proceed_parked, hempty]
              · let w1 : World := setActor (setCell w name label { value := max (w.cell name label).value value, dirty := true }) j (proceed ((setCell w name label { value := max (w.cell name label).value value, dirty := true }).st j) (afterHead k))
                have hbase : (w1.st id).parked = (w.st id).parked := by
                  simp [w1, setCell, setActor, hji, proceed_parked]
                rw [wakeReaders]
                have hw := wakes_parked I.desc (readersOf w1 name) w1 label j id
                exact (hw.trans hbase).trans hempty
            | internal => simp [execRun, hk, setActor, hji, hempty]
            | peer onTimeout => simp [execRun, hk, setActor, hji, hempty]
            | terminate =>
              rcases exec_term_world I w j k tail hk with
                hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
              · rw [hkept]
                exact hempty
              · rw [hrel]
                unfold releaseWorld
                rw [release_preserves_parked]
                have hbase : ((refundParked (refundMsgs (readCells I.desc w j) (tname j) (w.st j).box)
                    (tname j) (w.st j).parked).st id).parked = (w.st id).parked := by
                  simp [readCells_st, refund_msgs_parked, refund_park_parked]
                simp [setActor, hji, hbase, hempty]
              · rw [hkill]
                rcases terminate_park_move I.desc w j id with ⟨_, hk⟩
                simp [hk, hempty]
        | idle => simp [hp] at h
        | parked _ _ _ => simp [hp] at h
        | awaitReply _ _ => simp [hp] at h
        | awaitEffect _ => simp [hp] at h
        | awaitPeer _ => simp [hp] at h
        | crashed => simp [hp] at h
      · simp [hlj] at h

theorem init_park_empty (I : Impl) (N : Nat) (i : InstId) : ((initWorld I N).st i).parked = [] := by
  unfold initWorld
  rw [fold_read_st]
  cases hb : (coreRoster I.desc).contains i with
  | false =>
    show (if (coreRoster I.desc).contains i = true then initActor I.desc i else absentActor).parked = []
    rw [hb]
    simp [absentActor]
  | true =>
    show (if (coreRoster I.desc).contains i = true then initActor I.desc i else absentActor).parked = []
    rw [hb]
    unfold initActor
    cases templateOf I.desc (tname i) with
    | none => simp [absentActor]
    | some _ => simp [withTokens]

/-- A reachable mailbox that holds parked mail belongs to a live actor. -/
theorem mailbox_alive (I : Impl) (hL : LocalOk I) (N : Nat) (w : World) (hR : Reachable I N w)
    (id : InstId) (hne : (w.st id).parked ≠ []) : (w.st id).life = .alive := by
  induction hR generalizing id with
  | init => exact absurd (init_park_empty I N id) hne
  | step w w' a prev happ ih =>
    cases Classical.em ((w'.st id).life = .alive) with
    | inl hlive => exact hlive
    | inr hdead =>
      cases Classical.em ((w.st id).life = .alive) with
      | inl halive =>
        cases only_terminate_kills I a w w' id happ halive hdead with
        | inl hExecKill =>
          rcases hExecKill with ⟨tail, toState, replyTo, t, hact, hrun, ht, hsub, htm, hpk, hch⟩
          have hcleared := kill_park_empty I w id t tail toState replyTo ht hsub htm hpk halive
            ((inv_reachable I N w hL prev).forest).wf
          have hstep : w' = execRun I w id (w.st id) ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ := by
            simp [apply, hact, execHead, halive, hrun] at happ
            exact happ.symm
          rw [hstep] at hne
          exact absurd hcleared hne
        | inr hSubKill =>
          rcases hSubKill with ⟨who, t, _hact, _ht, _htm, _hdesc, _hpk, hw, hwho⟩
          rw [hw] at hdead hne hwho
          rcases hwho with hself | hchg
          · have hcleared := (terminate_cleared I.desc w who
              ((inv_reachable I N w hL prev).forest).wf (hself ▸ halive)).1
            rw [hself] at hne
            exact absurd hcleared hne
          · exact absurd (terminate_killed_park I.desc w who id hchg) hne
      | inr hdead0 =>
        have hempty : (w.st id).parked = [] := by
          cases Classical.em ((w.st id).parked = []) with
          | inl hempty => exact hempty
          | inr hne0 => exact absurd (ih id hne0) hdead0
        exact absurd (dead_no_mail I a w w' id happ hdead0 hempty) hne

/-- Parked or waiting for a reply. These phases do not carry a new typestate. -/
def PhaseWait (ph : Phase) : Prop :=
  (∃ dst c k, ph = .parked dst c k) ∨ (∃ dst k, ph = .awaitReply dst k)

theorem proceed_not_wait (a : Actor) (k : Cont) : ¬PhaseWait (proceed a k).phase := by
  cases hk : k.rest <;> simp [proceed, PhaseWait, hk]

theorem resume_ty (a : Actor) (b : Bool) (dst : InstId) (h : PhaseWait (resumeSender a b dst).phase) :
    (resumeSender a b dst).typestate = a.typestate := by
  cases hph : a.phase with
  | parked _ _ k =>
    cases b with
    | true => simp [resumeSender, hph]
    | false =>
      exact absurd (by simpa [resumeSender, hph] using h) (proceed_not_wait a k)
  | idle => simp [resumeSender, hph]
  | run _ => simp [resumeSender, hph]
  | awaitReply _ _ => simp [resumeSender, hph]
  | awaitEffect _ => simp [resumeSender, hph]
  | awaitPeer _ => simp [resumeSender, hph]
  | crashed => simp [resumeSender, hph]

/-- Enqueue copies typestate whenever the actor is still parked or awaiting. -/
theorem enqueue_ty_wait (w : World) (D : Description) (sender dst i : InstId) (msg : Msg)
    (isCall : Bool) (k : Cont)
    (hwait : PhaseWait ((enqueueOrPark w D sender dst msg isCall k).st i).phase) :
    ((enqueueOrPark w D sender dst msg isCall k).st i).typestate = (w.st i).typestate := by
  cases isCall with
  | true =>
    unfold enqueueOrPark at hwait ⊢
    by_cases hlive : (w.st dst).life = .alive
    · simp [hlive] at hwait ⊢
      by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
      · simp [hroom] at hwait ⊢
        by_cases hsame : sender = dst
        · rw [if_pos hsame] at hwait ⊢
          simp [setActor, chargeSender, bumpToken]
          by_cases hi : i = sender <;> simp [hi, chargeSender, bumpToken]
        · rw [if_neg hsame] at hwait ⊢
          have hflip : ¬dst = sender := fun h => hsame h.symm
          by_cases hi : i = sender
          · simp [setActor, hi, chargeSender, bumpToken]
          · by_cases hid : i = dst <;> simp [setActor, hi, hid, hflip]
      · simp [hroom] at hwait ⊢
        by_cases hsame : sender = dst
        · rw [if_pos hsame] at hwait ⊢
          simp [setActor, chargeSender, bumpToken]
          by_cases hi : i = sender <;> simp [hi, chargeSender, bumpToken]
        · rw [if_neg hsame] at hwait ⊢
          have hflip : ¬dst = sender := fun h => hsame h.symm
          by_cases hi : i = sender
          · simp [setActor, hi, chargeSender, bumpToken]
          · by_cases hid : i = dst <;> simp [setActor, hi, hid, hflip]
    · simp [hlive, setActor] at hwait ⊢
      by_cases hi : i = sender
      · simp [hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ k)
      · simp [hi]
  | false =>
    unfold enqueueOrPark at hwait ⊢
    by_cases hlive : (w.st dst).life = .alive
    · simp [hlive] at hwait ⊢
      by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
      · simp [hroom] at hwait ⊢
        by_cases hsame : sender = dst
        · rw [if_pos hsame] at hwait ⊢
          simp [setActor, chargeSender, bumpToken] at hwait ⊢
          by_cases hi : i = sender
          · simp [hi] at hwait ⊢
            exact absurd hwait (proceed_not_wait _ k)
          · simp [hi]
        · rw [if_neg hsame] at hwait ⊢
          have hflip : ¬dst = sender := fun h => hsame h.symm
          by_cases hi : i = sender
          · simp [setActor, hi, chargeSender, bumpToken] at hwait ⊢
            exact absurd hwait (proceed_not_wait _ k)
          · by_cases hid : i = dst <;> simp [setActor, hi, hid, hflip]
      · simp [hroom] at hwait ⊢
        by_cases hsame : sender = dst
        · rw [if_pos hsame] at hwait ⊢
          simp [setActor, chargeSender, bumpToken]
          by_cases hi : i = sender <;> simp [hi, chargeSender, bumpToken]
        · rw [if_neg hsame] at hwait ⊢
          have hflip : ¬dst = sender := fun h => hsame h.symm
          by_cases hi : i = sender
          · simp [setActor, hi, chargeSender, bumpToken]
          · by_cases hid : i = dst <;> simp [setActor, hi, hid, hflip]
    · simp [hlive, setActor] at hwait ⊢
      by_cases hi : i = sender
      · simp [hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ k)
      · simp [hi]

theorem reply_ty_wait (w : World) (sender : InstId) (k : Cont) (i : InstId)
    (hwait : PhaseWait ((performReply w sender k).st i).phase) :
    ((performReply w sender k).st i).typestate = (w.st i).typestate := by
  unfold performReply at hwait ⊢
  cases hr : k.replyTo with
  | none =>
    simp [hr] at hwait
    by_cases hi : i = sender
    · simp [setActor, hi] at hwait ⊢
      exact absurd hwait (proceed_not_wait _ (afterHead k))
    · simp [setActor, hi]
  | some caller =>
    simp [hr] at hwait
    cases hph : (w.st caller).phase with
    | awaitReply dst ck =>
      simp [hph] at hwait
      by_cases hd : dst = sender
      · simp [hd] at hwait
        by_cases hi : i = sender
        · simp [setActor, hi] at hwait ⊢
          exact absurd hwait (proceed_not_wait _ (afterHead k))
        · by_cases hc : i = caller
          · have hcs : ¬caller = sender := fun h => hi (hc.trans h)
            simp [setActor, hi, hc, hcs] at hwait ⊢
            exact absurd hwait (proceed_not_wait _ ck)
          · simp [setActor, hi, hc, hph, hd]
      · simp [hd] at hwait
        by_cases hi : i = sender
        · simp [setActor, hi] at hwait ⊢
          exact absurd hwait (proceed_not_wait _ (afterHead k))
        · simp [setActor, hi, hph, hd]
    | idle =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]
    | run ck =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]
    | parked _ _ _ =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]
    | awaitEffect _ =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]
    | awaitPeer _ =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]
    | crashed =>
      simp [hph] at hwait
      by_cases hi : i = sender
      · simp [setActor, hi] at hwait ⊢
        exact absurd hwait (proceed_not_wait _ (afterHead k))
      · simp [setActor, hi, hph]

theorem release_preserves_nonwait (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (hn : ¬PhaseWait ((w.st s).phase)) : ¬PhaseWait ((releaseParked w id ps).st s).phase := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using hn
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w hn
    · rw [if_neg hskip]
      by_cases hs : s = p.sender
      · cases hph : (w.st p.sender).phase with
        | parked _ _ k =>
          exact ih _ (by simpa [setActor, hs, resumeSender, hph] using proceed_not_wait (w.st p.sender) k)
        | idle => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
        | run k => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
        | awaitReply _ _ => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
        | awaitEffect _ => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
        | awaitPeer _ => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
        | crashed => exact ih _ (by simpa [setActor, hs, resumeSender, hph] using hn)
      · exact ih _ (by simpa [setActor, hs] using hn)

theorem release_ty_wait (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (hpost : PhaseWait ((releaseParked w id ps).st s).phase) :
    ((releaseParked w id ps).st s).typestate = (w.st s).typestate := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons] at hpost ⊢
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip] at hpost ⊢
      exact ih _ hpost
    · rw [if_neg hskip] at hpost ⊢
      by_cases hs : s = p.sender
      · cases hph : (w.st p.sender).phase with
        | parked _ _ k =>
          exact absurd hpost (release_preserves_nonwait _ id ps s
            (by simpa [setActor, hs, resumeSender, hph] using proceed_not_wait (w.st p.sender) k))
        | idle =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
        | run k =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
        | awaitReply _ k =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
        | awaitEffect _ =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
        | awaitPeer _ =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
        | crashed =>
          have hidr : resumeSender (w.st p.sender) false id = w.st p.sender := by simp [resumeSender, hph]
          rw [hidr] at hpost ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases h : i = p.sender <;> simp [h]
          rw [hself] at hpost ⊢
          exact ih _ hpost
      · have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id)) hpost
        exact hmid.trans (by simp [setActor, hs])

/-- A parked or awaiting phase is exactly `isWait`. -/
theorem phaseWait_isWait (ph : Phase) (h : PhaseWait ph) : isWait ph := by
  rcases h with ⟨d, c, k, hk⟩ | ⟨d, k, hk⟩
  · exact Or.inl ⟨d, c, k, hk⟩
  · exact Or.inr ⟨d, k, hk⟩

theorem isWait_phaseWait (ph : Phase) (h : isWait ph) : PhaseWait ph := by
  rcases h with ⟨d, c, k, hk⟩ | ⟨d, k, hk⟩
  · exact Or.inl ⟨d, c, k, hk⟩
  · exact Or.inr ⟨d, k, hk⟩

theorem resume_false_id (a : Actor) (dst : InstId)
    (h : ∀ d c k, a.phase ≠ .parked d c k) : resumeSender a false dst = a := by
  cases hph : a.phase with
  | parked d c k => exact absurd hph (h d c k)
  | idle => simp [resumeSender, hph]
  | run _ => simp [resumeSender, hph]
  | awaitReply _ _ => simp [resumeSender, hph]
  | awaitEffect _ => simp [resumeSender, hph]
  | awaitPeer _ => simp [resumeSender, hph]
  | crashed => simp [resumeSender, hph]

/-- Resuming a non-call parked sender never leaves that sender parked or awaiting. -/
theorem releaseParked_phase_wait (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (h : PhaseWait ((releaseParked w id ps).st s).phase) :
    ((releaseParked w id ps).st s).phase = (w.st s).phase := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons] at h ⊢
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip] at h ⊢
      exact ih _ h
    · rw [if_neg hskip] at h ⊢
      by_cases hs : s = p.sender
      · subst hs
        by_cases hpark : ∃ d c k, (w.st p.sender).phase = .parked d c k
        · rcases hpark with ⟨_, _, k, hph⟩
          exact absurd h (release_preserves_nonwait _ id ps p.sender
            (by simpa [setActor, resumeSender, hph] using proceed_not_wait (w.st p.sender) k))
        · have hidr : resumeSender (w.st p.sender) false id = w.st p.sender :=
            resume_false_id (w.st p.sender) id (fun d c k heq => hpark ⟨d, c, k, heq⟩)
          rw [hidr] at h ⊢
          have hself : setActor w p.sender (w.st p.sender) = w := by
            simp [setActor]; congr; funext i; by_cases hi : i = p.sender <;> simp [hi]
          rw [hself] at h ⊢
          exact ih _ h
      · exact (ih _ h).trans (by simp [setActor, hs])

/-- The actor `releaseWorld` kills is idle, so it is not parked or awaiting. -/
theorem releaseWorld_victim_not_wait (D : Description) (w : World) (id : InstId) (a : Actor) :
    ¬PhaseWait ((releaseWorld D w id a).st id).phase := by
  let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
  let deadA : Actor :=
    { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hstep : releaseWorld D w id a = releaseParked (setActor base id deadA) id a.parked := by
    simp [releaseWorld, base, deadA]
  rw [hstep]
  have hv := release_victim_eq (setActor base id deadA) id a.parked
  have hidle : ((releaseParked (setActor base id deadA) id a.parked).st id).phase = .idle := by
    have hph := congrArg (fun a => a.phase) hv
    simpa [setActor, deadA] using hph
  simp [PhaseWait, hidle]

/-- A wait that survives `releaseWorld` had the same phase and typestate before it. -/
theorem releaseWorld_wait (D : Description) (w : World) (id : InstId) (a : Actor) (s : InstId)
    (h : PhaseWait ((releaseWorld D w id a).st s).phase) :
    ((releaseWorld D w id a).st s).phase = (w.st s).phase ∧
      ((releaseWorld D w id a).st s).typestate = (w.st s).typestate := by
  by_cases hs : s = id
  · exact absurd (by simpa [hs] using h) (releaseWorld_victim_not_wait D w id a)
  · let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
    let deadA : Actor :=
      { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
    have hphB : (base.st s).phase = (w.st s).phase := by
      have hread := congrArg (fun a => a.phase) (readCells_st D w id s)
      have href := (refund_life (readCells D w id) (tname id) a.box s).2.2.1
      have hrefp :=
        (refundP_life (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked s).2.2.1
      simp [base, hread, href, hrefp]
    have htyB : (base.st s).typestate = (w.st s).typestate := by
      have hread := congrArg (fun a => a.typestate) (readCells_st D w id s)
      have href := (refund_life (readCells D w id) (tname id) a.box s).2.1
      have hrefp :=
        (refundP_life (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked s).2.1
      simp [base, hread, href, hrefp]
    have hsetPh : ((setActor base id deadA).st s).phase = (base.st s).phase := by
      simp [setActor, hs]
    have hsetTy : ((setActor base id deadA).st s).typestate = (base.st s).typestate := by
      simp [setActor, hs]
    have hstep : releaseWorld D w id a = releaseParked (setActor base id deadA) id a.parked := by
      simp [releaseWorld, base, deadA]
    rw [hstep] at h ⊢
    exact ⟨(releaseParked_phase_wait _ id a.parked s h).trans (hsetPh.trans hphB),
      (release_ty_wait _ id a.parked s h).trans (hsetTy.trans htyB)⟩

/-- A fold of `failWaiter` that still ends in a wait never rewrote that actor. -/
theorem failFold_wait_actor (w : World) (dead s : InstId) (ids : List InstId)
    (h : isWait ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase) :
    (ids.foldl (fun w i => failWaiter w dead i) w).st s = w.st s := by
  induction ids generalizing w with
  | nil => simp
  | cons i ids ih =>
    simp only [List.foldl_cons] at h ⊢
    have htail := ih (failWaiter w dead i) h
    have hmid : isWait ((failWaiter w dead i).st s).phase := by
      rw [← congrArg (fun a => a.phase) htail]
      exact h
    exact htail.trans (failWaiter_keeps_wait w dead i s hmid)

theorem admitHost_ty (w : World) (dead host s : InstId) :
    ((admitHost w dead host).st s).typestate = (w.st s).typestate := by
  unfold admitHost
  by_cases hhost : (host == dead) = true
  · simp [hhost]
  · simp only [hhost, ite_false]
    by_cases hempty : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty = true
    · simp [hempty]
    · simp only [hempty, ite_false]
      by_cases hs : s = host
      · simp [setActor, hs]
      · simp [setActor, hs]

theorem admitFold_ty (w : World) (dead s : InstId) (ids : List InstId) :
    ((ids.foldl (fun w host => admitHost w dead host) w).st s).typestate =
      (w.st s).typestate := by
  induction ids generalizing w with
  | nil => rfl
  | cons host ids ih =>
    simp only [List.foldl_cons]
    exact (ih (admitHost w dead host)).trans (admitHost_ty w dead host s)

theorem admitDead_typestate (w : World) (dead s : InstId) :
    ((admitDead w dead).st s).typestate = (w.st s).typestate := by
  simpa [admitDead] using admitFold_ty w dead s w.roster

/-- A wait that survives `abortActor` was already that wait, with the same typestate. -/
theorem abort_wait (D : Description) (w : World) (id : InstId) (a : Actor) (s : InstId)
    (h : PhaseWait ((abortActor D w id a).st s).phase) :
    ((abortActor D w id a).st s).phase = (w.st s).phase ∧
      ((abortActor D w id a).st s).typestate = (w.st s).typestate := by
  have hph := (admitDead_phase (failWaiters (releaseWorld D w id a) id) id s).1
  have htyA := admitDead_typestate (failWaiters (releaseWorld D w id a) id) id s
  have hwait : isWait ((failWaiters (releaseWorld D w id a) id).st s).phase := by
    apply phaseWait_isWait
    rw [← hph]
    simpa [abortActor] using h
  have hact := failFold_wait_actor (releaseWorld D w id a) id s
    (releaseWorld D w id a).roster (by simpa [failWaiters] using hwait)
  have hpostR : PhaseWait ((releaseWorld D w id a).st s).phase :=
    isWait_phaseWait _ (by rw [← congrArg (fun a => a.phase) hact]; simpa [failWaiters] using hwait)
  have hrel := releaseWorld_wait D w id a s hpostR
  refine ⟨?_, ?_⟩
  · have hphF := congrArg (fun a => a.phase) hact
    simpa [abortActor, failWaiters] using hph.trans (hphF.trans hrel.1)
  · have htyF := congrArg (fun a => a.typestate) hact
    simpa [abortActor, failWaiters] using htyA.trans (htyF.trans hrel.2)

/-- A wait that survives the descendant fold had the same phase and typestate. -/
theorem abortDesc_wait (fuel : Nat) (D : Description) (w : World) (parent s : InstId)
    (h : PhaseWait ((abortDesc fuel D w parent).st s).phase) :
    ((abortDesc fuel D w parent).st s).phase = (w.st s).phase ∧
      ((abortDesc fuel D w parent).st s).typestate = (w.st s).typestate := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using And.intro rfl rfl
  | succ fuel ih =>
    simp only [abortDesc] at h ⊢
    suffices ∀ (ids : List InstId) (w0 : World),
        PhaseWait ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).phase →
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).phase = (w0.st s).phase ∧
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).typestate = (w0.st s).typestate by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil =>
      intro w0 h0
      simpa using And.intro rfl rfl
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons] at h0 ⊢
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo] at h0 ⊢
        have htail := ihf (abortActor D (abortDesc fuel D w0 c) c
          ((abortDesc fuel D w0 c).st c)) h0
        have hpost2 : PhaseWait ((abortActor D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c)).st s).phase := by
          rw [htail.1] at h0
          exact h0
        have hstep := abort_wait D (abortDesc fuel D w0 c) c
          ((abortDesc fuel D w0 c).st c) s hpost2
        have hpost1 : PhaseWait (((abortDesc fuel D w0 c).st s).phase) := by
          rw [hstep.1] at hpost2
          exact hpost2
        have hdesc := ih w0 c hpost1
        exact ⟨htail.1.trans (hstep.1.trans hdesc.1), htail.2.trans (hstep.2.trans hdesc.2)⟩
      · rw [if_neg hgo] at h0 ⊢
        exact ihf w0 h0

theorem enqueueTombstone_typestate (D : Description) (w : World) (child s : InstId) :
    ((enqueueTombstone D w child).st s).typestate = (w.st s).typestate := by
  cases hsup : supervisorOf D child with
  | none => simp [enqueueTombstone, hsup]
  | some parent =>
    simp [enqueueTombstone, hsup]
    split
    · by_cases h : s = parent
      · simp [setActor, h]
      · simp [setActor, h]
    · rfl

/-- A wait that survives `terminateStage` had the same typestate before it. -/
theorem terminate_ty_wait (D : Description) (w : World) (id s : InstId)
    (h : PhaseWait ((terminateStage D w id (w.st id)).st s).phase) :
    ((terminateStage D w id (w.st id)).st s).typestate = (w.st s).typestate := by
  simp only [terminateStage] at h ⊢
  have htyT := enqueueTombstone_typestate D
    (abortActor D (abortDesc w.roster.length D w id) id ((abortDesc w.roster.length D w id).st id)) id s
  have hphT := enqueueTombstone_phase D
    (abortActor D (abortDesc w.roster.length D w id) id ((abortDesc w.roster.length D w id).st id)) id s
  have hpost2 : PhaseWait ((abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)).st s).phase := by
    rw [hphT] at h
    exact h
  have hstep := abort_wait D (abortDesc w.roster.length D w id) id
    ((abortDesc w.roster.length D w id).st id) s hpost2
  have hpost1 : PhaseWait (((abortDesc w.roster.length D w id).st s).phase) := by
    rw [hstep.1] at hpost2
    exact hpost2
  have hdesc := abortDesc_wait w.roster.length D w id s hpost1
  exact htyT.trans (hstep.2.trans hdesc.2)

/-- One step does not change the typestate of an actor that stays parked or awaiting. -/
theorem waiting_ty_step (I : Impl) (a : Action) (w w' : World) (s : InstId)
    (h : apply I a w = some w')
    (hpre : PhaseWait ((w.st s).phase)) (hpost : PhaseWait ((w'.st s).phase)) :
    (w'.st s).typestate = (w.st s).typestate := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    rfl
  | callTimeout id =>
    have hct : callTimeout w id = some w' := by simpa [stepWorld] using stepOfApply h
    by_cases hs : s = id
    · exfalso
      rw [hs] at hpost
      rcases callTimeout_self w w' id hct with ⟨_, k0, _, hproc⟩ | ⟨_, k0, _, hproc⟩ | ⟨k0, _, hproc⟩
      · rw [hproc] at hpost
        exact absurd hpost (proceed_not_wait _ (selectCall k0 .timedOut))
      · rw [hproc] at hpost
        exact absurd hpost (proceed_not_wait _ (selectCall k0 .notAdmitted))
      · rw [hproc] at hpost
        exact absurd hpost (proceed_not_wait _
          {k0 with rest := k0.onTimeout, toState := pickState k0.toState k0.toTimeout})
    · exact deadline_keeps_ty w w' id s hct hs
  | ingress who label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    exact ingress_ty_eq I w w' who label s h
  | finish j =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨kF, _, hw⟩ := finish_proceed I w w' j h
    rw [hw] at hpost ⊢
    by_cases hs : s = j
    · rw [hs] at hpost ⊢
      rw [setActor_self] at hpost
      exact absurd hpost (proceed_not_wait _ kF)
    · simp [setActor, hs]
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        simp only [readCells_st]
        by_cases hi : s = InstId.peer template (w.nextIx template)
        · simp [readCells_st, setActor, hi, withTokens, PhaseWait] at hpost
        · simp [readCells_st, setActor, hi]
      · cases h
  | recvPrio j =>
    by_cases hs : s = j
    · rw [hs] at hpre
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold receivePrio at h
      cases hp : (w.st j).prio with
      | nil => simp [hp] at h
      | cons _ _ =>
        simp [hp] at h
        rcases hpre with ⟨_, _, _, hph⟩ | ⟨_, _, hph⟩ <;> simp [hph] at h
    · have h := stepOfApply h
      simp only [stepWorld] at h
      unfold receivePrio at h
      cases hp : (w.st j).prio with
      | nil => simp [hp] at h
      | cons m ms =>
        by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
        · simp [hp, hready] at h
        · simp [hp, hready] at h
          split at h
          · cases h
          · next w1 a1 hdel =>
            cases h
            have hst := deliver_st I w j _ m w1 a1 s hdel
            simpa [setActor, hs] using congrArg (·.typestate) hst
  | recvBulk j =>
    by_cases hs : s = j
    · rw [hs] at hpre
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold receiveBulk at h
      rcases hpre with ⟨_, _, _, hph⟩ | ⟨_, _, hph⟩ <;> simp [hph] at h
    · have h := stepOfApply h
      simp only [stepWorld] at h
      unfold receiveBulk at h
      by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
      · simp [hready] at h
      · simp [hready] at h
        cases hbox : (w.st j).box with
        | nil =>
          cases hpark : (w.st j).parked with
          | nil => simp [hbox, hpark] at h
          | cons q qs =>
            simp [hbox, hpark] at h
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w j _ q.msg w1 a1 s hdel
              have hset : ((setActor w1 j a1).st s).typestate = (w.st s).typestate := by
                simpa [setActor, hs] using congrArg (·.typestate) hst
              have hcred := (creditLive_keeps (setActor w1 j a1) (tname j) q.msg.sender s).2.1
              by_cases hsender : s = q.sender
              · rw [← hsender] at hpost ⊢
                simp [setActor] at hpost ⊢
                exact (resume_ty _ q.isCall j hpost).trans (hcred.trans hset)
              · simp [setActor, hsender]
                exact hcred.trans hset
        | cons m ms =>
          cases hpark : (w.st j).parked with
          | nil =>
            simp [hbox, hpark] at h
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w j _ m w1 a1 s hdel
              have hset : ((setActor w1 j a1).st s).typestate = (w.st s).typestate := by
                simpa [setActor, hs] using congrArg (·.typestate) hst
              exact ((creditLive_keeps (setActor w1 j a1) (tname j) m.sender s).2.1).trans hset
          | cons q qs =>
            simp [hbox, hpark] at h
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w j _ m w1 a1 s hdel
              let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
              have hset : ((setActor w1 j admitted).st s).typestate = (w.st s).typestate := by
                simpa [setActor, admitted, hs] using congrArg (·.typestate) hst
              have hcred := (creditLive_keeps (setActor w1 j admitted) (tname j) m.sender s).2.1
              by_cases hsender : s = q.sender
              · rw [← hsender] at hpost ⊢
                simp [setActor] at hpost ⊢
                exact (resume_ty _ q.isCall j hpost).trans (hcred.trans hset)
              · simp [setActor, hsender]
                exact hcred.trans hset
  | exec j =>
    by_cases hs : s = j
    · rw [hs] at hpre
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold execHead at h
      rcases hpre with ⟨_, _, _, hph⟩ | ⟨_, _, hph⟩ <;> simp [hph] at h
    · have h := stepOfApply h
      simp only [stepWorld] at h
      unfold execHead at h
      by_cases hlj : (w.st j).life = .alive
      · simp [hlj] at h
        cases hp : (w.st j).phase with
        | run kE =>
          simp [hp] at h
          cases h
          cases hk : kE.rest with
          | nil => simp [execRun, hk, setActor, hs]
          | cons e tail =>
            cases e with
            | send name label hint =>
              simp [execRun, hk] at hpost ⊢
              cases hr : route w I.desc j name with
              | none =>
                simp [hr, setActor, hs] at hpost ⊢
              | some dstId =>
                simp [hr] at hpost ⊢
                exact enqueue_ty_wait w I.desc j dstId s
                  ({ label := label, sender := j, callFrom := none } : Msg) false (afterHead kE) hpost
            | call name label hint na to =>
              simp [execRun, hk] at hpost ⊢
              cases hr : route w I.desc j name with
              | none => simp [hr, setActor, hs] at hpost ⊢
              | some dstId =>
                simp [hr] at hpost ⊢
                exact enqueue_ty_wait w I.desc j dstId s
                  ({ label := label, sender := j, callFrom := some j } : Msg) true (afterHead kE) hpost
            | trySend name label hint onFull onGone =>
              simp [execRun, hk] at hpost ⊢
              cases hr : route w I.desc j name with
              | none => simp [hr, setActor, hs] at hpost ⊢
              | some dstId =>
                simp [hr] at hpost ⊢
                split
                · next hgo =>
                  simp [hgo] at hpost ⊢
                  exact enqueue_ty_wait w I.desc j dstId s
                    ({ label := label, sender := j, callFrom := none, reliable := false } : Msg)
                    false (afterHead kE) hpost
                · next hmiss =>
                  simp [hmiss, setActor, hs, proceed] at hpost ⊢
            | reply =>
              simp [execRun, hk] at hpost ⊢
              exact reply_ty_wait w j kE s hpost
            | selfSchedule _ =>
              simp [execRun, hk]
              split
              · simp [setActor, hs, proceed]
              · split
                · simp [setActor, hs, proceed]
                · simp [setActor, hs]
            | cell name label value =>
              simp only [execRun, hk]
              split
              · simp [setCell, setActor, hs, proceed]
              · let w1 : World := setActor (setCell w name label
                    { value := max (w.cell name label).value value, dirty := true }) j
                  (proceed ((setCell w name label
                    { value := max (w.cell name label).value value, dirty := true }).st j) (afterHead kE))
                have hbase : (w1.st s).typestate = (w.st s).typestate := by
                  simp [w1, setCell, setActor, hs, proceed]
                rw [wakeReaders]
                exact (wakes_ty (readersOf w1 name) I.desc w1 name label j s).trans hbase
            | internal => simp [execRun, hk, setActor, hs]
            | peer onTimeout => simp [execRun, hk, setActor, hs]
            | terminate =>
              rcases exec_term_world I w j kE tail hk with
                hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
              · rw [hkept]
              · let base :=
                  refundParked (refundMsgs (readCells I.desc w j) (tname j) (w.st j).box) (tname j)
                    (w.st j).parked
                let deadA : Actor :=
                  { base.st j with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
                have hbase : (base.st s).typestate = (w.st s).typestate := by
                  have hread := congrArg (·.typestate) (readCells_st I.desc w j s)
                  have href := (refund_life (readCells I.desc w j) (tname j) (w.st j).box s).2.1
                  have hrefp :=
                    (refundP_life (refundMsgs (readCells I.desc w j) (tname j) (w.st j).box) (tname j)
                      (w.st j).parked s).2.1
                  simp [base, hread, href, hrefp]
                have hset : ((setActor base j deadA).st s).typestate = (w.st s).typestate := by
                  simp [setActor, hs, hbase]
                have hstep : execRun I w j (w.st j) kE =
                    releaseParked (setActor base j deadA) j (w.st j).parked := by
                  rw [hrel]
                  simp [releaseWorld, base, deadA]
                rw [hstep] at hpost ⊢
                exact (release_ty_wait (setActor base j deadA) j (w.st j).parked s hpost).trans hset
              · rw [hkill] at hpost ⊢
                exact terminate_ty_wait I.desc w j s hpost
        | idle => simp [hp] at h
        | parked _ _ _ => simp [hp] at h
        | awaitReply _ _ => simp [hp] at h
        | awaitEffect _ => simp [hp] at h
        | awaitPeer _ => simp [hp] at h
        | crashed => simp [hp] at h
      · simp [hlj] at h

/-- While `s` stays parked or awaiting, its typestate does not change. -/
theorem parked_typestate_stays (I : Impl) {N : Nat} (ρ : Run I N)
    (s : InstId) (i n : Nat)
    (hwait : ∀ t, i ≤ t → t ≤ i + n → PhaseWait (((ρ.cfg t).st s).phase)) :
    ((ρ.cfg (i + n)).st s).typestate = ((ρ.cfg i).st s).typestate := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hwait t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hstep := waiting_ty_step I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) s
      (ρ.valid (i + n))
      (hwait (i + n) (Nat.le_add_right i n) (by omega))
      (hwait (i + n + 1) (by omega) (by omega))
    exact hstep.trans hprev

/-- A blocking send keeps the waiter's height, and the live callee stays strictly below it. -/
theorem send_height_below (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : ((ρ.cfg i).st s).phase = .parked dst false k)
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.blockingSend dst))
    (hlive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st dst).life = .alive) :
    rankAt hs (ρ.cfg (i + n)) s = rankAt hs (ρ.cfg i) s ∧
      rankAt hs (ρ.cfg (i + n)) dst < rankAt hs (ρ.cfg i) s := by
  have hphn := blocking_stays I hL ρ s dst k i n hph hkind
  have hty := parked_typestate_stays I ρ s i n (fun t h1 h2 => by
    obtain ⟨k0, hk0⟩ := blocking_parked ((ρ.cfg t).st s) dst (hkind t h1 h2)
    exact Or.inl ⟨dst, false, k0, hk0⟩)
  have hrank : rankAt hs (ρ.cfg (i + n)) s = rankAt hs (ρ.cfg i) s := by
    simp [rankAt, hty]
  refine ⟨hrank, ?_⟩
  rw [← hrank]
  have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
  simpa [rankAt] using park_below I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n)) hO s dst k
    hs hok hphn (hlive (i + n) (Nat.le_add_right _ _) (Nat.le_refl _))

/-- Releasing a mailbox skips call entries, so a parked caller keeps its phase. -/
theorem release_keeps_caller (w : World) (id : InstId) (ps : List Parked) (s : InstId)
    (h : ∀ p, p ∈ ps → p.sender = s → p.isCall = true) :
    ((releaseParked w id ps).st s).phase = (w.st s).phase := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w (fun q hq => h q (List.mem_cons_of_mem p hq))
    · rw [if_neg hskip]
      have hne : s ≠ p.sender := by
        intro hs
        have hc : p.isCall = true := h p (by simp) hs.symm
        simp [hc] at hskip
      have hstep : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st s).phase =
          (w.st s).phase := by simp [setActor, hne]
      exact (ih _ (fun q hq => h q (List.mem_cons_of_mem p hq))).trans hstep

/-- A parked call is admitted, stays parked, or a subtree kill resumes or idles it. -/
theorem call_park_next (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : (w.st s).phase = .parked dst true k) :
    (w'.st s).phase = .parked dst true k ∨ (w'.st s).phase = .awaitReply dst k ∨
      (w'.st s).phase = .idle ∨ (w'.st s).phase = .run k := by
  cases a with
  | stutter =>
    cases stutter_unchanged I w w' h
    exact Or.inl hph
  | ingress who label =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    exact Or.inl ((ingress_phase I w w' who label s h).1.trans hph)
  | finish j =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    obtain ⟨_, hphF, hw⟩ := finish_proceed I w w' j h
    rw [hw]
    by_cases hs : s = j
    · rw [hs] at hph
      rcases hphF with hphF | hphF <;> simp [hph] at hphF
    · exact Or.inl (by simpa [setActor, hs] using hph)
  | spawn template =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    unfold spawn at h
    split at h
    · cases h
    · next t ht =>
      split at h
      · cases h
        have hslot := hO template (w.nextIx template) (Nat.le_refl _)
        have hne : s ≠ InstId.peer template (w.nextIx template) := by
          intro heq
          rw [heq] at hph
          rw [hslot.2.1] at hph
          cases hph
        simp only [readCells_st, setActor, hne]
        exact Or.inl hph
      · cases h
  | recvPrio j =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    by_cases hs : s = j
    · rw [hs] at hph
      unfold receivePrio at h
      cases hp : (w.st j).prio with
      | nil => simp [hp] at h
      | cons _ _ => simp [hp, hph] at h
    · have hpk := prio_parked I w w' j s (by simpa using h)
      exact Or.inl (by
        unfold receivePrio at h
        cases hp : (w.st j).prio with
        | nil => simp [hp] at h
        | cons m ms =>
          by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
          · simp [hp, hready] at h
          · simp [hp, hready] at h
            split at h
            · cases h
            · next w1 a1 hdel =>
              cases h
              have hst := deliver_st I w j _ m w1 a1 s hdel
              simpa [setActor, hs, hst] using hph)
  | recvBulk j =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    by_cases hsj : s = j
    · rw [hsj] at hph
      unfold receiveBulk at h
      simp [hph] at h
    · by_cases hjd : j = dst
      · obtain ⟨p0, hp0, hs0, hc0⟩ := hM.bwd s dst true k hph
        cases hpk : (w.st dst).parked with
        | nil => exact absurd hp0 (by simp [hpk])
        | cons p ps =>
          by_cases hhead : s = p.sender
          · have hc : p.isCall = true := by
              have hmem : p ∈ (w.st dst).parked := by simp [hpk]
              exact (hM.uniq dst dst p0 p hp0 hmem (hs0.trans hhead)).2 ▸ hc0
            have hrecv : receiveBulk I w dst = some w' := by
              simpa [hjd] using h
            exact Or.inr (Or.inl (bulk_admits_call I w w' dst hrecv p ps hpk s hhead
              (by simpa [hjd] using hsj) k (by simpa [hjd] using hph) hc))
          · unfold receiveBulk at h
            by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
            · simp [hready] at h
            · simp [hready] at h
              cases hbox : (w.st j).box with
              | nil =>
                simp [hbox] at h
                cases hpark : (w.st j).parked with
                | nil => simp [hpark] at h
                | cons q qs =>
                  simp [hpark] at h
                  have hns : s ≠ q.sender := by
                    have hsame : (w.st j).parked = (w.st dst).parked := by simp [hjd]
                    rw [hsame, hpk] at hpark
                    cases hpark
                    exact hhead
                  split at h
                  · cases h
                  · next w1 a1 hdel =>
                    cases h
                    have hst := deliver_st I w j _ q.msg w1 a1 s hdel
                    have hset : ((setActor w1 j a1).st s).phase = (w.st s).phase := by
                      simpa [setActor, hsj, hst] using hph
                    have hcred := (creditLive_keeps (setActor w1 j a1) (tname j) q.msg.sender s).2.2.1
                    simp only [setActor, hns, ite_false]
                    exact Or.inl ((hcred.trans hset).trans hph)
              | cons m ms =>
                cases hpark : (w.st j).parked with
                | nil =>
                  simp [hbox, hpark] at h
                  split at h
                  · cases h
                  · next w1 a1 hdel =>
                    cases h
                    have hst := deliver_st I w j _ m w1 a1 s hdel
                    have hcred := (creditLive_keeps (setActor w1 j a1) (tname j) m.sender s).2.2.1
                    have hset : ((setActor w1 j a1).st s).phase = (w.st s).phase := by
                      simpa [setActor, hsj, hst] using hph
                    exact Or.inl ((hcred.trans hset).trans hph)
                | cons q qs =>
                  simp [hbox, hpark] at h
                  have hns : s ≠ q.sender := by
                    have hsame : (w.st j).parked = (w.st dst).parked := by simp [hjd]
                    rw [hsame, hpk] at hpark
                    cases hpark
                    exact hhead
                  split at h
                  · cases h
                  · next w1 a1 hdel =>
                    cases h
                    have hst := deliver_st I w j _ m w1 a1 s hdel
                    let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
                    have hset : ((setActor w1 j admitted).st s).phase = (w.st s).phase := by
                      simpa [setActor, admitted, hsj, hst] using hph
                    have hcred := (creditLive_keeps (setActor w1 j admitted) (tname j) m.sender s).2.2.1
                    simp only [setActor, hns, ite_false]
                    exact Or.inl ((hcred.trans hset).trans hph)
      · unfold receiveBulk at h
        by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
        · simp [hready] at h
        · simp [hready] at h
          cases hbox : (w.st j).box with
          | nil =>
            cases hpark : (w.st j).parked with
            | nil => simp [hbox, hpark] at h
            | cons q qs =>
              simp [hbox, hpark] at h
              have hns : s ≠ q.sender := by
                intro heq
                obtain ⟨p0, hp0, hs0, _⟩ := hM.bwd s dst true k hph
                have hmemq : q ∈ (w.st j).parked := by simp [hpark]
                exact hjd ((hM.uniq j dst q p0 hmemq hp0 (heq.symm.trans hs0.symm)).1)
              split at h
              · cases h
              · next w1 a1 hdel =>
                cases h
                have hst := deliver_st I w j _ q.msg w1 a1 s hdel
                have hset : ((setActor w1 j a1).st s).phase = (w.st s).phase := by
                  simpa [setActor, hsj, hst] using hph
                have hcred := (creditLive_keeps (setActor w1 j a1) (tname j) q.msg.sender s).2.2.1
                simp only [setActor, hns, ite_false]
                exact Or.inl ((hcred.trans hset).trans hph)
          | cons m ms =>
            cases hpark : (w.st j).parked with
            | nil =>
              simp [hbox, hpark] at h
              split at h
              · cases h
              · next w1 a1 hdel =>
                cases h
                have hst := deliver_st I w j _ m w1 a1 s hdel
                have hcred := (creditLive_keeps (setActor w1 j a1) (tname j) m.sender s).2.2.1
                have hset : ((setActor w1 j a1).st s).phase = (w.st s).phase := by
                  simpa [setActor, hsj, hst] using hph
                exact Or.inl ((hcred.trans hset).trans hph)
            | cons q qs =>
              simp [hbox, hpark] at h
              have hns : s ≠ q.sender := by
                intro heq
                obtain ⟨p0, hp0, hs0, _⟩ := hM.bwd s dst true k hph
                have hmemq : q ∈ (w.st j).parked := by simp [hpark]
                exact hjd ((hM.uniq j dst q p0 hmemq hp0 (heq.symm.trans hs0.symm)).1)
              split at h
              · cases h
              · next w1 a1 hdel =>
                cases h
                have hst := deliver_st I w j _ m w1 a1 s hdel
                let admitted : Actor := { a1 with box := a1.box ++ [q.msg], parked := qs }
                have hset : ((setActor w1 j admitted).st s).phase = (w.st s).phase := by
                  simpa [setActor, admitted, hsj, hst] using hph
                have hcred := (creditLive_keeps (setActor w1 j admitted) (tname j) m.sender s).2.2.1
                simp only [setActor, hns, ite_false]
                exact Or.inl ((hcred.trans hset).trans hph)
  | exec j =>
    have h := stepOfApply h
    simp only [stepWorld] at h
    by_cases hsj : s = j
    · rw [hsj] at hph
      unfold execHead at h
      simp [hph] at h
    · unfold execHead at h
      by_cases hlj : (w.st j).life = .alive
      · simp [hlj] at h
        cases hp : (w.st j).phase with
        | run kE =>
          simp [hp] at h
          cases h
          cases hk : kE.rest with
          | nil => exact Or.inl (by simp [execRun, hk, setActor, hsj, hph])
          | cons e tail =>
            cases e with
            | send name label hint =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => exact Or.inl (by simp [hr, setActor, hsj, hph])
              | some dstId =>
                simp [hr]
                exact Or.inl ((enqueue_phase_other w I.desc j dstId
                  ({ label := label, sender := j, callFrom := none } : Msg) false (afterHead kE) s hsj).trans hph)
            | call name label hint na to =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => exact Or.inl (by simp [hr, setActor, hsj, hph])
              | some dstId =>
                simp [hr]
                exact Or.inl ((enqueue_phase_other w I.desc j dstId
                  ({ label := label, sender := j, callFrom := some j } : Msg) true (afterHead kE) s hsj).trans hph)
            | trySend name label hint onFull onGone =>
              simp [execRun, hk]
              cases hr : route w I.desc j name with
              | none => exact Or.inl (by simp [hr, setActor, hsj, hph])
              | some dstId =>
                simp [hr]
                split
                · exact Or.inl ((enqueue_phase_other w I.desc j dstId
                    ({ label := label, sender := j, callFrom := none, reliable := false } : Msg) false
                    (afterHead kE) s hsj).trans hph)
                · exact Or.inl (by simp [setActor, hsj, hph])
            | reply =>
              simp [execRun, hk]
              exact Or.inl ((reply_keeps_quiet w j s kE
                (fun d ck hbad => by simp [hph] at hbad) hsj).1.trans hph)
            | selfSchedule _ =>
              simp [execRun, hk]
              split
              · exact Or.inl (by simp [setActor, hsj, hph])
              · split
                · exact Or.inl (by simp [setActor, hsj, hph])
                · exact Or.inl (by simp [setActor, hsj, hph])
            | cell name label value =>
              simp only [execRun, hk]
              split
              · exact Or.inl (by simp [setCell, setActor, hsj, hph])
              · rw [wakeReaders]
                exact Or.inl (by
                  rw [wakes_phase (readersOf _ _) I.desc _ name label j s]
                  simp [setCell, setActor, hsj, hph])
            | internal => exact Or.inl (by simp [execRun, hk, setActor, hsj, hph])
            | peer onTimeout => exact Or.inl (by simp [execRun, hk, setActor, hsj, hph])
            | terminate =>
              rcases exec_term_world I w j kE tail hk with
                hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
              · exact Or.inl (by rw [hkept]; exact hph)
              · let base :=
                  refundParked (refundMsgs (readCells I.desc w j) (tname j) (w.st j).box) (tname j)
                    (w.st j).parked
                let deadA : Actor :=
                  { base.st j with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
                have hcalls : ∀ p, p ∈ (w.st j).parked → p.sender = s → p.isCall = true := by
                  intro p hp hsnd
                  obtain ⟨q, hq, hqs, hc⟩ := hM.bwd s dst true k hph
                  have hjd : j = dst := (hM.uniq j dst p q hp hq (hsnd.trans hqs.symm)).1
                  have hsame := (hM.uniq j dst p q hp hq (hsnd.trans hqs.symm)).2
                  simpa [hsame] using hc
                have hbase : (base.st s).phase = (w.st s).phase := by
                  have hread := readCells_st I.desc w j s
                  have href := (refund_life (readCells I.desc w j) (tname j) (w.st j).box s).2.2.1
                  have hrefp :=
                    (refundP_life (refundMsgs (readCells I.desc w j) (tname j) (w.st j).box) (tname j)
                      (w.st j).parked s).2.2.1
                  simp [base, hread, href, hrefp]
                have hset : ((setActor base j deadA).st s).phase = (w.st s).phase := by
                  simp [setActor, hsj, hbase]
                have hkeep := release_keeps_caller (setActor base j deadA) j (w.st j).parked s hcalls
                have hstep : execRun I w j (w.st j) kE =
                    releaseParked (setActor base j deadA) j (w.st j).parked := by
                  rw [hrel]
                  simp [releaseWorld, base, deadA]
                rw [hstep]
                exact Or.inl ((hkeep.trans hset).trans hph)
              · rw [hkill]
                rcases terminate_block I.desc w j s dst true k hph with hstay | hres | hidle
                · exact Or.inl hstay
                · cases hkrest : k.rest with
                  | nil =>
                    exact Or.inr (Or.inr (Or.inl (by simpa [resumed, hkrest] using hres)))
                  | cons _ _ =>
                    exact Or.inr (Or.inr (Or.inr (by simpa [resumed, hkrest] using hres)))
                · exact Or.inr (Or.inr (Or.inl hidle))
        | idle => simp [hp] at h
        | parked _ _ _ => simp [hp] at h
        | awaitReply _ _ => simp [hp] at h
        | awaitEffect _ => simp [hp] at h
        | awaitPeer _ => simp [hp] at h
        | crashed => simp [hp] at h
      · simp [hlj] at h

/-- A call keeps its continuation: admission only rewrites parked into `awaitReply`. -/
def CallPhase (dst : InstId) (k : Cont) (ph : Phase) : Prop :=
  ph = .parked dst true k ∨ ph = .awaitReply dst k

theorem call_step (I : Impl) (a : Action) (w w' : World) (s dst : InstId) (k : Cont)
    (hM : MailInv w) (hO : OpenSlots w) (h : apply I a w = some w')
    (hph : CallPhase dst k ((w.st s).phase))
    (hkind : waitKind ((w'.st s)) = some (.callReply dst)) :
    CallPhase dst k ((w'.st s).phase) := by
  rcases hph with hpark | hawait
  · rcases call_park_next I a w w' s dst k hM hO h hpark with hstay | hadm | hdead
    · exact Or.inl hstay
    · exact Or.inr hadm
    · rcases hdead with hidle | hrun
      · simp [waitKind, hidle] at hkind
      · simp [waitKind, hrun] at hkind
  · rcases await_next I a w w' s dst k hM hO h hawait with hstay | hpro | hidle
    · exact Or.inr hstay
    · have hwk : waitKind ((w'.st s)) = waitKind (proceed ((w.st s)) k) := by simp [waitKind, hpro]
      exact absurd (hwk.symm.trans hkind) (proceed_not_reply ((w.st s)) k dst)
    · simp [waitKind, hidle] at hkind

theorem call_stays (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : CallPhase dst k (((ρ.cfg i).st s).phase))
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.callReply dst)) :
    CallPhase dst k (((ρ.cfg (i + n)).st s).phase) := by
  induction n with
  | zero => simpa using hph
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hkind t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hR := cfg_reachable ρ (i + n)
    have hM := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.1
    have hO := (inv_reachable I N (ρ.cfg (i + n)) hL hR).2.2
    exact call_step I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1)) s dst k hM hO
      (ρ.valid (i + n)) hprev (hkind (i + n + 1) (by omega) (by omega))

/-- The first step that leaves a call reply drops `phaseFuel`. -/
theorem call_drops_at (I : Impl) (hL : LocalOk I) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i j : Nat)
    (hph : CallPhase dst k (((ρ.cfg i).st s).phase)) (hlt : i < j)
    (hbefore : ∀ t, i ≤ t → t < j → waitKind ((ρ.cfg t).st s) = some (.callReply dst))
    (hdiff : waitKind ((ρ.cfg j).st s) ≠ some (.callReply dst)) :
    phaseFuel (((ρ.cfg j).st s).phase) < phaseFuel (((ρ.cfg i).st s).phase) := by
  have hle : i ≤ j - 1 := by omega
  have hpre := call_stays I hL ρ s dst k i ((j - 1) - i) hph
    (fun t h1 h2 => hbefore t h1 (by omega))
  have hidx : i + ((j - 1) - i) = j - 1 := Nat.add_sub_of_le hle
  have hph1 : CallPhase dst k (((ρ.cfg (j - 1)).st s).phase) := by simpa [hidx] using hpre
  have hR := cfg_reachable ρ (j - 1)
  have hM := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.1
  have hO := (inv_reachable I N (ρ.cfg (j - 1)) hL hR).2.2
  have hv := ρ.valid (j - 1)
  have hj1 : (j - 1) + 1 = j := by omega
  rw [hj1] at hv
  rcases hph1 with hpark | hawait
  · have hstep := call_park_next I (ρ.act (j - 1)) (ρ.cfg (j - 1)) (ρ.cfg j) s dst k hM hO hv hpark
    rcases hstep with hstay | hadm | hdead
    · exact absurd (by simp [waitKind, hstay]) hdiff
    · exact absurd (by simp [waitKind, hadm]) hdiff
    · rcases hdead with hidle | hrun
      · have hdrop : phaseFuel (((ρ.cfg j).st s).phase) < phaseFuel (((ρ.cfg (j - 1)).st s).phase) := by
          rw [hidle, hpark]; simp only [phaseFuel]; omega
        have heq : phaseFuel (((ρ.cfg (j - 1)).st s).phase) = phaseFuel (((ρ.cfg i).st s).phase) := by
          rw [hpark]
          rcases hph with hpark0 | hawait0
          · rw [hpark0]
          · rw [hawait0]; simp only [phaseFuel]
        exact Nat.lt_of_lt_of_eq hdrop heq
      · have hdrop : phaseFuel (((ρ.cfg j).st s).phase) < phaseFuel (((ρ.cfg (j - 1)).st s).phase) := by
          rw [hrun, hpark]; simp only [phaseFuel]; omega
        have heq : phaseFuel (((ρ.cfg (j - 1)).st s).phase) = phaseFuel (((ρ.cfg i).st s).phase) := by
          rw [hpark]
          rcases hph with hpark0 | hawait0
          · rw [hpark0]
          · rw [hawait0]; simp only [phaseFuel]
        exact Nat.lt_of_lt_of_eq hdrop heq
  · have hdrop := await_fuel I (ρ.act (j - 1)) (ρ.cfg (j - 1)) (ρ.cfg j) s dst k hM hO hv hawait hdiff
    have heq : phaseFuel (((ρ.cfg (j - 1)).st s).phase) = phaseFuel (((ρ.cfg i).st s).phase) := by
      rcases hph with hpark0 | hawait0
      · simp [phaseFuel, hawait, hpark0]
      · simp [phaseFuel, hawait, hawait0]
    omega

theorem call_is_wait (dst : InstId) (k : Cont) (ph : Phase) (h : CallPhase dst k ph) : PhaseWait ph := by
  rcases h with h | h
  · exact Or.inl ⟨dst, true, k, h⟩
  · exact Or.inr ⟨dst, k, h⟩

theorem proceed_not_callphase (a : Actor) (k k0 : Cont) (dst : InstId) :
    ¬CallPhase dst k0 (proceed a k).phase := by
  cases hk : k.rest <;> simp [proceed, CallPhase, hk]

theorem failWaiter_keeps_gone (w : World) (dead i s dst : InstId) (k : Cont)
    (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((failWaiter w dead i).st s).phase := by
  unfold failWaiter
  by_cases hdead : ((w.st i).life != .alive) = true
  · simpa [hdead] using h
  · simp only [hdead, ite_false]
    cases hph : (w.st i).phase with
    | parked d _ ck =>
      by_cases hd : (d == dead) = true
      · by_cases hs : s = i
        · simp [hph, hd, hs, setActor]
          exact proceed_not_callphase (w.st i) ck k dst
        · simpa [hph, hd, setActor, hs] using h
      · simpa [hph, hd] using h
    | awaitReply d _ =>
      by_cases hd : (d == dead) = true
      · by_cases hs : s = i
        · simp [hph, hd, hs, setActor, CallPhase]
        · simpa [hph, hd, setActor, hs] using h
      · simpa [hph, hd] using h
    | idle => simpa [hph] using h
    | run _ => simpa [hph] using h
    | awaitEffect _ => simpa [hph] using h
    | awaitPeer _ => simpa [hph] using h
    | crashed => simpa [hph] using h

theorem failFold_keeps_gone (w : World) (dead s dst : InstId) (k : Cont) (ids : List InstId)
    (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((ids.foldl (fun w i => failWaiter w dead i) w).st s).phase := by
  induction ids generalizing w with
  | nil => simpa using h
  | cons i ids ih =>
    simp only [List.foldl_cons]
    exact ih _ (failWaiter_keeps_gone w dead i s dst k h)

theorem failWaiter_drops_call (w : World) (s dst : InstId) (k : Cont)
    (hlive : (w.st s).life = .alive) (hph : CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((failWaiter w dst s).st s).phase := by
  have hgo : ((w.st s).life != .alive) = false := by simp [hlive, bne]
  have hd : (dst == dst) = true := by simp
  rcases hph with hpark | hawait
  · simp [failWaiter, hgo, hpark, hd, setActor]
    exact proceed_not_callphase (w.st s) k k dst
  · simp [failWaiter, hgo, hawait, hd, setActor, CallPhase]

theorem failFold_drops_call (w : World) (dst s : InstId) (k : Cont) (ids : List InstId)
    (hmem : s ∈ ids) (hlive : (w.st s).life = .alive)
    (hph : CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((ids.foldl (fun w i => failWaiter w dst i) w).st s).phase := by
  induction ids generalizing w with
  | nil => cases hmem
  | cons i ids ih =>
    simp only [List.foldl_cons] at hmem ⊢
    by_cases hs : s = i
    · subst hs
      exact failFold_keeps_gone (failWaiter w dst s) dst s dst k ids
        (failWaiter_drops_call w s dst k hlive hph)
    · have hact := failWaiter_other w dst i s hs
      have hmem' : s ∈ ids := by
        rcases List.mem_cons.mp hmem with h | hmem
        · exact absurd h hs
        · exact hmem
      exact ih _ hmem' (by rw [congrArg (fun a => a.life) hact]; exact hlive)
        (by rw [congrArg (fun a => a.phase) hact]; exact hph)

theorem resume_false_gone (a : Actor) (dst0 dst : InstId) (k : Cont)
    (h : ¬CallPhase dst k a.phase) : ¬CallPhase dst k (resumeSender a false dst0).phase := by
  cases hph : a.phase with
  | parked _ _ ck =>
    simpa [resumeSender, hph] using proceed_not_callphase a ck k dst
  | idle => simpa [resumeSender, hph, CallPhase] using h
  | run _ => simpa [resumeSender, hph, CallPhase] using h
  | awaitReply _ _ => simpa [resumeSender, hph, CallPhase] using h
  | awaitEffect _ => simpa [resumeSender, hph, CallPhase] using h
  | awaitPeer _ => simpa [resumeSender, hph, CallPhase] using h
  | crashed => simpa [resumeSender, hph, CallPhase] using h

theorem releaseParked_keeps_gone (w : World) (id s dst : InstId) (ps : List Parked) (k : Cont)
    (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((releaseParked w id ps).st s).phase := by
  induction ps generalizing w with
  | nil => simpa [releaseParked] using h
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih _ h
    · rw [if_neg hskip]
      by_cases hs : s = p.sender
      · have hph : ¬CallPhase dst k (resumeSender (w.st p.sender) false id).phase :=
          resume_false_gone (w.st p.sender) id dst k (by rw [hs] at h; exact h)
        exact ih _ (by rw [hs]; simpa [setActor] using hph)
      · exact ih _ (by simpa [setActor, hs] using h)

theorem releaseWorld_keeps_gone (D : Description) (w : World) (id s dst : InstId) (a : Actor)
    (k : Cont) (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((releaseWorld D w id a).st s).phase := by
  by_cases hs : s = id
  · intro hbad
    exact releaseWorld_victim_not_wait D w id a (by rw [hs] at hbad; exact call_is_wait dst k _ hbad)
  · let base := refundParked (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked
    let deadA : Actor :=
      { base.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
    have hphB : (base.st s).phase = (w.st s).phase := by
      have hread := congrArg (fun a => a.phase) (readCells_st D w id s)
      have href := (refund_life (readCells D w id) (tname id) a.box s).2.2.1
      have hrefp :=
        (refundP_life (refundMsgs (readCells D w id) (tname id) a.box) (tname id) a.parked s).2.2.1
      simp [base, hread, href, hrefp]
    have hset : ((setActor base id deadA).st s).phase = (base.st s).phase := by simp [setActor, hs]
    have hstep : releaseWorld D w id a = releaseParked (setActor base id deadA) id a.parked := by
      simp [releaseWorld, base, deadA]
    rw [hstep]
    exact releaseParked_keeps_gone _ id s dst a.parked k (by rw [hset, hphB]; exact h)

theorem admit_keeps_gone (w : World) (dead s dst : InstId) (k : Cont)
    (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((admitDead w dead).st s).phase := by
  intro hbad
  rw [(admitDead_phase w dead s).1] at hbad
  exact h hbad

theorem abort_keeps_gone (D : Description) (w : World) (id s dst : InstId) (a : Actor) (k : Cont)
    (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((abortActor D w id a).st s).phase := by
  have hrel := releaseWorld_keeps_gone D w id s dst a k h
  have hfail := failFold_keeps_gone (releaseWorld D w id a) id s dst k
    (releaseWorld D w id a).roster (by simpa [failWaiters] using hrel)
  have hadmit := admit_keeps_gone (failWaiters (releaseWorld D w id a) id) id s dst k
    (by simpa [failWaiters] using hfail)
  simpa [abortActor] using hadmit

theorem abort_drops_self (D : Description) (w : World) (id s dst : InstId) (a : Actor) (k : Cont)
    (hs : s = id) : ¬CallPhase dst k ((abortActor D w id a).st s).phase := by
  rw [hs]
  simp [CallPhase, (abort_self D w id a).2]

theorem abort_drops_call (D : Description) (w : World) (a : Actor) (s dst : InstId) (k : Cont)
    (hsd : s ≠ dst) (hmem : s ∈ w.roster) (hlive : (w.st s).life = .alive)
    (hph : CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((abortActor D w dst a).st s).phase := by
  have hmemR : s ∈ (releaseWorld D w dst a).roster := by rw [releaseWorld_roster]; exact hmem
  have hliveR : ((releaseWorld D w dst a).st s).life = .alive :=
    (releaseWorld_other_life D w dst s a hsd).trans hlive
  by_cases hstill : CallPhase dst k (((releaseWorld D w dst a).st s).phase)
  · have hgone := failFold_drops_call (releaseWorld D w dst a) dst s k
      (releaseWorld D w dst a).roster hmemR hliveR hstill
    intro hbad
    simp only [abortActor] at hbad
    rw [(admitDead_phase (failWaiters (releaseWorld D w dst a) dst) dst s).1] at hbad
    exact hgone hbad
  · have hgone := failFold_keeps_gone (releaseWorld D w dst a) dst s dst k
      (releaseWorld D w dst a).roster hstill
    intro hbad
    simp only [abortActor] at hbad
    rw [(admitDead_phase (failWaiters (releaseWorld D w dst a) dst) dst s).1] at hbad
    exact hgone hbad

theorem abortDesc_keeps_gone (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (k : Cont) (h : ¬CallPhase dst k ((w.st s).phase)) :
    ¬CallPhase dst k ((abortDesc fuel D w parent).st s).phase := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using h
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World), ¬CallPhase dst k ((w0.st s).phase) →
        ¬CallPhase dst k ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).phase by
      exact this w.roster w h
    intro ids
    induction ids with
    | nil => intro w0 h0; simpa using h0
    | cons c ids ihf =>
      intro w0 h0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        exact ihf _ (abort_keeps_gone D (abortDesc fuel D w0 c) c s dst
          ((abortDesc fuel D w0 c).st c) k (ih w0 c h0))
      · rw [if_neg hgo]
        exact ihf w0 h0

theorem descFold_keeps_gone (fuel : Nat) (D : Description) (parent s dst : InstId) (k : Cont)
    (ids : List InstId) (w0 : World) (h : ¬CallPhase dst k ((w0.st s).phase)) :
    ¬CallPhase dst k ((ids.foldl (fun w child =>
      if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
        let w := abortDesc fuel D w child
        abortActor D w child (w.st child)
      else w) w0).st s).phase := by
  induction ids generalizing w0 with
  | nil => simpa using h
  | cons c ids ih =>
    simp only [List.foldl_cons]
    by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
    · rw [if_pos hgo]
      exact ih _ (abort_keeps_gone D (abortDesc fuel D w0 c) c s dst
        ((abortDesc fuel D w0 c).st c) k (abortDesc_keeps_gone fuel D w0 c s dst k h))
    · rw [if_neg hgo]
      exact ih w0 h

/-- Aborting the callee, or the caller, drops a live call. A surviving call was
already a call, and neither of those actors was the one aborted. -/
theorem abort_call_alive (D : Description) (w : World) (id : InstId) (a : Actor) (s dst : InstId)
    (k : Cont) (hsd : s ≠ dst) (hmem : s ∈ w.roster) (hlive : (w.st s).life = .alive)
    (hph : CallPhase dst k ((w.st s).phase))
    (hpost : CallPhase dst k ((abortActor D w id a).st s).phase) :
    id ≠ dst ∧ id ≠ s ∧ ((abortActor D w id a).st dst).life = (w.st dst).life ∧
      ((abortActor D w id a).st s).life = .alive := by
  have hneD : id ≠ dst := by
    intro heq
    subst heq
    exact abort_drops_call D w a s id k hsd hmem hlive hph hpost
  have hneS : id ≠ s := by
    intro heq
    exact abort_drops_self D w id s dst a k heq.symm hpost
  refine ⟨hneD, hneS, abortActor_other_life D w id dst a hneD.symm, ?_⟩
  exact (abortActor_other_life D w id s a hneS.symm).trans hlive

theorem abortDesc_call_life (fuel : Nat) (D : Description) (w : World) (parent s dst : InstId)
    (k : Cont) (hsd : s ≠ dst) (hmem : s ∈ w.roster) (hlive : (w.st s).life = .alive)
    (hph : CallPhase dst k ((w.st s).phase))
    (hpost : CallPhase dst k ((abortDesc fuel D w parent).st s).phase) :
    ((abortDesc fuel D w parent).st dst).life = (w.st dst).life ∧
      ((abortDesc fuel D w parent).st s).life = .alive := by
  induction fuel generalizing w parent with
  | zero =>
    simp [abortDesc]
    exact hlive
  | succ fuel ih =>
    simp only [abortDesc] at hpost ⊢
    suffices ∀ (ids : List InstId) (w0 : World), s ∈ w0.roster → (w0.st s).life = .alive →
        CallPhase dst k ((w0.st s).phase) →
        CallPhase dst k ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).phase →
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st dst).life = (w0.st dst).life ∧
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st s).life = .alive by
      exact this w.roster w hmem hlive hph hpost
    intro ids
    induction ids with
    | nil =>
      intro w0 _ hl0 _ _
      simp
      exact hl0
    | cons c ids ihf =>
      intro w0 hmem0 hl0 hph0 hpost0
      simp only [List.foldl_cons] at hpost0 ⊢
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo] at hpost0 ⊢
        have hph2 : CallPhase dst k ((abortActor D (abortDesc fuel D w0 c) c
            ((abortDesc fuel D w0 c).st c)).st s).phase := by
          by_cases hgone : CallPhase dst k ((abortActor D (abortDesc fuel D w0 c) c
              ((abortDesc fuel D w0 c).st c)).st s).phase
          · exact hgone
          · exact absurd hpost0 (descFold_keeps_gone fuel D parent s dst k ids
              (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c)) hgone)
        have hph1 : CallPhase dst k (((abortDesc fuel D w0 c).st s).phase) := by
          by_cases hgone : CallPhase dst k (((abortDesc fuel D w0 c).st s).phase)
          · exact hgone
          · exact absurd hph2 (abort_keeps_gone D (abortDesc fuel D w0 c) c s dst
              ((abortDesc fuel D w0 c).st c) k hgone)
        have hrec := ih w0 c hmem0 hl0 hph0 hph1
        have hstep := abort_call_alive D (abortDesc fuel D w0 c) c
          ((abortDesc fuel D w0 c).st c) s dst k hsd
          (by rw [abortDesc_roster]; exact hmem0) hrec.2 hph1 hph2
        have htail := ihf (abortActor D (abortDesc fuel D w0 c) c
          ((abortDesc fuel D w0 c).st c))
          (by rw [abortActor_roster, abortDesc_roster]; exact hmem0) hstep.2.2.2 hph2 hpost0
        exact ⟨htail.1.trans (hstep.2.2.1.trans hrec.1), htail.2⟩
      · rw [if_neg hgo] at hpost0 ⊢
        exact ihf w0 hmem0 hl0 hph0 hpost0

/-- A caller who is still in `CallPhase` after `terminateStage` is waiting on a
callee whose life did not change. -/
theorem terminate_call_life (D : Description) (w : World) (id s dst : InstId) (k : Cont)
    (hsd : s ≠ dst) (hmem : s ∈ w.roster) (hlive : (w.st s).life = .alive)
    (hph : CallPhase dst k ((w.st s).phase))
    (hpost : CallPhase dst k ((terminateStage D w id (w.st id)).st s).phase) :
    ((terminateStage D w id (w.st id)).st dst).life = (w.st dst).life := by
  simp only [terminateStage] at hpost ⊢
  have hph2 : CallPhase dst k ((abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)).st s).phase := by
    rw [enqueueTombstone_phase D (abortActor D (abortDesc w.roster.length D w id) id
      ((abortDesc w.roster.length D w id).st id)) id s] at hpost
    exact hpost
  have hph1 : CallPhase dst k (((abortDesc w.roster.length D w id).st s).phase) := by
    by_cases hgone : CallPhase dst k (((abortDesc w.roster.length D w id).st s).phase)
    · exact hgone
    · exact absurd hph2 (abort_keeps_gone D (abortDesc w.roster.length D w id) id s dst
        ((abortDesc w.roster.length D w id).st id) k hgone)
  have hrec := abortDesc_call_life w.roster.length D w id s dst k hsd hmem hlive hph hph1
  have hstep := abort_call_alive D (abortDesc w.roster.length D w id) id
    ((abortDesc w.roster.length D w id).st id) s dst k hsd
    (by rw [abortDesc_roster]; exact hmem) hrec.2 hph1 hph2
  exact (enqueueTombstone_life D _ id dst).trans (hstep.2.2.1.trans hrec.1)

theorem call_callee_step (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (a : Action) (w' : World) (s dst : InstId) (k : Cont)
    (h : apply I a w = some w') (hph : CallPhase dst k ((w.st s).phase))
    (hph' : CallPhase dst k ((w'.st s).phase))
    (halive : (w.st dst).life = .alive) : (w'.st dst).life = .alive := by
  cases Classical.em ((w'.st dst).life = .alive) with
  | inl h' => exact h'
  | inr hdead =>
    cases only_terminate_kills I a w w' dst h halive hdead with
    | inl hExecKill =>
      rcases hExecKill with ⟨_, _, _, t, _, _, ht, hsub, htm, _⟩
      rcases hph with hpark | hawait
      · have hnot := no_terminable_call_target I hL hG N w hR s dst k (Or.inl hpark) t ht
        cases hnot with
        | inl h => simp [htm] at h
        | inr hsame => simp [sameSubtree, templateSubtree, ht, hsub, bne] at hsame
      · have hnot := no_terminable_call_target I hL hG N w hR s dst k (Or.inr hawait) t ht
        cases hnot with
        | inl h => simp [htm] at h
        | inr hsame => simp [sameSubtree, templateSubtree, ht, hsub, bne] at hsame
    | inr hSubKill =>
      rcases hSubKill with ⟨who, _, _, _, _, _, _, hw, hwho⟩
      rw [hw] at hph' hdead hwho
      by_cases hsd : s = dst
      · rw [hsd] at hph'
        rcases hwho with hself | hchg
        · rw [hself] at hph'
          simp [CallPhase, (terminate_self I.desc w who
            ((inv_reachable I N w hL hR).forest).wf (hself ▸ halive)).2] at hph'
        · simp [CallPhase, (terminate_died_idle I.desc w who dst hchg).2] at hph'
      · have hls : (w.st s).life = .alive := wait_alive I hL N w hR s (by
          rcases hph with hpark | hawait
          · intro hidle
            rw [hpark] at hidle
            cases hidle
          · intro hidle
            rw [hawait] at hidle
            cases hidle) (by
          rcases hph with hpark | hawait
          · intro hcrash
            rw [hpark] at hcrash
            cases hcrash
          · intro hcrash
            rw [hawait] at hcrash
            cases hcrash)
        have hmem := (inv2_reachable I hL hG N w hR).2.1.aliveIn s hls
        have heq := terminate_call_life I.desc w who s dst k hsd hmem hls hph hph'
        exact absurd (heq.trans halive) hdead

theorem call_callee_alive (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : CallPhase dst k (((ρ.cfg i).st s).phase))
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.callReply dst))
    (halive : ((ρ.cfg i).st dst).life = .alive) :
    ((ρ.cfg (i + n)).st dst).life = .alive := by
  induction n with
  | zero => simpa using halive
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => hkind t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hphase := call_stays I hL ρ s dst k i n hph
      (fun t h1 h2 => hkind t h1 (Nat.le_trans h2 (Nat.le_succ _)))
    have hpost := call_stays I hL ρ s dst k i (n + 1) hph hkind
    exact call_callee_step I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))
      (ρ.act (i + n)) (ρ.cfg (i + n + 1)) s dst k (ρ.valid (i + n)) hphase hpost hprev

/-- A call keeps the caller's height, and the live callee stays strictly below it. -/
theorem call_height_below (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (s dst : InstId) (k : Cont) (i n : Nat)
    (hph : CallPhase dst k (((ρ.cfg i).st s).phase))
    (hkind : ∀ t, i ≤ t → t ≤ i + n → waitKind ((ρ.cfg t).st s) = some (.callReply dst))
    (halive : ((ρ.cfg i).st dst).life = .alive) :
    rankAt hs (ρ.cfg (i + n)) s = rankAt hs (ρ.cfg i) s ∧
      rankAt hs (ρ.cfg (i + n)) dst < rankAt hs (ρ.cfg i) s := by
  have hphn := call_stays I hL ρ s dst k i n hph hkind
  have hty := parked_typestate_stays I ρ s i n (fun t h1 h2 => by
    have hphase := call_stays I hL ρ s dst k i (t - i) hph (fun u hu1 hu2 =>
      hkind u hu1 (by
        have ht : i + (t - i) = t := Nat.add_sub_of_le h1
        omega))
    have hidx : i + (t - i) = t := Nat.add_sub_of_le h1
    have hhere : CallPhase dst k (((ρ.cfg t).st s).phase) := by simpa [hidx] using hphase
    rcases hhere with hpark | hawait
    · exact Or.inl ⟨dst, true, k, hpark⟩
    · exact Or.inr ⟨dst, k, hawait⟩)
  have hrank : rankAt hs (ρ.cfg (i + n)) s = rankAt hs (ρ.cfg i) s := by
    simp [rankAt, hty]
  have hlive := call_callee_alive I hL hG ρ s dst k i n hph hkind halive
  refine ⟨hrank, ?_⟩
  rw [← hrank]
  rcases hphn with hpark | hawait
  · have hO := (inv3_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).1.2.1
    simpa [rankAt] using call_below I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n)) s dst k
      hs hok hpark hlive
  · simpa [rankAt] using reply_below I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n)) s dst k
      hs hok hawait hlive

theorem untimed_peer_stays (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (x : InstId) (i n : Nat) (k : Cont)
    (hp : ((ρ.cfg i).st x).phase = .awaitPeer k) (hl : ((ρ.cfg i).st x).life = .alive)
    (hf : peerFinishable I.desc x = false) (halive : ∀ t, i ≤ t → ((ρ.cfg t).st x).life = .alive) :
    QuietKept (.awaitPeer k) ((ρ.cfg (i + n)).st x).phase := by
  -- `peerFinishable` is constantly true: every peer wait can finish.
  -- A hypothesis that it is false does not arise.
  simp [peerFinishable] at hf

/-- An actor that stays alive and is never stuck reaches idle. Blocks end, and each
ending step drops `phaseFuel`, including a call whose continuation was frozen. -/
theorem idle_when_free (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (hA : Assumptions I)
    {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (x : InstId) (i0 : Nat)
    (halive : ∀ t, i0 ≤ t → ((ρ.cfg t).st x).life = .alive)
    (hfree : ∀ t, i0 ≤ t → ¬Stuck ρ x t) :
    ∀ t, i0 ≤ t → ∃ j, t ≤ j ∧ Idle (ρ.cfg j) x := by
  suffices ∀ n t, i0 ≤ t → phaseFuel (((ρ.cfg t).st x).phase) ≤ n →
      ∃ j, t ≤ j ∧ Idle (ρ.cfg j) x by
    intro t ht
    exact this _ t ht (Nat.le_refl _)
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro t ht hfuel
    cases hph : ((ρ.cfg t).st x).phase with
    | idle => exact ⟨t, Nat.le_refl _, ⟨halive t ht, hph⟩⟩
    | crashed =>
      exact absurd hph (reachable_not_crashed I hL hG N (ρ.cfg t) (cfg_reachable ρ t) x)
    | awaitEffect k =>
      obtain ⟨j, k', hj, hphj, hrest, _, hproc, _⟩ := effect_resumes I hL hG hA ρ hF x t k hph (halive t ht)
        (fun u hu => halive u (Nat.le_trans ht hu))
      have hlt : phaseFuel (((ρ.cfg (j + 1)).st x).phase) < n := by
        have hdrop := finish_effect_drops ((ρ.cfg j).st x) k'
        rw [← hproc] at hdrop
        have hsame : phaseFuel (.awaitEffect k') = phaseFuel (.awaitEffect k) := by
          simp [phaseFuel, hrest]
        have hatj : phaseFuel (((ρ.cfg j).st x).phase) = phaseFuel (.awaitEffect k') := by
          simp [phaseFuel, hphj]
        have hati : phaseFuel (((ρ.cfg t).st x).phase) = phaseFuel (.awaitEffect k) := by
          simp [phaseFuel, hph]
        omega
      obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1)
        (Nat.le_trans ht (Nat.le_trans hj (Nat.le_succ j))) (Nat.le_refl _)
      exact ⟨j2, Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) hj2, hq⟩
    | awaitPeer k =>
      cases hf : peerFinishable I.desc x with
      | true =>
        obtain ⟨j, k', hj, hphj, hrest, _, honto, hlj, hstep⟩ :=
          peer_resumes I hL hG hA ρ hF x t k hph (halive t ht) hf
            (fun u hu => halive u (Nat.le_trans ht hu))
        have _ := hlj
        have hsame : phaseFuel (.awaitPeer k') = phaseFuel (.awaitPeer k) := by
          simp [phaseFuel, peerFuel, hrest, honto]
        have hatj : phaseFuel (((ρ.cfg j).st x).phase) = phaseFuel (.awaitPeer k') := by
          simp [phaseFuel, hphj]
        have hati : phaseFuel (((ρ.cfg t).st x).phase) = phaseFuel (.awaitPeer k) := by
          simp [phaseFuel, hph]
        rcases hstep with hproc | hto
        · have hlt : phaseFuel (((ρ.cfg (j + 1)).st x).phase) < n := by
            have hdrop := finish_peer_drops ((ρ.cfg j).st x) k'
            rw [← hproc] at hdrop
            omega
          obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1)
            (Nat.le_trans ht (Nat.le_trans hj (Nat.le_succ j))) (Nat.le_refl _)
          exact ⟨j2, Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) hj2, hq⟩
        · have hlt : phaseFuel (((ρ.cfg (j + 1)).st x).phase) < n := by
            have hdrop := timeout_peer_drops ((ρ.cfg j).st x) k'
            rw [← hto] at hdrop
            omega
          obtain ⟨j2, hj2, hq⟩ := ih _ hlt (j + 1)
            (Nat.le_trans ht (Nat.le_trans hj (Nat.le_succ j))) (Nat.le_refl _)
          exact ⟨j2, Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) hj2, hq⟩
      | false =>
        exact False.elim ((hfree t ht) ⟨⟨by simp [SameWait, waitKind, hph], by simp [waitKind, hph]⟩,
          fun j hj => by
            have hphj := untimed_peer_stays I hL hG ρ x t (j - t) k hph (halive t ht) hf
              (fun u hu => halive u (Nat.le_trans ht hu))
            have hidx : t + (j - t) = j := Nat.add_sub_of_le hj
            obtain ⟨k', hphj', _, _, _⟩ := quietKept_peer k _ (by simpa [hidx] using hphj)
            simp [SameWait, waitKind, hph, hphj']⟩)
    | run k =>
      have hhit : ∃ j, t ≤ j ∧ ρ.act j = .exec x := by
        cases Classical.em (∃ j, t ≤ j ∧ ρ.act j = .exec x) with
        | inl h => exact h
        | inr hmiss =>
          have hstay : ∀ u, t ≤ u → (∃ k', ((ρ.cfg u).st x).phase = .run k') ∧
              ((ρ.cfg u).st x).life = .alive := by
            intro u hu
            have hgot := run_holds hL hG ρ x t (u - t) k hph (halive t ht)
              (fun v hv _ => halive v (Nat.le_trans ht hv))
              (fun v h1 _ hbad => hmiss ⟨v, h1, hbad⟩)
            have hph' := by simpa [Nat.add_sub_of_le hu] using hgot
            refine ⟨?_, hph'.2⟩
            rcases hph'.1 with h | ⟨_, _, h⟩
            · exact ⟨k, h⟩
            · exact ⟨{k with replyTo := none}, h⟩
          exact False.elim (not_forever_run I hL hG ρ hF x t (fun j hj => (hstay j hj).2)
            (fun j hj => (hstay j hj).1))
      obtain ⟨j0, hj0, hact0⟩ := hhit
      have hscan := scanExec_spec ρ.act x (j0 - t) t ⟨j0 - t, Nat.le_refl _, by
        simpa [Nat.add_sub_of_le hj0] using hact0⟩
      let m := scanExec ρ.act x (j0 - t) t
      have him : t ≤ m := hscan.1
      have hact : ρ.act m = .exec x := hscan.2.1
      have hpre := run_holds hL hG ρ x t (m - t) k hph (halive t ht)
        (fun u hu _ => halive u (Nat.le_trans ht hu))
        (fun u h1 _ hbad => hscan.2.2 u h1 (by omega) hbad)
      obtain ⟨k0, hhere, hrest, _⟩ := runKept_view k _ (by
        simpa [Nat.add_sub_of_le him] using hpre.1)
      have hl' : ((ρ.cfg m).st x).life = .alive := by
        simpa [Nat.add_sub_of_le him] using hpre.2
      have hrun : execRun I (ρ.cfg m) x ((ρ.cfg m).st x) k0 = ρ.cfg (m + 1) := by
        have hstep := (apply_step I (ρ.act m) (ρ.cfg m) (ρ.cfg (m + 1)) (ρ.valid m)).2
        simp [stepWorld, hact, execHead, hl', hhere] at hstep
        exact hstep
      by_cases hempty : k0.rest = []
      · have hidle : ((ρ.cfg (m + 1)).st x).phase = .idle := by
          rw [← hrun]
          simp [execRun, hempty, setActor]
        exact ⟨m + 1, Nat.le_trans him (Nat.le_succ _),
          ⟨halive _ (Nat.le_trans ht (Nat.le_trans him (Nat.le_succ m))), hidle⟩⟩
      · have hdrop := exec_drops I hL hG N (ρ.cfg m) (cfg_reachable ρ m) x k0 hhere hl'
          (run_not_crashed ρ m) hempty
        rw [hrun] at hdrop
        have hlt : phaseFuel (((ρ.cfg (m + 1)).st x).phase) < n := by
          have hold : phaseFuel (((ρ.cfg m).st x).phase) ≤ n := by
            have hfuelM := runKept_fuel k _ (by simpa [Nat.add_sub_of_le him] using hpre.1)
            have hfuelI : phaseFuel (((ρ.cfg t).st x).phase) = phaseFuel (.run k) := by
              simp [phaseFuel, hph]
            simpa [hfuelM, hfuelI] using hfuel
          omega
        obtain ⟨j2, hj2, hq⟩ := ih _ hlt (m + 1)
          (Nat.le_trans ht (Nat.le_trans him (Nat.le_succ m))) (Nat.le_refl _)
        exact ⟨j2, Nat.le_trans (Nat.le_trans him (Nat.le_succ m)) hj2, hq⟩
    | parked dst c k =>
      have hkind0 : waitKind ((ρ.cfg t).st x) =
          some (if c then .callReply dst else .blockingSend dst) := by simp [waitKind, hph]
      have hex : ∃ j, t ≤ j ∧ waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x) := by
        cases Classical.em (∃ j, t ≤ j ∧
            waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x)) with
        | inl h => exact h
        | inr hno =>
          have hS : Stuck ρ x t := by
            refine ⟨⟨rfl, by simp [waitKind, hph]⟩, ?_⟩
            intro j hj
            have heq : waitKind ((ρ.cfg j).st x) = waitKind ((ρ.cfg t).st x) := by
              cases Classical.em (waitKind ((ρ.cfg j).st x) = waitKind ((ρ.cfg t).st x)) with
              | inl h => exact h
              | inr h => exact absurd h (fun hne => hno ⟨j, hj, hne⟩)
            exact ⟨heq.symm, by simp [waitKind, hph]⟩
          exact absurd hS (hfree t ht)
      obtain ⟨j0, hj0, hdiff0⟩ := hex
      obtain ⟨j, hj, hpj, hmin⟩ := earliest
        (fun j => t ≤ j ∧ waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x)) j0 t hj0
        ⟨hj0, hdiff0⟩
      obtain ⟨_, hdiff⟩ := hpj
      have hltj : t < j := by
        have hne : j ≠ t := by
          intro heq
          simp [heq, hkind0] at hdiff
        exact Nat.lt_of_le_of_ne hj (fun h => hne h.symm)
      cases c with
      | false =>
        have hbefore : ∀ u, t ≤ u → u < j →
            waitKind ((ρ.cfg u).st x) = some (.blockingSend dst) := by
          intro u hu1 hu2
          have hnot := hmin u hu1 hu2
          have heq : waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x) := by
            cases Classical.em (waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x)) with
            | inl h => exact h
            | inr h => exact absurd (And.intro hu1 h) hnot
          simpa [waitKind, hph] using heq
        have hdrop := send_drops_at I hL ρ x dst k t j hph hltj hbefore
          (by simpa [hkind0] using hdiff)
        have hlt : phaseFuel (((ρ.cfg j).st x).phase) < n := by
          have hold : phaseFuel (((ρ.cfg t).st x).phase) ≤ n := hfuel
          omega
        obtain ⟨j2, hj2, hq⟩ := ih _ hlt j (Nat.le_trans ht (Nat.le_of_lt hltj)) (Nat.le_refl _)
        exact ⟨j2, Nat.le_trans (Nat.le_of_lt hltj) hj2, hq⟩
      | true =>
        have hbeforeC : ∀ u, t ≤ u → u < j →
            waitKind ((ρ.cfg u).st x) = some (.callReply dst) := by
          intro u hu1 hu2
          have hnot := hmin u hu1 hu2
          have heq : waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x) := by
            cases Classical.em (waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x)) with
            | inl h => exact h
            | inr h => exact absurd (And.intro hu1 h) hnot
          simpa [hkind0] using heq
        have hdrop := call_drops_at I hL ρ x dst k t j (Or.inl hph) hltj hbeforeC
          (by simpa [hkind0] using hdiff)
        have hlt : phaseFuel (((ρ.cfg j).st x).phase) < n := by omega
        obtain ⟨j2, hj2, hq⟩ := ih _ hlt j (Nat.le_trans ht (Nat.le_of_lt hltj)) (Nat.le_refl _)
        exact ⟨j2, Nat.le_trans (Nat.le_of_lt hltj) hj2, hq⟩
    | awaitReply dst k =>
      have hkind0 : waitKind ((ρ.cfg t).st x) = some (.callReply dst) := by simp [waitKind, hph]
      have hex : ∃ j, t ≤ j ∧ waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x) := by
        cases Classical.em (∃ j, t ≤ j ∧
            waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x)) with
        | inl h => exact h
        | inr hno =>
          have hS : Stuck ρ x t := by
            refine ⟨⟨rfl, by simp [waitKind, hph]⟩, ?_⟩
            intro j hj
            have heq : waitKind ((ρ.cfg j).st x) = waitKind ((ρ.cfg t).st x) := by
              cases Classical.em (waitKind ((ρ.cfg j).st x) = waitKind ((ρ.cfg t).st x)) with
              | inl h => exact h
              | inr h => exact absurd h (fun hne => hno ⟨j, hj, hne⟩)
            exact ⟨heq.symm, by simp [waitKind, hph]⟩
          exact absurd hS (hfree t ht)
      obtain ⟨j0, hj0, hdiff0⟩ := hex
      obtain ⟨j, hj, hpj, hmin⟩ := earliest
        (fun j => t ≤ j ∧ waitKind ((ρ.cfg j).st x) ≠ waitKind ((ρ.cfg t).st x)) j0 t hj0
        ⟨hj0, hdiff0⟩
      obtain ⟨_, hdiff⟩ := hpj
      have hltj : t < j := by
        have hne : j ≠ t := by
          intro heq
          simp [heq, hkind0] at hdiff
        exact Nat.lt_of_le_of_ne hj (fun h => hne h.symm)
      have hbefore : ∀ u, t ≤ u → u < j → waitKind ((ρ.cfg u).st x) = some (.callReply dst) := by
        intro u hu1 hu2
        have hnot : ¬(t ≤ u ∧ waitKind ((ρ.cfg u).st x) ≠ waitKind ((ρ.cfg t).st x)) := hmin u hu1 hu2
        have heq : waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x) := by
          cases Classical.em (waitKind ((ρ.cfg u).st x) = waitKind ((ρ.cfg t).st x)) with
          | inl h => exact h
          | inr h => exact absurd (And.intro hu1 h) hnot
        simpa [hkind0] using heq
      have hdrop := call_drops_at I hL ρ x dst k t j (Or.inr hph) hltj hbefore
        (by simpa [hkind0] using hdiff)
      have hlt : phaseFuel (((ρ.cfg j).st x).phase) < n := by omega
      obtain ⟨j2, hj2, hq⟩ := ih _ hlt j (Nat.le_trans ht (Nat.le_of_lt hltj)) (Nat.le_refl _)
      exact ⟨j2, Nat.le_trans (Nat.le_of_lt hltj) hj2, hq⟩

/-- Idle, or stopped on a pure untimed peer. A finishable peer is not this end:
`finish` is enabled, and fairness takes it. -/
def Settled (D : Description) (w : World) (x : InstId) : Prop :=
  Idle w x ∨ ∃ k, (w.st x).phase = .awaitPeer k ∧ peerFinishable D x = false

theorem settled_partner_idle (I : Impl) (hG : GraphOk I.desc) (hL : LocalOk I) {N : Nat}
    (w : World) (hR : Reachable I N w) (src dst : InstId)
    (hwait : (∃ c k, (w.st src).phase = .parked dst c k) ∨
      (∃ k, (w.st src).phase = .awaitReply dst k))
    (hset : Settled I.desc w dst) : Idle w dst := by
  rcases hset with hId | ⟨_, hph, hf⟩
  · exact hId
  · have hfin := target_finishable I hG w (inv_reachable I N w hL hR) src dst hwait
    simp [hfin] at hf

/-- A blocking send does not last forever when every actor strictly below the sender
settles infinitely often while it remains below. The partner itself settles by
becoming idle: a pure untimed peer is not a legal target. -/
theorem send_stuck_false (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ)
    (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (s dst : InstId) (i : Nat) (hS : Stuck ρ s i)
    (hkind : waitKind ((ρ.cfg i).st s) = some (.blockingSend dst))
    (hlower : ∀ (t : Nat) (x : InstId), rankAt hs (ρ.cfg t) x < rankAt hs (ρ.cfg i) s →
      (∀ u, t ≤ u → ((ρ.cfg u).st x).life = .alive) →
      (∀ u, t ≤ u → rankAt hs (ρ.cfg u) x < rankAt hs (ρ.cfg i) s) →
      ∀ u, t ≤ u → ∃ j, u ≤ j ∧ Settled I.desc (ρ.cfg j) x) : False := by
  have hall : ∀ j, i ≤ j → waitKind ((ρ.cfg j).st s) = some (.blockingSend dst) := by
    intro j hj
    exact ((hkind.symm.trans (hS.2 j hj).1).symm)
  obtain ⟨k, hph⟩ := blocking_parked ((ρ.cfg i).st s) dst hkind
  have hstay : ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst false k := by
    intro t ht
    have hfreeze := blocking_stays I hL ρ s dst k i (t - i) hph
      (fun u hu1 _ => hall u hu1)
    exact ⟨k, by simpa [Nat.add_sub_of_le ht] using hfreeze⟩
  have hM := (inv_reachable I N (ρ.cfg i) hL (cfg_reachable ρ i)).2.1
  obtain ⟨p, hp, hps, _⟩ := hM.bwd s dst false k hph
  have hmail : ((ρ.cfg i).st dst).parked ≠ [] := by
    intro hempty
    simp [hempty] at hp
  have hl0 := mailbox_alive I hL N (ρ.cfg i) (cfg_reachable ρ i) dst hmail
  have halive := alive_while_send I hL hG ρ s dst i hstay hl0
  have hbelow : ∀ u, i ≤ u → rankAt hs (ρ.cfg u) dst < rankAt hs (ρ.cfg i) s := by
    intro u hu
    have hht := send_height_below I hL hG ρ hs hok s dst k i (u - i) hph
      (fun t ht1 _ => hall t ht1)
      (fun t ht1 _ => halive t ht1)
    simpa [Nat.add_sub_of_le hu] using hht.2
  have hset := hlower i dst (hbelow i (Nat.le_refl _)) halive hbelow
  have hidle : ∀ u, i ≤ u → ∃ j, u ≤ j ∧ Idle (ρ.cfg j) dst := by
    intro u hu
    obtain ⟨j, hj, hS⟩ := hset u hu
    have hjI : i ≤ j := Nat.le_trans hu hj
    obtain ⟨k', hk'⟩ := hstay j hjI
    exact ⟨j, hj, settled_partner_idle I hG hL (ρ.cfg j) (cfg_reachable ρ j) s dst
      (Or.inl ⟨false, k', hk'⟩) hS⟩
  have hcan : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk dst) := by
    intro t
    let u := max t i
    obtain ⟨j, hj, hId⟩ := hidle u (Nat.le_max_right _ _)
    have hj' : i ≤ j := Nat.le_trans (Nat.le_max_right t i) hj
    obtain ⟨k', hk'⟩ := hstay j hj'
    have hMj := (inv_reachable I N (ρ.cfg j) hL (cfg_reachable ρ j)).2.1
    obtain ⟨p', hp', _, _⟩ := hMj.bwd s dst false k' hk'
    have hbox : ((ρ.cfg j).st dst).parked ≠ [] := by
      intro hempty
      simp [hempty] at hp'
    exact ⟨j, Nat.le_trans (Nat.le_max_left _ _) hj,
      enabled_of_can I hL hG N _ (cfg_reachable ρ j) dst ⟨hId, Or.inr hbox⟩⟩
  have hidx := parkIndex_of_mem ((ρ.cfg i).st dst).parked s ⟨p, hp, hps⟩
  exact parked_forever_false I hL hG ρ hF s dst false (parkIndex ((ρ.cfg i).st dst).parked s) i
    hstay halive (Nat.le_refl _) hidx hcan

/-- A call that stays parked does not last forever when every actor strictly below
the caller stays idle infinitely often while it remains below. -/
theorem call_parked_stuck_false (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ)
    (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (s dst : InstId) (k : Cont) (i : Nat)
    (hph : ((ρ.cfg i).st s).phase = .parked dst true k)
    (hkind : ∀ j, i ≤ j → waitKind ((ρ.cfg j).st s) = some (.callReply dst))
    (hstay : ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst true k)
    (hlower : ∀ (t : Nat) (x : InstId), rankAt hs (ρ.cfg t) x < rankAt hs (ρ.cfg i) s →
      (∀ u, t ≤ u → ((ρ.cfg u).st x).life = .alive) →
      (∀ u, t ≤ u → rankAt hs (ρ.cfg u) x < rankAt hs (ρ.cfg i) s) →
      ∀ u, t ≤ u → ∃ j, u ≤ j ∧ Settled I.desc (ρ.cfg j) x) : False := by
  have hM := (inv_reachable I N (ρ.cfg i) hL (cfg_reachable ρ i)).2.1
  obtain ⟨p, hp, hps, _⟩ := hM.bwd s dst true k hph
  have hmail : ((ρ.cfg i).st dst).parked ≠ [] := by
    intro hempty
    simp [hempty] at hp
  have hl0 := mailbox_alive I hL N (ρ.cfg i) (cfg_reachable ρ i) dst hmail
  have halive : ∀ t, i ≤ t → ((ρ.cfg t).st dst).life = .alive := by
    intro t ht
    have hgot := call_callee_alive I hL hG ρ s dst k i (t - i) (Or.inl hph)
      (fun u hu1 _ => hkind u hu1) hl0
    simpa [Nat.add_sub_of_le ht] using hgot
  have hbelow : ∀ u, i ≤ u → rankAt hs (ρ.cfg u) dst < rankAt hs (ρ.cfg i) s := by
    intro u hu
    have hht := call_height_below I hL hG ρ hs hok s dst k i (u - i) (Or.inl hph)
      (fun t ht1 _ => hkind t ht1) hl0
    simpa [Nat.add_sub_of_le hu] using hht.2
  have hset := hlower i dst (hbelow i (Nat.le_refl _)) halive hbelow
  have hidle : ∀ u, i ≤ u → ∃ j, u ≤ j ∧ Idle (ρ.cfg j) dst := by
    intro u hu
    obtain ⟨j, hj, hS⟩ := hset u hu
    have hjI : i ≤ j := Nat.le_trans hu hj
    obtain ⟨k', hk'⟩ := hstay j hjI
    exact ⟨j, hj, settled_partner_idle I hG hL (ρ.cfg j) (cfg_reachable ρ j) s dst
      (Or.inl ⟨true, k', hk'⟩) hS⟩
  have hcan : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk dst) := by
    intro t
    let u := max t i
    obtain ⟨j, hj, hId⟩ := hidle u (Nat.le_max_right _ _)
    have hj' : i ≤ j := Nat.le_trans (Nat.le_max_right t i) hj
    obtain ⟨k', hk'⟩ := hstay j hj'
    have hMj := (inv_reachable I N (ρ.cfg j) hL (cfg_reachable ρ j)).2.1
    obtain ⟨p', hp', _, _⟩ := hMj.bwd s dst true k' hk'
    have hbox : ((ρ.cfg j).st dst).parked ≠ [] := by
      intro hempty
      simp [hempty] at hp'
    exact ⟨j, Nat.le_trans (Nat.le_max_left _ _) hj,
      enabled_of_can I hL hG N _ (cfg_reachable ρ j) dst ⟨hId, Or.inr hbox⟩⟩
  have hidx := parkIndex_of_mem ((ρ.cfg i).st dst).parked s ⟨p, hp, hps⟩
  exact parked_forever_false I hL hG ρ hF s dst true (parkIndex ((ρ.cfg i).st dst).parked s) i
    hstay halive (Nat.le_refl _) hidx hcan

/-- A stuck call is admitted. It cannot stay parked, so some later phase is
`awaitReply` on the same continuation, and it stays there while the kind lasts. -/
theorem call_admitted (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ)
    (hs : List (Node × Nat)) (hok : heightsOkB (residualEdges I.desc) hs = true)
    (s dst : InstId) (i : Nat) (hS : Stuck ρ s i)
    (hkind : waitKind ((ρ.cfg i).st s) = some (.callReply dst))
    (hlower : ∀ (t : Nat) (x : InstId), rankAt hs (ρ.cfg t) x < rankAt hs (ρ.cfg i) s →
      (∀ u, t ≤ u → ((ρ.cfg u).st x).life = .alive) →
      (∀ u, t ≤ u → rankAt hs (ρ.cfg u) x < rankAt hs (ρ.cfg i) s) →
      ∀ u, t ≤ u → ∃ j, u ≤ j ∧ Settled I.desc (ρ.cfg j) x) :
    ∃ j k, i ≤ j ∧ ((ρ.cfg j).st s).phase = .awaitReply dst k ∧
      ∀ t, j ≤ t → ((ρ.cfg t).st s).phase = .awaitReply dst k := by
  have hall : ∀ j, i ≤ j → waitKind ((ρ.cfg j).st s) = some (.callReply dst) := by
    intro j hj
    exact ((hkind.symm.trans (hS.2 j hj).1).symm)
  rcases call_parked_or_await ((ρ.cfg i).st s) dst hkind with ⟨k, hpark⟩ | ⟨k, hawait⟩
  · have hnot : ¬ ∀ t, i ≤ t → ∃ k, ((ρ.cfg t).st s).phase = .parked dst true k := by
      intro hstay
      exact call_parked_stuck_false I hL hG ρ hF hs hok s dst k i hpark hall hstay hlower
    have hex : ∃ t, i ≤ t ∧ ∀ k, ((ρ.cfg t).st s).phase ≠ .parked dst true k := by
      cases Classical.em (∃ t, i ≤ t ∧ ∀ k, ((ρ.cfg t).st s).phase ≠ .parked dst true k) with
      | inl h => exact h
      | inr hno =>
        exact False.elim (hnot (by
          intro t ht
          cases Classical.em (∃ k, ((ρ.cfg t).st s).phase = .parked dst true k) with
          | inl h => exact h
          | inr hnp =>
            exact absurd ⟨t, ht, fun k hk => hnp ⟨k, hk⟩⟩ hno))
    obtain ⟨t0, ht0, hnp⟩ := hex
    obtain ⟨t, ht, hpT, _⟩ := earliest
      (fun t => i ≤ t ∧ ∀ k, ((ρ.cfg t).st s).phase ≠ .parked dst true k) t0 i ht0 ⟨ht0, hnp⟩
    obtain ⟨_, hnpT⟩ := hpT
    have hphase := call_stays I hL ρ s dst k i (t - i) (Or.inl hpark)
      (fun u hu1 _ => hall u hu1)
    have hidx : i + (t - i) = t := Nat.add_sub_of_le ht
    have hhere : CallPhase dst k (((ρ.cfg t).st s).phase) := by simpa [hidx] using hphase
    have hawait : ((ρ.cfg t).st s).phase = .awaitReply dst k := by
      rcases hhere with hpk | haw
      · exact absurd hpk (hnpT k)
      · exact haw
    refine ⟨t, k, ht, hawait, ?_⟩
    intro u hu
    have hfreeze := await_stays I hL ρ s dst k t (u - t) hawait
      (fun v hv1 _ => hall v (Nat.le_trans ht hv1))
    simpa [Nat.add_sub_of_le hu] using hfreeze
  · refine ⟨i, k, Nat.le_refl _, hawait, ?_⟩
    intro u hu
    have hfreeze := await_stays I hL ρ s dst k i (u - i) hawait (fun v hv1 _ => hall v hv1)
    simpa [Nat.add_sub_of_le hu] using hfreeze


/-- That resume is not the same wait: a blocking send at the parked head is over. -/
theorem recv_clears_head_send (I : Impl) (w w' : World) (id : InstId)
    (h : receiveBulk I w id = some w') (p : Parked) (ps : List Parked)
    (hp : (w.st id).parked = p :: ps) (s : InstId) (hs : s = p.sender) (hne : s ≠ id)
    (k : Cont) (hph : (w.st s).phase = .parked id false k) (hc : p.isCall = false) :
    ¬ SameWait (w.st s) (w'.st s) := by
  intro hsame
  have hwas : waitKind (w.st s) = some (.blockingSend id) := by simp [waitKind, hph]
  have hnow := bulk_resumes_send I w w' id h p ps hp s hs hne k hph hc
  have heq := hsame.1
  simp [hwas, hnow] at heq

theorem replyCount_append (xs ys : List Eff) :
    replyCount (xs ++ ys) = replyCount xs + replyCount ys := by
  induction xs with
  | nil => simp [replyCount]
  | cons e es ih =>
    cases e <;> simp [replyCount, ih] <;> omega

theorem terminateBefore_of_head (pre es : List Eff) (hpre : replyCount pre = 0) :
    terminateBeforeReply (pre ++ (.terminate :: es)) = true := by
  induction pre with
  | nil => simp [terminateBeforeReply]
  | cons e rest ih =>
    cases e <;> simp [replyCount, terminateBeforeReply] at hpre ⊢ <;> exact ih hpre

/-- A checked program has one reply and no earlier `terminate`, or no reply at all. -/
theorem program_reply_count (I : Impl) (hL : LocalOk I) (tr : Transition) (hm : tr ∈ I.transitions)
    (t : Template) (ht : templateOf I.desc tr.template = some t) :
    (tr.acceptsCall = true ∧ replyCount tr.program = 1 ∧ terminateBeforeReply tr.program = false) ∨
      (tr.acceptsCall = false ∧ replyCount tr.program = 0) := by
  have hok := transitionOk_of_mem I hL tr hm
  cases hacc : tr.acceptsCall
  · simp only [transitionOk, ht, hacc] at hok
    repeat rw [Bool.and_eq_true] at hok
    exact Or.inr ⟨rfl, beq_iff_eq.mp hok.1.1.2⟩
  · refine Or.inl ⟨?_, (call_program_replies I hL tr hm hacc t ht).1,
      (call_program_replies I hL tr hm hacc t ht).2⟩
    rfl

theorem terminate_suffix_quiet (I : Impl) (hL : LocalOk I) (w : World) (hS : ProgSrc I w)
    (id : InstId) (es : List Eff) (hc : carried ((w.st id).phase) = some (.terminate :: es)) :
    replyCount (.terminate :: es) = 0 := by
  obtain ⟨tr, hm, hname, pre, hpre⟩ := hS id (.terminate :: es) hc
  obtain ⟨t, ht⟩ := src_template I hL w hS id _ hc
  have ht' : templateOf I.desc tr.template = some t := by simpa [hname] using ht
  rcases program_reply_count I hL tr hm t ht' with ⟨_, hcount, hbefore⟩ | ⟨_, hzero⟩
  · have happ := replyCount_append pre (.terminate :: es)
    rw [hpre] at happ
    by_cases hz : replyCount (.terminate :: es) = 0
    · exact hz
    · have hpre0 : replyCount pre = 0 := by
        have hpos : 0 < replyCount (.terminate :: es) := Nat.pos_of_ne_zero hz
        omega
      have hb := terminateBefore_of_head pre es hpre0
      rw [hpre] at hb
      simp [hb] at hbefore
  · have happ := replyCount_append pre (.terminate :: es)
    rw [hpre, hzero] at happ
    omega

theorem reply_head_one (I : Impl) (hL : LocalOk I) (w : World) (hS : ProgSrc I w) (id : InstId)
    (k : Cont) (es : List Eff) (hc : carried ((w.st id).phase) = some k.rest)
    (hrest : k.rest = .reply :: es) : replyCount k.rest = 1 := by
  obtain ⟨tr, hm, hname, pre, hpre⟩ := hS id k.rest hc
  obtain ⟨t, ht⟩ := src_template I hL w hS id _ hc
  have ht' : templateOf I.desc tr.template = some t := by simpa [hname] using ht
  rcases program_reply_count I hL tr hm t ht' with ⟨_, hcount, _⟩ | ⟨_, hzero⟩
  · have happ := replyCount_append pre k.rest
    rw [hpre, hcount, hrest] at happ
    simp [replyCount] at happ
    have hsum : replyCount pre + replyCount es = 0 :=
      Nat.add_right_cancel (by
        show replyCount pre + replyCount es + 1 = 0 + 1
        rw [Nat.add_assoc, Nat.zero_add]
        exact happ.symm)
    have hes : replyCount es = 0 := (Nat.eq_zero_of_add_eq_zero hsum).2
    rw [hrest]
    simp [replyCount, hes]
  · have happ := replyCount_append pre k.rest
    rw [hpre, hzero, hrest] at happ
    simp [replyCount] at happ

/-- A call cannot be sitting in a lone terminable actor's box. A subtree member may
hold a call from a sibling, and that call dies with the subtree. -/
theorem terminable_no_call_box (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (hT : CallTagInv w) (id : InstId) (t : Template)
    (ht : templateOf I.desc (tname id) = some t) (hterm : t.terminable = true)
    (hsub : t.subtree = "") (m : Msg)
    (hm : m ∈ (w.st id).box) : m.callFrom = none := by
  cases hc : m.callFrom with
  | none => rfl
  | some c =>
    obtain ⟨k, hph⟩ := box_awaits w hT id m c hm hc
    have hnot := no_terminable_call_target I hL hG N w hR c id k (Or.inr hph) t ht
    have hsame : sameSubtree I.desc (tname c) (tname id) = true := by simpa [hterm] using hnot
    have hempty : templateSubtree I.desc (tname id) = "" := by simp [templateSubtree, ht, hsub]
    simp [sameSubtree, hempty] at hsame

theorem parked_callfrom_none (w : World) (hT : CallTagInv w) (hM : MailInv w) (id : InstId)
    (p : Parked) (hp : p ∈ (w.st id).parked) (hc : p.isCall = false) : p.msg.callFrom = none := by
  cases hcf : p.msg.callFrom with
  | none => rfl
  | some s =>
    obtain ⟨hs, _, hk⟩ := (hT.parkFrom id p hp s).mp hcf
    obtain ⟨k2, hph⟩ := hM.fwd id p hp
    rw [hc] at hph
    rw [← hs, hph] at hk
    cases hk

theorem tag_of_read (D : Description) (w : World) (id : InstId) (hT : CallTagInv w) :
    CallTagInv (readCells D w id) := by
  apply call_tag_copy w (readCells D w id) hT
  intro i
  simp [readCells_st]

theorem tag_of_refund (w : World) (name : String) (ms : List Msg) (hT : CallTagInv w) :
    CallTagInv (refundMsgs w name ms) := by
  apply call_tag_copy w (refundMsgs w name ms) hT
  intro i
  exact ⟨(refund_life w name ms i).2.2.1, refund_box w name ms i, refund_park w name ms i,
    (refund_life w name ms i).2.2.2⟩

theorem tag_of_refundP (w : World) (name : String) (ps : List Parked) (hT : CallTagInv w) :
    CallTagInv (refundParked w name ps) := by
  apply call_tag_copy w (refundParked w name ps) hT
  intro i
  exact ⟨(refundP_life w name ps i).2.2.1, refundP_box w name ps i, refundP_park w name ps i,
    (refundP_life w name ps i).2.2.2⟩

/-- Killing a subtree does not change the call-relevant phase of an outsider.
A plain park on a live member becomes that continuation; every other outsider phase stays. -/
theorem outsider_view (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (sub : String) (key : Nat) (s : InstId)
    (hnot : isMember I.desc s sub key = false) :
    TagView (w.st s).phase ((killSubtree w I.desc sub key).st s).phase := by
  let D := I.desc
  let wK := killSubtree w D sub key
  have hS : SemInv I w := (inv_reachable I N w hL hR).1
  have hstable (hh : holdsPhase (w.st s).phase = true) :
      (wK.st s).phase = (w.st s).phase := by
    by_cases hl : (w.st s).life = .alive
    · by_cases hl' : (wK.st s).life = .alive
      · exact ((killSubtree_if_alive w D sub key s hl').2.2.2.2 hh).1
      · exact absurd (killSubtree_died w D sub key s hl hl').1
          (by simpa [Bool.not_eq_true] using hnot)
    · exact ((killSubtree_if_dead w D sub key s hl).2.2.2.2 hh).1
  cases hph : (w.st s).phase with
  | idle =>
    rw [hstable (by simp [holdsPhase, hph]), hph]
    exact tagView_refl _
  | run k =>
    rw [hstable (by simp [holdsPhase, hph]), hph]
    exact tagView_refl _
  | awaitEffect k =>
    rw [hstable (by simp [holdsPhase, hph]), hph]
    exact tagView_refl _
  | awaitPeer k =>
    rw [hstable (by simp [holdsPhase, hph]), hph]
    exact tagView_refl _
  | crashed =>
    rw [hstable (by simp [holdsPhase, hph]), hph]
    exact tagView_refl _
  | parked dst c k =>
    cases c with
    | true =>
      have hiff := call_member_iff I hL hG N w hR s dst k (Or.inl hph) sub key
      have hdst : isMember D dst sub key = false := by simpa [hnot] using hiff.symm
      have hnew := killFold_foreign_park w D sub key w.roster s dst true k hnot (Or.inl hdst) hph
      have hphK : (wK.st s).phase = .parked dst true k := by
        simpa [wK, killSubtree, killMembers] using hnew
      rw [hphK]
      exact tagView_refl _
    | false =>
      by_cases hm : isMember D dst sub key = true
      · by_cases hl : (w.st dst).life = .alive
        · have hls : (w.st s).life = .alive := wait_alive I hL N w hR s (by simp [hph]) (by simp [hph])
          have hs : s ∈ w.roster := hS.rostered s hls
          have hr : dst ∈ w.roster := hS.rostered dst hl
          have hres := killSubtree_plain_phase w D sub key s dst k hnot hs hls hph hm hl hr
          rw [hres]
          exact tagView_plain_resume dst k
        · have hnew := killFold_foreign_park w D sub key w.roster s dst false k hnot (Or.inr hl) hph
          have hphK : (wK.st s).phase = .parked dst false k := by
            simpa [wK, killSubtree, killMembers] using hnew
          rw [hphK]
          exact tagView_refl _
      · have hdst : isMember D dst sub key = false := by simpa [Bool.not_eq_true] using hm
        have hnew := killFold_foreign_park w D sub key w.roster s dst false k hnot (Or.inl hdst) hph
        have hphK : (wK.st s).phase = .parked dst false k := by
          simpa [wK, killSubtree, killMembers] using hnew
        rw [hphK]
        exact tagView_refl _
  | awaitReply dst k =>
    have hiff := call_member_iff I hL hG N w hR s dst k (Or.inr hph) sub key
    have hdstB : isMember D dst sub key = false := by simpa [hnot] using hiff.symm
    by_cases hl : (w.st dst).life = .alive
    · have hnew := killFold_foreign_await w D sub key w.roster s dst k hnot (Or.inl hdstB) hph
      have hphK : (wK.st s).phase = .awaitReply dst k := by
        simpa [wK, killSubtree, killMembers] using hnew
      rw [hphK]
      exact tagView_refl _
    · have hnew := killFold_foreign_await w D sub key w.roster s dst k hnot (Or.inr hl) hph
      have hphK : (wK.st s).phase = .awaitReply dst k := by
        simpa [wK, killSubtree, killMembers] using hnew
      rw [hphK]
      exact tagView_refl _

theorem countCall_le (ms ns : List Msg) (c : InstId) (h : ms.Sublist ns) :
    countCall ms c ≤ countCall ns c := by
  induction h with
  | slnil => simp [countCall]
  | cons _ _ ih =>
    simp only [countCall]
    exact Nat.le_trans ih (Nat.le_add_left _ _)
  | cons_cons _ _ ih =>
    simp only [countCall]
    omega

theorem countParked_le (ps qs : List Parked) (c : InstId) (h : ps.Sublist qs) :
    countParkedCall ps c ≤ countParkedCall qs c := by
  induction h with
  | slnil => simp [countParkedCall]
  | cons _ _ ih =>
    simp only [countParkedCall]
    exact Nat.le_trans ih (Nat.le_add_left _ _)
  | cons_cons _ _ ih =>
    simp only [countParkedCall]
    omega

theorem killOne_absent_box (w : World) (D : Description) (id host : InstId) (m : Msg)
    (habs : m ∉ (w.st host).box) : m ∉ ((killOne w D id).st host).box := by
  intro hmem
  by_cases hh : host = id
  · rw [hh, (killOne_self w D id).2.2.1] at hmem
    exact (List.not_mem_nil hmem).elim
  · rcases (killOne_other_rest w D id host hh).1 with heq | hfilt
    · exact habs (by simpa [heq] using hmem)
    · have hmem' : m ∈ (w.st host).box.filter (fun x => x.sender != id) := by
        rw [← hfilt]
        exact hmem
      exact habs (List.mem_filter.mp hmem').1

theorem killFold_absent_box (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (host : InstId) (m : Msg) (hhost : host ∈ w.roster)
    (habs : m ∉ (w.st host).box) :
    m ∉ ((ids.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st host).box := by
  induction ids generalizing w with
  | nil =>
    intro hmem
    exact habs (by simpa using hmem)
  | cons j ids ih =>
    intro hmem
    simp only [List.foldl_cons] at hmem
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true] at hmem
      exact ih (killOne w D j) (by rw [killOne_roster]; exact hhost)
        (killOne_absent_box w D j host m habs) hmem
    · simp only [hcond, ite_false] at hmem
      exact ih w hhost habs hmem

theorem killOne_drops_parked (w : World) (D : Description) (id host : InstId) (p : Parked)
    (hsend : p.sender = id) (hs : host ∈ w.roster) :
    p ∉ ((killOne w D id).st host).parked := by
  intro hmem
  by_cases hh : host = id
  · rw [hh, (killOne_self w D id).2.2.2.2] at hmem
    exact (List.not_mem_nil hmem).elim
  · rw [killOne_parked_eq w D id host hh hs] at hmem
    simp [bne, beq_iff_eq, hsend] at hmem

theorem killOne_absent_parked (w : World) (D : Description) (id host : InstId) (p : Parked)
    (habs : p ∉ (w.st host).parked) : p ∉ ((killOne w D id).st host).parked := by
  intro hmem
  by_cases hh : host = id
  · rw [hh, (killOne_self w D id).2.2.2.2] at hmem
    exact (List.not_mem_nil hmem).elim
  · rcases killOne_parked_fate w D id host hh with heq | hfilt
    · exact habs (by simpa [heq] using hmem)
    · have hmem' : p ∈ (w.st host).parked.filter (fun x => x.sender != id) := by
        rw [← hfilt]
        exact hmem
      exact habs (List.mem_filter.mp hmem').1

theorem killFold_absent_parked (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (host : InstId) (p : Parked) (habs : p ∉ (w.st host).parked) :
    p ∉ ((ids.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st host).parked := by
  induction ids generalizing w with
  | nil =>
    intro hmem
    exact habs (by simpa using hmem)
  | cons j ids ih =>
    intro hmem
    simp only [List.foldl_cons] at hmem
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true] at hmem
      exact ih (killOne w D j) (killOne_absent_parked w D j host p habs) hmem
    · simp only [hcond, ite_false] at hmem
      exact ih w habs hmem

/-- Mail from a live member does not survive the fold that kills that member. -/
theorem killFold_no_sender_box (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (host : InstId) (m : Msg) (hhost : host ∈ w.roster)
    (hsender : isMember D m.sender sub key = true) (hlive : (w.st m.sender).life = .alive)
    (hin : m.sender ∈ ids) :
    m ∉ ((ids.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st host).box := by
  induction ids generalizing w with
  | nil =>
    intro hmem
    cases hin
  | cons j ids ih =>
    intro hmem
    simp only [List.foldl_cons] at hmem
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true] at hmem
      by_cases hj : j = m.sender
      · have habs := killOne_drops_sender w D j host m (by rw [hj]) hhost
        exact killFold_absent_box (killOne w D j) D sub key ids host m
          (by rw [killOne_roster]; exact hhost) habs hmem
      · have hl' : ((killOne w D j).st m.sender).life = .alive :=
          ((killOne_other_rest w D j m.sender (Ne.symm hj)).2.2).trans hlive
        have hin' : m.sender ∈ ids := by
          simp [List.mem_cons] at hin
          rcases hin with h | hin
          · exact False.elim (hj h.symm)
          · exact hin
        exact ih (killOne w D j) (by rw [killOne_roster]; exact hhost) hl' hin' hmem
    · simp only [hcond, ite_false] at hmem
      have hin' : m.sender ∈ ids := by
        simp [List.mem_cons] at hin
        rcases hin with h | hin
        · have hgo : (isMember D m.sender sub key && (w.st m.sender).life == .alive) = true := by
            simp [hsender, hlive, beq_iff_eq]
          rw [h] at hgo
          simp [hgo] at hcond
        · exact hin
      exact ih w hhost hlive hin' hmem

theorem killFold_no_sender_parked (w : World) (D : Description) (sub : String) (key : Nat)
    (ids : List InstId) (host : InstId) (p : Parked) (hhost : host ∈ w.roster)
    (hsender : isMember D p.sender sub key = true) (hlive : (w.st p.sender).life = .alive)
    (hin : p.sender ∈ ids) :
    p ∉ ((ids.foldl (fun w id =>
      if isMember D id sub key && (w.st id).life == .alive then killOne w D id else w) w).st host).parked := by
  induction ids generalizing w with
  | nil =>
    intro hmem
    cases hin
  | cons j ids ih =>
    intro hmem
    simp only [List.foldl_cons] at hmem
    by_cases hcond : (isMember D j sub key && (w.st j).life == .alive) = true
    · simp only [hcond, ite_true] at hmem
      by_cases hj : j = p.sender
      · have habs := killOne_drops_parked w D j host p (by rw [hj]) hhost
        exact killFold_absent_parked (killOne w D j) D sub key ids host p habs hmem
      · have hl' : ((killOne w D j).st p.sender).life = .alive :=
          ((killOne_other_rest w D j p.sender (Ne.symm hj)).2.2).trans hlive
        have hin' : p.sender ∈ ids := by
          simp [List.mem_cons] at hin
          rcases hin with h | hin
          · exact False.elim (hj h.symm)
          · exact hin
        exact ih (killOne w D j) (by rw [killOne_roster]; exact hhost) hl' hin' hmem
    · simp only [hcond, ite_false] at hmem
      have hin' : p.sender ∈ ids := by
        simp [List.mem_cons] at hin
        rcases hin with h | hin
        · have hgo : (isMember D p.sender sub key && (w.st p.sender).life == .alive) = true := by
            simp [hsender, hlive, beq_iff_eq]
          rw [h] at hgo
          simp [hgo] at hcond
        · exact hin
      exact ih w hhost hlive hin' hmem

/-- A subtree kill preserves call tags. Members die together, so a call inside the
subtree leaves no survivor waiting. An outsider's call phase is `outsider_view`,
and mail that names an outsider stays. -/
theorem subtree_kill_tag (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (hT : CallTagInv w) (hown : BoxOwned w) (sub : String) (key : Nat) :
    CallTagInv (killSubtree w I.desc sub key) := by
  let D := I.desc
  let wK := killSubtree w D sub key
  have hS : SemInv I w := (inv_reachable I N w hL hR).1
  have hM : MailInv w := (inv_reachable I N w hL hR).2.1
  have hnotAlive (s : InstId) (hm : isMember D s sub key = true) (hl : (w.st s).life = .alive) :
      (wK.st s).phase = .idle ∧ (wK.st s).box = [] ∧ (wK.st s).parked = [] := by
    have hr := hS.rostered s hl
    have hk := killSubtree_kills w D sub key s hm hl hr
    exact ⟨hk.2.1, hk.2.2.1, hk.2.2.2.2⟩
  have hmailFwd (d c : InstId) (hm : mailCall wK d c) : mailCall w d c := by
    rcases hm with ⟨m, hmem, hc⟩ | ⟨p, hmem, hc⟩
    · exact Or.inl ⟨m, (killSubtree_box_sub w D sub key d).subset hmem, hc⟩
    · exact Or.inr ⟨p, (killSubtree_parked_sub w D sub key d).subset hmem, hc⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro c d k hph
    have hkeep := (killSubtree_keeps_wait w D sub key c (Or.inr ⟨d, k, by simpa [wK] using hph⟩)).1
    have hold : (w.st c).phase = .awaitReply d k := by
      exact hkeep.symm.trans (by simpa [wK] using hph)
    have hnotC : isMember D c sub key = false := by
      by_cases hm : isMember D c sub key = true
      · have hl := wait_alive I hL N w hR c (by simp [hold]) (by simp [hold])
        have hidle := (hnotAlive c hm hl).1
        have hbad : (wK.st c).phase = .awaitReply d k := by simpa [wK] using hph
        rw [hidle] at hbad
        cases hbad
      · simpa [Bool.not_eq_true] using hm
    have hnotD : isMember D d sub key = false := by
      exact (call_member_iff I hL hG N w hR c d k (Or.inr hold) sub key).trans hnotC
    have hv := outsider_view I hL hG N w hR sub key d hnotD
    have hback : mailCall w d c → mailCall wK d c := by
      intro hm
      rcases hm with ⟨m, hmem, hc⟩ | ⟨p, hmem, hc⟩
      · have hsnd := hown d m c hmem hc
        have hmem' := killFold_keeps_msg w D sub key w.roster d m hnotD
          (by simpa [hsnd] using hnotC) hmem
        exact Or.inl ⟨m, by simpa [wK, killSubtree, killMembers] using hmem', hc⟩
      · rcases (hT.parkFrom d p hmem c).mp hc with ⟨hsnd, _, _⟩
        have hlive : (w.st d).life = .alive := mailbox_alive I hL N w hR d (by
          intro hempty
          simp [hempty] at hmem)
        have hmem' := killFold_keeps_parked w D sub key w.roster d p hnotD
          (by simpa [hsnd] using hnotC) (hS.rostered d hlive) hmem
        exact Or.inr ⟨p, by simpa [wK, killSubtree, killMembers] using hmem', hc⟩
    have hmailIff : mailCall wK d c ↔ mailCall w d c := ⟨hmailFwd d c, hback⟩
    rcases hT.awaiting c d k hold with hmail | hhand | hpend | hdead
    · exact Or.inl ⟨hmailIff.mpr hmail.1,
        fun h => hmail.2.1 ((hv.2.2.1 c).mpr h),
        fun h => hmail.2.2 ((hv.2.2.2 c).mpr h)⟩
    · exact Or.inr (Or.inl ⟨fun h => hhand.1 (hmailIff.mp h),
        (hv.2.2.1 c).mp hhand.2.1,
        fun h => hhand.2.2 ((hv.2.2.2 c).mpr h)⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨fun h => hpend.1 (hmailIff.mp h),
        fun h => hpend.2.1 ((hv.2.2.1 c).mpr h),
        (hv.2.2.2 c).mp hpend.2.2⟩))
    · have hlC0 : (w.st c).life = .alive :=
        wait_alive I hL N w hR c (by rw [hold]; intro h; cases h) (by rw [hold]; intro h; cases h)
      have hlC : (wK.st c).life = .alive := by
        by_cases hgone : (wK.st c).life = .alive
        · exact hgone
        · exact absurd (killSubtree_died w D sub key c hlC0 hgone).1
            (by simpa [Bool.not_eq_true] using hnotC)
      have hlD : (wK.st d).life = .dead :=
        ((killSubtree_if_dead w D sub key d (by rw [hdead.1]; intro h; cases h)).1).trans hdead.1
      exact Or.inr (Or.inr (Or.inr ⟨hlD, hlC,
        fun h => hdead.2.2.1 (hmailIff.mp h),
        fun h => hdead.2.2.2.1 ((hv.2.2.1 c).mpr h),
        fun h => hdead.2.2.2.2 ((hv.2.2.2 c).mpr h)⟩))
  · intro c d k hph
    have hkeep := (killSubtree_keeps_wait w D sub key c (Or.inl ⟨d, true, k, by simpa [wK] using hph⟩)).1
    have hold : (w.st c).phase = .parked d true k := by
      exact hkeep.symm.trans (by simpa [wK] using hph)
    have hnotC : isMember D c sub key = false := by
      by_cases hm : isMember D c sub key = true
      · have hl := wait_alive I hL N w hR c (by simp [hold]) (by simp [hold])
        have hbad : (wK.st c).phase = .parked d true k := by simpa [wK] using hph
        rw [(hnotAlive c hm hl).1] at hbad
        cases hbad
      · simpa [Bool.not_eq_true] using hm
    have hnotD : isMember D d sub key = false := by
      exact (call_member_iff I hL hG N w hR c d k (Or.inl hold) sub key).trans hnotC
    have hv := outsider_view I hL hG N w hR sub key d hnotD
    have holdP := hT.parkedCall c d k hold
    have hback : mailCall w d c → mailCall wK d c := by
      intro hm
      rcases hm with ⟨m, hmem, hc⟩ | ⟨p, hmem, hc⟩
      · have hsnd := hown d m c hmem hc
        have hmem' := killFold_keeps_msg w D sub key w.roster d m hnotD
          (by simpa [hsnd] using hnotC) hmem
        exact Or.inl ⟨m, by simpa [wK, killSubtree, killMembers] using hmem', hc⟩
      · rcases (hT.parkFrom d p hmem c).mp hc with ⟨hsnd, _, _⟩
        have hlive : (w.st d).life = .alive := mailbox_alive I hL N w hR d (by
          intro hempty
          simp [hempty] at hmem)
        have hmem' := killFold_keeps_parked w D sub key w.roster d p hnotD
          (by simpa [hsnd] using hnotC) (hS.rostered d hlive) hmem
        exact Or.inr ⟨p, by simpa [wK, killSubtree, killMembers] using hmem', hc⟩
    exact ⟨hback holdP.1, fun h => holdP.2.1 ((hv.2.2.1 c).mpr h),
      fun h => holdP.2.2 ((hv.2.2.2 c).mpr h)⟩
  · intro d c hm
    have hold := hT.msgOwner d c (hmailFwd d c hm)
    have hOcc := (inv2_reachable I hL hG N w hR).2.1
    have hl : (w.st c).life = .alive := by
      rcases hold with ⟨_, hph⟩ | ⟨_, hph⟩
      · exact wait_alive I hL N w hR c (by simp [hph]) (by simp [hph])
      · exact wait_alive I hL N w hR c (by simp [hph]) (by simp [hph])
    have hnotC : isMember D c sub key = false := by
      by_cases hmC : isMember D c sub key = true
      · have hcin := hS.rostered c hl
        by_cases hd : d ∈ w.roster
        · rcases hm with ⟨m, hmem, hc⟩ | ⟨p, hmem, hc⟩
          · have hsnd := hown d m c ((killSubtree_box_sub w D sub key d).subset hmem) hc
            exact False.elim (killFold_no_sender_box w D sub key w.roster d m hd
              (by rw [hsnd]; exact hmC) (by rw [hsnd]; exact hl) (by rw [hsnd]; exact hcin)
              (by simpa [wK, killSubtree, killMembers] using hmem))
          · have hmem0 := (killSubtree_parked_sub w D sub key d).subset hmem
            obtain ⟨hsnd, _⟩ := (hT.parkFrom d p hmem0 c).mp hc
            exact False.elim (killFold_no_sender_parked w D sub key w.roster d p hd
              (by rw [hsnd]; exact hmC) (by rw [hsnd]; exact hl) (by rw [hsnd]; exact hcin)
              (by simpa [wK, killSubtree, killMembers] using hmem))
        · rcases hmailFwd d c hm with ⟨_, hmem, _⟩ | ⟨_, hmem, _⟩
          · exact False.elim (by simp [(hOcc.offEmpty d hd).1] at hmem)
          · exact False.elim (by simp [(hOcc.offEmpty d hd).2] at hmem)
      · simpa [Bool.not_eq_true] using hmC
    have hv := outsider_view I hL hG N w hR sub key c hnotC
    rcases hold with ⟨k, hph⟩ | ⟨k, hph⟩
    · exact Or.inl ⟨k, (hv.1 d k).mp hph⟩
    · exact Or.inr ⟨k, (hv.2.1 d k).mp hph⟩
  · intro d c ho
    have hO := (inv_reachable I N w hL hR).2.2
    have hSK := (killSubtree_inv I w sub key hS hM hO).1
    have hidleOw (hidle : (wK.st d).phase = .idle) : False := by
      rcases ho with h | h
      · obtain ⟨k, hk, _⟩ := h
        rw [hidle] at hk
        cases hk
      · obtain ⟨k, hk, _⟩ := h
        rw [hidle] at hk
        cases hk
    by_cases hl : (w.st d).life = .alive
    · by_cases hm : isMember D d sub key = true
      · exact False.elim (hidleOw (hnotAlive d hm hl).1)
      · have hnotD : isMember D d sub key = false := by simpa [Bool.not_eq_true] using hm
        have hv := outsider_view I hL hG N w hR sub key d hnotD
        have hold : handlerOwes c (w.st d).phase ∨ replyPending c (w.st d).phase := by
          rcases ho with h | h
          · exact Or.inl ((hv.2.2.1 c).mpr h)
          · exact Or.inr ((hv.2.2.2 c).mpr h)
        obtain ⟨k, hph⟩ := hT.oweOwner d c hold
        have hnotC : isMember D c sub key = false :=
          (call_member_iff I hL hG N w hR c d k (Or.inr hph) sub key).symm.trans hnotD
        exact ⟨k, ((outsider_view I hL hG N w hR sub key c hnotC).1 d k).mp hph⟩
    · have hlK : (wK.st d).life ≠ .alive := by
        intro hlK
        exact hl ((killSubtree_if_alive w D sub key d hlK).1)
      exact False.elim (hidleOw (hSK.idleOff d hlK))
  · intro id m hm
    rcases killSubtree_prio_step w D sub key id with heq | hempty
    · have hm' : m ∈ ((killSubtree w D sub key).st id).prio := by simpa [wK] using hm
      exact hT.prioPlain id m (heq ▸ hm')
    · have hm' : m ∈ ((killSubtree w D sub key).st id).prio := by simpa [wK] using hm
      simp [hempty] at hm'
  · intro d c
    have hbox := countCall_le _ _ c (killSubtree_box_sub w D sub key d)
    have hpark := countParked_le _ _ c (killSubtree_parked_sub w D sub key d)
    have hold := hT.sole d c
    have hsum : countCall (wK.st d).box c + countParkedCall (wK.st d).parked c ≤
        countCall (w.st d).box c + countParkedCall (w.st d).parked c := by
      simpa [wK] using Nat.add_le_add hbox hpark
    exact Nat.le_trans hsum hold
  · intro d p hp s
    have hp0 : p ∈ (w.st d).parked := (killSubtree_parked_sub w D sub key d).subset hp
    constructor
    · intro hc
      rcases (hT.parkFrom d p hp0 s).mp hc with ⟨hsnd, k, hph⟩
      have hnotS : isMember D s sub key = false := by
        by_cases hm : isMember D s sub key = true
        · have hl := wait_alive I hL N w hR s (by simp [hph]) (by simp [hph])
          have hOcc := (inv2_reachable I hL hG N w hR).2.1
          by_cases hd : d ∈ w.roster
          · exact False.elim (killFold_no_sender_parked w D sub key w.roster d p hd
              (by rw [hsnd]; exact hm) (by rw [hsnd]; exact hl) (by rw [hsnd]; exact hS.rostered s hl)
              (by simpa [wK, killSubtree, killMembers] using hp))
          · exact False.elim (by simp [(hOcc.offEmpty d hd).2] at hp0)
        · simpa [Bool.not_eq_true] using hm
      refine ⟨hsnd, k, ((outsider_view I hL hG N w hR sub key s hnotS).2.1 d k).mp hph⟩
    · intro ⟨hsnd, k, hph⟩
      have hnotS : isMember D s sub key = false := by
        by_cases hm : isMember D s sub key = true
        · have hbad : (wK.st s).phase = .parked d true k := by simpa [wK] using hph
          have hwait : isWait (wK.st s).phase := Or.inl ⟨d, true, k, hbad⟩
          have hold := ((killSubtree_keeps_wait w D sub key s hwait).1).symm.trans hbad
          have hl := wait_alive I hL N w hR s (by simp [hold]) (by simp [hold])
          rw [(hnotAlive s hm hl).1] at hbad
          cases hbad
        · simpa [Bool.not_eq_true] using hm
      have hold := ((outsider_view I hL hG N w hR sub key s hnotS).2.1 d k).mpr hph
      exact (hT.parkFrom d p hp0 s).mpr ⟨hsnd, k, hold⟩
  · intro c d k hph
    have hkeep := (killSubtree_keeps_wait w D sub key c (Or.inl ⟨d, true, k, by simpa [wK] using hph⟩)).1
    have hold : (w.st c).phase = .parked d true k := hkeep.symm.trans (by simpa [wK] using hph)
    have holdP := hT.parkedOnly c d k hold
    refine ⟨?_, ?_⟩
    · rcases holdP.1 with ⟨p, hp, hsnd, hc⟩
      have hnotC : isMember D c sub key = false := by
        by_cases hm : isMember D c sub key = true
        · have hl := wait_alive I hL N w hR c (by simp [hold]) (by simp [hold])
          have hbad : (wK.st c).phase = .parked d true k := by simpa [wK] using hph
          rw [(hnotAlive c hm hl).1] at hbad
          cases hbad
        · simpa [Bool.not_eq_true] using hm
      have hnotD : isMember D d sub key = false :=
        (call_member_iff I hL hG N w hR c d k (Or.inl hold) sub key).trans hnotC
      have hlive : (w.st d).life = .alive := mailbox_alive I hL N w hR d (by
        intro hempty
        simp [hempty] at hp)
      have hmem := killFold_keeps_parked w D sub key w.roster d p hnotD
        (by simpa [hsnd] using hnotC) (hS.rostered d hlive) hp
      exact ⟨p, by simpa [wK, killSubtree, killMembers] using hmem, hsnd, hc⟩
    · intro ⟨m, hm, hc⟩
      exact holdP.2 ⟨m, (killSubtree_box_sub w D sub key d).subset hm, hc⟩

/-- Killing `terminate`: the mailbox holds no call, the continuation owes no reply,
and plain parked senders are resumed. -/
private def tagBreakCaller : InstId := .core "caller"

private def tagBreakCallee : InstId := .core "callee"

private def tagBreakK : Cont := { rest := [], toState := "s", replyTo := none }

private def tagBreakMsg : Msg :=
  { label := "m", sender := tagBreakCaller, callFrom := some tagBreakCaller }

private def tagBreakActor (life : Life) (ph : Phase) (box : List Msg) : Actor where
  life := life
  typestate := "s"
  phase := ph
  box := box
  prio := []
  parked := []
  tokens := fun _ => 0

/-- Caller `c` is in `awaitReply` of callee `d`, and `d`'s box holds that call. -/
private def tagBreakWorld : World where
  N := 1
  roster := [tagBreakCaller, tagBreakCallee]
  nextIx := fun _ => 0
  st := fun i =>
    if i = tagBreakCaller then tagBreakActor .alive (.awaitReply tagBreakCallee tagBreakK) []
    else if i = tagBreakCallee then tagBreakActor .alive .idle [tagBreakMsg]
    else absentActor
  cell := fun _ _ => cleanCell
  observed := fun _ _ => 0

private theorem tagBreak_ne : tagBreakCaller ≠ tagBreakCallee := by
  decide

private theorem tagBreak_st_caller :
    (tagBreakWorld.st tagBreakCaller) = tagBreakActor .alive (.awaitReply tagBreakCallee tagBreakK) [] := by
  simp only [tagBreakWorld]
  split
  · rfl
  · rename_i h
    exact False.elim (h trivial)

private theorem tagBreak_st_callee :
    (tagBreakWorld.st tagBreakCallee) = tagBreakActor .alive .idle [tagBreakMsg] := by
  simp only [tagBreakWorld]
  split
  · rename_i h
    exact absurd h tagBreak_ne.symm
  · split
    · rfl
    · rename_i h
      exact False.elim (h trivial)

private theorem tagBreak_st_other (i : InstId) (hc : i ≠ tagBreakCaller) (hd : i ≠ tagBreakCallee) :
    tagBreakWorld.st i = absentActor := by
  simp only [tagBreakWorld]
  split
  · rename_i h
    exact absurd h hc
  · rfl

private theorem tagBreak_no_handler (i c : InstId) :
    ¬handlerOwes c (tagBreakWorld.st i).phase ∧ ¬replyPending c (tagBreakWorld.st i).phase := by
  by_cases hc : i = tagBreakCaller
  · subst hc
    rw [tagBreak_st_caller]
    refine ⟨?_, ?_⟩
    · intro ⟨k, hk, hs, _⟩
      simp [tagBreakActor, carriedCont] at hk
      subst hk
      simp [replyShape, tagBreakK] at hs
    · intro ⟨k, hk, hs, _⟩
      simp [tagBreakActor, carriedCont] at hk
      subst hk
      simp [replyShape, tagBreakK] at hs
  · by_cases hd : i = tagBreakCallee
    · subst hd
      rw [tagBreak_st_callee]
      refine ⟨?_, ?_⟩
      · intro ⟨_, hk, _⟩
        simp [tagBreakActor, carriedCont] at hk
      · intro ⟨_, hk, _⟩
        simp [tagBreakActor, carriedCont] at hk
    · rw [tagBreak_st_other i hc hd]
      refine ⟨?_, ?_⟩
      · intro ⟨_, hk, _⟩
        simp [absentActor, carriedCont] at hk
      · intro ⟨_, hk, _⟩
        simp [absentActor, carriedCont] at hk

private theorem tagBreak_mail (d c : InstId) :
    mailCall tagBreakWorld d c ↔ d = tagBreakCallee ∧ c = tagBreakCaller := by
  constructor
  · intro hm
    rcases hm with ⟨m, hmem, hc⟩ | ⟨p, hmem, _⟩
    · by_cases hd : d = tagBreakCallee
      · subst hd
        rw [tagBreak_st_callee] at hmem
        simp [tagBreakActor, tagBreakMsg] at hmem
        subst hmem
        simp [tagBreakMsg] at hc
        exact ⟨rfl, hc.symm⟩
      · by_cases hcaller : d = tagBreakCaller
        · rw [hcaller, tagBreak_st_caller] at hmem
          simp [tagBreakActor] at hmem
        · rw [tagBreak_st_other d hcaller hd] at hmem
          simp [absentActor] at hmem
    · by_cases hd : d = tagBreakCallee
      · rw [hd, tagBreak_st_callee] at hmem
        simp [tagBreakActor] at hmem
      · by_cases hcaller : d = tagBreakCaller
        · rw [hcaller, tagBreak_st_caller] at hmem
          simp [tagBreakActor] at hmem
        · rw [tagBreak_st_other d hcaller hd] at hmem
          simp [absentActor] at hmem
  · intro ⟨hd, hc⟩
    subst hd
    subst hc
    refine Or.inl ⟨tagBreakMsg, ?_, rfl⟩
    rw [tagBreak_st_callee]
    simp [tagBreakActor]

private def tagBreakDesc : Description where
  name := ""
  freshNames := false
  templates := []
  edges := []
  compatibility := .all
  steps := []

private def tagBreakDead (a : Actor) : Actor :=
  { a with life := .dead, phase := .idle, box := [], prio := [], parked := [] }

/-- Aborting the callee leaves the caller in `awaitReply` and the callee dead,
idle, and empty. `failWaiter` does not resume the caller. The three live-callee
cases fail on that world; the fourth `awaiting` disjunct is the one that holds,
because the caller stays alive and the deadline stays enabled. -/
theorem abort_await_not_tag :
    CallTagInv tagBreakWorld ∧
      ¬Awaiting3 (abortActor tagBreakDesc tagBreakWorld tagBreakCallee
        (tagBreakWorld.st tagBreakCallee)) := by
  refine ⟨?_, ?_⟩
  · refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro c d k hph
      by_cases hc : c = tagBreakCaller
      · subst hc
        rw [tagBreak_st_caller] at hph
        simp [tagBreakActor] at hph
        rcases hph with ⟨hd, hk⟩
        subst hd
        subst hk
        refine Or.inl ⟨(tagBreak_mail tagBreakCallee tagBreakCaller).mpr ⟨rfl, rfl⟩, ?_, ?_⟩
        · exact (tagBreak_no_handler tagBreakCallee tagBreakCaller).1
        · exact (tagBreak_no_handler tagBreakCallee tagBreakCaller).2
      · by_cases hd : c = tagBreakCallee
        · subst hd
          rw [tagBreak_st_callee] at hph
          simp [tagBreakActor] at hph
        · rw [tagBreak_st_other c hc hd] at hph
          simp [absentActor] at hph
    · intro c d k hph
      by_cases hc : c = tagBreakCaller
      · subst hc
        rw [tagBreak_st_caller] at hph
        simp [tagBreakActor] at hph
      · by_cases hd : c = tagBreakCallee
        · subst hd
          rw [tagBreak_st_callee] at hph
          simp [tagBreakActor] at hph
        · rw [tagBreak_st_other c hc hd] at hph
          simp [absentActor] at hph
    · intro d c hm
      rcases (tagBreak_mail d c).mp hm with ⟨hd, hc⟩
      subst hd
      subst hc
      exact Or.inl ⟨tagBreakK, by rw [tagBreak_st_caller]; rfl⟩
    · intro d c ho
      exact False.elim (ho.elim (tagBreak_no_handler d c).1 (tagBreak_no_handler d c).2)
    · intro id m hm
      by_cases hc : id = tagBreakCaller
      · subst hc
        rw [tagBreak_st_caller] at hm
        simp [tagBreakActor] at hm
      · by_cases hd : id = tagBreakCallee
        · subst hd
          rw [tagBreak_st_callee] at hm
          simp [tagBreakActor] at hm
        · rw [tagBreak_st_other id hc hd] at hm
          simp [absentActor] at hm
    · intro d c
      unfold soleCall
      by_cases hd : d = tagBreakCallee
      · subst hd
        rw [tagBreak_st_callee]
        by_cases hc : c = tagBreakCaller
        · subst hc
          simp [countCall, countParkedCall, tagBreakActor, tagBreakMsg]
        · have hc' : tagBreakCaller ≠ c := fun h => hc h.symm
          simp [countCall, countParkedCall, tagBreakActor, tagBreakMsg, hc']
      · by_cases hcaller : d = tagBreakCaller
        · subst hcaller
          rw [tagBreak_st_caller]
          simp [countCall, countParkedCall, tagBreakActor]
        · rw [tagBreak_st_other d hcaller hd]
          simp [countCall, countParkedCall, absentActor]
    · intro d p hp s
      by_cases hd : d = tagBreakCallee
      · subst hd
        rw [tagBreak_st_callee] at hp
        simp [tagBreakActor] at hp
      · by_cases hc : d = tagBreakCaller
        · subst hc
          rw [tagBreak_st_caller] at hp
          simp [tagBreakActor] at hp
        · rw [tagBreak_st_other d hc hd] at hp
          simp [absentActor] at hp
    · intro c d k hph
      by_cases hc : c = tagBreakCaller
      · subst hc
        rw [tagBreak_st_caller] at hph
        simp [tagBreakActor] at hph
      · by_cases hd : c = tagBreakCallee
        · subst hd
          rw [tagBreak_st_callee] at hph
          simp [tagBreakActor] at hph
        · rw [tagBreak_st_other c hc hd] at hph
          simp [absentActor] at hph
    · intro d c ho
      exact False.elim (ho.elim (tagBreak_no_handler d c).1 (tagBreak_no_handler d c).2)
  · intro hT
    let credited := creditSender tagBreakWorld (tname tagBreakCallee) tagBreakCaller
    have hcredit : credited.st tagBreakCallee = tagBreakWorld.st tagBreakCallee := by
      simpa [credited, creditSender] using
        setActor_other tagBreakWorld tagBreakCaller tagBreakCallee
          (bumpToken (tagBreakWorld.st tagBreakCaller) (tname tagBreakCallee) (.ofNat 1))
          tagBreak_ne.symm
    have hread : readCells tagBreakDesc tagBreakWorld tagBreakCallee = tagBreakWorld := by
      simp [readCells, cellLabels, tagBreakDesc, tname, tagBreakCallee]
    have hbox : (tagBreakWorld.st tagBreakCallee).box = [tagBreakMsg] := by
      simp [tagBreak_st_callee, tagBreakActor]
    have hpark0 : (tagBreakWorld.st tagBreakCallee).parked = [] := by
      simp [tagBreak_st_callee, tagBreakActor]
    have hrefund : refundMsgs tagBreakWorld (tname tagBreakCallee) [tagBreakMsg] = credited := by
      simp [refundMsgs, tagBreakMsg, credited]
    have hrel : releaseWorld tagBreakDesc tagBreakWorld tagBreakCallee
        (tagBreakWorld.st tagBreakCallee) =
        setActor credited tagBreakCallee (tagBreakDead (credited.st tagBreakCallee)) := by
      unfold releaseWorld
      simp only [hread, hbox, hpark0, hrefund, refundParked, releaseParked, List.foldl_nil,
        tagBreakDead]
    let wDead := setActor credited tagBreakCallee (tagBreakDead (credited.st tagBreakCallee))
    have hcredPhase : (credited.st tagBreakCaller).phase = .awaitReply tagBreakCallee tagBreakK := by
      simp [credited, creditSender, setActor, bumpToken, tagBreak_st_caller, tagBreakActor]
    have hcredLife : (credited.st tagBreakCaller).life = .alive := by
      simp [credited, creditSender, setActor, bumpToken, tagBreak_st_caller, tagBreakActor]
    have hcredPark : (credited.st tagBreakCaller).parked = [] := by
      simp [credited, creditSender, setActor, bumpToken, tagBreak_st_caller, tagBreakActor]
    have hcallerAct : wDead.st tagBreakCaller = credited.st tagBreakCaller := by
      simp [wDead]
      exact setActor_other credited tagBreakCallee tagBreakCaller _ tagBreak_ne
    have hcallerPhase : (wDead.st tagBreakCaller).phase = .awaitReply tagBreakCallee tagBreakK := by
      simp [hcallerAct, hcredPhase]
    have hcallerLife : (wDead.st tagBreakCaller).life = .alive := by
      simp [hcallerAct, hcredLife]
    have hcallerPark : (wDead.st tagBreakCaller).parked = [] := by
      simp [hcallerAct, hcredPark]
    have hcalPhase : (wDead.st tagBreakCallee).phase = .idle := by
      simp [wDead, setActor, tagBreakDead]
    have hcalBox : (wDead.st tagBreakCallee).box = [] := by
      simp [wDead, setActor, tagBreakDead]
    have hcalPark : (wDead.st tagBreakCallee).parked = [] := by
      simp [wDead, setActor, tagBreakDead]
    have hcalLife : (wDead.st tagBreakCallee).life = .dead := by
      simp [wDead, setActor, tagBreakDead]
    have hnotLive : ((wDead.st tagBreakCaller).life != .alive) = false := by
      simp [hcallerLife, bne]
    have hdeadBit : ((wDead.st tagBreakCallee).life != .alive) = true := by
      simp [hcalLife, bne]
    have hfailCaller : failWaiter wDead tagBreakCallee tagBreakCaller = wDead := by
      simp [failWaiter, hnotLive, hcallerPhase]
    have hfailCallee : failWaiter wDead tagBreakCallee tagBreakCallee = wDead := by
      simp [failWaiter, hdeadBit]
    have hroster : wDead.roster = [tagBreakCaller, tagBreakCallee] := by
      simp only [wDead, credited, setActor, creditSender, tagBreakWorld]
    have hfail : failWaiters wDead tagBreakCallee = wDead := by
      rw [failWaiters, hroster, List.foldl_cons, List.foldl_cons, List.foldl_nil, hfailCaller, hfailCallee]
    have hdiff : (tagBreakCaller == tagBreakCallee) = false := by
      simpa [beq_iff_eq] using tagBreak_ne
    have hsame : (tagBreakCallee == tagBreakCallee) = true := by simp
    have hhostCaller : admitHost wDead tagBreakCallee tagBreakCaller = wDead := by
      simp [admitHost, hdiff, hcallerPark]
    have hhostCallee : admitHost wDead tagBreakCallee tagBreakCallee = wDead := by
      simp [admitHost, hsame]
    have hadmit : admitDead wDead tagBreakCallee = wDead := by
      rw [admitDead, hroster, List.foldl_cons, List.foldl_cons, List.foldl_nil, hhostCaller, hhostCallee]
    have hw : abortActor tagBreakDesc tagBreakWorld tagBreakCallee
        (tagBreakWorld.st tagBreakCallee) = wDead := by
      simp [abortActor, hrel, wDead, hfail, hadmit]
    have hph : (wDead.st tagBreakCaller).phase = .awaitReply tagBreakCallee tagBreakK := hcallerPhase
    rw [hw] at hT
    rcases hT tagBreakCaller tagBreakCallee tagBreakK hph with
      ⟨hm, _, _⟩ | ⟨_, ho, _⟩ | ⟨_, _, hp⟩
    · rcases hm with ⟨m, hm, _⟩ | ⟨p, hp, _⟩
      · simp [hcalBox] at hm
      · simp [hcalPark] at hp
    · rcases ho with ⟨_, hk, _⟩
      simp [hcalPhase, carriedCont] at hk
    · rcases hp with ⟨_, hk, _⟩
      simp [hcalPhase, carriedCont] at hk

theorem terminate_tag (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (hT : CallTagInv w) (hown : BoxOwned w) (hM : MailInv w)
    (hS : ProgSrc I w) (hTerm : TermOk I w) (id : InstId) (k : Cont) (es : List Eff)
    (hph : (w.st id).phase = .run k) (hrest : k.rest = .terminate :: es) :
    CallTagInv (execRun I w id (w.st id) k) := by
  have hc : carried ((w.st id).phase) = some (.terminate :: es) := by simp [carried, hph, hrest]
  have hcount0 := terminate_suffix_quiet I hL w hS id es hc
  have hname := hTerm id (.terminate :: es) hc (by simp [hasTerminate])
  have hstep := exec_term_step I w id (w.st id) es k.toState k.replyTo
  have heq : execRun I w id (w.st id) k =
      execRun I w id (w.st id) ⟨.terminate :: es, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
    cases k
    simp at hrest
    rw [hrest]
  rw [heq]
  generalize hw : execRun I w id (w.st id) ⟨.terminate :: es, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ = wR at hstep ⊢
  cases hstep
  · exact hT
  · rename_i t ht hsub htm hpark hch
    have hparkF : hasParkedCall (w.st id).parked = false := hpark
    let base := refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box)
      (tname id) (w.st id).parked
    have hBase : CallTagInv base := by
      simpa [base] using tag_of_refundP _ (tname id) (w.st id).parked
        (tag_of_refund _ (tname id) (w.st id).box (tag_of_read I.desc w id hT))
    have hphB (i : InstId) : (base.st i).phase = (w.st i).phase := by
      simp [base, readCells_st, (refund_life _ _ _ _).2.2.1, (refundP_life _ _ _ _).2.2.1]
    have hboxB (i : InstId) : (base.st i).box = (w.st i).box := by
      simp [base, readCells_st, refund_box, refundP_box]
    have hparkB (i : InstId) : (base.st i).parked = (w.st i).parked := by
      simp [base, readCells_st, refund_park, refundP_park]
    have hquiet (c : InstId) : ¬handlerOwes c (base.st id).phase ∧ ¬replyPending c (base.st id).phase := by
      have hrun : (base.st id).phase = .run k := by rw [hphB, hph]
      constructor
      · intro ⟨k0, hk0, hs, _⟩
        simp [carriedCont, hrun] at hk0
        cases hk0
        exact not_shape_zero c k (by rw [hrest]; exact hcount0) hs
      · intro ⟨k0, hk0, hs, _⟩
        simp [carriedCont, hrun] at hk0
        cases hk0
        exact not_shape_zero c k (by rw [hrest]; exact hcount0) hs
    have hcallB : ∀ m, m ∈ (base.st id).box → m.callFrom = none := by
      intro m hm
      rw [hboxB] at hm
      exact terminable_no_call_box I hL hG N w hR hT id t ht htm hsub m hm
    have hplainP : ∀ p, p ∈ (w.st id).parked → p.isCall = false := by
      intro p hp
      have hall := by simpa [hasParkedCall, List.any_eq_false] using hparkF
      exact hall p hp
    have hcallP : ∀ p, p ∈ (base.st id).parked → p.msg.callFrom = none := by
      intro p hp
      rw [hparkB] at hp
      exact parked_callfrom_none w hT hM id p hp (hplainP p hp)
    have hClear := idle_clear_tag base id hBase
      (fun d kA hbad => by rw [hphB, hph] at hbad; cases hbad)
      (fun d kA hbad => by rw [hphB, hph] at hbad; cases hbad)
      hquiet hcallB hcallP
    let cleared := setActor base id { (base.st id) with phase := .idle, box := [], prio := [], parked := [] }
    let dead : Actor :=
      { (base.st id) with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
    have hDead : CallTagInv (setActor base id dead) := by
      apply call_tag_copy cleared (setActor base id dead) hClear
      intro i
      by_cases hi : i = id <;> simp [cleared, dead, setActor, hi]
    have hstep : ∀ p, p ∈ (w.st id).parked → p.isCall = false ∧
        (p.sender = id ∨ ∃ k, ((setActor base id dead).st p.sender).phase = .parked id false k) := by
      intro p hp
      refine ⟨hplainP p hp, Or.inr ?_⟩
      obtain ⟨kS, hphS⟩ := hM.fwd id p hp
      rw [hplainP p hp] at hphS
      have hne : p.sender ≠ id := by
        intro hs
        rw [hs, hph] at hphS
        cases hphS
      exact ⟨kS, by simp [setActor, hne, hphB, hphS]⟩
    have hrel := release_plain_tag (setActor base id dead) id (w.st id).parked hDead
      (fun p1 p2 h1 h2 heq => (hM.uniq id id p1 p2 h1 h2 heq).2)
      (hM.once id) hstep
    simpa [releaseWorld, base, dead] using hrel
  · rename_i t ht htm hdesc hpk
    -- A committing member aborts its own descendants and then itself. The
    -- parent's tombstone is a plain priority message, so the call tags of that
    -- enqueue follow from the world the aborts left.
    simp only [terminateStage]
    apply tombstone_tag I.desc _ id
    · -- `abort_await_not_tag`: an `awaitReply` caller of the aborted actor is left
      -- waiting, and `awaiting` has no dead-callee disjunct. Parked callers use
      -- the dead disjunct of `parkedCall`.
      skip

theorem exec_tag (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (hT : CallTagInv w) (hown : BoxOwned w) (id : InstId) (w' : World)
    (h : execHead I w id = some w') : CallTagInv w' := by
  have hM : MailInv w := (inv_reachable I N w hL hR).2.1
  have hS : ProgSrc I w := prog_src_reachable I N w hR
  have hLane : PrioDeclared I w := lane_reachable I hL hG N w hR
  have hTerm : TermOk I w := term_ok_reachable I hL N w hR
  unfold execHead at h
  by_cases hlive : (w.st id).life ≠ .alive
  · simp [hlive] at h
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
    | run k =>
      simp [hph] at h
      cases h
      cases hrest : k.rest with
      | nil =>
        simp [execRun, hrest]
        exact run_done_tag w id k hT hph hrest
      | cons e es =>
        cases e with
        | send dst label hint =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp only [hroute]
            exact callTag_note w id id dst (proceed (w.st id) (afterHead k))
              (run_tail_tag w id k (.send dst label hint) es hT hph hrest
                (by intro h; cases h) (by intro h; cases h))
          | some dstId =>
            simp
            exact enqueue_send_tag w I.desc id dstId
              { label := label, sender := id, callFrom := none } k (.send dst label hint) es hT hph
              hrest (by intro h; cases h) (by intro h; cases h) rfl
        | trySend dst label hint onFull onGone =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp only [hroute]
            exact callTag_note w id id dst (proceed (w.st id) (afterHead k))
              (run_tail_tag w id k (.trySend dst label hint onFull onGone) es hT hph hrest
                (by intro h; cases h) (by intro h; cases h))
          | some dstId =>
            simp
            split
            · exact enqueue_send_tag w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } k
                (.trySend dst label hint onFull onGone) es hT hph hrest (by intro h; cases h) (by intro h; cases h) rfl
            · exact run_tail_tag w id k (.trySend dst label hint onFull onGone) es hT hph hrest
                (by intro h; cases h) (by intro h; cases h)
        | call dst label hint na to =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp only [hroute]
            exact callTag_note w id id dst (proceed (w.st id) (afterHead k))
              (run_tail_tag w id k (.call dst label hint na to) es hT hph hrest
                (by intro h; cases h) (by intro h; cases h))
          | some dstId =>
            simp
            exact enqueue_call_tag w I.desc id dstId
              { label := label, sender := id, callFrom := some id } k (.call dst label hint na to) es hT hM
              hph hrest (by intro h; cases h) (by intro h; cases h) rfl
        | reply =>
          simp [execRun, hrest]
          have hcry : carried ((w.st id).phase) = some k.rest := by simp [carried, hph]
          exact reply_tag w id k es hT hph hrest (reply_head_one I hL w hS id k es hcry hrest)
        | selfSchedule label =>
          exact schedule_tag I w hT id k label es hph hrest (fun hfresh =>
            by
              obtain ⟨t, ht⟩ := src_template I hL w hS id (.selfSchedule label :: es)
                (by simp [carried, hph, hrest])
              exact lane_has_room I hL hG w.N w hLane id t ht label
                (sched_declared I w hS id _ (by simp [carried, hph, hrest]) label
                  (self_head_label label es)) hfresh)
        | cell dst label value =>
          simp [execRun, hrest]
          have hCell : CallTagInv (setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }) := by
            apply call_tag_copy w _ hT
            intro i
            simp [setCell]
          have hRun := run_tail_tag
            (setCell w dst label { value := max (w.cell dst label).value value, dirty := true })
            id k (.cell dst label value) es hCell (by simp [setCell, hph]) hrest
            (by intro h; cases h) (by intro h; cases h)
          by_cases hdirty : (w.cell dst label).dirty = true
          · simp [hdirty]
            exact hRun
          · simp [hdirty]
            exact wake_readers_tag I.desc _ dst label id (readersOf _ dst) hRun
        | internal =>
          simp [execRun, hrest]
          exact carry_step_tag w id k (.internal) es (.awaitEffect (afterHead k)) hT hph hrest
            (by intro h; cases h) (by intro h; cases h) (by simp [carriedCont])
            (by intro d kA hbad; cases hbad) (by intro d kA hbad; cases hbad)
        | peer onTimeout =>
          simp [execRun, hrest]
          exact carry_step_tag w id k ((.peer onTimeout)) es (.awaitPeer (afterHead k)) hT hph hrest
            (by intro h; cases h) (by intro h; cases h) (by simp [carriedCont])
            (by intro d kA hbad; cases hbad) (by intro d kA hbad; cases hbad)
        | terminate =>
          exact terminate_tag I hL hG N w hR hT hown hM hS hTerm id k es hph hrest

/-- A member that a kill may select: it is not in a call, nobody is in a call on it,
and its mailbox holds no call. -/
structure MemberQuiet (w : World) (id : InstId) : Prop where
  notCaller : ∀ callee k, ¬ CallWait (w.st id).phase callee k
  notTarget : ∀ caller k, ¬ CallWait (w.st caller).phase id k
  noBox : ∀ m, m ∈ (w.st id).box → m.callFrom = none
  noPark : ∀ p, p ∈ (w.st id).parked → p.msg.callFrom = none

/-- A reachable lone terminable is quiet: it never started a call, and no call names it.
A subtree member may call a sibling, so this does not apply there. -/
theorem reachable_member_quiet (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) (hT : CallTagInv w) (hM : MailInv w) (id : InstId)
    (hterm : loneTerminableName I.desc (tname id))
    (hcall : ∀ callee k, ¬ CallWait (w.st id).phase callee k) : MemberQuiet w id := by
  obtain ⟨t, ht, _hmul, htm, hsub⟩ := hterm
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro callee k h
    -- A lone terminable may call (DECISIONS 2026-11-22). Quiet is the extra fact.
    exact hcall callee k h
  · intro caller k h
    have hnot := no_terminable_call_target I hL hG N w hR caller id k h t ht
    have hsame : sameSubtree I.desc (tname caller) (tname id) = true := by simpa [htm] using hnot
    have hempty : templateSubtree I.desc (tname id) = "" := by simp [templateSubtree, ht, hsub]
    simp [sameSubtree, hempty] at hsame
  · intro m hm
    exact terminable_no_call_box I hL hG N w hR hT id t ht htm hsub m hm
  · intro p hp
    cases hcf : p.msg.callFrom with
    | none => rfl
    | some s =>
      obtain ⟨_hs, k, hk⟩ := (hT.parkFrom id p hp s).mp hcf
      have hnot := no_terminable_call_target I hL hG N w hR s id k (Or.inl hk) t ht
      have hsame : sameSubtree I.desc (tname s) (tname id) = true := by simpa [htm] using hnot
      have hempty : templateSubtree I.desc (tname id) = "" := by simp [templateSubtree, ht, hsub]
      simp [sameSubtree, hempty] at hsame

/-- Killing one quiet terminable member preserves call tags, and every quiet id stays quiet. -/
theorem killOne_tag (I : Impl) (hG : GraphOk I.desc) (w : World) (hT : CallTagInv w)
    (hO : OccInv I w) (sub : String) (key : Nat) (id : InstId)
    (hmem : isMember I.desc id sub key = true) (halive : (w.st id).life = .alive)
    (hQ : MemberQuiet w id)
    (hown : ∀ (i : InstId) (m : Msg) (c : InstId),
      m ∈ (w.st i).box → m.callFrom = some c → m.sender = c) :
    CallTagInv (killOne w I.desc id) ∧
      (∀ j, MemberQuiet w j → MemberQuiet (killOne w I.desc id) j) ∧
      ((killOne w I.desc id).st id).life = .dead ∧
      (∀ j, j ≠ id → ((killOne w I.desc id).st j).life = (w.st j).life) := by
  let D := I.desc
  have htermB := member_terminable D hG.subtrees id sub key hmem
  have hterm : terminableName D (tname id) := by
    cases ht : templateOf D (tname id) with
    | none => simp [terminableB, ht] at htermB
    | some t => exact ⟨t, ht, by simpa [terminableB, ht] using htermB⟩
  let w1 := readCells D w id
  let w2 := refundMsgs w1 (tname id) (w.st id).box
  let w3 := refundParked w2 (tname id) (w.st id).parked
  let w4 := failWaiters w3 id
  let w5 := forgetSender w4 id
  have hbody : killOne w D id =
      setActor w5 id { w5.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] } := by
    simp [killOne, w1, w2, w3, w4, w5, failWaiters, forgetSender]
  have hph3 (i : InstId) : (w3.st i).phase = (w.st i).phase := by
    have hp := (refundParked_phase_life w2 (tname id) (w.st id).parked i).1
    have hm := (refundMsgs_phase_life w1 (tname id) (w.st id).box i).1
    have hc := congrArg (·.phase) (readCells_st D w id i)
    simpa [w3, w2, w1] using hp.trans (hm.trans hc)
  have hbox3 (i : InstId) : (w3.st i).box = (w.st i).box := by
    have hp := refundP_box w2 (tname id) (w.st id).parked i
    have hm := refund_box w1 (tname id) (w.st id).box i
    have hc := congrArg (·.box) (readCells_st D w id i)
    simpa [w3, w2, w1] using hp.trans (hm.trans hc)
  have hpark3 (i : InstId) : (w3.st i).parked = (w.st i).parked := by
    have hp := refundP_park w2 (tname id) (w.st id).parked i
    have hm := refund_park w1 (tname id) (w.st id).box i
    have hc := congrArg (·.parked) (readCells_st D w id i)
    simpa [w3, w2, w1] using hp.trans (hm.trans hc)
  have hQ3 : MemberQuiet w3 id := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro callee k h
      exact hQ.notCaller callee k (by simpa [hph3 id] using h)
    · intro caller k h
      exact hQ.notTarget caller k (by simpa [hph3 caller] using h)
    · intro m hm
      exact hQ.noBox m (by simpa [hbox3 id] using hm)
    · intro p hp
      exact hQ.noPark p (by simpa [hpark3 id] using hp)
  have hT3 : CallTagInv w3 := by
    simpa [w3, w2, w1] using
      tag_of_refundP w2 (tname id) (w.st id).parked
        (tag_of_refund w1 (tname id) (w.st id).box (tag_of_read D w id hT))
  have hTF : CallTagInv w4 := by
    simpa [w4, failWaiters] using fail_plain_tag w3 id w3.roster hT3 hQ3.notTarget
  have hno4 : ∀ c k, ¬ CallWait (w4.st c).phase id k := by
    intro c k h
    exact hQ3.notTarget c k
      (failFold_call w3 id c id k w3.roster (by simpa [w4, failWaiters] using h))
  have hnotCaller4 : ∀ callee k, ¬ CallWait (w4.st id).phase callee k := by
    intro callee k h
    exact hQ3.notCaller callee k
      (failFold_call w3 id id callee k w3.roster (by simpa [w4, failWaiters] using h))
  have hmail4 (i : InstId) : (w4.st i).box = (w3.st i).box ∧ (w4.st i).parked = (w3.st i).parked := by
    have hm := failFold_mail w3 id i w3.roster
    exact ⟨by simpa [w4, failWaiters] using hm.1, by simpa [w4, failWaiters] using hm.2.2⟩
  have hnotA : ∀ d k, (w4.st id).phase ≠ .awaitReply d k := by
    intro d k hbad
    exact hnotCaller4 d k (Or.inr hbad)
  have hnotP : ∀ d k, (w4.st id).phase ≠ .parked d true k := by
    intro d k hbad
    exact hnotCaller4 d k (Or.inl hbad)
  have hquiet : ∀ c, ¬handlerOwes c (w4.st id).phase ∧ ¬replyPending c (w4.st id).phase := by
    intro c
    constructor
    · intro h
      obtain ⟨k, hk⟩ := hTF.oweOwner id c (Or.inl h)
      exact hno4 c k (Or.inr hk)
    · intro h
      obtain ⟨k, hk⟩ := hTF.oweOwner id c (Or.inr h)
      exact hno4 c k (Or.inr hk)
  have hcallB : ∀ m, m ∈ (w4.st id).box → m.callFrom = none := by
    intro m hm
    exact hQ3.noBox m (by simpa [(hmail4 id).1] using hm)
  have hcallP : ∀ p, p ∈ (w4.st id).parked → p.msg.callFrom = none := by
    intro p hp
    exact hQ3.noPark p (by simpa [(hmail4 id).2] using hp)
  have hplainB : ∀ i m, m ∈ (w4.st i).box → m.sender = id → m.callFrom = none := by
    intro i m hm hsnd
    cases hc : m.callFrom with
    | none => rfl
    | some c =>
      have hm0 : m ∈ (w.st i).box := by simpa [hbox3 i, (hmail4 i).1] using hm
      have hs := hown i m c hm0 hc
      have hid : c = id := hs.symm.trans hsnd
      have hmail : mailCall w i id := Or.inl ⟨m, hm0, by simpa [hid] using hc⟩
      rcases hT.msgOwner i id hmail with ⟨k, hk⟩ | ⟨k, hk⟩
      · exact False.elim (hQ.notCaller i k (Or.inr hk))
      · exact False.elim (hQ.notCaller i k (Or.inl hk))
  have hplainP : ∀ i p, p ∈ (w4.st i).parked → p.sender = id → p.msg.callFrom = none := by
    intro i p hp hsnd
    cases hc : p.msg.callFrom with
    | none => rfl
    | some c =>
      have hp0 : p ∈ (w.st i).parked := by simpa [hpark3 i, (hmail4 i).2] using hp
      rcases (hT.parkFrom i p hp0 c).mp hc with ⟨hs, k, hk⟩
      have hid : c = id := hs.symm.trans hsnd
      exact False.elim (hQ.notCaller i k (Or.inl (by simpa [hid] using hk)))
  have hT5 : CallTagInv w5 := by
    simpa [w5] using forget_plain_tag w4 id hTF hplainB hplainP
  have hph5 : (w5.st id).phase = (w4.st id).phase := (forget_stable w4 id id).1
  have hnotA5 : ∀ d k, (w5.st id).phase ≠ .awaitReply d k := by
    intro d k hbad
    exact hnotA d k (by simpa [hph5] using hbad)
  have hnotP5 : ∀ d k, (w5.st id).phase ≠ .parked d true k := by
    intro d k hbad
    exact hnotP d k (by simpa [hph5] using hbad)
  have hquiet5 : ∀ c, ¬handlerOwes c (w5.st id).phase ∧ ¬replyPending c (w5.st id).phase := by
    intro c
    simpa [handlerOwes, replyPending, hph5] using hquiet c
  have hcallB5 : ∀ m, m ∈ (w5.st id).box → m.callFrom = none := by
    intro m hm
    rcases forget_box_fate w4 id id with heq | hfilt
    · exact hcallB m (by simpa [w5, heq] using hm)
    · exact hcallB m (List.mem_filter.mp (hfilt ▸ hm)).1
  have hcallP5 : ∀ p, p ∈ (w5.st id).parked → p.msg.callFrom = none := by
    intro p hp
    rcases forget_parked_fate w4 id id with heq | hfilt
    · exact hcallP p (by simpa [w5, heq] using hp)
    · exact hcallP p (List.mem_filter.mp (hfilt ▸ hp)).1
  have hClear := idle_clear_tag w5 id hT5 hnotA5 hnotP5 hquiet5 hcallB5 hcallP5
  let cleared := setActor w5 id { (w5.st id) with phase := .idle, box := [], prio := [], parked := [] }
  let dead : Actor :=
    { (w5.st id) with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  have hDead : CallTagInv (setActor w5 id dead) := by
    apply call_tag_copy cleared (setActor w5 id dead) hClear
    intro i
    by_cases hi : i = id <;> simp [cleared, dead, setActor, hi]
  have htag : CallTagInv (killOne w D id) := by
    simpa [dead, hbody] using hDead
  refine ⟨htag, ?_, ?_, ?_⟩
  · intro j hQj
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro callee k h
      exact hQj.notCaller callee k (killOne_call w D id j callee k h)
    · intro caller k h
      exact hQj.notTarget caller k (killOne_call w D id caller j k h)
    · intro m hm
      by_cases hj : j = id
      · rw [hj, hbody] at hm
        simp [setActor, List.mem_nil_iff] at hm
      · rw [hbody] at hm
        have hset : m ∈ (w5.st j).box := by simpa [setActor, hj] using hm
        have hm4 : m ∈ (w4.st j).box := by
          rcases forget_box_fate w4 id j with heq | hfilt
          · simpa [w5, heq] using hset
          · exact (List.mem_filter.mp (hfilt ▸ hset)).1
        exact hQj.noBox m (by simpa [hbox3 j, (hmail4 j).1] using hm4)
    · intro p hp
      by_cases hj : j = id
      · rw [hj, hbody] at hp
        simp [setActor, List.mem_nil_iff] at hp
      · rw [hbody] at hp
        have hset : p ∈ (w5.st j).parked := by simpa [setActor, hj] using hp
        have hp4 : p ∈ (w4.st j).parked := by
          rcases forget_parked_fate w4 id j with heq | hfilt
          · simpa [w5, heq] using hset
          · exact (List.mem_filter.mp (hfilt ▸ hset)).1
        exact hQj.noPark p (by simpa [hpark3 j, (hmail4 j).2] using hp4)
  · rw [hbody]
    simp [setActor]
  · intro j hj
    rw [hbody]
    have hset : ((setActor w5 id
        { w5.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }).st j).life =
        (w5.st j).life := by simp [setActor, hj]
    rw [hset]
    have hlife5 : (w5.st j).life = (w4.st j).life := (forget_stable w4 id j).2.1
    rw [hlife5]
    have hf := failFold_life w3 id j w3.roster
    have hp := (refundParked_phase_life w2 (tname id) (w.st id).parked j).2
    have hm := (refundMsgs_phase_life w1 (tname id) (w.st id).box j).2
    have hc := congrArg (·.life) (readCells_st D w id j)
    simpa [w4, w3, w2, w1, failWaiters] using hf.trans (hp.trans (hm.trans hc))

theorem kill_fold_tag (I : Impl) (hG : GraphOk I.desc) (w : World) (sub : String) (key : Nat)
    (ids : List InstId) (hT : CallTagInv w) (hO : OccInv I w) (hS : SemInv I w) (hM : MailInv w)
    (hSlots : OpenSlots w)
    (hQ : ∀ j, isMember I.desc j sub key = true → (w.st j).life = .alive → MemberQuiet w j)
    (hown : ∀ (i : InstId) (m : Msg) (c : InstId),
      m ∈ (w.st i).box → m.callFrom = some c → m.sender = c) :
    CallTagInv (ids.foldl (fun w id =>
      if isMember I.desc id sub key && (w.st id).life == .alive then killOne w I.desc id else w) w) := by
  induction ids generalizing w with
  | nil => simpa using hT
  | cons id ids ih =>
    simp only [List.foldl_cons]
    split
    · next hcond =>
      have hparts := (Bool.and_eq_true _ _).mp hcond
      have halive : (w.st id).life = .alive := by simpa [beq_iff_eq] using hparts.2
      have hStep := killOne_tag I hG w hT hO sub key id hparts.1 halive (hQ id hparts.1 halive) hown
      have hOcc := occ_killOne I hG w sub key id hO hS hparts.1 halive
      have hInv := killOne_inv I w sub key id hS hM hSlots hparts.1 halive
      have hQ' : ∀ j, isMember I.desc j sub key = true →
          ((killOne w I.desc id).st j).life = .alive → MemberQuiet (killOne w I.desc id) j := by
        intro j hm hl
        by_cases hj : j = id
        · simp [hj, hStep.2.2.1] at hl
        · exact hStep.2.1 j (hQ j hm (by simpa [hStep.2.2.2 j hj] using hl))
      have hown' : ∀ i m c, m ∈ ((killOne w I.desc id).st i).box →
          m.callFrom = some c → m.sender = c := by
        intro i m c hm hc
        by_cases hi : i = id
        · rw [hi] at hm
          simp [(killOne_self w I.desc id).2.2.1] at hm
        · rcases (killOne_other_rest w I.desc id i hi).1 with heq | hfilt
          · exact hown i m c (by simpa [heq] using hm) hc
          · exact hown i m c (List.mem_filter.mp (hfilt ▸ hm)).1 hc
      exact ih _ hStep.1 hOcc hInv.1 hInv.2.1 hInv.2.2 hQ' hown'
    · exact ih _ hT hO hS hM hSlots hQ hown

/-- Replacing one actor keeps call ownership when that actor's box does. -/
theorem owned_keep (w : World) (id : InstId) (a : Actor) (hown : BoxOwned w)
    (hbox : a.box = (w.st id).box) : BoxOwned (setActor w id a) := by
  intro i m c hm hc
  by_cases hi : i = id
  · exact hown id m c (by rw [← hbox]; simpa [hi, setActor_self] using hm) hc
  · exact hown i m c (by simpa [setActor_other _ _ _ _ hi] using hm) hc

/-- Equal bulk mailboxes carry the same call ownership. -/
theorem owned_box_eq (w w' : World) (hown : BoxOwned w)
    (hbox : ∀ i, (w'.st i).box = (w.st i).box) : BoxOwned w' := by
  intro i m c hm hc
  exact hown i m c (by rw [hbox i] at hm; exact hm) hc

theorem setCell_st (w : World) (dst label : String) (c : Cell) (i : InstId) :
    (setCell w dst label c).st i = w.st i := rfl

theorem msgs_box (w : World) (name : String) (ms : List Msg) (i : InstId) :
    ((refundMsgs w name ms).st i).box = (w.st i).box := by
  unfold refundMsgs
  induction ms generalizing w with
  | nil => simp
  | cons m ms ih =>
    simp [List.foldl_cons]
    exact (ih (creditSender w name m.sender)).trans (credit_box w name m.sender i)

theorem parks_box (w : World) (name : String) (ps : List Parked) (i : InstId) :
    ((refundParked w name ps).st i).box = (w.st i).box := by
  unfold refundParked
  induction ps generalizing w with
  | nil => simp
  | cons p ps ih =>
    simp [List.foldl_cons]
    exact (ih (creditSender w name p.msg.sender)).trans (credit_box w name p.msg.sender i)

theorem release_fold_box (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).box = (w.st i).box := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hif : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hif]
      exact ih w
    · rw [if_neg hif]
      have hbox : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).box =
          (w.st i).box := by
        by_cases hi : i = p.sender
        · simp [hi, setActor, resume_box]
        · simp [setActor, hi]
      exact (ih _).trans hbox

/-- A lone release empties the actor and leaves every other bulk mailbox. -/
theorem releaseWorld_box (D : Description) (w : World) (id : InstId) (a : Actor) (i : InstId) :
    ((releaseWorld D w id a).st i).box = (if i = id then [] else (w.st i).box) := by
  let w1 := readCells D w id
  have h1 : (w1.st i).box = (w.st i).box := by simp [w1, cellsSt]
  let w2 := refundMsgs w1 (tname id) a.box
  have h2 : (w2.st i).box = (w1.st i).box := by simp [w2, msgs_box]
  let w3 := refundParked w2 (tname id) a.parked
  have h3 : (w3.st i).box = (w2.st i).box := by simp [w3, parks_box]
  let dead : Actor :=
    { w3.st id with life := .dead, phase := .idle, box := [], prio := [], parked := [] }
  let w4 := setActor w3 id dead
  have h4 : (w4.st i).box = if i = id then [] else (w3.st i).box := by
    by_cases hi : i = id
    · simp [w4, hi, setActor, dead]
    · simp [w4, setActor, hi]
  have hbody : releaseWorld D w id a = releaseParked w4 id a.parked := by
    simp [releaseWorld, w1, w2, w3, w4, dead]
  rw [hbody, release_fold_box, h4]
  by_cases hi : i = id
  · simp [hi]
  · simp [hi, h3, h2, h1]

theorem release_owned (D : Description) (w : World) (id : InstId) (a : Actor) (hown : BoxOwned w) :
    BoxOwned (releaseWorld D w id a) := by
  intro i m c hm hc
  have hbox := releaseWorld_box D w id a i
  by_cases hi : i = id
  · rw [hbox] at hm
    simp [hi] at hm
  · rw [hbox] at hm
    simp [hi] at hm
    exact hown i m c hm hc

theorem tryWake_box (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) : ((tryWake D w dstId label writer).st i).box = (w.st i).box := by
  by_cases hif : ((w.st dstId).life == .alive &&
      decide (prioLoad (w.st dstId).prio < capPrio D w.N dstId) &&
      !((w.st dstId).prio.any fun p => p.label == label)) = true
  · simp [tryWake, hif, setActor]
    by_cases hi : i = dstId <;> simp [hi]
  · simp [tryWake, hif]

theorem wake_box (ids : List InstId) (D : Description) (w : World) (dst label : String)
    (writer i : InstId) :
    ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).box = (w.st i).box := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp [List.foldl_cons]
    exact (ih (tryWake D w j label writer)).trans (tryWake_box D w j label writer i)

/-- Enqueue keeps ownership: a new call message names its sender, and a send names nobody. -/
theorem enqueue_owned (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (isCall : Bool) (k : Cont) (hown : BoxOwned w)
    (hmsg : ∀ c, msg.callFrom = some c → msg.sender = c) :
    BoxOwned (enqueueOrPark w D sender dst msg isCall k) := by
  intro i m c hm hc
  rcases enqueue_box_mem w D sender dst msg isCall k i m hm with hm0 | ⟨_, heq, _⟩
  · exact hown i m c hm0 hc
  · have hc' : msg.callFrom = some c := by simpa [heq] using hc
    simpa [heq] using hmsg c hc'

theorem deliver_world (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) (i : InstId) :
    w1.st i = (w.st i) := by
  unfold deliver at h
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        simp [cellsSt]
    · split at h
      · cases h
      · cases h
        simp [cellsSt]

theorem deliver_actor (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg)
    (w1 : World) (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.box = a.box := by
  unfold deliver at h
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        rfl
    · split at h
      · cases h
      · cases h
        split <;> rfl

/-- Every box message in `w'` was already in that box, or is the message of a
parked entry that was already there. Every parked entry was already parked. -/
structure MailFrom (w w' : World) : Prop where
  box : ∀ i m, m ∈ (w'.st i).box →
    m ∈ (w.st i).box ∨ ∃ p, p ∈ (w.st i).parked ∧ p.msg = m
  park : ∀ i p, p ∈ (w'.st i).parked → p ∈ (w.st i).parked

theorem mailFrom_rfl (w : World) : MailFrom w w where
  box _ _ hm := Or.inl hm
  park _ _ hp := hp

theorem mailFrom_trans (w₁ w₂ w₃ : World) (h₁₂ : MailFrom w₁ w₂) (h₂₃ : MailFrom w₂ w₃) :
    MailFrom w₁ w₃ where
  box i m hm := by
    rcases h₂₃.box i m hm with hbox | ⟨p, hp, hmsg⟩
    · rcases h₁₂.box i m hbox with hold | ⟨p, hp, hmsg⟩
      · exact Or.inl hold
      · exact Or.inr ⟨p, hp, hmsg⟩
    · exact Or.inr ⟨p, h₁₂.park i p hp, hmsg⟩
  park i p hp := h₁₂.park i p (h₂₃.park i p hp)

theorem releaseWorld_mail (D : Description) (w : World) (id : InstId) (a : Actor) :
    MailFrom w (releaseWorld D w id a) where
  box i m hm := Or.inl ((releaseWorld_sub D w id a i).1.mem hm)
  park i p hp := (releaseWorld_sub D w id a i).2.mem hp

theorem fail_mail (w : World) (dead : InstId) : MailFrom w (failWaiters w dead) where
  box i m hm := by
    have hb := failFold_box w dead i w.roster
    rw [show ((failWaiters w dead).st i).box = (w.st i).box by simpa [failWaiters] using hb] at hm
    exact Or.inl hm
  park i p hp := by
    have hp' := failFold_parked w dead i w.roster
    rw [show ((failWaiters w dead).st i).parked = (w.st i).parked by simpa [failWaiters] using hp'] at hp
    exact hp

theorem admitHost_mail (w : World) (dead host : InstId) : MailFrom w (admitHost w dead host) where
  box i m hm := by
    unfold admitHost at hm
    split at hm
    · exact Or.inl hm
    · split at hm
      · exact Or.inl hm
      · by_cases hi : i = host
        · rw [hi] at hm ⊢
          rw [setActor_self] at hm
          rcases List.mem_append.mp hm with hbox | hmap
          · exact Or.inl hbox
          · rcases List.mem_map.mp hmap with ⟨p, hp, hmsg⟩
            exact Or.inr ⟨p, (List.mem_filter.mp hp).1, hmsg⟩
        · rw [setActor_other w host i _ hi] at hm
          exact Or.inl hm
  park i p hp := by
    unfold admitHost at hp
    split at hp
    · exact hp
    · split at hp
      · exact hp
      · by_cases hi : i = host
        · rw [hi] at hp ⊢
          rw [setActor_self] at hp
          exact (List.mem_filter.mp hp).1
        · rw [setActor_other w host i _ hi] at hp
          exact hp

theorem admitFold_mail (w : World) (dead : InstId) (ids : List InstId) :
    MailFrom w (ids.foldl (fun w host => admitHost w dead host) w) := by
  induction ids generalizing w with
  | nil => exact mailFrom_rfl w
  | cons host ids ih =>
    simp only [List.foldl_cons]
    exact mailFrom_trans w (admitHost w dead host) _
      (admitHost_mail w dead host) (ih (admitHost w dead host))

theorem admit_mail (w : World) (dead : InstId) : MailFrom w (admitDead w dead) := by
  simpa [admitDead] using admitFold_mail w dead w.roster

theorem abort_mail (D : Description) (w : World) (id : InstId) (a : Actor) :
    MailFrom w (abortActor D w id a) := by
  simp only [abortActor]
  exact mailFrom_trans w (releaseWorld D w id a) _
    (releaseWorld_mail D w id a)
    (mailFrom_trans (releaseWorld D w id a) (failWaiters (releaseWorld D w id a) id) _
      (fail_mail (releaseWorld D w id a) id)
      (admit_mail (failWaiters (releaseWorld D w id a) id) id))

theorem abortDesc_mail (fuel : Nat) (D : Description) (w : World) (parent : InstId) :
    MailFrom w (abortDesc fuel D w parent) := by
  induction fuel generalizing w parent with
  | zero => simpa [abortDesc] using mailFrom_rfl w
  | succ fuel ih =>
    simp only [abortDesc]
    suffices ∀ (ids : List InstId) (w0 : World),
        MailFrom w0 (ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0) by
      exact this w.roster w
    intro ids
    induction ids with
    | nil => intro w0; simpa using mailFrom_rfl w0
    | cons c ids ihf =>
      intro w0
      simp only [List.foldl_cons]
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo]
        exact mailFrom_trans w0 (abortDesc fuel D w0 c) _
          (ih w0 c)
          (mailFrom_trans (abortDesc fuel D w0 c)
            (abortActor D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c)) _
            (abort_mail D (abortDesc fuel D w0 c) c ((abortDesc fuel D w0 c).st c))
            (ihf _))
      · rw [if_neg hgo]
        exact ihf w0

theorem tombstone_mail (D : Description) (w : World) (child : InstId) :
    MailFrom w (enqueueTombstone D w child) where
  box i m hm := by
    rw [tombstone_box] at hm
    exact Or.inl hm
  park i p hp := by
    rw [tombstone_parked] at hp
    exact hp

/-- `terminateStage` only deletes mail or moves a parked message into the same box. -/
theorem terminate_mail (D : Description) (w : World) (id : InstId) :
    MailFrom w (terminateStage D w id (w.st id)) := by
  simp only [terminateStage]
  exact mailFrom_trans w (abortDesc w.roster.length D w id) _
    (abortDesc_mail w.roster.length D w id)
    (mailFrom_trans (abortDesc w.roster.length D w id)
      (abortActor D (abortDesc w.roster.length D w id) id ((abortDesc w.roster.length D w id).st id)) _
      (abort_mail D (abortDesc w.roster.length D w id) id ((abortDesc w.roster.length D w id).st id))
      (tombstone_mail D _ id))

theorem mail_owned (w : World) (hT : CallTagInv w)
    (hpm : ∀ i p, p ∈ (w.st i).parked → p.sender = p.msg.sender) (hown : BoxOwned w) (w' : World)
    (h : MailFrom w w') : BoxOwned w' := by
  intro i m c hm hc
  rcases h.box i m hm with hbox | ⟨p, hp, hmsg⟩
  · exact hown i m c hbox hc
  · have hc' : p.msg.callFrom = some c := by rw [hmsg]; exact hc
    have hs : p.sender = c := ((hT.parkFrom i p hp c).mp hc').1
    rw [hpm i p hp] at hs
    rw [← hmsg]
    exact hs

/-- One execution step does not put a call into a mailbox under another sender's name. -/
theorem exec_owned (I : Impl) (w : World) (id : InstId) (w' : World)
    (hT : CallTagInv w) (hpm : ∀ i p, p ∈ (w.st i).parked → p.sender = p.msg.sender)
    (hown : BoxOwned w) (h : execHead I w id = some w') : BoxOwned w' := by
  unfold execHead at h
  by_cases hlive : (w.st id).life ≠ .alive
  · simp [hlive] at h
  · simp [hlive] at h
    cases hph : (w.st id).phase with
    | idle => simp [hph] at h
    | parked _ _ _ => simp [hph] at h
    | awaitReply _ _ => simp [hph] at h
    | awaitEffect _ => simp [hph] at h
    | awaitPeer _ => simp [hph] at h
    | crashed => simp [hph] at h
    | run k =>
      simp [hph] at h
      cases h
      cases hrest : k.rest with
      | nil =>
        simp [execRun, hrest]
        exact owned_keep w id ({(w.st id) with phase := .idle, typestate := k.toState}) hown rfl
      | cons e es =>
        cases e with
        | send dst label hint =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp [hroute]
            exact owned_keep (noteStale w id dst) id (proceed (w.st id) (afterHead k))
              (owned_box_eq w _ hown (fun i => by simp [noteStale_st]))
              (by simp [noteStale_st, proceed_box])
          | some dstId =>
            simp [hroute]
            exact enqueue_owned w I.desc id dstId
              { label := label, sender := id, callFrom := none } false (afterHead k) hown
              (by intro c hc; cases hc)
        | trySend dst label hint onFull onGone =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp [hroute]
            exact owned_keep (noteStale w id dst) id (proceed (w.st id) (afterHead k))
              (owned_box_eq w _ hown (fun i => by simp [noteStale_st]))
              (by simp [noteStale_st, proceed_box])
          | some dstId =>
            simp [hroute]
            split
            · exact enqueue_owned w I.desc id dstId
                { label := label, sender := id, callFrom := none, reliable := false } false
                (afterHead k) hown (by intro c hc; cases hc)
            · exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
        | call dst label hint na to =>
          simp [execRun, hrest]
          cases hroute : route w I.desc id dst with
          | none =>
            simp [hroute]
            exact owned_keep (noteStale w id dst) id (proceed (w.st id) (afterHead k))
              (owned_box_eq w _ hown (fun i => by simp [noteStale_st]))
              (by simp [noteStale_st, proceed_box])
          | some dstId =>
            simp [hroute]
            exact enqueue_owned w I.desc id dstId
              { label := label, sender := id, callFrom := some id } true (afterHead k) hown
              (by intro c hc; cases hc; rfl)
        | reply =>
          simp [execRun, hrest]
          cases hrep : k.replyTo with
          | none =>
            simp [performReply, hrep]
            exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
          | some caller =>
            simp [performReply, hrep]
            cases hphC : (w.st caller).phase with
            | awaitReply dst ck =>
              by_cases hdst : dst = id
              · simp [hdst]
                exact owned_keep (setActor w caller (proceed (w.st caller) ck)) id
                  (proceed ((setActor w caller (proceed (w.st caller) ck)).st id) (afterHead k))
                  (owned_keep w caller (proceed (w.st caller) ck) hown (by simp [proceed_box]))
                  (by
                    by_cases hi : id = caller
                    · simp [hi, setActor, proceed_box]
                    · simp [setActor, hi, proceed_box])
              · simp [hdst]
                exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | idle =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | run _ =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | parked _ _ _ =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | awaitEffect _ =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | awaitPeer _ =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
            | crashed =>
              simp
              exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
        | selfSchedule label =>
          simp [execRun, hrest]
          split
          · exact owned_keep w id (proceed (w.st id) (afterHead k)) hown (by simp [proceed_box])
          · split
            · exact owned_keep w id (proceed ({(w.st id) with prio := upsertPrio (w.st id).prio { label := label, sender := id, callFrom := none, mid := (w.st id).nextMid }, nextMid := (w.st id).nextMid + 1}) (afterHead k)) hown (by simp [proceed_box])
            · exact owned_keep w id ({(w.st id) with phase := .crashed}) hown rfl
        | cell dst label value =>
          simp [execRun, hrest]
          let written : Cell := { value := max (w.cell dst label).value value, dirty := true }
          have hbase (i : InstId) :
              ((setActor (setCell w dst label written) id (proceed (w.st id) (afterHead k))).st i).box =
                (w.st i).box := by
            by_cases hi : i = id
            · simp [hi, setCell_st, setActor, proceed_box]
            · simp [setCell_st, setActor, hi]
          split
          · exact owned_box_eq w _ hown hbase
          · intro i m c hm hc
            simp only [wakeReaders, setCell_st] at hm
            rw [wake_box (readersOf (setActor (setCell w dst label written) id
              (proceed (w.st id) (afterHead k))) dst) I.desc
              (setActor (setCell w dst label written) id (proceed (w.st id) (afterHead k)))
              dst label id i] at hm
            exact hown i m c (by rw [← hbase i]; exact hm) hc
        | internal =>
          simp [execRun, hrest]
          exact owned_keep w id ({(w.st id) with phase := .awaitEffect (afterHead k)}) hown rfl
        | peer onTimeout =>
          simp [execRun, hrest]
          exact owned_keep w id ({(w.st id) with phase := .awaitPeer (afterHead k)}) hown rfl
        | terminate =>
          have hstep := exec_term_step I w id (w.st id) es k.toState k.replyTo
          have heq : execRun I w id (w.st id) k =
              execRun I w id (w.st id) ⟨.terminate :: es, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ := by
            cases k
            simp at hrest
            rw [hrest]
          rw [heq]
          generalize hw : execRun I w id (w.st id) ⟨.terminate :: es, k.toState, k.replyTo, [], [], [], "", "", "", "", ""⟩ = wR
            at hstep ⊢
          cases hstep
          · exact hown
          · exact release_owned I.desc w id (w.st id) hown
          · exact mail_owned w hT hpm hown _ (terminate_mail I.desc w id)

/-- A bulk receive moves a parked call only with the sender the tag invariant records. -/
theorem recv_owned (I : Impl) (w : World) (id : InstId) (w' : World) (hT : CallTagInv w)
    (hOcc : OccInv I w) (hown : BoxOwned w) (h : receiveBulk I w id = some w') : BoxOwned w' := by
  unfold receiveBulk at h
  by_cases hready : (w.st id).life ≠ .alive ∨ (w.st id).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st id).box with
    | nil =>
      cases hp : (w.st id).parked with
      | nil => simp [hbox, hp] at h
      | cons p ps =>
        simp [hbox, hp] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_world I w id ({(w.st id) with parked := ps}) p.msg w1 a1
            (by simp [hbox]; exact hdel)
          have ha : a1.box = [] := by
            simpa [hbox] using deliver_actor I w id ({(w.st id) with parked := ps}) p.msg w1 a1
              (by simp [hbox]; exact hdel)
          intro i m c hm hc
          by_cases hs : i = p.sender <;> by_cases hid : i = id
          · have hsid : p.sender = id := hs.symm.trans hid
            simp [setActor, credit_box, resume_box, hs, hid, hsid, ha] at hm
          · have hsid : p.sender ≠ id := fun h => hid (hs.trans h)
            simp [setActor, credit_box, resume_box, hs, hid, hsid, hst] at hm
            exact hown p.sender m c hm hc
          · have hne : ¬id = p.sender := by simpa [hid] using hs
            simp [setActor, credit_box, resume_box, hne, hid, ha] at hm
          · simp [setActor, credit_box, resume_box, hs, hid, hst] at hm
            exact hown i m c hm hc
    | cons m0 ms =>
      cases hp : (w.st id).parked with
      | nil =>
        simp [hbox, hp] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_world I w id ({(w.st id) with box := ms}) m0 w1 a1
            (by simp [hp]; exact hdel)
          have ha : a1.box = ms := by
            simpa using deliver_actor I w id ({(w.st id) with box := ms}) m0 w1 a1
              (by simp [hp]; exact hdel)
          intro i m c hm hc
          rw [credit_box] at hm
          by_cases hi : i = id
          · rw [hi, setActor_self] at hm
            exact hown id m c (by rw [ha] at hm; exact List.mem_of_mem_tail (by rw [hbox]; exact hm)) hc
          · rw [setActor_other _ _ _ _ hi, hst] at hm
            exact hown i m c hm hc
      | cons p ps =>
        simp [hbox, hp] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_world I w id ({(w.st id) with box := ms}) m0 w1 a1
            (by simp [hp]; exact hdel)
          have ha : a1.box = ms := by
            simpa using deliver_actor I w id ({(w.st id) with box := ms}) m0 w1 a1
              (by simp [hp]; exact hdel)
          intro i m c hm hc
          rw [setActor] at hm
          by_cases hs : i = p.sender
          · simp [hs, resume_box, credit_box] at hm
            by_cases hid : p.sender = id
            · simp [hid, setActor, ha, List.mem_append, List.mem_singleton] at hm
              rcases hm with hm | hm
              · exact hown id m c (by simpa [hbox] using List.mem_cons_of_mem m0 hm) hc
              · have hc0 : p.msg.callFrom = some c := by simpa [hm] using hc
                rcases (hT.parkFrom id p (by simp [hp]) c).mp hc0 with ⟨hsnd, _, _⟩
                exact (hOcc.parkMsg id p (by simp [hp])).symm.trans hsnd ▸ by simpa [hm]
            · simp [setActor, hid, hst] at hm
              exact hown p.sender m c hm hc
          · simp [hs, credit_box] at hm
            by_cases hi : i = id
            · simp [hi, setActor] at hm
              simp [List.mem_append, List.mem_singleton, ha] at hm
              rcases hm with hm | hm
              · exact hown id m c (List.mem_of_mem_tail (by simpa [hbox] using hm)) hc
              · have hc0 : p.msg.callFrom = some c := by simpa [hm] using hc
                rcases (hT.parkFrom id p (by simp [hp]) c).mp hc0 with ⟨hsnd, _, _⟩
                have hmsg := (hOcc.parkMsg id p (by simp [hp])).symm.trans hsnd
                simpa [hm] using hmsg
            · simp [setActor, hi, hst] at hm
              exact hown i m c hm hc

theorem prio_owned (I : Impl) (w : World) (id : InstId) (w' : World) (hown : BoxOwned w)
    (h : receivePrio I w id = some w') : BoxOwned w' := by
  intro i m c hm hc
  exact hown i m c (prio_box_msg I w w' id i h m hm) hc

theorem ingress_owned (I : Impl) (w w' : World) (dst : InstId) (label : String)
    (hown : BoxOwned w) (h : receiveIngress I w dst label = some w') : BoxOwned w' := by
  intro i m c hm hc
  rcases ingress_box I w w' dst label i h with ⟨_, hbox⟩ | ⟨_, hbox⟩
  · rw [hbox] at hm
    simp [List.mem_append, List.mem_singleton] at hm
    rcases hm with hm | hm
    · exact hown i m c hm hc
    · simp [hm] at hc
  · exact hown i m c (by rw [hbox] at hm; exact hm) hc

theorem spawn_owned (I : Impl) (w : World) (template : String) (w' : World)
    (hSlot : OpenSlots w) (hOcc : OccInv I w) (hown : BoxOwned w)
    (h : spawn I w template = some w') : BoxOwned w' := by
  unfold spawn at h
  cases ht : templateOf I.desc template with
  | none => simp [ht] at h
  | some t =>
    simp [ht] at h
    obtain ⟨_, heq⟩ := h
    let nid := InstId.peer template (w.nextIx template)
    have hnin : nid ∉ w.roster := by
      intro hmem
      exact absurd (hOcc.indexed template (w.nextIx template) hmem) (Nat.lt_irrefl _)
    have hempty := (hOcc.offEmpty nid hnin).1
    have hbox : ∀ i, (w'.st i).box = (w.st i).box := by
      rw [← heq]
      intro i
      by_cases hi : i = nid
      · simp [hi, nid, readCells_st, setActor, withTokens, hempty]
      · simp [readCells_st, setActor, hi, nid]
    exact owned_box_eq w w' hown hbox

/-- A subtree kill preserves call tags. -/
theorem kill_subtree_tag (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) (hT : CallTagInv w) (hown : BoxOwned w) (sub : String) (key : Nat) :
    CallTagInv (killSubtree w I.desc sub key) :=
  subtree_kill_tag I hL hG N w hR hT hown sub key

theorem finish_keeps_box (I : Impl) (w w' : World) (id i : InstId)
    (h : finishWait I w id = some w') : (w'.st i).box = (w.st i).box := by
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  by_cases hi : i = id <;> simp [setActor, hi, proceed_box]

/-- Reachable worlds keep call tags, and a call message in a mailbox names its sender. -/
theorem tag_owned_reachable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat)
    (w : World) (hR : Reachable I N w) : CallTagInv w ∧ BoxOwned w := by
  induction hR with
  | init =>
    exact ⟨call_tag_init I N, by
      intro i m c hm hc
      simp [(init_box I N i).1] at hm⟩
  | step w w' a prev happ ih =>
    cases a with
    | stutter =>
      cases stutter_unchanged I w w' happ
      exact ih
    | ingress dst label =>
      have hing : receiveIngress I w dst label = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨ingress_tag I w dst label w' ih.1 hing, ingress_owned I w w' dst label ih.2 hing⟩
    | finish id =>
      have hf : finishWait I w id = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨finish_tag I w id w' ih.1 hf,
        owned_box_eq w w' ih.2 (fun i => finish_keeps_box I w w' id i hf)⟩
    | spawn template =>
      have hs : spawn I w template = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨spawn_tag I w template w' (inv_reachable I N w hL prev).2.2
          (inv2_reachable I hL hG N w prev).2.1 ih.1 hs,
        spawn_owned I w template w' (inv_reachable I N w hL prev).2.2
          (inv2_reachable I hL hG N w prev).2.1 ih.2 hs⟩
    | recvPrio id =>
      have hp : receivePrio I w id = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨prio_tag I w id w' ih.1 hp, prio_owned I w id w' ih.2 hp⟩
    | recvBulk id =>
      have hb : receiveBulk I w id = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨recvBulk_tag I hL w w' id (inv_reachable I N w hL prev).2.1 ih.1 hb,
        recv_owned I w id w' ih.1 (inv2_reachable I hL hG N w prev).2.1 ih.2 hb⟩
    | exec id =>
      have hhead : execHead I w id = some w' := by simpa [stepWorld] using stepOfApply happ
      exact ⟨exec_tag I hL hG N w prev ih.1 ih.2 id w' hhead,
        exec_owned I w id w' ih.1 (inv2_reachable I hL hG N w prev).2.1.parkMsg ih.2 hhead⟩

theorem call_tag_reachable (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) (N : Nat) (w : World)
    (hR : Reachable I N w) : CallTagInv w :=
  (tag_owned_reachable I hL hG N w hR).1

/-- Index of the first bulk message that names `c`, or the length when there is none. -/
def callPos : List Msg → InstId → Nat
  | [], _ => 0
  | m :: ms, c => if m.callFrom = some c then 0 else callPos ms c + 1

theorem callPos_head (m : Msg) (ms : List Msg) (c : InstId) (hc : m.callFrom = some c) :
    callPos (m :: ms) c = 0 := by
  simp [callPos, hc]

theorem callPos_skip (m : Msg) (ms : List Msg) (c : InstId) (hne : m.callFrom ≠ some c) :
    callPos (m :: ms) c = callPos ms c + 1 := by
  simp [callPos, hne]

theorem callPos_append (ms extra : List Msg) (c : InstId) (h : callPos ms c < ms.length) :
    callPos (ms ++ extra) c = callPos ms c := by
  induction ms with
  | nil => simp [callPos] at h
  | cons m ms ih =>
    by_cases hc : m.callFrom = some c
    · simp [callPos, hc]
    · have hlt : callPos ms c < ms.length := by
        simp [callPos, hc, List.length] at h
        omega
      simp [callPos, hc, ih hlt]

theorem callPos_mem (ms : List Msg) (c : InstId) (h : callPos ms c < ms.length) :
    ∃ m, m ∈ ms ∧ m.callFrom = some c := by
  induction ms with
  | nil => simp [callPos] at h
  | cons m ms ih =>
    by_cases hc : m.callFrom = some c
    · exact ⟨m, List.Mem.head _, hc⟩
    · have hlt : callPos ms c < ms.length := by
        simp [callPos, hc, List.length] at h
        omega
      obtain ⟨m', hm, hc'⟩ := ih hlt
      exact ⟨m', List.Mem.tail _ hm, hc'⟩

theorem mem_call_pos (ms : List Msg) (m : Msg) (c : InstId) (hm : m ∈ ms) (hc : m.callFrom = some c) :
    callPos ms c < ms.length := by
  induction ms with
  | nil => cases hm
  | cons x xs ih =>
    cases hm with
    | head => simp [callPos, hc, List.length]
    | tail _ ht =>
      by_cases hx : x.callFrom = some c
      · simp [callPos, hx, List.length]
      · have hlt := ih ht
        simp [callPos, hx, List.length] at hlt ⊢
        omega

theorem countParkedCall_none (ps : List Parked) (c : InstId)
    (h : ∀ p, p ∈ ps → p.msg.callFrom ≠ some c) : countParkedCall ps c = 0 := by
  induction ps with
  | nil => simp [countParkedCall]
  | cons p ps ih =>
    have hp := h p (List.Mem.head _)
    simp [countParkedCall, hp, ih (fun q hq => h q (List.Mem.tail _ hq))]

/-- A caller in `awaitReply` has its call in the box, not in the parked list. -/
theorem await_mail_in_box (w : World) (hT : CallTagInv w) (c d : InstId) (k : Cont)
    (hph : (w.st c).phase = .awaitReply d k) (hmail : mailCall w d c) :
    callPos (w.st d).box c < (w.st d).box.length ∧
      ∀ p, p ∈ (w.st d).parked → p.msg.callFrom ≠ some c := by
  have hno (p) (hp : p ∈ (w.st d).parked) : p.msg.callFrom ≠ some c := by
    intro hc
    obtain ⟨_, _, hk⟩ := (hT.parkFrom d p hp c).mp hc
    simp [hph] at hk
  refine ⟨?_, hno⟩
  rcases hmail with ⟨m, hm, hc⟩ | ⟨p, hp, hc⟩
  · exact mem_call_pos (w.st d).box m c hm hc
  · exact absurd hc (hno p hp)

/-- One bulk receive of a callee that still holds the call either installs the
handler or moves that message strictly closer to the head of the box. -/
theorem recv_box_progress (I : Impl) (hL : LocalOk I) (w w' : World) (d c : InstId) (k : Cont)
    (h : receiveBulk I w d = some w') (hM : MailInv w) (hT : CallTagInv w)
    (hph : (w.st c).phase = .awaitReply d k)
    (hpos : callPos (w.st d).box c < (w.st d).box.length) :
    ((w'.st c).phase = .awaitReply d k ∧ ¬mailCall w' d c ∧
        (handlerOwes c (w'.st d).phase ∨ replyPending c (w'.st d).phase)) ∨
      ((w'.st c).phase = .awaitReply d k ∧ mailCall w' d c ∧
        callPos (w'.st d).box c < callPos (w.st d).box c) := by
  have hlive : (w.st d).life = .alive := by
    by_cases hl : (w.st d).life = .alive
    · exact hl
    · have hready : (w.st d).life ≠ .alive ∨ (w.st d).phase ≠ .idle := Or.inl hl
      simp [receiveBulk, hready] at h
  have hidle : (w.st d).phase = .idle := by
    by_cases hp : (w.st d).phase = .idle
    · exact hp
    · have hready : (w.st d).life ≠ .alive ∨ (w.st d).phase ≠ .idle := Or.inr hp
      simp [receiveBulk, hready] at h
  have hcne : c ≠ d := by
    intro heq
    rw [heq] at hph
    simp [hidle] at hph
  have hnoP (p) (hp : p ∈ (w.st d).parked) : p.msg.callFrom ≠ some c := by
    intro hc
    obtain ⟨_, _, hk⟩ := (hT.parkFrom d p hp c).mp hc
    simp [hph] at hk
  unfold receiveBulk at h
  have hready : ¬((w.st d).life ≠ .alive ∨ (w.st d).phase ≠ .idle) := by
    intro hbad
    simp [hbad] at h
  simp [hready] at h
  cases hbox : (w.st d).box with
  | nil => simp [callPos, hbox] at hpos
  | cons m ms =>
    cases hpark : (w.st d).parked with
    | nil =>
      simp [hbox, hpark] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        injection h with hw
        have hdel' : deliver I w d ({ (w.st d) with box := ms }) m = some (w1, a1) := by
          simpa [hpark] using hdel
        have hst (i) : w1.st i = w.st i := deliver_st I w d _ m w1 a1 i hdel'
        by_cases hc : m.callFrom = some c
        · have hcall := deliver_call I hL w d ({ (w.st d) with box := ms }) m w1 a1 c hdel' hc
          obtain ⟨kH, hrun, hshape, _, _⟩ := hcall.2.2.2
          have hzero : countCall ms c = 0 := by
            have hs := hT.sole d c
            unfold soleCall at hs
            rw [hbox, hpark, count_some m ms c hc] at hs
            simp [countParkedCall] at hs
            omega
          have hphC : (w'.st c).phase = .awaitReply d k := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender c).2.2.1
            simpa [setActor, hcne, hst c, hph] using hcr
          have hphD : (w'.st d).phase = .run kH := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender d).2.2.1
            simpa [setActor, hrun] using hcr
          have hbox' : (w'.st d).box = ms := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender d).1
            simpa [setActor, hcall.1] using hcr
          have hpark' : (w'.st d).parked = [] := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender d).2.1
            simpa [setActor, hcall.2.1, hpark] using hcr
          have hnoB : ∀ x, x ∈ (w'.st d).box → x.callFrom ≠ some c := by
            intro x hx
            rw [hbox'] at hx
            exact count_zero_mem ms c hzero x hx
          refine Or.inl ⟨hphC, ?_, ?_⟩
          · intro hbad
            rcases hbad with ⟨x, hx, hc'⟩ | ⟨p, hp, hc'⟩
            · exact hnoB x hx hc'
            · simp [hpark'] at hp
          · have hduty : handlerOwes c a1.phase ∨ replyPending c a1.phase := by
              cases hrest : kH.rest with
              | nil =>
                have hc1 := hshape.2.1
                simp [replyCount, hrest] at hc1
              | cons e es =>
                by_cases he : e = .reply
                · exact Or.inr ⟨kH, by simp [carriedCont, hrun], hshape,
                    by simp [nextIsReply, hrest, he]⟩
                · exact Or.inl ⟨kH, by simp [carriedCont, hrun], hshape, by
                    cases e <;> simp [nextIsReply, hrest] at he ⊢⟩
            simpa [hphD, hrun] using hduty
        · have hboxA : a1.box = ms := by
            cases hcf : m.callFrom with
            | none =>
              exact (deliver_plain I w d ({ (w.st d) with box := ms }) m w1 a1 hdel' hcf).1
            | some s =>
              exact (deliver_call I hL w d ({ (w.st d) with box := ms }) m w1 a1 s hdel' hcf).1
          have hposT : callPos ms c < ms.length := by
            simp [callPos, hc, hbox] at hpos
            omega
          have hphC : (w'.st c).phase = .awaitReply d k := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender c).2.2.1
            simpa [setActor, hcne, hst c, hph] using hcr
          have hbox' : (w'.st d).box = ms := by
            rw [← hw]
            have hcr := (credit_same (setActor w1 d a1) (tname d) m.sender d).1
            simpa [setActor, hboxA] using hcr
          refine Or.inr ⟨hphC, ?_, ?_⟩
          · obtain ⟨m', hm', hc'⟩ := callPos_mem ms c hposT
            exact Or.inl ⟨m', by rw [hbox']; exact hm', hc'⟩
          · rw [hbox']
            simp [callPos, hc]
    | cons p ps =>
      simp [hbox, hpark] at h
      split at h
      · cases h
      · next w1 a1 hdel =>
        injection h with hw
        have hdel' : deliver I w d ({ (w.st d) with box := ms }) m = some (w1, a1) := by
          simpa [hpark] using hdel
        have hst (i) : w1.st i = w.st i := deliver_st I w d _ m w1 a1 i hdel'
        have hpmem : p ∈ (w.st d).parked := by simp [hpark]
        have hsnd : p.sender ≠ d := by
          intro heq
          obtain ⟨_, hkS⟩ := hM.fwd d p hpmem
          rw [heq] at hkS
          simp [hidle] at hkS
        have hsc : p.sender ≠ c := by
          intro heq
          obtain ⟨_, hkS⟩ := hM.fwd d p hpmem
          rw [heq] at hkS
          simp [hph] at hkS
        have hmsg : p.msg.callFrom ≠ some c := hnoP p hpmem
        have hflipC : ¬ c = p.sender := fun h => hsc h.symm
        have hflipD : ¬ d = p.sender := fun h => hsnd h.symm
        by_cases hc : m.callFrom = some c
        · have hcall := deliver_call I hL w d ({ (w.st d) with box := ms }) m w1 a1 c hdel' hc
          obtain ⟨kH, hrun, hshape, _, _⟩ := hcall.2.2.2
          have hzero : countCall ms c = 0 := by
            have hs := hT.sole d c
            unfold soleCall at hs
            rw [hbox, hpark, count_some m ms c hc] at hs
            have hpk : countParkedCall (p :: ps) c = 0 :=
              countParkedCall_none (p :: ps) c (fun q hq => hnoP q (by simpa [hpark] using hq))
            simp [hpk] at hs
            omega
          have hadm :
              ((setActor w1 d { a1 with box := a1.box ++ [p.msg], parked := ps }).st d).phase =
                .run kH ∧
              ((setActor w1 d { a1 with box := a1.box ++ [p.msg], parked := ps }).st d).box =
                ms ++ [p.msg] ∧
              ((setActor w1 d { a1 with box := a1.box ++ [p.msg], parked := ps }).st d).parked = ps := by
            simp [setActor, hrun, hcall.1]
          -- The final world resumes the parked sender, who is neither the callee nor the caller.
          have hphC : (w'.st c).phase = .awaitReply d k := by
            rw [← hw]
            simp [setActor, hflipC, credit_same, hcne, hst c, hph]
          have hphD : (w'.st d).phase = .run kH := by
            rw [← hw]
            simp [setActor, hflipD, credit_same]
            exact hrun
          have hbox' : (w'.st d).box = ms ++ [p.msg] := by
            rw [← hw]
            simp [setActor, hflipD, credit_same]
            rw [hcall.1]
          have hpark' : (w'.st d).parked = ps := by
            rw [← hw]
            simp [setActor, hflipD, credit_same]
          have hnoB : ∀ x, x ∈ (w'.st d).box → x.callFrom ≠ some c := by
            intro x hx
            rw [hbox'] at hx
            have hx' : x ∈ ms ∨ x ∈ [p.msg] := by simpa [List.mem_append] using hx
            rcases hx' with hx' | hx'
            · exact count_zero_mem ms c hzero x hx'
            · simp at hx'
              rw [hx']
              exact hmsg
          have hnoQ : ∀ q, q ∈ (w'.st d).parked → q.msg.callFrom ≠ some c := by
            intro q hq
            rw [hpark'] at hq
            exact hnoP q (by rw [hpark]; exact List.Mem.tail _ hq)
          refine Or.inl ⟨hphC, ?_, ?_⟩
          · intro hbad
            rcases hbad with ⟨x, hx, hc'⟩ | ⟨q, hq, hc'⟩
            · exact hnoB x hx hc'
            · exact hnoQ q hq hc'
          · rw [hphD]
            cases hrest : kH.rest with
            | nil =>
              have hc1 := hshape.2.1
              simp [replyCount, hrest] at hc1
            | cons e es =>
              by_cases he : e = .reply
              · exact Or.inr ⟨kH, by simp [carriedCont], hshape,
                  by simp [nextIsReply, hrest, he]⟩
              · exact Or.inl ⟨kH, by simp [carriedCont], hshape, by
                  cases e <;> simp [nextIsReply, hrest] at he ⊢⟩
        · have hboxA : a1.box = ms := by
            cases hcf : m.callFrom with
            | none =>
              exact (deliver_plain I w d ({ (w.st d) with box := ms }) m w1 a1 hdel' hcf).1
            | some s =>
              exact (deliver_call I hL w d ({ (w.st d) with box := ms }) m w1 a1 s hdel' hcf).1
          have hposT : callPos ms c < ms.length := by
            simp [callPos, hc, hbox] at hpos
            omega
          have hadm :
              ((setActor w1 d { a1 with box := a1.box ++ [p.msg], parked := ps }).st d).box =
                ms ++ [p.msg] := by
            simp [setActor, hboxA]
          have hphC : (w'.st c).phase = .awaitReply d k := by
            rw [← hw]
            simp [setActor, hflipC, credit_same, hcne, hst c, hph]
          have hbox' : (w'.st d).box = ms ++ [p.msg] := by
            rw [← hw]
            simp [setActor, hflipD, credit_same]
            rw [hboxA]
          have hposA : callPos (ms ++ [p.msg]) c = callPos ms c :=
            callPos_append ms [p.msg] c hposT
          refine Or.inr ⟨hphC, ?_, ?_⟩
          · unfold mailCall
            rw [hbox']
            have hlen : (ms ++ [p.msg]).length = ms.length + 1 := by simp
            exact Or.inl (callPos_mem (ms ++ [p.msg]) c (by rw [hposA, hlen]; omega))
          · simp [hbox', hposA, callPos, hc]

/-- A box stays, or gains a suffix. Admitting a dead sender's parked mail appends
every matching message at once, so the suffix need not be a singleton. -/
def BoxGrow (old new : List Msg) : Prop :=
  new = old ∨ ∃ ms, new = old ++ ms

theorem boxGrow_trans {a b c : List Msg} (h1 : BoxGrow a b) (h2 : BoxGrow b c) : BoxGrow a c := by
  rcases h1 with h1 | ⟨ms1, h1⟩
  · rw [← h1]; exact h2
  · rcases h2 with h2 | ⟨ms2, h2⟩
    · exact Or.inr ⟨ms1, by rw [h2]; exact h1⟩
    · rw [h2, h1, List.append_assoc]
      exact Or.inr ⟨ms1 ++ ms2, rfl⟩

theorem call_grow (old new : List Msg) (c : InstId) (h : BoxGrow old new)
    (hin : callPos old c < old.length) :
    callPos new c = callPos old c ∧ callPos new c < new.length := by
  rcases h with h | ⟨ms, h⟩
  · rw [h]
    exact ⟨rfl, hin⟩
  · rw [h, callPos_append old ms c hin, List.length_append]
    refine ⟨rfl, ?_⟩
    omega

/-- Enqueue appends to the target box or leaves every box alone. -/
theorem enqueue_box (w : World) (D : Description) (sender dst : InstId) (msg : Msg)
    (isCall : Bool) (k : Cont) (i : InstId) :
    BoxGrow ((w.st i).box) ((enqueueOrPark w D sender dst msg isCall k).st i).box := by
  unfold enqueueOrPark
  by_cases hlive : (w.st dst).life = .alive
  · simp [hlive]
    by_cases hroom : (w.st dst).parked = [] ∧ (w.st dst).box.length < capBulk D w.N dst
    · simp [hroom]
      cases isCall
      · by_cases hsame : sender = dst
        · rw [hsame]
          by_cases hi : i = dst
          · rw [hi]
            simp [setActor, charge_box, proceed_box]
            exact Or.inr ⟨[{ msg with mid := (w.st dst).nextMid }], rfl⟩
          · simp [setActor, hi]
            exact Or.inl rfl
        · by_cases hi : i = dst
          · rw [hi, if_neg hsame]
            have hflip : ¬ dst = sender := fun h => hsame h.symm
            simp [setActor, charge_box, proceed_box, hsame]
            rw [if_neg hflip]
            exact Or.inr ⟨[{ msg with mid := (w.st dst).nextMid }], rfl⟩
          · by_cases his : i = sender
            · rw [his, if_neg hsame]
              simp [setActor, hi, charge_box, proceed_box]
              exact Or.inl rfl
            · rw [if_neg hsame]
              simp [setActor, hi, his]
              exact Or.inl rfl
      · by_cases hsame : sender = dst
        · rw [hsame]
          by_cases hi : i = dst
          · rw [hi]
            simp [setActor, charge_box]
            exact Or.inr ⟨[{ msg with mid := (w.st dst).nextMid }], rfl⟩
          · simp [setActor, hi]
            exact Or.inl rfl
        · by_cases hi : i = dst
          · rw [hi, if_neg hsame]
            have hflip : ¬ dst = sender := fun h => hsame h.symm
            simp [setActor, charge_box, hsame]
            rw [if_neg hflip]
            exact Or.inr ⟨[{ msg with mid := (w.st dst).nextMid }], rfl⟩
          · by_cases his : i = sender
            · rw [his, if_neg hsame]
              simp [setActor, hi, charge_box]
              exact Or.inl rfl
            · rw [if_neg hsame]
              simp [setActor, hi, his]
              exact Or.inl rfl
    · simp [hroom]
      by_cases hsame : sender = dst
      · rw [hsame]
        by_cases hi : i = dst
        · rw [hi]
          simp [setActor, charge_box]
          exact Or.inl rfl
        · simp [setActor, hi]
          exact Or.inl rfl
      · by_cases hi : i = dst
        · rw [if_neg hsame, hi]
          have hflip : ¬ dst = sender := fun h => hsame h.symm
          simp [setActor, charge_box]
          rw [if_neg hflip]
          exact Or.inl rfl
        · by_cases his : i = sender
          · rw [his, if_neg hsame]
            simp [setActor, hi, charge_box]
            exact Or.inl rfl
          · rw [if_neg hsame]
            simp [setActor, hi, his]
            exact Or.inl rfl
  · simp [hlive]
    by_cases hi : i = sender
    · rw [hi]
      simp [setActor, proceed_box]
      exact Or.inl rfl
    · simp [setActor, hi]
      exact Or.inl rfl

theorem box_actor (w : World) (id : InstId) (a : Actor) (mb : InstId)
    (h : a.box = (w.st id).box) :
    BoxGrow ((w.st mb).box) ((setActor w id a).st mb).box := by
  by_cases hmb : mb = id
  · rw [hmb, setActor_self, h]
    exact Or.inl rfl
  · rw [setActor_other w id mb a hmb]
    exact Or.inl rfl

theorem finish_box (I : Impl) (w w' : World) (id i : InstId) (h : finishWait I w id = some w') :
    (w'.st i).box = (w.st i).box := by
  obtain ⟨_, _, hw⟩ := finish_proceed I w w' id h
  rw [hw]
  by_cases hi : i = id <;> simp [setActor, hi, proceed_box]

theorem deliver_box (I : Impl) (w : World) (id : InstId) (a : Actor) (m : Msg) (w1 : World)
    (a1 : Actor) (h : deliver I w id a m = some (w1, a1)) : a1.box = a.box := by
  simp only [deliver] at h
  split at h
  · cases h
  · split at h
    · split at h
      · cases h
      · cases h
        rfl
    · split at h
      · cases h
      · cases h
        split <;> rfl

theorem prio_box (I : Impl) (w w' : World) (id i : InstId) (h : receivePrio I w id = some w') :
    (w'.st i).box = (w.st i).box := by
  unfold receivePrio at h
  cases hprio : (w.st id).prio with
  | nil => simp [hprio] at h
  | cons m ms =>
    simp [hprio] at h
    split at h
    · simp at h
    · next w1 a1 hdel =>
      cases h.2
      have hbx := deliver_actor I w id ({ (w.st id) with prio := ms }) m w1 a1 hdel
      have hst := deliver_st I w id _ m w1 a1 i hdel
      by_cases hi : i = id
      · rw [hi]
        simp [setActor, hbx]
      · simp [setActor, hi, hst]

/-- A bulk receive of someone else does not change this mailbox. -/
theorem bulk_other_box (I : Impl) (w w' : World) (j i : InstId)
    (h : receiveBulk I w j = some w') (hne : i ≠ j) :
    (w'.st i).box = (w.st i).box := by
  unfold receiveBulk at h
  by_cases hready : (w.st j).life ≠ .alive ∨ (w.st j).phase ≠ .idle
  · simp [hready] at h
  · simp [hready] at h
    cases hbox : (w.st j).box with
    | nil =>
      cases hpark : (w.st j).parked with
      | nil => simp [hbox, hpark] at h
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w j _ p.msg w1 a1 i hdel
          by_cases hs : i = p.sender
          · have hnj : p.sender ≠ j := fun h => hne (hs.trans h)
            rw [hs] at hst ⊢
            simp [setActor_self, resume_box, credit_box]
            rw [setActor_other w1 j p.sender a1 hnj]
            exact congrArg (·.box) hst
          · simp [setActor_other (creditLive (setActor w1 j a1) (tname j) p.msg.sender) p.sender i _ hs,
              credit_box, setActor_other w1 j i a1 hne, hst]
    | cons m ms =>
      cases hpark : (w.st j).parked with
      | nil =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          have hst := deliver_st I w j _ m w1 a1 i hdel
          rw [credit_box]
          simp [setActor, hne, hst]
      | cons p ps =>
        simp [hbox, hpark] at h
        split at h
        · cases h
        · next w1 a1 hdel =>
          cases h
          let admitted : Actor := { a1 with box := a1.box ++ [p.msg], parked := ps }
          have hst := deliver_st I w j _ m w1 a1 i hdel
          by_cases hs : i = p.sender
          · have hnj : p.sender ≠ j := fun h => hne (hs.trans h)
            rw [hs] at hst ⊢
            simp [setActor_self, resume_box, credit_box, admitted]
            rw [setActor_other w1 j p.sender admitted hnj]
            exact congrArg (·.box) hst
          · simp [admitted, setActor_other (creditLive (setActor w1 j admitted) (tname j) m.sender)
              p.sender i _ hs, credit_box, setActor_other w1 j i admitted hne, hst]

theorem release_box (w : World) (id : InstId) (ps : List Parked) (i : InstId) :
    ((releaseParked w id ps).st i).box = (w.st i).box := by
  induction ps generalizing w with
  | nil => simp [releaseParked]
  | cons p ps ih =>
    simp only [releaseParked, List.foldl_cons]
    by_cases hskip : (p.isCall || decide (p.sender = id)) = true
    · rw [if_pos hskip]
      exact ih w
    · rw [if_neg hskip]
      have hmid := ih (setActor w p.sender (resumeSender (w.st p.sender) false id))
      have hset : ((setActor w p.sender (resumeSender (w.st p.sender) false id)).st i).box =
          (w.st i).box := by
        by_cases hi : i = p.sender
        · rw [hi]
          simp [setActor, resume_box]
        · simp [setActor, hi]
      rw [hset] at hmid
      exact hmid

theorem try_wake_box (D : Description) (w : World) (dstId : InstId) (label : String)
    (writer i : InstId) : ((tryWake D w dstId label writer).st i).box = (w.st i).box := by
  by_cases hif : ((w.st dstId).life == .alive &&
      decide (prioLoad (w.st dstId).prio < capPrio D w.N dstId) &&
      !((w.st dstId).prio.any fun p => p.label == label)) = true
  · simp [tryWake, hif, setActor]
    by_cases hi : i = dstId <;> simp [hi]
  · simp [tryWake, hif]

theorem wakes_box (D : Description) (ids : List InstId) (w : World) (label : String)
    (writer i : InstId) :
    ((ids.foldl (fun w id => tryWake D w id label writer) w).st i).box = (w.st i).box := by
  induction ids generalizing w with
  | nil => simp
  | cons j js ih =>
    simp only [List.foldl_cons]
    exact (ih _).trans (try_wake_box D w j label writer i)

/-- One execution step appends to a mailbox or leaves it. Killing the mailbox
owner is excluded: that actor is not alive afterwards. -/
theorem admitHost_box_grow (w : World) (dead host i : InstId) :
    BoxGrow ((w.st i).box) ((admitHost w dead host).st i).box := by
  by_cases hd : host = dead
  · simp [admitHost, hd]
    exact Or.inl rfl
  · have hb : (host == dead) = false := by simpa [beq_iff_eq] using hd
    by_cases hempty : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty = true
    · simp [admitHost, hb, hempty]
      exact Or.inl rfl
    · have hgo : ((w.st host).parked.filter fun p => p.sender == dead).isEmpty = false :=
        Bool.eq_false_of_ne_true hempty
      simp [admitHost, hb, hgo]
      by_cases hi : i = host
      · simp [setActor, hi]
        exact Or.inr ⟨((w.st host).parked.filter fun p => p.sender == dead).map (·.msg), rfl⟩
      · simp [setActor, hi]
        exact Or.inl rfl

theorem admitDead_box_grow (w : World) (dead i : InstId) :
    BoxGrow ((w.st i).box) ((admitDead w dead).st i).box := by
  unfold admitDead
  suffices ∀ (ids : List InstId) (w0 : World),
      BoxGrow ((w0.st i).box)
        ((List.foldl (fun w host => admitHost w dead host) w0 ids).st i).box by
    exact this w.roster w
  intro ids
  induction ids with
  | nil => intro w0; exact Or.inl rfl
  | cons host ids ih =>
    intro w0
    simp only [List.foldl_cons]
    exact boxGrow_trans (admitHost_box_grow w0 dead host i) (ih _)

/-- Aborting someone else only admits that actor's blocked sends into `i`'s box. -/
theorem abort_box_grow (D : Description) (w : World) (id : InstId) (a : Actor) (i : InstId)
    (hne : i ≠ id) :
    BoxGrow ((w.st i).box) ((abortActor D w id a).st i).box := by
  have hrel : ((releaseWorld D w id a).st i).box = (w.st i).box := by
    rw [release_box_host]
    simp [hne]
  have hfail : ((failWaiters (releaseWorld D w id a) id).st i).box =
      ((releaseWorld D w id a).st i).box := by
    simpa [failWaiters] using
      failFold_box (releaseWorld D w id a) id i (releaseWorld D w id a).roster
  have hEq := hfail.trans hrel
  simpa [abortActor, hEq] using
    admitDead_box_grow (failWaiters (releaseWorld D w id a) id) id i

theorem abortDesc_box_grow (fuel : Nat) (D : Description) (w : World) (parent i : InstId)
    (hlive : ((abortDesc fuel D w parent).st i).life = .alive) :
    BoxGrow ((w.st i).box) ((abortDesc fuel D w parent).st i).box := by
  induction fuel generalizing w parent with
  | zero =>
    simp [abortDesc] at hlive ⊢
    exact Or.inl rfl
  | succ fuel ih =>
    simp only [abortDesc] at hlive ⊢
    suffices ∀ (ids : List InstId) (w0 : World),
        ((ids.foldl (fun w child =>
          if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
            let w := abortDesc fuel D w child
            abortActor D w child (w.st child)
          else w) w0).st i).life = .alive →
        BoxGrow ((w0.st i).box)
          ((ids.foldl (fun w child =>
            if isChild D parent child && (w.st child).life == .alive && childTerminable D child then
              let w := abortDesc fuel D w child
              abortActor D w child (w.st child)
            else w) w0).st i).box by
      exact this w.roster w hlive
    intro ids
    induction ids with
    | nil => intro w0 _; exact Or.inl rfl
    | cons c ids ihf =>
      intro w0 hfin
      simp only [List.foldl_cons] at hfin ⊢
      by_cases hgo : (isChild D parent c && (w0.st c).life == .alive && childTerminable D c) = true
      · rw [if_pos hgo] at hfin ⊢
        let w1 := abortDesc fuel D w0 c
        let w2 := abortActor D w1 c (w1.st c)
        have hlive2 : (w2.st i).life = .alive := by
          by_cases hwas : (w2.st i).life = .alive
          · exact hwas
          · exact absurd hfin (abortFold_life_mono fuel D parent i ids w2 hwas)
        have hne : c ≠ i := by
          intro heq
          subst heq
          simp [w2, (abort_self D w1 c (w1.st c)).1] at hlive2
        have hlive1 : (w1.st i).life = .alive := by
          exact (abortActor_other_life D w1 c i (w1.st c) (Ne.symm hne)).symm.trans hlive2
        exact boxGrow_trans (ih w0 c hlive1)
          (boxGrow_trans (abort_box_grow D w1 c (w1.st c) i (Ne.symm hne)) (ihf w2 hfin))
      · rw [if_neg hgo] at hfin ⊢
        exact ihf w0 hfin

theorem terminate_box_grow (D : Description) (w : World) (id i : InstId)
    (hlive : ((terminateStage D w id (w.st id)).st i).life = .alive) :
    BoxGrow ((w.st i).box) ((terminateStage D w id (w.st id)).st i).box := by
  simp only [terminateStage] at hlive ⊢
  let w1 := abortDesc w.roster.length D w id
  let w2 := abortActor D w1 id (w1.st id)
  have hlive2 : (w2.st i).life = .alive := by
    rw [← enqueueTombstone_life D w2 id i]
    exact hlive
  have hne : i ≠ id := by
    intro heq
    have hdead := (abort_self D w1 i (w1.st i)).1
    rw [heq] at hdead hlive2
    simp [w2, hdead] at hlive2
  have hlive1 : (w1.st i).life = .alive := by
    exact (abortActor_other_life D w1 id i (w1.st id) hne).symm.trans hlive2
  have hgrow := boxGrow_trans (abortDesc_box_grow w.roster.length D w id i hlive1)
    (abort_box_grow D w1 id (w1.st id) i hne)
  have htomb : ((enqueueTombstone D w2 id).st i).box = (w2.st i).box := tombstone_box D w2 id i
  simpa [w1, w2, htomb] using hgrow

theorem exec_box (I : Impl) (w : World) (id : InstId) (k : Cont) (mb : InstId)
    (hG : GraphOk I.desc) (hH : MailHere I.desc w) (hO : OccInv I w)
    (hlive : ((execRun I w id (w.st id) k).st mb).life = .alive) :
    BoxGrow ((w.st mb).box) ((execRun I w id (w.st id) k).st mb).box := by
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases rest with
    | nil =>
      simpa [execRun] using box_actor w id { (w.st id) with phase := .idle, typestate := toState } mb rfl
    | cons e tail =>
      cases e with
      | send dst label hint =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact box_actor w id (proceed (w.st id)
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
        | some dstId =>
          simpa [hr] using enqueue_box w I.desc id dstId
            { label := label, sender := id, callFrom := none } false
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb
      | call dst label hint na to =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact box_actor w id (proceed (w.st id)
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
        | some dstId =>
          simpa [hr] using enqueue_box w I.desc id dstId
            { label := label, sender := id, callFrom := some id } true
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb
      | internal =>
        simpa [execRun] using box_actor w id
          { (w.st id) with phase := .awaitEffect (afterHead ⟨.internal :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb rfl
      | peer onTimeout =>
        simpa [execRun] using box_actor w id
          { (w.st id) with phase := .awaitPeer (afterHead ⟨(.peer onTimeout) :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) }
          mb rfl
      | selfSchedule label =>
        simp only [execRun]
        by_cases hany : ((w.st id).prio.any fun p => p.label == label) = true
        · simpa [hany] using box_actor w id (proceed (w.st id)
            (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
        · by_cases hlt : prioLoad (w.st id).prio < capPrio I.desc w.N id
          · simpa [hany, hlt] using box_actor w id (proceed { (w.st id) with
              prio := upsertPrio (w.st id).prio
                { label := label, sender := id, callFrom := none, reliable := true,
                  mid := (w.st id).nextMid },
              nextMid := (w.st id).nextMid + 1 }
              (afterHead ⟨.selfSchedule label :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (by simp [proceed_box])
          · simpa [hany, hlt] using box_actor w id { (w.st id) with phase := .crashed } mb rfl
      | trySend dst label hint onFull onGone =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none =>
          simp only [hr]
          exact box_actor w id (proceed (w.st id)
            (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
        | some dstId =>
          simp only [hr]
          split
          · simpa using enqueue_box w I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb
          · exact box_actor w id (proceed (w.st id)
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
      | reply =>
        simp only [execRun]
        unfold performReply
        cases hto : replyTo with
        | none =>
          simpa [hto] using box_actor w id (proceed (w.st id)
            (afterHead ⟨.reply :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb (proceed_box _ _)
        | some caller =>
          cases hcall : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · simp [hto, hcall, hd]
              by_cases hmb : mb = id
              · rw [hmb]
                by_cases hc : caller = id
                · rw [hc]
                  simp [setActor, proceed_box]
                  exact Or.inl rfl
                · have hflip : ¬ id = caller := fun h => hc h.symm
                  simp [setActor, proceed_box]
                  rw [if_neg hflip]
                  exact Or.inl rfl
              · by_cases hc : mb = caller
                · rw [hc]
                  have hne : ¬ caller = id := fun h => hmb (hc.trans h)
                  simp [setActor, hne, proceed_box]
                  exact Or.inl rfl
                · simp [setActor, hmb, hc]
                  exact Or.inl rfl
            · simpa [hto, hcall, hd] using box_actor w id (proceed (w.st id)
                (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | idle =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | run _ =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | awaitEffect _ =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | awaitPeer _ =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | parked _ _ _ =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
          | crashed =>
            simpa [hto, hcall] using box_actor w id (proceed (w.st id)
              (afterHead ⟨.reply :: tail, toState, some caller⟩)) mb (proceed_box _ _)
      | cell dst label value =>
        simp only [execRun]
        cases hdirty : (w.cell dst label).dirty
        · simp [hdirty, wakeReaders]
          rw [wakes_box]
          exact box_actor (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb
            (by simpa [setCell] using proceed_box _ _)
        · simp [hdirty]
          exact box_actor (setCell w dst label
            { value := max (w.cell dst label).value value, dirty := true }) id
            (proceed ((setCell w dst label
              { value := max (w.cell dst label).value value, dirty := true }).st id)
              (afterHead ⟨.cell dst label value :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩)) mb
            (by simpa [setCell] using proceed_box _ _)
      | terminate =>
        rcases exec_term_world I w id ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ tail rfl with
          hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
        · rw [hkept]
          exact Or.inl rfl
        · rw [hrel] at hlive ⊢
          by_cases hmb : mb = id
          · exfalso
            rw [hmb] at hlive
            rw [releaseWorld_self_dead] at hlive
            cases hlive
          · unfold releaseWorld
            have hbase : ∀ i, ((refundParked (refundMsgs (readCells I.desc w id) (tname id)
                  (w.st id).box) (tname id) (w.st id).parked).st i).box = (w.st i).box := by
              intro i
              rw [refundP_box, refund_box, readCells_st]
            rw [release_box, setActor_other _ id mb _ hmb, hbase]
            exact Or.inl rfl
        · rw [hkill] at hlive ⊢
          exact terminate_box_grow I.desc w id mb hlive

/-- A step other than this callee's bulk receive appends to its box or leaves the
box alone, so a call already in the box keeps its position. The call leaves the
box only when that receive delivers it. -/
theorem box_pos_mono (I : Impl) (a : Action) (w w' : World) (h : apply I a w = some w')
    (hG : GraphOk I.desc) (hH : MailHere I.desc w) (hOcc : OccInv I w) (d c : InstId)
    (hnot : a ≠ .recvBulk d) (halive : (w'.st d).life = .alive)
    (hpos : callPos (w.st d).box c < (w.st d).box.length) :
    callPos (w'.st d).box c = callPos (w.st d).box c ∧
      callPos (w'.st d).box c < (w'.st d).box.length := by
  have hgrow : BoxGrow (w.st d).box (w'.st d).box := by
    cases a with
    | stutter =>
      cases stutter_unchanged I w w' h
      exact Or.inl rfl
    | ingress who label =>
      rcases ingress_box I w w' who label d (by simpa [stepWorld] using stepOfApply h) with ⟨_, hbox⟩ | ⟨_, hbox⟩
      · exact Or.inr ⟨[{ label := label, sender := who, callFrom := none, reliable := true, mid := (w.st who).nextMid }], hbox⟩
      · exact Or.inl hbox
    | recvBulk id =>
      have hid : id ≠ d := by
        intro heq
        exact hnot (by simp [heq])
      exact Or.inl (bulk_other_box I w w' id d (by simpa [stepWorld] using stepOfApply h) hid.symm)
    | recvPrio id =>
      exact Or.inl (prio_box I w w' id d (by simpa [stepWorld] using stepOfApply h))
    | finish id =>
      exact Or.inl (finish_box I w w' id d (by simpa [stepWorld] using stepOfApply h))
    | exec id =>
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold execHead at h
      by_cases hrun : (w.st id).life = .alive
      · simp [hrun] at h
        cases hphase : (w.st id).phase with
        | run k =>
          simp [hphase] at h
          cases h
          exact exec_box I w id k d hG hH hOcc halive
        | idle => simp [hphase] at h
        | parked _ _ _ => simp [hphase] at h
        | awaitReply _ _ => simp [hphase] at h
        | awaitEffect _ => simp [hphase] at h
        | awaitPeer _ => simp [hphase] at h
        | crashed => simp [hphase] at h
      · simp [hrun] at h
    | spawn template =>
      have h := stepOfApply h
      simp only [stepWorld] at h
      unfold spawn at h
      split at h
      · cases h
      · next t ht =>
        split at h
        · cases h
          let nid := InstId.peer template (w.nextIx template)
          let wR : World := ({ w with roster := w.roster ++ [nid], nextIx := fun n =>
            if n = template then w.nextIx n + 1 else w.nextIx n } : World)
          let born : Actor := withTokens I.desc template
            { life := .alive, typestate := t.initial, phase := .idle, box := [], prio := [],
              parked := [], tokens := fun _ => 0 }
          by_cases hd : d = nid
          · have hnin : nid ∉ w.roster := by
              intro hmem
              have hix := hOcc.indexed template (w.nextIx template) hmem
              omega
            have hempty := (hOcc.offEmpty nid hnin).1
            rw [hd, hempty] at hpos
            simp [callPos] at hpos
          · have hs := readCells_st I.desc (setActor wR nid born) nid d
            rw [hs]
            simp [wR, setActor, hd]
            exact Or.inl rfl
        · cases h
  exact call_grow _ _ _ hgrow hpos

/-- While the callee is not receiving, a call sitting in its box stays at the same index. -/
theorem call_pos_mono (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat} (ρ : Run I N)
    (c d : InstId) (i n : Nat)
    (halive : ∀ t, i ≤ t → t ≤ i + n → ((ρ.cfg t).st d).life = .alive)
    (hnorecv : ∀ t, i ≤ t → t < i + n → ρ.act t ≠ .recvBulk d)
    (hin : callPos ((ρ.cfg i).st d).box c < ((ρ.cfg i).st d).box.length) :
    callPos ((ρ.cfg (i + n)).st d).box c = callPos ((ρ.cfg i).st d).box c ∧
      callPos ((ρ.cfg (i + n)).st d).box c < ((ρ.cfg (i + n)).st d).box.length := by
  induction n with
  | zero =>
    rw [Nat.add_zero]
    exact ⟨rfl, hin⟩
  | succ n ih =>
    have hprev := ih (fun t h1 h2 => halive t h1 (Nat.le_trans h2 (Nat.le_succ _)))
      (fun t h1 h2 => hnorecv t h1 (by omega))
    have hHere := mail_here_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))
    have hOcc := (inv2_reachable I hL hG N (ρ.cfg (i + n)) (cfg_reachable ρ (i + n))).2.1
    have hstep := box_pos_mono I (ρ.act (i + n)) (ρ.cfg (i + n)) (ρ.cfg (i + n + 1))
      (ρ.valid (i + n)) hG hHere hOcc d c
      (hnorecv (i + n) (Nat.le_add_right i n) (by omega))
      (halive (i + n + 1) (by omega) (by omega)) hprev.2
    exact ⟨hstep.1.trans hprev.1, hstep.2⟩

/-- With the callee alive and able to receive infinitely often, the tagged call is
delivered and the handler is installed. `n` bounds the call's position. Each bulk
receive either installs the handler or moves the message strictly closer to the head. -/
theorem call_delivered (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (c d : InstId) (k : Cont) (n i : Nat)
    (hstay : ∀ t, i ≤ t → ((ρ.cfg t).st c).phase = .awaitReply d k)
    (halive : ∀ t, i ≤ t → ((ρ.cfg t).st d).life = .alive)
    (hin : callPos ((ρ.cfg i).st d).box c ≤ n)
    (hlt : callPos ((ρ.cfg i).st d).box c < ((ρ.cfg i).st d).box.length)
    (hio : ∀ t, ∃ j, t ≤ j ∧ Enabled I (ρ.cfg j) (.recvBulk d)) :
    ∃ j, i ≤ j ∧ ¬mailCall (ρ.cfg j) d c ∧
      (handlerOwes c ((ρ.cfg j).st d).phase ∨ replyPending c ((ρ.cfg j).st d).phase) ∧
      ((ρ.cfg j).st c).phase = .awaitReply d k := by
  induction n generalizing i with
  | zero =>
    have hzero : callPos ((ρ.cfg i).st d).box c = 0 := by omega
    obtain ⟨j, hj, hact, hfirst⟩ := next_bulk ρ hF d i hio
    have hmono := call_pos_mono I hL hG ρ c d i (j - i)
      (fun t h1 _ => halive t h1)
      (fun t h1 h2 => hfirst t h1 (by
        have hsum : i + (j - i) = j := Nat.add_sub_of_le hj
        omega))
      hlt
    have hposj : callPos ((ρ.cfg j).st d).box c = 0 := by
      have heq := hmono.1
      simp [Nat.add_sub_of_le hj] at heq
      rw [heq]
      exact hzero
    have hlenj : callPos ((ρ.cfg j).st d).box c < ((ρ.cfg j).st d).box.length := by
      simpa [Nat.add_sub_of_le hj] using hmono.2
    have hM := (inv_reachable I N (ρ.cfg j) hL (cfg_reachable ρ j)).2.1
    have hT := call_tag_reachable I hL hG N (ρ.cfg j) (cfg_reachable ρ j)
    have hrecv : receiveBulk I (ρ.cfg j) d = some (ρ.cfg (j + 1)) := by
      simpa [apply, hact] using ρ.valid j
    rcases recv_box_progress I hL (ρ.cfg j) (ρ.cfg (j + 1)) d c k hrecv hM hT (hstay j hj) hlenj with
      hinst | hdrop
    · exact ⟨j + 1, Nat.le_trans hj (Nat.le_succ j), hinst.2.1, hinst.2.2, hinst.1⟩
    · simp [hposj] at hdrop
  | succ n ih =>
    obtain ⟨j, hj, hact, hfirst⟩ := next_bulk ρ hF d i hio
    have hmono := call_pos_mono I hL hG ρ c d i (j - i)
      (fun t h1 _ => halive t h1)
      (fun t h1 h2 => hfirst t h1 (by
        have hsum : i + (j - i) = j := Nat.add_sub_of_le hj
        omega))
      hlt
    have hposj : callPos ((ρ.cfg j).st d).box c ≤ n + 1 := by
      have heq := hmono.1
      simp [Nat.add_sub_of_le hj] at heq
      rw [heq]
      exact hin
    have hlenj : callPos ((ρ.cfg j).st d).box c < ((ρ.cfg j).st d).box.length := by
      simpa [Nat.add_sub_of_le hj] using hmono.2
    have hM := (inv_reachable I N (ρ.cfg j) hL (cfg_reachable ρ j)).2.1
    have hT := call_tag_reachable I hL hG N (ρ.cfg j) (cfg_reachable ρ j)
    have hrecv : receiveBulk I (ρ.cfg j) d = some (ρ.cfg (j + 1)) := by
      simpa [apply, hact] using ρ.valid j
    rcases recv_box_progress I hL (ρ.cfg j) (ρ.cfg (j + 1)) d c k hrecv hM hT (hstay j hj) hlenj with
      hinst | hdrop
    · exact ⟨j + 1, Nat.le_trans hj (Nat.le_succ j), hinst.2.1, hinst.2.2, hinst.1⟩
    · have hnext : callPos ((ρ.cfg (j + 1)).st d).box c ≤ n := by
        have hltp := hdrop.2.2
        omega
      have hmail : mailCall (ρ.cfg (j + 1)) d c := hdrop.2.1
      have hph1 : ((ρ.cfg (j + 1)).st c).phase = .awaitReply d k := hdrop.1
      have hT1 := call_tag_reachable I hL hG N (ρ.cfg (j + 1)) (cfg_reachable ρ (j + 1))
      have hlen1 := (await_mail_in_box (ρ.cfg (j + 1)) hT1 c d k hph1 hmail).1
      obtain ⟨j1, hj1, hmail1, howe1, hphj⟩ := ih (j + 1)
        (fun t ht => hstay t (Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) ht))
        (fun t ht => halive t (Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) ht))
        hnext hlen1
      exact ⟨j1, Nat.le_trans (Nat.le_trans hj (Nat.le_succ j)) hj1, hmail1, howe1, hphj⟩

/-- Executing a reply whose target is waiting on this sender ends that wait. -/
theorem reply_exec_leaves (I : Impl) (w : World) (d c : InstId) (k ck : Cont) (es : List Eff)
    (hph : (w.st d).phase = .run k) (hl : (w.st d).life = .alive)
    (hrest : k.rest = .reply :: es) (hto : k.replyTo = some c)
    (hwait : (w.st c).phase = .awaitReply d ck) :
    waitKind ((execRun I w d (w.st d) k).st c) ≠ some (.callReply d) := by
  have hcne : c ≠ d := by
    intro heq
    rw [heq] at hwait
    simp [hph] at hwait
  simp [execRun, hrest, performReply, hto, hwait, setActor, hcne, proceed_not_call]

/-- A handler whose next effect is the reply does execute it, and the caller leaves
`awaitReply`. -/
theorem pending_reply_runs (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (c d : InstId) (k ck : Cont) (es : List Eff) (i : Nat)
    (hph : ((ρ.cfg i).st d).phase = .run k) (hl : ((ρ.cfg i).st d).life = .alive)
    (hrest : k.rest = .reply :: es) (hto : k.replyTo = some c)
    (hwait : ((ρ.cfg i).st c).phase = .awaitReply d ck)
    (hlive : ∀ t, i ≤ t → ((ρ.cfg t).st d).life = .alive)
    (hstay : ∀ t, i ≤ t → ((ρ.cfg t).st c).phase = .awaitReply d ck) :
    ∃ j, i ≤ j ∧ waitKind (((ρ.cfg (j + 1)).st c)) ≠ some (.callReply d) := by
  have hhit : ∃ j, i ≤ j ∧ ρ.act j = .exec d := by
    cases Classical.em (∃ j, i ≤ j ∧ ρ.act j = .exec d) with
    | inl h => exact h
    | inr hmiss =>
      have hstayR : ∀ u, i ≤ u → (∃ k', ((ρ.cfg u).st d).phase = .run k') ∧
          ((ρ.cfg u).st d).life = .alive := by
        intro u hu
        have hgot := run_holds hL hG ρ d i (u - i) k hph hl
          (fun v hv _ => hlive v hv)
          (fun v h1 _ hbad => hmiss ⟨v, h1, hbad⟩)
        have hph' := by simpa [Nat.add_sub_of_le hu] using hgot
        refine ⟨?_, hph'.2⟩
        rcases hph'.1 with h | ⟨_, _, h⟩
        · exact ⟨k, h⟩
        · exact ⟨{k with replyTo := none}, h⟩
      exact False.elim (not_forever_run I hL hG ρ hF d i (fun j hj => (hstayR j hj).2)
        (fun j hj => (hstayR j hj).1))
  obtain ⟨j0, hj0, hact0⟩ := hhit
  have hscan := scanExec_spec ρ.act d (j0 - i) i ⟨j0 - i, Nat.le_refl _, by
    simpa [Nat.add_sub_of_le hj0] using hact0⟩
  let m := scanExec ρ.act d (j0 - i) i
  have him : i ≤ m := hscan.1
  have hact : ρ.act m = .exec d := hscan.2.1
  have hpre := run_holds_owed hL hG ρ d c i (m - i) k ck d hph hl hto
    (fun t ht _ => hlive t ht)
    (fun t h1 _ hbad => hscan.2.2 t h1 (by
      have hsum : i + (m - i) = m := Nat.add_sub_of_le him
      omega) hbad)
    (fun t h1 _ => hstay t h1)
  have hhere : ((ρ.cfg m).st d).phase = .run k := by
    simpa [Nat.add_sub_of_le him] using hpre.1
  have hlm : ((ρ.cfg m).st d).life = .alive := by
    simpa [Nat.add_sub_of_le him] using hpre.2
  have hrun : execRun I (ρ.cfg m) d ((ρ.cfg m).st d) k = ρ.cfg (m + 1) := by
    have hhead := ρ.valid m
    simp [apply, hact, execHead, hlm, hhere] at hhead
    exact hhead
  have hleft := reply_exec_leaves I (ρ.cfg m) d c k ck es hhere hlm hrest hto (hstay m him)
  rw [hrun] at hleft
  exact ⟨m, him, hleft⟩

/-- A caller that stays in `awaitReply` cannot be waiting on a handler whose next
effect is already the reply: that handler runs the reply and the wait ends. -/
theorem await_reply_head_false (I : Impl) (hL : LocalOk I) (hG : GraphOk I.desc) {N : Nat}
    (ρ : Run I N) (hF : Fair ρ) (c d : InstId) (k ck : Cont) (es : List Eff) (i : Nat)
    (hph : ((ρ.cfg i).st d).phase = .run k) (hl : ((ρ.cfg i).st d).life = .alive)
    (hrest : k.rest = .reply :: es) (hto : k.replyTo = some c)
    (hlive : ∀ t, i ≤ t → ((ρ.cfg t).st d).life = .alive)
    (hstay : ∀ t, i ≤ t → ((ρ.cfg t).st c).phase = .awaitReply d ck) : False := by
  obtain ⟨j, hj, hleft⟩ := pending_reply_runs I hL hG ρ hF c d k ck es i hph hl hrest hto
    (hstay i (Nat.le_refl _)) hlive hstay
  have hstill : ((ρ.cfg (j + 1)).st c).phase = .awaitReply d ck :=
    hstay (j + 1) (Nat.le_trans hj (Nat.le_succ j))
  simp [waitKind, hstill] at hleft

/-- An actor that is not running keeps its phase across someone else's execution,
and a dead idle actor is not resumed or parked on. -/
theorem exec_keeps_idle (I : Impl) (w : World) (id i : InstId) (k : Cont)
    (hne : i ≠ id) (hidle : (w.st i).phase = .idle) (hdead : (w.st i).life ≠ .alive) :
    ((execRun I w id (w.st id) k).st i).phase = .idle := by
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases rest with
    | nil => simp [execRun, setActor, hne, hidle]
    | cons e tail =>
      cases e with
      | send dst label hint =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none => simp [hr, setActor, hne, proceed, hidle]
        | some dstId =>
          simpa [hr, hidle] using enqueue_phase_other w I.desc id dstId
            { label := label, sender := id, callFrom := none } false
            (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i hne
      | call dst label hint na to =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none => simp [hr, setActor, hne, proceed, hidle]
        | some dstId =>
          simpa [hr, hidle] using enqueue_phase_other w I.desc id dstId
            { label := label, sender := id, callFrom := some id } true
            (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i hne
      | trySend dst label hint onFull onGone =>
        simp only [execRun]
        cases hr : route w I.desc id dst with
        | none => simp [hr, setActor, hne, proceed, hidle]
        | some dstId =>
          simp only [hr]
          split
          · simpa [hidle] using enqueue_phase_other w I.desc id dstId
              { label := label, sender := id, callFrom := none, reliable := false } false
              (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) i hne
          · simp [setActor, hne, proceed, hidle]
      | reply =>
        simp only [execRun, performReply]
        cases hto : replyTo with
        | none => simp [hto, setActor, hne, proceed, hidle]
        | some caller =>
          cases hcall : (w.st caller).phase with
          | awaitReply dst ck =>
            by_cases hd : dst = id
            · have hnc : caller ≠ i := by
                intro hc
                rw [hc] at hcall
                simp [hidle] at hcall
              have hflip : ¬ i = caller := fun h => hnc h.symm
              simp [hto, hcall, hd, setActor, hne, hflip, proceed, hidle]
            · simp [hto, hcall, hd, setActor, hne, proceed, hidle]
          | idle => simp [hto, hcall, setActor, hne, proceed, hidle]
          | run _ => simp [hto, hcall, setActor, hne, proceed, hidle]
          | parked _ _ _ => simp [hto, hcall, setActor, hne, proceed, hidle]
          | awaitEffect _ => simp [hto, hcall, setActor, hne, proceed, hidle]
          | awaitPeer _ => simp [hto, hcall, setActor, hne, proceed, hidle]
          | crashed => simp [hto, hcall, setActor, hne, proceed, hidle]
      | selfSchedule _ =>
        simp only [execRun]
        split <;> try split
        · simp [setActor, hne, proceed, hidle]
        · simp [setActor, hne, proceed, hidle]
        · simp [setActor, hne, hidle]
      | cell dst label value =>
        simp only [execRun]
        have hwake : ∀ (ids : List InstId) (w0 : World),
            ((ids.foldl (fun w r => tryWake I.desc w r label id) w0).st i).phase =
              (w0.st i).phase := by
          intro ids w0
          induction ids generalizing w0 with
          | nil => simp
          | cons j js ih =>
            simp only [List.foldl_cons]
            have hstep : ((tryWake I.desc w0 j label id).st i).phase = (w0.st i).phase := by
              by_cases hif : ((w0.st j).life == .alive &&
                  decide (prioLoad (w0.st j).prio < capPrio I.desc w0.N j) &&
                  !((w0.st j).prio.any fun p => p.label == label)) = true
              · simp [tryWake, hif, setActor]
                by_cases hi : i = j <;> simp [hi]
              · simp [tryWake, hif]
            exact (ih _).trans hstep
        cases hdirty : (w.cell dst label).dirty
        · simp [hdirty, setCell, setActor, hne, proceed, wakeReaders, hwake, hidle]
        · simp [hdirty, setCell, setActor, hne, proceed, hidle]
      | internal => simp [execRun, setActor, hne, hidle]
      | peer onTimeout => simp [execRun, setActor, hne, hidle]
      | terminate =>
        have hkeep : ∀ (ps : List Parked) (w0 : World), (w0.st i).phase = .idle →
            ((releaseParked w0 id ps).st i).phase = .idle := by
          intro ps w0 h0
          induction ps generalizing w0 with
          | nil => simpa [releaseParked] using h0
          | cons p ps ih =>
            simp only [releaseParked, List.foldl_cons]
            by_cases hskip : (p.isCall || decide (p.sender = id)) = true
            · rw [if_pos hskip]
              exact ih w0 h0
            · rw [if_neg hskip]
              have hph : ((setActor w0 p.sender (resumeSender (w0.st p.sender) false id)).st i).phase =
                  .idle := by
                by_cases hi : i = p.sender
                · have hI : (w0.st p.sender).phase = .idle := by rw [← hi]; exact h0
                  simp [setActor, hi, resumeSender, hI]
                · simp [setActor, hi, h0]
              exact ih _ hph
        rcases exec_term_world I w id ⟨.terminate :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩ tail rfl with
          hkept | ⟨_, _, _, _, _, _, hrel⟩ | ⟨t, _, _, _, _, hkill⟩
        · simpa [hkept] using hidle
        · rw [hrel]
          unfold releaseWorld
          have hpre : ((refundParked (refundMsgs (readCells I.desc w id) (tname id) (w.st id).box)
                (tname id) (w.st id).parked).st i).phase = .idle := by
            rw [(refundP_life _ _ _ i).2.2.1, (refund_life _ _ _ i).2.2.1, readCells_st]
            exact hidle
          exact hkeep _ _ (by simp [setActor, hne, hpre])
        · rw [hkill]
          simp only [terminateStage]
          exact (enqueueTombstone_phase I.desc
              (abortActor I.desc (abortDesc w.roster.length I.desc w id) id
                ((abortDesc w.roster.length I.desc w id).st id)) id i).trans
            ((abort_idle_phase I.desc (abortDesc w.roster.length I.desc w id) id
                ((abortDesc w.roster.length I.desc w id).st id) i
                (abortDesc_idle_phase w.roster.length I.desc w id i hidle)))

/-- Some bulk mailbox holds a message naming `c`. -/
def anyCall (w : World) (c : InstId) : Prop :=
  (∃ i m, m ∈ (w.st i).box ∧ m.callFrom = some c) ∨
    (∃ i p, p ∈ (w.st i).parked ∧ p.msg.callFrom = some c)

theorem mail_no_call (w w' : World) (c : InstId) (h : MailFrom w w') (hyes : anyCall w' c) :
    anyCall w c := by
  rcases hyes with ⟨i, m, hm, hc⟩ | ⟨i, p, hp, hc⟩
  · rcases h.box i m hm with hbox | ⟨p, hp, hmsg⟩
    · exact Or.inl ⟨i, m, hbox, hc⟩
    · rw [← hmsg] at hc
      exact Or.inr ⟨i, p, hp, hc⟩
  · exact Or.inr ⟨i, p, h.park i p hp, hc⟩

theorem anyCall_of_sub (w w' : World) (c : InstId)
    (hbox : ∀ i, (w'.st i).box.Sublist (w.st i).box)
    (hpark : ∀ i, (w'.st i).parked.Sublist (w.st i).parked)
    (h : anyCall w' c) : anyCall w c := by
  rcases h with ⟨i, m, hm, hc⟩ | ⟨i, p, hp, hc⟩
  · exact Or.inl ⟨i, m, (hbox i).mem hm, hc⟩
  · exact Or.inr ⟨i, p, (hpark i).mem hp, hc⟩

theorem anyCall_mail (w : World) (d c : InstId) (h : mailCall w d c) : anyCall w c := by
  rcases h with ⟨m, hm, hc⟩ | ⟨p, hp, hc⟩
  · exact Or.inl ⟨d, m, hm, hc⟩
  · exact Or.inr ⟨d, p, hp, hc⟩

/-- While `c` is in `awaitReply d`, only `d` can hold a message naming `c`. -/
theorem only_call_here (w : World) (hT : CallTagInv w) (c d : InstId) (k : Cont)
    (hph : (w.st c).phase = .awaitReply d k) (i : InstId) :
    (∀ m, m ∈ (w.st i).box → m.callFrom = some c → i = d) ∧
      (∀ p, p ∈ (w.st i).parked → p.msg.callFrom = some c → i = d) := by
  refine ⟨?_, ?_⟩
  · intro m hm hc
    rcases hT.msgOwner i c (Or.inl ⟨m, hm, hc⟩) with ⟨k', hk⟩ | ⟨k', hk⟩
    · have heq : Phase.awaitReply i k' = Phase.awaitReply d k := by rw [← hk, hph]
      injection heq
    · rw [hph] at hk
      cases hk
  · intro p hp hc
    rcases hT.msgOwner i c (Or.inr ⟨p, hp, hc⟩) with ⟨k', hk⟩ | ⟨k', hk⟩
    · have heq : Phase.awaitReply i k' = Phase.awaitReply d k := by rw [← hk, hph]
      injection heq
    · rw [hph] at hk
      cases hk

theorem exec_no_foreign_call (I : Impl) (w : World) (id : InstId) (k : Cont) (c : InstId)
    (hne : id ≠ c) (hno : ¬ anyCall w c) :
    ¬ anyCall (execRun I w id (w.st id) k) c := by
  intro hyes
  have hne' : ¬ c = id := fun h => hne h.symm
  cases k with
  | mk rest toState replyTo _ _ _ _ _ _ _ _ =>
    cases rest with
    | nil =>
      rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
      · simp [execRun, setActor] at hm
        by_cases hmb : mb = id
        · rw [hmb] at hm
          simp [setActor] at hm
          exact hno (Or.inl ⟨id, m, hm, hc⟩)
        · simp [setActor, hmb] at hm
          exact hno (Or.inl ⟨mb, m, hm, hc⟩)
      · simp [execRun, setActor] at hp
        by_cases hmb : mb = id
        · rw [hmb] at hp
          simp [setActor] at hp
          exact hno (Or.inr ⟨id, p, hp, hc⟩)
        · simp [setActor, hmb] at hp
          exact hno (Or.inr ⟨mb, p, hp, hc⟩)
    | cons e tail =>
      cases e with
      | call dst label hint na to =>
        simp only [execRun] at hyes
        cases hr : route w I.desc id dst with
        | none =>
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_box] at hm
              exact hno (Or.inl ⟨id, m, hm, hc⟩)
            · simp [hr, setActor, hmb] at hm
              exact hno (Or.inl ⟨mb, m, hm, hc⟩)
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_parked] at hp
              exact hno (Or.inr ⟨id, p, hp, hc⟩)
            · simp [hr, setActor, hmb] at hp
              exact hno (Or.inr ⟨mb, p, hp, hc⟩)
        | some dstId =>
          let msg : Msg := { label := label, sender := id, callFrom := some id }
          simp only [hr] at hyes
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · rcases enqueue_box_mem w I.desc id dstId msg true
                (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb m hm with
              hold | ⟨_, heq, _⟩
            · exact hno (Or.inl ⟨mb, m, hold, hc⟩)
            · rw [heq] at hc
              injection hc with hid
              exact hne hid
          · rcases enqueue_parked_mem w I.desc id dstId msg true
                (afterHead ⟨.call dst label hint na to :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb p hp with
              hold | ⟨_, _, heq, _, _⟩
            · exact hno (Or.inr ⟨mb, p, hold, hc⟩)
            · rw [heq] at hc
              injection hc with hid
              exact hne hid
      | send dst label hint =>
        simp only [execRun] at hyes
        cases hr : route w I.desc id dst with
        | none =>
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_box] at hm
              exact hno (Or.inl ⟨id, m, hm, hc⟩)
            · simp [hr, setActor, hmb] at hm
              exact hno (Or.inl ⟨mb, m, hm, hc⟩)
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_parked] at hp
              exact hno (Or.inr ⟨id, p, hp, hc⟩)
            · simp [hr, setActor, hmb] at hp
              exact hno (Or.inr ⟨mb, p, hp, hc⟩)
        | some dstId =>
          let msg : Msg := { label := label, sender := id, callFrom := none }
          simp only [hr] at hyes
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · rcases enqueue_box_mem w I.desc id dstId msg false
                (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb m hm with
              hold | ⟨_, heq, _⟩
            · exact hno (Or.inl ⟨mb, m, hold, hc⟩)
            · rw [heq] at hc
              simp at hc
          · rcases enqueue_parked_mem w I.desc id dstId msg false
                (afterHead ⟨.send dst label hint :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb p hp with
              hold | ⟨_, _, heq, _, _⟩
            · exact hno (Or.inr ⟨mb, p, hold, hc⟩)
            · rw [heq] at hc
              simp at hc
      | trySend dst label hint onFull onGone =>
        simp only [execRun] at hyes
        cases hr : route w I.desc id dst with
        | none =>
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_box] at hm
              exact hno (Or.inl ⟨id, m, hm, hc⟩)
            · simp [hr, setActor, hmb] at hm
              exact hno (Or.inl ⟨mb, m, hm, hc⟩)
          · by_cases hmb : mb = id
            · simp [hr, setActor, hmb, proceed_parked] at hp
              exact hno (Or.inr ⟨id, p, hp, hc⟩)
            · simp [hr, setActor, hmb] at hp
              exact hno (Or.inr ⟨mb, p, hp, hc⟩)
        | some dstId =>
          simp only [hr] at hyes
          by_cases hgo : ((w.st dstId).life == .alive && decide ((w.st dstId).parked = []) &&
              decide ((w.st dstId).box.length < capBulk I.desc w.N dstId)) = true
          · simp [hgo] at hyes
            let msg : Msg := { label := label, sender := id, callFrom := none, reliable := false }
            rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
            · rcases enqueue_box_mem w I.desc id dstId msg false
                  (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb m hm with
                hold | ⟨_, heq, _⟩
              · exact hno (Or.inl ⟨mb, m, hold, hc⟩)
              · rw [heq] at hc
                simp at hc
            · rcases enqueue_parked_mem w I.desc id dstId msg false
                  (afterHead ⟨.trySend dst label hint onFull onGone :: tail, toState, replyTo, [], [], [], "", "", "", "", ""⟩) mb p hp with
                hold | ⟨_, _, heq, _, _⟩
              · exact hno (Or.inr ⟨mb, p, hold, hc⟩)
              · rw [heq] at hc
                simp at hc
          · simp [hgo] at hyes
            rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
            · by_cases hmb : mb = id
              · simp [setActor, hmb, proceed_box] at hm
                exact hno (Or.inl ⟨id, m, hm, hc⟩)
              · simp [setActor, hmb] at hm
                exact hno (Or.inl ⟨mb, m, hm, hc⟩)
            · by_cases hmb : mb = id
              · simp [setActor, hmb, proceed_parked] at hp
                exact hno (Or.inr ⟨id, p, hp, hc⟩)
              · simp [setActor, hmb] at hp
