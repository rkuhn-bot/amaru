      | selfSchedule label =>
        simp only [execRun] at hyes
        by_cases hdup : ((w.st id).prio.any (fun p => p.label == label)) = true
        · simp [hdup] at hyes
          rcases hyes with ⟨mb, m, hm, hc⟩ | ⟨mb, p, hp, hc⟩
