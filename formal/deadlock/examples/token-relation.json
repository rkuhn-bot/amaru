      "repliesInDequeue": false,
      "ingress": false
    },
    {
      "src": "fetch_blocks",
      "srcState": "busy",
      "dst": "select_chain",
      "kind": "blocking",
      "reliability": "reliable",
      "effect": "send",
      "label": "ReturnToken",
      "scope": "intra",
      "occupancy": 11,
      "repliesInDequeue": false,
      "ingress": false
    }
  ]
