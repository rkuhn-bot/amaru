      "terminable": false,
      "untimedPeer": false,
      "mustFit": false
    },
    {
      "name": "fetch_blocks",
      "multiplicity": "one",
      "capacity": 10,
      "priorityCapacity": 4,
      "priorityBound": 1,
      "states": ["idle", "busy"],
      "initial": "idle",
      "terminable": false,
      "untimedPeer": false,
      "mustFit": false
    },
    {
      "name": "header_store",
      "multiplicity": "one",
      "capacity": 10,
      "priorityCapacity": 4,
      "priorityBound": 1,
      "states": ["idle"],
      "initial": "idle",
      "terminable": false,
      "untimedPeer": false,
      "mustFit": false
    }
  ],
  "edges": [
    {
      "src": "select_chain",
      "srcState": "holding",
      "dst": "fetch_blocks",
      "kind": "blocking",
      "reliability": "reliable",
      "effect": "send",
      "label": "NewBestTip",
      "scope": "intra",
