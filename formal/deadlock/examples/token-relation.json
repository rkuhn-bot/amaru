{
  "schema": "amaru-deadlock-graph/v1",
  "name": "token-relation",
  "freshNames": true,
  "compatibility": {
    "groups": [
      {
        "name": "fetch-token",
        "roles": ["select_chain", "fetch_blocks", "header_store"],
        "allowed": [
          [
            {"role": "select_chain", "state": "idle"},
            {"role": "fetch_blocks", "state": "idle"},
            {"role": "header_store", "state": "idle"}
          ],
          [
            {"role": "select_chain", "state": "holding"},
            {"role": "fetch_blocks", "state": "idle"},
            {"role": "header_store", "state": "idle"}
          ],
          [
            {"role": "select_chain", "state": "idle"},
            {"role": "fetch_blocks", "state": "busy"},
            {"role": "header_store", "state": "idle"}
          ]
        ]
      }
    ]
  },
  "transitions": [
    {"template": "select_chain", "from": "holding", "to": "idle", "label": "Release"},
    {"template": "fetch_blocks", "from": "busy", "to": "idle", "label": "Return"}
